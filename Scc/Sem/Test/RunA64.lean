/-! ## Loading and running -/

/-- The code base of the layout. -/
def codeLo : Nat := 0x400000

/-- The text's program, as the target parses it (once). -/
def progOf (asm : String) : Program :=
  match Kraken.AArch64.Parser.parse (Kraken.AArch64.Parser.stripDirectives (textSection asm)) with
  | .ok p => p
  | .error _ => []

/-- A code label's address, as `target.resolve` gives it at `codeLo`. -/
def resolveIn (prog : Program) (l : String) : Option Nat :=
  labelAddr labelName Directive.fakeSize codeLo l prog

/-- The layout of the text at `codeLo` (`.rodata` at `0x500000`), and what
the walk could not handle. -/
def layoutIn (asm : String) (prog : Program) : Layout × List String :=
  layoutOf asm codeLo 0x100000 0x500000 0x600000 0x1000000 0x10000000 0x8000000 (resolveIn prog)

/-- The resolved transfer and abort sites, as `Target.marks` resolves them. -/
def marksIn (prog : Program) : RunMarks :=
  { take := resolveIn prog (XferKind.label .take)
    release := resolveIn prog (XferKind.label .release)
    abortAt := fun k => resolveIn prog (abortName k) }

/-- Thread slots: the main thread and one spawned thread. -/
def slots : Nat := 2

/-- **The run of `asm`** on the canonical target, `fuel` steps at most,
summarised: the `out` text, the other events, why it stopped, the steps,
and the shared messages in the stack pool; or why the target refuses the
load. `refuseOut`: the kernel refuses every `write` to fd 1. -/
def runAsm (asm : String) (fuel : Nat) (refuseOut := false) : String :=
  let prog := progOf asm
  let Λ := (layoutIn asm prog).1
  match (target (kernel slots) Entry.linux).load asm Λ with
  | some c =>
    let r := run abi Arch.armv8 pcOf { marksIn prog with refuseOut } fuel 0 { cfg := c }
    s!"out={repr r.outText} events={r.other} stop={r.stop} steps={r.steps} " ++
      s!"poolMsgs={msgsIn r.cfg Λ.stackPool}"
  | none => "load refused"

/-- **A return address against the stack map**, both read from model
memory: the label of the stack map's first entry (`.quad` label of entry 0)
and its address in the layout; the run of `asm` until a thread's frame
record (`[x29 + 8]`, private stack memory) holds that address, i.e. the
callee of that call site has built its frame; then the frame's return
address and the table's word for the entry (shared memory at
`scc_stackmap + 8`, the loader's `.rodata` image). -/
def raCheck (asm : String) (fuel : Nat) : String :=
  let prog := progOf asm
  let Λ := (layoutIn asm prog).1
  let ro := ((dataSections asm).map (·.rodata)).getD []
  match (Kraken.DataImage.quadLabels ro).head?, (rodataSyms Λ ro).lookup "scc_stackmap" with
  | some l0, some tbl =>
    match resolveIn prog l0, (target (kernel slots) Entry.linux).load asm Λ with
    | some ra, some c =>
      let frameRa (c : Config isaLSE2 × Kernel.KState) : Option Nat :=
        c.1.threads.toList.findSome? fun t =>
          let fp := regVal t.st (.x 29)
          (privLoad t.st (fp + 8)).bind fun v => if v.toNat = ra then some v.toNat else none
      let r := runUntil abi Arch.armv8 pcOf (marksIn prog) (fun c => (frameRa c).isSome) fuel 0 { cfg := c }
      s!"label={l0} model={ra} frame={frameRa r.cfg} table={sharedWord r.cfg.1 (tbl + 8)} " ++
        s!"steps={r.steps} stop={r.stop}"
    | _, _ => "no label address or load refused"
  | _, _ => "no stack map"

/-! ## The layout of `hello.w`

The walk handles every line of the text; the transfer sites (`take`,
`release`) resolve to the runtime's site labels; the abort labels resolve
to the abort routines' labelled `exit_group` (`scc_rt_abort_<kind>_exit`). -/

/-- info: [] -/
#guard_msgs in
#eval (layoutIn helloAsm (progOf helloAsm)).2

/-- info: (some 4196288, some 4196344, [some 4198604, some 4198676, some 4198748, some 4198892, some 4198820]) -/
#guard_msgs in
#eval let μ := marksIn (progOf helloAsm)
  (μ.take, μ.release, [AbortKind.overflow, .heap, .stack, .threads, .writeErr].map μ.abortAt)

/-! ## Running `hello.w` and `handoff.w`

`hello.w` prints `Hello, world` and exits with 0, `handoff.w` exits with
42; with every `write` to fd 1 refused, `hello.w` takes the runtime's write
abort. What the runs show against the statement (`Scc/DESIGN.md` §7.4):

- The threads' pool stacks are taken at the transfer sites, so their
  writes are private: no shared write lands in the stack pool
  (`poolMsgs`, the count of such writes, which `InLayout` forbids, is 0).
- The abort routine's `exit_group(101)` is labelled
  `scc_rt_abort_write_exit`, which is `Λ.abortLbl .writeErr`: with every
  `write` to fd 1 refused the run ends with the outcome `abort writeErr`
  (`abort 4`) after the `writeErr` event. -/

/-- info: "out=\"Hello, world\\n\" events=[exit 0] stop=exited steps=1169 poolMsgs=0" -/
#guard_msgs in
#eval runAsm helloAsm 2000

/-- info: "out=\"\" events=[exit 42] stop=exited steps=988 poolMsgs=0" -/
#guard_msgs in
#eval runAsm handoffAsm 2000

/-- info: "out=\"\" events=[writeErr, abort 4] stop=exited steps=1250 poolMsgs=0" -/
#guard_msgs in
#eval runAsm helloAsm 2000 (refuseOut := true)

/-! ## A return address against the stack map

After the first stack-map call site, its callee's frame record holds the
return address the call left, and the `.rodata` table's entry for that site
holds the same address: the loader's sizes and image agree with the code. -/

/-- info: "label=.L0_scc_rt_start.sp2 model=4194376 frame=(some 4194376) table=(some 4194376) steps=22 stop=condition" -/
#guard_msgs in
#eval raCheck helloAsm 2000

end Scc.Sem.Test.RunA64
