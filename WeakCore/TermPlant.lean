          (stOf mem pairs th).vs.coh ⟨ad.label, o⟩ < t → h ≤ t) ∧
      (∀ rt w ad, evalAt th.env b = some (rt, [w]) → w.val = .loc ad 0 → (CE η).pfr ad.label ≠ none →
        ∃ Sp, MemHeldL (CE η) (stOf mem pairs th) H Sp ∧ SlotPayS (CE η) (stOf mem pairs th) Sp cr db ad.label)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hSub : PwSubS) (hSig : PwSig) (hTy : TyOKE g (CE η)) (hown1 : PubLe1 th Rf Rs H := by assumption)
    (hz0 : ∀ l, ¬ g.zf l := by exact fun _ h => h)
    (hPb : ∀ y a e rt ws ad, th.term = .let_ y (.publish a) e → evalAt th.env a = some (rt, ws) →
      ws.map (·.val) = [.loc ad 0] → g.pf ad.label := by exact fun _ _ _ _ _ _ _ _ _ => trivial) (hDy : DyFr p annNew (progTgts p) η th.σs th.term) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      (OwnFrOp (CE η) cx th → r.1 = mem) ∧ Ok r → ∃ Tot H' C F cr' db' Gd plh,
      ThInvMCFQK (fun E' => BiOut th E' ∧ KeepQRS (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th cr cr' plh ∧
          IniFixZ { g with zf := fun l => (CE η).pfr l ≠ none ∧ (CE η).ini l ≤ (CE η).rini l } (CE η) E'
            (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) ∧
          BiRcOut (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th)
        p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 Tot H' cr' db' ∧
      MintStep g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧ ClaimAtP th C F ∧
      Drop (CE η) (stOf mem pairs th) Gd ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr' + pSum (stOf mem pairs th) db + C + Res.sum (Gd.map GdE.R) +
          pSum (stOf r.1 r.2.1 r.2.2) plh ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db' + F ∧
      (PubShape cx th → GdCovT (CE η) (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) Gd th) ∧
        (¬ PubShape cx th → Gd = []) := by
  have hZ2 : ZOK { g with zf := fun l => (CE η).pfr l ≠ none ∧ (CE η).ini l ≤ (CE η).rini l } (CE η) th := by
    intro l _ hzl x b i v e ht rt w ad rti wi n h1 h2 h3 h4 hl hpf hrc
    subst hl
    have hlo := (hbi x b i v e ht).1 rt w ad rti wi n h1 h2 h3 h4 hpf hrc
    exact ⟨hlo, Nat.lt_of_lt_of_le hlo hzl.2⟩
  have h := tstepMCF_stepTKAC (hDy := hDy) (g := { g with zf := fun l => (CE η).pfr l ≠ none ∧ (CE η).ini l ≤ (CE η).rini l })
    (hZ := hZ2) (hPb := hPb) (Ok := Ok) hP hp hn hnd hsc hT hCk hi hE htv hm hH hpx hC hia hdw hwp hwin hfo hrmw hbf
    hpo hle hni hclo hbi hRP hPS hSub hSig hTy hown1
  refine ⟨h.1, fun r hr hpa hok => ?_⟩
  obtain ⟨Tot, H', C, F, cr', db', Gd, plh, ⟨E', hq, hF, hR⟩, hMS, hR2⟩ := h.2 r hr hpa hok
  exact ⟨Tot, H', C, F, cr', db', Gd, plh, ⟨E', ⟨hq.1, hq.2.1, hF.iniFixZ, hq.2.2⟩, efootDrop hz0 hF, hR⟩, mintStepDrop hMS, hR2⟩
#print axioms TermPlant.tstepMCF_stepTKA_zfC

/-- (plantFrozen) **The thread step keeps the counts of frozen cells**: `tstepMCF_stepTKA`
at a `g` without ghost labels (e.g. `gOf`), whose witness also satisfies `IniFixZ` at the
ghost labels `Zη l := pfr l ≠ none ∧ ini l ≤ rini l`.  The step runs at
`{ g with zf := Zη }` (the machine does not read `zf`); the `bufInit` guard `ZOK` there is
BH1 (`hbi.1`) plus `ini ≤ rini`. -/
theorem tstepMCF_stepTKA_zf {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {Rf Rs H : Res} {cr db : Ts → Res}
    [ProgRetIall p] [TermA4.ProgCkWC p] (hP : ProgT p) (hp : g.p = p) (hn : 0 < g.n) (hnd : isDone th = false)
    (hsc : StepScope cx th.term ∨ StepScopeR th.σs cx th.term)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeld (CE η) (stOf mem pairs th) H)
    (hpx : PAx g mem pairs th) (hC : PromCrK (CE η) (stOf mem pairs th) cr db)
    (hia : StoreIall ρ η cx th)
    (hdw : StoreCrZ η cx (stOf mem pairs th) th)
    (hwp : ∀ x a e rt ws ad, th.term = .let_ x (.publish a) e → evalAt th.env a = some (rt, ws) →
      ws.map (·.val) = [.loc ad 0] → FlipOK (CE η) (stOf mem pairs th) ad.label)
    (hwin : PubWinT (CE η) (stOf mem pairs th) th)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hrmw : NoPlantRMW (CE η) th) (hbf : g.boxFence = true)
    {Ok : Memory × List Ts × TTh → Prop}
    (hpo : OwnFrOp (CE η) cx th → ∀ lab c, (CE η).sto lab = some c → c.owner = some (CE η).tid →
      (CE η).pfr lab ≠ none → OpTgt th lab → PlantOp g mem pairs th (CE η) cr Ok lab c)
    (hni : OpNI cx th)
    (hclo : ∀ lab c, (CE η).sto lab = some c → Clo c.ty)
    (hbi : ∀ x b i v e, th.term = .let_ x (.bufInit b i v) e →
      (∀ rt w ad rti wi n, evalAt th.env b = some (rt, [w]) → w.val = .loc ad 0 →
        evalAt th.env i = some (rti, [wi]) → numOf [wi] = some n → (CE η).pfr ad.label ≠ none →
        (CE η).rc ad.label ≤ n → n < (CE η).ini ad.label) ∧
      (∀ rt w ad, evalAt th.env b = some (rt, [w]) → w.val = .loc ad 0 → (CE η).pfr ad.label ≠ none →
        ∀ o, PredU (CE η) ⟨ad.label, o⟩ → ∃ h, FirstW (stOf mem pairs th).mem ⟨ad.label, o⟩ h ∧
        h ∈ (stOf mem pairs th).promises ∧ ∀ t m, t ∈ (stOf mem pairs th).promises →
          (stOf mem pairs th).mem[t]? = some m → m.loc = ⟨ad.label, o⟩ →
          (stOf mem pairs th).vs.coh ⟨ad.label, o⟩ < t → h ≤ t) ∧
      (∀ rt w ad, evalAt th.env b = some (rt, [w]) → w.val = .loc ad 0 → (CE η).pfr ad.label ≠ none →
        ∃ Sp, MemHeldL (CE η) (stOf mem pairs th) H Sp ∧ SlotPayS (CE η) (stOf mem pairs th) Sp cr db ad.label)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hSub : PwSubS) (hSig : PwSig) (hTy : TyOKE g (CE η)) (hown1 : PubLe1 th Rf Rs H := by assumption)
    (hz0 : ∀ l, ¬ g.zf l := by exact fun _ h => h)
    (hPb : ∀ y a e rt ws ad, th.term = .let_ y (.publish a) e → evalAt th.env a = some (rt, ws) →
      ws.map (·.val) = [.loc ad 0] → g.pf ad.label := by exact fun _ _ _ _ _ _ _ _ _ => trivial) (hDy : DyFr p annNew (progTgts p) η th.σs th.term) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      (OwnFrOp (CE η) cx th → r.1 = mem) ∧ Ok r → ∃ Tot H' C F cr' db' Gd plh,
      ThInvMCFQK (fun E' => BiOut th E' ∧ KeepQRS (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th cr cr' plh ∧
          IniFixZ { g with zf := fun l => (CE η).pfr l ≠ none ∧ (CE η).ini l ≤ (CE η).rini l } (CE η) E'
            (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2))
        p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 Tot H' cr' db' ∧
      MintStep g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧ ClaimAtP th C F ∧
      Drop (CE η) (stOf mem pairs th) Gd ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr' + pSum (stOf mem pairs th) db + C + Res.sum (Gd.map GdE.R) +
          pSum (stOf r.1 r.2.1 r.2.2) plh ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db' + F ∧
      (PubShape cx th → GdCovT (CE η) (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) Gd th) ∧
        (¬ PubShape cx th → Gd = []) :=
  have h := tstepMCF_stepTKA_zfC (hDy := hDy) (cr₁ := cr) (hle := fun _ _ _ _ _ _ _ _ _ _ => Res.le_refl _) hP hp hn hnd hsc hT hCk hi hE htv hm hH hpx hC hia hdw hwp hwin hfo hrmw hbf hpo hni hclo hbi hRP hPS hSub hSig hTy hown1 hz0 hPb
  ⟨h.1, fun r hr hpa hq0 => let ⟨Tot, H', C, F, cr', db', Gd, plh, ⟨E', hq, h1⟩, h2⟩ := h.2 r hr hpa hq0
    ⟨Tot, H', C, F, cr', db', Gd, plh, ⟨E', ⟨hq.1, hq.2.1, hq.2.2.1⟩, h1⟩, h2⟩⟩
#print axioms tstepMCF_stepTKA_zf

/-- (KeepQX) **The kept credits of a thread step, lower-bound form** (the `hcrK`): an
optional single transfer `rk = (h, h')` (the `bufInit` re-key, P-a), and every other
surviving promise whose credit was an old credit or a key-free plant credit BEFORE the step
keeps it. -/
def KeepQX (E : TEnv) (s s' : St) (cr cr' : Ts → Res) : Prop :=
  ∃ rk : Option (Ts × Ts),
    (∀ h h', rk = some (h, h') → h ∈ s.promises ∧ h ∉ s'.promises ∧ h' ∈ s'.promises ∧ cr h' + cr h ≤ cr' h') ∧
    ∀ t, t ∈ s'.promises → (∀ hh, rk = some hh → t ≠ hh.2) →
      ((∃ m, s.mem[t]? = some m ∧ OldCr E s m t (cr t)) ∨
        (∃ m, s.mem[t]? = some m ∧ PlantCr E s m t (cr t) ∧ CrKeys (cr t))) → cr t ≤ cr' t

/-- (KeepQX) `KeepPl` (post-state plant guard) gives `KeepQX` (pre-state guard, no
transfer) along a step: a pre-state plant credit is still one after it (`PlantCr_step`). -/
theorem keepQX_of_keepPl {g : G} {E E' : TEnv} {s s' : St} {cr cr' : Ts → Res}
    (hK : KeepPl E E' s s' cr cr') (hF : EFoot g E E' s s') (hm : MemInv g E s) (hx : TermLiveProps.Ext s s') :
    KeepQX E s s' cr cr' := by
  refine ⟨none, (fun _ _ h => by cases h), fun t ht _ h => ?_⟩
  suffices hk : cr' t = cr t by rw [hk]; exact Res.le_refl _
  refine hK t ht ?_
  rcases h with h | ⟨m, hm', hpc, hk⟩
  · exact .inl h
  · have hlt : t < s.mem.size := hm.2.2.1 t (hx.prom t ht)
    exact .inr ⟨m, by rw [hx.mem.get t hlt]; exact hm', PlantCr_step hF hm hx hpc, hk⟩
#print axioms keepQX_of_keepPl

/-- (KeepQX) Off `publish`, `KeepQ` gives `KeepQX`. -/
theorem keepQX_of_keepQ {g : G} {E E' : TEnv} {s s' : St} {th : TTh} {cr cr' : Ts → Res}
    (hK : KeepQ E E' s s' th cr cr') (hnp : ∀ x a e, th.term ≠ .let_ x (.publish a) e)
    (hF : EFoot g E E' s s') (hm : MemInv g E s) (hx : TermLiveProps.Ext s s') :
    KeepQX E s s' cr cr' :=
  keepQX_of_keepPl (hK hnp).1 hF hm hx
#print axioms keepQX_of_keepQ

/-- (OvW3 R2) `KeepQX` survives raising the new credits. -/
theorem keepQX_mono {E : TEnv} {s s' : St} {cr cr0 cr' : Ts → Res} (hK : KeepQX E s s' cr cr0)
    (hle : ∀ t, cr0 t ≤ cr' t) : KeepQX E s s' cr cr' := by
  obtain ⟨rk, h1, h2⟩ := hK
  exact ⟨rk, fun a b e => let ⟨x1, x2, x3, x4⟩ := h1 a b e; ⟨x1, x2, x3, Res.le_trans x4 (hle b)⟩,
    fun t ht hn ho => Res.le_trans (h2 t ht hn ho) (hle t)⟩
#print axioms TermPlant.keepQX_mono

/-- (OvW3 R2) Off `publish`, `KeepQR` gives `KeepQX` (the re-pin credits only raise `cr'`). -/
theorem keepQX_of_keepQR {g : G} {E E' : TEnv} {s s' : St} {th : TTh} {cr cr' : Ts → Res}
    (hK : KeepQR E E' s s' th cr cr') (hnp : ∀ x a e, th.term ≠ .let_ x (.publish a) e)
    (hF : EFoot g E E' s s') (hm : MemInv g E s) (hx : TermLiveProps.Ext s s') :
    KeepQX E s s' cr cr' :=
  let ⟨_, hK0, hle⟩ := keepQR_le hK
  keepQX_mono (keepQX_of_keepQ hK0 hnp hF hm hx) hle
#print axioms TermPlant.keepQX_of_keepQR

/-- (pool) Off `publish`, `KeepQRS` gives `KeepQX` (the credited re-pins only raise `cr'`). -/
theorem keepQX_of_keepQRS {g : G} {E E' : TEnv} {s s' : St} {th : TTh} {cr cr' plh : Ts → Res}
    (hK : KeepQRS E E' s s' th cr cr' plh) (hnp : ∀ x a e, th.term ≠ .let_ x (.publish a) e)
    (hF : EFoot g E E' s s') (hm : MemInv g E s) (hx : TermLiveProps.Ext s s') :
    KeepQX E s s' cr cr' :=
  let ⟨_, hK0, hle⟩ := keepQRS_le hK
  keepQX_mono (keepQX_of_keepQ hK0 hnp hF hm hx) hle
#print axioms TermPlant.keepQX_of_keepQRS

end TermPlant

