/-! ## (KeepPl) The thread step keeps the plant credits (`dropA`) -/

/-- (KeepPl) **Swapping `dropP` for `dropA`** on the step's promises `s'` (a
duplicate-free sublist of `s`'s) costs at most the plant credits `dropP` dropped at `s`. -/
theorem pSum_dropA_swap {E E' : TEnv} {s s' : St} {cr : Ts → Res}
    (hsub : ∀ t, t ∈ s'.promises → t ∈ s.promises) (hnd : s'.promises.Nodup) :
    pSum s' (dropA E E' s s' cr) + pSum s (dropP E s cr) ≤ pSum s' (dropP E s cr) + pSum s cr := by
  obtain ⟨d, hd⟩ : ∃ d : Ts → Res, ∀ t k, d t k = dropA E E' s s' cr t k - dropP E s cr t k :=
    ⟨fun t k => dropA E E' s s' cr t k - dropP E s cr t k, fun _ _ => rfl⟩
  have e : ∀ t, dropA E E' s s' cr t = dropP E s cr t + d t := fun t => Res.ext fun k => by
    have h1 := (dropP_le_dropA (E := E) (E' := E') (s := s) (s' := s') (cr := cr) t) k
    rw [Res.add_apply, hd]
    omega
  have e1 := sum_map_split e s'.promises
  have e2 := sum_map_split e s.promises
  have h3 := sum_sub_le (f := d) hnd hsub
  have h4 := pSum_dropA_le (E := E) (E' := E') (s := s) (s0 := s) (s1 := s') (cr := cr)
  intro k
  have a1 := congrArg (fun R : Res => R k) e1
  have a2 := congrArg (fun R : Res => R k) e2
  have a3 := h3 k
  have a4 := h4 k
  simp only [pSum, Res.add_apply] at a1 a2 a3 a4 ⊢
  omega
#print axioms pSum_dropA_swap

/-- (KeepPl) **`PromCrK` at `dropA`**: `dropA` is `dropP` except at a key-free plant
credit after the step. -/
theorem PromCrK_dropA {E E' : TEnv} {s s' : St} {cr db : Ts → Res} (h : PromCr E' s' (dropP E s cr) db) :
    PromCrK E' s' (dropA E E' s s' cr) db := by
  intro tw htw
  obtain ⟨m, hm, hd, hc⟩ := h tw htw
  refine ⟨m, hm, hd, ?_⟩
  by_cases hpl : ∃ m1, s'.mem[tw]? = some m1 ∧ PlantCr E' s' m1 tw (cr tw) ∧ CrKeys (cr tw)
  · obtain ⟨m1, hm1, hp, hk⟩ := hpl
    have e : m = m1 := Option.some.inj (hm.symm.trans hm1)
    subst e
    rw [dropA_pos (Or.inr ⟨m, hm1, hp, hk⟩)]
    exact .inr ⟨hp, hk⟩
  · have e : dropA E E' s s' cr tw = dropP E s cr tw := by
      by_cases ho : ∃ m0, s.mem[tw]? = some m0 ∧ OldCr E s m0 tw (cr tw)
      · obtain ⟨m0, hm0, ho0⟩ := ho
        rw [dropA_pos (Or.inl ⟨m0, hm0, ho0⟩), dropP_of_old hm0 ho0]
      · rw [dropA_neg (fun h => h.elim ho hpl)]
        unfold dropP
        split
        · next h => exact absurd h ho
        · rfl
    rw [e]
    exact .inl hc
#print axioms PromCrK_dropA

/-- (KeepPl) **The step keeps the credits**: each promise left after the step from `s`
(at `E`) to `s'` (at `E'`) keeps its credit if it was an old credit before the step or is
a key-free plant credit after it. -/
def KeepPl (E E' : TEnv) (s s' : St) (cr cr' : Ts → Res) : Prop :=
  ∀ t, t ∈ s'.promises →
    ((∃ m, s.mem[t]? = some m ∧ OldCr E s m t (cr t)) ∨
      (∃ m, s'.mem[t]? = some m ∧ PlantCr E' s' m t (cr t) ∧ CrKeys (cr t))) → cr' t = cr t

theorem KeepPl_dropA {E E' : TEnv} {s s' : St} {cr : Ts → Res} : KeepPl E E' s s' cr (dropA E E' s s' cr) :=
  fun _ _ h => dropA_pos h
#print axioms KeepPl_dropA

/-- (KeepPl) Off `publish`, the new credits keep the old ones (`KeepPl`) and lie below
them. -/
def KeepQ (E E' : TEnv) (s s' : St) (th : TTh) (cr cr' : Ts → Res) : Prop :=
  (∀ x a e, th.term ≠ .let_ x (.publish a) e) → KeepPl E E' s s' cr cr' ∧ ∀ t, cr' t ≤ cr t

/-- (KeepPl) `ThInvMCFSQ` at `PromCrK`. -/
def ThInvMCFSQK (Q : TEnv → Prop) (p : Prog) (g : G) (E : TEnv) (s : St) (S0 : AllocLabel → List Res) (mem : Memory)
    (pairs : List Ts) (th : TTh) (Tot H : Res) (cr db : Ts → Res) : Prop :=
  ∃ E', Q E' ∧ EFoot g E E' s (stOf mem pairs th) ∧ SeenOK E E' Tot H ∧ BoxNewV E E' s th ∧ ThInvRE p E' th Tot ∧
    MemInv g E' (stOf mem pairs th) ∧ MemHeldK E s S0 E' (stOf mem pairs th) H ∧ PromCrK E' (stOf mem pairs th) cr db

theorem ThInvMCFSQK.toFQK {Q : TEnv → Prop} {p : Prog} {g : G} {E : TEnv} {s : St} {S0 : AllocLabel → List Res}
    {mem : Memory} {pairs : List Ts} {th : TTh} {Tot H : Res} {cr db : Ts → Res}
    (h : ThInvMCFSQK Q p g E s S0 mem pairs th Tot H cr db) : ThInvMCFQK Q p g E s mem pairs th Tot H cr db :=
  let ⟨E', hq, h0, hSK, hBV, h1, h2, h3, h4⟩ := h
  ⟨E', hq, h0, (by seenT), (by boxT), h1, h2, h3.memHeld, h4⟩
#print axioms ThInvMCFSQK.toFQK

theorem ThInvMCFSQK.mono {Q Q' : TEnv → Prop} {p : Prog} {g : G} {E : TEnv} {s : St} {S0 : AllocLabel → List Res}
    {mem : Memory} {pairs : List Ts} {th : TTh} {Tot H : Res} {cr db : Ts → Res} (hQ : ∀ E', Q E' → Q' E')
    (h : ThInvMCFSQK Q p g E s S0 mem pairs th Tot H cr db) : ThInvMCFSQK Q' p g E s S0 mem pairs th Tot H cr db :=
  let ⟨E', hq, h0⟩ := h
  ⟨E', hQ E' hq, h0⟩
#print axioms ThInvMCFSQK.mono

theorem ThInvMCFSQK.ofS {Q : TEnv → Prop} {p : Prog} {g : G} {E : TEnv} {s : St} {S0 : AllocLabel → List Res}
    {mem : Memory} {pairs : List Ts} {th : TTh} {Tot H : Res} {cr db : Ts → Res} (hQ : ∀ E', Q E')
    (h : ThInvMCFS p g E s S0 mem pairs th Tot H cr db) : ThInvMCFSQK Q p g E s S0 mem pairs th Tot H cr db :=
  let ⟨E', h0, h1, h2, h3, h4, h5, h6⟩ := h
  ⟨E', hQ E', h0, h1, h2, h3, h4, h5, PromCrK_of h6⟩
#print axioms ThInvMCFSQK.ofS

/-- (KeepPl) **From `dropP` to `dropA`**: a step's `ThInvMCFSQ` at the dropped credits
gives one at `dropA` (`PromCrK`, `KeepQ`), at the cost of `pSum_dropA_swap`. -/
theorem ThInvMCFSQ.toKA {Q0 : TEnv → Prop} {p : Prog} {g : G} {E : TEnv} {s : St} {S0 : AllocLabel → List Res}
    {mem : Memory} {pairs : List Ts} {th : TTh} {Tot H : Res} {cr db : Ts → Res} {th0 : TTh}
    (h : ThInvMCFSQ Q0 p g E s S0 mem pairs th Tot H (dropP E s cr) db)
    (hsub : ∀ t, t ∈ th.promises → t ∈ s.promises) :
    ∃ cr', ThInvMCFSQK (fun E' => Q0 E' ∧ KeepQ E E' s (stOf mem pairs th) th0 cr cr') p g E s S0 mem pairs th
        Tot H cr' db ∧
      pSum (stOf mem pairs th) cr' + pSum s (dropP E s cr) ≤ pSum (stOf mem pairs th) (dropP E s cr) + pSum s cr ∧
      pSum (stOf mem pairs th) cr' ≤ pSum (stOf mem pairs th) cr := by
  obtain ⟨E', hq, h0, h1, h2, h3, hm', h5, hC⟩ := h
  exact ⟨dropA E E' s (stOf mem pairs th) cr,
    ⟨E', ⟨hq, fun _ => ⟨KeepPl_dropA, dropA_le⟩⟩, h0, h1, h2, h3, hm', h5, PromCrK_dropA hC⟩,
    pSum_dropA_swap hsub (MemInv_nodup hm'), pSum_dropA_le⟩
#print axioms ThInvMCFSQ.toKA

/-- (KeepPl) `stepOut_ofFSQ` for a fulfilling step (credits at `cr` on the left),
concluding at `dropA`. -/
theorem stepOut_ofFSA {QE : TEnv → Prop} {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {cx : Cx} {η : TEnv}
    {Rf Rs H : Res} {cr db : Ts → Res} {Q : Memory × List Ts × TTh → Prop}
    (hnps : ¬ PubShape cx th)
    (h : tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → Q r →
      ∃ Tot H' C F, ThInvMCFSQ QE p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H'
          (dropP (CE η) (stOf mem pairs th) cr) db ∧
        MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
        Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
          Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → Q r →
      ∃ Tot H' C F cr' db' Gd,
      ThInvMCFSQK (fun E' => QE E' ∧ KeepQ (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th cr cr')
        p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr' db' ∧
      MintStep g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧ ClaimAt th.term C F ∧
      Drop (CE η) (stOf mem pairs th) Gd ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr' + pSum (stOf mem pairs th) db + C + Res.sum (Gd.map GdE.R) ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db' + F ∧
      (PubShape cx th → GdCovT (CE η) (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) Gd th) ∧
        (¬ PubShape cx th → Gd = []) :=
  ⟨h.1, fun r hr hpa hq => by
    obtain ⟨Tot, H', C, F, h1, h2, h3⟩ := h.2 r hr hpa hq
    obtain ⟨cr', hK, -, hle⟩ := ThInvMCFSQ.toKA (th0 := th) h1 (TermLiveProps.tstep_ext g mem pairs th r hr).prom
    refine ⟨Tot, H', C, F, cr', db, [], hK, h2.toM, h2.claimAt _, Drop_nil, G_nil (Res.le_def.2 fun k => ?_),
      fun hps => absurd hps hnps, fun _ => rfl⟩
    have e1 := h3 k
    have e2 := hle k
    simp only [Res.add_apply] at e1 e2 ⊢
    omega⟩
#print axioms stepOut_ofFSA

/-- (KeepPl) `stepOut_ofNSQ` concluding at `dropA`. -/
theorem stepOut_ofNSA {QE : TEnv → Prop} {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {cx : Cx} {η : TEnv}
    {Rf Rs H : Res} {cr db : Ts → Res} {Q : Memory × List Ts × TTh → Prop}
    (hnps : ¬ PubShape cx th)
    (hm : MemInv g (CE η) (stOf mem pairs th)) (hC : PromCrP (CE η) (stOf mem pairs th) cr db)
    (h : tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      ∃ Tot H', ThInvMKQ QE p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → Q r →
      ∃ Tot H' C F cr' db' Gd,
      ThInvMCFSQK (fun E' => QE E' ∧ KeepQ (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th cr cr')
        p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr' db' ∧
      MintStep g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧ ClaimAt th.term C F ∧
      Drop (CE η) (stOf mem pairs th) Gd ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr' + pSum (stOf mem pairs th) db + C + Res.sum (Gd.map GdE.R) ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db' + F ∧
      (PubShape cx th → GdCovT (CE η) (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) Gd th) ∧
        (¬ PubShape cx th → Gd = []) := by
  have h2 := mc_liftAQ hm (PromCrP_drop hC) h
  refine ⟨h2.1, fun r hr hpa _ => ?_⟩
  obtain ⟨Tot, H', C, F, h1, h3, h4⟩ := h2.2 r hr hpa
  obtain ⟨cr', hK, hsw, -⟩ := ThInvMCFSQ.toKA (th0 := th) h1 (TermLiveProps.tstep_ext g mem pairs th r hr).prom
  refine ⟨Tot, H', C, F, cr', db, [], hK, h3.toM, h3.claimAt _, Drop_nil, G_nil (Res.le_def.2 fun k => ?_),
    fun hps => absurd hps hnps, fun _ => rfl⟩
  have e1 := h4 k
  have e2 := hsw k
  simp only [Res.add_apply] at e1 e2 ⊢
  omega
#print axioms stepOut_ofNSA

/-! ## (OvW3 R2) Re-pin items at own fulfils: `KeepQR` and the credit bridge

The re-pin definitions and item lemmas live in `TermPiece` (OvW3 R2 relocation). -/

/-- (OvW3 R2) `KeepQ` with re-pins: the old new credits `cr0` keep `KeepQ`; `cr'` adds the
re-pin items' credits. -/
def KeepQR (E E' : TEnv) (s s' : St) (th : TTh) (cr cr' : Ts → Res) : Prop :=
  ∃ cr0 RS, KeepQ E E' s s' th cr cr0 ∧ (∀ t, cr' t = cr0 t + rpSum RS t) ∧
    RepinQ E' s' cr' RS ∧ RepinCov E E' s s' th RS

/-! ## (OvW3 R2) Re-pin credit sums -/

/-! ## (OvW3 R2) Monotonicity, `KeepQR` from `KeepQ` -/

/-- (OvW3 R2) `KeepQ` with no re-pin items is `KeepQR`, given the (vacuous) cover. -/
theorem keepQR_of_keepQ {E E' : TEnv} {s s' : St} {th : TTh} {cr cr' : Ts → Res}
    (hK : KeepQ E E' s s' th cr cr') (hV : RepinCov E E' s s' th []) : KeepQR E E' s s' th cr cr' :=
  ⟨cr', [], hK, fun t => by rw [rpSum_nil, Res.add_zero], fun y hy => absurd hy List.not_mem_nil, hV⟩
#print axioms TermPlant.keepQR_of_keepQ

/-- (PubKeep) **At `publish`, the step keeps the old and key-free plant credits** of the
outstanding promises at frontier cells (`KeepQ` is vacuous there). -/
def PubKeep (E : TEnv) (s s' : St) (th : TTh) (cr cr' : Ts → Res) : Prop :=
  (∃ x a e, th.term = .let_ x (.publish a) e) →
    ∀ t m, t ∈ s'.promises → s.mem[t]? = some m → E.pfr m.loc.label ≠ none →
      (OldCr E s m t (cr t) ∨ (PlantCr E s m t (cr t) ∧ CrKeys (cr t))) → cr' t = cr t

/-- (PubKeep) Off `publish`, `PubKeep` is vacuous. -/
theorem pubKeep_np {E : TEnv} {s s' : St} {th : TTh} {cr cr' : Ts → Res}
    (h : ∀ x a e, th.term ≠ .let_ x (.publish a) e) : PubKeep E s s' th cr cr' :=
  fun ⟨x, a, e, ht⟩ => absurd ht (h x a e)
#print axioms TermPlant.pubKeep_np

/-- (OvW3 R2) Off `publish`, `KeepQR`'s credits lie above the kept old ones. -/
theorem keepQR_le {E E' : TEnv} {s s' : St} {th : TTh} {cr cr' : Ts → Res}
    (hK : KeepQR E E' s s' th cr cr') : ∃ cr0, KeepQ E E' s s' th cr cr0 ∧ ∀ t, cr0 t ≤ cr' t :=
  let ⟨cr0, RS, h1, h2, _⟩ := hK
  ⟨cr0, h1, fun t => by rw [h2 t]; exact Res.le_add_right _ _⟩
#print axioms TermPlant.keepQR_le

/-- (pool, route B) **`KeepQ` with re-pins split into credited and pool items**: the credited
items `RSc` (holder below the label's frontier messages) raise `cr'`; the pool items `RSh` are
carried per promise by `plh`. -/
def KeepQRS (E E' : TEnv) (s s' : St) (th : TTh) (cr cr' plh : Ts → Res) : Prop :=
  ∃ cr0 RSc RSh, KeepQ E E' s s' th cr cr0 ∧ (∀ t, cr' t = cr0 t + rpSum RSc t) ∧ RepinQU E' s' cr' RSc ∧
    (∀ y ∈ RSc, HolderFp E' s' y) ∧ RepinQh E' s' RSh ∧ (∀ y ∈ RSh, ¬ HolderFp E' s' y) ∧
    (∀ t, plh t = rpSum RSh t) ∧ (∀ t, plh t ≠ .zero → t ∈ s'.promises) ∧ (∀ t, CrKeys (plh t)) ∧
    RepinCovS E E' s s' th RSc RSh ∧
    FulP E s s' th ∧
    RcKeepP E E' s s' th ∧
    PubKeep E s s' th cr cr'

/-- (pool) `KeepQRS`'s credits lie above the kept old ones. -/
theorem keepQRS_le {E E' : TEnv} {s s' : St} {th : TTh} {cr cr' plh : Ts → Res}
    (hK : KeepQRS E E' s s' th cr cr' plh) : ∃ cr0, KeepQ E E' s s' th cr cr0 ∧ ∀ t, cr0 t ≤ cr' t :=
  let ⟨cr0, _, _, h1, h2, _⟩ := hK
  ⟨cr0, h1, fun t => by rw [h2 t]; exact Res.le_add_right _ _⟩
#print axioms TermPlant.keepQRS_le

/-- (pool) `KeepQRS`'s new pool items sit at outstanding promises after the step. -/
theorem keepQRS_plhMem {E E' : TEnv} {s s' : St} {th : TTh} {cr cr' plh : Ts → Res}
    (hK : KeepQRS E E' s s' th cr cr' plh) : ∀ t, plh t ≠ .zero → t ∈ s'.promises :=
  let ⟨_, _, _, _, _, _, _, _, _, _, h, _⟩ := hK
  h
#print axioms TermPlant.keepQRS_plhMem

/-- (pool) `KeepQRS`'s new pool items are key-free. -/
theorem keepQRS_plhKeys {E E' : TEnv} {s s' : St} {th : TTh} {cr cr' plh : Ts → Res}
    (hK : KeepQRS E E' s s' th cr cr' plh) : ∀ t, CrKeys (plh t) :=
  let ⟨_, _, _, _, _, _, _, _, _, _, _, h, _⟩ := hK
  h
#print axioms TermPlant.keepQRS_plhKeys

/-- (pool) `KeepQ` with no re-pin items is `KeepQRS` (zero pool), given the (vacuous) cover. -/
theorem keepQRS_of_keepQ {E E' : TEnv} {s s' : St} {th : TTh} {cr cr' : Ts → Res}
    (hK : KeepQ E E' s s' th cr cr') (hV : RepinCovS E E' s s' th [] []) (hF : FulP E s s' th)
    (hR : RcKeepP E E' s s' th) (hPK : PubKeep E s s' th cr cr') :
    KeepQRS E E' s s' th cr cr' (fun _ => .zero) :=
  ⟨cr', [], [], hK, fun t => by rw [rpSum_nil, Res.add_zero], fun y hy => absurd hy List.not_mem_nil,
    fun y hy => absurd hy List.not_mem_nil, fun y hy => absurd hy List.not_mem_nil,
    fun y hy => absurd hy List.not_mem_nil, fun t => (rpSum_nil t).symm, fun t h => absurd rfl h,
    fun _ => CrKeys_zero, hV, hF, hR, hPK⟩
#print axioms TermPlant.keepQRS_of_keepQ

/-- (BI) **`KeepQRS` with the exclusion-free cover.** -/
def KeepQRSB (E E' : TEnv) (s s' : St) (th : TTh) (cr cr' plh : Ts → Res) : Prop :=
  ∃ cr0 RSc RSh, KeepQ E E' s s' th cr cr0 ∧ (∀ t, cr' t = cr0 t + rpSum RSc t) ∧ RepinQU E' s' cr' RSc ∧
    (∀ y ∈ RSc, HolderFp E' s' y) ∧ RepinQh E' s' RSh ∧ (∀ y ∈ RSh, ¬ HolderFp E' s' y) ∧
    (∀ t, plh t = rpSum RSh t) ∧ (∀ t, plh t ≠ .zero → t ∈ s'.promises) ∧ (∀ t, CrKeys (plh t)) ∧
    RepinCovSB E E' s s' th RSc RSh ∧
    FulP E s s' th ∧
    RcKeepP E E' s s' th ∧
    PubKeep E s s' th cr cr'

/-- (BI) `KeepQRSB` gives `KeepQRS`. -/
theorem keepQRS_of_B {E E' : TEnv} {s s' : St} {th : TTh} {cr cr' plh : Ts → Res}
    (hK : KeepQRSB E E' s s' th cr cr' plh) : KeepQRS E E' s s' th cr cr' plh :=
  let ⟨cr0, RSc, RSh, h1, h2, h3, h4, h5, h6, h7, h8, h9, hV, h10, h11, h12⟩ := hK
  ⟨cr0, RSc, RSh, h1, h2, h3, h4, h5, h6, h7, h8, h9, repinCovS_of_SB hV, h10, h11, h12⟩
#print axioms TermPlant.keepQRS_of_B

/-- (BI) `KeepQRS` gives `KeepQRSB` when the `bufInit`-at-`rc` exclusion holds at every target. -/
theorem keepQRSB_of_ex {E E' : TEnv} {s s' : St} {th : TTh} {cr cr' plh : Ts → Res}
    (hex : ∀ lab, OpTgtP th lab → ∀ x b i v e, th.term = .let_ x (.bufInit b i v) e → ∀ rti wi n,
      evalAt th.env i = some (rti, [wi]) → numOf [wi] = some n → n ≠ E.rc lab)
    (hK : KeepQRS E E' s s' th cr cr' plh) : KeepQRSB E E' s s' th cr cr' plh :=
  let ⟨cr0, RSc, RSh, h1, h2, h3, h4, h5, h6, h7, h8, h9, hV, h10, h11, h12⟩ := hK
  ⟨cr0, RSc, RSh, h1, h2, h3, h4, h5, h6, h7, h8, h9, fun lab hot => hV lab (hex lab hot) hot, h10, h11, h12⟩
#print axioms TermPlant.keepQRSB_of_ex

/-- (BI) Off `bufInit`, `KeepQRS` is `KeepQRSB`. -/
theorem keepQRSB_of_nb {E E' : TEnv} {s s' : St} {th : TTh} {cr cr' plh : Ts → Res}
    (hnb : ∀ x b i v e, th.term ≠ .let_ x (.bufInit b i v) e)
    (hK : KeepQRS E E' s s' th cr cr' plh) : KeepQRSB E E' s s' th cr cr' plh :=
  keepQRSB_of_ex (fun _ _ x b i v e ht => absurd ht (hnb x b i v e)) hK
#print axioms TermPlant.keepQRSB_of_nb

/-- (BI) `ThInvMCFSQ` depends on the credit only at the post-state promises. -/
theorem ThInvMCFSQ.congrCr {Q : TEnv → Prop} {p : Prog} {g : G} {E : TEnv} {s : St} {S0 : AllocLabel → List Res}
    {mem : Memory} {pairs : List Ts} {th : TTh} {Tot H : Res} {cr cr2 db : Ts → Res}
    (he : ∀ t, t ∈ (stOf mem pairs th).promises → cr t = cr2 t)
    (h : ThInvMCFSQ Q p g E s S0 mem pairs th Tot H cr db) : ThInvMCFSQ Q p g E s S0 mem pairs th Tot H cr2 db :=
  let ⟨E', hq, h0, h1, h2, h3, h4, h5, hC⟩ := h
  ⟨E', hq, h0, h1, h2, h3, h4, h5, fun tw htw => by rw [← he tw htw]; exact hC tw htw⟩
#print axioms TermPlant.ThInvMCFSQ.congrCr

/-- (BI) **The `bufInit`-at-`rc` pool data** at the stepped thread (`hbiP`): at a frontier `bufInit`
at its buffer's real count, the credit splits as `cr₀ + plb` (`plb` on promises the step
discharges, above the pool credit `plf` at the guarded ones), with the slot pay at `cr₀` and the
pool items `Gs` at `plf` (per holder, their sum is below `plf`) covering every predicted, first-written,
overtaken unit of the cell. -/
def HbiP (g : G) (mem : Memory) (pairs : List Ts) (th : TTh) (η : TEnv) (H : Res) (cr cr₀ plb plf db : Ts → Res)
    (Ok : Memory × List Ts × TTh → Prop) : Prop :=
  ∀ x b i v e, th.term = .let_ x (.bufInit b i v) e → ∀ rt w ad rti wi,
    evalAt th.env b = some (rt, [w]) → w.val = .loc ad 0 →
    evalAt th.env i = some (rti, [wi]) → numOf [wi] = some ((CE η).rc ad.label) →
    (CE η).pfr ad.label ≠ none →
    ∃ (Sp : AllocLabel → List Res) (Gs : List (Ts × Nat × Ty × List Word × Res × (Nat → Bool))),
      (∀ t, cr t = cr₀ t + plb t) ∧ PromCrK (CE η) (stOf mem pairs th) cr₀ db ∧
      (∀ t, plb t ≠ .zero → t ∈ (stOf mem pairs th).promises ∧
        ∀ r ∈ tstep g mem pairs th, Ok r → t ∉ (stOf r.1 r.2.1 r.2.2).promises) ∧
      (∀ r ∈ tstep g mem pairs th, Ok r → ∀ t m, t ∈ (stOf mem pairs th).promises →
        t ∉ (stOf r.1 r.2.1 r.2.2).promises → mem[t]? = some m →
        (∀ f mf, f ∈ FpAt (CE η) ⟨m.loc.label, 0⟩ → mem[f]? = some mf → mf.loc.label = m.loc.label → t < f) →
        plf t ≤ plb t) ∧
      MemHeldL (CE η) (stOf mem pairs th) H Sp ∧ SlotPayS (CE η) (stOf mem pairs th) Sp cr₀ db ad.label ∧
      (∀ t, Res.sum ((Gs.filter fun x => decide (x.1 = t)).map (·.2.2.2.2.1)) ≤ plf t) ∧
      ∀ c, (CE η).sto ad.label = some c →
        (∀ x ∈ Gs, CrItemQP (CE η) (stOf mem pairs th) plf ad.label c x) ∧
        ∀ o tw, PredU (CE η) ⟨ad.label, o⟩ → ¬ VisU (CE η) ⟨ad.label, o⟩ →
          LowOwn (stOf mem pairs th) ⟨ad.label, o⟩ tw → FirstW mem ⟨ad.label, o⟩ tw →
          OverT (CE η) (stOf mem pairs th) ⟨ad.label, o⟩ tw →
          ∃ x ∈ Gs, ∃ usS j, accs x.2.2.1 = some usS ∧ x.2.1 ≤ o ∧ InAcc usS j (o - x.2.1) ∧
            x.2.2.2.2.2 j = true

/-- (BI) **Not a frontier `bufInit` at its buffer's real count** (the guard of the `…C` steppers'
`hle`). -/
def NotBiRc (th : TTh) (E : TEnv) : Prop :=
  ∀ x b i v e rt w ad rti wi, th.term = .let_ x (.bufInit b i v) e → evalAt th.env b = some (rt, [w]) →
    w.val = .loc ad 0 → evalAt th.env i = some (rti, [wi]) → numOf [wi] = some (E.rc ad.label) →
    E.pfr ad.label ≠ none → False

/-- (BI) Off `bufInit`, `NotBiRc` holds. -/
theorem notBiRc_of_ne {th : TTh} {E : TEnv} (h : ∀ x b i v e, th.term ≠ .let_ x (.bufInit b i v) e) :
    NotBiRc th E :=
  fun x b i v e _ _ _ _ _ ht => absurd ht (h x b i v e)
#print axioms TermPlant.notBiRc_of_ne

/-- (BI) Away from a frontier `bufInit` at its buffer's real count, `BiRcOut` is vacuous. -/
theorem biRcOut_of_nb {E E' : TEnv} {s s' : St} {th : TTh} (h : NotBiRc th E) : BiRcOut E E' s s' th :=
  fun x b i v e rt w ad rti wi ht he hw hei hn hf => (h x b i v e rt w ad rti wi ht he hw hei hn hf).elim
#print axioms TermPlant.biRcOut_of_nb

/-- (BI) Map the invariant part of an eight-witness stepper output. -/
theorem mapQ8_mono {α γ δ : Type} {L : List α} {A B : α → Prop}
    {I I2 : α → Res → Res → Res → Res → (Ts → Res) → (Ts → Res) → γ → δ → Prop}
    {R : α → Res → Res → Res → Res → (Ts → Res) → (Ts → Res) → γ → δ → Prop}
    (hI : ∀ r Tot H' C F cr' db' Gd plh, I r Tot H' C F cr' db' Gd plh → I2 r Tot H' C F cr' db' Gd plh)
    (h : L ≠ [] ∧ ∀ r ∈ L, A r → B r → ∃ Tot H' C F cr' db' Gd plh,
      I r Tot H' C F cr' db' Gd plh ∧ R r Tot H' C F cr' db' Gd plh) :
    L ≠ [] ∧ ∀ r ∈ L, A r → B r → ∃ Tot H' C F cr' db' Gd plh,
      I2 r Tot H' C F cr' db' Gd plh ∧ R r Tot H' C F cr' db' Gd plh :=
  ⟨h.1, fun r hr ha hb => let ⟨Tot, H', C, F, cr', db', Gd, plh, h1, h2⟩ := h.2 r hr ha hb
    ⟨Tot, H', C, F, cr', db', Gd, plh, hI r Tot H' C F cr' db' Gd plh h1, h2⟩⟩
#print axioms TermPlant.mapQ8_mono


/-! ## (OvW3 R2) The bridge: dropped credits plus re-pin items -/

/-- (OvW3 R2, copied from the `oldCr_nword_zero`) At a non-word unit an `OldCr` credit is
nothing. -/
theorem oldCr_nwordZ {E : TEnv} {s : St} {m : Msg} {tw : Ts} {R : Res} (hw : ¬ WordUnit E m.loc)
    (h : OldCr E s m tw R) : R = .zero := by
  rcases h with ⟨w, -, hv⟩ | ⟨-, hz⟩
  · rcases hv with ⟨-, -, hW⟩ | ⟨-, hz⟩
    · rcases hW with ⟨n, P, hA, -, -⟩ | ⟨-, hz⟩
      · exact absurd (WordUnit_of_WordAt hA) hw
      · exact hz
    · exact hz
  · exact hz
#print axioms TermPlant.oldCr_nwordZ

/-- (OvW3 R2) **`PromCrK` with re-pins**: the kept credits `dropA` plus the re-pin items'
credits at their holders (key-free plant credits, `RepinPl`). -/
theorem PromCrK_repin {E E' : TEnv} {s s' : St} {cr db : Ts → Res} {RS : List (AllocLabel × Cell × CrIt)}
    (hC : PromCr E' s' (dropP E s cr) db) (hQ : RepinQ E' s' (rpSum RS) RS) (hP : RepinPl E' s' RS) :
    PromCrK E' s' (fun t => dropA E E' s s' cr t + rpSum RS t) db := by
  intro tw htw
  obtain ⟨m, hm, hd, hc⟩ := PromCrK_dropA hC tw htw
  refine ⟨m, hm, hd, ?_⟩
  by_cases hy : ∃ y ∈ RS, y.2.2.1 = tw
  · obtain ⟨y, hyR, rfl⟩ := hy
    obtain ⟨m1, hm1, hpl⟩ := hP y hyR
    obtain ⟨-, -, -, ⟨mh, -, hmh, -, -, hnw, -⟩, -⟩ := hQ y hyR
    rw [hm] at hm1; cases hm1
    rw [hm] at hmh; cases hmh
    have hK : CrKeys (rpSum RS y.2.2.1) := crKeys_rpSum _ (fun y' hy' => (hQ y' hy').2.2.2.2.1)
    have hge : y.2.2.2.2.2.2.1 ≤ dropA E E' s s' cr y.2.2.1 + rpSum RS y.2.2.1 :=
      Res.le_trans (rpSum_ge hyR) (fun k => by simp only [Res.add_apply]; omega)
    refine .inr ⟨hpl _ hge, ?_⟩
    show CrKeys (dropA E E' s s' cr y.2.2.1 + rpSum RS y.2.2.1)
    rcases hc with ho | ⟨-, hk⟩
    · rw [oldCr_nwordZ hnw ho, Res.zero_add]; exact hK
    · intro l; simp only [Res.add_apply, hk l, hK l]
  · have e : rpSum RS tw = .zero := rpSum_none fun y hy' e => hy ⟨y, hy', e⟩
    simp only [e, Res.add_zero]
    exact hc
#print axioms TermPlant.PromCrK_repin

/-- (OvW3 R2) **From `dropP` to `dropA` plus re-pins** (`ThInvMCFSQ.toKA` with `KeepQR`): a
step's `ThInvMCFSQ` at the dropped credits, whose witness carries re-pin items `RS`, gives one
at `dropA + rpSum RS`, at the cost of `pSum_dropA_swap` and the items' credits. -/
theorem ThInvMCFSQ.toKAR {Q0 : TEnv → Prop} {p : Prog} {g : G} {E : TEnv} {s : St} {S0 : AllocLabel → List Res}
    {mem : Memory} {pairs : List Ts} {th : TTh} {Tot H : Res} {cr db : Ts → Res} {th0 : TTh}
    {RS : List (AllocLabel × Cell × CrIt)}
    (h : ThInvMCFSQ (fun E' => Q0 E' ∧ RepinQ E' (stOf mem pairs th) (rpSum RS) RS ∧
      RepinPl E' (stOf mem pairs th) RS ∧ RepinCov E E' s (stOf mem pairs th) th0 RS) p g E s S0 mem pairs th
      Tot H (dropP E s cr) db)
    (hsub : ∀ t, t ∈ th.promises → t ∈ s.promises) :
    ∃ cr', ThInvMCFSQK (fun E' => Q0 E' ∧ KeepQR E E' s (stOf mem pairs th) th0 cr cr') p g E s S0 mem pairs th
        Tot H cr' db ∧
      pSum (stOf mem pairs th) cr' + pSum s (dropP E s cr) ≤
        pSum (stOf mem pairs th) (dropP E s cr) + pSum s cr + Res.sum (RS.map fun y => y.2.2.2.2.2.2.1) ∧
      pSum (stOf mem pairs th) cr' ≤ pSum (stOf mem pairs th) cr + Res.sum (RS.map fun y => y.2.2.2.2.2.2.1) := by
  obtain ⟨E', ⟨hq, hRQ, hRP, hRC⟩, h0, h1, h2, h3, hm', h5, hC⟩ := h
  have hnd := MemInv_nodup hm'
  have e := sum_map_split (f := fun t => dropA E E' s (stOf mem pairs th) cr t + rpSum RS t) (fun t => rfl)
    th.promises
  have hr := sum_rpSum_le RS hnd
  have hsw := pSum_dropA_swap (E := E) (E' := E') (s := s) (s' := stOf mem pairs th) (cr := cr) hsub hnd
  have hdl := pSum_dropA_le (E := E) (E' := E') (s := stOf mem pairs th) (s0 := s) (s1 := stOf mem pairs th) (cr := cr)
  refine ⟨fun t => dropA E E' s (stOf mem pairs th) cr t + rpSum RS t,
    ⟨E', ⟨hq, dropA E E' s (stOf mem pairs th) cr, RS, fun _ => ⟨KeepPl_dropA, dropA_le⟩, fun t => rfl,
      RepinQ_mono (fun t k => ?_) hRQ, hRC⟩, h0, h1, h2, h3, hm', h5, PromCrK_repin hC hRQ hRP⟩, ?_, ?_⟩
  · simp only [Res.add_apply]; omega
  · intro k
    have a1 := congrArg (fun R : Res => R k) e
    have a2 := hr k; have a3 := hsw k
    simp only [pSum, stOf, Res.add_apply] at a1 a2 a3 ⊢
    omega
  · intro k
    have a1 := congrArg (fun R : Res => R k) e
    have a2 := hr k; have a3 := hdl k
    simp only [pSum, stOf, Res.add_apply] at a1 a2 a3 ⊢
    omega
#print axioms TermPlant.ThInvMCFSQ.toKAR


/-! ## (OvW3 R2) Building re-pin items -/

/-! ## (OvW3 R2) Carving a whole value into pieces -/

/-- (OvW3 R2) `ThInvMCFSQK` at `KeepQ`, with a vacuous re-pin cover, is one at `KeepQR`. -/
theorem ThInvMCFSQK.toR {Q0 : TEnv → Prop} {p : Prog} {g : G} {E : TEnv} {s : St} {S0 : AllocLabel → List Res}
    {mem : Memory} {pairs : List Ts} {th : TTh} {Tot H : Res} {cr cr' db : Ts → Res} {th0 : TTh}
    (hV : ∀ E', RepinCov E E' s (stOf mem pairs th) th0 [])
    (h : ThInvMCFSQK (fun E' => Q0 E' ∧ KeepQ E E' s (stOf mem pairs th) th0 cr cr') p g E s S0 mem pairs th
      Tot H cr' db) :
    ThInvMCFSQK (fun E' => Q0 E' ∧ KeepQR E E' s (stOf mem pairs th) th0 cr cr') p g E s S0 mem pairs th
      Tot H cr' db :=
  h.mono fun E' hk => ⟨hk.1, keepQR_of_keepQ hk.2 (hV E')⟩
#print axioms TermPlant.ThInvMCFSQK.toR

/-- (OvW3 R2) `stepOut_ofFSA` for a fulfilling step with re-pin items `RS` (their credits
counted on the left), concluding at `dropA + rpSum RS` with `KeepQR`. -/
theorem stepOut_ofFSAR {QE : TEnv → Prop} {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory}
    {pairs : List Ts} {th : TTh} {cx : Cx} {η : TEnv}
    {Rf Rs H : Res} {cr db : Ts → Res} {Q : Memory × List Ts × TTh → Prop}
    (hnps : ¬ PubShape cx th)
    (h : tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → Q r →
      ∃ Tot H' C F, ∃ RS : List (AllocLabel × Cell × CrIt),
        ThInvMCFSQ (fun E' => QE E' ∧ RepinQ E' (stOf r.1 r.2.1 r.2.2) (rpSum RS) RS ∧
            RepinPl E' (stOf r.1 r.2.1 r.2.2) RS ∧ RepinCov (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th RS)
          p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' (dropP (CE η) (stOf mem pairs th) cr) db ∧
        MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
        Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C +
            Res.sum (RS.map fun y => y.2.2.2.2.2.2.1) ≤
          Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → Q r →
      ∃ Tot H' C F cr' db' Gd,
      ThInvMCFSQK (fun E' => QE E' ∧ KeepQR (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th cr cr')
        p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr' db' ∧
      MintStep g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧ ClaimAt th.term C F ∧
      Drop (CE η) (stOf mem pairs th) Gd ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr' + pSum (stOf mem pairs th) db + C + Res.sum (Gd.map GdE.R) ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db' + F ∧
      (PubShape cx th → GdCovT (CE η) (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) Gd th) :=
  ⟨h.1, fun r hr hpa hq => by
    obtain ⟨Tot, H', C, F, RS, h1, h2, h3⟩ := h.2 r hr hpa hq
    obtain ⟨cr', hK, -, hle⟩ := ThInvMCFSQ.toKAR (th0 := th) h1 (TermLiveProps.tstep_ext g mem pairs th r hr).prom
    refine ⟨Tot, H', C, F, cr', db, [], hK, h2.toM, h2.claimAt _, Drop_nil, G_nil (Res.le_def.2 fun k => ?_),
      fun hps => absurd hps hnps⟩
    have e1 := h3 k
    have e2 := hle k
    simp only [Res.add_apply] at e1 e2 ⊢
    omega⟩
#print axioms TermPlant.stepOut_ofFSAR

/-- (OvW3 G-b) A peeked reference, locative, or buffer, evaluated as a single location word,
has offset component `0`. -/
theorem peek_locZ {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {cx : Cx} {env : Env} {a : At} {t : Ty}
    (hv : VarsOK ρ η σs cx.vars env) (hpk : cx.peek a = .ok t)
    (ht : (∃ μ u, t = .ptr μ u) ∨ (∃ μ u, t = .loc μ u) ∨ ∃ μ u ψ, t = .refine (.loc μ u) ψ) :
    ∀ rt w ad off, evalAt env a = some (rt, [w]) → w.val = .loc ad off → off = 0 := by
  intro rt w ad off he hw
  obtain ⟨rt0, ws, hea, hvr, -⟩ := peek_VR hv hpk
  rw [he, Option.some.injEq, Prod.mk.injEq] at hea
  obtain ⟨rfl, rfl⟩ := hea
  rcases ht with ⟨μ, u, rfl⟩ | ⟨μ, u, rfl⟩ | ⟨μ, u, ψ, rfl⟩
  · simp only [VR] at hvr
    obtain ⟨a', c, h1, -⟩ := hvr
    rw [List.map_cons, List.map_nil, hw, List.cons.injEq] at h1
    injection h1.1 with _ h2
  · simp only [VR] at hvr
    rcases hvr with ⟨h1, -⟩ | ⟨a', c, U, h1, -⟩
    · rw [List.map_cons, List.map_nil, hw] at h1
      simp at h1
    · rw [List.map_cons, List.map_nil, hw, List.cons.injEq] at h1
      injection h1.1 with _ h2
  · simp only [VR] at hvr
    rcases hvr.1 with ⟨h1, -⟩ | ⟨a', c, U, h1, -⟩
    · rw [List.map_cons, List.map_nil, hw] at h1
      simp at h1
    · rw [List.map_cons, List.map_nil, hw, List.cons.injEq] at h1
      injection h1.1 with _ h2
#print axioms TermPlant.peek_locZ

/-- (OvW3 G-b) The target word of an own reference: offset component `0`, a cell's base, and
an own reference shape. -/
theorem ownPtr_shape {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {cx : Cx} {env : Env} {a : At} {u : Ty}
    (hv : VarsOK ρ η σs cx.vars env) (hpk : cx.peek a = .ok (.ptr .own u)) :
    ∀ rt w ad off, evalAt env a = some (rt, [w]) → w.val = .loc ad off →
      off = 0 ∧ ad.offset = 0 ∧ ∃ ru, rt = .ptr .own ru := by
  intro rt w ad off he hw
  obtain ⟨rt0, ws, hea, hvr, hl⟩ := peek_VR hv hpk
  rw [he, Option.some.injEq, Prod.mk.injEq] at hea
  obtain ⟨rfl, rfl⟩ := hea
  simp only [VR] at hvr
  obtain ⟨a', c, h1, hoff, -⟩ := hvr
  rw [List.map_cons, List.map_nil, hw, List.cons.injEq] at h1
  injection h1.1 with h2 h3
  subst h2
  refine ⟨h3, hoff, ?_⟩
  have hsk := hl.2.1
  rw [close_ptr] at hsk
  cases rt <;> simp [skel, etok] at hsk
  case ptr μ ru =>
    cases μ <;> simp [skelM] at hsk
    exact ⟨ru, rfl⟩
  case refine t ψ => unfold rf at hsk; split at hsk <;> simp [etok] at hsk
#print axioms TermPlant.ownPtr_shape

/-- (OvW3 G-b) The target word of an own locative: offset component `0` and a locative
shape. -/
theorem ownLoc_shape {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {cx : Cx} {env : Env} {a : At} {u : Ty}
    (hv : VarsOK ρ η σs cx.vars env) (hpk : cx.peek a = .ok (.loc .own u)) :
    ∀ rt w ad off, evalAt env a = some (rt, [w]) → w.val = .loc ad off →
      off = 0 ∧ ∃ μr ru, rt = .loc μr ru := by
  intro rt w ad off he hw
  have hz := peek_locZ hv hpk (.inr (.inl ⟨_, _, rfl⟩)) rt w ad off he hw
  obtain ⟨rt0, ws, hea, -, hl⟩ := peek_VR hv hpk
  rw [he, Option.some.injEq, Prod.mk.injEq] at hea
  obtain ⟨rfl, rfl⟩ := hea
  have hsk := hl.2.1
  simp only [close, substTs, skel, etok] at hsk
  obtain ⟨μr, ru, rfl, -, -⟩ := eskel_eq_loc hsk
  exact ⟨hz, μr, ru, rfl⟩
#print axioms TermPlant.ownLoc_shape

/-- (OvW3 G-b) The buffer of a slot operation evaluates at offset component `0`. -/
theorem slot_locZ {p : Prog} {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {th : TTh} {x : String}
    {e : Expr} {b : At}
    (hv : VarsOK ρ η σs cx.vars th.env) (hT : Typed p cx th.term)
    (ht : (∃ i v, th.term = .let_ x (.xchgAt b i v) e) ∨ (∃ i q v, th.term = .let_ x (.xchgAtF b i q v) e) ∨
      (∃ wi jl v, th.term = .let_ x (.stlw b wi jl v) e) ∨ ∃ i v, th.term = .let_ x (.stl b i v) e) :
    ∀ rt w ad off, evalAt th.env b = some (rt, [w]) → w.val = .loc ad off → off = 0 := by
  have hb : ∀ t μ n u k, cx.peek b = .ok t → bufOf t = some (μ, n, u, k) →
      ∀ rt w ad off, evalAt th.env b = some (rt, [w]) → w.val = .loc ad off → off = 0 := by
    intro t μ n u k hpk hbo
    refine peek_locZ hv hpk (.inr (.inr ?_))
    unfold bufOf at hbo
    split at hbo
    · exact ⟨_, _, _, rfl⟩
    · cases hbo
  rcases ht with ⟨i, v, h⟩ | ⟨i, q, v, h⟩ | ⟨wi, jl, v, h⟩ | ⟨i, v, h⟩
  · rw [h] at hT
    cases hT with
    | let_ hop _ =>
    cases hop with
    | xchgAt hpk hbo => exact hb _ _ _ _ _ hpk hbo
  · rw [h] at hT
    cases hT with
    | let_ hop _ =>
    cases hop with
    | xchgAtF hpk hbo => exact hb _ _ _ _ _ hpk hbo
  · rw [h] at hT
    cases hT with
    | let_ hop _ =>
    cases hop with
    | stlw hpk hbo => exact hb _ _ _ _ _ hpk hbo
  · rw [h] at hT
    cases hT with
    | let_ hop _ =>
    cases hop with
    | stl hpk hbo => exact hb _ _ _ _ _ hpk hbo
#print axioms TermPlant.slot_locZ

/-- (OvW3 G-b) The re-pin cover holds with any items when every evaluated target of the op's
address atom `q` has no frontier. -/
theorem repinCov_tgt {E E' : TEnv} {s s' : St} {th : TTh} {RS : List (AllocLabel × Cell × CrIt)} {q : At}
    (hq : ∀ q', opAtomP th.term = some q' → q' = q)
    (h : ∀ rt w ad off, evalAt th.env q = some (rt, [w]) → w.val = .loc ad off → E.pfr ad.label = none) :
    RepinCov E E' s s' th RS := by
  intro lab _ hot c o th0 tw _ _ hpf
  obtain ⟨q', rt, w, ad, off, hq', he, hw, rfl⟩ := hot
  obtain rfl := hq q' hq'
  exact absurd (h rt w ad off he hw) hpf
#print axioms TermPlant.repinCov_tgt

/-- (bufInit re-pin) `repinCov_tgt` for `RepinCovXU`. -/
theorem repinCovX_tgt {E E' : TEnv} {s s' : St} {th : TTh} {RS : List (AllocLabel × Cell × CrIt)} {q : At}
    (hq : ∀ q', opAtomP th.term = some q' → q' = q)
    (h : ∀ rt w ad off, evalAt th.env q = some (rt, [w]) → w.val = .loc ad off → E.pfr ad.label = none) :
    RepinCovXU E E' s s' th RS := by
  intro lab hot c o th0 tw _ _ hpf
  obtain ⟨q', rt, w, ad, off, hq', he, hw, rfl⟩ := hot
  obtain rfl := hq q' hq'
  exact absurd (h rt w ad off he hw) hpf
#print axioms TermPlant.repinCovX_tgt

/-- (bufInit re-pin) The buffer atom of a typed `bufInit` evaluates to offset component `0`
(it is `use`d at a refined own location). -/
theorem bufInit_locZ {p : Prog} {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {th : TTh} {x : String}
    {b i v : At} {e : Expr}
    (hv : VarsOK ρ η σs cx.vars th.env) (hT : Typed p cx th.term) (hterm : th.term = .let_ x (.bufInit b i v) e) :
    ∀ rt w ad off, evalAt th.env b = some (rt, [w]) → w.val = .loc ad off → off = 0 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop _ =>
  cases hop with
  | bufInit hu hbo =>
  refine peek_locZ hv (use_inv (ρ := ρ) (η := η) (σs := σs) (env := th.env) hu).1 (.inr (.inr ?_))
  unfold bufOf at hbo
  split at hbo
  · exact ⟨_, _, _, rfl⟩
  · cases hbo
#print axioms TermPlant.bufInit_locZ

/-- (bufInit re-pin) **No frontier (N)**: at a `bufInit` whose target has no frontier the
cover holds with any items. -/
theorem repinCovX_bufInitN {p : Prog} {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {th : TTh} {x : String}
    {b i v : At} {e : Expr} {E E' : TEnv} {s s' : St} {RS : List (AllocLabel × Cell × CrIt)}
    (hv : VarsOK ρ η σs cx.vars th.env) (hT : Typed p cx th.term) (hterm : th.term = .let_ x (.bufInit b i v) e)
    (hnf : ∀ rt w ad, evalAt th.env b = some (rt, [w]) → w.val = .loc ad 0 → E.pfr ad.label = none) :
    RepinCovXU E E' s s' th RS :=
  repinCovX_tgt (q := b) (fun q' hq' => by rw [hterm] at hq'; simp only [opAtomP, Option.some.injEq] at hq'; exact hq'.symm)
    fun rt w ad off he hw => by
      have hz := bufInit_locZ hv hT hterm rt w ad off he hw
      subst hz
      exact hnf rt w ad he hw
#print axioms TermPlant.repinCovX_bufInitN

/-- (FulP) At an op whose target has no frontier, `FulP` is vacuous. -/
theorem fulP_tgt {E : TEnv} {s s' : St} {th : TTh} {q : At}
    (hq : ∀ q', opAtomP th.term = some q' → q' = q)
    (h : ∀ rt w ad off, evalAt th.env q = some (rt, [w]) → w.val = .loc ad off → E.pfr ad.label = none) :
    FulP E s s' th := by
  intro _ _ hex
  obtain ⟨lab, hot, hpf⟩ := hex
  obtain ⟨q', rt, w, ad, off, hq', he, hw, rfl⟩ := hot
  obtain rfl := hq q' hq'
  exact absurd (h rt w ad off he hw) hpf
#print axioms TermPlant.fulP_tgt

/-- (FulP) `fulP_tgt` at a `bufInit` whose target has no frontier. -/
theorem fulP_bufInitN {p : Prog} {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {th : TTh} {x : String}
    {b i v : At} {e : Expr} {E : TEnv} {s s' : St}
    (hv : VarsOK ρ η σs cx.vars th.env) (hT : Typed p cx th.term) (hterm : th.term = .let_ x (.bufInit b i v) e)
    (hnf : ∀ rt w ad, evalAt th.env b = some (rt, [w]) → w.val = .loc ad 0 → E.pfr ad.label = none) :
    FulP E s s' th :=
  fulP_tgt (q := b) (fun q' hq' => by rw [hterm] at hq'; simp only [opAtomP, Option.some.injEq] at hq'; exact hq'.symm)
    fun rt w ad off he hw => by
      have hz := bufInit_locZ hv hT hterm rt w ad off he hw
      subst hz
      exact hnf rt w ad he hw
#print axioms TermPlant.fulP_bufInitN

/-- (FulP) Without an op atom, `FulP` is vacuous. -/
theorem fulP_nop {E : TEnv} {s s' : St} {th : TTh} (hq : opAtomP th.term = none) : FulP E s s' th := by
  intro _ h
  rw [hq] at h
  exact absurd h (by simp)
#print axioms TermPlant.fulP_nop

/-- (OpenRcKeep) `rcKeepP_tgt` at a `bufInit` whose target has no frontier. -/
theorem rcKeepP_bufInitN {p : Prog} {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {th : TTh} {x : String}
    {b i v : At} {e : Expr} {E E' : TEnv} {s s' : St}
