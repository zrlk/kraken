theorem rsum_key {α : Type} (f : α → Res) (k : Key) :
    ∀ (L : List α), Res.sum (L.map f) k = (L.map (fun a => f a k)).sum
  | [] => rfl
  | a :: L => by simp only [List.map_cons, Res.sum_cons, Res.add_apply, List.sum_cons, rsum_key f k L]

/-- (BI) **A pool item at credit `cr`** (TermOverCr's `CrItemQ`, stated in the plant). -/
def CrItemQP (E : TEnv) (s : St) (cr : Ts → Res) (l : AllocLabel) (c : Cell)
    (x : Ts × Nat × Ty × List Word × Res × (Nat → Bool)) : Prop :=
  ∃ mh usS, s.mem[x.1]? = some mh ∧ mh.loc.label = l ∧ LowOwn s mh.loc x.1 ∧
    ¬ WordUnit E mh.loc ∧ AtOff c.ty x.2.1 x.2.2.1 ∧ Solid x.2.2.1 ∧ accs x.2.2.1 = some usS ∧
    x.2.1 ≤ mh.loc.offset ∧ mh.loc.offset < x.2.1 + nWords usS ∧
    x.2.2.2.1.length = nWords usS ∧ ValOfR E x.2.2.1 x.2.2.2.1 x.2.2.2.2.1 ∧ x.2.2.2.2.1 ≤ cr x.1 ∧
    ∀ i o w tw', x.2.2.2.2.2 i = true → InAcc usS i o → x.2.2.2.1[o]? = some w →
      LowOwn s ⟨l, x.2.1 + o⟩ tw' → PredAt s.mem ⟨l, x.2.1 + o⟩ tw' w ∨
        (PredU E ⟨l, x.2.1 + o⟩ ∧ FirstW s.mem ⟨l, x.2.1 + o⟩ tw' ∧ ∃ m, s.mem[tw']? = some m ∧ mw m = w)

/-- **The plant transfer** of a drop list `Gd` with payload `R` and target
choice `tg`: promise `t` receives the payloads of the entries targeting it. -/
noncomputable def plantD {α : Type} (Gd : List α) (R : α → Res) (tg : α → Option Ts) : Ts → Res :=
  fun t => Res.sum ((Gd.filter (fun g => decide (tg g = some t))).map R)

theorem nsum_ite_le (x : Option Ts) (r : Nat) :
    ∀ (F : List Ts), F.Nodup → (F.map (fun t => if x = some t then r else 0)).sum ≤ r
  | [], _ => Nat.zero_le _
  | t :: F, hnd => by
      have hnd' := List.nodup_cons.1 hnd
      simp only [List.map_cons, List.sum_cons]
      by_cases hx : x = some t
      · have : ∀ (G : List Ts), (∀ u ∈ G, u ∈ F) → (G.map (fun t => if x = some t then r else 0)).sum = 0 := by
          intro G hG
          induction G with
          | nil => rfl
          | cons u G ih =>
              have hu := hG u (List.mem_cons_self ..)
              have : ¬ x = some u := by
                rw [hx]; intro h; cases h; exact hnd'.1 hu
              simp only [List.map_cons, List.sum_cons, this, ite_false, Nat.zero_add]
              exact ih (fun v hv => hG v (List.mem_cons_of_mem _ hv))
        rw [this F (fun _ h => h)]; simp [hx]
      · simp only [hx, ite_false, Nat.zero_add]; exact nsum_ite_le x r F hnd'.2

theorem plantD_cons {α : Type} (g : α) (Gd : List α) (R : α → Res) (tg : α → Option Ts) (t : Ts) (k : Key) :
    plantD (g :: Gd) R tg t k = (if tg g = some t then R g k else 0) + plantD Gd R tg t k := by
  unfold plantD
  by_cases h : tg g = some t
  · simp [h, Res.sum_cons, Res.add_apply]
  · simp [h]

/-- **The plant transfer is paid by the drop list**: over any nodup set of
promises, it hands out at most the drop list's total. -/
theorem plantD_sum_le {α : Type} (Gd : List α) (R : α → Res) (tg : α → Option Ts) {F : List Ts}
    (hnd : F.Nodup) : Res.sum (F.map (plantD Gd R tg)) ≤ Res.sum (Gd.map R) := by
  refine Res.le_def.2 fun k => ?_
  rw [rsum_key, rsum_key]
  induction Gd with
  | nil =>
      simp only [plantD, List.filter_nil, List.map_nil]
      clear hnd
      induction F with
      | nil => exact Nat.le_refl _
      | cons x F ih => simp only [List.map_cons, List.sum_cons]; exact Nat.le_trans (Nat.le_of_eq (by simp [Res.sum_nil])) ih
  | cons g Gd ih =>
      simp only [plantD_cons, List.map_cons, List.sum_cons]
      have e : (F.map (fun t => (if tg g = some t then R g k else 0) + plantD Gd R tg t k)).sum =
          (F.map (fun t => if tg g = some t then R g k else 0)).sum + (F.map (fun t => plantD Gd R tg t k)).sum := by
        clear ih hnd
        induction F with
        | nil => rfl
        | cons x F ih2 => simp only [List.map_cons, List.sum_cons, ih2]; omega
      rw [e]
      have := nsum_ite_le (tg g) (R g k) F hnd
      omega

/-- The plant transfer is supported on the chosen targets. -/
theorem plantD_supp {α : Type} {Gd : List α} {R : α → Res} {tg : α → Option Ts} {t : Ts}
    (h : plantD Gd R tg t ≠ .zero) : ∃ g ∈ Gd, tg g = some t := by
  apply Classical.byContradiction
  intro hn
  apply h
  unfold plantD
  have : Gd.filter (fun g => decide (tg g = some t)) = [] := by
    rw [List.filter_eq_nil_iff]
    intro g hg; simp only [decide_eq_true_eq]; intro e; exact hn ⟨g, hg, e⟩
  rw [this]; rfl

/-- A target choice inside a set `F` of promises satisfying `P`. -/
noncomputable def tgIn {α : Type} (F : List Ts) (P : α → Ts → Prop) : α → Option Ts :=
  fun g => by classical exact F.find? (fun t => decide (P g t))

theorem tgIn_spec {α : Type} {F : List Ts} {P : α → Ts → Prop} {g : α} {t : Ts}
    (h : tgIn F P g = some t) : t ∈ F ∧ P g t := by
  classical
  unfold tgIn at h
  have h1 := List.mem_of_find?_eq_some h
  have h2 := List.find?_some h
  exact ⟨h1, by simpa using h2⟩

/-- **The CrShift support facts** of a plant transfer whose targets are
foreign promises in the footprint. -/
theorem plantD_crShift {α : Type} {Gd : List α} {R : α → Res} {fp prom : List Ts} {P : α → Ts → Prop} :
    (∀ t, plantD Gd R (tgIn fp (fun g t => P g t ∧ t ∉ prom)) t ≠ .zero → t ∈ fp) ∧
    (∀ t, plantD Gd R (tgIn fp (fun g t => P g t ∧ t ∉ prom)) t ≠ .zero → t ∉ prom) := by
  refine ⟨fun t h => ?_, fun t h => ?_⟩
  · obtain ⟨g, _, e⟩ := plantD_supp h; exact (tgIn_spec e).1
  · obtain ⟨g, _, e⟩ := plantD_supp h; exact (tgIn_spec e).2.2

/-- **The plant transfer, one entry per target**: promise `t` receives the
payload of the first entry targeting it. -/
noncomputable def plantD1 {α : Type} (Gd : List α) (R : α → Res) (tg : α → Option Ts) : Ts → Res :=
  fun t => match Gd.find? (fun g => decide (tg g = some t)) with
    | some g => R g
    | none => .zero

theorem plantD1_le {α : Type} (R : α → Res) (tg : α → Option Ts) (t : Ts) (k : Key) :
    ∀ (Gd : List α), plantD1 Gd R tg t k ≤ plantD Gd R tg t k
  | [] => Nat.le_refl _
  | g :: Gd => by
      rw [plantD_cons]
      unfold plantD1
      by_cases h : tg g = some t
      · simp [h]
      · have ih := plantD1_le R tg t k Gd
        unfold plantD1 at ih
        simp only [List.find?_cons, h, decide_false, ite_false, Nat.zero_add]
        exact ih

/-- `plantD1` is paid by the drop list. -/
theorem plantD1_sum_le {α : Type} (Gd : List α) (R : α → Res) (tg : α → Option Ts) {F : List Ts}
    (hnd : F.Nodup) : Res.sum (F.map (plantD1 Gd R tg)) ≤ Res.sum (Gd.map R) := by
  refine Res.le_def.2 fun k => Nat.le_trans ?_ (Res.le_def.1 (plantD_sum_le Gd R tg hnd) k)
  rw [rsum_key, rsum_key]
  clear hnd
  induction F with
  | nil => exact Nat.le_refl _
  | cons x F ih => simp only [List.map_cons, List.sum_cons]; exact Nat.add_le_add (plantD1_le R tg x k Gd) ih

/-- **What a promise receives** under `plantD1`: nothing, or exactly the
payload of one entry targeting it. -/
theorem plantD1_cases {α : Type} (Gd : List α) (R : α → Res) (tg : α → Option Ts) (t : Ts) :
    plantD1 Gd R tg t = .zero ∨ ∃ g ∈ Gd, tg g = some t ∧ plantD1 Gd R tg t = R g := by
  unfold plantD1
  cases hf : Gd.find? (fun g => decide (tg g = some t)) with
  | none => exact Or.inl rfl
  | some g =>
      refine Or.inr ⟨g, List.mem_of_find?_eq_some hf, ?_, rfl⟩
      simpa using List.find?_some hf

/-- **The plant transfer by construction**: with targets chosen inside `fp`
by `P`, a promise receiving anything is in `fp`, satisfies `P` for an entry, and
receives exactly that entry's payload. -/
theorem plantD1_tgIn {α : Type} {Gd : List α} {R : α → Res} {fp : List Ts} {P : α → Ts → Prop} {t : Ts}
    (h : plantD1 Gd R (tgIn fp P) t ≠ .zero) :
    t ∈ fp ∧ ∃ g ∈ Gd, P g t ∧ plantD1 Gd R (tgIn fp P) t = R g := by
  rcases plantD1_cases Gd R (tgIn fp P) t with h0 | ⟨g, hg, e, hr⟩
  · exact absurd h0 h
  · exact ⟨(tgIn_spec e).1, g, hg, (tgIn_spec e).2, hr⟩

/-! ## `Over` never switches back (B's `Over_mono_cut`) -/

/-- Above any unskipped message at `a` there is a reading. -/
theorem ReadTs_exists_ge {mem : Memory} {Q : List Ts} {a : Address} :
    ∀ (d : Nat) (t0 : Ts), mem.size - t0 = d → t0 ∉ Q → (∃ m, mem[t0]? = some m ∧ m.loc = a) →
      ∃ t, t0 ≤ t ∧ ReadTs mem Q a t := by
  intro d
  induction d using Nat.strongRecOn with
  | _ d ih =>
    intro t0 hd hq hm
    by_cases hall : ∀ (t' : Ts) (m' : Msg), t0 < t' → mem[t']? = some m' → m'.loc = a → t' ∈ Q
    · exact ⟨t0, Nat.le_refl _, hq, hm, hall⟩
    · have : ∃ t' m', t0 < t' ∧ mem[t']? = some m' ∧ m'.loc = a ∧ t' ∉ Q := by
        apply Classical.byContradiction
        intro hn
        apply hall
        intro t' m' h1 h2 h3
        apply Classical.byContradiction
        intro h4
        exact hn ⟨t', m', h1, h2, h3, h4⟩
      obtain ⟨t1, m1, h1, h2, h3, h4⟩ := this
      have hs := lt_size_of_some h2
      obtain ⟨t, ht, hr⟩ := ih (mem.size - t1) (by (try simp only [WeakMem.Ts] at *); omega) t1 rfl h4 ⟨m1, h2, h3⟩
      exact ⟨t, by (try simp only [WeakMem.Ts] at *); omega, hr⟩

/-- **`OverU` is monotone** along a step that keeps the old messages'
units, keeps the owner's promises `P` (all old), newly skips no old message,
and stops skipping only messages above the owner's lowest promise (H2′). -/
theorem OverU_mono_gen {mem mem' : Memory} {P Q Q' : List Ts} {u : Address}
    (hloc : ∀ t, t < mem.size → ((∃ m, mem[t]? = some m ∧ m.loc = u) ↔ (∃ m, mem'[t]? = some m ∧ m.loc = u)))
    (hP : ∀ t, t ∈ P → t < mem.size)
    (hQ' : ∀ t, t < mem.size → t ∈ Q' → t ∈ Q)
    (hleave : ∀ tq t', tq ∈ Q → tq ∉ Q' → (∃ m, mem[tq]? = some m ∧ m.loc = u) → LowestIn mem P u t' → t' < tq)
    (h : OverU mem P Q u) : OverU mem' P Q' u := by
  obtain ⟨t, t', hr, hlo, hnp⟩ := h
  obtain ⟨htq, htm, htop⟩ := hr
  have hts : t < mem.size := let ⟨_, hm, _⟩ := htm; lt_size_of_some hm
  obtain ⟨tn, hge, hrn⟩ := ReadTs_exists_ge (mem := mem') (Q := Q') (a := u) _ t rfl
    (fun h => htq (hQ' t hts h)) ((hloc t hts).1 htm)
  have hlo' : LowestIn mem' P u t' := by
    obtain ⟨h1, h2, h3⟩ := hlo
    refine ⟨h1, (hloc t' (hP t' h1)).1 h2, fun t2 h4 h5 => h3 t2 h4 ((hloc t2 (hP t2 h4)).2 h5)⟩
  refine ⟨tn, t', hrn, hlo', fun hpn => ?_⟩
  obtain ⟨hlt, hmn, hbet⟩ := hpn
  have ht's := hP t' hlo.1
  have htns : tn < mem.size := by (try simp only [WeakMem.Ts] at *); omega
  rcases Nat.lt_or_ge t tn with hlt2 | hle2
  · -- the new reading is an old message that left the skip set, below `t'`
    have hmo := (hloc tn htns).2 hmn
    obtain ⟨m0, hm0, hl0⟩ := hmo
    have hinQ : tn ∈ Q := htop tn m0 hlt2 hm0 hl0
    have := hleave tn t' hinQ hrn.1 ⟨m0, hm0, hl0⟩ hlo
    (try simp only [WeakMem.Ts] at *); omega
  · have e : tn = t := by (try simp only [WeakMem.Ts] at *); omega
    subst e
    apply hnp
    refine ⟨hlt, htm, fun t2 m2 h1 h2 h3 h4 => ?_⟩
    have h2s : t2 < mem.size := lt_size_of_some h3
    obtain ⟨m3, hm3, hl3⟩ := (hloc t2 h2s).1 ⟨m2, h3, h4⟩
    exact hbet t2 m3 h1 h2 hm3 hl3

/-- `Over` is monotone, unit by unit. -/
theorem Over_mono_gen {mem mem' : Memory} {P : List Ts} {Q Q' : Address → List Ts} {l : AllocLabel} {b n : Nat}
    (hloc : ∀ t (u : Address), t < mem.size →
      ((∃ m, mem[t]? = some m ∧ m.loc = u) ↔ (∃ m, mem'[t]? = some m ∧ m.loc = u)))
    (hP : ∀ t, t ∈ P → t < mem.size)
    (hQ' : ∀ (u : Address) t, t < mem.size → t ∈ Q' u → t ∈ Q u)
    (hleave : ∀ (u : Address) tq t', tq ∈ Q u → tq ∉ Q' u → (∃ m, mem[tq]? = some m ∧ m.loc = u) →
      LowestIn mem P u t' → t' < tq)
    (h : Over mem P Q l b n) : Over mem' P Q' l b n := by
  obtain ⟨o, ho, hu⟩ := h
  exact ⟨o, ho, OverU_mono_gen (hloc · _) hP (hQ' _) (hleave _) hu⟩

/-- (D2) **H2′ at a cell** (named hypothesis): every foreign
message at `l` lies above every own outstanding promise at `l`. -/
def H2At (mem : Memory) (P F : List Ts) (l : AllocLabel) : Prop :=
  ∀ (tf tk : Ts) (mf mk : Msg), tf ∈ F → mem[tf]? = some mf → mf.loc.label = l →
    tk ∈ P → mem[tk]? = some mk → mk.loc.label = l → tk < tf

/-- **`Over_mono_cut`**: thread `k`'s `Over` at a non-word piece of `l` is
never switched off by another thread's step. `E, s` / `E', s'` are `k`'s cut and
state before / after; `k`'s promises are unchanged; the skip sets at the piece's
units are `k`'s promises plus `FpAt` (non-word units); an old message newly in
`k`'s `FpAt` was already there; and H2′ holds at `l` before the step. -/
theorem Over_mono_cut {E E' : TEnv} {s s' : St} {l : AllocLabel} {b n : Nat}
    (hloc : ∀ t (u : Address), t < s.mem.size →
      ((∃ m, s.mem[t]? = some m ∧ m.loc = u) ↔ (∃ m, s'.mem[t]? = some m ∧ m.loc = u)))
    (hpr : s'.promises = s.promises) (hP : ∀ t, t ∈ s.promises → t < s.mem.size)
    (hv : ∀ o, o < n → ¬ VisU E ⟨l, b + o⟩) (hv' : ∀ o, o < n → ¬ VisU E' ⟨l, b + o⟩)
    (hq : ∀ o, o < n → ¬ PredU E ⟨l, b + o⟩) (hq' : ∀ o, o < n → ¬ PredU E' ⟨l, b + o⟩)
    (hF : ∀ t, t < s.mem.size → t ∈ FpAt E' ⟨l, 0⟩ → t ∈ FpAt E ⟨l, 0⟩)
    (hH2 : H2At s.mem s.promises (FpAt E ⟨l, 0⟩) l)
    (h : Over s.mem s.promises (PromAt E s) l b n) : Over s'.mem s'.promises (PromAt E' s') l b n := by
  obtain ⟨o, ho, hu⟩ := h
  have eF : ∀ (E0 : TEnv) (x : Nat), FpAt E0 ⟨l, x⟩ = FpAt E0 ⟨l, 0⟩ := fun _ _ => rfl
  have e1 : PromAt E s ⟨l, b + o⟩ = s.promises ++ FpAt E ⟨l, 0⟩ := by
    rw [PromAt_nword (hv o ho) (hq o ho), eF]
  have e2 : PromAt E' s' ⟨l, b + o⟩ = s.promises ++ FpAt E' ⟨l, 0⟩ := by
    rw [PromAt_nword (hv' o ho) (hq' o ho), eF, hpr]
  refine ⟨o, ho, ?_⟩
  rw [hpr, e2]
  rw [e1] at hu
  refine OverU_mono_gen (hloc · _) hP (fun t ht h => ?_) (fun tq t' h1 h2 h3 h4 => ?_) hu
  · rcases List.mem_append.1 h with h | h
    · exact List.mem_append_left _ h
    · exact List.mem_append_right _ (hF t ht h)
  · rcases List.mem_append.1 h1 with h | h
    · exact absurd (List.mem_append_left _ h) h2
    · obtain ⟨mq, hmq, hlq⟩ := h3
      obtain ⟨hk, ⟨mk, hmk, hlk⟩, -⟩ := h4
      exact hH2 tq t' mq mk h hmq (by rw [hlq]) hk hmk (by rw [hlk])

/-! ## (d) The plant credit's piece is a drop entry's piece -/

/-- The solid component a `PlantCr` names is a piece of the cell's type. -/
theorem plant_piece {T S0 S : Ty} {sb b0 n : Nat} (hseg : SegOf T sb S0) (hat : AtOff S0 b0 S) (hS : Solid S)
    (hw : wc S = some n) (hn : 0 < n) : Piece T (sb + b0) S := by
  refine ⟨?_, hS, fun h => by rw [hw] at h; cases h; omega⟩
  rcases hseg with ⟨rfl, rfl, -⟩ | ⟨N, us, j, rfl, hus, hj, rfl⟩
  · rw [Nat.zero_add]; exact hat
  · exact .elem hus hj hat

/-- **Coverage reaches a plant piece**: under an untorn target, a planted
piece of another thread's cell meeting a foreign promise inside the target is a
drop entry's piece. -/
theorem gdCov_plant {E : TEnv} {s : St} {Gd : List GdE} {l : AllocLabel} {o n : Nat} {c : Cell}
    {S0 S : Ty} {sb b0 nS : Nat} {t : Ts} {m : Msg}
    (hcov : GdCov E s Gd l o n) (hu : ∀ j, j < n → UntornU E s ⟨l, o + j⟩)
    (hsto : E.sto l = some c) (hown : c.owner ≠ some E.tid)
    (hseg : SegOf c.ty sb S0) (hat : AtOff S0 b0 S) (hS : Solid S) (hw : wc S = some nS) (hn : 0 < nS)
    (ht : t ∈ E.fp) (hm : s.mem[t]? = some m) (hl : m.loc.label = l)
    (h1 : sb + b0 ≤ m.loc.offset) (h2 : sb + b0 + nS > m.loc.offset)
    (h3 : o ≤ m.loc.offset) (h4 : o + n > m.loc.offset) :
    ∃ g ∈ Gd, g.l = l ∧ g.b = sb + b0 ∧ g.S = S := by
  have hP := plant_piece hseg hat hS hw hn
  obtain ⟨vs, hvs⟩ := Piece_accs hP
  have e : nS = nWords vs := Option.some.inj (hw.symm.trans (wc_of_accs hvs))
  subst e
  exact hcov hu c (sb + b0) S vs t m hsto hown hP hvs ht hm hl h1 h2 h3 h4

/-! ## The system's credit invariant `PromCrK` -/

/-- A plant credit carries no own-handle key (pub cells are `noOwnIn`).
Word and region keys are not excluded: `sharedOK` admits tokens behind `pub`. -/
def CrKeys (R : Res) : Prop := ∀ l, R (.own l) = 0

theorem CrKeys_zero : CrKeys .zero := fun _ => rfl

/-- **`PromCrK`**: each own promise carries its `PromCr` credit, or a plant
credit without own keys. -/
def PromCrK (E : TEnv) (s : St) (cr db : Ts → Res) : Prop :=
  ∀ tw, tw ∈ s.promises → ∃ m, s.mem[tw]? = some m ∧ DbRes E s.mem m tw (db tw) ∧
    (OldCr E s m tw (cr tw) ∨ (PlantCr E s m tw (cr tw) ∧ CrKeys (cr tw)))

theorem PromCrK_of {E : TEnv} {s : St} {cr db : Ts → Res} (h : PromCr E s cr db) : PromCrK E s cr db :=
  fun tw htw => let ⟨m, hm, hd, hc⟩ := h tw htw; ⟨m, hm, hd, Or.inl hc⟩

theorem PromCrK.toP {E : TEnv} {s : St} {cr db : Ts → Res} (h : PromCrK E s cr db) : PromCrP E s cr db :=
  fun tw htw => let ⟨m, hm, hd, hc⟩ := h tw htw; ⟨m, hm, hd, hc.imp id And.left⟩

/-- What a `PromCrK` credit is, key-wise: a `VRes` of a word, nothing, or
key-free. -/
theorem PromCrK_cr {E : TEnv} {s : St} {cr db : Ts → Res} (h : PromCrK E s cr db) {tw : Ts}
    (htw : tw ∈ s.promises) :
    (∃ m w, s.mem[tw]? = some m ∧ VRes E m.loc w (cr tw)) ∨ cr tw = .zero ∨ CrKeys (cr tw) := by
  obtain ⟨m, hm, -, (⟨w, -, hw⟩ | ⟨-, hz⟩) | hpk⟩ := h tw htw
  · exact Or.inl ⟨m, w, hm, hw⟩
  · exact Or.inr (Or.inl hz)
  · exact Or.inr (Or.inr hpk.2)

theorem PromCrK_db {E : TEnv} {s : St} {cr db : Ts → Res} (h : PromCrK E s cr db) {tw : Ts}
    (htw : tw ∈ s.promises) : ∃ m, s.mem[tw]? = some m ∧ DbRes E s.mem m tw (db tw) :=
  let ⟨m, hm, hd, _⟩ := h tw htw; ⟨m, hm, hd⟩

/-! ## (dropA) `ThInvMCF` at `PromCrK`, and keeping plant credits across a step -/

/-- (dropA) `ThInvMCF` whose credits satisfy `PromCrK`. -/
def ThInvMCFK (p : Prog) (g : G) (E : TEnv) (s : St) (mem : Memory) (pairs : List Ts) (th : TTh) (Tot H : Res)
    (cr db : Ts → Res) : Prop :=
  ∃ E', EFoot g E E' s (stOf mem pairs th) ∧ SeenOK E E' Tot H ∧ BoxNewV E E' s th ∧ ThInvRE p E' th Tot ∧
    MemInv g E' (stOf mem pairs th) ∧ MemHeld E' (stOf mem pairs th) H ∧ PromCrK E' (stOf mem pairs th) cr db

/-- (dropA) `ThInvMCFS` whose credits satisfy `PromCrK`. -/
def ThInvMCFSK (p : Prog) (g : G) (E : TEnv) (s : St) (S0 : AllocLabel → List Res) (mem : Memory)
    (pairs : List Ts) (th : TTh) (Tot H : Res) (cr db : Ts → Res) : Prop :=
  ∃ E', EFoot g E E' s (stOf mem pairs th) ∧ SeenOK E E' Tot H ∧ BoxNewV E E' s th ∧ ThInvRE p E' th Tot ∧
    MemInv g E' (stOf mem pairs th) ∧ MemHeldK E s S0 E' (stOf mem pairs th) H ∧ PromCrK E' (stOf mem pairs th) cr db

theorem ThInvMCF.toK {p : Prog} {g : G} {E : TEnv} {s : St} {mem : Memory} {pairs : List Ts} {th : TTh}
    {Tot H : Res} {cr db : Ts → Res} (h : ThInvMCF p g E s mem pairs th Tot H cr db) :
    ThInvMCFK p g E s mem pairs th Tot H cr db :=
  let ⟨E', h0, hSK, hBV, h1, h2, h3, h4⟩ := h
  ⟨E', h0, hSK, hBV, h1, h2, h3, PromCrK_of h4⟩
#print axioms ThInvMCF.toK

theorem ThInvMCFS.toK {p : Prog} {g : G} {E : TEnv} {s : St} {S0 : AllocLabel → List Res} {mem : Memory}
    {pairs : List Ts} {th : TTh} {Tot H : Res} {cr db : Ts → Res} (h : ThInvMCFS p g E s S0 mem pairs th Tot H cr db) :
    ThInvMCFSK p g E s S0 mem pairs th Tot H cr db :=
  let ⟨E', h0, hSK, hBV, h1, h2, h3, h4⟩ := h
  ⟨E', h0, hSK, hBV, h1, h2, h3, PromCrK_of h4⟩
#print axioms ThInvMCFS.toK

theorem ThInvMCFSK.toF {p : Prog} {g : G} {E : TEnv} {s : St} {S0 : AllocLabel → List Res} {mem : Memory}
    {pairs : List Ts} {th : TTh} {Tot H : Res} {cr db : Ts → Res} (h : ThInvMCFSK p g E s S0 mem pairs th Tot H cr db) :
    ThInvMCFK p g E s mem pairs th Tot H cr db :=
  let ⟨E', h0, hSK, hBV, h1, h2, h3, h4⟩ := h
  ⟨E', h0, (by seenT), (by boxT), h1, h2, h3.memHeld, h4⟩
#print axioms ThInvMCFSK.toF

/-- (dropA) **The credits kept by a step from `s` (at `E`) to `s'` (at `E'`)**: a
credit stays if it is an old credit before the step or a key-free plant credit
after it; otherwise it is dropped. -/
noncomputable def dropA (E E' : TEnv) (s s' : St) (cr : Ts → Res) (t : Ts) : Res := by
  classical
  exact if (∃ m, s.mem[t]? = some m ∧ OldCr E s m t (cr t)) ∨
      (∃ m, s'.mem[t]? = some m ∧ PlantCr E' s' m t (cr t) ∧ CrKeys (cr t)) then cr t else .zero

theorem dropA_le {E E' : TEnv} {s s' : St} {cr : Ts → Res} (t : Ts) : dropA E E' s s' cr t ≤ cr t := by
  unfold dropA
  split
  · exact Res.le_refl _
  · exact Res.zero_le _
#print axioms dropA_le

theorem dropA_pos {E E' : TEnv} {s s' : St} {cr : Ts → Res} {t : Ts}
    (h : (∃ m, s.mem[t]? = some m ∧ OldCr E s m t (cr t)) ∨
      (∃ m, s'.mem[t]? = some m ∧ PlantCr E' s' m t (cr t) ∧ CrKeys (cr t))) :
    dropA E E' s s' cr t = cr t := by
  unfold dropA
  split
  · rfl
  · next hn => exact absurd h hn
#print axioms dropA_pos

theorem dropA_neg {E E' : TEnv} {s s' : St} {cr : Ts → Res} {t : Ts}
    (h : ¬ ((∃ m, s.mem[t]? = some m ∧ OldCr E s m t (cr t)) ∨
      (∃ m, s'.mem[t]? = some m ∧ PlantCr E' s' m t (cr t) ∧ CrKeys (cr t)))) :
    dropA E E' s s' cr t = .zero := by
  unfold dropA
  split
  · next hp => exact absurd hp h
  · rfl
#print axioms dropA_neg

theorem pSum_dropA_le {E E' : TEnv} {s s0 s1 : St} {cr : Ts → Res} : pSum s (dropA E E' s0 s1 cr) ≤ pSum s cr :=
  sum_map_le _ fun t _ => dropA_le t
#print axioms pSum_dropA_le

theorem dropP_le_dropA {E E' : TEnv} {s s' : St} {cr : Ts → Res} (t : Ts) :
    dropP E s cr t ≤ dropA E E' s s' cr t := by
  unfold dropP
  split
  next h => rw [dropA_pos (Or.inl h)]; exact Res.le_refl _
  next => exact Res.zero_le _
#print axioms dropP_le_dropA

/-- (dropA) A plant credit sits off the word units. -/
theorem PlantCr_nword {E : TEnv} {s : St} {m : Msg} {tw : Ts} {R : Res} (h : PlantCr E s m tw R) :
    ¬ WordUnit E m.loc :=
  let ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, hw, _⟩ := h; hw
#print axioms PlantCr_nword


/-- A duplicate-free copy of a list of timestamps. -/
def nodupL : List Ts → List Ts
  | [] => []
  | t :: L => if t ∈ nodupL L then nodupL L else t :: nodupL L

theorem mem_nodupL {t : Ts} : ∀ {L : List Ts}, t ∈ nodupL L ↔ t ∈ L
  | [] => Iff.rfl
  | x :: L => by
      unfold nodupL
      split
      next h =>
        rw [mem_nodupL (L := L), List.mem_cons]
        constructor
        · exact Or.inr
        · rintro (rfl | h')
          · exact mem_nodupL.1 h
          · exact h'
      next h => rw [List.mem_cons, List.mem_cons, mem_nodupL (L := L)]

theorem nodupL_nodup : ∀ (L : List Ts), (nodupL L).Nodup
  | [] => List.nodup_nil
  | x :: L => by
      unfold nodupL
      split
      next => exact nodupL_nodup L
      next h => exact List.nodup_cons.2 ⟨h, nodupL_nodup L⟩

theorem pSum_congr {s : St} {f g : Ts → Res} (h : ∀ t, t ∈ s.promises → f t = g t) : pSum s f = pSum s g := by
  unfold pSum
  rw [List.map_congr_left h]

theorem dropP_of_old {E : TEnv} {s : St} {cr : Ts → Res} {t : Ts} {m : Msg} (hm : s.mem[t]? = some m)
    (ho : OldCr E s m t (cr t)) : dropP E s cr t = cr t := by
  unfold dropP
  split
  · rfl
  · next h => exact absurd ⟨m, hm, ho⟩ h

/-- **`PromCrK` across the thread's own unplanted promise** (`tstepMC_promE`
at the dropped credits `dropP`): old promises keep their credits `cr`, the new
one takes `cr''`; old plant credits move by `hpl`. -/
theorem PromCrK_prom {E : TEnv} {s : St} {a : Address} {v : WeakMem.Val} {w : Ts} {cr db cr'' db' : Ts → Res}
    (hC : PromCrK E s cr db) (hPb : ∀ t, t ∈ s.promises → t < s.mem.size)
    (hag : ∀ t, t < s.mem.size → cr'' t = dropP E s cr t ∧ db' t = db t)
    (hC' : PromCr E (promSt s a v w) cr'' db')
    (hpl : ∀ tw m, tw ∈ s.promises → s.mem[tw]? = some m → PlantCr E s m tw (cr tw) →
      PlantCr E (promSt s a v w) m tw (cr tw)) :
    PromCrK E (promSt s a v w) (fun t => if t < s.mem.size then cr t else cr'' t) db' ∧
      pSum (promSt s a v w) (fun t => if t < s.mem.size then cr t else cr'' t) + pSum s (dropP E s cr) =
        pSum (promSt s a v w) cr'' + pSum s cr := by
  refine ⟨fun tw htw => ?_, ?_⟩
  · obtain ⟨m, hm, hd, hc⟩ := hC' tw htw
    by_cases hlt : tw < s.mem.size
    · have htw0 : tw ∈ s.promises := by
        rcases List.mem_append.1 htw with h | h
        · exact h
        · rw [List.mem_singleton] at h; exact absurd h (Nat.ne_of_lt hlt)
      obtain ⟨m0, hm0, -, hc0⟩ := hC tw htw0
      have hm' : s.mem[tw]? = some m := by
        have e := hm
        simp only [promSt, Array.getElem?_push, Nat.ne_of_lt hlt, ↓reduceIte] at e
        exact e
      have e0 : m0 = m := Option.some.inj (hm0.symm.trans hm')
      subst e0
      simp only [hlt, ↓reduceIte]
      refine ⟨m0, hm, hd, ?_⟩
      rcases hc0 with ho | ⟨hp, hk⟩
      · left
        rw [(hag tw hlt).1, dropP_of_old hm0 ho] at hc
        exact hc
      · exact Or.inr ⟨hpl tw m0 htw0 hm0 hp, hk⟩
    · simp only [hlt, ↓reduceIte]
      exact ⟨m, hm, hd, Or.inl hc⟩
  · rw [pSum_promSt, pSum_promSt]
    have e1 : pSum s (fun t => if t < s.mem.size then cr t else cr'' t) = pSum s cr :=
      pSum_congr fun t ht => by simp only [hPb t ht, ↓reduceIte]
    have e2 : pSum s cr'' = pSum s (dropP E s cr) := pSum_congr fun t ht => (hag t (hPb t ht)).1
    rw [e1, e2]
    simp only [Nat.lt_irrefl, ↓reduceIte]
    exact Res.ext fun k => by simp only [Res.add_apply]; omega


/-! ## (§11) Pinned plant credits: mixing, window shrinking, prefix stability -/


/-- (§11) **Pins mix**: words pinned at `K1` and at `K2` mix (taking `K1`'s
units from the first) to words pinned at both. -/
theorem PinW_mix {mem : Memory} {W : List Ts} {l : AllocLabel} {b : Nat} {us : List Acc} {K1 K2 : Nat → Bool}
    {ws1 ws2 : List Word} (h1 : PinW mem W l b us K1 ws1) (h2 : PinW mem W l b us K2 ws2)
    (l1 : ws1.length = nWords us) (l2 : ws2.length = nWords us) :
    PinW mem W l b us (fun i => K1 i || K2 i) (TermTear.mixU us K1 ws1 ws2) := by
  intro i o w t' hK hI hw hL
  change (K1 i || K2 i) = true at hK
  rw [TermTear.mixU_getElem us K1 ws1 ws2 i o l1 l2 hI] at hw
  cases hk : K1 i
  · rw [hk] at hK hw
    simp only [Bool.false_or] at hK
    simp only [Bool.false_eq_true, ite_false] at hw
    exact h2 i o w t' hK hI hw hL
  · rw [hk] at hw
    simp only [ite_true] at hw
    exact h1 i o w t' hk hI hw hL

theorem mem_winL {wb t : Ts} {P : List Ts} : t ∈ winL wb P ↔ t ∈ P ∧ t ≤ wb := by
  simp [winL]

/-- (§11) The lowest window promise at `a`, for a smaller bound, is the
lowest one for a larger bound. -/
theorem LowestIn_winL_mono {mem : Memory} {P : List Ts} {a : Address} {wb wb' t : Ts} (hle : wb ≤ wb')
    (h : LowestIn mem (winL wb P) a t) : LowestIn mem (winL wb' P) a t := by
  obtain ⟨h1, h2, h3⟩ := h
  obtain ⟨h1P, h1b⟩ := mem_winL.1 h1
  refine ⟨mem_winL.2 ⟨h1P, Nat.le_trans h1b hle⟩, h2, fun t2 h4 h5 => ?_⟩
  obtain ⟨h4P, -⟩ := mem_winL.1 h4
  by_cases hb : t2 ≤ wb
  · exact h3 t2 (mem_winL.2 ⟨h4P, hb⟩) h5
  · exact Nat.le_of_lt (Nat.lt_of_le_of_lt h1b (Nat.lt_of_not_le hb))

theorem PinW_winL_mono {mem : Memory} {P : List Ts} {l : AllocLabel} {b : Nat} {us : List Acc}
    {K : Nat → Bool} {ws : List Word} {wb wb' : Ts} (hle : wb ≤ wb')
    (h : PinW mem (winL wb' P) l b us K ws) : PinW mem (winL wb P) l b us K ws :=
  fun i o w t' hK hI hw hL => h i o w t' hK hI hw (LowestIn_winL_mono hle hL)

/-- (§11) **Plant credits add**: two plant credits at one promise make one,
pinned at both credits' units (`VRR_mix`), at the smaller window bound.  `hok`:
the pieces of the cell are `coupledOK` and `IallOK` (a planted cell's are,
`plantCpl`). -/
theorem PlantCr_add {E : TEnv} {s : St} {m : Msg} {tw : Ts} {R1 R2 : Res}
    (hok : ∀ c sb S0 b0 S, E.sto m.loc.label = some c → SegOf c.ty sb S0 → AtOff S0 b0 S →
      Ty.coupledOKIn [] S = true ∧ TermTear.IallOK [] S = true)
    (h1 : PlantCr E s m tw R1) (h2 : PlantCr E s m tw R2) : PlantCr E s m tw (R1 + R2) := by
  obtain ⟨c, sb, S0, b0, S, us, wb1, hsto, hown, hpf, hseg, hat, hS, hwu, hus, hn, hlo, hhi, htw1, hwb1, hfa1,
    hlow1, hR1⟩ := h1
  obtain ⟨c', sb', S0', b0', S', us', wb2, hsto', -, -, hseg', hat', hS', -, hus', hn', hlo', hhi', htw2, -, hfa2,
    -, hR2⟩ := h2
  rw [hsto] at hsto'; cases hsto'
  have hP := plant_piece hseg hat hS (wc_of_accs hus) hn
  have hP' := plant_piece hseg' hat' hS' (wc_of_accs hus') hn'
  obtain ⟨eb, eS⟩ := piece_match hP hP' (wc_of_accs hus) (wc_of_accs hus') hlo hhi hlo' hhi'
  subst eS
  rw [hus] at hus'; cases hus'
  rw [← eb] at hR2
  have hm1 : min wb1 wb2 ≤ wb1 := Nat.min_le_left _ _
  have hm2 : min wb1 wb2 ≤ wb2 := Nat.min_le_right _ _
  refine ⟨c, sb, S0, b0, S, us, min wb1 wb2, hsto, hown, hpf, hseg, hat, hS, hwu, hus, hn, hlo, hhi,
    Nat.le_min.2 ⟨htw1, htw2⟩, Nat.lt_of_le_of_lt hm1 hwb1,
    fun tf mf h1 h2 h3 => Nat.lt_of_le_of_lt hm1 (hfa1 tf mf h1 h2 h3),
    fun t' m' h1 h2 h3 h4 h5 h6 => hlow1 t' m' h1 h2 h3 h4 h5 (Nat.le_trans h6 hm1), ?_⟩
  obtain ⟨hcpl, hia⟩ := hok c sb S0 b0 S hsto hseg hat
  rcases hR1 with ⟨K1, ws1, R01, hl1, hv1, hle1, hp1⟩ | e1
  · rcases hR2 with ⟨K2, ws2, R02, hl2, hv2, hle2, hp2⟩ | e2
    · obtain ⟨Rm, hvm, hRm⟩ := TermTear.VRR_mix (sel := K1) hcpl hia hus hv1.1 hv2.1 hl1 hl2
      refine Or.inl ⟨fun i => K1 i || K2 i, TermTear.mixU us K1 ws1 ws2, Rm,
        TermTear.length_mixU _ _ _ _ hl1 hl2, ⟨hvm, TermTear.Valid_mix hus hv1.2 hv2.2 hl1 hl2⟩,
        fun k => ?_, PinW_mix (PinW_winL_mono hm1 hp1) (PinW_winL_mono hm2 hp2) hl1 hl2⟩
      have a1 := hRm k; have a2 := hle1 k; have a3 := hle2 k
      simp only [Res.add_apply] at a1 a2 a3 ⊢; omega
    · subst e2
      exact Or.inl ⟨K1, ws1, R01, hl1, hv1, by rw [Res.add_zero]; exact hle1, PinW_winL_mono hm1 hp1⟩
  · subst e1
    rcases hR2 with ⟨K2, ws2, R02, hl2, hv2, hle2, hp2⟩ | e2
    · exact Or.inl ⟨K2, ws2, R02, hl2, hv2, by rw [Res.zero_add]; exact hle2, PinW_winL_mono hm2 hp2⟩
    · subst e2; exact Or.inr (Res.zero_add _)

theorem PredAt_mono {mem mem' : Memory} {a : Address} {t : Ts} {w : Word} (ht : t < mem.size)
    (hpre : ∀ t, t < mem.size → mem'[t]? = mem[t]?) (h : PredAt mem a t w) : PredAt mem' a t w := by
  obtain ⟨t0, m, h1, h2, h3, h4, h5⟩ := h
  refine ⟨t0, m, h1, by rw [hpre t0 (Nat.lt_trans h1 ht)]; exact h2, h3, h4, fun t2 m2 h6 h7 h8 => ?_⟩
  rw [hpre t2 (Nat.lt_trans h7 ht)] at h8
  exact h5 t2 m2 h6 h7 h8

theorem LowestIn_back {mem mem' : Memory} {P : List Ts} {a : Address} {t : Ts}
    (hP : ∀ t, t ∈ P → t < mem.size) (hpre : ∀ t, t < mem.size → mem'[t]? = mem[t]?)
    (h : LowestIn mem' P a t) : LowestIn mem P a t := by
  obtain ⟨h1, ⟨m, h2, h3⟩, h4⟩ := h
  refine ⟨h1, ⟨m, by rw [← hpre t (hP t h1)]; exact h2, h3⟩, fun t2 h5 ⟨m2, h6, h7⟩ => h4 t2 h5 ⟨m2, ?_, h7⟩⟩
  rw [hpre t2 (hP t2 h5)]; exact h6

/-- (§11) **Plant credits are prefix-stable**: along a step that extends
memory (keeping its prefix), keeps the thread's promises, keeps the cell's
typing facts, newly skips no old foreign message, and keeps values' resources,
a plant credit stays one, unchanged. -/
theorem PlantCr_mono {E E' : TEnv} {s s' : St} {m : Msg} {tw : Ts} {R : Res}
    (hpre : ∀ t, t < s.mem.size → s'.mem[t]? = s.mem[t]?) (hsz : s.mem.size ≤ s'.mem.size)
    (hpr : s'.promises = s.promises) (hP : ∀ t, t ∈ s.promises → t < s.mem.size)
    (hsto : E'.sto m.loc.label = E.sto m.loc.label) (htid : E'.tid = E.tid)
    (hpf : E.pfr m.loc.label ≠ none → E'.pfr m.loc.label ≠ none) (hwu : WordUnit E' m.loc → WordUnit E m.loc)
    (hF : ∀ t, t < s.mem.size → t ∈ FpAt E' ⟨m.loc.label, 0⟩ → t ∈ FpAt E ⟨m.loc.label, 0⟩)
    (hV : ∀ S ws R0, ValOfR E S ws R0 → ValOfR E' S ws R0)
    (h : PlantCr E s m tw R) : PlantCr E' s' m tw R := by
  obtain ⟨c, sb, S0, b0, S, us, wb, hsto0, hown, hpf0, hseg, hat, hS, hwu0, hus, hn, hlo, hhi, htw, hwb, hfa,
    hlow, hR⟩ := h
  refine ⟨c, sb, S0, b0, S, us, wb, by rw [hsto]; exact hsto0, by rw [htid]; exact hown, hpf hpf0, hseg, hat, hS,
    fun h => hwu0 (hwu h), hus, hn, hlo, hhi, htw, Nat.lt_of_lt_of_le hwb hsz, fun tf mf h1 h2 h3 => ?_,
    fun t' m' h1 h2 h3 h4 h5 h6 => ?_, ?_⟩
  · by_cases hts : tf < s.mem.size
    · rw [hpre tf hts] at h2
      exact hfa tf mf (hF tf hts h1) h2 h3
    · exact Nat.lt_of_lt_of_le hwb (Nat.le_of_not_lt hts)
  · rw [hpr] at h1
    rw [hpre t' (hP t' h1)] at h2
    exact hlow t' m' h1 h2 h3 h4 h5 h6
  · rcases hR with ⟨K, ws, R0, hl, hv, hle, hp⟩ | e
    · refine Or.inl ⟨K, ws, R0, hl, hV S ws R0 hv, hle, fun i o w t' hK hI hw hL => ?_⟩
      rw [hpr] at hL
      have hW : ∀ t, t ∈ winL wb s.promises → t < s.mem.size := fun t ht => hP t (mem_winL.1 ht).1
      have hL0 := LowestIn_back hW hpre hL
      exact PredAt_mono (hW t' hL0.1) hpre (hp i o w t' hK hI hw hL0)
    · exact Or.inr e

/-- (dropA) `LowestIn` in a sub-list, back in the full list, when the full
list's extra entries sit at other labels. -/
theorem LowestIn_sup {mem : Memory} {P P' : List Ts} {a : Address} {t : Ts}
    (hsub : ∀ t, t ∈ P' → t ∈ P)
    (hout : ∀ t, t ∈ P → t ∉ P' → ∀ m, mem[t]? = some m → m.loc.label ≠ a.label)
    (h : LowestIn mem P' a t) : LowestIn mem P a t := by
  obtain ⟨h1, h2, h3⟩ := h
  refine ⟨hsub t h1, h2, fun t2 h4 ⟨m2, h5, h6⟩ => ?_⟩
  by_cases h7 : t2 ∈ P'
  · exact h3 t2 h7 ⟨m2, h5, h6⟩
  · exact absurd (congrArg Address.label h6) (hout t2 h4 h7 m2 h5)
#print axioms LowestIn_sup

/-- (dropA) **Plant-credit frame**: `PlantCr_mono` with the thread's promises
allowed to shrink, by promises at other labels only. -/
theorem PlantCr_frame {E E' : TEnv} {s s' : St} {m : Msg} {tw : Ts} {R : Res}
    (hpre : ∀ t, t < s.mem.size → s'.mem[t]? = s.mem[t]?) (hsz : s.mem.size ≤ s'.mem.size)
    (hpr : ∀ t, t ∈ s'.promises → t ∈ s.promises)
    (hout : ∀ t, t ∈ s.promises → t ∉ s'.promises → ∀ mt, s.mem[t]? = some mt → mt.loc.label ≠ m.loc.label)
    (hP : ∀ t, t ∈ s.promises → t < s.mem.size)
    (hsto : E'.sto m.loc.label = E.sto m.loc.label) (htid : E'.tid = E.tid)
    (hpf : E.pfr m.loc.label ≠ none → E'.pfr m.loc.label ≠ none) (hwu : WordUnit E' m.loc → WordUnit E m.loc)
    (hF : ∀ t, t < s.mem.size → t ∈ FpAt E' ⟨m.loc.label, 0⟩ → t ∈ FpAt E ⟨m.loc.label, 0⟩)
    (hV : ∀ S ws R0, ValOfR E S ws R0 → ValOfR E' S ws R0)
    (h : PlantCr E s m tw R) : PlantCr E' s' m tw R := by
  obtain ⟨c, sb, S0, b0, S, us, wb, hsto0, hown, hpf0, hseg, hat, hS, hwu0, hus, hn, hlo, hhi, htw, hwb, hfa,
    hlow, hR⟩ := h
  refine ⟨c, sb, S0, b0, S, us, wb, by rw [hsto]; exact hsto0, by rw [htid]; exact hown, hpf hpf0, hseg, hat, hS,
    fun h => hwu0 (hwu h), hus, hn, hlo, hhi, htw, Nat.lt_of_lt_of_le hwb hsz, fun tf mf h1 h2 h3 => ?_,
    fun t' m' h1 h2 h3 h4 h5 h6 => ?_, ?_⟩
  · by_cases hts : tf < s.mem.size
    · rw [hpre tf hts] at h2
      exact hfa tf mf (hF tf hts h1) h2 h3
    · exact Nat.lt_of_lt_of_le hwb (Nat.le_of_not_lt hts)
  · have h1' := hpr t' h1
    rw [hpre t' (hP t' h1')] at h2
    exact hlow t' m' h1' h2 h3 h4 h5 h6
  · rcases hR with ⟨K, ws, R0, hl, hv, hle, hp⟩ | e
    · refine Or.inl ⟨K, ws, R0, hl, hV S ws R0 hv, hle, fun i o w t' hK hI hw hL => ?_⟩
      have hW : ∀ t, t ∈ winL wb s'.promises → t < s.mem.size := fun t ht => hP t (hpr t (mem_winL.1 ht).1)
      have hL0 := LowestIn_back hW hpre hL
      have hL1 : LowestIn s.mem (winL wb s.promises) ⟨m.loc.label, sb + b0 + o⟩ t' :=
        LowestIn_sup (fun t ht => mem_winL.2 ⟨hpr t (mem_winL.1 ht).1, (mem_winL.1 ht).2⟩)
          (fun t ht hn' mt hmt => hout t (mem_winL.1 ht).1
            (fun h0 => hn' (mem_winL.2 ⟨h0, (mem_winL.1 ht).2⟩)) mt hmt) hL0
      exact PredAt_mono (hP t' (mem_winL.1 hL1.1).1) hpre (hp i o w t' hK hI hw hL1)
    · exact Or.inr e
#print axioms PlantCr_frame

/-! ## (§11) Window `Over`, `H2At′`, and the foreign-promise bound -/

/-- (§11) **`H2At′`**: every foreign message at `l` lies above every own
promise at `l` in the window below `wb`. -/
def H2AtW (mem : Memory) (P F : List Ts) (l : AllocLabel) (wb : Ts) : Prop :=
  ∀ (tf tk : Ts) (mf mk : Msg), tf ∈ F → mem[tf]? = some mf → mf.loc.label = l →
    tk ∈ P → mem[tk]? = some mk → mk.loc.label = l → tk ≤ wb → tk < tf

/-- (§11) **`ForAbove`**: every message of `F` at `l` lies above `wb`. -/
def ForAbove (mem : Memory) (F : List Ts) (l : AllocLabel) (wb : Ts) : Prop :=
  ∀ (tf : Ts) (mf : Msg), tf ∈ F → mem[tf]? = some mf → mf.loc.label = l → wb < tf

theorem H2AtW_of_ForAbove {mem : Memory} {P F : List Ts} {l : AllocLabel} {wb : Ts} (h : ForAbove mem F l wb) :
    H2AtW mem P F l wb :=
  fun tf _ mf _ h1 h2 h3 _ _ _ hle => Nat.lt_of_le_of_lt hle (h tf mf h1 h2 h3)

/-- (§11) A plant credit carries its window's foreign-promise bound. -/
theorem PlantCr_forAbove {E : TEnv} {s : St} {m : Msg} {tw : Ts} {R : Res} (h : PlantCr E s m tw R) :
    ∃ wb, tw ≤ wb ∧ ForAbove s.mem (FpAt E ⟨m.loc.label, 0⟩) m.loc.label wb :=
  let ⟨_, _, _, _, _, _, wb, _, _, _, _, _, _, _, _, _, _, _, htw, _, hfa, _, _⟩ := h
  ⟨wb, htw, hfa⟩

/-- (§11) **`Over_mono_cut` on the window** below `wb`: as `Over_mono_cut`,
for the owner's window promises, under `H2At′`. -/
theorem Over_mono_cutW {E E' : TEnv} {s s' : St} {l : AllocLabel} {b n : Nat} {wb : Ts}
    (hloc : ∀ t (u : Address), t < s.mem.size →
      ((∃ m, s.mem[t]? = some m ∧ m.loc = u) ↔ (∃ m, s'.mem[t]? = some m ∧ m.loc = u)))
    (hpr : s'.promises = s.promises) (hP : ∀ t, t ∈ s.promises → t < s.mem.size)
    (hv : ∀ o, o < n → ¬ VisU E ⟨l, b + o⟩) (hv' : ∀ o, o < n → ¬ VisU E' ⟨l, b + o⟩)
    (hq : ∀ o, o < n → ¬ PredU E ⟨l, b + o⟩) (hq' : ∀ o, o < n → ¬ PredU E' ⟨l, b + o⟩)
    (hF : ∀ t, t < s.mem.size → t ∈ FpAt E' ⟨l, 0⟩ → t ∈ FpAt E ⟨l, 0⟩)
    (hH2 : H2AtW s.mem s.promises (FpAt E ⟨l, 0⟩) l wb)
    (h : Over s.mem (winL wb s.promises) (PromAt E s) l b n) :
    Over s'.mem (winL wb s'.promises) (PromAt E' s') l b n := by
  obtain ⟨o, ho, hu⟩ := h
  have eF : ∀ (E0 : TEnv) (x : Nat), FpAt E0 ⟨l, x⟩ = FpAt E0 ⟨l, 0⟩ := fun _ _ => rfl
  have e1 : PromAt E s ⟨l, b + o⟩ = s.promises ++ FpAt E ⟨l, 0⟩ := by
    rw [PromAt_nword (hv o ho) (hq o ho), eF]
  have e2 : PromAt E' s' ⟨l, b + o⟩ = s.promises ++ FpAt E' ⟨l, 0⟩ := by
    rw [PromAt_nword (hv' o ho) (hq' o ho), eF, hpr]
  refine ⟨o, ho, ?_⟩
  rw [hpr, e2]
  rw [e1] at hu
  refine OverU_mono_gen (hloc · _) (fun t ht => hP t (mem_winL.1 ht).1) (fun t ht h => ?_)
    (fun tq t' h1 h2 h3 h4 => ?_) hu
  · rcases List.mem_append.1 h with h | h
    · exact List.mem_append_left _ h
    · exact List.mem_append_right _ (hF t ht h)
  · rcases List.mem_append.1 h1 with h | h
    · exact absurd (List.mem_append_left _ h) h2
    · obtain ⟨mq, hmq, hlq⟩ := h3
      obtain ⟨hk, ⟨mk, hmk, hlk⟩, -⟩ := h4
      obtain ⟨hkP, hkb⟩ := mem_winL.1 hk
      exact hH2 tq t' mq mk h hmq (by rw [hlq]) hkP hmk (by rw [hlk]) hkb

/-- (§11) **Completeness of a plant credit** (D3's predicate, not part of
`PlantCr`): a plant credit whose pinned units `K` cover every access unit of
the piece holding an overtaken window unit. -/
def PlantCrC (E : TEnv) (s : St) (m : Msg) (tw : Ts) (R : Res) : Prop :=
  ∃ c sb S0 b0 S us wb, E.sto m.loc.label = some c ∧ c.owner = some E.tid ∧ E.pfr m.loc.label ≠ none ∧
    SegOf c.ty sb S0 ∧ AtOff S0 b0 S ∧ Solid S ∧ ¬ WordUnit E m.loc ∧ accs S = some us ∧ 0 < nWords us ∧
    sb + b0 ≤ m.loc.offset ∧ m.loc.offset < sb + b0 + nWords us ∧ tw ≤ wb ∧ wb < s.mem.size ∧
    (∀ tf mf, tf ∈ FpAt E ⟨m.loc.label, 0⟩ → s.mem[tf]? = some mf → mf.loc.label = m.loc.label → wb < tf) ∧
    (∀ t' m', t' ∈ s.promises → s.mem[t']? = some m' → m'.loc.label = m.loc.label →
      sb + b0 ≤ m'.loc.offset → m'.loc.offset < sb + b0 + nWords us → t' ≤ wb → tw ≤ t') ∧
    ∃ K ws R0, ws.length = nWords us ∧ ValOfR E S ws R0 ∧ R0 ≤ R ∧
      PinW s.mem (winL wb s.promises) m.loc.label (sb + b0) us K ws ∧
      ∀ i o, InAcc us i o →
        OverU s.mem (winL wb s.promises) (PromAt E s ⟨m.loc.label, sb + b0 + o⟩) ⟨m.loc.label, sb + b0 + o⟩ →
        K i = true

theorem PlantCrC.toCr {E : TEnv} {s : St} {m : Msg} {tw : Ts} {R : Res} (h : PlantCrC E s m tw R) :
    PlantCr E s m tw R :=
  let ⟨c, sb, S0, b0, S, us, wb, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15,
    K, ws, R0, b1, b2, b3, b4, _⟩ := h
  ⟨c, sb, S0, b0, S, us, wb, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15,
    Or.inl ⟨K, ws, R0, b1, b2, b3, b4⟩⟩


/-- (D3 L4) **The fulfilling read is the predecessor**: at unit `a`, if every
message above coherence and at most `wb` is a promise of `P` (`WinOwn`), no
promise of `P` at `a` lies below `tw`, and the read message `tm` is at or above
coherence and below `tw ≤ wb`, then `tm` is the message just before `tw`. -/
theorem pred_of_win {mem : Memory} {P : List Ts} {a : Address} {coh tm tw wb : Ts} {m : Msg}
    (hwin : ∀ t m', mem[t]? = some m' → m'.loc = a → coh < t → t ≤ wb → t ∈ P)
    (hlow : ∀ t m', t ∈ P → mem[t]? = some m' → m'.loc = a → t < tw → False)
    (hcoh : coh ≤ tm) (hm : mem[tm]? = some m) (hl : m.loc = a) (hlt : tm < tw) (hwb : tw ≤ wb) :
    PredAt mem a tw (mw m) := by
  refine ⟨tm, m, hlt, hm, hl, rfl, fun t' m' h1 h2 h3 h4 => ?_⟩
  exact hlow t' m' (hwin t' m' h3 h4 (Nat.lt_of_le_of_lt hcoh h1) (Nat.le_trans (Nat.le_of_lt h2) hwb)) h3 h4 h2

theorem offs_ne {a : Address} {i j : Nat} (h : i ≠ j) : offs a i ≠ offs a j := by
  intro e
  have h1 : (offs a i).offset = (offs a j).offset := by rw [e]
  exact h (Nat.add_left_cancel h1)

/-- (D3) **A store that does not grow memory fulfils every unit**: memory is
unchanged and each stored unit `j` discharges an own promise `F[j]` above the
pre-state coherence at that unit, holding the stored value; the promises split
as the remaining ones plus `F`. -/
theorem storeUnits_fulAll {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s s' : St), s.promises.Nodup →
      s' ∈ storeUnits k arch pw a rel us ws i s → s'.mem.size ≤ s.mem.size →
      s'.mem = s.mem ∧ (∀ u, u ∈ us → u = .one) ∧ ∃ F : List Ts, F.length = nWords us ∧
        (∀ f : Ts → Res, Res.sum (s.promises.map f) = Res.sum (s'.promises.map f) + Res.sum (F.map f)) ∧
        (∀ x, (∀ j, j < nWords us → x ≠ offs a (i + j)) → s'.vs.coh x = s.vs.coh x) ∧
        (∀ t, t ∈ s.promises → t ∈ s'.promises ∨ t ∈ F) ∧
        ∀ j t, F[j]? = some t → t ∈ s.promises ∧ t ∉ s'.promises ∧ ∃ m w, s.mem[t]? = some m ∧
          ws[j]? = some w ∧ m.loc = offs a (i + j) ∧ m.val = w.val ∧ s.vs.coh (offs a (i + j)) < t ∧
          s.vs.vRelSt ≤ m.view ∧ (∀ x g, w.val = .loc x g → w.view ≤ m.view) ∧
          s'.vs.coh (offs a (i + j)) = t
  | [], _, _, s, s', _, hs, _ => by
      simp only [storeUnits, List.mem_singleton] at hs; subst hs
      exact ⟨rfl, fun u h => by simp at h, [], rfl, fun f => Res.ext fun k => by simp, fun _ _ => rfl,
        fun t h => Or.inl h, fun j t h => by simp at h⟩
  | .one :: us, w :: ws, i, s, s', hnd, hs, hsz => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      obtain ⟨t0, hcase, hcoh, hrs, -⟩ := stepStore_casesC hst
      have ev : exprVal (mth s pw w w) (dataE 1 w) = w.val := exprVal_dataE _ 1 w (by simp [mth, regsOf])
      have hmw : ∀ x g, w.val = .loc x g → w.view ≤ Promises.storeMview (mth s pw w w) (dataE 1 w) [0] rel :=
        storeMview_dataE _ 1 w (by simp [mth, regsOf]) [0] rel
      have hmr : s.vs.vRelSt ≤ Promises.storeMview (mth s pw w w) (dataE 1 w) [0] rel :=
        storeMview_relSt (mth s pw w w) _ [0] rel
      have hg := (storeUnits_growsF us ws (i + 1) _ s' hs)
      rcases hcase with ⟨hmem, -, -⟩ | ⟨hmem, htp, hprom, hlt, m0, hm0, hma, hmv, hmv'⟩
      · exfalso
        have : mem'.size ≤ s'.mem.size := hg.1.1
        rw [hmem, Array.size_push] at this; omega
      · have hnd1 : th.promises.Nodup := by rw [hprom]; exact hnd.erase _
        have hsz1 : s'.mem.size ≤ mem'.size := by rw [hmem]; exact hsz
        obtain ⟨e1, h1s, F, hFl, hFs, hco, hmem1, g⟩ := storeUnits_fulAll us ws (i + 1)
          { s with mem := mem', vs := th.vs, promises := th.promises } s' hnd1 hs hsz1
        have hsub : ∀ t, t ∈ th.promises → t ∈ s.promises := fun t ht => by
          rw [hprom] at ht; exact List.mem_of_mem_erase ht
        refine ⟨e1.trans hmem, fun u hu => ?_, t0 :: F, by rw [List.length_cons, hFl, TermMem.nWords_one], fun f => ?_,
          fun x hx => ?_, fun t ht => ?_, fun j t hj => ?_⟩
        · rcases List.mem_cons.1 hu with rfl | hu
          · rfl
          · exact h1s u hu
        · have h1 : Res.sum (s.promises.map f) = f t0 + Res.sum ((s.promises.erase t0).map f) :=
            sum_map_erase (f := f) htp
          have h2 := hFs f
          have e : th.promises = s.promises.erase t0 := hprom
          rw [← e] at h1
          change Res.sum (th.promises.map f) = _ at h2
          rw [h2] at h1
          rw [h1]
          refine Res.ext fun k => ?_
          simp only [Res.add_apply, List.map_cons, Res.sum_cons]
          omega
        · have e2 : s'.vs.coh x = th.vs.coh x := hco x fun j hj => by
            have := hx (j + 1) (by rw [TermMem.nWords_one]; omega)
            rwa [show i + (j + 1) = i + 1 + j by omega] at this
          rw [e2, hcoh]
          have hx0 : x ≠ offs a i := by simpa using hx 0 (by rw [TermMem.nWords_one]; omega)
          simp only [hx0, ite_false]
          rfl
        · by_cases e : t = t0
          · exact Or.inr (e ▸ List.mem_cons_self ..)
          · have : t ∈ th.promises := by rw [hprom]; exact (List.mem_erase_of_ne e).2 ht
            rcases hmem1 t this with h | h
            · exact Or.inl h
            · exact Or.inr (List.mem_cons_of_mem _ h)
        rcases j with _ | j
        · simp only [List.getElem?_cons_zero, Option.some.injEq] at hj; subst hj
          refine ⟨htp, fun h => ?_, m0, w, hm0, rfl, by rw [hma]; rfl, by rw [hmv, ev], hlt,
            Nat.le_trans hmr hmv', fun x g hx => Nat.le_trans (hmw x g hx) hmv', ?_⟩
          · have h2 : t0 ∈ th.promises := hg.2.1 t0 h
            rw [hprom] at h2; exact (List.Nodup.not_mem_erase hnd) h2
          · have e2 : s'.vs.coh (offs a (i + 0)) = th.vs.coh (offs a (i + 0)) := hco _ fun j _ =>
              offs_ne (by omega)
            rw [e2, hcoh]; simp
        · simp only [List.getElem?_cons_succ] at hj
          obtain ⟨h1, h2, m, w', h3, hw, h4, hv, h5, h6, h7, h8⟩ := g j t hj
          have hne : offs a (i + 1 + j) ≠ offs a i := offs_ne (by omega)
          have h3' : mem'[t]? = some m := h3
          rw [hmem] at h3'
          refine ⟨hsub t h1, h2, m, w', h3', by simpa using hw,
            by rw [h4, show i + 1 + j = i + (j + 1) by omega], hv, ?_,
            Nat.le_trans (Nat.le_of_eq hrs.symm) h6, h7, ?_⟩
          have h5' : th.vs.coh (offs a (i + 1 + j)) < t := h5
          rw [hcoh] at h5'; simp only [hne, ite_false] at h5'
          · rw [show i + (j + 1) = i + 1 + j by omega]; exact h5'
          · rw [show i + (j + 1) = i + 1 + j by omega]; exact h8
  | .two :: us, w0 :: w1 :: ws, i, s, s', _, hs, hsz => by
      simp only [storeUnits] at hs
      obtain ⟨q1, _, _, _, _⟩ := stepStorePair_eq s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel
      generalize Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel = R at q1 hs
      obtain ⟨mem', pairs', th⟩ := R
      simp only at q1 hs
      exfalso
      have : mem'.size ≤ s'.mem.size := (storeUnits_growsF us ws (i + 2) _ s' hs).1.1
      rw [q1, Array.size_push, Array.size_push] at this; omega
  | .one :: _, [], _, _, _, _, hs, _ => by simp [storeUnits] at hs
  | .two :: _, [], _, _, _, _, hs, _ => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, _, _, hs, _ => by simp [storeUnits] at hs

/-- A message not hidden below `b` has no later message at its address up to `b`. -/
theorem nhid {mem : Memory} {a : Address} {t b t' : Ts} {m' : Msg} (hh : WeakMem.hiddenFrom mem a t b = false)
    (h1 : t < t') (h2 : t' ≤ b) (hm : mem[t']? = some m') (hl : m'.loc = a) : False := by
  have hT : WeakMem.hiddenFrom mem a t b = true := by
    unfold WeakMem.hiddenFrom; rw [List.any_eq_true]
    exact ⟨t', List.mem_range.2 (Nat.lt_succ_of_le h2), by simp [h1, hm, hl]⟩
  rw [hh] at hT; cases hT

/-- (D3 L4′) **`pred_of_win`, from a read**: if every message at `a` above
coherence and below `tw` is a promise of `P`, none of which lies below `tw`,
then the read message `tm < tw`, not hidden below a bound `bnd ≥ coh`, is the
message just before `tw`. -/
theorem pred_of_rd {mem : Memory} {P : List Ts} {a : Address} {coh bnd tm tw : Ts} {m : Msg}
    (hwin : ∀ t m', mem[t]? = some m' → m'.loc = a → coh < t → t < tw → t ∈ P)
    (hlow : ∀ t m', t ∈ P → mem[t]? = some m' → m'.loc = a → t < tw → False)
    (hh : WeakMem.hiddenFrom mem a tm bnd = false) (hcb : coh ≤ bnd)
    (hm : mem[tm]? = some m) (hl : m.loc = a) (hlt : tm < tw) :
    PredAt mem a tw (mw m) := by
  refine ⟨tm, m, hlt, hm, hl, rfl, fun t' m' h1 h2 h3 h4 => ?_⟩
  by_cases hb : t' ≤ bnd
  · exact nhid hh h1 hb h3 h4
  · exact hlow t' m' (hwin t' m' h3 h4 (Nat.lt_of_le_of_lt hcb (Nat.lt_of_not_le hb)) h2) h3 h4 h2

/-- (D3) **A fulfilled unit that is not overtaken**: before, memory reads the
fulfilling read's message `tm`; after (skip list `Q'` = `Q` without `tw`),
the fulfilled message `tw`. -/
theorem unitA {mem : Memory} {Q Q' : List Ts} {a : Address} {tw tm : Ts} {mtw mtm : Msg}
    (hQ' : ∀ t m, mem[t]? = some m → m.loc = a → (t ∈ Q' ↔ t ∈ Q ∧ t ≠ tw))
    (hmw : mem[tw]? = some mtw) (hlw : mtw.loc = a) (htwQ : tw ∈ Q)
    (hmm : mem[tm]? = some mtm) (hlm : mtm.loc = a) (hlt : tm < tw)
    (hpred : ∀ t m, tm < t → t < tw → mem[t]? = some m → m.loc ≠ a)
    (hlow : ∀ t m, t ∈ Q → mem[t]? = some m → m.loc = a → tw ≤ t)
    (hA : ∀ t m, tw < t → mem[t]? = some m → m.loc = a → t ∈ Q) :
    LatestNP mem Q a (mw mtm) ∧ LatestNP mem Q' a (mw mtw) := by
  refine ⟨⟨tm, mtm, fun h => absurd (hlow tm mtm h hmm hlm) (Nat.not_le.2 hlt), hmm, hlm, rfl,
    fun t' m' h1 h2 h3 => ?_⟩, ⟨tw, mtw, fun h => ((hQ' tw mtw hmw hlw).1 h).2 rfl, hmw, hlw, rfl,
    fun t' m' h1 h2 h3 => (hQ' t' m' h2 h3).2 ⟨hA t' m' h1 h2 h3, Nat.ne_of_gt h1⟩⟩⟩
  rcases Nat.lt_trichotomy t' tw with h | rfl | h
  · exact absurd h3 (hpred t' m' h1 h h2)
  · exact htwQ
  · exact hA t' m' h h2 h3

/-- (D3) **A fulfilled unit that is overtaken** (a non-skipped message above
`tw`): memory's reading is unchanged. -/
theorem unitO {mem : Memory} {Q Q' : List Ts} {a : Address} {tw : Ts} {v : Word}
    (hQ' : ∀ t m, mem[t]? = some m → m.loc = a → (t ∈ Q' ↔ t ∈ Q ∧ t ≠ tw))
    (hO : ∃ t m, tw < t ∧ mem[t]? = some m ∧ m.loc = a ∧ t ∉ Q)
    (hl : LatestNP mem Q a v) : LatestNP mem Q' a v := by
  obtain ⟨t, m, ht, hm, hloc, hw, hlast⟩ := hl
  obtain ⟨to, mo, h1, h2, h3, h4⟩ := hO
  have hge : to ≤ t := Nat.le_of_not_lt fun h => h4 (hlast to mo h h2 h3)
  refine ⟨t, m, fun h => ht ((hQ' t m hm hloc).1 h).1, hm, hloc, hw, fun t' m' h5 h6 h7 =>
    (hQ' t' m' h6 h7).2 ⟨hlast t' m' h5 h6 h7, fun e => ?_⟩⟩
  subst e; exact absurd (Nat.lt_trans (Nat.lt_of_lt_of_le h1 hge) h5) (Nat.lt_irrefl _)

/-- (D3) An overtaken unit is `OverU` for its lowest window promise. -/
theorem overU_of {mem : Memory} {Q W : List Ts} {a : Address} {tw : Ts} {v : Word}
    (hlw : LowestIn mem W a tw)
    (hO : ∃ t m, tw < t ∧ mem[t]? = some m ∧ m.loc = a ∧ t ∉ Q)
    (hl : LatestNP mem Q a v) : OverU mem W Q a := by
  obtain ⟨t, m, ht, hm, hloc, -, hlast⟩ := hl
  obtain ⟨to, mo, h1, h2, h3, h4⟩ := hO
  have hge : to ≤ t := Nat.le_of_not_lt fun h => h4 (hlast to mo h h2 h3)
  exact ⟨t, tw, ⟨ht, ⟨m, hm, hloc⟩, hlast⟩, hlw, fun h => Nat.lt_irrefl _ (Nat.lt_trans (Nat.lt_of_lt_of_le h1 hge) h.1)⟩

/-- (D3) **A fulfilling step, with credits**: a step that keeps memory and
discharges exactly the promises `F` pays their debts out of their credits
(plant credits included); the remaining promises keep their old credits with
plant credits dropped. -/
theorem mc_ofFul {p : Prog} {g : G} {mem mem' : Memory} {pairs pairs' : List Ts} {th th' : TTh}
    {η : TEnv} {Tot H' Rf Rs H : Res} {cr db : Ts → Res} {F : List Ts}
    (hC : PromCrP (CE η) (stOf mem pairs th) cr db)
    (hT : ThInvRE p (CE η) th' Tot) (hm' : MemInv g (CE η) (stOf mem' pairs' th'))
    (hH' : MemHeld (CE η) (stOf mem' pairs' th') H') (hmem : mem' = mem)
    (hsplit : ∀ f : Ts → Res, Res.sum (th.promises.map f) = Res.sum (th'.promises.map f) + Res.sum (F.map f))
    (hsub : ∀ t, t ∈ th'.promises → t ∈ th.promises)
    (hle : Tot + H' + Res.sum (F.map db) ≤ Rf + Rs + H + Res.sum (F.map cr)) :
    ∃ Tot H' C F, ThInvMCF p g (CE η) (stOf mem pairs th) mem' pairs' th' Tot H' (dropP (CE η) (stOf mem pairs th) cr) db ∧
      MintStepN g η (stOf mem pairs th) (stOf mem' pairs' th') C F ∧
      Tot + H' + pSum (stOf mem' pairs' th') (dropP (CE η) (stOf mem pairs th) cr) + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf mem' pairs' th') db + F := by
  subst mem'
  have hC0 := PromCrP_drop hC
  have hC' : PromCr (CE η) (stOf mem pairs' th') (dropP (CE η) (stOf mem pairs th) cr) db :=
    fun tw htw => hC0 tw (hsub tw htw)
  refine ⟨Tot, H', .zero, .zero, ⟨CE η, EFoot_refl, (by seenT), (by boxT), hT, hm', hH', hC'⟩, .none, ?_⟩
  have e1 := hsplit cr
  have e2 := hsplit db
  have h3 : pSum (stOf mem pairs' th') (dropP (CE η) (stOf mem pairs th) cr) ≤ pSum (stOf mem pairs' th') cr :=
    pSum_dropP_le
  intro k
  have h1 := hle k
  have h4 := h3 k
  have e1k := congrArg (fun R : Res => R k) e1
  have e2k := congrArg (fun R : Res => R k) e2
  simp only [pSum, stOf, Res.add_apply, Res.zero_apply] at h1 h4 e1k e2k ⊢
  omega

/-- (D3) **What a single-word load reads, with coherence**: each unit reads a
message at its address, not hidden below the address register's view nor the
pre-load coherence, at or below the post-load coherence there. -/
theorem loadUnits_rd1 {arch : Arch} {pw : Word} {a : Address} {acq : Bool} :
    ∀ (us : List Acc) (k : Nat) (s : St) (r : St × List Word), r ∈ loadUnits arch pw a acq us k s →
      (∀ u, u ∈ us → u = .one) →
      r.2.length = us.length ∧ ∀ j w, r.2[j]? = some w → ∃ (t : Ts) (m : Msg), s.mem[t]? = some m ∧
        m.loc = offs a (k + j) ∧
        WeakMem.hiddenFrom s.mem (offs a (k + j)) t (max pw.view (s.vs.coh (offs a (k + j)))) = false ∧
        WLe1 (mw m) w ∧ t ≤ r.1.vs.coh (offs a (k + j))
  | [], k, s, r, hr, _ => by
      simp only [loadUnits, List.mem_singleton] at hr; subst hr
      exact ⟨rfl, fun j w h => by simp at h⟩
  | .one :: us, k, s, r, hr, h1 => by
      simp only [loadUnits, List.mem_flatMap, List.mem_map] at hr
      obtain ⟨th, hth, ⟨s', ws⟩, hmem, rfl⟩ := hr
      have hcm := loadUnits_cohMono us (k + 1) _ (s', ws) hmem
      simp only [Promises.stepLoad, List.mem_map, List.mem_filter, List.mem_range] at hth
      obtain ⟨t, ⟨_, hrd⟩, rfl⟩ := hth
      obtain ⟨g1, g2⟩ := loadUnits_rd1 us (k + 1) _ (s', ws) hmem (fun u hu => h1 u (List.mem_cons_of_mem _ hu))
      obtain ⟨m, hm, hloc, hh⟩ := readable_get hrd
      have e : s.mem[t]! = m := by simp [getElem!_def, hm]
      refine ⟨by simp [g1], fun j w hj => ?_⟩
      rcases j with _ | j
      · simp only [List.getElem?_cons_zero, Option.some.injEq] at hj
        subst hj
        refine ⟨t, m, hm, by rw [hloc]; rfl, ?_, ⟨by simp [mw, e], fun _ _ _ => by simp [mw, e]⟩, ?_⟩
        · exact hiddenFrom_mono (Nat.max_le.2 ⟨view_le_bound arch s pw s.vs _, coh_le_bound _ _ _ _⟩) hh
        · refine Nat.le_trans ?_ (hcm (offs a (k + 0)))
          show t ≤ (if offs a (k + 0) = offs a k then max (s.vs.coh (offs a k)) t else s.vs.coh (offs a (k + 0)))
          simp only [Nat.add_zero, ite_true]
          exact Nat.le_max_right _ _
      · simp only [List.getElem?_cons_succ] at hj
        obtain ⟨t', m', hm', hl', hh', hw', hc'⟩ := g2 j w hj
        have hne : offs a (k + 1 + j) ≠ offs a k := offs_ne (by omega)
        have ec : (if offs a (k + 1 + j) = offs a k then max ((mth s pw pw pw).vs.coh (offs a k)) t
            else (mth s pw pw pw).vs.coh (offs a (k + 1 + j))) = s.vs.coh (offs a (k + 1 + j)) := by
          simp only [hne, ite_false]; rfl
        rw [show k + (j + 1) = k + 1 + j by omega]
        refine ⟨t', m', hm', hl', ?_, hw', hc'⟩
        have := hh'
        simp only at this
        rw [ec] at this
        exact this
  | .two :: _, _, _, _, _, h1 => absurd (h1 _ (List.mem_cons_self ..)) (by simp)

/-- (D3) **Patching a word unit**: replacing the word `w0` at a non-ghost word
position by `w` changes the value's resources by exactly the region token. -/
theorem patchW {E : TEnv} {T : Ty} {o k : Nat} {P : Proto} (hat : AtOff T o (.word (.lit k) P))
    (hg : P.ghost = false) {C : List Word} {R : Res} (hv : VRR (fun _ => 0) (CE E) T (shp T) C R)
    (hwc : wc T = some C.length) {w0 w : Word} (h0 : C[o]? = some w0) {Rw : Res}
    (hw : VRR (fun _ => 0) (CE E) (.word (.lit k) P) (shp (.word (.lit k) P)) [w] Rw) :
    ∃ R', VRR (fun _ => 0) (CE E) T (shp T) (C.take o ++ [w] ++ C.drop (o + 1)) R' ∧
      R' + wr P k w0.val = R + wr P k w.val := by
  obtain ⟨n, Rq, Rr, hwn, hle, hR, hvq, hput⟩ := VRR_at E hat hv hwc
  rw [wc_word hg] at hwn
  obtain rfl : 1 = n := Option.some.inj hwn
  have hq : (C.drop o).take 1 = [w0] := by
    rw [List.take_one, List.head?_drop, h0]; rfl
  rw [hq] at hvq
  have e1 := VRR_word_wr hvq
  have e2 := VRR_word_wr hw
  refine ⟨Rw + Rr, hput [w] Rw hw rfl, ?_⟩
  subst e1 e2 hR
  refine Res.ext fun x => ?_
  simp only [Res.add_apply]
  omega

/-- (OvW3 R1) **Patching a piece from a credit, with the dropped complement**: mixing a
credit value `ws` (holding `R0`) into the piece at `q` leaves the complement mix (the piece's
current words at the `K` units, `ws` elsewhere) holding `Rd`, and the patched value plus `Rd`
costs at most `R0`. -/
theorem patchOD {E : TEnv} {ρ₀ : Nat → Nat} {T S : Ty} {q : Nat} {usS : List Acc} (hat : AtOff T q S)
    (hus : accs S = some usS) (hcS : Ty.coupledOKIn [] S = true) (hiS : TermTear.IallOK [] S = true)
    {C : List Word} {R : Res} (hv : VRR ρ₀ (CE E) T (shp T) C R) (hwc : wc T = some C.length)
    {ws : List Word} {R0 : Res} (hws : VRR ρ₀ (CE E) S (shp S) ws R0) (hl : ws.length = nWords usS)
    (K : Nat → Bool) :
    ∃ R' Rd, VRR ρ₀ (CE E) T (shp T)
        (C.take q ++ TermTear.mixU usS K ws ((C.drop q).take (nWords usS)) ++ C.drop (q + nWords usS)) R' ∧
      VRR ρ₀ (CE E) S (shp S) (TermTear.mixU usS K ((C.drop q).take (nWords usS)) ws) Rd ∧
      R' + Rd ≤ R + R0 := by
  obtain ⟨n, Rq, Rr, hwn, hle, hR, hvq, hput⟩ := VRR_at E hat hv hwc
  rw [wc_of_accs hus] at hwn
  obtain rfl : nWords usS = n := Option.some.inj hwn
  have hlq : ((C.drop q).take (nWords usS)).length = nWords usS := by
    simp only [List.length_take, List.length_drop]; omega
  obtain ⟨Ra, Rb, hva, hvb, hab⟩ := TermTear.VRR_mix2 (sel := K) hcS hiS hus hws hvq hl hlq
  refine ⟨Ra + Rr, Rb, hput _ Ra hva (TermTear.length_mixU usS K _ _ hl hlq), hvb, ?_⟩
  subst hR
  intro x
  have h1 := hab x
  simp only [Res.add_apply] at h1 ⊢
  omega

#print axioms patchOD

/-- (D3) **Patching a piece from a credit**: mixing a credit value `ws` (holding
`R0`) into the piece at `q` costs at most `R0`. -/
theorem patchO {E : TEnv} {ρ₀ : Nat → Nat} {T S : Ty} {q : Nat} {usS : List Acc} (hat : AtOff T q S)
    (hus : accs S = some usS) (hcS : Ty.coupledOKIn [] S = true) (hiS : TermTear.IallOK [] S = true)
    {C : List Word} {R : Res} (hv : VRR ρ₀ (CE E) T (shp T) C R) (hwc : wc T = some C.length)
    {ws : List Word} {R0 : Res} (hws : VRR ρ₀ (CE E) S (shp S) ws R0) (hl : ws.length = nWords usS)
    (K : Nat → Bool) :
    ∃ R', VRR ρ₀ (CE E) T (shp T)
        (C.take q ++ TermTear.mixU usS K ws ((C.drop q).take (nWords usS)) ++ C.drop (q + nWords usS)) R' ∧
      R' ≤ R + R0 := by
  obtain ⟨R', Rd, hv', -, hle⟩ := patchOD hat hus hcS hiS hv hwc hws hl K
  refine ⟨R', hv', fun x => ?_⟩
  have h1 := hle x
  simp only [Res.add_apply] at h1 ⊢
  omega

/-- Every word of a layout lies in some access unit. -/
theorem inAcc_ex : ∀ (us : List Acc) (o : Nat), o < nWords us → ∃ i, InAcc us i o
  | [], o, h => by simp [nWords] at h
  | u :: us, o, h => by
      rw [TermTear.nWords_cons] at h
      by_cases ho : o < u.size
      · refine ⟨0, ?_, ?_⟩ <;> simp [TermTear.nWords_cons, TermTear.nWords_nil] <;> omega
      · obtain ⟨i, h1, h2⟩ := inAcc_ex us (o - u.size) (by omega)
        refine ⟨i + 1, ?_, ?_⟩
        · rw [List.take_succ_cons, TermTear.nWords_cons]; omega
        · rw [List.take_succ_cons, TermTear.nWords_cons]; omega

theorem patch_get {C M : List Word} {q n : Nat} (hM : M.length = n) (hC : q + n ≤ C.length) (p : Nat) :
    (C.take q ++ M ++ C.drop (q + n))[p]? = if q ≤ p ∧ p < q + n then M[p - q]? else C[p]? := by
  have hq : (C.take q).length = q := by simp only [List.length_take]; omega
  have hl : (C.take q ++ M).length = q + n := by simp only [List.length_append, hq, hM]
  split
  · rename_i h
    rw [List.getElem?_append_left (by omega), List.getElem?_append_right (by omega), hq]
  · rename_i h
    by_cases hp : p < q
    · rw [List.getElem?_append_left (by omega), List.getElem?_append_left (by omega),
        List.getElem?_take_of_lt hp]
    · rw [List.getElem?_append_right (by omega), hl, List.getElem?_drop]
      congr 1; omega

/-- A credit patch item: credit value `ws` (holding `R0`) for the piece `S`
(layout `us`) at word `q`, selecting the units `K`. -/
structure PatchIt where
  q : Nat
  S : Ty
  us : List Acc
  ws : List Word
  R0 : Res
  K : Nat → Bool

/-- The patch of `C` by item `g`. -/
def PatchIt.app (g : PatchIt) (C : List Word) : List Word :=
  C.take g.q ++ TermTear.mixU g.us g.K g.ws ((C.drop g.q).take (nWords g.us)) ++ C.drop (g.q + nWords g.us)

/-- Word `p` is covered by item `g`. -/
def PatchIt.Cov (g : PatchIt) (p : Nat) : Prop := g.q ≤ p ∧ ∃ i, InAcc g.us i (p - g.q) ∧ g.K i = true

/-- Item `g` is good for target `P0` in a value of `T`. -/
def PatchIt.OK (E : TEnv) (ρ₀ : Nat → Nat) (T : Ty) (P0 : List Word) (g : PatchIt) : Prop :=
  AtOff T g.q g.S ∧ accs g.S = some g.us ∧ Ty.coupledOKIn [] g.S = true ∧ TermTear.IallOK [] g.S = true ∧
    VRR ρ₀ (CE E) g.S (shp g.S) g.ws g.R0 ∧ g.ws.length = nWords g.us ∧
    ∀ i o, g.K i = true → InAcc g.us i o → g.ws[o]? = P0[g.q + o]?

theorem PatchIt.app_get {g : PatchIt} {C : List Word} (hl : g.ws.length = nWords g.us)
    (hC : g.q + nWords g.us ≤ C.length) (p : Nat) :
    (g.app C)[p]? = C[p]? ∨ (g.Cov p ∧ (g.app C)[p]? = g.ws[p - g.q]?) := by
  have hlq : ((C.drop g.q).take (nWords g.us)).length = nWords g.us := by
    simp only [List.length_take, List.length_drop]; omega
  unfold PatchIt.app
  rw [patch_get (TermTear.length_mixU g.us g.K _ _ hl hlq) hC]
  split
  · rename_i h
    obtain ⟨i, hi⟩ := inAcc_ex g.us (p - g.q) (by omega)
    rw [TermTear.mixU_getElem g.us g.K _ _ i _ hl hlq hi]
    cases hk : g.K i
    · left
      simp only [Bool.false_eq_true, ↓reduceIte]
      rw [List.getElem?_take_of_lt (by omega), List.getElem?_drop]; congr 1; omega
    · right
      exact ⟨⟨h.1, i, hi, hk⟩, by simp⟩
  · left; rfl

theorem PatchIt.app_cov {g : PatchIt} {C : List Word} (hl : g.ws.length = nWords g.us)
    (hC : g.q + nWords g.us ≤ C.length) {p : Nat} (hp : g.Cov p) :
    (g.app C)[p]? = g.ws[p - g.q]? := by
  obtain ⟨hq, i, hi, hk⟩ := hp
  have hlq : ((C.drop g.q).take (nWords g.us)).length = nWords g.us := by
    simp only [List.length_take, List.length_drop]; omega
  have hin : p - g.q < nWords g.us := Nat.lt_of_lt_of_le hi.2 (TermTear.nWords_take_le _ _)
  unfold PatchIt.app
  rw [patch_get (TermTear.length_mixU g.us g.K _ _ hl hlq) hC]
  have hc : g.q ≤ p ∧ p < g.q + nWords g.us := ⟨hq, by omega⟩
  simp only [hc, and_self, ↓reduceIte]
  rw [TermTear.mixU_getElem g.us g.K _ _ i _ hl hlq hi, hk]
  rfl

/-- (OvW3 R1) **Iterated patching, with the dropped complements**: as `patchAll`, plus one drop
entry `(g, Rd, Cd)` per item (in order): `Cd` is the piece's words when `g` is applied, each
either `C`'s or the target's, and the complement mix `mixU g.us g.K Cd g.ws` holds `Rd`; the
patched value plus all `Rd` costs at most the items' credits. -/
theorem patchAllD {E : TEnv} {ρ₀ : Nat → Nat} {T : Ty} {P0 : List Word} :
    ∀ (G : List PatchIt) (C : List Word) (R : Res), VRR ρ₀ (CE E) T (shp T) C R → wc T = some C.length →
      C.length = P0.length → (∀ g ∈ G, g.OK E ρ₀ T P0) →
      (∀ p, C[p]? ≠ P0[p]? → ∃ g ∈ G, g.Cov p) →
      ∃ R', ∃ Ds : List (PatchIt × Res × List Word), VRR ρ₀ (CE E) T (shp T) P0 R' ∧ Ds.map (·.1) = G ∧
        (∀ d ∈ Ds, VRR ρ₀ (CE E) d.1.S (shp d.1.S) (TermTear.mixU d.1.us d.1.K d.2.2 d.1.ws) d.2.1 ∧
          d.2.2.length = nWords d.1.us ∧
          ∀ o, o < nWords d.1.us → d.2.2[o]? = C[d.1.q + o]? ∨ d.2.2[o]? = P0[d.1.q + o]?) ∧
        (∀ (i : Nat) (d : PatchIt × Res × List Word), Ds[i]? = some d → ∀ o, o < nWords d.1.us →
          (∀ (j : Nat) (e : PatchIt × Res × List Word), j < i → Ds[j]? = some e → ¬ e.1.Cov (d.1.q + o)) → d.2.2[o]? = C[d.1.q + o]?) ∧
        R' + Res.sum (Ds.map (·.2.1)) ≤ R + Res.sum (G.map PatchIt.R0)
  | [], C, R, hv, _, _, _, hc => by
      have hCP : C = P0 := List.ext_getElem? (fun p => Classical.byContradiction fun h => by
        obtain ⟨g, hg, _⟩ := hc p h
        cases hg)
      subst hCP
      refine ⟨R, [], hv, rfl, fun d hd => absurd hd List.not_mem_nil, fun i d hi => by simp at hi, fun x => ?_⟩
      simp only [List.map_nil, Res.sum, Res.add_apply]
      simp [Res.zero]
  | g :: G, C, R, hv, hwc, hl, hok, hc => by
      obtain ⟨hat, hus, hcS, hiS, hws, hwl, hpin⟩ := hok g (List.mem_cons_self ..)
      obtain ⟨R1, Rd, hv1, hvd, hle1⟩ := patchOD hat hus hcS hiS hv hwc hws hwl g.K
      obtain ⟨n, -, -, hwn, hqn, -⟩ := VRR_at E hat hv hwc
      rw [wc_of_accs hus] at hwn
      obtain rfl : nWords g.us = n := Option.some.inj hwn
      have hlq : ((C.drop g.q).take (nWords g.us)).length = nWords g.us := by
        simp only [List.length_take, List.length_drop]; omega
      have hlen : (g.app C).length = C.length := by
        simp only [PatchIt.app, List.length_append, List.length_take, List.length_drop,
          TermTear.length_mixU g.us g.K _ _ hwl hlq]
        omega
      have hgP : ∀ p, g.Cov p → (g.app C)[p]? = P0[p]? := by
        intro p hgc
        rw [PatchIt.app_cov hwl hqn hgc]
        obtain ⟨hq, i, hi, hk⟩ := hgc
        rw [hpin i _ hk hi]
        congr 1; omega
      have hcov : ∀ p, (g.app C)[p]? ≠ P0[p]? → ∃ g' ∈ G, g'.Cov p := by
        intro p hp
        by_cases hgc : g.Cov p
        · exact absurd (hgP p hgc) hp
        · rcases PatchIt.app_get hwl hqn p with h | ⟨h, -⟩
          · rw [h] at hp
            obtain ⟨g', hg', hcv⟩ := hc p hp
            rcases List.mem_cons.mp hg' with rfl | hG
            · exact absurd hcv hgc
            · exact ⟨g', hG, hcv⟩
          · exact absurd h hgc
      obtain ⟨R', Ds, hv', hDs, hDf, hD1, hle'⟩ := patchAllD G (g.app C) R1 hv1 (by rw [hlen]; exact hwc)
        (by rw [hlen]; exact hl) (fun g' hg' => hok g' (List.mem_cons_of_mem _ hg')) hcov
      refine ⟨R', (g, Rd, (C.drop g.q).take (nWords g.us)) :: Ds, hv', by rw [List.map_cons, hDs],
        fun d hd => ?_, fun i d hi o ho hf => ?_, fun x => ?_⟩
      · rcases List.mem_cons.mp hd with rfl | hd
        · refine ⟨hvd, hlq, fun o ho => .inl ?_⟩
          show ((C.drop g.q).take (nWords g.us))[o]? = C[g.q + o]?
          rw [List.getElem?_take_of_lt ho, List.getElem?_drop]
        · obtain ⟨h1, h2, h3⟩ := hDf d hd
          refine ⟨h1, h2, fun o ho => ?_⟩
          rcases h3 o ho with e | e
          · rw [e]
            by_cases hgc : g.Cov (d.1.q + o)
            · exact .inr (hgP _ hgc)
            · rcases PatchIt.app_get hwl hqn (d.1.q + o) with h | ⟨h, -⟩
              · exact .inl h
              · exact absurd h hgc
          · exact .inr e
      · cases i with
        | zero =>
          rw [List.getElem?_cons_zero] at hi
          obtain rfl := Option.some.inj hi
          show ((C.drop g.q).take (nWords g.us))[o]? = C[g.q + o]?
          rw [List.getElem?_take_of_lt ho, List.getElem?_drop]
        | succ i =>
          rw [List.getElem?_cons_succ] at hi
          have e := hD1 i d hi o ho (fun j e hj he => hf (j + 1) e (by omega) (by rw [List.getElem?_cons_succ]; exact he))
          have hng : ¬ g.Cov (d.1.q + o) := hf 0 _ (Nat.zero_lt_succ _) List.getElem?_cons_zero
          rw [e]
          rcases PatchIt.app_get hwl hqn (d.1.q + o) with h | ⟨h, -⟩
          · exact h
          · exact absurd h hng
      · have h1 := hle1 x
        have h2 := hle' x
        simp only [List.map_cons, Res.sum, Res.add_apply] at h1 h2 ⊢
        omega

#print axioms patchAllD

/-- (D3) **Iterated patching**: credit items covering every word where `C`
differs from the target `P0` patch `C` into `P0`, at the cost of their credits. -/
theorem patchAll {E : TEnv} {ρ₀ : Nat → Nat} {T : Ty} {P0 : List Word} :
    ∀ (G : List PatchIt) (C : List Word) (R : Res), VRR ρ₀ (CE E) T (shp T) C R → wc T = some C.length →
      C.length = P0.length → (∀ g ∈ G, g.OK E ρ₀ T P0) →
      (∀ p, C[p]? ≠ P0[p]? → ∃ g ∈ G, g.Cov p) →
      ∃ R', VRR ρ₀ (CE E) T (shp T) P0 R' ∧ R' ≤ R + Res.sum (G.map PatchIt.R0) := by
  intro G C R hv hwc hl hok hc
  obtain ⟨R', Ds, hv', -, -, -, hle⟩ := patchAllD G C R hv hwc hl hok hc
  refine ⟨R', hv', fun x => ?_⟩
  have h1 := hle x
  simp only [Res.add_apply] at h1 ⊢
  omega

/-- (D3) **A word of a valid value at a protocol-word position is typed**. -/
theorem word_typed {η : TEnv} {T : Ty} {o k : Nat} {P : Proto} (hat : AtOff T o (.word (.lit k) P))
    (hg : P.ghost = false) (ha : accs T ≠ none) {w : Word} (hw : WordOK η T o w) :
    pwf P = true ∧ ∃ v, w.val = .num v ∧ InP P v := by
  obtain ⟨b, S, ws, o', w0, hseg, hv, hws, hle, hbo⟩ := hw
  obtain ⟨rfl, rfl⟩ := SegOf_lay ha hseg
  obtain ⟨us, hus⟩ := Option.ne_none_iff_exists'.mp ha
  have hwc : wc S = some ws.length := by rw [wc_of_accs hus, hv.2 us hus]
  obtain ⟨n, hn, -, hvr, -⟩ := VR_at η.unsee hat hv.1.1 hv.1.2 hwc
  have hws' : ws[o]? = some w0 := by rw [← hbo, Nat.zero_add]; exact hws
  obtain ⟨hlt, e⟩ := List.getElem?_eq_some_iff.mp hws'
  have hn1 : n = 1 := by rw [wc_word hg] at hn; exact (Option.some.inj hn).symm
  subst hn1
  rw [List.drop_eq_getElem_cons hlt, List.take_succ_cons, List.take_zero, e] at hvr
  simp only [VR] at hvr
  obtain ⟨hp, hin⟩ := hvr
  obtain ⟨v, hv1, hv2⟩ := hin hg
  refine ⟨hp, v, ?_, hv2⟩
  rw [← hle.1]; simpa using hv1

theorem nWords_ones : ∀ (us : List Acc), (∀ u, u ∈ us → u = .one) → nWords us = us.length
  | [], _ => rfl
  | u :: us, h => by
      obtain rfl := h u (List.mem_cons_self ..)
      rw [TermMem.nWords_one, nWords_ones us (fun v hv => h v (List.mem_cons_of_mem _ hv)), List.length_cons]

theorem inAcc_one {us : List Acc} (h : ∀ u, u ∈ us → u = .one) {j : Nat} (hj : j < us.length) :
    InAcc us j j := by
  have e1 := nWords_ones (us.take j) (fun u hu => h u (List.mem_of_mem_take hu))
  have e2 := nWords_ones (us.take (j + 1)) (fun u hu => h u (List.mem_of_mem_take hu))
  simp only [List.length_take] at e1 e2
  constructor <;> omega

/-- (D3) **Patching the visible word units**: each word unit `j ∈ L` goes from
the stored word to the target `P0[j]`, trading `dbW j` for `crW j`. -/
theorem patchWs {E : TEnv} {T : Ty} {P0 wsn : List Word} (dbW crW : Nat → Res) :
    ∀ (L : List Nat) (C : List Word) (R : Res), L.Nodup → VRR (fun _ => 0) (CE E) T (shp T) C R →
      wc T = some C.length →
      (∀ j, j ∈ L → C[j]? = wsn[j]? ∧ ∃ k P w0 wp, AtOff T j (.word (.lit k) P) ∧ P.ghost = false ∧
        wsn[j]? = some w0 ∧ P0[j]? = some wp ∧
        (∃ Rw, VRR (fun _ => 0) (CE E) (.word (.lit k) P) (shp (.word (.lit k) P)) [wp] Rw) ∧
        dbW j = wr P k w0.val ∧ crW j = wr P k wp.val) →
      ∃ C' R', VRR (fun _ => 0) (CE E) T (shp T) C' R' ∧ C'.length = C.length ∧
        (∀ p, p ∉ L → C'[p]? = C[p]?) ∧ (∀ p, p ∈ L → C'[p]? = P0[p]?) ∧
        R' + Res.sum (L.map dbW) = R + Res.sum (L.map crW)
  | [], C, R, _, hv, _, _ => ⟨C, R, hv, rfl, fun _ _ => rfl, fun p h => absurd h List.not_mem_nil, rfl⟩
  | j :: L, C, R, hnd, hv, hwc, hj => by
      obtain ⟨hcj, k, P, w0, wp, hat, hg, hw0, hwp, ⟨Rw, hvw⟩, hdb, hcr⟩ := hj j (List.mem_cons_self ..)
      have hc0 : C[j]? = some w0 := hcj.trans hw0
      obtain ⟨R1, hv1, hR1⟩ := patchW hat hg hv hwc hc0 hvw
      have hlt : j < C.length := (List.getElem?_eq_some_iff.mp hc0).1
      have hlen : (C.take j ++ [wp] ++ C.drop (j + 1)).length = C.length := by
        simp only [List.length_append, List.length_take, List.length_drop, List.length_singleton]; omega
      have hget := patch_get (C := C) (M := [wp]) (q := j) (n := 1) rfl (by omega)
      have hnj : j ∉ L := (List.nodup_cons.mp hnd).1
      obtain ⟨C', R', hv', hl', hout, hin, hsum⟩ := patchWs dbW crW L _ R1 (List.nodup_cons.mp hnd).2 hv1
        (by rw [hlen]; exact hwc) (fun j' hj' => by
          obtain ⟨h1, h2⟩ := hj j' (List.mem_cons_of_mem _ hj')
          have hne : j' ≠ j := fun e => hnj (e ▸ hj')
          refine ⟨?_, h2⟩
          rw [hget j']
          have : ¬ (j ≤ j' ∧ j' < j + 1) := fun h => hne (by omega)
          simp only [this, ↓reduceIte]; exact h1)
      refine ⟨C', R', hv', hl'.trans hlen, fun p hp => ?_, fun p hp => ?_, ?_⟩
      · have hpj : p ≠ j := fun e => hp (e ▸ List.mem_cons_self ..)
        rw [hout p (fun h => hp (List.mem_cons_of_mem _ h)), hget p]
        have : ¬ (j ≤ p ∧ p < j + 1) := fun h => hpj (by omega)
        simp only [this, ↓reduceIte]
      · rcases List.mem_cons.mp hp with rfl | hp'
        · rw [hout p hnj, hget p]
          simp only [Nat.le_refl, Nat.lt_succ_self, and_self, ↓reduceIte, Nat.sub_self]
          exact (by simpa using hwp.symm)
        · exact hin p hp'
      · refine Res.ext fun x => ?_
        have h1 := congrFun hsum x
        have h2 := congrFun hR1 x
        simp only [List.map_cons, Res.sum_cons, Res.add_apply, hdb, hcr] at h1 h2 ⊢
        omega

/-- (OvW3 R1) **The cell-level resource exchange, with the dropped complements**: as
`cellAcct`, plus one drop entry `(g, Rd, Cd)` per item, `Cd` the piece's words when `g` is
applied (each the target's, or the cell's: the new word off `A`, the old one at `A`), the
complement mix `mixU g.us g.K Cd g.ws` holding `Rd`, all `Rd` counted on the left. -/
theorem cellAcctD {E : TEnv} {T : Ty} {us : List Acc} (hus : accs T = some us) (h1 : ∀ u, u ∈ us → u = .one)
    (hc : Ty.coupledOKIn [] T = true) (hia : TermTear.IallOK [] T = true)
    {vals0 wsn P0 : List Word} {R0 Rv : Res}
    (hv0 : VRR (fun _ => 0) (CE E) T (shp T) vals0 R0) (hvn : VRR (fun _ => 0) (CE E) T (shp T) wsn Rv)
    (l0 : vals0.length = nWords us) (ln : wsn.length = nWords us) (lp : P0.length = nWords us)
    (A : Nat → Bool) (L : List Nat) (hnd : L.Nodup) (dbW crW : Nat → Res)
    (hA : ∀ j, A j = true → vals0[j]? = P0[j]?)
    (hW : ∀ j, j ∈ L → A j = false ∧ ∃ k P w0 wp, AtOff T j (.word (.lit k) P) ∧ P.ghost = false ∧
        wsn[j]? = some w0 ∧ P0[j]? = some wp ∧
        (∃ Rw, VRR (fun _ => 0) (CE E) (.word (.lit k) P) (shp (.word (.lit k) P)) [wp] Rw) ∧
        dbW j = wr P k w0.val ∧ crW j = wr P k wp.val)
    (G : List PatchIt) (hG : ∀ g ∈ G, g.OK E (fun _ => 0) T P0)
    (hcov : ∀ j, j < nWords us → A j = false → j ∉ L → ∃ g ∈ G, g.Cov j) :
    ∃ Ra Rp, ∃ Ds : List (PatchIt × Res × List Word),
      VRR (fun _ => 0) (CE E) T (shp T) (TermTear.mixU us A wsn vals0) Ra ∧
      VRR (fun _ => 0) (CE E) T (shp T) P0 Rp ∧ Ds.map (·.1) = G ∧
      (∀ d ∈ Ds, VRR (fun _ => 0) (CE E) d.1.S (shp d.1.S) (TermTear.mixU d.1.us d.1.K d.2.2 d.1.ws) d.2.1 ∧
        d.2.2.length = nWords d.1.us ∧
        ∀ o, o < nWords d.1.us → d.2.2[o]? = P0[d.1.q + o]? ∨
          (A (d.1.q + o) = false ∧ d.2.2[o]? = wsn[d.1.q + o]?) ∨
          (A (d.1.q + o) = true ∧ d.2.2[o]? = vals0[d.1.q + o]?)) ∧
      (∀ (i : Nat) (d : PatchIt × Res × List Word), Ds[i]? = some d → ∀ o, o < nWords d.1.us →
        (∀ (j : Nat) (e : PatchIt × Res × List Word), j < i → Ds[j]? = some e → ¬ e.1.Cov (d.1.q + o)) → d.1.q + o ∉ L → d.1.q + o < nWords us →
        d.2.2[o]? = if A (d.1.q + o) then vals0[d.1.q + o]? else wsn[d.1.q + o]?) ∧
      Ra + Rp + Res.sum (L.map dbW) + Res.sum (Ds.map (·.2.1)) ≤
        R0 + Rv + Res.sum (L.map crW) + Res.sum (G.map PatchIt.R0) := by
  obtain ⟨Ra, Rb, hva, hvb, hab⟩ := TermTear.VRR_mix2 (sel := A) hc hia hus hvn hv0 ln l0
  have hlB : (TermTear.mixU us A vals0 wsn).length = nWords us := TermTear.length_mixU us A _ _ l0 ln
  have hwcB : wc T = some (TermTear.mixU us A vals0 wsn).length := by rw [wc_of_accs hus, hlB]
  have hBget : ∀ j, j < nWords us → (TermTear.mixU us A vals0 wsn)[j]? = if A j then vals0[j]? else wsn[j]? :=
    fun j hj => TermTear.mixU_getElem us A vals0 wsn j j l0 ln
      (inAcc_one h1 (by rw [nWords_ones us h1] at hj; exact hj))
  obtain ⟨C', R', hv', hl', hout, hin, hsum⟩ := patchWs (P0 := P0) (wsn := wsn) dbW crW L _ Rb hnd hvb hwcB
    (fun j hj => by
      obtain ⟨hAj, k, P, w0, wp, hat, hg, hw0, rest⟩ := hW j hj
      have hjn : j < nWords us := by rw [← ln]; exact (List.getElem?_eq_some_iff.mp hw0).1
      refine ⟨?_, k, P, w0, wp, hat, hg, hw0, rest⟩
      rw [hBget j hjn, hAj]; rfl)
  obtain ⟨Rp, Ds, hvp, hDs, hDf, hD1, hRp⟩ := patchAllD G C' R' hv' (by rw [hl']; exact hwcB) (by rw [hl', hlB, lp]) hG
    (fun p hp => by
      by_cases hpL : p ∈ L
      · exact absurd (hin p hpL) hp
      rw [hout p hpL] at hp
      by_cases hpn : p < nWords us
      · cases hAp : A p
        · exact hcov p hpn hAp hpL
        · exfalso; apply hp; rw [hBget p hpn, hAp]; exact hA p hAp
      · exfalso; apply hp
        rw [List.getElem?_eq_none (by omega), List.getElem?_eq_none (by omega)])
  refine ⟨Ra, Rp, Ds, hva, hvp, hDs, fun d hd => ?_,
    fun i d hi o ho hf hpL hpn => by rw [hD1 i d hi o ho hf, hout _ hpL, hBget _ hpn], fun x => ?_⟩
  · obtain ⟨f1, f2, f3⟩ := hDf d hd
    refine ⟨f1, f2, fun o ho => ?_⟩
    rcases f3 o ho with e | e
    · rw [e]
      by_cases hpL : d.1.q + o ∈ L
      · exact .inl (hin _ hpL)
      rw [hout _ hpL]
      by_cases hpn : d.1.q + o < nWords us
      · rw [hBget _ hpn]
        cases hAp : A (d.1.q + o)
        · exact .inr (.inl ⟨rfl, rfl⟩)
        · exact .inr (.inr ⟨rfl, rfl⟩)
      · left
        rw [List.getElem?_eq_none (by omega), List.getElem?_eq_none (by omega)]
    · exact .inl e
  · have e1 := hab x
    have e2 := hRp x
    have e3 := congrFun hsum x
    simp only [Res.add_apply] at e1 e2 e3 ⊢
    omega

#print axioms cellAcctD

/-- (D3) **The cell-level resource exchange** of a fulfilling RMW: memory takes
the stored words at the units `A`; the thread gets the target `P0`, the visible
word units `L` trading `dbW` for `crW`, the remaining units paid by the items. -/
theorem cellAcct {E : TEnv} {T : Ty} {us : List Acc} (hus : accs T = some us) (h1 : ∀ u, u ∈ us → u = .one)
    (hc : Ty.coupledOKIn [] T = true) (hia : TermTear.IallOK [] T = true)
    {vals0 wsn P0 : List Word} {R0 Rv : Res}
    (hv0 : VRR (fun _ => 0) (CE E) T (shp T) vals0 R0) (hvn : VRR (fun _ => 0) (CE E) T (shp T) wsn Rv)
    (l0 : vals0.length = nWords us) (ln : wsn.length = nWords us) (lp : P0.length = nWords us)
    (A : Nat → Bool) (L : List Nat) (hnd : L.Nodup) (dbW crW : Nat → Res)
    (hA : ∀ j, A j = true → vals0[j]? = P0[j]?)
    (hW : ∀ j, j ∈ L → A j = false ∧ ∃ k P w0 wp, AtOff T j (.word (.lit k) P) ∧ P.ghost = false ∧
        wsn[j]? = some w0 ∧ P0[j]? = some wp ∧
        (∃ Rw, VRR (fun _ => 0) (CE E) (.word (.lit k) P) (shp (.word (.lit k) P)) [wp] Rw) ∧
        dbW j = wr P k w0.val ∧ crW j = wr P k wp.val)
    (G : List PatchIt) (hG : ∀ g ∈ G, g.OK E (fun _ => 0) T P0)
    (hcov : ∀ j, j < nWords us → A j = false → j ∉ L → ∃ g ∈ G, g.Cov j) :
    ∃ Ra Rp, VRR (fun _ => 0) (CE E) T (shp T) (TermTear.mixU us A wsn vals0) Ra ∧
      VRR (fun _ => 0) (CE E) T (shp T) P0 Rp ∧
      Ra + Rp + Res.sum (L.map dbW) ≤ R0 + Rv + Res.sum (L.map crW) + Res.sum (G.map PatchIt.R0) := by
  obtain ⟨Ra, Rp, Ds, hva, hvp, -, -, -, hle⟩ :=
    cellAcctD hus h1 hc hia hv0 hvn l0 ln lp A L hnd dbW crW hA hW G hG hcov
  refine ⟨Ra, Rp, hva, hvp, fun x => ?_⟩
  have e := hle x
  simp only [Res.add_apply] at e ⊢
  omega

theorem sum_sub_le {f : Ts → Res} : ∀ {L1 L2 : List Ts}, L1.Nodup → (∀ x, x ∈ L1 → x ∈ L2) →
    Res.sum (L1.map f) ≤ Res.sum (L2.map f)
  | [], L2, _, _ => fun k => by simp [Res.zero]
  | x :: L1, L2, hnd, hs => by
      have hx := hs x (List.mem_cons_self ..)
      rw [sum_map_erase (f := f) hx]
      have ih := sum_sub_le (f := f) (L1 := L1) (L2 := L2.erase x) (List.nodup_cons.mp hnd).2 (fun y hy => by
        have hne : y ≠ x := fun e => (List.nodup_cons.mp hnd).1 (e ▸ hy)
        exact (List.mem_erase_of_ne hne).2 (hs y (List.mem_cons_of_mem _ hy)))
      intro k
      have := ih k
      simp only [List.map_cons, Res.sum_cons, Res.add_apply] at this ⊢
      omega

theorem exists_WLe_pickD {P : Nat → Word → Prop} :
    ∀ (vals : List Word), (∀ o v, vals[o]? = some v → ∃ w, WLe1 w v ∧ P o w) →
      ∃ vals', WLe vals' vals ∧ ∀ o w, vals'[o]? = some w → P o w
  | [], _ => ⟨[], trivial, fun o w h => by simp at h⟩
  | v :: vs, h => by
      obtain ⟨w, hw, hp⟩ := h 0 v rfl
      obtain ⟨vs', hws, hps⟩ := exists_WLe_pickD (P := fun o w => P (o + 1) w) vs
        (fun o v' hv => h (o + 1) v' (by simpa using hv))
      refine ⟨w :: vs', ⟨hw, hws⟩, fun o w' hw' => ?_⟩
      rcases o with _ | o
      · simp only [List.getElem?_cons_zero, Option.some.injEq] at hw'; subst hw'; exact hp
      · simp only [List.getElem?_cons_succ] at hw'; exact hps o w' hw'

theorem AtOff_word_lit0 {T U : Ty} {o : Nat} (h : AtOff T o U) (hT : Clo T) :
    ∀ r P, U = .word r P → ∃ n, r = .lit n := by
  have hT' := hT.2 (fun _ => 0) (fun _ => .void) 0 0
  clear hT
  induction h with
  | here _ =>
      intro r P e
      subst e
      simp only [cl, clI_zero, Ty.word.injEq] at hT'
      exact ⟨_, hT'.1.symm⟩
  | fst _ ih =>
      simp only [cl, Ty.prod.injEq] at hT'
      exact ih hT'.1
  | snd _ _ ih =>
      simp only [cl, Ty.prod.injEq] at hT'
      exact ih hT'.2
  | elem _ _ _ ih =>
      simp only [cl, clI, Ty.array.injEq] at hT'
      exact ih hT'.2
  | mu hW _ _ ih => exact ih ((Clo_cl hW _ _).2 _ _ 0 0)
  | fold _ _ _ _ _ =>
      intro r P e
      simp [cl] at e

theorem no_word2_of_ones {T : Ty} {us : List Acc} (hus : accs T = some us) (h1 : ∀ u, u ∈ us → u = .one)
    {o : Nat} {r : Idx} {P : Proto2} (h : AtOff T o (.word2 r P)) : False := by
  obtain ⟨pre, post, e, -⟩ := AtOff_embed h hus accs_word2
  have := h1 .two (by rw [e]; simp)
  cases this

/-! ### (D3) The plant facts at an own-path op on an own frontier cell -/

/-- (switch) The address atom of an own-path op (`OwnOpT`). -/
def opAtom : Expr → Option At
  | .let_ _ (.xchg a _) _ => some a
  | .let_ _ (.xchgAt b _ _) _ => some b
  | .let_ _ (.xchgAtF b _ _ _) _ => some b
  | .let_ _ (.stlw b _ _ _) _ => some b
  | .let_ _ (.stl b _ _) _ => some b
  | .let_ _ (.bufInit b _ _) _ => some b
  | .let_ _ (.store _ a _ _) _ => some a
  | _ => none

/-- (switch) **The op's target label**: the op's address atom evaluates to a
location of `lab`. -/
def OpTgt (th : TTh) (lab : AllocLabel) : Prop :=
  ∃ q rt w ad off, opAtom th.term = some q ∧ evalAt th.env q = some (rt, [w]) ∧ w.val = .loc ad off ∧
    ad.label = lab

/-- (OvW3 R2) `CrKeys` is `TermPiece.CrKeysP`. -/
theorem crKeys_iffP {R : Res} : CrKeys R ↔ CrKeysP R := Iff.rfl
#print axioms TermPlant.crKeys_iffP

/-- (OvW3 R2) `OpTgt` is `TermPiece.OpTgtP`. -/
theorem opTgt_iffP {th : TTh} {lab : AllocLabel} : OpTgt th lab ↔ OpTgtP th lab := Iff.rfl
#print axioms TermPlant.opTgt_iffP

/-- (switch) **An own-path op on a frontier cell**: the guard of the plant
fields (`plantFulfil`, `PlantOp`, `XchgIall`). -/
def OwnFrOp (E : TEnv) (cx : Cx) (th : TTh) : Prop :=
  OwnOpT cx th.term ∧ ∃ lab, E.pfr lab ≠ none ∧ OpTgt th lab

/-! ### (switch) `∀`-freedom of the op target (replaces `XchgIall`) -/

theorem iallOK_ofNIP : ∀ (t : Ty) (ke : KEnv), noIallV t = true → TermTear.IallOK ke t = true := by
  intro t
  induction t with
  | prod a b iha ihb => intro ke h; simp only [noIallV, Bool.and_eq_true] at h; simp [TermTear.IallOK, iha ke h.1, ihb ke h.2]
  | sum a b iha ihb => intro ke h; simp only [noIallV, Bool.and_eq_true] at h; simp [TermTear.IallOK, iha ke h.1, ihb ke h.2]
  | iex t ih => intro ke h; simp only [TermTear.IallOK]; exact ih ke h
  | tex κ t ih => intro ke h; simp only [TermTear.IallOK]; exact ih _ h
  | mu t ih => intro ke h; simp only [TermTear.IallOK]; exact ih _ h
  | refine t ψ ih => intro ke h; simp only [TermTear.IallOK]; exact ih ke h
  | iall t _ => intro ke h; simp [noIallV] at h
  | _ => intro ke _; rfl

theorem noIallV_shiftTP : ∀ (t : Ty) (c : Nat), noIallV (t.shiftT c) = noIallV t := by
  intro t
  induction t with
  | tvar k => intro c; simp only [Ty.shiftT]; split <;> rfl
  | prod a b iha ihb => intro c; simp [Ty.shiftT, noIallV, iha, ihb]
  | sum a b iha ihb => intro c; simp [Ty.shiftT, noIallV, iha, ihb]
  | array i t ih => intro c; simp [Ty.shiftT, noIallV, ih]
  | mu t ih => intro c; simp [Ty.shiftT, noIallV, ih]
  | tex κ t ih => intro c; simp [Ty.shiftT, noIallV, ih]
  | iex t ih => intro c; simp [Ty.shiftT, noIallV, ih]
  | refine t ψ ih => intro c; simp [Ty.shiftT, noIallV, ih]
  | _ => intro c; rfl

theorem noIallV_shiftIP : ∀ (t : Ty) (c : Nat), noIallV (t.shiftI c) = noIallV t := by
  intro t
  induction t with
  | prod a b iha ihb => intro c; simp [Ty.shiftI, noIallV, iha, ihb]
  | sum a b iha ihb => intro c; simp [Ty.shiftI, noIallV, iha, ihb]
  | array i t ih => intro c; simp [Ty.shiftI, noIallV, ih]
  | mu t ih => intro c; simp [Ty.shiftI, noIallV, ih]
  | tex κ t ih => intro c; simp [Ty.shiftI, noIallV, ih]
  | iex t ih => intro c; simp [Ty.shiftI, noIallV, ih]
  | refine t ψ ih => intro c; simp [Ty.shiftI, noIallV, ih]
  | _ => intro c; rfl

theorem noIallV_substTP : ∀ (t : Ty) (j : Nat) (s : Ty), noIallV s = true → noIallV t = true →
    noIallV (Ty.substT j s t) = true := by
  intro t
  induction t with
  | tvar k =>
    intro j s hs _
    simp only [Ty.substT]
    split
    · exact hs
    · split <;> rfl
  | prod a b iha ihb => intro j s hs h; simp only [Ty.substT, noIallV, Bool.and_eq_true] at h ⊢; exact ⟨iha j s hs h.1, ihb j s hs h.2⟩
  | sum a b iha ihb => intro j s hs h; simp only [Ty.substT, noIallV, Bool.and_eq_true] at h ⊢; exact ⟨iha j s hs h.1, ihb j s hs h.2⟩
  | array i t ih => intro j s hs h; exact ih j s hs h
  | mu t ih => intro j s hs h; exact ih (j + 1) (s.shiftT 0) (by rw [noIallV_shiftTP]; exact hs) h
  | tex κ t ih => intro j s hs h; exact ih (j + 1) (s.shiftT 0) (by rw [noIallV_shiftTP]; exact hs) h
  | iex t ih => intro j s hs h; exact ih j (s.shiftI 0) (by rw [noIallV_shiftIP]; exact hs) h
  | refine t ψ ih => intro j s hs h; exact ih j s hs h
  | iall t _ => intro j s hs h; simp [noIallV] at h
  | _ => intro j s _ _; rfl

theorem noIallV_of_substTP : ∀ (t : Ty) (j : Nat) (s : Ty), noIallV (Ty.substT j s t) = true → noIallV t = true := by
  intro t
  induction t with
  | prod a b iha ihb => intro j s h; simp only [Ty.substT, noIallV, Bool.and_eq_true] at h ⊢; exact ⟨iha j s h.1, ihb j s h.2⟩
  | sum a b iha ihb => intro j s h; simp only [Ty.substT, noIallV, Bool.and_eq_true] at h ⊢; exact ⟨iha j s h.1, ihb j s h.2⟩
  | array i t ih => intro j s h; exact ih j s h
  | mu t ih => intro j s h; exact ih (j + 1) _ h
  | tex κ t ih => intro j s h; exact ih (j + 1) _ h
  | iex t ih => intro j s h; exact ih j _ h
  | refine t ψ ih => intro j s h; exact ih j s h
  | iall t _ => intro j s h; simp [Ty.substT, noIallV] at h
  | _ => intro j s _; rfl

theorem noIallV_unfoldP {ρ : Nat → Nat} {W : Nat → Ty} (hW : ∀ k, Clo (W k)) {s : Ty}
    (h : noIallV (cl ρ W 0 0 (.mu s)) = true) : noIallV (cl ρ W 0 0 (unfold1 (.mu s))) = true := by
  rw [cl_unfold1 hW, cl_mu_eq]
  rw [cl_mu_eq] at h
  exact noIallV_substTP _ 0 _ h (by simp only [noIallV] at h; exact h)

theorem noIallV_foldP {ρ : Nat → Nat} {W : Nat → Ty} (hW : ∀ k, Clo (W k)) {s : Ty}
    (h : noIallV (cl ρ W 0 0 (unfold1 (.mu s))) = true) : noIallV (cl ρ W 0 0 (.mu s)) = true := by
  rw [cl_unfold1 hW, cl_mu_eq] at h
  rw [cl_mu_eq]
  simp only [unfold1] at h
  simp only [noIallV]
  exact noIallV_of_substTP _ 0 _ h

/-- Every `AtOff` component of a `∀`-free type is `∀`-free. -/
theorem noIallV_AtOffP {U V : Ty} {d : Nat} (h : AtOff U d V) (hU : noIallV U = true) : noIallV V = true := by
  induction h with
  | here _ => exact hU
  | fst _ ih => simp only [noIallV, Bool.and_eq_true] at hU; exact ih hU.1
  | snd _ _ ih => simp only [noIallV, Bool.and_eq_true] at hU; exact ih hU.2
  | elem _ _ _ ih => exact ih hU
  | mu hW _ _ ih => exact ih (noIallV_unfoldP hW hU)
  | fold hW _ _ _ ih => exact noIallV_foldP hW (ih hU)

/-- A folded cell type of a `∀`-free type is `∀`-free. -/
theorem noIallV_FdP {T U : Ty} (h : Fd T U) (hU : noIallV U = true) : noIallV T = true := by
  induction h with
  | refl => exact hU
  | fold hW _ _ _ ih => exact ih (noIallV_unfoldP hW hU)

/-- (switch) **Deep `∀`-freedom**: no index-`∀` node anywhere, also under
references and code signatures (`TermScope.drf` without its region half). -/
def niDeep : Ty → Bool
  | .prod a b => niDeep a && niDeep b
  | .sum a b => niDeep a && niDeep b
  | .code a b _ => niDeep a && niDeep b
  | .array _ t => niDeep t
  | .ptr _ t => niDeep t
  | .ptrOpt _ t => niDeep t
  | .loc _ t => niDeep t
  | .mu t => niDeep t
  | .tex _ t => niDeep t
  | .iall _ => false
  | .iex t => niDeep t
  | .refine t _ => niDeep t
  | _ => true

theorem noIallV_of_niDeep : ∀ t : Ty, niDeep t = true → noIallV t = true := by
  intro t
  induction t with
  | prod a b iha ihb => intro h; simp only [niDeep, noIallV, Bool.and_eq_true] at h ⊢; exact ⟨iha h.1, ihb h.2⟩
  | sum a b iha ihb => intro h; simp only [niDeep, noIallV, Bool.and_eq_true] at h ⊢; exact ⟨iha h.1, ihb h.2⟩
  | array i t ih => intro h; exact ih h
  | mu t ih => intro h; exact ih h
  | tex κ t ih => intro h; exact ih h
  | iex t ih => intro h; exact ih h
  | refine t ψ ih => intro h; exact ih h
  | iall t _ => intro h; simp [niDeep] at h
  | _ => intro _; rfl

/-- (switch) **The op's address operand is deeply `∀`-free** (discharged from
the program scope check, as `TermIall.storeIall_term`). -/
def OpNI (cx : Cx) (th : TTh) : Prop :=
  ∀ q t, opAtom th.term = some q → cx.peek q = .ok t → niDeep t = true

theorem niCl {ρ : Nat → Nat} {η : TEnv} (hW : WitAF η) {u : Ty} (h : niDeep u = true) :
    noIallV (cl ρ η.wit 0 0 u) = true :=
  noIallV_cl hW.ni u 0 0 (noIallV_of_niDeep u h)

theorem niDeep_bufOf {t u : Ty} {μ : Mode} {n k : Idx} (hb : bufOf t = some (μ, n, u, k))
    (h : niDeep t = true) : niDeep u = true := by
  unfold bufOf at hb
  split at hb <;> simp at hb
  obtain ⟨rfl, rfl, rfl, rfl⟩ := hb
  simpa [niDeep] using h

theorem niDeep_compTy : ∀ (u : Ty) (p : List Nat) {c : Ty}, compTy u p = some c → niDeep u = true →
    niDeep c = true := by
  intro u p
  induction p generalizing u with
  | nil => intro c h hu; simp [compTy] at h; rw [← h]; exact hu
  | cons j p ih =>
    intro c h hu
    cases u <;> try (simp [compTy] at h)
    rename_i a b
    simp only [niDeep, Bool.and_eq_true] at hu
    match j, h with
    | 0, h => exact ih a h hu.1
    | 1, h => exact ih b h hu.2
    | n + 2, h => simp [compTy] at h


/-- (D3) **`PlantOp`**: the plant facts an own-path op on the own frontier cell `l`
needs, at a window bound `wB` (intended: the plant message's timestamp).  The first
clause (W1) ranges over the results satisfying `Ok` (in use: the taken one). -/
def PlantOp (g : G) (mem : Memory) (pairs : List Ts) (th : TTh) (E : TEnv) (cr : Ts → Res)
    (Ok : Memory × List Ts × TTh → Prop)
    (l : AllocLabel) (c : Cell) : Prop :=
  ∃ (wB : Ts) (Gs : List (Ts × Nat × Ty × List Word × Res × (Nat → Bool))),
    (∀ r ∈ tstep g mem pairs th, r.1 = mem → Ok r → ∀ t, t ∈ (stOf mem pairs th).promises →
      t ∉ (stOf r.1 r.2.1 r.2.2).promises → t ≤ wB) ∧
    (∀ t m, (stOf mem pairs th).mem[t]? = some m → m.loc.label = l →
      (stOf mem pairs th).vs.coh m.loc < t → t ≤ wB → t ∈ (stOf mem pairs th).promises) ∧
    (∀ t m, t ∈ FpAt E ⟨l, 0⟩ → (stOf mem pairs th).mem[t]? = some m → m.loc.label = l → wB < t) ∧
    (Gs.map (·.1)).Nodup ∧ (∀ x ∈ Gs, CrItem E (stOf mem pairs th) cr l c x) ∧
    ∀ o tw, InitRr E c l o → ¬ VisU E ⟨l, o⟩ → LowOwn (stOf mem pairs th) ⟨l, o⟩ tw → tw ≤ wB →
      OverT E (stOf mem pairs th) ⟨l, o⟩ tw →
      ∃ x ∈ Gs, ∃ usS i, accs x.2.2.1 = some usS ∧ x.2.1 ≤ o ∧ InAcc usS i (o - x.2.1) ∧
        x.2.2.2.2.2 i = true

theorem sum_idx (f : Ts → Res) : ∀ F : List Ts,
    Res.sum (F.map f) = Res.sum ((List.range F.length).map fun j => f (F.getD j 0))
  | [] => rfl
  | x :: F => by
      rw [List.length_cons, List.range_succ_eq_map, List.map_cons, List.map_cons, List.map_map, Res.sum_cons,
        Res.sum_cons, sum_idx f F]
      rfl

theorem sum_app {α : Type} (f : α → Res) : ∀ (L1 L2 : List α),
    Res.sum ((L1 ++ L2).map f) = Res.sum (L1.map f) + Res.sum (L2.map f)
  | [], L2 => by simp only [List.nil_append, List.map_nil, Res.sum_nil, Res.zero_add]
  | x :: L1, L2 => by
      simp only [List.cons_append, List.map_cons, Res.sum_cons]
      rw [sum_app f L1 L2, Res.add_assoc]

theorem sum_le_of {α : Type} {f g : α → Res} : ∀ (L : List α), (∀ x, x ∈ L → f x ≤ g x) →
    Res.sum (L.map f) ≤ Res.sum (L.map g)
  | [], _ => fun k => Nat.le_refl _
  | x :: L, h => fun k => by
      have h1 := h x List.mem_cons_self k
      have h2 := sum_le_of L (fun y hy => h y (List.mem_cons_of_mem _ hy)) k
      simp only [List.map_cons, Res.sum_cons, Res.add_apply] at h1 h2 ⊢
      omega

theorem nodup_map_on {α β : Type} {f : α → β} : ∀ {l : List α},
    (∀ x, x ∈ l → ∀ y, y ∈ l → f x = f y → x = y) → l.Nodup → (l.map f).Nodup
  | [], _, _ => List.nodup_nil
  | x :: l, H, d => by
      rw [List.map_cons, List.nodup_cons]
      refine ⟨fun hm => ?_, nodup_map_on (fun a ha b hb => H a (List.mem_cons_of_mem _ ha) b
        (List.mem_cons_of_mem _ hb)) (List.nodup_cons.mp d).2⟩
      obtain ⟨y, hy, e⟩ := List.mem_map.mp hm
      exact (List.nodup_cons.mp d).1 (H y (List.mem_cons_of_mem _ hy) x List.mem_cons_self e ▸ hy)

/-- The patch item of a plant credit item. -/
def crPatch (x : Ts × Nat × Ty × List Word × Res × (Nat → Bool)) : PatchIt :=
  ⟨x.2.1, x.2.2.1, (accs x.2.2.1).getD [], x.2.2.2.1, x.2.2.2.2.1, x.2.2.2.2.2⟩

theorem sum_filt {α : Type} (p : α → Bool) {f : α → Res} :
    ∀ (L : List α), (∀ x, x ∈ L → p x = false → f x = .zero) →
      Res.sum (L.map f) = Res.sum ((L.filter p).map f)
  | [], _ => rfl
  | x :: L, hz => by
      have ih := sum_filt p L (fun y hy => hz y (List.mem_cons_of_mem _ hy))
      cases hp : p x
      · simp only [List.map_cons, Res.sum_cons, List.filter_cons, hp, Bool.false_eq_true, ↓reduceIte]
        rw [hz x List.mem_cons_self hp, Res.zero_add, ih]
      · simp only [List.map_cons, Res.sum_cons, List.filter_cons, hp, ↓reduceIte, ih]

set_option maxHeartbeats 1600000 in
/-- (D3) **The frontier branch of the own `xchg`**: at an own cell with a frontier,
the swap fulfils the thread's lowest promise at every unit (`plantFulfil`), and
the plant facts (`PlantOp`) pay for what it reads. -/
theorem tstepMCF_xchgOwnF {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {a v : At} {u : Ty} {e : Expr} {Rf Rs H : Res}
    {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.xchg a v) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.ptr .own u))
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeld (CE η) (stOf mem pairs th) H) (hC : PromCrP (CE η) (stOf mem pairs th) cr db)
    (hfr : ∀ lab ru pw, evalAt th.env a = some (.ptr .own ru, [pw]) → pw.val = .loc ⟨lab, 0⟩ 0 →
      (CE η).pfr lab ≠ none)
    {Ok : Memory × List Ts × TTh → Prop}
    (hpo : ∀ lab c, (CE η).sto lab = some c → c.owner = some (CE η).tid → (CE η).pfr lab ≠ none → OpTgt th lab →
      PlantOp g mem pairs th (CE η) cr Ok lab c)
    (hniX : OpNI cx th)
    (hclo : ∀ lab c, (CE η).sto lab = some c → Clo c.ty) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hDy : DyFr p annNew (progTgts p) η th.σs th.term) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → r.1 = mem → Ok r →
      ∃ Tot H' C F, ThInvMCF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 Tot H'
          (dropP (CE η) (stOf mem pairs th) cr) db ∧
        MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
        Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) (dropP (CE η) (stOf mem pairs th) cr) +
            pSum (stOf mem pairs th) db + C ≤
          Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  have hT0 := hT
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | xchg hp hx hu hsub hb =>
  obtain ⟨t, u', o, tv, c₁, hp, hx, hu, hsub, hb⟩ : ∃ t u' o tv c₁, cx.peek a = .ok t ∧
      XchgCell cx t u' o ∧ cx.use v = .ok (tv, c₁) ∧ (SubS c₁ tv u' ∨ SubS c₁ tv o) ∧
      c₁.bind x o = .ok c' := ⟨_, _, _, _, _, hp, hx, hu, hsub, hb⟩
  rw [hpk] at hp; cases hp
  cases hx with
  | rgn _ hc _ _ _ => simp [cellOf] at hc
  | own _ hc _ =>
  simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc; subst hc
  have hi0 := hi.1
  have hsub : SubS c₁ tv u := hsub.elim id id
  have hotv : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have ho : cx.opaqueOK u = true := sub_opaqueOK hsub hotv
  have htb : tb cx.ke.length u = true := tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.ptr .own u) = some (.own, u))
  obtain ⟨lab, c, pw, ru, hea, hpw, hsto, hcty, hacc, hown, hsku, hsig⟩ := ownPtr_view hi0 hpk htv ho
  have hniC : noIallV c.ty = true := noIallV_FdP hcty (niCl hi.1.2.2.2.2.2.2.1 (by simpa [niDeep] using (hniX a _ (by rw [hterm]; rfl) hpk)))
  have hpf := hfr lab ru pw hea hpw
  obtain ⟨rv, wsv, Rv, Rr, hev, hvv, hlv, hvrv, hi1, hle⟩ := useR hu hi hE.2.2
  have hsat : Sat c₁.facts ρ := hi1.1.1
  have hna : ∀ N e', c.ty ≠ .array (.lit N) e' := fun N e' h =>
    hacc (by rw [h]; simp [accs])
  obtain ⟨us, hus, ⟨r0, hr0⟩, hld, hstw⟩ := ownLoad (arch := g.arch) (pw := pw) (acq := false) (s := stOf mem pairs th)
    hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hsto hown (Fd_lay hcty).1 (Fd_lay hcty).2.1
    (fun ws => ((Fd_lay hcty).2.2.2 ws).1) (fun R ws => (Fd_VR η hcty).1) hna hsku (peek_cell_lyt hi0.2.1 hpk hea rfl rfl).2 hsig
    (by rw [(Fd_lay hcty).2.2.1]; exact pub_accs hi0.2.2.2.1 hi0.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi0.2.1 htv hpk rfl ho hea rfl)
  obtain ⟨hval, hlen⟩ := ownStoreVal hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 hsat hsub ho htb hvv hlv hsig hus
  have husA : accs c.ty = some us := ((Fd_lay hcty).2.2.1.trans (pub_accs hi0.2.2.2.1 hi0.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi0.2.1 htv hpk rfl ho hea rfl).symm).trans hus
  have hus' : wc c.ty = some (nWords us) := by rw [(Fd_lay hcty).2.1, ← wc_of_sig hsig]; simp [wc, hus]
  replace hval := (Fd_EnvVal (CE η) hcty).2 hval
  have hsigu : sig (close th.σs u) = sig (cl ρ η.wit 0 0 u) :=
    sig_WitL hi0.2.2.2.1 ρ ho (lt_of_guardT htb hi0.2.2.2.2.1)
  have hvalR : EnvValR (CE η) c.ty wsv Rv := by
    obtain ⟨hs, -⟩ := Lay_canon hsub hlv
    have hvu : VRR ρ η u (shp (close th.σs u)) wsv Rv := by rw [← hs]; exact VRR_sub hsat hsub _ _ _ hvrv
    have hvc : VRR (fun _ => 0) (CE η) (cl ρ η.wit 0 0 u) (shp (cl ρ η.wit 0 0 u)) wsv Rv := by
      rw [← shp_of_sig hsigu]
      exact (VRR_close hE.2.1 hE.2.2 ρ u [] 0 ρ (fun _ => 0) (shp (close th.σs u)) wsv Rv (fun k => rfl)
        (fun k hk => absurd hk (Nat.not_lt_zero _))).1 hvu
    refine ⟨?_, hval.2⟩
    rw [(Fd_lay hcty).1]
    exact (Fd_VRR η hcty).2 hvc
  obtain ⟨R0, H0, rfl, hent0, hX⟩ := MemHeld_focus hH lab
  obtain ⟨vals0, hL0, hC0⟩ := hent0.2 c hsto
  have hvR0 : ValOfR (CE η) c.ty vals0 R0 ∧ vals0.length = nWords us := by
    rcases hC0 with ⟨h1, h2⟩ | ⟨N, e', _, _, hT', _⟩
    · rw [hus'] at h1; exact ⟨h2, (Option.some.inj h1).symm⟩
    · exact absurd hT' (hna N e')
  have key : tstep g mem pairs th =
      ((loadUnits g.arch pw ⟨lab, 0⟩ false us 0 (stOf mem pairs th)).flatMap fun (s1, old) =>
        (storeUnits g.k g.arch pw ⟨lab, 0⟩ false us wsv 0 s1).map fun s2 => (s2, ru, old)).map
        fun (s', t, ws) => (s'.mem, s'.pairs, withS { th with term := e, env := (x, t, ws) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hev, cellOf, addrOf, hpw, hus]
  have htg : OpTgt th lab := ⟨a, _, pw, ⟨lab, 0⟩, 0, by rw [hterm]; rfl, hea, hpw, rfl⟩
  obtain ⟨wB, Gs, hW1, hW2, hW3, hGnd, hGit, hGcov⟩ := hpo lab c hsto hown hpf htg
  rw [key] at hW1 ⊢
  have hm1 : ∀ r1, r1 ∈ loadUnits g.arch pw ⟨lab, 0⟩ false us 0 (stOf mem pairs th) → PromAbove r1.1 → MemInv g (CE η) r1.1 :=
    fun r1 h hp =>  by
      obtain ⟨_, _, f1, f2, f3, f4, f5⟩ := hld r1 h hp
      exact MemInv_load hm f1 f2 f3 f4 f5 (loadUnits_relSt _ _ _ _ h) (loadUnits_vWr _ _ _ _ h)
  obtain ⟨s2, hs2⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := pw) (a := ⟨lab, 0⟩) (rel := false)
    us wsv 0 r0.1 hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem (List.mem_flatMap.2 ⟨r0, hr0, List.mem_map_of_mem hs2⟩)),
    fun r hr hpr0 hful hok => ?_⟩
  have hr' := hr
  have hpr := hpr0
  rw [List.mem_map] at hr
  obtain ⟨⟨s', t', ws'⟩, hr, rfl⟩ := hr
  rw [List.mem_flatMap] at hr
  obtain ⟨⟨s1, old⟩, h1, h2⟩ := hr
  rw [List.mem_map] at h2
  obtain ⟨s2, hs2, he2⟩ := h2
  simp only [Prod.mk.injEq] at he2
  obtain ⟨rfl, rfl, rfl⟩ := he2
  have hp1 : PromAbove s1 := storeUnits_promAbove hs2 (fun t ht m hm => hpr t ht m hm)
  obtain ⟨-, hlay, f1, -, fc, f3, -⟩ := hld (s1, old) h1 hp1
