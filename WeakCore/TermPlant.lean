      obtain ⟨-, -, m', w, hm', hw, -, hvl, -, hrel, hview, -⟩ := hFj' o tw htw
      rw [hm] at hm'; cases hm'
      rw [List.getElem?_map, hw] at hv; cases hv
      exact ⟨mw m, ⟨hvl.symm, fun a' g' h => Nat.max_le.mpr ⟨hview a' g' h, hrel⟩⟩, hl2⟩
  obtain ⟨vals', hWv, hLv⟩ := exists_WLe_pick _ hpick
  have hent : HeldEntry (CE η) s2 lab Ra := by
    refine ⟨fun h => (by change η.sto lab = none at h; rw [hsto] at h; cases h), fun c' hc' => ?_⟩
    change η.sto lab = some c' at hc'
    rw [hsto] at hc'; cases hc'
    refine ⟨vals', hLv, CellOKR_up hWv (Or.inl ⟨by rw [TermTear.length_mixU us A _ _ hln hvR0.2]; exact hus',
      hVa, TermTear.Valid_mix husA hst.2 hvR0.1.2 hln hvR0.2⟩)⟩
  have hX1 : MemHeldX (CE η) s1 lab H0 := MemHeldX_tr hX (fun _ _ => rfl) (fun _ _ => rfl)
    (fun l' hne o w hl => by rw [← f1] at hl; rw [PromAt_eqp f3]; exact hl) id
  have hX' : MemHeldX (CE η) s2 lab H0 := MemHeldX_store (a := ⟨lab, 0⟩) hX1 hm1'.2.2.1 hs2
  -- the value read, with the patched resources, at the static type
  have hvold : VRR ρ η u (shp ru) old Rp := by
    have h1 := VRR_up _ _ _ _ _ hWP hVp
    have h2 : VRR (fun _ => 0) (CE η) c.ty (shp c.ty) old Rp :=
      VRR_mono c.ty (CE (CE η).unsee) (CE η) _ _ _ _ (fun _ _ _ _ h => h) (fun _ _ _ _ h => h) rfl rfl rfl (fun _ _ h => h)
        (fun _ => Nat.le_refl _) (fun _ _ h => h) (fun _ h => h.elim) (fun _ _ h => h) h1
    have h3 := (Fd_VRR η hcty).1 h2
    rw [(Fd_lay hcty).1, ← shp_of_sig hsig] at h3
    exact (VRR_close hE.2.1 hE.2.2 ρ u [] 0 ρ (fun _ => 0) (shp ru) old Rp (fun k => rfl)
      (fun k hk => absurd hk (Nat.not_lt_zero _))).2 h3
  have hfi := bindR hb hi1 (RLink_of hE.2.1 hE.2.2) hvold hlay
  -- the accounting: debts at the visible word units, credits from them and from the plant items
  have hdbS : Res.sum (F.map db) ≤ Res.sum (L.map fun j => db (F.getD j 0)) := by
    rw [sum_idx db F, hFl, sum_filt (fun j => decide (VisU (CE η) ⟨lab, j⟩)) _ (fun j hj hp => ?_), ← hLdef]
    · exact fun k => Nat.le_refl _
    · obtain ⟨t, ht⟩ := hFex j (List.mem_range.mp hj)
      have hgd : F.getD j 0 = t := by rw [List.getD_eq_getElem?_getD, ht]; rfl
      show db (F.getD j 0) = _
      rw [hgd]; exact hdb0 j t ht (fun h => absurd (decide_eq_true h) (by rw [hp]; exact Bool.false_ne_true))
  have hgdL : ∀ j, j ∈ L → ∃ t, F[j]? = some t ∧ F.getD j 0 = t := fun j hj => by
    obtain ⟨t, ht⟩ := hFex j ((hLmem j).mp hj).1
    exact ⟨t, ht, by rw [List.getD_eq_getElem?_getD, ht]; rfl⟩
  have hG1 : Res.sum ((Gs.map crPatch).map PatchIt.R0) ≤ Res.sum ((Gs.map (·.1)).map cr) := by
    rw [List.map_map, List.map_map]
    exact sum_le_of Gs (fun x hx => by
      obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, hR, _⟩ := hGit x hx
      exact hR)
  have hndL : (L.map fun j => F.getD j 0).Nodup := by
    refine nodup_map_on (fun j hj j' hj' e => ?_) hLnd
    obtain ⟨t, ht, e1⟩ := hgdL j hj
    obtain ⟨t', ht', e2⟩ := hgdL j' hj'
    rw [e1, e2] at e; subst e
    exact hFinj j j' t ht ht'
  have hnd : (Gs.map (·.1) ++ L.map fun j => F.getD j 0).Nodup := by
    refine List.nodup_append.mpr ⟨hGnd, hndL, fun a ha b hb e => ?_⟩
    obtain ⟨x, hx, rfl⟩ := List.mem_map.mp ha
    obtain ⟨j, hj, rfl⟩ := List.mem_map.mp hb
    obtain ⟨t, ht, e1⟩ := hgdL j hj
    rw [e1] at e
    obtain ⟨mh, _, hmh, _, _, hnw, _⟩ := hGit x hx
    obtain ⟨-, -, m, -, hm, -, hl, -⟩ := hFj' j t ht
    change mem[x.1]? = some mh at hmh
    rw [e, hm] at hmh; cases hmh
    rw [hl] at hnw
    exact hnw ((hLmem j).mp hj).2.1
  have hsubF : ∀ y, y ∈ (Gs.map (·.1) ++ L.map fun j => F.getD j 0) → y ∈ F := by
    intro y hy
    rcases List.mem_append.mp hy with hy | hy
    · obtain ⟨x, hx, rfl⟩ := List.mem_map.mp hy
      obtain ⟨mh, usS, _, hlab, hlo, _, hat, _, husS, _, hq2, _⟩ := hGit x hx
      have hb := AtOff_bound hat husA husS
      obtain ⟨t, ht⟩ := hFex mh.loc.offset (Nat.lt_of_lt_of_le hq2 hb)
      have e : mh.loc = ⟨lab, mh.loc.offset⟩ := by rw [← hlab]
      have hlo' : LowOwn (stOf mem pairs th) ⟨lab, mh.loc.offset⟩ x.1 := by rw [← e]; exact hlo
      rw [LowOwn_uniq hlo' (hlow _ t ht)]
      exact List.mem_iff_getElem?.mpr ⟨_, ht⟩
    · obtain ⟨j, hj, rfl⟩ := List.mem_map.mp hy
      obtain ⟨t, ht, e1⟩ := hgdL j hj
      rw [e1]; exact List.mem_iff_getElem?.mpr ⟨_, ht⟩
  have hcrS := sum_sub_le (f := cr) hnd hsubF
  rw [sum_app, List.map_map] at hcrS
  exact mc_ofFul (Tot := Rr + Rp + Rs) (H' := Ra + H0) hC ⟨ρ, η, c', Rr + Rp, Rs, rfl, hE, ⟨he, hck⟩, htv', hfi, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0), hDy.letW hterm rfl⟩
    (MemInv_store hm1' hsto hown husA hval hlen s2 hs2) (MemHeld_unfocus hX' hent) hmem2
    (fun f => by have := hFs f; rw [f3] at this; exact this) hsub2 (Res.le_def.2 fun k => by
      have e1 := hle k
      have e2 := hacc k
      have e3 := hdbS k
      have e4 := hcrS k
      have e5 := hG1 k
      simp only [Res.add_apply, Function.comp_def, List.map_map] at e1 e2 e3 e4 e5 ⊢
      omega)


/-- The patch item of a plant credit item, relative to a piece at word `b`. -/
def crPatchAt (b : Nat) (x : Ts × Nat × Ty × List Word × Res × (Nat → Bool)) : PatchIt :=
  ⟨x.2.1 - b, x.2.2.1, (accs x.2.2.1).getD [], x.2.2.2.1, x.2.2.2.2.1, x.2.2.2.2.2⟩

/-- (OvW3 R2b) At word `0` the relative patch item is the plain one. -/
theorem crPatchAt_zero (x : Ts × Nat × Ty × List Word × Res × (Nat → Bool)) : crPatchAt 0 x = crPatch x := by
  simp only [crPatchAt, crPatch, Nat.sub_zero]
#print axioms TermPlant.crPatchAt_zero

theorem map_crPatchAt_zero (G : List (Ts × Nat × Ty × List Word × Res × (Nat → Bool))) :
    G.map (crPatchAt 0) = G.map crPatch := by
  rw [show crPatchAt 0 = crPatch from funext crPatchAt_zero]
#print axioms TermPlant.map_crPatchAt_zero

set_option maxHeartbeats 3200000 in
/-- (D3) **The fulfilling swap of a piece at an own frontier cell, with credits**:
the piece `U` (at word `b` of cell `c`) is swapped by a store that fulfils, at
each unit, the thread's lowest promise there.  The piece's new memory reading
holds `Ra`; the value read (below `old`) holds `Rp`; together, with the debts
of the fulfilled promises, they cost no more than the piece's old reading, the
new value, and the fulfilled promises' credits (plant credits included). -/
theorem pieceAcctF0 {E : TEnv} {s s2 : St} {cr db : Ts → Res} {lab : AllocLabel} {c : Cell} {f : Ts}
    {b : Nat} {U : Ty} {us : List Acc} {vq wsn P0 : List Word} {Rq Rv : Res} {F : List Ts} {wB : Ts}
    {Gs : List (Ts × Nat × Ty × List Word × Res × (Nat → Bool))} {coh1 : Address → Ts}
    (hC : PromCrP E s cr db) (hsto : E.sto lab = some c) (hf : E.pfr lab = some f)
    (hcpl : Ty.coupledOKIn [] c.ty = true) (hniU : noIallV U = true)
    (hclo : Clo c.ty) (hat : AtOff c.ty b U) (hus : accs U = some us) (hone : ∀ u, u ∈ us → u = .one)
    (hiniW : ∀ j, j < nWords us → IniW E ⟨lab, b + j⟩)
    (hinR : ∀ j, j < nWords us → InitRr E c lab (b + j))
    (htyc : ∀ j, j < nWords us → VisU E ⟨lab, b + j⟩ → ∃ m, s.mem[s.vs.coh ⟨lab, b + j⟩]? = some m ∧
      m.loc = ⟨lab, b + j⟩ ∧ ∀ k P, AtOff c.ty (b + j) (.word (.lit k) P) → P.ghost = false →
        pwf P = true ∧ ∃ x, m.val = .num x ∧ InP P x)
    (hvq : VRR (fun _ => 0) (CE E.unsee) U (shp U) vq Rq) (hVq : Valid U vq) (hlq : vq.length = nWords us)
    (hLq : ∀ j v, vq[j]? = some v → LatestNP s.mem (PromAt E s ⟨lab, b + j⟩) ⟨lab, b + j⟩ v)
    (hvn : VRR (fun _ => 0) (CE E.unsee) U (shp U) wsn Rv) (hVn : Valid U wsn) (hln : wsn.length = nWords us)
    (hmem2 : s2.mem = s.mem) (hsub2 : ∀ t, t ∈ s2.promises → t ∈ s.promises)
    (hFl : F.length = nWords us) (hFm : ∀ t, t ∈ s.promises → t ∈ s2.promises ∨ t ∈ F)
    (hFj : ∀ (j : Nat) t, F[j]? = some t → t ∈ s.promises ∧ t ∉ s2.promises ∧ ∃ m w, s.mem[t]? = some m ∧
      wsn[j]? = some w ∧ m.loc = ⟨lab, b + j⟩ ∧ WLe1 w (mw m) ∧ coh1 ⟨lab, b + j⟩ < t ∧
      s2.vs.coh ⟨lab, b + j⟩ = t)
    (hpr2 : ∀ t, t ∈ s2.promises → ∀ m, s.mem[t]? = some m → s2.vs.coh m.loc < t)
    (hcm : ∀ a, s.vs.coh a ≤ coh1 a) (hlP : P0.length = nWords us)
    (hP0 : ∀ (o : Nat) w, P0[o]? = some w → ∀ t, F[o]? = some t → PredAt s.mem ⟨lab, b + o⟩ t w)
    (hwB : ∀ (j : Nat) t, F[j]? = some t → t ≤ wB)
    (hW2 : ∀ t m, s.mem[t]? = some m → m.loc.label = lab → s.vs.coh m.loc < t → t ≤ wB → t ∈ s.promises)
    (hW3 : ∀ t m, t ∈ FpAt E ⟨lab, 0⟩ → s.mem[t]? = some m → m.loc.label = lab → wB < t)
    (hGnd : (Gs.map (·.1)).Nodup) (hGit : ∀ x ∈ Gs, CrItem E s cr lab c x)
    (hGcov : ∀ o tw, InitRr E c lab o → ¬ VisU E ⟨lab, o⟩ → LowOwn s ⟨lab, o⟩ tw → tw ≤ wB → OverT E s ⟨lab, o⟩ tw →
      ∃ x ∈ Gs, ∃ usS i, accs x.2.2.1 = some usS ∧ x.2.1 ≤ o ∧ InAcc usS i (o - x.2.1) ∧
        x.2.2.2.2.2 i = true) :
    ∃ M Ra Rp, M.length = nWords us ∧ VRR (fun _ => 0) (CE E.unsee) U (shp U) M Ra ∧ Valid U M ∧
      (∀ j w, M[j]? = some w → LatestNP s2.mem (PromAt E s2 ⟨lab, b + j⟩) ⟨lab, b + j⟩ w) ∧
      VRR (fun _ => 0) (CE E.unsee) U (shp U) P0 Rp ∧
      Ra + Rp + Res.sum (F.map db) ≤ Rq + Rv + Res.sum (F.map cr) := by
  classical
  have hnU : nWords us = us.length := nWords_ones us hone
  have hpfv : Vis E lab := Vis_pfr hf
  have hcplU := coupledOK_AtOff hat hcpl
  have haddr : ∀ j j', (⟨lab, b + j⟩ : Address) = ⟨lab, b + j'⟩ → j = j' := fun j j' e =>
    Nat.add_left_cancel (congrArg WeakMem.Address.offset e)
  have hFlt : ∀ j t, F[j]? = some t → j < nWords us := fun j t h => by
    rw [← hFl]; exact (List.getElem?_eq_some_iff.mp h).1
  have hFex : ∀ j, j < nWords us → ∃ t, F[j]? = some t := fun j hj =>
    ⟨F[j]'(by rw [hFl]; exact hj), List.getElem?_eq_getElem _⟩
  have hFinj : ∀ j j' t, F[j]? = some t → F[j']? = some t → j = j' := fun j j' t h h' => by
    obtain ⟨-, -, m, -, hm, -, hl, -⟩ := hFj j t h
    obtain ⟨-, -, m', -, hm', -, hl', -⟩ := hFj j' t h'
    rw [hm] at hm'; cases hm'
    exact haddr _ _ (hl.symm.trans hl')
  have hlow : ∀ j t, F[j]? = some t → LowOwn s ⟨lab, b + j⟩ t := by
    intro j t hj
    obtain ⟨h1, -, m, -, hm, -, hl, -, -, hc2⟩ := hFj j t hj
    refine ⟨h1, ⟨m, hm, hl⟩, fun t' m' ht' hm' hl' => ?_⟩
    rcases hFm t' ht' with h | h
    · have := hpr2 t' h m' hm'
      rw [hl', hc2] at this; exact Nat.le_of_lt this
    · obtain ⟨j', hj'⟩ := List.mem_iff_getElem?.mp h
      obtain ⟨-, -, m'', -, hm'', -, hl'', -⟩ := hFj j' t' hj'
      rw [hm'] at hm''; cases hm''
      have := haddr _ _ (hl'.symm.trans hl''); subst this
      rw [hj] at hj'; cases hj'; exact Nat.le_refl _
  have hgap : ∀ j t, F[j]? = some t → ∀ t' m', s.mem[t']? = some m' → m'.loc = ⟨lab, b + j⟩ →
      s.vs.coh ⟨lab, b + j⟩ < t' → t' < t → False := by
    intro j t hj t' m' hm' hl' hc ht
    have hin := hW2 t' m' hm' (by rw [hl']) (by rw [hl']; exact hc)
      (Nat.le_trans (Nat.le_of_lt ht) (hwB j t hj))
    exact absurd ((hlow j t hj).2.2 t' m' hin hm' hl') (Nat.not_le.mpr ht)
  obtain ⟨A, hAdef⟩ : ∃ A : Nat → Bool, ∀ j, A j = true ↔ (¬ VisU E ⟨lab, b + j⟩ ∧
      ∀ t, F[j]? = some t → ¬ OverT E s ⟨lab, b + j⟩ t) :=
    ⟨fun j => decide _, fun j => decide_eq_true_iff⟩
  obtain ⟨L, hLdef⟩ : ∃ L : List Nat, L = (List.range (nWords us)).filter fun j => decide (VisU E ⟨lab, b + j⟩) :=
    ⟨_, rfl⟩
  have hLmem : ∀ j, j ∈ L ↔ j < nWords us ∧ VisU E ⟨lab, b + j⟩ := fun j => by
    rw [hLdef, List.mem_filter, List.mem_range, decide_eq_true_iff]
  have hLnd : L.Nodup := by rw [hLdef]; exact List.Nodup.sublist (List.filter_sublist ..) List.nodup_range
  -- (U3) the piece's units are initialised in the real count: no predicted unit
  have hnq : ∀ j tw, F[j]? = some tw → ¬ PredU E ⟨lab, b + j⟩ := fun j tw hj =>
    PredU_initRr hsto (hinR j (hFlt j tw hj))
  have hQ' : ∀ j tw, ¬ VisU E ⟨lab, b + j⟩ → F[j]? = some tw → ∀ t m, s.mem[t]? = some m →
      m.loc = ⟨lab, b + j⟩ →
      (t ∈ PromAt E s2 ⟨lab, b + j⟩ ↔ t ∈ PromAt E s ⟨lab, b + j⟩ ∧ t ≠ tw) := by
    intro j tw hnv hj t m hm hl
    rw [PromAt_nword hnv (hnq j tw hj), PromAt_nword hnv (hnq j tw hj)]
    obtain ⟨-, htw2, -⟩ := hFj j tw hj
    constructor
    · intro h
      rcases List.mem_append.mp h with h | h
      · exact ⟨List.mem_append_left _ (hsub2 t h), fun e => htw2 (e ▸ h)⟩
      · refine ⟨List.mem_append_right _ h, fun e => ?_⟩
        subst e
        have := hW3 t m h hm (by rw [hl])
        exact absurd (hwB j t hj) (Nat.not_le.mpr this)
    · rintro ⟨h, hne⟩
      rcases List.mem_append.mp h with h | h
      · rcases hFm t h with h' | h'
        · exact List.mem_append_left _ h'
        · obtain ⟨j', hj'⟩ := List.mem_iff_getElem?.mp h'
          obtain ⟨-, -, m', -, hm', -, hl', -⟩ := hFj j' t hj'
          rw [hm] at hm'; cases hm'
          have := haddr _ _ (hl.symm.trans hl'); subst this
          rw [hj] at hj'; exact absurd (Option.some.inj hj').symm hne
      · exact List.mem_append_right _ h
  have hAu : ∀ j tw, A j = true → F[j]? = some tw → ∃ m wp, s.mem[tw]? = some m ∧ P0[j]? = some wp ∧
      LatestNP s.mem (PromAt E s ⟨lab, b + j⟩) ⟨lab, b + j⟩ wp ∧
      LatestNP s.mem (PromAt E s2 ⟨lab, b + j⟩) ⟨lab, b + j⟩ (mw m) := by
    intro j tw hA hj
    obtain ⟨hnv, hno⟩ := (hAdef j).mp hA
    obtain ⟨htw, -, m, w, hm, -, hl, -⟩ := hFj j tw hj
    have hjn := hFlt j tw hj
    obtain ⟨wp, hwp⟩ : ∃ wp, P0[j]? = some wp := ⟨_, List.getElem?_eq_getElem (by rw [hlP]; exact hjn)⟩
    obtain ⟨tm, mtm, hlt, hmm, hlm, hwm, hbt⟩ := hP0 j wp hwp tw hj
    refine ⟨m, wp, hm, hwp, ?_⟩
    have := unitA (Q := PromAt E s ⟨lab, b + j⟩) (Q' := PromAt E s2 ⟨lab, b + j⟩)
      (hQ' j tw hnv hj) hm hl (by rw [PromAt_nword hnv (hnq j tw hj)]; exact List.mem_append_left _ htw) hmm hlm
      hlt hbt
      (fun t m' ht hm' hl' => by
        rw [PromAt_nword hnv (hnq j tw hj)] at ht
        rcases List.mem_append.mp ht with h | h
        · exact (hlow j tw hj).2.2 t m' h hm' hl'
        · exact Nat.le_of_lt (Nat.lt_of_le_of_lt (hwB j tw hj) (hW3 t m' h hm' (by rw [hl']))))
      (fun t m' ht hm' hl' => Classical.byContradiction fun hn => hno tw hj ⟨t, m', ht, hm', hl', hn⟩)
    rw [← hwm]; exact this
  have hdb0 : ∀ j t, F[j]? = some t → ¬ VisU E ⟨lab, b + j⟩ → db t = .zero := by
    intro j t hj hnv
    obtain ⟨htw, -, m, -, hm, -, hl, -⟩ := hFj j t hj
    obtain ⟨m', hm', hdb, -⟩ := hC t htw
    rw [hm] at hm'; cases hm'
    exact (DbRes_nvisU (by rw [hl]; exact fun h => h.elim hnv fun h' => hnq j t hj h'.1)).1 hdb
  have hWu : ∀ j, j ∈ L → A j = false ∧ ∃ k P w0 wp, AtOff U j (.word (.lit k) P) ∧ P.ghost = false ∧
      wsn[j]? = some w0 ∧ P0[j]? = some wp ∧
      (∃ Rw, VRR (fun _ => 0) (CE E.unsee) (.word (.lit k) P) (shp (.word (.lit k) P)) [wp] Rw) ∧
      (fun j => db (F.getD j 0)) j = wr P k w0.val ∧ (fun j => cr (F.getD j 0)) j = wr P k wp.val := by
    intro j hj
    obtain ⟨hjn, hvu⟩ := (hLmem j).mp hj
    refine ⟨Bool.eq_false_iff.mpr fun h => ((hAdef j).mp h).1 hvu, ?_⟩
    obtain ⟨c', hc', hwu⟩ := hvu.1
    change E.sto lab = some c' at hc'
    rw [hsto] at hc'; cases hc'
    obtain ⟨r, P, hg, hatc, hatU⟩ : ∃ r P, P.ghost = false ∧ AtOff c.ty (b + j) (.word r P) ∧
        AtOff U j (.word r P) := by
      rcases hwu with ⟨r, P, hg, h⟩ | ⟨r, P, h⟩ | ⟨r, P, h1, h⟩
      · change AtOff c.ty (b + j) _ at h
        refine ⟨r, P, hg, h, ?_⟩
        rcases AtOff_nest (Solid_word r P) (accs_word hg) hat hus h with h' | h' | ⟨-, h'⟩
        · simp [nWords, Acc.size] at h' <;> omega
        · omega
        · rwa [Nat.add_sub_cancel_left] at h'
      · change AtOff c.ty (b + j) _ at h
        rcases AtOff_nest (Solid_word2 r P) accs_word2 hat hus h with h' | h' | ⟨-, h'⟩
        · simp [nWords, Acc.size] at h' <;> omega
        · omega
        · rw [Nat.add_sub_cancel_left] at h'; exact (no_word2_of_ones hus hone h').elim
      · change 1 ≤ b + j at h1
        change AtOff c.ty (b + j - 1) _ at h
        rcases AtOff_nest (Solid_word2 r P) accs_word2 hat hus h with h' | h' | ⟨-, h'⟩
        · simp [nWords, Acc.size] at h' <;> omega
        · omega
        · exact (no_word2_of_ones hus hone h').elim
    obtain ⟨k, rfl⟩ := AtOff_word_lit0 hatc hclo r P rfl
    obtain ⟨tw, htw⟩ := hFex j hjn
    obtain ⟨htwP, -, m, w, hm, hw, hl, hle1, hc1, -⟩ := hFj j tw htw
    obtain ⟨wp, hwp⟩ : ∃ wp, P0[j]? = some wp := ⟨_, List.getElem?_eq_getElem (by rw [hlP]; exact hjn)⟩
    have hpd := hP0 j wp hwp tw htw
    have hgd : F.getD j 0 = tw := by rw [List.getD_eq_getElem?_getD, htw]; rfl
    have hWA : WordAt E ⟨lab, b + j⟩ k P := ⟨c, hsto, hatc, hg⟩
    have hini := hiniW j hjn
    obtain ⟨m', hm', hdb, hcr⟩ := hC tw htwP
    rw [hm] at hm'; cases hm'
    obtain ⟨mc, hmc, hlc, hty0⟩ := htyc j hjn hvu
    obtain ⟨t0, m0, hlt0, hm0, hl0, hw0, hbt0⟩ := hpd
    have hct : s.vs.coh ⟨lab, b + j⟩ < tw := Nat.lt_of_le_of_lt (hcm _) hc1
    have ht0 : t0 = s.vs.coh ⟨lab, b + j⟩ := by
      rcases Nat.lt_trichotomy t0 (s.vs.coh ⟨lab, b + j⟩) with h | h | h
      · exact absurd hlc (hbt0 _ mc h hct hmc)
      · exact h
      · exact (hgap j tw htw t0 m0 hm0 hl0 h hlt0).elim
    subst ht0
    rw [hm0] at hmc; cases hmc
    have hty : pwf P = true ∧ ∃ x, wp.val = .num x ∧ InP P x := by
      rw [← hw0]; exact hty0 k P hatc hg
    have hdb := (DbRes_nInit (by
      rw [hl]; intro h
      obtain ⟨x, hx, -⟩ := hty.2
      have := h wp ⟨_, mc, hlt0, hm0, hl0, hw0, hbt0⟩
      rw [hx] at this; cases this)).1 hdb
    rw [hl] at hdb
    refine ⟨k, P, w, wp, hatU, hg, hw, hwp, ⟨_, VRR_word_of hty.1 hty.2⟩, ?_, ?_⟩
    · show db (F.getD j 0) = _
      rw [hgd, WRes_eq_wr hWA ((VRes_vis hpfv hini).mp hdb), ← hle1.1]
    · show cr (F.getD j 0) = _
      rw [hgd]
      rcases hcr with hcr | hpl
      · rcases hcr with ⟨w', hpw', hv'⟩ | ⟨hnp, -⟩
        · rw [hl] at hpw' hv'
          have e := PredAt_uniq ⟨_, mc, hlt0, hm0, hl0, hw0, hbt0⟩ hpw'
          subst e
          exact WRes_eq_wr hWA ((VRes_vis hpfv hini).mp hv')
        · rw [hl] at hnp; exact (hnp wp ⟨_, mc, hlt0, hm0, hl0, hw0, hbt0⟩).elim
      · obtain ⟨_, _, _, _, _, _, _, -, -, -, -, -, -, hnw, -⟩ := hpl
        rw [hl] at hnw; exact absurd (WordAt_unit hWA) hnw
  have hAc : ∀ j, A j = true → vq[j]? = P0[j]? := by
    intro j hA
    by_cases hj : j < nWords us
    · obtain ⟨tw, htw⟩ := hFex j hj
      obtain ⟨m, wp, -, hwp, hl1, -⟩ := hAu j tw hA htw
      obtain ⟨v, hv⟩ : ∃ v, vq[j]? = some v := ⟨_, List.getElem?_eq_getElem (by rw [hlq]; exact hj)⟩
      rw [hv, hwp, LatestNP_uniq (hLq j v hv) hl1]
    · rw [List.getElem?_eq_none (by rw [hlq]; omega), List.getElem?_eq_none (by rw [hlP]; omega)]
  obtain ⟨Gf, hGfdef⟩ : ∃ Gf : List (Ts × Nat × Ty × List Word × Res × (Nat → Bool)),
      Gf = Gs.filter fun x => decide (b ≤ x.2.1 ∧ AtOff U (x.2.1 - b) x.2.2.1) := ⟨_, rfl⟩
  have hGfmem : ∀ x, x ∈ Gf ↔ x ∈ Gs ∧ b ≤ x.2.1 ∧ AtOff U (x.2.1 - b) x.2.2.1 := fun x => by
    rw [hGfdef, List.mem_filter, decide_eq_true_iff]
  have hGok : ∀ g ∈ Gf.map (crPatchAt b), g.OK E.unsee (fun _ => 0) U P0 := by
    intro g hg
    obtain ⟨x, hx, rfl⟩ := List.mem_map.mp hg
    obtain ⟨hx, hbq, hatUS⟩ := (hGfmem x).mp hx
    obtain ⟨mh, usS, hmh, hlab, hlo, hnw, hatS, hsol, husS, hq1, hq2, hwl, hvr, hR, hpin⟩ := hGit x hx
    have hb := AtOff_bound hatUS hus husS
    refine ⟨hatUS, by simp [crPatchAt, husS], coupledOK_AtOff hatUS hcplU, iallOK_ofNIP _ _ (noIallV_AtOffP hatUS hniU),
      hvr.1, by simp [crPatchAt, husS, hwl], fun i o hi ho => ?_⟩
    simp only [crPatchAt, husS, Option.getD_some] at hi ho ⊢
    have hon : o < nWords usS := Nat.lt_of_lt_of_le ho.2 (TermTear.nWords_take_le _ _)
    have hqn : x.2.1 - b + o < nWords us := by omega
    have e : b + (x.2.1 - b + o) = x.2.1 + o := by omega
    obtain ⟨tw, htw⟩ := hFex _ hqn
    obtain ⟨wp, hwp⟩ : ∃ wp, P0[x.2.1 - b + o]? = some wp :=
      ⟨_, List.getElem?_eq_getElem (by rw [hlP]; exact hqn)⟩
    obtain ⟨w, hw⟩ : ∃ w, x.2.2.2.1[o]? = some w := ⟨_, List.getElem?_eq_getElem (by rw [hwl]; exact hon)⟩
    have hl1 := hlow _ tw htw
    have hp1 := hP0 _ wp hwp tw htw
    rw [e] at hl1 hp1
    rw [hw, hwp, PredAt_uniq (hpin i o w tw hi ho hw hl1) hp1]
  have hcov : ∀ j, j < nWords us → A j = false → j ∉ L → ∃ g ∈ Gf.map (crPatchAt b), g.Cov j := by
    intro j hj hA hL
    have hnv : ¬ VisU E ⟨lab, b + j⟩ := fun h => hL ((hLmem j).mpr ⟨hj, h⟩)
    obtain ⟨tw, htw⟩ := hFex j hj
    have hov : OverT E s ⟨lab, b + j⟩ tw := Classical.byContradiction fun hn =>
      absurd ((hAdef j).mpr ⟨hnv, fun t ht => by rw [htw] at ht; cases ht; exact hn⟩)
        (by rw [hA]; exact Bool.false_ne_true)
    obtain ⟨x, hx, usS, i, husS, h1, h3, h4⟩ :=
      hGcov (b + j) tw (hinR j hj) hnv (hlow j tw htw) (hwB j tw htw) hov
    obtain ⟨-, usS', -, -, -, -, hatS, hsol, husS', -⟩ := hGit x hx
    rw [husS] at husS'; cases husS'
    have hin : b + j - x.2.1 < nWords usS := Nat.lt_of_lt_of_le h3.2 (TermTear.nWords_take_le _ _)
    obtain ⟨hbq, hatUS⟩ : b ≤ x.2.1 ∧ AtOff U (x.2.1 - b) x.2.2.1 := by
      rcases AtOff_nest hsol husS hat hus hatS with h' | h' | h'
      · omega
      · omega
      · exact h'
    refine ⟨crPatchAt b x, List.mem_map_of_mem ((hGfmem x).mpr ⟨hx, hbq, hatUS⟩), ?_⟩
    show x.2.1 - b ≤ j ∧ ∃ i, InAcc ((accs x.2.2.1).getD []) i (j - (x.2.1 - b)) ∧ x.2.2.2.2.2 i = true
    have e : j - (x.2.1 - b) = b + j - x.2.1 := by omega
    rw [husS, e]; exact ⟨by omega, i, h3, h4⟩
  obtain ⟨Ra, Rp, hVa, hVp, hacc⟩ := cellAcct hus hone hcplU (iallOK_ofNIP _ _ hniU) hvq hvn hlq hln hlP A L hLnd
    (fun j => db (F.getD j 0)) (fun j => cr (F.getD j 0)) hAc hWu (Gf.map (crPatchAt b)) hGok hcov
  -- the piece after
  have hpick : ∀ o v, (TermTear.mixU us A wsn vq)[o]? = some v →
      ∃ w, WLe1 v w ∧ LatestNP s2.mem (PromAt E s2 ⟨lab, b + o⟩) ⟨lab, b + o⟩ w := by
    intro o v hv
    have hon : o < nWords us := by
      have := (List.getElem?_eq_some_iff.mp hv).1
      rwa [TermTear.length_mixU us A _ _ hln hlq] at this
    have hia := inAcc_one hone (j := o) (by rw [← hnU]; exact hon)
    rw [TermTear.mixU_getElem us A _ _ o o hln hlq hia] at hv
    rw [hmem2]
    obtain ⟨tw, htw⟩ := hFex o hon
    cases hAo : A o
    · simp only [hAo, Bool.false_eq_true, ↓reduceIte] at hv
      refine ⟨v, WLe1_refl v, ?_⟩
      by_cases hvu : VisU E ⟨lab, b + o⟩
      · rw [PromAt_word hvu]; have := hLq o v hv; rw [PromAt_word hvu] at this; exact this
      · have hov : OverT E s ⟨lab, b + o⟩ tw := Classical.byContradiction fun hn =>
          absurd ((hAdef o).mpr ⟨hvu, fun t ht => by rw [htw] at ht; cases ht; exact hn⟩)
            (by rw [hAo]; exact Bool.false_ne_true)
        exact unitO (hQ' o tw hvu htw) hov (hLq o v hv)
    · simp only [hAo, ↓reduceIte] at hv
      obtain ⟨m, wp, hm, -, -, hl2⟩ := hAu o tw hAo htw
      obtain ⟨-, -, m', w, hm', hw, -, hle1, -⟩ := hFj o tw htw
      rw [hm] at hm'; cases hm'
      rw [hw] at hv; cases hv
      exact ⟨mw m, hle1, hl2⟩
  obtain ⟨vals', hWv, hLv⟩ := exists_WLe_pick _ hpick
  -- the accounting
  have hdbS : Res.sum (F.map db) ≤ Res.sum (L.map fun j => db (F.getD j 0)) := by
    rw [sum_idx db F, hFl, sum_filt (fun j => decide (VisU E ⟨lab, b + j⟩)) _ (fun j hj hp => ?_), ← hLdef]
    · exact fun k => Nat.le_refl _
    · obtain ⟨t, ht⟩ := hFex j (List.mem_range.mp hj)
      have hgd : F.getD j 0 = t := by rw [List.getD_eq_getElem?_getD, ht]; rfl
      show db (F.getD j 0) = _
      rw [hgd]; exact hdb0 j t ht (fun h => absurd (decide_eq_true h) (by rw [hp]; exact Bool.false_ne_true))
  have hgdL : ∀ j, j ∈ L → ∃ t, F[j]? = some t ∧ F.getD j 0 = t := fun j hj => by
    obtain ⟨t, ht⟩ := hFex j ((hLmem j).mp hj).1
    exact ⟨t, ht, by rw [List.getD_eq_getElem?_getD, ht]; rfl⟩
  have hG1 : Res.sum ((Gf.map (crPatchAt b)).map PatchIt.R0) ≤ Res.sum ((Gf.map (·.1)).map cr) := by
    rw [List.map_map, List.map_map]
    exact sum_le_of Gf (fun x hx => by
      obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, hR, _⟩ := hGit x ((hGfmem x).mp hx).1
      exact hR)
  have hndL : (L.map fun j => F.getD j 0).Nodup := by
    refine nodup_map_on (fun j hj j' hj' e => ?_) hLnd
    obtain ⟨t, ht, e1⟩ := hgdL j hj
    obtain ⟨t', ht', e2⟩ := hgdL j' hj'
    rw [e1, e2] at e; subst e
    exact hFinj j j' t ht ht'
  have hndG : (Gf.map (·.1)).Nodup := by
    rw [hGfdef]; exact List.Nodup.sublist (List.Sublist.map _ (List.filter_sublist ..)) hGnd
  have hnd : (Gf.map (·.1) ++ L.map fun j => F.getD j 0).Nodup := by
    refine List.nodup_append.mpr ⟨hndG, hndL, fun a ha b' hb e => ?_⟩
    obtain ⟨x, hx, rfl⟩ := List.mem_map.mp ha
    obtain ⟨j, hj, rfl⟩ := List.mem_map.mp hb
    obtain ⟨t, ht, e1⟩ := hgdL j hj
    rw [e1] at e
    obtain ⟨mh, _, hmh, _, _, hnw, _⟩ := hGit x ((hGfmem x).mp hx).1
    obtain ⟨-, -, m, -, hm, -, hl, -⟩ := hFj j t ht
    rw [e, hm] at hmh; cases hmh
    rw [hl] at hnw
    exact hnw ((hLmem j).mp hj).2.1
  have hsubF : ∀ y, y ∈ (Gf.map (·.1) ++ L.map fun j => F.getD j 0) → y ∈ F := by
    intro y hy
    rcases List.mem_append.mp hy with hy | hy
    · obtain ⟨x, hx, rfl⟩ := List.mem_map.mp hy
      obtain ⟨hx, hbq, hatUS⟩ := (hGfmem x).mp hx
      obtain ⟨mh, usS, _, hlab, hlo, _, _, _, husS, hq1, hq2, _⟩ := hGit x hx
      have hb := AtOff_bound hatUS hus husS
      have hlt : mh.loc.offset - b < nWords us := by
        have key : ∀ Y : Nat, x.2.1 ≤ Y → Y < x.2.1 + nWords usS → Y - b < nWords us := by
          intro Y; omega
        exact key _ hq1 hq2
      obtain ⟨t, ht⟩ := hFex (mh.loc.offset - b) hlt
      have e : mh.loc = ⟨lab, b + (mh.loc.offset - b)⟩ := by
        rw [Nat.add_sub_cancel' (Nat.le_trans hbq hq1), ← hlab]
      have hlo' : LowOwn s ⟨lab, b + (mh.loc.offset - b)⟩ x.1 := by rw [← e]; exact hlo
      rw [LowOwn_uniq hlo' (hlow _ t ht)]
      exact List.mem_iff_getElem?.mpr ⟨_, ht⟩
    · obtain ⟨j, hj, rfl⟩ := List.mem_map.mp hy
      obtain ⟨t, ht, e1⟩ := hgdL j hj
      rw [e1]; exact List.mem_iff_getElem?.mpr ⟨_, ht⟩
  have hcrS := sum_sub_le (f := cr) hnd hsubF
  rw [sum_app] at hcrS
  refine ⟨vals', Ra, Rp, hWv.length.symm.trans (TermTear.length_mixU us A _ _ hln hlq),
    VRR_up U _ _ _ _ hWv hVa, Valid_vals U _ _ hWv.vals (TermTear.Valid_mix hus hVn hVq hln hlq), hLv,
    hVp, fun k => ?_⟩
  have e2 := hacc k
  have e3 := hdbS k
  have e4 := hcrS k
  have e5 := hG1 k
  simp only [Res.add_apply, Function.comp_def, List.map_map] at e2 e3 e4 e5 ⊢
  omega

/-! ## (OvW3 R2a) Re-pin items at a fulfilling own store's piece -/

/-- (OvW3 R2a) At an all-one-word layout, a unit is its word. -/
theorem inAcc_ones_eq {us : List Acc} (h1 : ∀ u, u ∈ us → u = .one) {i o : Nat} (h : InAcc us i o) :
    o = i := by
  have e1 := nWords_ones (us.take i) (fun u hu => h1 u (List.mem_of_mem_take hu))
  have e2 := nWords_ones (us.take (i + 1)) (fun u hu => h1 u (List.mem_of_mem_take hu))
  obtain ⟨ha, hb⟩ := h
  rw [e1, List.length_take] at ha
  rw [e2, List.length_take] at hb
  omega
#print axioms TermPlant.inAcc_ones_eq

/-- (OvW3 R2a) **Re-pin items from the patch leftovers** (`cellAcctD`'s `Ds`): at a fulfilling own
store's piece, each leftover whose item first covers a fulfilled, overtaken, non-visible unit gives
a re-pin item (the leftover's mix, bumped there to the fulfilled message, which is the new lowest
own promise's predecessor); together they cost no more than the leftovers and cover every such
unit. -/
theorem repin_fromDs {E : TEnv} {s s2 : St} {cr : Ts → Res} {lab : AllocLabel} {c : Cell} {f : Ts}
    {b : Nat} {U : Ty} {us : List Acc} {vq wsn P0 : List Word} {F : List Ts} {A : Nat → Bool}
    {L : List Nat} {coh1 : Address → Ts}
    {Gf : List (Ts × Nat × Ty × List Word × Res × (Nat → Bool))} {Ds : List (PatchIt × Res × List Word)}
    (hsto : E.sto lab = some c) (hown : c.owner = some E.tid) (hf : E.pfr lab = some f)
    (hlay : LayT c.ty) (hnoT : Ty.noOwnIn [] c.ty = true)
    (hus : accs U = some us) (hone : ∀ u, u ∈ us → u = .one)
    (hVq : Valid U vq) (hlq : vq.length = nWords us) (hVn : Valid U wsn) (hln : wsn.length = nWords us)
    (hmem2 : s2.mem = s.mem) (hsub2 : ∀ t, t ∈ s2.promises → t ∈ s.promises)
    (hFl : F.length = nWords us)
    (hFj : ∀ (j : Nat) t, F[j]? = some t → t ∈ s.promises ∧ t ∉ s2.promises ∧ ∃ m w, s.mem[t]? = some m ∧
      wsn[j]? = some w ∧ m.loc = ⟨lab, b + j⟩ ∧ WLe1 w (mw m) ∧ coh1 ⟨lab, b + j⟩ < t ∧
      s2.vs.coh ⟨lab, b + j⟩ = t)
    (hlow : ∀ j t, F[j]? = some t → LowOwn s ⟨lab, b + j⟩ t)
    (hQ' : ∀ j tw, ¬ VisU E ⟨lab, b + j⟩ → F[j]? = some tw → ∀ t m, s.mem[t]? = some m →
      m.loc = ⟨lab, b + j⟩ → (t ∈ PromAt E s2 ⟨lab, b + j⟩ ↔ t ∈ PromAt E s ⟨lab, b + j⟩ ∧ t ≠ tw))
    (hAdef : ∀ j, A j = true ↔ (¬ VisU E ⟨lab, b + j⟩ ∧ ∀ t, F[j]? = some t → ¬ OverT E s ⟨lab, b + j⟩ t))
    (hLmem : ∀ j, j ∈ L ↔ j < nWords us ∧ VisU E ⟨lab, b + j⟩)
    (hGit : ∀ x ∈ Gf, CrItem E s cr lab c x) (hGb : ∀ x ∈ Gf, b ≤ x.2.1)
    (hGok : ∀ g ∈ Gf.map (crPatchAt b), g.OK E.unsee (fun _ => 0) U P0)
    (hcov : ∀ j, j < nWords us → A j = false → j ∉ L → ∃ g ∈ Gf.map (crPatchAt b), g.Cov j)
    (hDs : Ds.map (·.1) = Gf.map (crPatchAt b))
    (hD : ∀ d ∈ Ds, VRR (fun _ => 0) (CE E.unsee) d.1.S (shp d.1.S) (TermTear.mixU d.1.us d.1.K d.2.2 d.1.ws) d.2.1 ∧
        d.2.2.length = nWords d.1.us ∧
        ∀ o, o < nWords d.1.us → d.2.2[o]? = P0[d.1.q + o]? ∨
          (A (d.1.q + o) = false ∧ d.2.2[o]? = wsn[d.1.q + o]?) ∨
          (A (d.1.q + o) = true ∧ d.2.2[o]? = vq[d.1.q + o]?))
    (hfirst : ∀ (i : Nat) (d : PatchIt × Res × List Word), Ds[i]? = some d → ∀ o, o < nWords d.1.us →
        (∀ (j : Nat) (e : PatchIt × Res × List Word), j < i → Ds[j]? = some e → ¬ e.1.Cov (d.1.q + o)) →
        d.1.q + o ∉ L → d.1.q + o < nWords us →
        d.2.2[o]? = if A (d.1.q + o) then vq[d.1.q + o]? else wsn[d.1.q + o]?) :
    ∃ RS : List (AllocLabel × Cell × CrIt), (∀ y ∈ RS, RepinItU E s2 y ∧ y.1 = lab) ∧
      Res.sum (RS.map fun y => y.2.2.2.2.2.2.1) ≤ Res.sum (Ds.map (·.2.1)) ∧
      ∀ (o : Nat) th0 tw, b ≤ o → o < b + nWords us → ¬ VisU E ⟨lab, o⟩ → LowOwn s ⟨lab, o⟩ th0 →
        th0 ∉ s2.promises → LowOwn s2 ⟨lab, o⟩ tw → OverT E s2 ⟨lab, o⟩ tw → WinGU E s2 lab o tw →
        ∃ y ∈ RS, y.1 = lab ∧ CrCov y.2.2 o := by
  classical
  -- a leftover is good at word `o` of the cell: it first covers the fulfilled, overtaken unit there
  let Good : (PatchIt × Res × List Word) → Nat → Prop := fun d o =>
    ∃ i, Ds[i]? = some d ∧ b ≤ o ∧ d.1.Cov (o - b) ∧
      (∀ (j : Nat) (e : PatchIt × Res × List Word), j < i → Ds[j]? = some e → ¬ e.1.Cov (o - b)) ∧
      o - b ∉ L ∧ o - b < nWords us ∧ A (o - b) = false ∧
      ∃ th0 tw, F[o - b]? = some th0 ∧ th0 < tw ∧ LowOwn s2 ⟨lab, o⟩ tw ∧ WinGU E s2 lab o tw
  let Q : (PatchIt × Res × List Word) → AllocLabel × Cell × CrIt → Prop := fun d y =>
    y.1 = lab ∧ RepinItU E s2 y ∧ y.2.2.2.2.2.2.1 = d.2.1 ∧ ∀ o, Good d o → CrCov y.2.2 o
  -- each good leftover gives an item
  have hmk : ∀ d ∈ Ds, ∀ o0, Good d o0 → ∃ y, Q d y := by
    rintro ⟨g, Rd, Cd⟩ hd o0 hg0
    obtain ⟨x, hx, ex⟩ : ∃ x ∈ Gf, crPatchAt b x = g := by
      have : g ∈ Gf.map (crPatchAt b) := by rw [← hDs]; exact List.mem_map_of_mem hd
      exact List.mem_map.1 this
    obtain ⟨hok1, -, -, -, -, -, hKP⟩ := hGok g (by rw [← ex]; exact List.mem_map_of_mem hx)
    subst ex
    obtain ⟨mh, usS, hmh, hlab, hlo, hnwx, hatS, hsol, husS, hq1, hq2, hwl, hvr, -, -⟩ := hGit x hx
    have hbq := hGb x hx
    have eus : (crPatchAt b x).us = usS := by simp only [crPatchAt, husS, Option.getD_some]
    obtain ⟨hvD, hlCd, halt⟩ := hD _ hd
    rw [eus] at hvD hlCd halt hKP
    change VRR (fun _ => 0) (CE E.unsee) x.2.2.1 (shp x.2.2.1)
      (TermTear.mixU usS x.2.2.2.2.2 Cd x.2.2.2.1) Rd at hvD
    change AtOff U (x.2.1 - b) x.2.2.1 at hok1
    have hb := AtOff_bound hok1 hus husS
    obtain ⟨pre, post, epre, -⟩ := AtOff_embed hok1 hus husS
    have hone' : ∀ u, u ∈ usS → u = .one := fun u hu => hone u (by rw [epre]; simp [hu])
    have hnS : nWords usS = usS.length := nWords_ones usS hone'
    have hIo : ∀ o, o < nWords usS → InAcc usS o o := fun o ho => inAcc_one hone' (by rw [← hnS]; exact ho)
    -- the leftover's mix is a valid value: at each word one of the item's, the new or the old word
    generalize hDl : TermTear.mixU usS x.2.2.2.2.2 Cd x.2.2.2.1 = Dl at hvD
    have hlD : Dl.length = nWords usS := by rw [← hDl]; exact TermTear.length_mixU usS _ _ _ hlCd hwl
    have hDget : ∀ o, o < nWords usS → Dl[o]? = if x.2.2.2.2.2 o then Cd[o]? else x.2.2.2.1[o]? := fun o ho => by
      rw [← hDl]; exact TermTear.mixU_getElem usS _ _ _ o o hlCd hwl (hIo o ho)
    have hwS : wc x.2.2.1 = some (nWords usS) := wc_of_accs husS
    have hUa : accs U ≠ none := by rw [hus]; simp
    have hVW := Valid_at hok1 hUa hVn (by rw [wc_of_accs hus, hln]) _ hwS
    have hVV := Valid_at hok1 hUa hVq (by rw [wc_of_accs hus, hlq]) _ hwS
    generalize hW : (wsn.drop (x.2.1 - b)).take (nWords usS) = W at hVW
    generalize hV : (vq.drop (x.2.1 - b)).take (nWords usS) = V at hVV
    have hlW : W.length = nWords usS := by rw [← hW]; simp only [List.length_take, List.length_drop]; omega
    have hlV : V.length = nWords usS := by rw [← hV]; simp only [List.length_take, List.length_drop]; omega
    have hWget : ∀ o, o < nWords usS → W[o]? = wsn[x.2.1 - b + o]? := fun o ho => by
      rw [← hW, List.getElem?_take_of_lt ho, List.getElem?_drop]
    have hVget : ∀ o, o < nWords usS → V[o]? = vq[x.2.1 - b + o]? := fun o ho => by
      rw [← hV, List.getElem?_take_of_lt ho, List.getElem?_drop]
    have hlM2 := TermTear.length_mixU usS (fun i => decide (Dl[i]? = W[i]?)) W V hlW hlV
    have eD : Dl = TermTear.mixU usS (fun i => decide (Dl[i]? = x.2.2.2.1[i]?)) x.2.2.2.1
        (TermTear.mixU usS (fun i => decide (Dl[i]? = W[i]?)) W V) := by
      apply List.ext_getElem?
      intro o
      by_cases ho : o < nWords usS
      · rw [TermTear.mixU_getElem usS _ _ _ o o hwl hlM2 (hIo o ho),
          TermTear.mixU_getElem usS _ _ _ o o hlW hlV (hIo o ho)]
        by_cases h1 : Dl[o]? = x.2.2.2.1[o]?
        · simp only [h1, decide_true, ite_true]
        · simp only [h1, decide_false, Bool.false_eq_true, ite_false]
          by_cases h2 : Dl[o]? = W[o]?
          · simp only [h2, decide_true, ite_true]
          · simp only [h2, decide_false, Bool.false_eq_true, ite_false]
            rw [hDget o ho] at h1 h2 ⊢
            cases hK : x.2.2.2.2.2 o
            · simp only [hK, Bool.false_eq_true, ite_false] at h1; exact (h1 trivial).elim
            · simp only [hK, ite_true] at h1 h2 ⊢
              rcases halt o ho with e | ⟨-, e⟩ | ⟨-, e⟩
              · exact absurd (e.trans (hKP o o hK (hIo o ho)).symm) h1
              · exact absurd (e.trans (hWget o ho).symm) h2
              · exact e.trans (hVget o ho).symm
      · rw [List.getElem?_eq_none (by omega), List.getElem?_eq_none (by
          rw [TermTear.length_mixU usS _ _ _ hwl hlM2]; omega)]
    have hVD : Valid x.2.2.1 Dl := by
      rw [eD]
      exact TermTear.Valid_mix husS hvr.2 (TermTear.Valid_mix husS hVW hVV hlW hlV) hwl hlM2
    -- the facts at a good word
    have hG1 : ∀ o, Good (crPatchAt b x, Rd, Cd) o → x.2.1 ≤ o ∧ o - x.2.1 < nWords usS ∧
        x.2.2.2.2.2 (o - x.2.1) = true ∧ o - b = x.2.1 - b + (o - x.2.1) ∧
        ∃ th0 tw m w, F[o - b]? = some th0 ∧ th0 < tw ∧ LowOwn s2 ⟨lab, o⟩ tw ∧ WinGU E s2 lab o tw ∧
          s.mem[th0]? = some m ∧ m.loc = ⟨lab, o⟩ ∧ s2.vs.coh ⟨lab, o⟩ = th0 ∧
          Dl[o - x.2.1]? = some w ∧ WLe1 w (mw m) := by
      rintro o ⟨i, hi, hbo, ⟨hq, i', hI', hK'⟩, hfst, hnL, hlt, hA, th0, tw, hF0, htw, hlw, hwn⟩
      change x.2.1 - b ≤ o - b at hq
      change InAcc ((accs x.2.2.1).getD []) i' (o - b - (x.2.1 - b)) at hI'
      rw [husS, Option.getD_some] at hI'
      have e1 : o - b - (x.2.1 - b) = o - x.2.1 := by omega
      rw [e1] at hI'
      have ei := inAcc_ones_eq hone' hI'
      have hon : o - x.2.1 < nWords usS := Nat.lt_of_lt_of_le hI'.2 (TermTear.nWords_take_le _ _)
      rw [← ei] at hK'
      have e2 : o - b = x.2.1 - b + (o - x.2.1) := by omega
      obtain ⟨-, -, m, w, hm, hw, hl, hle, -, hc⟩ := hFj (o - b) th0 hF0
      have e3 : (⟨lab, b + (o - b)⟩ : Address) = ⟨lab, o⟩ := by rw [Nat.add_sub_cancel' hbo]
      rw [e3] at hl hc
      have hK2 : x.2.2.2.2.2 (o - x.2.1) = true := hK'
      refine ⟨by omega, hon, hK', e2, th0, tw, m, w, hF0, htw, hlw, hwn, hm, hl, hc, ?_, hle⟩
      have hfc := hfirst i _ hi (o - x.2.1) (by show o - x.2.1 < nWords (crPatchAt b x).us; rw [eus]; exact hon)
        (by
          intro j e hj he hc'
          apply hfst j e hj he
          have e7 : (crPatchAt b x, Rd, Cd).1.q + (o - x.2.1) = o - b := by
            show x.2.1 - b + (o - x.2.1) = o - b; omega
          rw [e7] at hc'; exact hc')
        (by show x.2.1 - b + (o - x.2.1) ∉ L; rw [← e2]; exact hnL)
        (by show x.2.1 - b + (o - x.2.1) < nWords us; rw [← e2]; exact hlt)
      change Cd[o - x.2.1]? = if A (x.2.1 - b + (o - x.2.1)) then vq[x.2.1 - b + (o - x.2.1)]?
        else wsn[x.2.1 - b + (o - x.2.1)]? at hfc
      rw [← e2, hA] at hfc
      simp only [Bool.false_eq_true, ite_false] at hfc
      rw [hDget _ hon, hK2]; simp only [ite_true]; rw [hfc, hw]
    -- bump the leftover's mix to the fulfilled messages at the good words
    let tgt : Nat → Word := fun o' =>
      ((s.mem[(F[x.2.1 - b + o']?).getD 0]?).map mw).getD (mw ⟨⟨lab, 0⟩, .undef, 0⟩)
    have hbump : ∀ o' v, Dl[o']? = some v → Good (crPatchAt b x, Rd, Cd) (x.2.1 + o') → WLe1 v (tgt o') := by
      intro o' v hv hg
      obtain ⟨-, -, -, e2, th0, tw, m, w, hF0, -, -, -, hm, -, -, hw, hle⟩ := hG1 _ hg
      have e4 : x.2.1 + o' - x.2.1 = o' := by omega
      rw [e4] at hw e2
      rw [hv] at hw; cases hw
      have e5 : x.2.1 - b + o' = x.2.1 + o' - b := by omega
      show WLe1 v (((s.mem[(F[x.2.1 - b + o']?).getD 0]?).map mw).getD _)
      rw [e5, hF0, Option.getD_some, hm, Option.map_some, Option.getD_some]
      exact hle
    obtain ⟨ws1, hl1, hv1, hV1, hp1⟩ := bump_sel hvD hVD (fun o' => Good (crPatchAt b x, Rd, Cd) (x.2.1 + o'))
      tgt hbump
    rw [hlD] at hl1
    have hk : CrKeysP Rd := fun l => TermBlkZ.VRR_own_zero l x.2.2.1 [] (CE E.unsee) (fun _ => 0) (shp x.2.2.1) _ Rd
      (noOwn_AtOff hatS hnoT) (fun _ _ _ _ h => False.elim h) (fun _ _ _ _ h => False.elim h) hv1
    -- the pins at the good words
    have hKP' : ∀ o, Good (crPatchAt b x, Rd, Cd) o →
        kPinU E s2 lab x.2.1 usS ws1 x.2.2.2.2.2 (o - x.2.1) = true ∧ x.2.1 ≤ o ∧
          InAcc usS (o - x.2.1) (o - x.2.1) := by
      intro o hg
      obtain ⟨hqo, hon, hK', -, th0, tw, m, w, hF0, htw, hlw, hwn, hm, hl, hc, -, -⟩ := hG1 o hg
      refine ⟨kPinU_iff.2 ⟨hK', fun o'' hI'' => ?_⟩, hqo, hIo _ hon⟩
      have e := inAcc_ones_eq hone' hI''
      subst e
      have e6 : x.2.1 + (o - x.2.1) = o := by omega
      rw [e6]
      refine ⟨tw, hlw, hwn, fun w' hw' => ?_⟩
      have hg' : Good (crPatchAt b x, Rd, Cd) (x.2.1 + (o - x.2.1)) := by rw [e6]; exact hg
      have ew := (hp1 _ w' hw').1 hg'
      have e5 : x.2.1 - b + (o - x.2.1) = o - b := by omega
      have et : tgt (o - x.2.1) = mw m := by
        show ((s.mem[(F[x.2.1 - b + (o - x.2.1)]?).getD 0]?).map mw).getD _ = mw m
        rw [e5, hF0, Option.getD_some, hm, Option.map_some, Option.getD_some]
      rw [ew, et]
      exact predAt_of_winGU hc htw (by rw [hmem2]; exact hm) hl hlw hwn
    -- the item
    have hpos := (hG1 o0 hg0).2.1
    have hP : Piece c.ty x.2.1 x.2.2.1 := ⟨hatS, hsol, by rw [hwS]; intro h; injection h with h; omega⟩
    have hel : mh.loc = ⟨lab, mh.loc.offset⟩ := by rw [← hlab]
    have hnw := nword_piece hsto hP husS hq1 hq2 (by rw [← hel]; exact hnwx)
    obtain ⟨t, hRt⟩ := repin_itemU (K := x.2.2.2.2.2) hsto hown (by rw [hf]; simp) hlay hP husS hnw hl1
      ⟨hv1, hV1⟩ hk (hKP' o0 hg0).2.2 (hKP' o0 hg0).1
    exact ⟨_, rfl, hRt, rfl, fun o hg => kPinU_cov husS (hKP' o hg).1 (hKP' o hg).2.1 (hKP' o hg).2.2⟩
  obtain ⟨RS, hRS1, hRS2, hRS3⟩ := pick_list Q (fun d => d.2.1) (fun y => y.2.2.2.2.2.2.1)
    (fun d y hq => by rw [hq.2.2.1]; exact Res.le_refl _) Ds
  refine ⟨RS, fun y hy => ?_, hRS3, ?_⟩
  · obtain ⟨d, -, hq⟩ := hRS1 y hy
    exact ⟨hq.2.1, hq.1⟩
  intro o th0 tw hb1 hb2 hnv hlo hth hlw hov hwn
  have hj : o - b < nWords us := by omega
  have eo : (⟨lab, b + (o - b)⟩ : Address) = ⟨lab, o⟩ := by rw [Nat.add_sub_cancel' hb1]
  obtain ⟨t0, hF0⟩ : ∃ t0, F[o - b]? = some t0 := ⟨_, List.getElem?_eq_getElem (by rw [hFl]; exact hj)⟩
  have hl0 := hlow _ t0 hF0
  rw [eo] at hl0
  obtain rfl := LowOwn_uniq hl0 hlo
  have hlwc := hlw
  obtain ⟨htw2, ⟨mt, hmt, hlt⟩, -⟩ := hlw
  have hlt0 : t0 < tw := Nat.lt_of_le_of_ne
    (hlo.2.2 tw mt (hsub2 tw htw2) (by rw [← hmem2]; exact hmt) hlt) (fun e => hth (e ▸ htw2))
  have hnv' : ¬ VisU E ⟨lab, b + (o - b)⟩ := by rw [eo]; exact hnv
  have hOv : OverT E s ⟨lab, b + (o - b)⟩ t0 := by
    obtain ⟨t, mm, h1, h2, h3, h4⟩ := hov
    rw [hmem2] at h2
    refine ⟨t, mm, Nat.lt_trans hlt0 h1, h2, by rw [eo]; exact h3, fun hin => h4 ?_⟩
    have key := (hQ' _ t0 hnv' hF0 t mm h2 (by rw [eo]; exact h3)).2 ⟨hin, fun e => by
      subst e; exact absurd h1 (Nat.not_lt.mpr (Nat.le_of_lt hlt0))⟩
    rw [eo] at key; exact key
  have hA : A (o - b) = false := by
    cases hAj : A (o - b)
    · rfl
    · exact absurd hOv (((hAdef _).1 hAj).2 t0 hF0)
  have hnL : o - b ∉ L := fun h => hnv' ((hLmem _).1 h).2
  obtain ⟨g, hg, hcg⟩ := hcov _ hj hA hnL
  rw [← hDs] at hg
  obtain ⟨d0, hd0, rfl⟩ := List.mem_map.1 hg
  obtain ⟨i1, hi1⟩ := List.mem_iff_getElem?.1 hd0
  obtain ⟨i0, ⟨d, hdi, hdc⟩, hmin⟩ := exists_minN (P := fun i => ∃ d, Ds[i]? = some d ∧ d.1.Cov (o - b)) i1
    ⟨d0, hi1, hcg⟩
  have hgood : Good d o := ⟨i0, hdi, hb1, hdc, fun j e hj' he hc => absurd (hmin j ⟨e, he, hc⟩) (Nat.not_le.mpr hj'),
    hnL, hj, hA, t0, tw, hF0, hlt0, hlwc, hwn⟩
  have hd : d ∈ Ds := List.mem_of_getElem? hdi
  obtain ⟨y, hy, hq⟩ := hRS2 d hd (hmk d hd o hgood)
  exact ⟨y, hy, hq.1, hq.2.2.2 o hgood⟩
#print axioms TermPlant.repin_fromDs

