/-- (OvW3 R2b) `mc_ofFulSQX` at re-pin items `RS`: the witness predicate and the extra cost
depend on `RS`, which the conclusion exhibits. -/
theorem mc_ofFulSQR {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem mem' : Memory} {pairs pairs' : List Ts}
    {th th' : TTh} {η : TEnv} {Tot H' Rf Rs H : Res} {cr db : Ts → Res} {F : List Ts}
    {RS : List (AllocLabel × Cell × CrIt)} {Q : List (AllocLabel × Cell × CrIt) → TEnv → Prop}
    (hq : Q RS (CE η))
    (hC : PromCrP (CE η) (stOf mem pairs th) cr db)
    (hT : ThInvRE p (CE η) th' Tot) (hm' : MemInv g (CE η) (stOf mem' pairs' th'))
    (hH' : MemHeldK (CE η) (stOf mem pairs th) Sp (CE η) (stOf mem' pairs' th') H') (hmem : mem' = mem)
    (hsplit : ∀ f : Ts → Res, Res.sum (th.promises.map f) = Res.sum (th'.promises.map f) + Res.sum (F.map f))
    (hsub : ∀ t, t ∈ th'.promises → t ∈ th.promises)
    (hle : Tot + H' + Res.sum (F.map db) + Res.sum (RS.map fun y => y.2.2.2.2.2.2.1) ≤
      Rf + Rs + H + Res.sum (F.map cr)) :
    ∃ Tot H' C F, ∃ RS' : List (AllocLabel × Cell × CrIt),
      ThInvMCFSQ (Q RS') p g (CE η) (stOf mem pairs th) Sp mem' pairs' th' Tot H'
        (dropP (CE η) (stOf mem pairs th) cr) db ∧
      MintStepN g η (stOf mem pairs th) (stOf mem' pairs' th') C F ∧
      Tot + H' + pSum (stOf mem' pairs' th') cr + pSum (stOf mem pairs th) db + C +
          Res.sum (RS'.map fun y => y.2.2.2.2.2.2.1) ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf mem' pairs' th') db + F := by
  obtain ⟨Tot2, H2, C, F2, h1, h2, h3⟩ := mc_ofFulSQX (Q := Q RS)
    (X := Res.sum (RS.map fun y => y.2.2.2.2.2.2.1)) hq hC hT hm' hH' hmem hsplit hsub hle
  exact ⟨Tot2, H2, C, F2, RS, h1, h2, h3⟩
