/-- (H, pins) Rechoosing label `l`'s list keeps every untouched predicted slot when the
changed slots are real (below `rc`). -/
theorem SKeepT_setLab {E : TEnv} {s s' : St} {S : AllocLabel → List Res} {l : AllocLabel} {Rs' : List Res}
    (h : ∀ c, E.sto l = some c → ∀ j, Rs'[j]? ≠ (S l)[j]? → ∀ N e us', c.ty = .array (.lit N) e →
      accs e = some us' → j < E.rc l) :
    SKeepT E s s' S (updS S l Rs') := by
  intro l' c N e us j R hc hT hu hP _ hR
  by_cases hl : l' = l
  · subst hl
    rw [updS_self]
    by_cases he : Rs'[j]? = (S l')[j]?
    · rw [he]; exact hR
    · have hj := h c hc j he N e us hT hu
      obtain ⟨-, hiw, hnr⟩ := hP
      have hw : 0 < nWords us := by
        have := (IniW_cell hc hT hu).mp hiw
        rcases Nat.eq_zero_or_pos (nWords us) with h0 | h0
        · rw [h0, Nat.mul_zero] at this; exact absurd this (Nat.not_lt_zero _)
        · exact h0
      exact absurd ((IniWr_cell hc hT hu).mpr (Nat.mul_lt_mul_of_pos_right hj hw)) hnr
  · rw [updS_other S Rs' hl]; exact hR
#print axioms SKeepT_setLab

theorem mc_ofFulS {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem mem' : Memory} {pairs pairs' : List Ts} {th th' : TTh}
    {η : TEnv} {Tot H' Rf Rs H : Res} {cr db : Ts → Res} {F : List Ts}
    (hC : PromCrP (CE η) (stOf mem pairs th) cr db)
    (hT : ThInvRE p (CE η) th' Tot) (hm' : MemInv g (CE η) (stOf mem' pairs' th'))
    (hH' : MemHeldK (CE η) (stOf mem pairs th) Sp (CE η) (stOf mem' pairs' th') H') (hmem : mem' = mem)
    (hsplit : ∀ f : Ts → Res, Res.sum (th.promises.map f) = Res.sum (th'.promises.map f) + Res.sum (F.map f))
    (hsub : ∀ t, t ∈ th'.promises → t ∈ th.promises)
    (hle : Tot + H' + Res.sum (F.map db) ≤ Rf + Rs + H + Res.sum (F.map cr)) :
    ∃ Tot H' C F, ThInvMCFS p g (CE η) (stOf mem pairs th) Sp mem' pairs' th' Tot H' (dropP (CE η) (stOf mem pairs th) cr) db ∧
      MintStepN g η (stOf mem pairs th) (stOf mem' pairs' th') C F ∧
      Tot + H' + pSum (stOf mem' pairs' th') (dropP (CE η) (stOf mem pairs th) cr) + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf mem' pairs' th') db + F := by
  subst mem'
  have hC0 := PromCrP_drop hC
  have hC' : PromCr (CE η) (stOf mem pairs' th') (dropP (CE η) (stOf mem pairs th) cr) db :=
    fun tw htw => hC0 tw (hsub tw htw)
  refine ⟨Tot, H', .zero, .zero, ⟨CE η, EFoot_refl, (by seenT), (by boxT), hT, hm', hH', hC'⟩, .none, ?_⟩
  have e1 := hsplit cr
  have e2 := hsplit db
  have h3 : pSum (stOf mem pairs' th') (dropP (CE η) (stOf mem pairs th) cr) ≤ pSum (stOf mem pairs' th') cr :=
    pSum_dropP_le
  intro k
  have h1 := hle k
  have h4 := h3 k
  have e1k := congrArg (fun R : Res => R k) e1
  have e2k := congrArg (fun R : Res => R k) e2
  simp only [pSum, stOf, Res.add_apply, Res.zero_apply] at h1 h4 e1k e2k ⊢
  omega
#print axioms mc_ofFulS

