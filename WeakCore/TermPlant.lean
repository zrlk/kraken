  have hent0 := hentL0.entry
  obtain ⟨hTc, hoff⟩ := bufCell hent0 hsto hat hini
  obtain ⟨A, hA⟩ : ∃ A, offs ad (ev ρ j * nWords us) = A := ⟨_, rfl⟩
