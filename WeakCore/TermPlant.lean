/-- (OvW3 R2b) `tstepMCF_xchgOwnFL` with **re-pin items**: the step's state change pays for
re-pin items `RS` (`cellAcctD`, `repin_fromDs`), concluding in `stepOut_ofFSAR`'s premise shape. -/
theorem tstepMCF_xchgOwnFLD {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {a v : At} {u : Ty} {e : Expr} {Rf Rs H : Res}
    {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.xchg a v) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.ptr .own u))
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    {Sp : AllocLabel → List Res} (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCrP (CE η) (stOf mem pairs th) cr db)
    (hfr : ∀ lab ru pw, evalAt th.env a = some (.ptr .own ru, [pw]) → pw.val = .loc ⟨lab, 0⟩ 0 →
      (CE η).pfr lab ≠ none)
    {Ok : Memory × List Ts × TTh → Prop}
    (hpo : ∀ lab c, (CE η).sto lab = some c → c.owner = some (CE η).tid → (CE η).pfr lab ≠ none → OpTgt th lab →
      PlantOp g mem pairs th (CE η) cr Ok lab c)
    (hniX : OpNI cx th)
    (hclo : ∀ lab c, (CE η).sto lab = some c → Clo c.ty) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hDy : DyFr p annNew (progTgts p) η th.σs th.term) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → r.1 = mem → Ok r →
      ∃ Tot H' C F, ∃ RS : List (AllocLabel × Cell × CrIt),
        ThInvMCFSQ (fun E' => BiOut th E' ∧ (∀ y ∈ RS, RepinItU E' (stOf r.1 r.2.1 r.2.2) y) ∧
            RepinCovU (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th RS ∧
            FulP (CE η) (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th ∧
            RcKeepP (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th)
          p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' (dropP (CE η) (stOf mem pairs th) cr) db ∧
        MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
        Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C +
            Res.sum (RS.map fun y => y.2.2.2.2.2.2.1) ≤
          Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F :=
  tstepMCF_xchgOwnFLDC (hDy := hDy) (cr₁ := cr) (hle := fun _ _ _ _ _ _ _ _ _ => Res.le_refl _) hterm hP hpk hT hCk hi hE htv hm hH hC hfr hpo hniX hclo hRP hPS
#print axioms TermPlant.tstepMCF_xchgOwnFLD

/-- (H, pins) **The slot-level paid fulfil of a predicted slot**, against the slot lists `S`:
at the own buffer `l` with element `e` of positive width, for any stored value `ws` holding
`Rv`, the slot at `rc` holding `Rj := (S l)[rc]` along its latest words `wq`, and its first
writes `F` (unit by unit, with `ws`'s values), there is a new share `Rj'` of `wq` such that the
fulfilled debits plus `Rj'` are at most `Rj + Rv` plus their credits. -/
def SlotPayS (E : TEnv) (s : St) (S : AllocLabel → List Res) (cr db : Ts → Res) (l : AllocLabel) : Prop :=
  ∀ c N e us (F : List Ts) (ws wq : List Word) (Rv Rj : Res),
    E.sto l = some c → c.ty = .array (.lit N) e → accs e = some us → 0 < nWords us →
    F.length = nWords us → ws.length = nWords us → wq.length = nWords us →
    ValOfR E e ws Rv →
    (S l)[E.rc l]? = some Rj → ValOfR E e wq Rj →
    (∀ o w, wq[o]? = some w →
      LatestNP s.mem (PromAt E s ⟨l, E.rc l * nWords us + o⟩) ⟨l, E.rc l * nWords us + o⟩ w) →
    (∀ o t, F[o]? = some t → t ∈ s.promises ∧ ∃ m x, s.mem[t]? = some m ∧ ws[o]? = some x ∧
      m.loc = ⟨l, E.rc l * nWords us + o⟩ ∧ m.val = x.val ∧ WLe1 x (mw m) ∧ FirstW s.mem m.loc t) →
    ∃ Rj', ValOfR E e wq Rj' ∧ Rj' + Res.sum (F.map db) ≤ Rj + Rv + Res.sum (F.map cr)

/-- (BI) `SlotPayS` is monotone in the credit. -/
theorem slotPayS_mono {E : TEnv} {s : St} {S : AllocLabel → List Res} {cr cr2 db : Ts → Res} {l : AllocLabel}
    (hle : ∀ t, cr t ≤ cr2 t) (h : SlotPayS E s S cr db l) : SlotPayS E s S cr2 db l := by
  intro c N e us F ws wq Rv Rj h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 h12
  obtain ⟨Rj', hv, hb⟩ := h c N e us F ws wq Rv Rj h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 h12
  refine ⟨Rj', hv, fun k => ?_⟩
  have h2k := sum_le_of F (fun t _ => hle t) k
  have hbk := hb k
  simp only [Res.add_apply] at hbk ⊢
  omega
#print axioms TermPlant.slotPayS_mono

/-- (BI) **The `bufInit`-at-`rc` slot facts** (the last conjunct of the `…C` steppers' outputs): at a
frontier `bufInit` at its buffer's real count, the step only bumps the real count past the slot, and
each promise it discharges is the first write of a slot unit, now coherence-latest there. -/
def BiRcOut (E E' : TEnv) (s s' : St) (th : TTh) : Prop :=
  ∀ x b i v e rt w ad rti wi, th.term = .let_ x (.bufInit b i v) e → evalAt th.env b = some (rt, [w]) →
    w.val = .loc ad 0 → evalAt th.env i = some (rti, [wi]) → numOf [wi] = some (E.rc ad.label) →
    E.pfr ad.label ≠ none →
    E' = { E with rini := bumpIni E.rini ad.label (E.rc ad.label + 1) } ∧ E.rc ad.label < E.ini ad.label ∧
    ∃ c N el us, E.sto ad.label = some c ∧ c.owner = some E.tid ∧ c.ty = .array (.lit N) el ∧
      accs el = some us ∧ s'.mem = s.mem ∧ (∀ u, u ∈ us → u = .one) ∧
      (∀ t, t ∈ s'.promises → t ∈ s.promises) ∧
      ∀ t m, t ∈ s.promises → t ∉ s'.promises → s.mem[t]? = some m →
        m.loc.label = ad.label ∧ E.rc ad.label * nWords us ≤ m.loc.offset ∧
        m.loc.offset < E.rc ad.label * nWords us + nWords us ∧ FirstW s.mem m.loc t ∧ s'.vs.coh m.loc = t

set_option maxHeartbeats 3200000 in
/-- (CRC) `tstepMCF_bufInitPL` with the plant items (`PlantOp`/`CrItem`) at a separate credit `cr₁`, below `cr` at the promises the step discharges. -/
theorem tstepMCF_bufInitPLC {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {b i v : At} {e : Expr} {Rf Rs H : Res}
    {cr db cr₁ : Ts → Res}
    (hterm : th.term = .let_ x (.bufInit b i v) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    {Sp : AllocLabel → List Res} (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCrP (CE η) (stOf mem pairs th) cr db)
    (hfr : ∀ rt w ad, evalAt th.env b = some (rt, [w]) → w.val = .loc ad 0 → (CE η).pfr ad.label ≠ none)
    (hjr : ∀ rt w ad rti wi n, evalAt th.env b = some (rt, [w]) → w.val = .loc ad 0 →
      evalAt th.env i = some (rti, [wi]) → numOf [wi] = some n →
      (CE η).rc ad.label ≤ n)
    (hb1 : ∀ rt w ad rti wi n, evalAt th.env b = some (rt, [w]) → w.val = .loc ad 0 →
      evalAt th.env i = some (rti, [wi]) → numOf [wi] = some n →
      (CE η).rc ad.label ≤ n → n < (CE η).ini ad.label)
    {Ok : Memory × List Ts × TTh → Prop}
    (hpo : ∀ lab c, (CE η).sto lab = some c → c.owner = some (CE η).tid → (CE η).pfr lab ≠ none → OpTgt th lab →
      PlantOp g mem pairs th (CE η) cr₁ Ok lab c)
    (hbh : ∀ rt w ad, evalAt th.env b = some (rt, [w]) → w.val = .loc ad 0 →
      ∀ o, PredU (CE η) ⟨ad.label, o⟩ → ∃ h, FirstW (stOf mem pairs th).mem ⟨ad.label, o⟩ h ∧
      h ∈ (stOf mem pairs th).promises ∧ ∀ t m, t ∈ (stOf mem pairs th).promises →
        (stOf mem pairs th).mem[t]? = some m → m.loc = ⟨ad.label, o⟩ →
        (stOf mem pairs th).vs.coh ⟨ad.label, o⟩ < t → h ≤ t)
    (hpay : ∀ rt w ad, evalAt th.env b = some (rt, [w]) → w.val = .loc ad 0 →
      SlotPayS (CE η) (stOf mem pairs th) Sp cr db ad.label)
    (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hZ : ZOK g (CE η) th := by exact fun _ _ h => False.elim h) (hDy : DyFr p annNew (progTgts p) η th.σs th.term) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → r.1 = mem → Ok r →
      FulP (CE η) (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th ∧
      ∃ Tot H' C F, ThInvMCFSQ (fun E' => BiOut th E' ∧
          RcKeepP (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th ∧
          BiRcOut (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th) p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H'
          (dropP (CE η) (stOf mem pairs th) cr) db ∧
        MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
        Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr +
            pSum (stOf mem pairs th) db + C ≤
          Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | bufInit hu hbuf hint heq hlt hu2 hsub hb =>
  obtain ⟨t, tv, u, n, k, j, c₁, c₂, hu, hbuf, hint, heq, hlt, hu2, hsub, hb⟩ : ∃ t tv u n k j c₁ c₂,
      cx.use b = .ok (t, c₁) ∧ bufOf t = some (.own, n, u, k) ∧ IntIdx c₁ i j ∧ EqI c₁ j k ∧
      LtI c₁ k n ∧ c₁.use v = .ok (tv, c₂) ∧ SubS c₂ tv u ∧
      c₂.bind x (.refine (.loc .own (.array n u)) (.ini (.add k (.lit 1)))) = .ok c' :=
    ⟨_, _, _, _, _, _, _, _, hu, hbuf, hint, heq, hlt, hu2, hsub, hb⟩
  have ht : t = .refine (.loc .own (.array n u)) (.ini k) := by
    unfold bufOf at hbuf; split at hbuf
    · simp only [Option.some.injEq, Prod.mk.injEq] at hbuf
      obtain ⟨h1, rfl, rfl, rfl⟩ := hbuf; subst h1; rfl
    · simp at hbuf
  subst ht
  have htu := use_TvOK hu htv
  obtain ⟨rb, wsb, Rb, Rr1, hea, hvb, hlb, hvrb, hi1, hle1⟩ := useR hu hi hE.2.2
  have hRb := VRR_buf_R hbuf hvrb
  obtain ⟨rv, wsv, Rv, Rr2, hev, hvv, hlv, hvrv, hi2, hle2⟩ := useR hu2 hi1 hE.2.2
  have hJK : ev ρ j = ev ρ k := heq ρ hi1.1.1
  have hKN : ev ρ k < ev ρ n := hlt ρ hi1.1.1
  obtain ⟨ti, hpi, hti⟩ := hint
  obtain ⟨rti, wsi, hei, hvi, -⟩ := peek_VR hi1.1.2.1 hpi
  obtain ⟨wi, rfl, hwi⟩ := map_singleton (VR_intS hti hvi)
  have hvb0 := hvb
  simp only [VR] at hvb
  obtain ⟨hv, hir⟩ := hvb
  rcases hv with ⟨-, e0, he0⟩ | ⟨ad, c, U, hws, hsto, hat0, hFU, hown, hini0⟩
  · have he0 := Fd_nonmu he0 (fun b => by simp [cl])
    simp only [cl, clI_zero, Ty.array.injEq, Idx.lit.injEq] at he0
    omega
  obtain rfl := Fd_nonmu hFU (fun b => by simp [cl])
  obtain ⟨w, rfl, hwv⟩ := map_singleton hws
  have hni : numOf [wi] = some (ev ρ j) := by simp [numOf, hwi]
  have hjr1 : η.rc ad.label ≤ ev ρ j := hjr rb w ad rti wi (ev ρ j) hea hwv hei hni
  have hKm : ev ρ k ≤ η.rc ad.label := by
    simp only [IniR] at hir; have h := hir ad (by simp [hwv]); rw [TEnv.selIni_loc] at h; exact h
  have hjrc : ev ρ j = η.rc ad.label := by omega
  have hjI : ev ρ j < η.ini ad.label := hb1 rb w ad rti wi (ev ρ j) hea hwv hei hni (by show η.rc ad.label ≤ ev ρ j; omega)
  have hjrc' : ev ρ j = min (η.ini ad.label) (η.rini ad.label) := hjrc
  have hjI' : ev ρ j < η.ini ad.label := hjI
  have hat := hat0
  have hini := hini0
  simp only [cl, clI_zero] at hat hini
  have hs' : etok (skel rb) = rf (.loc (skelM .own) (.array (.lit 0) (etok (skel (close th.σs u))))) := by
    rw [hlb.2.1]; rfl
  obtain ⟨μr, nr, ur, ψ, rfl, -, hsu⟩ := buf_runtime' hs'
  have htb1 : tb c₁.ke.length u = true := by
    have h := htu.2.1
    rw [← htu.2.2] at h
