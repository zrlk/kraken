theorem VR_ones_nundef : ∀ (T : Ty) {ρ : Nat → Nat} {η : TEnv} {ws : List Word} {us : List Acc},
    VR ρ η T (shp T) ws → accs T = some us → (∀ u, u ∈ us → u = .one) →
    ∀ j w, j < nWords us → ws[j]? = some w → w.val ≠ .undef := by
  intro T
  induction T with
  | prod a b iha ihb =>
      intro ρ η ws us hv hus h1 j w hj hw
      simp only [VR, shp] at hv
      obtain ⟨ra, rb, e, hsp⟩ := hv
      simp only [Shp.prod.injEq] at e
      obtain ⟨rfl, rfl⟩ := e
      cases ha : accs a with
      | none => simp [accs, ha] at hus
      | some ua =>
      cases hb : accs b with
      | none => simp [accs, ha, hb] at hus
      | some ub =>
      simp [accs, ha, hb] at hus
      subst hus
      obtain ⟨-, hva, hvb⟩ := hsp (nWords ua) (by rw [shp_wc]; simp [wc, ha])
      have hn : nWords (ua ++ ub) = nWords ua + nWords ub := by simp [nWords]
      by_cases hl : j < nWords ua
      · exact iha hva ha (fun u hu => h1 u (List.mem_append_left _ hu)) j w hl
          (by rw [List.getElem?_take_of_lt hl]; exact hw)
      · exact ihb hvb hb (fun u hu => h1 u (List.mem_append_right _ hu)) (j - nWords ua) w (by omega)
          (by rw [List.getElem?_drop, Nat.add_sub_cancel' (by omega)]; exact hw)
  | refine t _ ih =>
      intro ρ η ws us hv hus h1
      simp only [VR, shp] at hv
      simp only [accs] at hus
      exact ih hv.1 hus h1
  | mu t ih =>
      intro ρ η ws us hv hus h1
      simp only [VR, shp] at hv
      simp only [accs] at hus
      exact ih hv hus h1
  | iall t ih =>
      intro ρ η ws us hv hus h1
      simp only [VR, shp] at hv
      simp only [accs] at hus
      exact ih (hv 0) hus h1
  | iex t ih =>
      intro ρ η ws us hv hus h1 j w hj hw
      by_cases e1 : us = [.one]
      · subst e1
        obtain rfl : j = 0 := by simp [nWords, Acc.size] at hj; omega
        exact VR_word1_nundef _ hv hus hw
      simp only [VR, shp] at hv
      obtain ⟨n, rb, w', e, hv⟩ := hv
      simp only [Shp.iex.injEq] at e
      obtain ⟨-, rfl⟩ := e
      have hus' : accs t = some us := by
        simp only [accs] at hus
        split at hus
        · split at hus
          · cases hus; simp [nWords] at hj
          · cases hus; exact absurd rfl e1
          · cases hus; exact absurd (h1 .two (by simp)) (by simp)
          · exact hus
        · exact hus
      exact ih hv hus' h1 j w hj hw
  | tex κ t ih =>
      intro ρ η ws us hv hus h1 j w hj hw
      by_cases e1 : us = [.one]
      · subst e1
        obtain rfl : j = 0 := by simp [nWords, Acc.size] at hj; omega
        exact VR_word1_nundef _ hv hus hw
      simp only [VR, shp] at hv
      obtain ⟨n, rb, s, e, -, -, hv⟩ := hv
      simp only [Shp.tex.injEq] at e
      obtain ⟨-, rfl⟩ := e
      have hus' : accs t = some us := by
        simp only [accs] at hus
        split at hus
        · split at hus
          · cases hus; simp [nWords] at hj
          · cases hus; exact absurd rfl e1
          · cases hus; exact absurd (h1 .two (by simp)) (by simp)
          · exact hus
        · exact hus
      exact ih hv hus' h1 j w hj hw
  | _ =>
      intro ρ η ws us hv hus h1 j w hj hw
      by_cases e1 : us = [.one]
      · subst e1
        obtain rfl : j = 0 := by simp [nWords, Acc.size] at hj; omega
        exact VR_word1_nundef _ hv hus hw
      · exfalso
        have h3 : us = [] ∨ us = [.two] ∨ us = [.one] := by
          simp only [accs] at hus
          first
            | (split at hus <;> (cases hus; simp))
            | (cases hus; simp)
            | simp at hus
        rcases h3 with rfl | rfl | rfl
        · simp [nWords] at hj
        · exact absurd (h1 .two (by simp)) (by simp)
        · exact e1 rfl
#print axioms TermPlant.VR_ones_nundef

/-- (pool) `repinCov_tgt` for the per-unit cover. -/
theorem repinCovU_tgt {E E' : TEnv} {s s' : St} {th : TTh} {RS : List (AllocLabel × Cell × CrIt)} {q : At}
    (hq : ∀ q', opAtomP th.term = some q' → q' = q)
    (h : ∀ rt w ad off, evalAt th.env q = some (rt, [w]) → w.val = .loc ad off → E.pfr ad.label = none) :
    RepinCovU E E' s s' th RS := by
  intro lab _ hot c o th0 tw _ _ hpf
  obtain ⟨q', rt, w, ad, off, hq', he, hw, rfl⟩ := hot
  obtain rfl := hq q' hq'
  exact absurd (h rt w ad off he hw) hpf
#print axioms TermPlant.repinCovU_tgt

