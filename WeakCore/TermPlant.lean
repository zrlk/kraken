            simp only [Ty.sharedOKIn, Bool.and_eq_true] at hsh; exact hsh.1.2
          have htbu : tb c₁.ke.length u = true := by
            have h := (use_TvOK hu htv).2.1
            rw [← (use_TvOK hu htv).2.2] at h
            simpa [tb] using h
