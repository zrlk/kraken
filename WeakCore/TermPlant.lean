/-- (plantFrozen) `EFoot` at `g` with ghost labels `Z` gives `EFoot` at `g` when `g` has none:
only `IniFixZ` reads the ghost labels, and it is vacuous there. -/
theorem efootDrop {g : G} {Z : AllocLabel → Prop} {E E' : TEnv} {s s' : St} (hz : ∀ l, ¬ g.zf l)
    (h : EFoot { g with zf := Z } E E' s s') : EFoot g E E' s s' := by
  obtain ⟨a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, -, a15, a16⟩ := h
  exact ⟨a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, fun l _ _ hzl => (hz l hzl).elim, a15, a16⟩
#print axioms efootDrop

/-- (plantFrozen) `MintStep` does not read the ghost labels. -/
theorem mintStepDrop {g : G} {Z : AllocLabel → Prop} {η : TEnv} {s s' : St} {C F : Res}
    (h : MintStep { g with zf := Z } η s s' C F) : MintStep g η s s' C F := by
  cases h with
  | none => exact .none
  | fresh => exact .fresh
  | alloc h1 h2 => exact .alloc h1 h2
  | consume μ ws => exact .consume μ ws
  | epoch h1 h2 h3 h4 h5 h6 h7 h8 h9 => exact .epoch h1 h2 h3 h4 h5 h6 h7 h8 h9
  | share h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 => exact .share h1 h2 h3 h4 h5 h6 h7 h8 h9 h10
  | claim n j => exact .claim n j
  | epoch2 h1 h2 h3 h4 h5 h6 h7 h8 h9 => exact .epoch2 h1 h2 h3 h4 h5 h6 h7 h8 h9
#print axioms mintStepDrop

