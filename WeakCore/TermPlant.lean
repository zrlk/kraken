/-- (U3, case b) `IniWr` at a literal-array cell, by its count. -/
theorem IniWr_cell {E : TEnv} {lab : AllocLabel} {o N : Nat} {c : Cell} {e : Ty} {us : List Acc}
    (hsto : E.sto lab = some c) (hT : c.ty = .array (.lit N) e) (hus : accs e = some us) :
    IniWr E ⟨lab, o⟩ ↔ o < E.rc lab * nWords us := by
  constructor
  · intro h; exact h c N e us hsto hT hus
  · intro h c' N' e' us' hc' hT' hu'
    have hc'' : E.sto lab = some c' := hc'
    rw [hsto] at hc''; cases hc''; rw [hT] at hT'; cases hT'; rw [hus] at hu'; cases hu'; exact h

/-- (U3, case b) `IniW` at a literal-array cell, by its count. -/
theorem IniW_cell {E : TEnv} {lab : AllocLabel} {o N : Nat} {c : Cell} {e : Ty} {us : List Acc}
    (hsto : E.sto lab = some c) (hT : c.ty = .array (.lit N) e) (hus : accs e = some us) :
    IniW E ⟨lab, o⟩ ↔ o < E.ini lab * nWords us := by
  constructor
  · intro h; exact h c N e us hsto hT hus
  · intro h c' N' e' us' hc' hT' hu'
    have hc'' : E.sto lab = some c' := hc'
    rw [hsto] at hc''; cases hc''; rw [hT] at hT'; cases hT'; rw [hus] at hu'; cases hu'; exact h

