/-! ## (pool, route B) Step level: re-pins split into credited and pool items -/

/-- (pool) `RepinQU` survives raising the credits. -/
theorem RepinQU_mono {E' : TEnv} {s' : St} {cr cr' : Ts → Res} {RS : List (AllocLabel × Cell × CrIt)}
    (hle : ∀ t, cr t ≤ cr' t) (h : RepinQU E' s' cr RS) : RepinQU E' s' cr' RS := fun y hy =>
  let ⟨a1, a2, a3, a4, a5⟩ := h y hy
  ⟨a1, a2, a3, CrItem_mono hle a4, a5⟩
#print axioms TermPlant.RepinQU_mono

/-- (pool) `PromCrK_repin` for credited items at per-unit windows (`RepinQU`). -/
theorem PromCrK_repinU {E E' : TEnv} {s s' : St} {cr db : Ts → Res} {RS : List (AllocLabel × Cell × CrIt)}
    (hC : PromCr E' s' (dropP E s cr) db) (hQ : RepinQU E' s' (rpSum RS) RS) (hP : RepinPl E' s' RS) :
    PromCrK E' s' (fun t => dropA E E' s s' cr t + rpSum RS t) db := by
  intro tw htw
  obtain ⟨m, hm, hd, hc⟩ := PromCrK_dropA hC tw htw
  refine ⟨m, hm, hd, ?_⟩
  by_cases hy : ∃ y ∈ RS, y.2.2.1 = tw
  · obtain ⟨y, hyR, rfl⟩ := hy
    obtain ⟨m1, hm1, hpl⟩ := hP y hyR
    obtain ⟨-, -, -, ⟨mh, -, hmh, -, -, hnw, -⟩, -⟩ := hQ y hyR
    rw [hm] at hm1; cases hm1
    rw [hm] at hmh; cases hmh
    have hK : CrKeys (rpSum RS y.2.2.1) := crKeys_rpSum _ (fun y' hy' => (hQ y' hy').2.2.2.2.1)
    have hge : y.2.2.2.2.2.2.1 ≤ dropA E E' s s' cr y.2.2.1 + rpSum RS y.2.2.1 :=
      Res.le_trans (rpSum_ge hyR) (fun k => by simp only [Res.add_apply]; omega)
    refine .inr ⟨hpl _ hge, ?_⟩
    show CrKeys (dropA E E' s s' cr y.2.2.1 + rpSum RS y.2.2.1)
    rcases hc with ho | ⟨-, hk⟩
    · rw [oldCr_nwordZ hnw ho, Res.zero_add]; exact hK
    · intro l; simp only [Res.add_apply, hk l, hK l]
  · have e : rpSum RS tw = .zero := rpSum_none fun y hy' e => hy ⟨y, hy', e⟩
    simp only [e, Res.add_zero]
    exact hc
#print axioms TermPlant.PromCrK_repinU

/-- (pool) **From `dropP` to `dropA` plus split re-pins** (`ThInvMCFSQ.toKAR` with `KeepQRS`):
the credited items (`HolderFp`) raise `cr'`, the pool items are carried by `plh`. -/
theorem ThInvMCFSQ.toKARS {Q0 : TEnv → Prop} {p : Prog} {g : G} {E : TEnv} {s : St} {S0 : AllocLabel → List Res}
    {mem : Memory} {pairs : List Ts} {th : TTh} {Tot H : Res} {cr db : Ts → Res} {th0 : TTh}
    {RS : List (AllocLabel × Cell × CrIt)}
    (h : ThInvMCFSQ (fun E' => Q0 E' ∧ (∀ y ∈ RS, RepinItU E' (stOf mem pairs th) y) ∧
      RepinCovU E E' s (stOf mem pairs th) th0 RS ∧ FulP E s (stOf mem pairs th) th0 ∧
      RcKeepP E E' s (stOf mem pairs th) th0) p g E s S0 mem pairs th Tot H
      (dropP E s cr) db)
    (hsub : ∀ t, t ∈ th.promises → t ∈ s.promises) (hnp : ∀ x a e, th0.term ≠ .let_ x (.publish a) e) :
    ∃ cr' plh, ThInvMCFSQK (fun E' => Q0 E' ∧ KeepQRS E E' s (stOf mem pairs th) th0 cr cr' plh) p g E s S0
        mem pairs th Tot H cr' db ∧
      pSum (stOf mem pairs th) cr' + pSum (stOf mem pairs th) plh + pSum s (dropP E s cr) ≤
        pSum (stOf mem pairs th) (dropP E s cr) + pSum s cr + Res.sum (RS.map fun y => y.2.2.2.2.2.2.1) ∧
      pSum (stOf mem pairs th) cr' + pSum (stOf mem pairs th) plh ≤
        pSum (stOf mem pairs th) cr + Res.sum (RS.map fun y => y.2.2.2.2.2.2.1) := by
  obtain ⟨E', ⟨hq, hRI, hRC, hFP, hRK⟩, h0, h1, h2, h3, hm', h5, hC⟩ := h
  obtain ⟨hQc, hPc, hFc, hQh, hFh, hmem⟩ := repin_splitU hRI
  have hnd := MemInv_nodup hm'
  have e := sum_map_split
    (f := fun t => dropA E E' s (stOf mem pairs th) cr t + rpSum (rpC E' (stOf mem pairs th) RS) t)
    (fun t => rfl) th.promises
  have hrc := sum_rpSum_le (rpC E' (stOf mem pairs th) RS) hnd
  have hrh := sum_rpSum_le (rpH E' (stOf mem pairs th) RS) hnd
  have hsp := sum_rpC_rpH E' (stOf mem pairs th) (fun y => y.2.2.2.2.2.2.1) RS
  have hsw := pSum_dropA_swap (E := E) (E' := E') (s := s) (s' := stOf mem pairs th) (cr := cr) hsub hnd
  have hdl := pSum_dropA_le (E := E) (E' := E') (s := stOf mem pairs th) (s0 := s) (s1 := stOf mem pairs th) (cr := cr)
  refine ⟨fun t => dropA E E' s (stOf mem pairs th) cr t + rpSum (rpC E' (stOf mem pairs th) RS) t,
    rpSum (rpH E' (stOf mem pairs th) RS),
    ⟨E', ⟨hq, dropA E E' s (stOf mem pairs th) cr, rpC E' (stOf mem pairs th) RS, rpH E' (stOf mem pairs th) RS,
      fun _ => ⟨KeepPl_dropA, dropA_le⟩, fun t => rfl, RepinQU_mono (fun t k => ?_) hQc, hFc, hQh, hFh,
      fun t => rfl, ?_, fun t => crKeys_rpSum t (fun y hy => (hQh y hy).2.2.2.2.1), RepinCovS_of_U hRC hmem, hFP, hRK, pubKeep_np hnp⟩,
      h0, h1, h2, h3, hm', h5, PromCrK_repinU hC hQc hPc⟩, ?_, ?_⟩
  · simp only [Res.add_apply]; omega
  · intro t ht
    by_cases hy : ∃ y ∈ rpH E' (stOf mem pairs th) RS, y.2.2.1 = t
    · obtain ⟨y, hy, rfl⟩ := hy
      obtain ⟨-, -, -, ⟨mh, usS, hmh, hl, hlo, -⟩, -⟩ := hQh y hy
      exact hlo.1
    · exact absurd (rpSum_none fun y hy' e => hy ⟨y, hy', e⟩) ht
  · intro k
    have a1 := congrArg (fun R : Res => R k) e
    have a4 := congrArg (fun R : Res => R k) hsp
    have a2 := hrc k; have a3 := hsw k; have a5 := hrh k
    simp only [pSum, stOf, Res.add_apply] at a1 a2 a3 a4 a5 ⊢
    omega
  · intro k
    have a1 := congrArg (fun R : Res => R k) e
    have a4 := congrArg (fun R : Res => R k) hsp
    have a2 := hrc k; have a3 := hdl k; have a5 := hrh k
    simp only [pSum, stOf, Res.add_apply] at a1 a2 a3 a4 a5 ⊢
    omega
#print axioms TermPlant.ThInvMCFSQ.toKARS

/-- (pool) A zero pool costs nothing. -/
theorem le_plh0 {X Y : Res} {s : St} (h : X ≤ Y) : X + pSum s (fun _ => .zero) ≤ Y := by
  have e : pSum s (fun _ => .zero) = .zero := sum_map_zero s.promises
  rw [e, Res.add_zero]; exact h
#print axioms TermPlant.le_plh0

/-- (pool) A vacuous per-unit cover with no items is a split cover with no items. -/
theorem covS_nil {E E' : TEnv} {s s' : St} {th : TTh} (h : RepinCovU E E' s s' th []) :
    RepinCovS E E' s s' th [] [] :=
  RepinCovS_of_U h (fun _ hy => absurd hy List.not_mem_nil)
#print axioms TermPlant.covS_nil

/-- (pool) `ThInvMCFSQK` at `KeepQ`, with a vacuous per-unit re-pin cover, is one at `KeepQRS`
with a zero pool. -/
theorem ThInvMCFSQK.toRS {Q0 : TEnv → Prop} {p : Prog} {g : G} {E : TEnv} {s : St} {S0 : AllocLabel → List Res}
    {mem : Memory} {pairs : List Ts} {th : TTh} {Tot H : Res} {cr cr' db : Ts → Res} {th0 : TTh}
    (hV : ∀ E', RepinCovU E E' s (stOf mem pairs th) th0 []) (hF : FulP E s (stOf mem pairs th) th0)
    (hR : ∀ E', RcKeepP E E' s (stOf mem pairs th) th0) (hnp : ∀ x a e, th0.term ≠ .let_ x (.publish a) e)
    (h : ThInvMCFSQK (fun E' => Q0 E' ∧ KeepQ E E' s (stOf mem pairs th) th0 cr cr') p g E s S0 mem pairs th
      Tot H cr' db) :
    ThInvMCFSQK (fun E' => Q0 E' ∧ KeepQRS E E' s (stOf mem pairs th) th0 cr cr' (fun _ => .zero)) p g E s S0
      mem pairs th Tot H cr' db :=
  h.mono fun E' hk => ⟨hk.1, keepQRS_of_keepQ hk.2 (covS_nil (hV E')) hF (hR E') (pubKeep_np hnp)⟩
#print axioms TermPlant.ThInvMCFSQK.toRS

/-- (pool) `stepOut_ofFSAR` with split re-pins (`KeepQRS`, pool `plh`). -/
theorem stepOut_ofFSARS {QE : TEnv → Prop} {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory}
    {pairs : List Ts} {th : TTh} {cx : Cx} {η : TEnv}
    {Rf Rs H : Res} {cr db : Ts → Res} {Q : Memory × List Ts × TTh → Prop}
    (hnps : ¬ PubShape cx th) (hnp : ∀ x a e, th.term ≠ .let_ x (.publish a) e)
    (h : tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → Q r →
      ∃ Tot H' C F, ∃ RS : List (AllocLabel × Cell × CrIt),
        ThInvMCFSQ (fun E' => QE E' ∧ (∀ y ∈ RS, RepinItU E' (stOf r.1 r.2.1 r.2.2) y) ∧
            RepinCovU (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th RS ∧
            FulP (CE η) (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th ∧
            RcKeepP (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th)
          p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' (dropP (CE η) (stOf mem pairs th) cr) db ∧
        MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
        Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C +
            Res.sum (RS.map fun y => y.2.2.2.2.2.2.1) ≤
          Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → Q r →
      ∃ Tot H' C F cr' db' Gd plh,
      ThInvMCFSQK (fun E' => QE E' ∧ KeepQRS (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th cr cr' plh)
        p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr' db' ∧
      MintStep g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧ ClaimAt th.term C F ∧
      Drop (CE η) (stOf mem pairs th) Gd ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr' + pSum (stOf mem pairs th) db + C + Res.sum (Gd.map GdE.R) +
          pSum (stOf r.1 r.2.1 r.2.2) plh ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db' + F ∧
      (PubShape cx th → GdCovT (CE η) (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) Gd th) ∧
        (¬ PubShape cx th → Gd = []) :=
  ⟨h.1, fun r hr hpa hq => by
    obtain ⟨Tot, H', C, F, RS, h1, h2, h3⟩ := h.2 r hr hpa hq
    obtain ⟨cr', plh, hK, -, hle⟩ := ThInvMCFSQ.toKARS (th0 := th) h1 (TermLiveProps.tstep_ext g mem pairs th r hr).prom hnp
    refine ⟨Tot, H', C, F, cr', db, [], plh, hK, h2.toM, h2.claimAt _, Drop_nil, Res.le_def.2 fun k => ?_,
      fun hps => absurd hps hnps, fun _ => rfl⟩
    have e1 := h3 k
    have e2 := hle k
    simp only [Res.add_apply, List.map_nil, Res.sum_nil, Res.zero_apply] at e1 e2 ⊢
    omega⟩
#print axioms TermPlant.stepOut_ofFSARS

/-- (BI) `ThInvMCFSQ.toKARS` with the exclusion-free cover. -/
theorem ThInvMCFSQ.toKARSB {Q0 : TEnv → Prop} {p : Prog} {g : G} {E : TEnv} {s : St} {S0 : AllocLabel → List Res}
    {mem : Memory} {pairs : List Ts} {th : TTh} {Tot H : Res} {cr db : Ts → Res} {th0 : TTh}
    {RS : List (AllocLabel × Cell × CrIt)}
    (h : ThInvMCFSQ (fun E' => Q0 E' ∧ (∀ y ∈ RS, RepinItU E' (stOf mem pairs th) y) ∧
      RepinCovUB E E' s (stOf mem pairs th) th0 RS ∧ FulP E s (stOf mem pairs th) th0 ∧
      RcKeepP E E' s (stOf mem pairs th) th0) p g E s S0 mem pairs th Tot H
      (dropP E s cr) db)
    (hsub : ∀ t, t ∈ th.promises → t ∈ s.promises) (hnp : ∀ x a e, th0.term ≠ .let_ x (.publish a) e) :
    ∃ cr' plh, ThInvMCFSQK (fun E' => Q0 E' ∧ KeepQRSB E E' s (stOf mem pairs th) th0 cr cr' plh) p g E s S0
        mem pairs th Tot H cr' db ∧
      pSum (stOf mem pairs th) cr' + pSum (stOf mem pairs th) plh + pSum s (dropP E s cr) ≤
        pSum (stOf mem pairs th) (dropP E s cr) + pSum s cr + Res.sum (RS.map fun y => y.2.2.2.2.2.2.1) ∧
      pSum (stOf mem pairs th) cr' + pSum (stOf mem pairs th) plh ≤
        pSum (stOf mem pairs th) cr + Res.sum (RS.map fun y => y.2.2.2.2.2.2.1) := by
  obtain ⟨E', ⟨hq, hRI, hRC, hFP, hRK⟩, h0, h1, h2, h3, hm', h5, hC⟩ := h
  obtain ⟨hQc, hPc, hFc, hQh, hFh, hmem⟩ := repin_splitU hRI
  have hnd := MemInv_nodup hm'
  have e := sum_map_split
    (f := fun t => dropA E E' s (stOf mem pairs th) cr t + rpSum (rpC E' (stOf mem pairs th) RS) t)
    (fun t => rfl) th.promises
  have hrc := sum_rpSum_le (rpC E' (stOf mem pairs th) RS) hnd
  have hrh := sum_rpSum_le (rpH E' (stOf mem pairs th) RS) hnd
  have hsp := sum_rpC_rpH E' (stOf mem pairs th) (fun y => y.2.2.2.2.2.2.1) RS
  have hsw := pSum_dropA_swap (E := E) (E' := E') (s := s) (s' := stOf mem pairs th) (cr := cr) hsub hnd
  have hdl := pSum_dropA_le (E := E) (E' := E') (s := stOf mem pairs th) (s0 := s) (s1 := stOf mem pairs th) (cr := cr)
  refine ⟨fun t => dropA E E' s (stOf mem pairs th) cr t + rpSum (rpC E' (stOf mem pairs th) RS) t,
    rpSum (rpH E' (stOf mem pairs th) RS),
    ⟨E', ⟨hq, dropA E E' s (stOf mem pairs th) cr, rpC E' (stOf mem pairs th) RS, rpH E' (stOf mem pairs th) RS,
      fun _ => ⟨KeepPl_dropA, dropA_le⟩, fun t => rfl, RepinQU_mono (fun t k => ?_) hQc, hFc, hQh, hFh,
      fun t => rfl, ?_, fun t => crKeys_rpSum t (fun y hy => (hQh y hy).2.2.2.2.1), RepinCovSB_of_U hRC hmem, hFP, hRK, pubKeep_np hnp⟩,
      h0, h1, h2, h3, hm', h5, PromCrK_repinU hC hQc hPc⟩, ?_, ?_⟩
  · simp only [Res.add_apply]; omega
  · intro t ht
    by_cases hy : ∃ y ∈ rpH E' (stOf mem pairs th) RS, y.2.2.1 = t
    · obtain ⟨y, hy, rfl⟩ := hy
      obtain ⟨-, -, -, ⟨mh, usS, hmh, hl, hlo, -⟩, -⟩ := hQh y hy
      exact hlo.1
    · exact absurd (rpSum_none fun y hy' e => hy ⟨y, hy', e⟩) ht
  · intro k
    have a1 := congrArg (fun R : Res => R k) e
    have a4 := congrArg (fun R : Res => R k) hsp
    have a2 := hrc k; have a3 := hsw k; have a5 := hrh k
    simp only [pSum, stOf, Res.add_apply] at a1 a2 a3 a4 a5 ⊢
    omega
  · intro k
    have a1 := congrArg (fun R : Res => R k) e
    have a4 := congrArg (fun R : Res => R k) hsp
    have a2 := hrc k; have a3 := hdl k; have a5 := hrh k
    simp only [pSum, stOf, Res.add_apply] at a1 a2 a3 a4 a5 ⊢
    omega
#print axioms TermPlant.ThInvMCFSQ.toKARSB

