theorem heldPieceF0L {E : TEnv} {s s2 : St} {cr db : Ts → Res} {lab : AllocLabel} {c : Cell} {f : Ts}
    {b : Nat} {U : Ty} {us : List Acc} {wsn P0 : List Word} {Rs0 : List Res} {Rv : Res} {F : List Ts} {wB : Ts}
    {Gs : List (Ts × Nat × Ty × List Word × Res × (Nat → Bool))} {coh1 : Address → Ts}
    (hent0 : HeldEntryL E s lab Rs0)
    (hC : PromCrP E s cr db) (hsto : E.sto lab = some c) (hf : E.pfr lab = some f)
    (hcpl : Ty.coupledOKIn [] c.ty = true) (hniU : noIallV U = true)
    (hclo : Clo c.ty) (hat : AtOff c.ty b U) (hini : IniAt E.ini c ⟨lab, b⟩ U)
    (hna : ∀ N e, U ≠ .array (.lit N) e) (hus : accs U = some us) (hone : ∀ u, u ∈ us → u = .one)
    (hiniW : ∀ j, j < nWords us → IniW E ⟨lab, b + j⟩)
    (hinR : ∀ j, j < nWords us → InitRr E c lab (b + j))
    (htyc : ∀ j, j < nWords us → VisU E ⟨lab, b + j⟩ → ∃ m, s.mem[s.vs.coh ⟨lab, b + j⟩]? = some m ∧
      m.loc = ⟨lab, b + j⟩ ∧ ∀ k P, AtOff c.ty (b + j) (.word (.lit k) P) → P.ghost = false →
        pwf P = true ∧ ∃ x, m.val = .num x ∧ InP P x)
    (hvn : VRR (fun _ => 0) (CE E.unsee) U (shp U) wsn Rv) (hVn : Valid U wsn) (hln : wsn.length = nWords us)
    (hmem2 : s2.mem = s.mem) (hsub2 : ∀ t, t ∈ s2.promises → t ∈ s.promises)
    (hFl : F.length = nWords us) (hFm : ∀ t, t ∈ s.promises → t ∈ s2.promises ∨ t ∈ F)
    (hFj : ∀ (j : Nat) t, F[j]? = some t → t ∈ s.promises ∧ t ∉ s2.promises ∧ ∃ m w, s.mem[t]? = some m ∧
      wsn[j]? = some w ∧ m.loc = ⟨lab, b + j⟩ ∧ WLe1 w (mw m) ∧ coh1 ⟨lab, b + j⟩ < t ∧
      s2.vs.coh ⟨lab, b + j⟩ = t)
    (hpr2 : ∀ t, t ∈ s2.promises → ∀ m, s.mem[t]? = some m → s2.vs.coh m.loc < t)
    (hcm : ∀ a, s.vs.coh a ≤ coh1 a) (hlP : P0.length = nWords us)
    (hP0 : ∀ (o : Nat) w, P0[o]? = some w → ∀ t, F[o]? = some t → PredAt s.mem ⟨lab, b + o⟩ t w)
    (hwB : ∀ (j : Nat) t, F[j]? = some t → t ≤ wB)
    (hW2 : ∀ t m, s.mem[t]? = some m → m.loc.label = lab → s.vs.coh m.loc < t → t ≤ wB → t ∈ s.promises)
    (hW3 : ∀ t m, t ∈ FpAt E ⟨lab, 0⟩ → s.mem[t]? = some m → m.loc.label = lab → wB < t)
    (hGnd : (Gs.map (·.1)).Nodup) (hGit : ∀ x ∈ Gs, CrItem E s cr lab c x)
    (hGcov : ∀ o tw, InitRr E c lab o → ¬ VisU E ⟨lab, o⟩ → LowOwn s ⟨lab, o⟩ tw → tw ≤ wB → OverT E s ⟨lab, o⟩ tw →
      ∃ x ∈ Gs, ∃ usS i, accs x.2.2.1 = some usS ∧ x.2.1 ≤ o ∧ InAcc usS i (o - x.2.1) ∧
        x.2.2.2.2.2 i = true) :
    ∃ Rs' Rp, HeldEntryL E s2 lab Rs' ∧
      (∀ j, Rs'[j]? ≠ Rs0[j]? → ∀ N e us', c.ty = .array (.lit N) e → accs e = some us' → j < E.rc lab) ∧
      VRR (fun _ => 0) (CE E.unsee) U (shp U) P0 Rp ∧
      Res.sum Rs' + Rp + Res.sum (F.map db) ≤ Res.sum Rs0 + Rv + Res.sum (F.map cr) := by
  obtain ⟨vals0, hL0, hC0⟩ := hent0.2 c hsto
  by_cases hw0 : nWords us = 0
  · -- a zero-width piece: nothing is fulfilled, nothing read, the entry is unchanged
    obtain rfl := nWords_zero_nil hw0
    have hF0 : F = [] := List.eq_nil_of_length_eq_zero (by simpa [nWords] using hFl)
    have hP00 : P0 = [] := List.eq_nil_of_length_eq_zero (by simpa [nWords] using hlP)
    have hw0 : wsn = [] := List.eq_nil_of_length_eq_zero (by simpa [nWords] using hln)
    subst hF0 hP00 hw0
    have hlat : ∀ (o : Nat) v, vals0[o]? = some v →
        LatestNP s2.mem (PromAt E s2 ⟨lab, o⟩) ⟨lab, o⟩ v := by
      intro o v hov
      rw [hmem2]
      refine LatestNP_congr (fun t m hm hl => ?_) (hL0 o v hov)
      by_cases hvu : VisU E ⟨lab, o⟩
      · rw [PromAt_word hvu, PromAt_word hvu]
      · have key : t ∈ s2.promises ++ FpAt E ⟨lab, o⟩ ↔ t ∈ s.promises ++ FpAt E ⟨lab, o⟩ := by
          rw [List.mem_append, List.mem_append]
          constructor
          · rintro (h | h)
            · exact Or.inl (hsub2 t h)
            · exact Or.inr h
          · rintro (h | h)
            · rcases hFm t h with h' | h'
              · exact Or.inl h'
              · cases h'
            · exact Or.inr h
        by_cases hq : PredU E ⟨lab, o⟩
        · rw [mem_PromAt_pred hvu hq, mem_PromAt_pred hvu hq, hmem2]
          exact and_congr_left fun _ => key
        · rw [PromAt_nword hvu hq, PromAt_nword hvu hq]
          exact key
    refine ⟨Rs0, Rv, ⟨fun h => ?_, fun c' hc' => ?_⟩, fun j h => absurd rfl h, hvn, fun k => Nat.le_refl _⟩
    · rw [hsto] at h; cases h
    · rw [hsto] at hc'; cases hc'; exact ⟨vals0, hlat, hC0⟩
  rcases own_segL (a := ⟨lab, b⟩) (nI := E.ini) (Nat.le_refl _) hC0 hat hini hna with
    ⟨bS, oS, S, wS, k, Rs, -, hbo, hatS, hwS, hbw, hRk, ⟨hvs, hVs⟩, hkb, hput⟩ | ⟨-, -, -, -, -, -, -, hz0⟩
  rotate_left
  · exact absurd (hz0 _ hus) hw0
  have hbo' : bS + oS = b := hbo
  have hsl : ((vals0.drop bS).take wS).length = wS := by
    simp only [List.length_take, List.length_drop]; omega
  obtain ⟨n, Rq, Rr2, hwn, hle, hRs, hvq, hput2⟩ := VRR_at E.unsee hatS hvs (by rw [hsl]; exact hwS)
  have hwU : wc U = some (nWords us) := wc_of_accs hus
  rw [hwU] at hwn
  obtain rfl : nWords us = n := Option.some.inj hwn
  rw [hsl] at hle
  have hlenv : b + nWords us ≤ vals0.length := by
    rw [← hbo', Nat.add_assoc]; exact Nat.le_trans (Nat.add_le_add_left hle bS) hbw
  have hVq0 := Valid_at hatS (fun h => by simp [wc, h] at hwS) hVs (by rw [hsl]; exact hwS) _ hwU
  have hvqe : (((vals0.drop bS).take wS).drop oS).take (nWords us) = (vals0.drop b).take (nWords us) := by
    rw [take_drop_take hle, drop_drop', hbo']
  rw [hvqe] at hvq hVq0
  have hlq : ((vals0.drop b).take (nWords us)).length = nWords us := by
    simp only [List.length_take, List.length_drop]; omega
  have hLq : ∀ (j : Nat) v, ((vals0.drop b).take (nWords us))[j]? = some v →
      LatestNP s.mem (PromAt E s ⟨lab, b + j⟩) ⟨lab, b + j⟩ v := fun j v hj => by
    have hj' : vals0[b + j]? = some v := by
      by_cases hjn : j < nWords us
      · rw [List.getElem?_take_of_lt hjn, List.getElem?_drop] at hj; exact hj
      · rw [List.getElem?_eq_none (by simp; omega)] at hj; cases hj
    exact hL0 _ v hj'
  obtain ⟨M, Ra, Rp, hMl, hMv, hMV, hML, hVp, hacc⟩ := pieceAcctF0 hC hsto hf hcpl hniU hclo hat hus
    hone hiniW hinR htyc hvq hVq0 hlq hLq hvn hVn hln hmem2 hsub2 hFl hFm hFj hpr2 hcm hlP hP0 hwB hW2 hW3
    hGnd hGit hGcov
  have hQ := hput2 M Ra hMv hMl
  have hQV := (VR_put E.unsee hatS (VRR_VR S (RLink_of (Coh_CE _) (CohR_CE _)) hvs) hVs (by rw [hsl]; exact hwS)
    (VRR_VR U (RLink_of (Coh_CE _) (CohR_CE _)) hMv) hMV (by rw [hMl]; exact hwU)).2.2
  rw [hMl] at hQV
  have hQl : (((vals0.drop bS).take wS).take oS ++ M ++ ((vals0.drop bS).take wS).drop (oS + nWords us)).length = wS := by
    simp only [List.length_append, List.length_take, List.length_drop, hMl]; omega
  have hcell' := hput _ _ ⟨hQ, hQV⟩ hQl
  have hsp := splice_seg vals0 M bS wS oS (by rw [hMl]; exact hle)
  rw [hMl] at hsp
  rw [hsp, hbo'] at hcell'
  have hFlt : ∀ j t, F[j]? = some t → j < nWords us := fun j t h => by
    rw [← hFl]; exact (List.getElem?_eq_some_iff.mp h).1
  have hlat' : ∀ (o : Nat) v, (vals0.take b ++ M ++ vals0.drop (b + nWords us))[o]? = some v →
      LatestNP s2.mem (PromAt E s2 ⟨lab, o⟩) ⟨lab, o⟩ v := by
    intro o v hov
    rw [splice_get vals0 M b (nWords us) o hMl hlenv] at hov
    by_cases hr : b ≤ o ∧ o < b + nWords us
    · rw [iteT hr] at hov
      have := hML (o - b) v hov
      have e : b + (o - b) = o := by omega
      rw [e] at this; exact this
    · rw [iteF hr] at hov
      rw [hmem2]
      refine LatestNP_congr (fun t m hm hl => ?_) (hL0 o v hov)
      by_cases hvu : VisU E ⟨lab, o⟩
      · rw [PromAt_word hvu, PromAt_word hvu]
      · have key : t ∈ s2.promises ++ FpAt E ⟨lab, o⟩ ↔ t ∈ s.promises ++ FpAt E ⟨lab, o⟩ := by
          rw [List.mem_append, List.mem_append]
          constructor
          · rintro (h | h)
            · exact Or.inl (hsub2 t h)
            · exact Or.inr h
          · rintro (h | h)
            · rcases hFm t h with h' | h'
              · exact Or.inl h'
              · obtain ⟨j, hj⟩ := List.mem_iff_getElem?.mp h'
                obtain ⟨-, -, m', -, hm', -, hl', -⟩ := hFj j t hj
                rw [hm] at hm'; cases hm'
                have hjn := hFlt j t hj
                have e : o = b + j := congrArg WeakMem.Address.offset (hl.symm.trans hl')
                exact absurd ⟨by omega, by omega⟩ hr
            · exact Or.inr h
        by_cases hq : PredU E ⟨lab, o⟩
        · -- (U3) a predicted slot of the cell: the same memory, the same cut point
          rw [mem_PromAt_pred hvu hq, mem_PromAt_pred hvu hq, hmem2]
          exact and_congr_left fun _ => key
        · rw [PromAt_nword hvu hq, PromAt_nword hvu hq]
          exact key
  have hent : HeldEntryL E s2 lab (Rs0.set k (Ra + Rr2)) := by
    refine ⟨fun h => ?_, fun c' hc' => ?_⟩
    · rw [hsto] at h; cases h
    · rw [hsto] at hc'; cases hc'; exact ⟨_, hlat', hcell'⟩
  have hkL : k < Rs0.length := (List.getElem?_eq_some_iff.mp hRk).1
  refine ⟨Rs0.set k (Ra + Rr2), Rp, hent, fun j hj N e us' hT hus' => ?_, hVp, fun i => ?_⟩
  · have hjk : j = k := by
      obtain hne | h : j ≠ k ∨ j = k := (Decidable.em (j = k)).symm
      · exact absurd (by rw [List.getElem?_set_ne (Ne.symm hne)]) hj
      · exact h
    subst hjk
    obtain ⟨hbk, -⟩ := hkb N e us' hT hus'
    have h0 := hinR 0 (by omega) N e us' hT hus'
    rw [Nat.add_zero] at h0
    have hle : j * nWords us' ≤ b := by rw [← hbo', hbk]; exact Nat.le_add_right _ _
    exact Nat.lt_of_not_le fun hge => Nat.lt_irrefl _ (Nat.lt_of_lt_of_le h0
      (Nat.le_trans (Nat.mul_le_mul_right _ hge) hle))
  · have es1 := Res.sum_set Rs0 k (Ra + Rr2) hkL
    have es2 := Res.sum_set_zero Rs0 k hkL
    have eRk : Rs0[k] = Rs := (List.getElem?_eq_some_iff.mp hRk).2
    rw [eRk] at es2
    subst hRs
    have e := hacc i
    have e1 := congrArg (fun R : Res => R i) es1
    have e2 := congrArg (fun R : Res => R i) es2
    simp only [Res.add_apply] at e e1 e2 ⊢
    omega
#print axioms heldPieceF0L

/-- (OpenRcKeep) **The real count stays below the untouched predicted units**: at a step that
leaves memory unchanged at an op with a frontier target, every predicted (`PredU`) array unit
of `E` that no fulfilled promise sits at lies at or above the post-step real count `E'.rini`. -/
def RcKeepP (E E' : TEnv) (s s' : St) (th : TTh) : Prop :=
  s'.mem = s.mem → (opAtomP th.term).isSome = true → (∃ lab, OpTgtP th lab ∧ E.pfr lab ≠ none) →
    ∀ a : Address, (∀ t m, t ∈ s.promises → t ∉ s'.promises → s.mem[t]? = some m → m.loc ≠ a) → PredU E a →
      ∀ c N e us, E.sto a.label = some c → c.ty = .array (.lit N) e → accs e = some us →
        E'.rini a.label * nWords us ≤ a.offset

theorem rcKeepP_pred {E : TEnv} {a : Address} {c : Cell} {N : Nat} {e : Ty} {us : List TermRun.Acc}
    (hp : PredU E a) (hc : E.sto a.label = some c) (hty : c.ty = .array (.lit N) e) (hus : accs e = some us) :
    E.rini a.label * nWords us ≤ a.offset := by
  have h1 := hp.2.1 c N e us hc hty hus
  have h2 : ¬ a.offset < E.rc a.label * nWords us := fun h => hp.2.2 (fun c' N' e' us' hc' hty' hus' => by
    rw [hc] at hc'; cases hc'; rw [hty] at hty'; cases hty'; rw [hus] at hus'; cases hus'; exact h)
  unfold TEnv.rc at h2
  rcases Nat.le_total (E.ini a.label) (E.rini a.label) with h | h
  · rw [Nat.min_eq_left h] at h2; exact absurd h1 h2
  · rw [Nat.min_eq_right h] at h2; exact Nat.le_of_not_lt h2
#print axioms TermPlant.rcKeepP_pred

theorem rcKeep_of_rini {E E' : TEnv} {s s' : St} {th : TTh}
    (h : ∀ l c, E.sto l = some c → E'.rini l = E.rini l) : RcKeepP E E' s s' th := by
  intro _ _ _ a _ hp c N e us hc hty hus
  rw [h a.label c hc]
  exact rcKeepP_pred hp hc hty hus
#print axioms TermPlant.rcKeep_of_rini

theorem rcKeepP_tgt {E E' : TEnv} {s s' : St} {th : TTh} {q : At}
    (hq : ∀ q', opAtomP th.term = some q' → q' = q)
    (h : ∀ rt w ad off, evalAt th.env q = some (rt, [w]) → w.val = .loc ad off → E.pfr ad.label = none) :
    RcKeepP E E' s s' th := by
  intro _ _ hex
  obtain ⟨lab, hot, hpf⟩ := hex
  obtain ⟨q', rt, w, ad, off, hq', he, hw, rfl⟩ := hot
  obtain rfl := hq q' hq'
  exact absurd (h rt w ad off he hw) hpf
#print axioms TermPlant.rcKeepP_tgt

theorem rcKeepP_nop {E E' : TEnv} {s s' : St} {th : TTh} (hq : opAtomP th.term = none) : RcKeepP E E' s s' th := by
  intro _ h
  rw [hq] at h
  exact absurd h (by simp)
#print axioms TermPlant.rcKeepP_nop

theorem rkAddr_eq {a b : Address} (h1 : a.label = b.label) (h2 : a.offset = b.offset) : a = b := by
  cases a
  cases b
  simp only at h1 h2
  subst h1
  subst h2
  rfl
#print axioms TermPlant.rkAddr_eq

/-- (FulP) `fulP_of_fulAll` from a heldPiece-shaped fulfilment list. -/
theorem fulP_ofH {E : TEnv} {s s2 : St} {th : TTh} {lab : AllocLabel} {c : Cell} {b : Nat} {U : Ty}
    {us : List Acc} {wsn : List Word} {F : List Ts} {coh1 : Address → Ts}
    (htg : ∀ l, OpTgtP th l → l = lab) (hsto : E.sto lab = some c) (hat : AtOff c.ty b U)
    (hus : accs U = some us) (hmem2 : s2.mem = s.mem)
    (hFl : F.length = nWords us) (hFm : ∀ t, t ∈ s.promises → t ∈ s2.promises ∨ t ∈ F)
    (hFj : ∀ (j : Nat) t, F[j]? = some t → t ∈ s.promises ∧ t ∉ s2.promises ∧ ∃ m w, s.mem[t]? = some m ∧
      wsn[j]? = some w ∧ m.loc = ⟨lab, b + j⟩ ∧ WLe1 w (mw m) ∧ coh1 ⟨lab, b + j⟩ < t ∧
      s2.vs.coh ⟨lab, b + j⟩ = t)
    (hpr2 : ∀ t, t ∈ s2.promises → ∀ m, s.mem[t]? = some m → s2.vs.coh m.loc < t) :
    FulP E s s2 th :=
  fulP_of_fulAll htg hsto hat hus (fun t ht m hm => hpr2 t ht m (by rw [← hmem2]; exact hm)) fun _ =>
    ⟨F, hFl, hFm, fun j t hj =>
      let ⟨h1, h2, m, _, h3, _, h5, _, _, h8⟩ := hFj j t hj
      ⟨h1, h2, m, h3, h5, h8⟩⟩
#print axioms TermPlant.fulP_ofH

set_option maxHeartbeats 3200000 in
/-- (CRC) `heldPieceF0LD` with the plant items (`PlantOp`/`CrItem`) at a separate credit `cr₁`, below `cr` at the promises the step discharges. -/
theorem heldPieceF0LDC {E : TEnv} {s s2 : St} {cr db cr₁ : Ts → Res} {lab : AllocLabel} {c : Cell} {f : Ts}
    {b : Nat} {U : Ty} {us : List Acc} {wsn P0 : List Word} {Rs0 : List Res} {Rv : Res} {F : List Ts} {wB : Ts}
    {Gs : List (Ts × Nat × Ty × List Word × Res × (Nat → Bool))} {coh1 : Address → Ts}
    (hent0 : HeldEntryL E s lab Rs0)
    (hC : PromCrP E s cr db) (hsto : E.sto lab = some c) (hf : E.pfr lab = some f)
    (hown : c.owner = some E.tid) (hnoT : Ty.noOwnIn [] c.ty = true)
    (hcpl : Ty.coupledOKIn [] c.ty = true) (hniU : noIallV U = true)
    (hclo : Clo c.ty) (hat : AtOff c.ty b U) (hini : IniAt E.ini c ⟨lab, b⟩ U)
    (hna : ∀ N e, U ≠ .array (.lit N) e) (hus : accs U = some us) (hone : ∀ u, u ∈ us → u = .one)
    (hiniW : ∀ j, j < nWords us → IniW E ⟨lab, b + j⟩)
    (hinR : ∀ j, j < nWords us → InitRr E c lab (b + j))
    (htyc : ∀ j, j < nWords us → VisU E ⟨lab, b + j⟩ → ∃ m, s.mem[s.vs.coh ⟨lab, b + j⟩]? = some m ∧
      m.loc = ⟨lab, b + j⟩ ∧ ∀ k P, AtOff c.ty (b + j) (.word (.lit k) P) → P.ghost = false →
        pwf P = true ∧ ∃ x, m.val = .num x ∧ InP P x)
    (hvn : VRR (fun _ => 0) (CE E.unsee) U (shp U) wsn Rv) (hVn : Valid U wsn) (hln : wsn.length = nWords us)
    (hmem2 : s2.mem = s.mem) (hsub2 : ∀ t, t ∈ s2.promises → t ∈ s.promises)
    (hFl : F.length = nWords us) (hFm : ∀ t, t ∈ s.promises → t ∈ s2.promises ∨ t ∈ F)
    (hFj : ∀ (j : Nat) t, F[j]? = some t → t ∈ s.promises ∧ t ∉ s2.promises ∧ ∃ m w, s.mem[t]? = some m ∧
      wsn[j]? = some w ∧ m.loc = ⟨lab, b + j⟩ ∧ WLe1 w (mw m) ∧ coh1 ⟨lab, b + j⟩ < t ∧
      s2.vs.coh ⟨lab, b + j⟩ = t)
    (hpr2 : ∀ t, t ∈ s2.promises → ∀ m, s.mem[t]? = some m → s2.vs.coh m.loc < t)
    (hcm : ∀ a, s.vs.coh a ≤ coh1 a) (hlP : P0.length = nWords us)
    (hP0 : ∀ (o : Nat) w, P0[o]? = some w → ∀ t, F[o]? = some t → PredAt s.mem ⟨lab, b + o⟩ t w)
    (hwB : ∀ (j : Nat) t, F[j]? = some t → t ≤ wB)
    (hW2 : ∀ t m, s.mem[t]? = some m → m.loc.label = lab → s.vs.coh m.loc < t → t ≤ wB → t ∈ s.promises)
    (hW3 : ∀ t m, t ∈ FpAt E ⟨lab, 0⟩ → s.mem[t]? = some m → m.loc.label = lab → wB < t)
    (hGnd : (Gs.map (·.1)).Nodup) (hGit : ∀ x ∈ Gs, CrItem E s cr₁ lab c x) (hcle : ∀ t, t ∈ F → cr₁ t ≤ cr t)
    (hGcov : ∀ o tw, InitRr E c lab o → ¬ VisU E ⟨lab, o⟩ → LowOwn s ⟨lab, o⟩ tw → tw ≤ wB → OverT E s ⟨lab, o⟩ tw →
      ∃ x ∈ Gs, ∃ usS i, accs x.2.2.1 = some usS ∧ x.2.1 ≤ o ∧ InAcc usS i (o - x.2.1) ∧
        x.2.2.2.2.2 i = true) :
    (∀ th : TTh, (∀ l, OpTgtP th l → l = lab) → FulP E s s2 th) ∧ ∃ Rs' Rp, HeldEntryL E s2 lab Rs' ∧
      (∀ j, Rs'[j]? ≠ Rs0[j]? → ∀ N e us', c.ty = .array (.lit N) e → accs e = some us' → j < E.rc lab) ∧
      VRR (fun _ => 0) (CE E.unsee) U (shp U) P0 Rp ∧
      ∃ RS : List (AllocLabel × Cell × CrIt), (∀ y ∈ RS, RepinItU E s2 y ∧ y.1 = lab) ∧
      Res.sum Rs' + Rp + Res.sum (F.map db) + Res.sum (RS.map fun y => y.2.2.2.2.2.2.1) ≤
        Res.sum Rs0 + Rv + Res.sum (F.map cr) ∧
      ∀ (o : Nat) th0 tw, ¬ VisU E ⟨lab, o⟩ → LowOwn s ⟨lab, o⟩ th0 → th0 ∉ s2.promises →
        LowOwn s2 ⟨lab, o⟩ tw → OverT E s2 ⟨lab, o⟩ tw → WinGU E s2 lab o tw →
        ∃ y ∈ RS, y.1 = lab ∧ CrCov y.2.2 o := by
  refine ⟨fun th0 htg => fulP_ofH htg hsto hat hus hmem2 hFl hFm hFj hpr2, ?_⟩
  obtain ⟨vals0, hL0, hC0⟩ := hent0.2 c hsto
  by_cases hw0 : nWords us = 0
  · -- a zero-width piece: nothing is fulfilled, nothing read, the entry is unchanged
    obtain rfl := nWords_zero_nil hw0
    have hF0 : F = [] := List.eq_nil_of_length_eq_zero (by simpa [nWords] using hFl)
    have hP00 : P0 = [] := List.eq_nil_of_length_eq_zero (by simpa [nWords] using hlP)
    have hw0 : wsn = [] := List.eq_nil_of_length_eq_zero (by simpa [nWords] using hln)
    subst hF0 hP00 hw0
    have hlat : ∀ (o : Nat) v, vals0[o]? = some v →
        LatestNP s2.mem (PromAt E s2 ⟨lab, o⟩) ⟨lab, o⟩ v := by
      intro o v hov
      rw [hmem2]
      refine LatestNP_congr (fun t m hm hl => ?_) (hL0 o v hov)
      by_cases hvu : VisU E ⟨lab, o⟩
      · rw [PromAt_word hvu, PromAt_word hvu]
      · have key : t ∈ s2.promises ++ FpAt E ⟨lab, o⟩ ↔ t ∈ s.promises ++ FpAt E ⟨lab, o⟩ := by
          rw [List.mem_append, List.mem_append]
          constructor
          · rintro (h | h)
            · exact Or.inl (hsub2 t h)
            · exact Or.inr h
          · rintro (h | h)
            · rcases hFm t h with h' | h'
              · exact Or.inl h'
              · cases h'
            · exact Or.inr h
        by_cases hq : PredU E ⟨lab, o⟩
        · rw [mem_PromAt_pred hvu hq, mem_PromAt_pred hvu hq, hmem2]
          exact and_congr_left fun _ => key
        · rw [PromAt_nword hvu hq, PromAt_nword hvu hq]
          exact key
    refine ⟨Rs0, Rv, ⟨fun h => ?_, fun c' hc' => ?_⟩, fun j h => absurd rfl h, hvn, [],
      fun y hy => absurd hy List.not_mem_nil, R_nil (fun k => Nat.le_refl _),
      fun o th0 tw _ hlo hth => ?_⟩
    · rw [hsto] at h; cases h
    · rw [hsto] at hc'; cases hc'; exact ⟨vals0, hlat, hC0⟩
    · rcases hFm th0 hlo.1 with h | h
      · exact absurd h hth
      · exact absurd h List.not_mem_nil
  rcases own_segL (a := ⟨lab, b⟩) (nI := E.ini) (Nat.le_refl _) hC0 hat hini hna with
    ⟨bS, oS, S, wS, k, Rs, -, hbo, hatS, hwS, hbw, hRk, ⟨hvs, hVs⟩, hkb, hput⟩ | ⟨-, -, -, -, -, -, -, hz0⟩
  rotate_left
  · exact absurd (hz0 _ hus) hw0
  have hbo' : bS + oS = b := hbo
  have hsl : ((vals0.drop bS).take wS).length = wS := by
    simp only [List.length_take, List.length_drop]; omega
  obtain ⟨n, Rq, Rr2, hwn, hle, hRs, hvq, hput2⟩ := VRR_at E.unsee hatS hvs (by rw [hsl]; exact hwS)
  have hwU : wc U = some (nWords us) := wc_of_accs hus
  rw [hwU] at hwn
  obtain rfl : nWords us = n := Option.some.inj hwn
  rw [hsl] at hle
  have hlenv : b + nWords us ≤ vals0.length := by
    rw [← hbo', Nat.add_assoc]; exact Nat.le_trans (Nat.add_le_add_left hle bS) hbw
  have hVq0 := Valid_at hatS (fun h => by simp [wc, h] at hwS) hVs (by rw [hsl]; exact hwS) _ hwU
  have hvqe : (((vals0.drop bS).take wS).drop oS).take (nWords us) = (vals0.drop b).take (nWords us) := by
    rw [take_drop_take hle, drop_drop', hbo']
  rw [hvqe] at hvq hVq0
  have hlq : ((vals0.drop b).take (nWords us)).length = nWords us := by
    simp only [List.length_take, List.length_drop]; omega
  have hLq : ∀ (j : Nat) v, ((vals0.drop b).take (nWords us))[j]? = some v →
      LatestNP s.mem (PromAt E s ⟨lab, b + j⟩) ⟨lab, b + j⟩ v := fun j v hj => by
    have hj' : vals0[b + j]? = some v := by
      by_cases hjn : j < nWords us
      · rw [List.getElem?_take_of_lt hjn, List.getElem?_drop] at hj; exact hj
      · rw [List.getElem?_eq_none (by simp; omega)] at hj; cases hj
    exact hL0 _ v hj'
  obtain ⟨M, Ra, Rp, hMl, hMv, hMV, hML, hVp, RS, hRS1, hacc, hcovR⟩ := pieceAcctF0DC hC hsto hf hown
    (LayT_of_CellR hC0) hnoT hcpl hniU hclo hat hus
    hone hiniW hinR htyc hvq hVq0 hlq hLq hvn hVn hln hmem2 hsub2 hFl hFm hFj hpr2 hcm hlP hP0 hwB hW2 hW3
    hGnd hGit hcle hGcov
  have hQ := hput2 M Ra hMv hMl
  have hQV := (VR_put E.unsee hatS (VRR_VR S (RLink_of (Coh_CE _) (CohR_CE _)) hvs) hVs (by rw [hsl]; exact hwS)
    (VRR_VR U (RLink_of (Coh_CE _) (CohR_CE _)) hMv) hMV (by rw [hMl]; exact hwU)).2.2
  rw [hMl] at hQV
  have hQl : (((vals0.drop bS).take wS).take oS ++ M ++ ((vals0.drop bS).take wS).drop (oS + nWords us)).length = wS := by
    simp only [List.length_append, List.length_take, List.length_drop, hMl]; omega
  have hcell' := hput _ _ ⟨hQ, hQV⟩ hQl
  have hsp := splice_seg vals0 M bS wS oS (by rw [hMl]; exact hle)
  rw [hMl] at hsp
  rw [hsp, hbo'] at hcell'
  have hFlt : ∀ j t, F[j]? = some t → j < nWords us := fun j t h => by
    rw [← hFl]; exact (List.getElem?_eq_some_iff.mp h).1
  have hlat' : ∀ (o : Nat) v, (vals0.take b ++ M ++ vals0.drop (b + nWords us))[o]? = some v →
      LatestNP s2.mem (PromAt E s2 ⟨lab, o⟩) ⟨lab, o⟩ v := by
    intro o v hov
    rw [splice_get vals0 M b (nWords us) o hMl hlenv] at hov
    by_cases hr : b ≤ o ∧ o < b + nWords us
    · rw [iteT hr] at hov
      have := hML (o - b) v hov
      have e : b + (o - b) = o := by omega
      rw [e] at this; exact this
    · rw [iteF hr] at hov
      rw [hmem2]
      refine LatestNP_congr (fun t m hm hl => ?_) (hL0 o v hov)
      by_cases hvu : VisU E ⟨lab, o⟩
      · rw [PromAt_word hvu, PromAt_word hvu]
      · have key : t ∈ s2.promises ++ FpAt E ⟨lab, o⟩ ↔ t ∈ s.promises ++ FpAt E ⟨lab, o⟩ := by
          rw [List.mem_append, List.mem_append]
          constructor
          · rintro (h | h)
            · exact Or.inl (hsub2 t h)
            · exact Or.inr h
          · rintro (h | h)
            · rcases hFm t h with h' | h'
              · exact Or.inl h'
              · obtain ⟨j, hj⟩ := List.mem_iff_getElem?.mp h'
                obtain ⟨-, -, m', -, hm', -, hl', -⟩ := hFj j t hj
                rw [hm] at hm'; cases hm'
                have hjn := hFlt j t hj
                have e : o = b + j := congrArg WeakMem.Address.offset (hl.symm.trans hl')
                exact absurd ⟨by omega, by omega⟩ hr
            · exact Or.inr h
        by_cases hq : PredU E ⟨lab, o⟩
        · -- (U3) a predicted slot of the cell: the same memory, the same cut point
          rw [mem_PromAt_pred hvu hq, mem_PromAt_pred hvu hq, hmem2]
          exact and_congr_left fun _ => key
        · rw [PromAt_nword hvu hq, PromAt_nword hvu hq]
          exact key
  have hent : HeldEntryL E s2 lab (Rs0.set k (Ra + Rr2)) := by
    refine ⟨fun h => ?_, fun c' hc' => ?_⟩
    · rw [hsto] at h; cases h
    · rw [hsto] at hc'; cases hc'; exact ⟨_, hlat', hcell'⟩
  have hkL : k < Rs0.length := (List.getElem?_eq_some_iff.mp hRk).1
  refine ⟨Rs0.set k (Ra + Rr2), Rp, hent, fun j hj N e us' hT hus' => ?_, hVp, RS, hRS1, fun i => ?_,
    hcovR⟩
  · have hjk : j = k := by
      obtain hne | h : j ≠ k ∨ j = k := (Decidable.em (j = k)).symm
      · exact absurd (by rw [List.getElem?_set_ne (Ne.symm hne)]) hj
      · exact h
    subst hjk
    obtain ⟨hbk, -⟩ := hkb N e us' hT hus'
    have h0 := hinR 0 (by omega) N e us' hT hus'
    rw [Nat.add_zero] at h0
    have hle : j * nWords us' ≤ b := by rw [← hbo', hbk]; exact Nat.le_add_right _ _
    exact Nat.lt_of_not_le fun hge => Nat.lt_irrefl _ (Nat.lt_of_lt_of_le h0
      (Nat.le_trans (Nat.mul_le_mul_right _ hge) hle))
  · have es1 := Res.sum_set Rs0 k (Ra + Rr2) hkL
    have es2 := Res.sum_set_zero Rs0 k hkL
    have eRk : Rs0[k] = Rs := (List.getElem?_eq_some_iff.mp hRk).2
    rw [eRk] at es2
    subst hRs
    have e := hacc i
    have e1 := congrArg (fun R : Res => R i) es1
    have e2 := congrArg (fun R : Res => R i) es2
    simp only [Res.add_apply] at e e1 e2 ⊢
    omega
