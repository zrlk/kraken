    obtain ⟨-, -, m', -, hm', -, hl', -⟩ := hFj j th0 hj
    rw [hm0] at hm'; cases hm'
    have e : o = b + j := congrArg WeakMem.Address.offset (hl0.symm.trans hl')
    have hjn := hFlt j th0 hj
    exact hRS3 o th0 tw (by omega) (by omega) hnv hlo hth hlw hov hwn
