/-- (PubKeep) **`OldCr` across `publish`**: at a frontier label (visible, not flipped), with
the cell and its `ini` kept and memory's prefix kept, an old credit stays one. -/
theorem OldCr_pub {g : G} {E E' : TEnv} {s s' : St} {m : Msg} {tw : Ts} {R : Res}
    (hF : EFoot g E E' s s') (hQ : ∀ l, E'.sto l = E.sto l ∧ E'.ini l = E.ini l)
    (hx : TermLiveProps.Ext s s') (hlt : tw < s.mem.size) (hpf : E.pfr m.loc.label ≠ none)
    (h : OldCr E s m tw R) : OldCr E' s' m tw R := by
  have hpre : ∀ t, t < s.mem.size → s'.mem[t]? = s.mem[t]? := fun t ht => hx.mem.get t ht
  have hPA : ∀ w, PredAt s.mem m.loc tw w ↔ PredAt s'.mem m.loc tw w := fun w =>
    PredAt_prefix (fun t ht => hpre t ht) (Nat.le_of_lt hlt)
  obtain ⟨-, -, -, -, -, hpfE, -⟩ := hF
  have hs := (hQ m.loc.label).1
  have hVV : Vis E m.loc.label ∧ Vis E' m.loc.label := by
    cases e : E.pfr m.loc.label with
    | none => exact absurd e hpf
    | some f =>
      refine ⟨Vis_pfr e, Vis_pfr (f := f) ?_⟩
      rcases hpfE m.loc.label with e' | ⟨e', -⟩ | ⟨-, e', -⟩
      · rw [e']; exact e
      · rw [e'] at e; cases e
      · rw [e'] at e; cases e
  have hvr : ∀ w, VRes E m.loc w R → VRes E' m.loc w R := fun w hv =>
    VRes_nfu hs (hQ m.loc.label).2 (fun _ => hVV.2)
      (fun ⟨⟨⟨c, hc, hw⟩, _⟩, hn⟩ => hn ⟨⟨c, by rw [← hs]; exact hc, hw⟩, hVV.1⟩) hv
  rcases h with ⟨w, hp, hv⟩ | ⟨hn, rfl⟩
  · exact Or.inl ⟨w, (hPA w).1 hp, hvr w hv⟩
  · exact Or.inr ⟨fun w hp => hn w ((hPA w).2 hp), rfl⟩
#print axioms TermPlant.OldCr_pub

/-- (PubKeep) **An old credit is unique** (`PredAt_uniq`, `WordAt_uniq`). -/
theorem OldCr_uniq {E : TEnv} {s : St} {m : Msg} {tw : Ts} {R R' : Res}
    (h : OldCr E s m tw R) (h' : OldCr E s m tw R') : R = R' := by
  rcases h with ⟨w, hp, hv⟩ | ⟨hn, rfl⟩ <;> rcases h' with ⟨w', hp', hv'⟩ | ⟨hn', rfl⟩
  · obtain rfl := PredAt_uniq hp hp'
    rcases hv with ⟨hV, hI, hw⟩ | ⟨hn0, rfl⟩ <;> rcases hv' with ⟨hV', hI', hw'⟩ | ⟨hn1, rfl⟩
    · exact WRes_uniq (fun _ _ _ _ h1 h2 => WordAt_uniq h1 h2) hw hw'
    · exact absurd ⟨hV, hI⟩ hn1
    · exact absurd ⟨hV', hI'⟩ hn0
    · rfl
  · exact absurd hp (hn' w)
  · exact absurd hp' (hn w')
  · rfl
#print axioms TermPlant.OldCr_uniq

/-- (PubKeep) **Restoring the kept credits at `publish`**: given the step's credits `cr'`
(`PromCr` at `E'`, from the dropped credits `dropP`), the credits `cr''` taking `cr` back at
every outstanding frontier promise with an old or key-free plant credit satisfy `PromCrK`,
keep those credits, and cost at most what `dropP` dropped. -/
theorem pubFix {g : G} {E E' : TEnv} {s s' : St} {cr cr' db' : Ts → Res}
    (hm : MemInv g E s) (hx : TermLiveProps.Ext s s') (hF : EFoot g E E' s s')
    (hQ : ∀ l, E'.sto l = E.sto l ∧ E'.ini l = E.ini l) (hnd : s'.promises.Nodup)
    (hC' : PromCr E' s' cr' db') :
    ∃ cr'', PromCrK E' s' cr'' db' ∧
      (∀ t m, t ∈ s'.promises → s.mem[t]? = some m → E.pfr m.loc.label ≠ none →
        (OldCr E s m t (cr t) ∨ (PlantCr E s m t (cr t) ∧ CrKeys (cr t))) → cr'' t = cr t) ∧
      pSum s' cr'' + pSum s (dropP E s cr) ≤ pSum s' cr' + pSum s cr := by
  classical
  obtain ⟨PK, hPK⟩ : ∃ PK : Ts → Prop, ∀ t, PK t ↔ ∃ m, s.mem[t]? = some m ∧ E.pfr m.loc.label ≠ none ∧
      (OldCr E s m t (cr t) ∨ (PlantCr E s m t (cr t) ∧ CrKeys (cr t))) := ⟨_, fun _ => Iff.rfl⟩
  obtain ⟨OK, hOK⟩ : ∃ OK : Ts → Prop, ∀ t, OK t ↔ ∃ m, s.mem[t]? = some m ∧ OldCr E s m t (cr t) :=
    ⟨_, fun _ => Iff.rfl⟩
  have hlt : ∀ t, t ∈ s'.promises → t < s.mem.size := fun t ht => hm.2.2.1 t (hx.prom t ht)
  have hpre : ∀ t, t < s.mem.size → s'.mem[t]? = s.mem[t]? := fun t ht => hx.mem.get t ht
  have hkeep : ∀ t, t ∈ s'.promises → PK t → ∃ m, s'.mem[t]? = some m ∧ s.mem[t]? = some m ∧
      (OldCr E' s' m t (cr t) ∨ (PlantCr E' s' m t (cr t) ∧ CrKeys (cr t))) := by
    intro t ht hp
    obtain ⟨m, hm0, hpf, hor⟩ := (hPK t).1 hp
    refine ⟨m, by rw [hpre t (hlt t ht)]; exact hm0, hm0, ?_⟩
    rcases hor with ho | ⟨hpl, hk⟩
    · exact Or.inl (OldCr_pub hF hQ hx (hlt t ht) hpf ho)
    · exact Or.inr ⟨PlantCr_step hF hm hx hpl, hk⟩
  obtain ⟨d, hd⟩ : ∃ d : Ts → Res, ∀ t, d t = if PK t ∧ ¬ OK t then cr t else .zero := ⟨_, fun _ => rfl⟩
  refine ⟨fun t => if PK t then cr t else cr' t, fun tw htw => ?_, fun t m ht hm0 hpf hor => ?_, ?_⟩
  · obtain ⟨m, hm', hdb, hc⟩ := hC' tw htw
    refine ⟨m, hm', hdb, ?_⟩
    by_cases hp : PK tw
    · obtain ⟨m1, hm1, -, hor⟩ := hkeep tw htw hp
      rw [hm'] at hm1; cases hm1
      simp only [hp, ite_true]; exact hor
    · simp only [hp, ite_false]; exact Or.inl hc
  · have hp : PK t := (hPK t).2 ⟨m, hm0, hpf, hor⟩
    simp only [hp, ite_true]
  · have h1 : ∀ t, t ∈ s'.promises → (if PK t then cr t else cr' t) ≤ cr' t + d t := by
      intro t ht
      rw [hd t]
      by_cases hp : PK t
      · have e1 : (if PK t then cr t else cr' t) = cr t := by simp only [hp, ite_true]
        rw [e1]
        by_cases ho : OK t
        · have e2 : (if PK t ∧ ¬ OK t then cr t else Res.zero) = Res.zero := by
            split
            · next h => exact absurd ho h.2
            · rfl
          rw [e2, Res.add_zero]
          obtain ⟨m0, hm0, ho0⟩ := (hOK t).1 ho
          obtain ⟨m1, hm1, hpf1, -⟩ := (hPK t).1 hp
          rw [hm0] at hm1; cases hm1
          obtain ⟨m, hm', -, hc⟩ := hC' t ht
          rw [hpre t (hlt t ht), hm0] at hm'; cases hm'
          rw [OldCr_uniq (OldCr_pub hF hQ hx (hlt t ht) hpf1 ho0) hc]
          exact Res.le_refl _
        · have e2 : (if PK t ∧ ¬ OK t then cr t else Res.zero) = cr t := by
            split
            · rfl
            · next h => exact absurd ⟨hp, ho⟩ h
          rw [e2]
          exact Res.le_def.2 fun k => by simp only [Res.add_apply]; omega
      · have e1 : (if PK t then cr t else cr' t) = cr' t := by simp only [hp, ite_false]
        have e2 : (if PK t ∧ ¬ OK t then cr t else Res.zero) = Res.zero := by
          split
          · next h => exact absurd h.1 hp
          · rfl
        rw [e1, e2, Res.add_zero]
        exact Res.le_refl _
    have h2 : ∀ t, t ∈ s.promises → dropP E s cr t + d t ≤ cr t := by
      intro t _
      rw [hd t]
      by_cases hy : PK t ∧ ¬ OK t
      · have e2 : (if PK t ∧ ¬ OK t then cr t else Res.zero) = cr t := by
          split
          · rfl
          · next h => exact absurd hy h
        have e : dropP E s cr t = .zero := by
          unfold dropP
          split
          · next h => exact absurd ((hOK t).2 h) hy.2
          · rfl
        rw [e2, e, Res.zero_add]
        exact Res.le_refl _
      · have e2 : (if PK t ∧ ¬ OK t then cr t else Res.zero) = Res.zero := by
          split
          · next h => exact absurd h hy
          · rfl
        rw [e2, Res.add_zero]
        exact dropP_le t
    have a1 := sum_map_le _ h1
    have a2 := sum_map_split (f := fun t => cr' t + d t) (g := cr') (h := d) (fun _ => rfl) s'.promises
    have a3 := sum_sub_le (f := d) hnd hx.prom
    have a4 := sum_map_le _ h2
    have a5 := sum_map_split (f := fun t => dropP E s cr t + d t) (g := dropP E s cr) (h := d) (fun _ => rfl) s.promises
    intro k
    have b1 := a1 k; have b2 := congrArg (fun R : Res => R k) a2; have b3 := a3 k; have b4 := a4 k
    have b5 := congrArg (fun R : Res => R k) a5
    simp only [pSum, Res.add_apply] at b1 b2 b3 b4 b5 ⊢
    omega
