  obtain ⟨P0, hWP, hlP, hP0⟩ := pickOldF hFl hFj hlow hgap hol hrd
  obtain ⟨Ra, Rp, hent, hkeep, hVp, hacc⟩ := heldPieceF0L hent0 hC hsto hf hcpl hniU hclo hat hini hna hus hone
    hiniW hinR htyc hvn hVn hln hmem2 hsub2 hFl hFm hFj hpr2 hcm hlP hP0 hwB hW2 hW3 hGnd hGit hGcov
  exact ⟨Ra, P0, Rp, hent, hkeep, hWP, hVp, hacc⟩
