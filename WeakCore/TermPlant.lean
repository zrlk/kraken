theorem heldPieceFL {E : TEnv} {s s2 : St} {cr db : Ts → Res} {lab : AllocLabel} {c : Cell} {f : Ts}
    {b : Nat} {U : Ty} {us : List Acc} {wsn old : List Word} {Rs0 : List Res} {Rv : Res} {F : List Ts} {wB : Ts}
    {Gs : List (Ts × Nat × Ty × List Word × Res × (Nat → Bool))} {coh1 : Address → Ts} {V : Ts}
    (hent0 : HeldEntryL E s lab Rs0)
