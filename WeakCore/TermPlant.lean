/-- (D3) The fulfilled promises are the lowest own ones at their units, with no
message strictly between coherence and them there. -/
theorem lowGapF {s s2 : St} {lab : AllocLabel} {b : Nat} {us : List Acc} {wsn : List Word} {F : List Ts}
    {wB : Ts} {coh1 : Address → Ts}
    (hFl : F.length = nWords us) (hFm : ∀ t, t ∈ s.promises → t ∈ s2.promises ∨ t ∈ F)
    (hFj : ∀ (j : Nat) t, F[j]? = some t → t ∈ s.promises ∧ t ∉ s2.promises ∧ ∃ m w, s.mem[t]? = some m ∧
      wsn[j]? = some w ∧ m.loc = ⟨lab, b + j⟩ ∧ WLe1 w (mw m) ∧ coh1 ⟨lab, b + j⟩ < t ∧
      s2.vs.coh ⟨lab, b + j⟩ = t)
    (hpr2 : ∀ t, t ∈ s2.promises → ∀ m, s.mem[t]? = some m → s2.vs.coh m.loc < t)
    (hwB : ∀ (j : Nat) t, F[j]? = some t → t ≤ wB)
    (hW2 : ∀ t m, s.mem[t]? = some m → m.loc.label = lab → s.vs.coh m.loc < t → t ≤ wB → t ∈ s.promises) :
    (∀ (j : Nat) t, F[j]? = some t → LowOwn s ⟨lab, b + j⟩ t) ∧
    (∀ (j : Nat) t, F[j]? = some t → ∀ t' m', s.mem[t']? = some m' → m'.loc = ⟨lab, b + j⟩ →
      s.vs.coh ⟨lab, b + j⟩ < t' → t' < t → False) := by
  have haddr : ∀ j j', (⟨lab, b + j⟩ : Address) = ⟨lab, b + j'⟩ → j = j' := fun j j' e =>
    Nat.add_left_cancel (congrArg WeakMem.Address.offset e)
  have hFlt : ∀ j t, F[j]? = some t → j < nWords us := fun j t h => by
    rw [← hFl]; exact (List.getElem?_eq_some_iff.mp h).1
  have hFex : ∀ j, j < nWords us → ∃ t, F[j]? = some t := fun j hj =>
    ⟨F[j]'(by rw [hFl]; exact hj), List.getElem?_eq_getElem _⟩
  have hFinj : ∀ j j' t, F[j]? = some t → F[j']? = some t → j = j' := fun j j' t h h' => by
    obtain ⟨-, -, m, -, hm, -, hl, -⟩ := hFj j t h
    obtain ⟨-, -, m', -, hm', -, hl', -⟩ := hFj j' t h'
    rw [hm] at hm'; cases hm'
    exact haddr _ _ (hl.symm.trans hl')
  have hlow : ∀ j t, F[j]? = some t → LowOwn s ⟨lab, b + j⟩ t := by
    intro j t hj
    obtain ⟨h1, -, m, -, hm, -, hl, -, -, hc2⟩ := hFj j t hj
    refine ⟨h1, ⟨m, hm, hl⟩, fun t' m' ht' hm' hl' => ?_⟩
    rcases hFm t' ht' with h | h
    · have := hpr2 t' h m' hm'
      rw [hl', hc2] at this; exact Nat.le_of_lt this
    · obtain ⟨j', hj'⟩ := List.mem_iff_getElem?.mp h
      obtain ⟨-, -, m'', -, hm'', -, hl'', -⟩ := hFj j' t' hj'
      rw [hm'] at hm''; cases hm''
      have := haddr _ _ (hl'.symm.trans hl''); subst this
      rw [hj] at hj'; cases hj'; exact Nat.le_refl _
  have hgap : ∀ j t, F[j]? = some t → ∀ t' m', s.mem[t']? = some m' → m'.loc = ⟨lab, b + j⟩ →
      s.vs.coh ⟨lab, b + j⟩ < t' → t' < t → False := by
    intro j t hj t' m' hm' hl' hc ht
    have hin := hW2 t' m' hm' (by rw [hl']) (by rw [hl']; exact hc)
      (Nat.le_trans (Nat.le_of_lt ht) (hwB j t hj))
    exact absurd ((hlow j t hj).2.2 t' m' hin hm' hl') (Nat.not_le.mpr ht)
  exact ⟨hlow, hgap⟩

/-- (D3) The fulfilled promises' predecessors, below the words read. -/
theorem pickOldF {s s2 : St} {lab : AllocLabel} {b : Nat} {us : List Acc} {wsn old : List Word}
    {F : List Ts} {coh1 : Address → Ts} {V : Ts}
    (hFl : F.length = nWords us)
    (hFj : ∀ (j : Nat) t, F[j]? = some t → t ∈ s.promises ∧ t ∉ s2.promises ∧ ∃ m w, s.mem[t]? = some m ∧
      wsn[j]? = some w ∧ m.loc = ⟨lab, b + j⟩ ∧ WLe1 w (mw m) ∧ coh1 ⟨lab, b + j⟩ < t ∧
      s2.vs.coh ⟨lab, b + j⟩ = t)
    (hlow : (∀ (j : Nat) t, F[j]? = some t → LowOwn s ⟨lab, b + j⟩ t))
    (hgap : (∀ (j : Nat) t, F[j]? = some t → ∀ t' m', s.mem[t']? = some m' → m'.loc = ⟨lab, b + j⟩ →
      s.vs.coh ⟨lab, b + j⟩ < t' → t' < t → False))
    (hol : old.length = nWords us)
    (hrd : ∀ (j : Nat) w, old[j]? = some w → ∃ (tm : Ts) (m : Msg), s.mem[tm]? = some m ∧ m.loc = ⟨lab, b + j⟩ ∧
      WeakMem.hiddenFrom s.mem ⟨lab, b + j⟩ tm (max V (s.vs.coh ⟨lab, b + j⟩)) = false ∧ WLe1 (mw m) w ∧
      tm ≤ coh1 ⟨lab, b + j⟩) :
    ∃ P0, WLe P0 old ∧ P0.length = nWords us ∧ ∀ (o : Nat) w, P0[o]? = some w → ∀ t, F[o]? = some t → PredAt s.mem ⟨lab, b + o⟩ t w := by
  have hFex : ∀ j, j < nWords us → ∃ t, F[j]? = some t := fun j hj =>
    ⟨F[j]'(by rw [hFl]; exact hj), List.getElem?_eq_getElem _⟩
  obtain ⟨P0, hWP, hP0⟩ := exists_WLe_pickD
    (P := fun o w => ∀ t, F[o]? = some t → PredAt s.mem ⟨lab, b + o⟩ t w) old (fun o v hv => by
      obtain ⟨tm, m, hm, hl, hh, hle1, htm⟩ := hrd o v hv
      have ho : o < nWords us := by rw [← hol]; exact (List.getElem?_eq_some_iff.mp hv).1
      obtain ⟨t, ht⟩ := hFex o ho
      obtain ⟨-, -, -, -, -, -, -, -, hc1, -⟩ := hFj o t ht
      have hpd : PredAt s.mem ⟨lab, b + o⟩ t (mw m) :=
        pred_of_rd (P := s.promises) (coh := s.vs.coh ⟨lab, b + o⟩)
          (fun t' m' hm' hl' hc ht' => (hgap o t ht t' m' hm' hl' hc ht').elim)
          (fun t' m' ht' hm' hl' hlt' => absurd ((hlow o t ht).2.2 t' m' ht' hm' hl') (Nat.not_le.mpr hlt'))
          hh (Nat.le_max_right _ _) hm hl (Nat.lt_of_le_of_lt htm hc1)
      exact ⟨mw m, hle1, fun t' ht' => by rw [ht] at ht'; cases ht'; exact hpd⟩)
  exact ⟨P0, hWP, by rw [hWP.length, hol], hP0⟩

/-- (D3) A list of picks. -/
theorem exists_list_pick {P : Nat → Word → Prop} : ∀ n, (∀ j, j < n → ∃ w, P j w) →
    ∃ L : List Word, L.length = n ∧ ∀ j w, L[j]? = some w → P j w
  | 0, _ => ⟨[], rfl, fun j w h => by simp at h⟩
  | n + 1, h => by
      obtain ⟨w, hw⟩ := h 0 (Nat.succ_pos n)
      obtain ⟨L, hl, hL⟩ := exists_list_pick (P := fun j w => P (j + 1) w) n (fun j hj => h (j + 1) (by omega))
      refine ⟨w :: L, by simp [hl], fun j w' hj => ?_⟩
      rcases j with _ | j
      · simp only [List.getElem?_cons_zero, Option.some.injEq] at hj; subst hj; exact hw
      · exact hL j w' (by simpa using hj)

/-- (D3) Without a read: the fulfilled promises' predecessors are the coherence
messages. -/
theorem pickCohF {s : St} {lab : AllocLabel} {b : Nat} {us : List Acc} {F : List Ts}
    (hcoh : ∀ j, j < nWords us → ∃ m, s.mem[s.vs.coh ⟨lab, b + j⟩]? = some m ∧ m.loc = ⟨lab, b + j⟩)
    (hc1 : ∀ (j : Nat) t, F[j]? = some t → s.vs.coh ⟨lab, b + j⟩ < t)
    (hgap : (∀ (j : Nat) t, F[j]? = some t → ∀ t' m', s.mem[t']? = some m' → m'.loc = ⟨lab, b + j⟩ →
      s.vs.coh ⟨lab, b + j⟩ < t' → t' < t → False)) :
    ∃ P0 : List Word, P0.length = nWords us ∧ ∀ (o : Nat) w, P0[o]? = some w → ∀ t, F[o]? = some t → PredAt s.mem ⟨lab, b + o⟩ t w :=
  exists_list_pick (P := fun o w => ∀ t, F[o]? = some t → PredAt s.mem ⟨lab, b + o⟩ t w) (nWords us)
    (fun j hj => by
      obtain ⟨m, hm, hl⟩ := hcoh j hj
      exact ⟨mw m, fun t ht => ⟨_, m, hc1 j t ht, hm, hl, rfl,
        fun t' m' h1 h2 h3 h4 => hgap j t ht t' m' h3 h4 h1 h2⟩⟩)

/-- (D3) `LatestNP` along skip sets agreeing at the address's messages. -/
theorem LatestNP_congr {mem : Memory} {P P' : List Ts} {a : Address} {w : Word}
    (h : ∀ t m, mem[t]? = some m → m.loc = a → (t ∈ P' ↔ t ∈ P)) (hl : LatestNP mem P a w) :
    LatestNP mem P' a w := by
  obtain ⟨t, m, ht, hm, hla, hw, hlast⟩ := hl
  exact ⟨t, m, fun h' => ht ((h t m hm hla).mp h'), hm, hla, hw,
    fun t' m' hlt hm' hl' => (h t' m' hm' hl').mpr (hlast t' m' hlt hm' hl')⟩

