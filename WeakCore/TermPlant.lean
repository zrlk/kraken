  have hT0 := hT
  rw [ht] at hT0
  cases hT0 with
  | let_ hop _ =>
  cases hop with
  | storeWordGive hp hw | storeWordKeep hp hw | storeWordHand hp hw =>
    obtain ⟨μ, hteq⟩ := wordOf_cases hw
    exact fulP_wordStore ht hp hteq hi.1 hE htv r hr
  | storeOwn hp hnw hc =>
    exfalso
    rcases cell_cases hc with rfl | rfl
    · exact hO (.inr ⟨_, _, _, _, _, _, _, ht, .inl ⟨hp, hnw⟩⟩)
    · exact hO (.inr ⟨_, _, _, _, _, _, _, ht, .inr ⟨hp, hnw⟩⟩)
  | storePub hp hnw hc =>
    exfalso
    rcases cell_cases hc with rfl | rfl
    · exact hps ⟨_, _, _, _, _, _, _, ht, .inl ⟨hp, hnw⟩⟩
    · exact hps ⟨_, _, _, _, _, _, _, ht, .inr ⟨hp, hnw⟩⟩
  | storeRgn hp _ hc | storeCap hp _ hc =>
    exfalso
    rcases hsc with hs | hs
    · rw [ht] at hs
      exact hs _ hp _ _ hc
    · rw [ht] at hs
      simp only [StepScopeR, OpScopeR] at hs
#print axioms TermPlant.fulP_stepK

/-- (option 3) `mc_ofPLGQ` from `ThInvMPLQX`: the store's credit surplus `Y` is paid on the left. -/
theorem mc_ofPLGQX {Q : TEnv → Prop} {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem mem' : Memory}
    {pairs pairs' : List Ts} {th th' : TTh} {η : TEnv} {Tot H' Y Rf Rs H X : Res} {cr db : Ts → Res}
    (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hK : ThInvMPLQX Q p g (CE η) (stOf mem pairs th) Sp mem' pairs' th' Tot H' Y) (hle : Tot + H' + Y + X ≤ Rf + Rs + H) :
    ∃ Tot H' C F, ThInvMCFSQ Q p g (CE η) (stOf mem pairs th) Sp mem' pairs' th' Tot H' cr db ∧
      MintStepN g η (stOf mem pairs th) (stOf mem' pairs' th') C F ∧
      Tot + H' + pSum (stOf mem' pairs' th') cr + pSum (stOf mem pairs th) db + C + X ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf mem' pairs' th') db + F := by
  obtain ⟨E, hq, hF, hSK, hBV, hT, hm', hH', hP⟩ := hK
  obtain ⟨hC', e⟩ := hP cr db hC
  refine ⟨Tot, H', .zero, .zero, ⟨E, hq, hF, (by seenT), (by boxT), hT, hm', hH', hC'⟩, .none, ?_⟩
  intro k
  have h1 := hle k
  have h2 := e k
  simp only [Res.add_apply, Res.zero_apply] at h1 h2 ⊢
  omega
#print axioms TermPlant.mc_ofPLGQX

/-- (OvW3 G-b) `mc_ofPLG` keeping `Q` on the witness (`ThInvMPLQ`).  (Corollary of `mc_ofPLGQX` at `Y = 0`.) -/
theorem mc_ofPLGQ {Q : TEnv → Prop} {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem mem' : Memory}
    {pairs pairs' : List Ts} {th th' : TTh} {η : TEnv} {Tot H' Rf Rs H X : Res} {cr db : Ts → Res}
    (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hK : ThInvMPLQ Q p g (CE η) (stOf mem pairs th) Sp mem' pairs' th' Tot H') (hle : Tot + H' + X ≤ Rf + Rs + H) :
    ∃ Tot H' C F, ThInvMCFSQ Q p g (CE η) (stOf mem pairs th) Sp mem' pairs' th' Tot H' cr db ∧
      MintStepN g η (stOf mem pairs th) (stOf mem' pairs' th') C F ∧
      Tot + H' + pSum (stOf mem' pairs' th') cr + pSum (stOf mem pairs th) db + C + X ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf mem' pairs' th') db + F := by
  obtain ⟨E, hq, a1, a2, a3, a4, a5, a6, a7⟩ := hK
  exact mc_ofPLGQX (Y := .zero) hC ⟨E, hq, a1, a2, a3, a4, a5, a6, CrPackLe_X a7⟩
    (Res.le_def.2 fun k => by have e := hle k; simp only [Res.add_apply, Res.zero_apply] at e ⊢; omega)
#print axioms TermPlant.mc_ofPLGQ

/-- (KeepQX) **Plant-credit frame, any leaving promises**: `PlantCr_frame` with the
thread's promises allowed to shrink anywhere.  The access set shrinks to the units whose
words keep their lowest window promise (`K` is existential in `PlantCr`), so the credit
and its value are unchanged. -/
theorem PlantCr_frameK {E E' : TEnv} {s s' : St} {m : Msg} {tw : Ts} {R : Res}
    (hpre : ∀ t, t < s.mem.size → s'.mem[t]? = s.mem[t]?) (hsz : s.mem.size ≤ s'.mem.size)
    (hpr : ∀ t, t ∈ s'.promises → t ∈ s.promises)
    (hP : ∀ t, t ∈ s.promises → t < s.mem.size)
    (hsto : E'.sto m.loc.label = E.sto m.loc.label) (htid : E'.tid = E.tid)
    (hpf : E.pfr m.loc.label ≠ none → E'.pfr m.loc.label ≠ none) (hwu : WordUnit E' m.loc → WordUnit E m.loc)
    (hF : ∀ t, t < s.mem.size → t ∈ FpAt E' ⟨m.loc.label, 0⟩ → t ∈ FpAt E ⟨m.loc.label, 0⟩)
    (hV : ∀ S ws R0, ValOfR E S ws R0 → ValOfR E' S ws R0)
    (h : PlantCr E s m tw R) : PlantCr E' s' m tw R := by
  classical
  obtain ⟨c, sb, S0, b0, S, us, wb, hsto0, hown, hpf0, hseg, hat, hS, hwu0, hus, hn, hlo, hhi, htw, hwb, hfa,
    hlow, hR⟩ := h
  refine ⟨c, sb, S0, b0, S, us, wb, by rw [hsto]; exact hsto0, by rw [htid]; exact hown, hpf hpf0, hseg, hat, hS,
    fun h => hwu0 (hwu h), hus, hn, hlo, hhi, htw, Nat.lt_of_lt_of_le hwb hsz, fun tf mf h1 h2 h3 => ?_,
    fun t' m' h1 h2 h3 h4 h5 h6 => ?_, ?_⟩
  · by_cases hts : tf < s.mem.size
    · rw [hpre tf hts] at h2
      exact hfa tf mf (hF tf hts h1) h2 h3
    · exact Nat.lt_of_lt_of_le hwb (Nat.le_of_not_lt hts)
  · have h1' := hpr t' h1
    rw [hpre t' (hP t' h1')] at h2
    exact hlow t' m' h1' h2 h3 h4 h5 h6
  · rcases hR with ⟨K, ws, R0, hl, hv, hle, hp⟩ | e
    · refine Or.inl ⟨fun i => decide (K i = true ∧ ∀ o t', InAcc us i o →
          LowestIn s'.mem (winL wb s'.promises) ⟨m.loc.label, sb + b0 + o⟩ t' →
          LowestIn s.mem (winL wb s.promises) ⟨m.loc.label, sb + b0 + o⟩ t'), ws, R0, hl, hV S ws R0 hv, hle,
        fun i o w t' hK hI hw hL => ?_⟩
      obtain ⟨hK1, hK2⟩ := of_decide_eq_true hK
      have hL1 := hK2 o t' hI hL
      exact PredAt_mono (hP t' (mem_winL.1 hL1.1).1) hpre (hp i o w t' hK1 hI hw hL1)
    · exact Or.inr e
#print axioms PlantCr_frameK

/-- (KeepQX) **A plant credit survives a thread step** (off `publish` or not): the step's
footprint (`EFoot`) keeps the cell, its frontier, the owner and values' resources; memory
only grows; the thread's promises only shrink (`PlantCr_frameK`). -/
theorem PlantCr_step {g : G} {E E' : TEnv} {s s' : St} {m : Msg} {tw : Ts} {R : Res}
    (hF : EFoot g E E' s s') (hm : MemInv g E s) (hx : TermLiveProps.Ext s s')
    (h : PlantCr E s m tw R) : PlantCr E' s' m tw R := by
  obtain ⟨hp, ht, hs, hb, hi, hpf, -, -, hfp, hri, -, -, -, -, -, -⟩ := hF
  have hstoE : ∀ l c, E.sto l = some c → E'.sto l = some c := fun l c hc => by
    rcases hs l with e | ⟨hfr, -⟩
    · rw [e]; exact hc
    · rw [(fresh_blank hm hfr).1] at hc; cases hc
  have hpfE : ∀ l f, E.pfr l = some f → E'.pfr l = some f := fun l f hf => by
    rcases hpf l with e | ⟨e, -⟩ | ⟨-, e, -⟩
    · rw [e]; exact hf
    · rw [e] at hf; cases hf
    · rw [e] at hf; cases hf
  have hbE : ∀ l B, E.box l = some B → E'.box l = some B := fun l B hB => by
    rcases hb l with e | ⟨hfr, -⟩
    · rw [e]; exact hB
    · rw [(fresh_blank hm hfr).2.1] at hB; cases hB
  obtain ⟨c, -, -, -, -, -, -, hsto0, -, hpf0, -⟩ := id h
  have hsto : E'.sto m.loc.label = E.sto m.loc.label := by rw [hsto0]; exact hstoE _ _ hsto0
  refine PlantCr_frameK (fun t ht => hx.mem.get t ht) hx.mem.size hx.prom (fun t ht => hm.2.2.1 t ht) hsto ht
    (fun h0 => ?_) (fun ⟨c', hc', hw⟩ => ⟨c', by rw [← hsto]; exact hc', hw⟩) (fun t _ h1 => ?_)
    (fun S ws R0 hv => ValOfR_mono hp.symm ht.symm hstoE (fun l => (hi l).1) hv hpfE hbE hri) h
  · cases e : E.pfr m.loc.label with
    | none => exact absurd e h0
    | some f => rw [hpfE _ _ e]; exact Option.some_ne_none f
  · have hvis : Vis E m.loc.label := fun hpv => hpf0 hpv.2
    have h2 : t ∈ E'.fp := by
      unfold FpAt at h1; split at h1
      · exact h1
      · cases h1
    show t ∈ FpAt E ⟨m.loc.label, 0⟩
    unfold FpAt; simp only [hvis, ite_true, ← hfp]; exact h2
#print axioms PlantCr_step

set_option linter.unusedSimpArgs false in
/-- (PubKeep) A verbatim copy of `TermStep.tstepMR_publish`, exporting that the witness keeps the
cells and `ini` (the only changes: the conclusion's `ThInvMCFSQ` and three `fun _ => ⟨rfl, rfl⟩`). -/
theorem tstepMR_publishE {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {a : At} {e : Expr}
    {Rf Rs H : Res}
    (hterm : th.term = .let_ x (.publish a) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hsc : PubScope cx a)
    {cr db : Ts → Res} (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hwp : ∀ rt ws ad, evalAt th.env a = some (rt, ws) → ws.map (·.val) = [.loc ad 0] →
      FlipOK (CE η) (stOf mem pairs th) ad.label)
    (hwin : ∀ rt ws ad, evalAt th.env a = some (rt, ws) → ws.map (·.val) = [.loc ad 0] →
      NoHold (CE η) (stOf mem pairs th) ad.label)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hown1 : PubLe1 th Rf Rs H := by assumption)
    (hPb : ∀ y a e rt ws ad, th.term = .let_ y (.publish a) e → evalAt th.env a = some (rt, ws) →
      ws.map (·.val) = [.loc ad 0] → g.pf ad.label := by exact fun _ _ _ _ _ _ _ _ _ => trivial) (hDy : DyFr p annNew (progTgts p) η th.σs th.term) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      ∃ Tot H' cr' db' rt ws, evalAt th.env a = some (rt, ws) ∧
        (∀ ad g', ws.map (·.val) = [.loc ad g'] → η.sto ad.label ≠ none) ∧
        ThInvMCFSQ (fun E' => ∀ l, E'.sto l = (CE η).sto l ∧ E'.ini l = (CE η).ini l) p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr' db' ∧
        Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr' + pSum (stOf mem pairs th) db + ownW .own ws ≤
          Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db' := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | publish hu hsh hb =>
    obtain ⟨u, c₁, hu, hsh, hb⟩ : ∃ u c₁, cx.use a = .ok (.ptr .own u, c₁) ∧
        Ty.sharedOKIn c₁.ke (.ptr .pub u) = true ∧ c₁.bind x (.ptr .pub u) = .ok c' := ⟨_, _, hu, hsh, hb⟩
    obtain ⟨rt, ws, R0, Rr, hea, hv, hl, hvR, hi1R, hle⟩ := useR hu hi hE.2.2
    have hR0 := VRR_cell_R rfl hvR
    have hi1 := hi1R.1
    simp only [VR] at hv
    obtain ⟨⟨lab, off⟩, c, hws, hoff, hsto, hcty, hmode, hacc⟩ := hv
    simp only at hoff; subst hoff
    obtain ⟨pw, rfl, hpw⟩ : ∃ pw, ws = [pw] ∧ pw.val = .loc ⟨lab, 0⟩ 0 := by
      match ws, hws with
      | [pw], h => exact ⟨pw, rfl, by simpa using h⟩
      | [], h => simp at h
      | _ :: _ :: _, h => simp at h
    have hsk := hl.2.1
    rw [close_ptr] at hsk
    obtain ⟨ru, rfl, hsku⟩ : ∃ ru, rt = .ptr .own ru ∧ etok (skel ru) = etok (skel (close th.σs u)) := by
      cases rt <;> simp [skel, etok] at hsk
      case ptr μ ru =>
        cases μ <;> simp [skelM, etok] at hsk
        exact ⟨ru, rfl, hsk⟩
      case refine t ψ => unfold rf at hsk; split at hsk <;> simp [etok] at hsk
    have hown : c.owner = some η.tid := hmode
    have hx : Ext η (η.withSto η.sto η.ini (pubP η lab (stOf mem pairs th).vs.vWr) (pubS η lab)) :=
      Ext_withSto hE.2.1 (fun l c h => h) (fun _ => Nat.le_refl _) (pubP_mono η lab _) (fun l h => Or.inr h)
    have key : tstep g mem pairs th =
        [((fenceS (stOf mem pairs th) .st).mem, (fenceS (stOf mem pairs th) .st).pairs,
          withS { th with term := e, env := (x, .ptr .pub ru, [pw]) :: th.env } (fenceS (stOf mem pairs th) .st))] := by
      simp only [tstep, hterm, evalOp, hea]; rfl
    rw [key]
    refine ⟨by simp, fun r hr hpa0 => ?_⟩
    simp only [List.mem_singleton] at hr
    subst hr
    have hvr : VR ρ (η.withSto η.sto η.ini (pubP η lab (stOf mem pairs th).vs.vWr) (pubS η lab))
        (.ptr .pub u) (shp (.ptr .pub ru)) [pw] := by
      simp only [VR]
      exact ⟨⟨lab, 0⟩, c, hws, rfl, hsto, hcty,
        ⟨(η.pfr lab).getD (stOf mem pairs th).vs.vWr, by simp [TEnv.withSto, pubP], Or.inl (Or.inl rfl)⟩, hacc⟩
    have hlay : Lay th.σs (.ptr .pub u) (.ptr .pub ru) [pw] :=
      ⟨fun us h => by simp [accs] at h; subst h; rfl, by rw [close_ptr]; simp only [skel, etok, hsku],
        by simp [wc, accs], ⟨⟨lab, 0⟩, hws⟩, by
          simp only [close, substTs, lyt, etok]; rw [(cell_lyt hl.2.2.2.2 rfl rfl).2]; rfl⟩
    have hE' : EnvOK p (η.withSto η.sto η.ini (pubP η lab (stOf mem pairs th).vs.vWr) (pubS η lab)) :=
      ⟨hE.1, hx.1, hx.2.2.2.2.2.2.2.2.2.2.1⟩
    have hvz : VRR ρ (η.withSto η.sto η.ini (pubP η lab (stOf mem pairs th).vs.vWr) (pubS η lab))
        (.ptr .pub u) (shp (.ptr .pub ru)) [pw] .zero := by
      simp only [VR] at hvr; simp only [VRR]; exact ⟨hvr, rfl⟩
    have hfr := bindR hb (FInvR_ext hE.2.1 hE.2.2 hx hi1R) (RLink_of hE'.2.1 hE'.2.2) hvz hlay
    rw [Res.add_zero] at hfr
    have hpa : PromAbove (stOf mem pairs th) := fun t ht m hm' => hpa0 t ht m hm'
    obtain ⟨H', cr', db', ⟨S', hH'L, hSK⟩, hC', heq⟩ :=
      MemHeld_pubS (V := (stOf mem pairs th).vs.vWr) (S := pubS η lab) hm hH hC hpa (hwp _ _ ⟨lab, 0⟩ hea (by simp [hpw])) hfo
        ⟨c, hsto, hown⟩
    have hHn : MemHeldK (CE η) (stOf mem pairs th) Sp (CE (η.withSto η.sto η.ini (pubP η lab (stOf mem pairs th).vs.vWr) (pubS η lab)))
        (fenceS (stOf mem pairs th) .st) H' := ⟨S', MemHeldL_eqs hH'L rfl rfl, hSK.toT _ _⟩
    have hCn : PromCr (CE (η.withSto η.sto η.ini (pubP η lab (stOf mem pairs th).vs.vWr) (pubS η lab)))
        (fenceS (stOf mem pairs th) .st) cr' db' :=
      PromCr_keep hC' rfl (MemInv_promLt hm) (fun _ _ => rfl) (fun _ _ _ _ => rfl)
    have hleT : Rr + Rs + H' + pSum (stOf mem pairs th) cr' + pSum (stOf mem pairs th) db + ownW .own [pw] ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf mem pairs th) db' :=
      Res.le_def.2 fun k => by
        have h1 := Res.le_def.1 hle k
        have h2 := congrArg (fun R : Res => R k) heq
        have h3 := congrArg (fun R : Res => R k) hR0
        simp only [Res.add_apply] at h1 h2 h3 ⊢; omega
    exact ⟨Rr + Rs, H', cr', db', _, [pw], hea,
      (fun ad g' h => by simp only [List.map_cons, List.map_nil, hpw] at h; cases h; simp [hsto]), ⟨CE (η.withSto η.sto η.ini (pubP η lab (stOf mem pairs th).vs.vWr) (pubS η lab)), fun _ => ⟨rfl, rfl⟩,
      EFoot_pub (hgp := hPb x a e _ _ ⟨lab, 0⟩ hterm hea (by simp [hpw])) rfl rfl rfl rfl rfl ⟨c, hsto, hown⟩ (fun _ => rfl) (fun _ => Iff.rfl) (hwin _ _ ⟨lab, 0⟩ hea (by simp [hpw])).2.2,
      SeenOK_pubS (pub_zero (ad := ⟨lab, 0⟩) hleT (PromCr_own0 hC _).1 (PromCr_own0 hC' _).2
        (g0 := 0) (by simp [hpw]) (hown1 _ _ _ hterm _ _ ⟨lab, 0⟩ 0 hea (by simp [hpw]))),
      (by boxT), ⟨ρ, η.withSto η.sto η.ini (pubP η lab (stOf mem pairs th).vs.vWr) (pubS η lab), c', Rr, Rs, rfl, hE', ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0), hDy.letW hterm rfl⟩,
      MemInv_publish (E := CE η) (hF := PubWin_of_NoHold (E := CE η) hm hsto hown (hwin _ _ ⟨lab, 0⟩ hea (by simp [hpw]))) hm hsto hown rfl rfl rfl rfl rfl rfl rfl (fun b S hseg _ => by
        obtain ⟨-, rfl⟩ := SegOf_lay hacc hseg
        have hcu : Ty.coupledOKIn c₁.ke u = true := by
