          obtain ⟨hfp, Tot, H', C, F, h1, h2, h3⟩ := hPL.2 r' hr' hpa' (hq'.1 hOF) hq'.2
          exact ⟨Tot, H', C, F, [], h1.mono fun _ hq => ⟨⟨hq.1, hq.2.2⟩, fun y hy => absurd hy List.not_mem_nil,
            RepinCovU_biP ⟨x, b, i, v, e, rti, wi, _, ht, hei, hn, hnr⟩, hfp, hq.2.1⟩, h2,
            by rw [List.map_nil, Res.sum_nil, Res.add_zero]; exact h3⟩⟩).2 r hr hpa ⟨rfl, hq⟩
    exact ⟨Tot, H', C, F, cr', db', Gd, plh, h1.mono fun _ hk => ⟨hk.1.1, hk.2, hk.1.2⟩, h2⟩
  refine mapQ8_mono (I := fun r Tot H' C F cr' db' Gd plh =>
      ThInvMCFSQK (fun E' => BiOut th E' ∧ KeepQRS (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th cr cr' plh)
