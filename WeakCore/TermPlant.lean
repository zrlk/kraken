/-- (H) Setting a zero entry of a list of resources adds the new one to the sum. -/
theorem sum_set_zero : ∀ (Rs : List Res) (j : Nat) (x : Res), Rs[j]? = some .zero →
    Res.sum (Rs.set j x) = Res.sum Rs + x
  | [], j, x, h => by simp at h
  | r :: rs, 0, x, h => by
      simp only [List.getElem?_cons_zero, Option.some.injEq] at h
      subst h
      simp only [List.set_cons_zero, Res.sum_cons]
      exact Res.ext fun k => by simp only [Res.add_apply, Res.zero_apply]; omega
  | r :: rs, j + 1, x, h => by
      simp only [List.getElem?_cons_succ] at h
      simp only [List.set_cons_succ, Res.sum_cons, sum_set_zero rs j x h, Res.add_assoc]
#print axioms sum_set_zero

/-- (H) **Raising a buffer's real count past slot `j`**: the slot's clause becomes a value;
at a zero-width element it was nothing and becomes the value `Rz` on no words. -/
theorem BufOKR_raise {E E' : TEnv} {n j : Nat} {T : Ty} {vals : List Word} {R0 Rz : Res}
    (f : ∀ {U : Ty} {vs : List Word} {Rq : Res}, ValOfR E U vs Rq → ValOfR E' U vs Rq) (hjn : j < n)
    (hb : BufOKR E n j T vals R0)
    (hz : ∀ N e us, T = .array (.lit N) e → accs e = some us →
      (0 < nWords us → Rz = .zero) ∧ (nWords us = 0 → ValOfR E' e [] Rz)) :
    BufOKR E' n (j + 1) T vals (R0 + Rz) := by
  obtain ⟨N, e, us, Rs, hT, hu, hn, hl, hRs, hR, hsl⟩ := hb
  obtain ⟨hz1, hz2⟩ := hz N e us hT hu
  by_cases hw : 0 < nWords us
  · rw [hz1 hw, Res.add_zero]
    refine ⟨N, e, us, Rs, hT, hu, hn, hl, hRs, hR, fun j' Rj h1 h2 => ?_⟩
    have h := hsl j' Rj h1 h2
    exact ⟨fun _ h0 => absurd h0 (by omega), fun _ => f (h.2 (Or.inr hw))⟩
  · have hw0 : nWords us = 0 := by omega
    have hjR : j < Rs.length := by omega
    have hRj : Rs[j]? = some .zero := by
      rw [List.getElem?_eq_getElem hjR]
      exact congrArg some ((hsl j Rs[j] (by omega) (List.getElem?_eq_getElem hjR)).1 (Nat.le_refl _) hw0)
    refine ⟨N, e, us, Rs.set j Rz, hT, hu, hn, hl, by rw [List.length_set]; exact hRs,
      by rw [sum_set_zero Rs j Rz hRj, hR], fun j' Rj h1 h2 => ?_⟩
    rw [List.getElem?_set] at h2
    by_cases hjj : j = j'
    · subst hjj
      simp only [hjR, if_true, Option.some.injEq] at h2
      subst h2
      refine ⟨fun h => absurd h (by omega), fun _ => ?_⟩
      have e0 : (vals.drop (j * nWords us)).take (nWords us) = [] := by rw [hw0]; simp
      rw [e0]; exact hz2 hw0
    · simp only [hjj, if_false] at h2
      have h := hsl j' Rj h1 h2
      exact ⟨fun h3 h4 => h.1 (by omega) h4, fun h3 => f (h.2 (Or.inl (by omega)))⟩
#print axioms BufOKR_raise

/-- (U3, case b) **The entry of a predicted slot's cell across its `bufInit`**:
the store fulfils, at each unit of slot `j = rc`, the holder (the first write);
raising the real count to `j + 1` turns the slot's predicted units into plain
ones, and memory's reading of the cell is unchanged. -/
theorem predEntry {E E' : TEnv} {s s2 : St} {lab : AllocLabel} {c : Cell} {N j : Nat} {e : Ty}
    {us : List Acc} {R0 : Res} {F : List Ts} {wB : Ts}
    (hent : HeldEntry E s lab R0) (hsto : E.sto lab = some c) (hT : c.ty = .array (.lit N) e)
    (hus : accs e = some us)
    (hs : E'.sto = E.sto) (htid : E'.tid = E.tid) (hpf : E'.pfr = E.pfr) (hfp : E'.fp = E.fp)
    (hini : E'.ini = E.ini) (hrc : E'.rc lab = j + 1) (hrc0 : E.rc lab = j) (hjn : j < E.ini lab)
    (hv : ∀ {T : Ty} {vs : List Word} {R : Res}, ValOfR E T vs R → ValOfR E' T vs R)
    (hf : E.pfr lab ≠ none)
    (hmem2 : s2.mem = s.mem) (hsub2 : ∀ t, t ∈ s2.promises → t ∈ s.promises)
    (hFl : F.length = nWords us) (hFm : ∀ t, t ∈ s.promises → t ∈ s2.promises ∨ t ∈ F)
    (hFa : ∀ jj t, F[jj]? = some t → t ∈ s.promises ∧ ∃ m, s.mem[t]? = some m ∧
      m.loc = ⟨lab, j * nWords us + jj⟩ ∧ s.vs.coh m.loc < t ∧ s2.vs.coh m.loc = t ∧ LowOwn s m.loc t ∧ t ≤ wB)
    (hpr2 : ∀ t, t ∈ s2.promises → ∀ m, s.mem[t]? = some m → s2.vs.coh m.loc < t)
    (hW3 : ∀ t m, t ∈ FpAt E ⟨lab, 0⟩ → s.mem[t]? = some m → m.loc.label = lab → wB < t)
    {Rz : Res} (hz : 0 < nWords us → Rz = .zero) (hz0 : nWords us = 0 → ValOfR E' e [] Rz)
    (hbh : ∀ o, PredU E ⟨lab, o⟩ → ∃ h, FirstW s.mem ⟨lab, o⟩ h ∧ h ∈ s.promises ∧
      ∀ t m, t ∈ s.promises → s.mem[t]? = some m → m.loc = ⟨lab, o⟩ → s.vs.coh ⟨lab, o⟩ < t → h ≤ t) :
    HeldEntry E' s2 lab (R0 + Rz) := by
  classical
  obtain ⟨vals0, hL0, hC0⟩ := hent.2 c hsto
  have hsto' : E'.sto lab = some c := by rw [hs]; exact hsto
  have hFlt : ∀ jj t, F[jj]? = some t → jj < nWords us := fun jj t h => by
    rw [← hFl]; exact (List.getElem?_eq_some_iff.mp h).1
  -- a promise of `F` at unit `a` sits at the slot's unit `a`
  have hFat : ∀ t m o, s.mem[t]? = some m → m.loc = ⟨lab, o⟩ → t ∈ F →
      ∃ jj, F[jj]? = some t ∧ o = j * nWords us + jj := fun t m o hm hl ht => by
    obtain ⟨jj, hjj⟩ := List.mem_iff_getElem?.mp ht
    obtain ⟨-, m', hm', hl', -⟩ := hFa jj t hjj
    rw [hm] at hm'; cases hm'
    exact ⟨jj, hjj, congrArg WeakMem.Address.offset (hl.symm.trans hl')⟩
  have hFpE : ∀ o, FpAt E' ⟨lab, o⟩ = FpAt E ⟨lab, o⟩ := fun o => by
    unfold FpAt; rw [Vis_congr (l := lab) (by rw [hs]) htid (by rw [hpf]), hfp]
  have hlat : ∀ o v, vals0[o]? = some v → LatestNP s2.mem (PromAt E' s2 ⟨lab, o⟩) ⟨lab, o⟩ v := by
    intro o v hov
    rw [hmem2]
    refine LatestNP_congr (fun t m hm hl => ?_) (hL0 o v hov)
    have hVU : VisU E' ⟨lab, o⟩ ↔ VisU E ⟨lab, o⟩ := VisU_congr (by rw [hs]) htid (by rw [hpf])
    by_cases hvu : VisU E ⟨lab, o⟩
    · rw [PromAt_word hvu, PromAt_word (hVU.mpr hvu)]
    have hvu' : ¬ VisU E' ⟨lab, o⟩ := fun h => hvu (hVU.mp h)
    by_cases hsl : j * nWords us ≤ o ∧ o < j * nWords us + nWords us
    · -- a unit of the slot: predicted before, plain after
      obtain ⟨hsl1, hsl2⟩ := hsl
      have hq : PredU E ⟨lab, o⟩ := by
        refine ⟨hf, (IniW_cell hsto hT hus).mpr ?_, fun h => ?_⟩
        · have : (j + 1) * nWords us ≤ E.ini lab * nWords us := Nat.mul_le_mul_right _ hjn
          simp only [Nat.add_mul, Nat.one_mul] at this; exact Nat.lt_of_lt_of_le hsl2 this
        · have := (IniWr_cell hsto hT hus).mp h
          rw [hrc0] at this; exact absurd hsl1 (Nat.not_le.mpr this)
      have hnq' : ¬ PredU E' ⟨lab, o⟩ := fun h => h.2.2 ((IniWr_cell hsto' (by exact hT) hus).mpr (by
        rw [hrc, Nat.add_mul, Nat.one_mul]; exact hsl2))
      obtain ⟨h, hFW, hhP, hlow⟩ := hbh o hq
      have hjj : o - j * nWords us < nWords us := Nat.sub_lt_left_of_lt_add hsl1 hsl2
      obtain ⟨tw, htw⟩ : ∃ tw, F[o - j * nWords us]? = some tw :=
        ⟨_, List.getElem?_eq_getElem (by rw [hFl]; exact hjj)⟩
      obtain ⟨htwP, mw0, hmw, hlw, hcw, hc2, hLw, hwB⟩ := hFa _ tw htw
      have e0 : j * nWords us + (o - j * nWords us) = o := by omega
      rw [e0] at hlw
      rw [hlw] at hcw hc2 hLw
      have hhle : h ≤ tw := hlow tw mw0 htwP hmw hlw hcw
      obtain ⟨mh, hmh, hlh, -⟩ := hFW.1
      have htle : tw ≤ h := hLw.2.2 h mh hhP hmh hlh
      have heq : h = tw := Nat.le_antisymm hhle htle
      subst heq
      rw [PromAt_nword hvu' hnq', mem_PromAt_pred hvu hq, hFpE o, List.mem_append, List.mem_append]
      constructor
      · rintro (ht | ht)
        · refine ⟨Or.inl (hsub2 t ht), ⟨h, hFW, ?_⟩⟩
          have := hpr2 t ht m hm
          rw [hl, hc2] at this; exact this
        · refine ⟨Or.inr ht, ⟨h, hFW, ?_⟩⟩
          have := hW3 t m ht hm (by rw [hl])
          exact Nat.lt_of_le_of_lt hwB this
      · rintro ⟨ht | ht, h', hFW', hlt⟩
        · obtain rfl := FirstW_uniq hFW' hFW
          rcases hFm t ht with h2 | h2
          · exact Or.inl h2
          · obtain ⟨jj, hjj', ho⟩ := hFat t m o hm hl h2
            have e1 : jj = o - j * nWords us := by omega
            rw [e1, htw] at hjj'; cases hjj'
            exact absurd hlt (Nat.lt_irrefl _)
        · exact Or.inr ht
    · -- off the slot: the same kind of unit, the same skipped promises at `a`
      have hq : PredU E' ⟨lab, o⟩ ↔ PredU E ⟨lab, o⟩ := by
        have hiw : IniW E' ⟨lab, o⟩ ↔ IniW E ⟨lab, o⟩ := IniW_congrU (by rw [hs]) (by rw [hini])
        have hr' := IniWr_cell (o := o) hsto' (by exact hT) hus
        have hr0 := IniWr_cell (o := o) hsto hT hus
        rw [hrc, Nat.add_mul, Nat.one_mul] at hr'
        rw [hrc0] at hr0
        have hp' : E'.pfr lab = E.pfr lab := by rw [hpf]
        constructor
        · rintro ⟨h1, h2, h3⟩
          refine ⟨fun h => h1 (by rw [hp']; exact h), hiw.mp h2, fun h => h3 (hr'.mpr ?_)⟩
          have := hr0.mp h
          generalize j * nWords us = A at this ⊢; omega
        · rintro ⟨h1, h2, h3⟩
          refine ⟨fun h => h1 (by rw [← hp']; exact h), hiw.mpr h2, fun h => h3 (hr0.mpr ?_)⟩
          exact Nat.lt_of_not_le fun hle => hsl ⟨hle, hr'.mp h⟩
      have hP : t ∈ s2.promises ↔ t ∈ s.promises := by
        refine ⟨hsub2 t, fun ht => (hFm t ht).resolve_right fun h2 => ?_⟩
        obtain ⟨jj, hjj', ho⟩ := hFat t m o hm hl h2
        exact hsl ⟨by rw [ho]; exact Nat.le_add_right _ _,
          by rw [ho]; exact Nat.add_lt_add_left (hFlt jj t hjj') _⟩
      by_cases hq0 : PredU E ⟨lab, o⟩
      · rw [mem_PromAt_pred hvu' (hq.mpr hq0), mem_PromAt_pred hvu hq0, hFpE o, List.mem_append,
          List.mem_append, hP, hmem2]
      · rw [PromAt_nword hvu' (fun h => hq0 (hq.mp h)), PromAt_nword hvu hq0, hFpE o, List.mem_append,
          List.mem_append, hP]
  refine ⟨fun h => (by rw [hsto'] at h; cases h), fun c' hc' => ?_⟩
  rw [hsto'] at hc'; cases hc'
  refine ⟨vals0, hlat, ?_⟩
  rw [hini, hrc]
  rw [hrc0] at hC0
  rcases hC0 with ⟨hwc, -⟩ | hb
  · rw [hT] at hwc; simp [wc, accs] at hwc
  · refine Or.inr (BufOKR_raise hv hjn hb fun N' e' us' hT' hus' => ?_)
    rw [hT] at hT'; cases hT'
    rw [hus] at hus'; cases hus'
    exact ⟨hz, hz0⟩

theorem predEntryL {E E' : TEnv} {s s2 : St} {lab : AllocLabel} {c : Cell} {N j : Nat} {e : Ty}
    {us : List Acc} {Rs : List Res} {F : List Ts} {wB : Ts}
    (hent : HeldEntryL E s lab Rs) (hsto : E.sto lab = some c) (hT : c.ty = .array (.lit N) e)
    (hus : accs e = some us)
    (hs : E'.sto = E.sto) (htid : E'.tid = E.tid) (hpf : E'.pfr = E.pfr) (hfp : E'.fp = E.fp)
    (hini : E'.ini = E.ini) (hrc : E'.rc lab = j + 1) (hrc0 : E.rc lab = j) (hjn : j < E.ini lab)
    (hv : ∀ {T : Ty} {vs : List Word} {R : Res}, ValOfR E T vs R → ValOfR E' T vs R)
    (hf : E.pfr lab ≠ none)
    (hmem2 : s2.mem = s.mem) (hsub2 : ∀ t, t ∈ s2.promises → t ∈ s.promises)
    (hFl : F.length = nWords us) (hFm : ∀ t, t ∈ s.promises → t ∈ s2.promises ∨ t ∈ F)
    (hFa : ∀ jj t, F[jj]? = some t → t ∈ s.promises ∧ ∃ m, s.mem[t]? = some m ∧
      m.loc = ⟨lab, j * nWords us + jj⟩ ∧ s.vs.coh m.loc < t ∧ s2.vs.coh m.loc = t ∧ LowOwn s m.loc t ∧ t ≤ wB)
    (hpr2 : ∀ t, t ∈ s2.promises → ∀ m, s.mem[t]? = some m → s2.vs.coh m.loc < t)
    (hW3 : ∀ t m, t ∈ FpAt E ⟨lab, 0⟩ → s.mem[t]? = some m → m.loc.label = lab → wB < t)
    (hbh : ∀ o, PredU E ⟨lab, o⟩ → ∃ h, FirstW s.mem ⟨lab, o⟩ h ∧ h ∈ s.promises ∧
      ∀ t m, t ∈ s.promises → s.mem[t]? = some m → m.loc = ⟨lab, o⟩ → s.vs.coh ⟨lab, o⟩ < t → h ≤ t) :
    ∃ (wq : List Word) (Rj : Res), wq.length = nWords us ∧
      (∀ o w, wq[o]? = some w → LatestNP s.mem (PromAt E s ⟨lab, j * nWords us + o⟩) ⟨lab, j * nWords us + o⟩ w) ∧
      Rs[j]? = some Rj ∧ (0 < nWords us → ValOfR E e wq Rj) ∧ (nWords us = 0 → Rj = .zero) ∧
      ∀ Rj', ValOfR E' e wq Rj' → HeldEntryL E' s2 lab (Rs.set j Rj') := by
  classical
  obtain ⟨vals0, hL0, hC0⟩ := hent.2 c hsto
  have hsto' : E'.sto lab = some c := by rw [hs]; exact hsto
  have hFlt : ∀ jj t, F[jj]? = some t → jj < nWords us := fun jj t h => by
    rw [← hFl]; exact (List.getElem?_eq_some_iff.mp h).1
  -- a promise of `F` at unit `a` sits at the slot's unit `a`
  have hFat : ∀ t m o, s.mem[t]? = some m → m.loc = ⟨lab, o⟩ → t ∈ F →
      ∃ jj, F[jj]? = some t ∧ o = j * nWords us + jj := fun t m o hm hl ht => by
    obtain ⟨jj, hjj⟩ := List.mem_iff_getElem?.mp ht
    obtain ⟨-, m', hm', hl', -⟩ := hFa jj t hjj
    rw [hm] at hm'; cases hm'
    exact ⟨jj, hjj, congrArg WeakMem.Address.offset (hl.symm.trans hl')⟩
  have hFpE : ∀ o, FpAt E' ⟨lab, o⟩ = FpAt E ⟨lab, o⟩ := fun o => by
    unfold FpAt; rw [Vis_congr (l := lab) (by rw [hs]) htid (by rw [hpf]), hfp]
  have hlat : ∀ o v, vals0[o]? = some v → LatestNP s2.mem (PromAt E' s2 ⟨lab, o⟩) ⟨lab, o⟩ v := by
    intro o v hov
    rw [hmem2]
    refine LatestNP_congr (fun t m hm hl => ?_) (hL0 o v hov)
    have hVU : VisU E' ⟨lab, o⟩ ↔ VisU E ⟨lab, o⟩ := VisU_congr (by rw [hs]) htid (by rw [hpf])
    by_cases hvu : VisU E ⟨lab, o⟩
    · rw [PromAt_word hvu, PromAt_word (hVU.mpr hvu)]
    have hvu' : ¬ VisU E' ⟨lab, o⟩ := fun h => hvu (hVU.mp h)
    by_cases hsl : j * nWords us ≤ o ∧ o < j * nWords us + nWords us
    · -- a unit of the slot: predicted before, plain after
      obtain ⟨hsl1, hsl2⟩ := hsl
      have hq : PredU E ⟨lab, o⟩ := by
        refine ⟨hf, (IniW_cell hsto hT hus).mpr ?_, fun h => ?_⟩
        · have : (j + 1) * nWords us ≤ E.ini lab * nWords us := Nat.mul_le_mul_right _ hjn
          simp only [Nat.add_mul, Nat.one_mul] at this; exact Nat.lt_of_lt_of_le hsl2 this
        · have := (IniWr_cell hsto hT hus).mp h
          rw [hrc0] at this; exact absurd hsl1 (Nat.not_le.mpr this)
      have hnq' : ¬ PredU E' ⟨lab, o⟩ := fun h => h.2.2 ((IniWr_cell hsto' (by exact hT) hus).mpr (by
        rw [hrc, Nat.add_mul, Nat.one_mul]; exact hsl2))
      obtain ⟨h, hFW, hhP, hlow⟩ := hbh o hq
      have hjj : o - j * nWords us < nWords us := Nat.sub_lt_left_of_lt_add hsl1 hsl2
      obtain ⟨tw, htw⟩ : ∃ tw, F[o - j * nWords us]? = some tw :=
        ⟨_, List.getElem?_eq_getElem (by rw [hFl]; exact hjj)⟩
      obtain ⟨htwP, mw0, hmw, hlw, hcw, hc2, hLw, hwB⟩ := hFa _ tw htw
      have e0 : j * nWords us + (o - j * nWords us) = o := by omega
      rw [e0] at hlw
      rw [hlw] at hcw hc2 hLw
      have hhle : h ≤ tw := hlow tw mw0 htwP hmw hlw hcw
      obtain ⟨mh, hmh, hlh, -⟩ := hFW.1
      have htle : tw ≤ h := hLw.2.2 h mh hhP hmh hlh
      have heq : h = tw := Nat.le_antisymm hhle htle
      subst heq
      rw [PromAt_nword hvu' hnq', mem_PromAt_pred hvu hq, hFpE o, List.mem_append, List.mem_append]
      constructor
      · rintro (ht | ht)
        · refine ⟨Or.inl (hsub2 t ht), ⟨h, hFW, ?_⟩⟩
          have := hpr2 t ht m hm
          rw [hl, hc2] at this; exact this
        · refine ⟨Or.inr ht, ⟨h, hFW, ?_⟩⟩
          have := hW3 t m ht hm (by rw [hl])
          exact Nat.lt_of_le_of_lt hwB this
      · rintro ⟨ht | ht, h', hFW', hlt⟩
        · obtain rfl := FirstW_uniq hFW' hFW
          rcases hFm t ht with h2 | h2
          · exact Or.inl h2
          · obtain ⟨jj, hjj', ho⟩ := hFat t m o hm hl h2
            have e1 : jj = o - j * nWords us := by omega
            rw [e1, htw] at hjj'; cases hjj'
            exact absurd hlt (Nat.lt_irrefl _)
        · exact Or.inr ht
    · -- off the slot: the same kind of unit, the same skipped promises at `a`
      have hq : PredU E' ⟨lab, o⟩ ↔ PredU E ⟨lab, o⟩ := by
        have hiw : IniW E' ⟨lab, o⟩ ↔ IniW E ⟨lab, o⟩ := IniW_congrU (by rw [hs]) (by rw [hini])
        have hr' := IniWr_cell (o := o) hsto' (by exact hT) hus
        have hr0 := IniWr_cell (o := o) hsto hT hus
        rw [hrc, Nat.add_mul, Nat.one_mul] at hr'
        rw [hrc0] at hr0
        have hp' : E'.pfr lab = E.pfr lab := by rw [hpf]
        constructor
        · rintro ⟨h1, h2, h3⟩
          refine ⟨fun h => h1 (by rw [hp']; exact h), hiw.mp h2, fun h => h3 (hr'.mpr ?_)⟩
          have := hr0.mp h
          generalize j * nWords us = A at this ⊢; omega
        · rintro ⟨h1, h2, h3⟩
          refine ⟨fun h => h1 (by rw [← hp']; exact h), hiw.mpr h2, fun h => h3 (hr0.mpr ?_)⟩
          exact Nat.lt_of_not_le fun hle => hsl ⟨hle, hr'.mp h⟩
      have hP : t ∈ s2.promises ↔ t ∈ s.promises := by
        refine ⟨hsub2 t, fun ht => (hFm t ht).resolve_right fun h2 => ?_⟩
        obtain ⟨jj, hjj', ho⟩ := hFat t m o hm hl h2
        exact hsl ⟨by rw [ho]; exact Nat.le_add_right _ _,
          by rw [ho]; exact Nat.add_lt_add_left (hFlt jj t hjj') _⟩
      by_cases hq0 : PredU E ⟨lab, o⟩
      · rw [mem_PromAt_pred hvu' (hq.mpr hq0), mem_PromAt_pred hvu hq0, hFpE o, List.mem_append,
          List.mem_append, hP, hmem2]
      · rw [PromAt_nword hvu' (fun h => hq0 (hq.mp h)), PromAt_nword hvu hq0, hFpE o, List.mem_append,
          List.mem_append, hP]
  rw [hrc0] at hC0
  rcases hC0 with ⟨hwc, -⟩ | ⟨N', e', us', hT', hus', hn', hvl, hRl, hsl⟩
  · rw [hT] at hwc; simp [wc, accs] at hwc
  rw [hT] at hT'; cases hT'
  rw [hus] at hus'; cases hus'
  have hjR : j < Rs.length := by omega
  have hRj := List.getElem?_eq_getElem hjR
  have hslj := hsl j Rs[j] hjn hRj
  refine ⟨(vals0.drop (j * nWords us)).take (nWords us), Rs[j], ?_, fun o w hw => ?_, hRj,
    fun hw => hslj.2 (Or.inr hw), fun hw => hslj.1 (Nat.le_refl _) hw, fun Rj' hRj' => ?_⟩
  · have : (j + 1) * nWords us ≤ N * nWords us := Nat.mul_le_mul_right _ (by omega)
    rw [Nat.add_mul, Nat.one_mul] at this
    simp only [List.length_take, List.length_drop, hvl]; omega
  · rw [List.getElem?_take, List.getElem?_drop] at hw
    split at hw
    · exact hL0 _ _ hw
    · cases hw
  refine ⟨fun h => (by rw [hsto'] at h; cases h), fun c' hc' => ?_⟩
  rw [hsto'] at hc'; cases hc'
  refine ⟨vals0, hlat, Or.inr ⟨N, e, us, hT, hus, by rw [hini]; exact hn', hvl, by rw [List.length_set, hini]; exact hRl,
    fun j' Rj hj' hR => ?_⟩⟩
  rw [hini] at hj'
  rw [List.getElem?_set] at hR
  by_cases hjj : j = j'
  · subst hjj
    simp only [hjR, ite_true, Option.some.injEq] at hR
    subst hR
    exact ⟨fun h => absurd h (by rw [hrc]; omega), fun _ => hRj'⟩
  · simp only [hjj, ite_false] at hR
    have h := hsl j' Rj hj' hR
    rw [hrc]
    exact ⟨fun h3 h4 => h.1 (by omega) h4, fun h3 => hv (h.2 (by omega))⟩
#print axioms predEntryL

/-- (H) `DbRes_congr` with the designation's agreement in place of the real counts'. -/
theorem DbRes_congrD {E E' : TEnv} {mem : Memory} {m : Msg} {tw : Ts} {R : Res}
    (hs : E'.sto m.loc.label = E.sto m.loc.label) (ht : E'.tid = E.tid)
    (hp : E'.pfr m.loc.label = E.pfr m.loc.label) (hi : E'.ini m.loc.label = E.ini m.loc.label)
    (hb : ∀ l B, E.box l = some B → E'.box l = some B)
    (hD : DesigAt E' mem m.loc tw ↔ DesigAt E mem m.loc tw) (h : DbRes E mem m tw R) : DbRes E' mem m tw R := by
  rcases h with ⟨h1, h2, h3, h4⟩ | ⟨h1, h2⟩
  · refine Or.inl ⟨(Vis_congr hs ht hp).2 h1, (IniW_congr hs hi).2 h2, fun hI => ?_,
      fun hI => (WRes_congr hs).2 (h4 hI)⟩
    obtain ⟨R₁, Z, hF, hS, hZ, hR⟩ := h3 hI
    exact ⟨R₁, Z, (FRes_congr hs).2 hF, fun h' => BlkDb_mono hs hb (hS (hD.1 h')),
      fun h' => hZ (fun h'' => h' (hD.2 h'')), hR⟩
  · exact Or.inr ⟨by rw [Vis_congr hs ht hp, IniW_congr hs hi]; exact h1, h2⟩
#print axioms DbRes_congrD

/-- (U3, case b) Credits and debits read the environment only through store,
thread, frontier and `ini` (not `rini`). -/
theorem PromCr_congrI {E E' : TEnv} {s : St} {cr db : Ts → Res} (h : PromCr E s cr db)
    (hs : E'.sto = E.sto) (ht : E'.tid = E.tid) (hp : E'.pfr = E.pfr) (hi : E'.ini = E.ini)
    (hb : ∀ l B, E.box l = some B → E'.box l = some B)
    (hD : ∀ tw m, tw ∈ s.promises → s.mem[tw]? = some m → (DesigAt E' s.mem m.loc tw ↔ DesigAt E s.mem m.loc tw)) :
    PromCr E' s cr db := by
  intro tw htw
  obtain ⟨m, hm, hd, hc⟩ := h tw htw
  refine ⟨m, hm, DbRes_congrD (by rw [hs]) ht (by rw [hp]) (by rw [hi]) hb (hD tw m htw hm) hd, ?_⟩
  rcases hc with ⟨w, hw, hcw⟩ | hz
  · exact Or.inl ⟨w, hw, (VRes_congr (by rw [hs]) ht (by rw [hp]) (by rw [hi])).2 hcw⟩
  · exact Or.inr hz

/-- (U3, case b) `mc_ofFul` into a new environment `E'` that differs from `CE η`
off credits (`rini` only). -/
theorem mc_ofFulE {p : Prog} {g : G} {mem mem' : Memory} {pairs pairs' : List Ts} {th th' : TTh}
    {η : TEnv} {E' : TEnv} {Tot H' Rf Rs H : Res} {cr db : Ts → Res} {F : List Ts}
    (hC : PromCrP (CE η) (stOf mem pairs th) cr db)
    (hF : EFoot g (CE η) E' (stOf mem pairs th) (stOf mem' pairs' th'))
    (hs : E'.sto = (CE η).sto) (ht : E'.tid = (CE η).tid) (hp : E'.pfr = (CE η).pfr) (hi : E'.ini = (CE η).ini)
    (hT : ThInvRE p E' th' Tot) (hm' : MemInv g E' (stOf mem' pairs' th'))
    (hH' : MemHeld E' (stOf mem' pairs' th') H') (hmem : mem' = mem)
    (hsplit : ∀ f : Ts → Res, Res.sum (th.promises.map f) = Res.sum (th'.promises.map f) + Res.sum (F.map f))
    (hsub : ∀ t, t ∈ th'.promises → t ∈ th.promises)
    (hle : Tot + H' + Res.sum (F.map db) ≤ Rf + Rs + H + Res.sum (F.map cr))
    (hb : ∀ l B, (CE η).box l = some B → E'.box l = some B)
    (hD : ∀ tw m, tw ∈ th'.promises → mem[tw]? = some m → (DesigAt E' mem m.loc tw ↔ DesigAt (CE η) mem m.loc tw))
    (hse : E'.seen = (CE η).seen := by first | rfl | assumption)
    (hbx : ∀ l, E'.box l = (CE η).box l := by first | (intro _; rfl) | assumption) :
    ∃ Tot H' C F, ThInvMCF p g (CE η) (stOf mem pairs th) mem' pairs' th' Tot H' (dropP (CE η) (stOf mem pairs th) cr) db ∧
      MintStepN g η (stOf mem pairs th) (stOf mem' pairs' th') C F ∧
      Tot + H' + pSum (stOf mem' pairs' th') (dropP (CE η) (stOf mem pairs th) cr) + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf mem' pairs' th') db + F := by
  subst mem'
  have hC0 := PromCrP_drop hC
  have hC1 : PromCr (CE η) (stOf mem pairs' th') (dropP (CE η) (stOf mem pairs th) cr) db :=
    fun tw htw => hC0 tw (hsub tw htw)
  refine ⟨Tot, H', .zero, .zero, ⟨E', hF, (by seenT), (by boxT), hT, hm', hH', PromCr_congrI hC1 hs ht hp hi hb hD⟩, .none, ?_⟩
  have e1 := hsplit cr
  have e2 := hsplit db
  have h3 : pSum (stOf mem pairs' th') (dropP (CE η) (stOf mem pairs th) cr) ≤ pSum (stOf mem pairs' th') cr :=
    pSum_dropP_le
  intro k
  have h1 := hle k
  have h4 := h3 k
  have e1k := congrArg (fun R : Res => R k) e1
  have e2k := congrArg (fun R : Res => R k) e2
  simp only [pSum, stOf, Res.add_apply, Res.zero_apply] at h1 h4 e1k e2k ⊢
  omega

/-- (U3, case b) Sums along a list of indices against a list of pieces with
those indices. -/
theorem sum_pieces_le {β : Type} (dbW : Nat → Res) (h : Nat → β) :
    ∀ (L : List Nat) (G : List ((Nat × β) × Res)), G.map Prod.fst = L.map (fun j => (j, h j)) →
      (∀ g ∈ G, dbW g.1.1 ≤ g.2) → Res.sum (L.map dbW) ≤ Res.sum (G.map Prod.snd)
  | [], [], _, _ => fun k => Nat.le_refl _
  | [], _ :: _, e, _ => by simp at e
  | _ :: _, [], e, _ => by simp at e
  | j :: L, g :: G, e, hg => by
      simp only [List.map_cons, List.cons.injEq] at e
      have h1 := hg g List.mem_cons_self
      rw [e.1] at h1
      have h2 := sum_pieces_le dbW h L G e.2 (fun g' hg' => hg g' (List.mem_cons_of_mem _ hg'))
      intro k
      have := h1 k; have := h2 k
      simp only [List.map_cons, Res.sum_cons, Res.add_apply] at *
      omega

/-- (U3, case b) **The words of a value pay their debits**: a value holding `Rv`
covers, at distinct protocol-word units `L`, debits each at most the unit's
word resources (`wr + wdW`). -/
theorem wordsAcct {E : TEnv} {T : Ty} {us : List Acc} (hus : accs T = some us) {wsn : List Word} {Rv : Res}
    (hvn : VRR (fun _ => 0) (CE E) T (shp T) wsn Rv) (ln : wsn.length = nWords us)
    (L : List Nat) (hnd : L.Nodup) (dbW : Nat → Res) (kf : Nat → Nat) (Pf : Nat → Proto)
    (hW : ∀ j, j ∈ L → AtOff T j (.word (.lit (kf j)) (Pf j)) ∧ (Pf j).ghost = false ∧
      ∃ w0, wsn[j]? = some w0 ∧ dbW j ≤ wr (Pf j) (kf j) w0.val + wdW (Pf j) (kf j)) :
    Res.sum (L.map dbW) ≤ Rv := by
  let hf : Nat → Ty := fun j => .word (.lit (kf j)) (Pf j)
  have hL : ∀ p ∈ L.map (fun j => (j, hf j)), Piece T p.1 p.2 := by
    intro p hp
    obtain ⟨j, hj, rfl⟩ := List.mem_map.mp hp
    obtain ⟨hat, hg, -⟩ := hW j hj
    exact ⟨hat, Solid_word _ _, by rw [wc_word hg]; simp⟩
  have hnd' : (L.map (fun j => (j, hf j))).Nodup :=
    List.Pairwise.map _ (fun a b h e => h (Prod.mk.inj e).1) hnd
  obtain ⟨G, eG, Rr, hR, hG⟩ := VRR_pieces E (by rw [hus]; simp) hL hnd' hvn (by rw [wc_of_accs hus, ln])
  have hle : Res.sum (L.map dbW) ≤ Res.sum (G.map Prod.snd) := by
    refine sum_pieces_le dbW hf L G eG (fun g hg => ?_)
    have hg1 : g.1 ∈ L.map (fun j => (j, hf j)) := by rw [← eG]; exact List.mem_map_of_mem hg
    obtain ⟨j, hj, e1⟩ := List.mem_map.mp hg1
    obtain ⟨hat, hgh, w0, hw0, hdb⟩ := hW j hj
    obtain ⟨n, hn, hb, hv⟩ := hG g hg
    rw [← e1] at hn hb hv
    simp only [hf, wc_word hgh, Option.some.injEq] at hn
    subst hn
    have hsl : (wsn.drop j).take 1 = [w0] := by
      apply List.ext_getElem?; intro i
      rw [slice_get]
      by_cases hi : i < 1
      · rw [iteT hi]; obtain rfl : i = 0 := by omega
        simpa using hw0
      · rw [iteF hi]; simp; omega
    rw [hsl] at hv
    rw [← e1]
    exact Res.le_def.2 fun k => by
      have := Res.le_def.1 hdb k
      rw [VRR_word_wr hv]; exact this
  rw [hR]
  intro k
  have := hle k
  simp only [Res.add_apply]
  omega

/-- (U3, case b) **The fulfilled promises' debits are paid by the stored value**:
promise `F[j]` is at unit `b + j` of the stored component `U`, with the stored
word's value; its debit (`DbRes`: `wr`, or `wr + wdW` when it initialises the
unit, or nothing off protocol words) is at most that word's resources. -/
theorem dbF_le {E : TEnv} {s : St} {cr db : Ts → Res} {lab : AllocLabel} {c : Cell} {b : Nat} {U : Ty}
    {us : List Acc} {wsn : List Word} {Rv : Res} {F : List Ts}
    (hC : PromCrP E s cr db) (hsto : E.sto lab = some c) (hat : AtOff c.ty b U) (hus : accs U = some us)
    (hvn : VRR (fun _ => 0) (CE E.unsee) U (shp U) wsn Rv) (hln : wsn.length = nWords us)
    (hFl : F.length = nWords us)
    (hFj : ∀ j t, F[j]? = some t → t ∈ s.promises ∧ ∃ m w, s.mem[t]? = some m ∧ wsn[j]? = some w ∧
      m.loc = ⟨lab, b + j⟩ ∧ (mw m).val = w.val)
    (hnq : ∀ j t, F[j]? = some t → ¬ PredU E ⟨lab, b + j⟩) :
    Res.sum (F.map db) ≤ Rv := by
  classical
  let L : List Nat := (List.range (nWords us)).filter fun j => decide (∃ n P, WordAt E ⟨lab, b + j⟩ n P)
  have hLmem : ∀ j, j ∈ L ↔ j < nWords us ∧ ∃ n P, WordAt E ⟨lab, b + j⟩ n P := fun j => by
    simp only [L, List.mem_filter, List.mem_range, decide_eq_true_iff]
  have hLnd : L.Nodup := List.Nodup.sublist (List.filter_sublist ..) List.nodup_range
  have hFex : ∀ j, j < nWords us → ∃ t, F[j]? = some t ∧ F.getD j 0 = t := fun j hj => by
    refine ⟨F[j]'(by rw [hFl]; exact hj), List.getElem?_eq_getElem _, ?_⟩
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by rw [hFl]; exact hj)]; rfl
  have hS : Res.sum (F.map db) = Res.sum (L.map fun j => db (F.getD j 0)) := by
    rw [sum_idx db F, hFl]
    refine sum_filt _ _ (fun j hj hp => ?_)
    obtain ⟨t, ht, hgd⟩ := hFex j (List.mem_range.mp hj)
    rw [hgd]
    obtain ⟨htw, m, w, hm, -, hl, -⟩ := hFj j t ht
    obtain ⟨m', hm', hdb, -⟩ := hC t htw
    rw [hm] at hm'; cases hm'
    refine DbRes_noword hdb (fun n P hw => ?_) (fun hD => hnq j t ht (hl ▸ hD.1))
    rw [hl] at hw
    have hex : ∃ n P, WordAt E ⟨lab, b + j⟩ n P := ⟨n, P, hw⟩
    first | exact absurd (decide_eq_true hex) (by rw [hp]; exact Bool.false_ne_true) | (simp only [decide_eq_false_iff_not, decide_eq_true_eq, Bool.not_eq_true] at hp; exact absurd hex hp) | exact absurd hex hp
  rw [hS]
  rcases hL0 : L with _ | ⟨j0, L'⟩
  · exact fun k => Nat.zero_le _
  obtain ⟨-, n0, P0, -⟩ := (hLmem j0).mp (by rw [hL0]; exact List.mem_cons_self)
  let kf : Nat → Nat := fun j => if h : ∃ n P, WordAt E ⟨lab, b + j⟩ n P then Classical.choose h else n0
  let Pf : Nat → Proto := fun j =>
    if h : ∃ n P, WordAt E ⟨lab, b + j⟩ n P then Classical.choose (Classical.choose_spec h) else P0
  have hkP : ∀ j, (∃ n P, WordAt E ⟨lab, b + j⟩ n P) → WordAt E ⟨lab, b + j⟩ (kf j) (Pf j) := fun j h => by
    simp only [kf, Pf, h, dite_true]; exact Classical.choose_spec (Classical.choose_spec h)
  rw [← hL0]
  refine wordsAcct (E := E.unsee) hus hvn hln L hLnd _ kf Pf (fun j hj => ?_)
  obtain ⟨hjn, hex⟩ := (hLmem j).mp hj
  obtain ⟨c', hc', hatc, hg⟩ := hkP j hex
  rw [hsto] at hc'; cases hc'
  have hatU : AtOff U j (.word (.lit (kf j)) (Pf j)) := by
    rcases AtOff_nest (Solid_word _ _) (accs_word hg) hat hus hatc with h' | h' | ⟨-, h'⟩
    · first | omega | (simp [nWords, Acc.size] at h'; omega) | simp [nWords, Acc.size] at h'
    · change b + nWords us ≤ b + j at h'; omega
    · change AtOff U (b + j - b) _ at h'; rwa [Nat.add_sub_cancel_left] at h'
  obtain ⟨t, ht, hgd⟩ := hFex j hjn
  obtain ⟨htw, m, w, hm, hw, hl, hv⟩ := hFj j t ht
  refine ⟨hatU, hg, w, hw, ?_⟩
  rw [hgd]
  obtain ⟨m', hm', hdb, -⟩ := hC t htw
  rw [hm] at hm'; cases hm'
  have hWA : WordAt E m.loc (kf j) (Pf j) := by rw [hl]; exact ⟨c, hsto, hatc, hg⟩
  rcases hdb with ⟨-, -, h3, h4⟩ | ⟨-, h0⟩
  · by_cases hI : InitAt s.mem m.loc t
    · obtain ⟨R₁, Z, hF, -, hZ, hR⟩ := h3 hI
      rw [hR, hZ (fun hD => hnq j t ht (hl ▸ hD.1)), Res.add_zero]
      rcases hF with ⟨n, P, hw', e⟩ | ⟨hn, -⟩
      · obtain ⟨rfl, rfl⟩ := WordAt_uniq hw' hWA
        rw [e, hv]; exact fun k => Nat.le_refl _
      · exact absurd hWA (hn _ _)
    · rw [WRes_eq_wr hWA (h4 hI), hv]
      intro k; simp only [Res.add_apply]; omega
  · rw [h0]; exact Res.zero_le _

/-- (U3, case b) A whole-buffer locative into a held cell: the cell is that
buffer, at offset `0`. -/
theorem bufCell {E : TEnv} {s : St} {R0 : Res} {c : Cell} {a : Address} {N : Nat} {e : Ty}
    {ini : AllocLabel → Nat}
    (hent : HeldEntry E s a.label R0) (hsto : E.sto a.label = some c) (hat : AtOff c.ty a.offset (.array (.lit N) e))
    (hini : IniAt ini c a (.array (.lit N) e)) :
    c.ty = .array (.lit N) e ∧ a.offset = 0 := by
  obtain ⟨vals, -, hcR⟩ := hent.2 c hsto
  obtain ⟨N', e', usB, Rl, hT, -⟩ : BufOKR E (E.ini a.label) (E.rc a.label) c.ty vals R0 := by
    rcases hcR with ⟨hwc, hv⟩ | hb
    · exfalso
      obtain ⟨n', _, _, hwn, -⟩ := VRR_at E.unsee hat hv.1 hwc
      simp [wc, accs] at hwn
    · exact hb
  rcases hini N' e' hT with ⟨hUc, h0⟩ | ⟨us', j', o', hus', -, -, hato⟩
  · exact ⟨hUc.symm, h0.symm⟩
  · exact (accs_AtOff hato (by rw [hus']; simp) (by simp [accs])).elim

/-- (H) **The paid fulfil of a predicted slot** (decision (A); the caller discharges it
from `PaidB`): at the own buffer `l` with element `e`, for any value `ws` of the slot at `rc`
holding `Rv`, fulfilled by the slot's first writes `F` (unit by unit, with `ws`'s values), the
fulfilled debits are at most `Rv` plus their credits. -/
def SlotPay (E : TEnv) (s : St) (cr db : Ts → Res) (l : AllocLabel) : Prop :=
  ∀ c N e us (F : List Ts) (ws : List Word) (Rv : Res),
    E.sto l = some c → c.ty = .array (.lit N) e → accs e = some us →
    F.length = nWords us → ws.length = nWords us →
    VRR (fun _ => 0) (CE E.unsee) e (shp e) ws Rv →
    (∀ o t, F[o]? = some t → t ∈ s.promises ∧ ∃ m x, s.mem[t]? = some m ∧ ws[o]? = some x ∧
      m.loc = ⟨l, E.rc l * nWords us + o⟩ ∧ m.val = x.val ∧ FirstW s.mem m.loc t) →
    Res.sum (F.map db) ≤ Rv + Res.sum (F.map cr)

set_option maxHeartbeats 3200000 in
/-- (U3, case b) **`bufInit` at the predicted slot of an own frontier buffer,
fulfilling** (slot `j = rc < ini`): the slot's units are predicted (`PredU`)
before and plain after; the environment bumps `rini` past `j` (`ini` is
unchanged, so the promise credits transfer by congruence). The buffer's held
entry is unchanged (`predEntry`); the fulfilled promises' debits are paid by the
stored value (`dbF_le`), and their credits are dropped. -/
theorem tstepMCF_bufInitP {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {b i v : At} {e : Expr} {Rf Rs H : Res}
    {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.bufInit b i v) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeld (CE η) (stOf mem pairs th) H) (hC : PromCrP (CE η) (stOf mem pairs th) cr db)
    (hfr : ∀ rt w ad, evalAt th.env b = some (rt, [w]) → w.val = .loc ad 0 → (CE η).pfr ad.label ≠ none)
    (hjr : ∀ rt w ad rti wi n, evalAt th.env b = some (rt, [w]) → w.val = .loc ad 0 →
      evalAt th.env i = some (rti, [wi]) → numOf [wi] = some n →
      (CE η).rc ad.label ≤ n)
    (hb1 : ∀ rt w ad rti wi n, evalAt th.env b = some (rt, [w]) → w.val = .loc ad 0 →
      evalAt th.env i = some (rti, [wi]) → numOf [wi] = some n →
      (CE η).rc ad.label ≤ n → n < (CE η).ini ad.label)
    {Ok : Memory × List Ts × TTh → Prop}
    (hpo : ∀ lab c, (CE η).sto lab = some c → c.owner = some (CE η).tid → (CE η).pfr lab ≠ none → OpTgt th lab →
      PlantOp g mem pairs th (CE η) cr Ok lab c)
    (hbh : ∀ rt w ad, evalAt th.env b = some (rt, [w]) → w.val = .loc ad 0 →
      ∀ o, PredU (CE η) ⟨ad.label, o⟩ → ∃ h, FirstW (stOf mem pairs th).mem ⟨ad.label, o⟩ h ∧
      h ∈ (stOf mem pairs th).promises ∧ ∀ t m, t ∈ (stOf mem pairs th).promises →
        (stOf mem pairs th).mem[t]? = some m → m.loc = ⟨ad.label, o⟩ →
        (stOf mem pairs th).vs.coh ⟨ad.label, o⟩ < t → h ≤ t)
    (hpay : ∀ rt w ad, evalAt th.env b = some (rt, [w]) → w.val = .loc ad 0 →
      SlotPay (CE η) (stOf mem pairs th) cr db ad.label)
    (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hZ : ZOK g (CE η) th := by exact fun _ _ h => False.elim h) (hDy : DyFr p annNew (progTgts p) η th.σs th.term) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → r.1 = mem → Ok r →
      ∃ Tot H' C F, ThInvMCF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 Tot H'
          (dropP (CE η) (stOf mem pairs th) cr) db ∧
        MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
        Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) (dropP (CE η) (stOf mem pairs th) cr) +
            pSum (stOf mem pairs th) db + C ≤
          Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | bufInit hu hbuf hint heq hlt hu2 hsub hb =>
  obtain ⟨t, tv, u, n, k, j, c₁, c₂, hu, hbuf, hint, heq, hlt, hu2, hsub, hb⟩ : ∃ t tv u n k j c₁ c₂,
      cx.use b = .ok (t, c₁) ∧ bufOf t = some (.own, n, u, k) ∧ IntIdx c₁ i j ∧ EqI c₁ j k ∧
      LtI c₁ k n ∧ c₁.use v = .ok (tv, c₂) ∧ SubS c₂ tv u ∧
      c₂.bind x (.refine (.loc .own (.array n u)) (.ini (.add k (.lit 1)))) = .ok c' :=
    ⟨_, _, _, _, _, _, _, _, hu, hbuf, hint, heq, hlt, hu2, hsub, hb⟩
  have ht : t = .refine (.loc .own (.array n u)) (.ini k) := by
    unfold bufOf at hbuf; split at hbuf
    · simp only [Option.some.injEq, Prod.mk.injEq] at hbuf
      obtain ⟨h1, rfl, rfl, rfl⟩ := hbuf; subst h1; rfl
    · simp at hbuf
  subst ht
  have htu := use_TvOK hu htv
  obtain ⟨rb, wsb, Rb, Rr1, hea, hvb, hlb, hvrb, hi1, hle1⟩ := useR hu hi hE.2.2
  have hRb := VRR_buf_R hbuf hvrb
  obtain ⟨rv, wsv, Rv, Rr2, hev, hvv, hlv, hvrv, hi2, hle2⟩ := useR hu2 hi1 hE.2.2
  have hJK : ev ρ j = ev ρ k := heq ρ hi1.1.1
  have hKN : ev ρ k < ev ρ n := hlt ρ hi1.1.1
  obtain ⟨ti, hpi, hti⟩ := hint
  obtain ⟨rti, wsi, hei, hvi, -⟩ := peek_VR hi1.1.2.1 hpi
  obtain ⟨wi, rfl, hwi⟩ := map_singleton (VR_intS hti hvi)
  have hvb0 := hvb
  simp only [VR] at hvb
  obtain ⟨hv, hir⟩ := hvb
  rcases hv with ⟨-, e0, he0⟩ | ⟨ad, c, U, hws, hsto, hat0, hFU, hown, hini0⟩
  · have he0 := Fd_nonmu he0 (fun b => by simp [cl])
    simp only [cl, clI_zero, Ty.array.injEq, Idx.lit.injEq] at he0
    omega
  obtain rfl := Fd_nonmu hFU (fun b => by simp [cl])
  obtain ⟨w, rfl, hwv⟩ := map_singleton hws
  have hni : numOf [wi] = some (ev ρ j) := by simp [numOf, hwi]
  have hjr1 : η.rc ad.label ≤ ev ρ j := hjr rb w ad rti wi (ev ρ j) hea hwv hei hni
  have hKm : ev ρ k ≤ η.rc ad.label := by
    simp only [IniR] at hir; have h := hir ad (by simp [hwv]); rw [TEnv.selIni_loc] at h; exact h
  have hjrc : ev ρ j = η.rc ad.label := by omega
  have hjI : ev ρ j < η.ini ad.label := hb1 rb w ad rti wi (ev ρ j) hea hwv hei hni (by show η.rc ad.label ≤ ev ρ j; omega)
  have hjrc' : ev ρ j = min (η.ini ad.label) (η.rini ad.label) := hjrc
  have hjI' : ev ρ j < η.ini ad.label := hjI
  have hat := hat0
  have hini := hini0
  simp only [cl, clI_zero] at hat hini
  have hs' : etok (skel rb) = rf (.loc (skelM .own) (.array (.lit 0) (etok (skel (close th.σs u))))) := by
    rw [hlb.2.1]; rfl
  obtain ⟨μr, nr, ur, ψ, rfl, -, hsu⟩ := buf_runtime' hs'
  have htb1 : tb c₁.ke.length u = true := by
    have h := htu.2.1
    rw [← htu.2.2] at h
    simp [tb] at h
    exact h
  have ho : c₁.opaqueOK u = true :=
    sub_opaqueOK hsub (peek_opaqueOK htu.1 (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu2).1)
  have hsig : sig ur = sig (cl ρ η.wit 0 0 u) := by
    have e1 : sig ur = sig (close th.σs u) := sig_of_eskel hsu
    rw [e1]; exact sig_WitL hi1.1.2.2.2.1 ρ ho (lt_of_guardT htb1 hi1.1.2.2.2.2.1)
  obtain ⟨us0, hus0⟩ : ∃ us, accs (cl ρ η.wit 0 0 u) = some us := by
    rcases AtOff_lay hat with h | ⟨n', e', he', h⟩
    · simp [accs] at h
    · simp only [Ty.array.injEq] at he'; rw [he'.2]
      exact Option.ne_none_iff_exists'.1 h
  obtain ⟨us, hus⟩ : ∃ us, accs ur = some us := by
    have : wc ur ≠ none := by rw [wc_of_sig hsig]; simp [wc, hus0]
    cases h : accs ur with
    | none => simp [wc, h] at this
    | some us => exact ⟨us, rfl⟩
  have hweA : accs (cl ρ η.wit 0 0 u) = some us := (accs_rtW hE.2.1 hi1.1.2.2.2.1 hi1.1.2.2.2.2.1 ho htb1 (buf_lyt hlb.2.2.2.2 rfl).2).symm.trans hus
  obtain ⟨hval, hlen⟩ :=
    ownStoreVal (cx := c₁) hE.2.1 hi1.1.2.2.2.1 hi1.1.2.2.2.2.1 hi2.1.1 hsub ho htb1 hvv hlv hsig hus
  have hvalR := storeValR (cx := c₁) hE.2.1 hE.2.2 hi1.1.2.2.2.1 hi1.1.2.2.2.2.1 hi2.1.1 hsub ho htb1
    hvrv hlv hval.2
  have hJN : ev ρ j < ev ρ n := by omega
  obtain ⟨R0, H0, rfl, hent0, hX⟩ := MemHeld_focus hH ad.label
  obtain ⟨hTc, hoff⟩ := bufCell hent0 hsto hat hini
  obtain ⟨A, hA⟩ : ∃ A, offs ad (ev ρ j * nWords us) = A := ⟨_, rfl⟩
  have hAe : A = ⟨ad.label, ev ρ j * nWords us⟩ := by rw [← hA]; simp [offs, hoff]
  have hAl : A.label = ad.label := by rw [hAe]
  have hstoA : η.sto A.label = some c := by rw [hAl]; exact hsto
  have hpfA : (CE η).pfr A.label ≠ none := by rw [hAl]; exact hfr _ w ad hea hwv
  have hatA : AtOff c.ty A.offset (cl ρ η.wit 0 0 u) := by
    have h := AtOff_trans hat (.elem hweA hJN (.here (Or.inl (by rw [hweA]; simp))))
    rw [← hA]; simpa [offs] using h
  -- the environment: `rini` bumped past `j`
  let rini' := bumpIni η.rini ad.label (ev ρ j + 1)
  have hri' : ∀ l, η.rini l ≤ rini' l := bumpIni_le _ _ _
  have hx : Ext η (η.withSto η.sto η.ini (Ri := rini')) :=
    Ext_withSto hE.2.1 (fun l c h => h) (fun l => Nat.le_refl _) (Ri := rini') (hRi := hri')
  have hmono : ∀ {T : Ty} {vs : List Word} {Rq : Res}, ValOfR (CE η) T vs Rq →
      ValOfR (CE (η.withSto η.sto η.ini (Ri := rini'))) T vs Rq :=
    fun hv0 => ValOfR_mono (η₁ := CE η) (η₂ := CE (η.withSto η.sto η.ini (Ri := rini'))) rfl rfl (fun l c h => h) (fun l => Nat.le_refl _) hv0 (hri := hri')
  let rtR : Ty := Ty.refine (Ty.loc μr (Ty.array nr ur)) (Pred.ini (Idx.lit (ev ρ j + 1)))
  have key : tstep g mem pairs th =
      (storeUnits g.k g.arch w A false us wsv 0 (stOf mem pairs th)).map fun s' =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, rtR, [w]) :: th.env } s') := by
    rw [← hA]
    simp only [tstep, hterm, evalOp, hea, hei, hev, numOf, hwi, addrOf, hwv, bufElem, hus, List.map_map]; rfl
  have htg : OpTgt th A.label := ⟨b, _, w, ad, 0, by rw [hterm]; rfl, hea, hwv, hAl.symm⟩
  obtain ⟨wB, Gs, hW1, hW2, hW3, -, -, -⟩ := hpo A.label c hstoA hown hpfA htg
  rw [key] at hW1 ⊢
  obtain ⟨s0, hs0⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := w) (a := A) (rel := false)
    us wsv 0 (stOf mem pairs th) hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hs0), fun r hr hpr0 hful hok => ?_⟩
  have hr' := hr
  have hpr := hpr0
  rw [List.mem_map] at hr
  obtain ⟨s2, hs2, rfl⟩ := hr
