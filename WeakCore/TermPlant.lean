/-- (D3) **The fulfilling swap of a piece at an own frontier cell, held**: the
cell's entry after the swap holds `Ra`; with the value read's `Rp` and the
fulfilled promises' debts, no more than the entry before, the new value, and
the fulfilled promises' credits. -/
theorem heldPieceF0 {E : TEnv} {s s2 : St} {cr db : Ts → Res} {lab : AllocLabel} {c : Cell} {f : Ts}
    {b : Nat} {U : Ty} {us : List Acc} {wsn P0 : List Word} {R0 Rv : Res} {F : List Ts} {wB : Ts}
    {Gs : List (Ts × Nat × Ty × List Word × Res × (Nat → Bool))} {coh1 : Address → Ts}
    (hent0 : HeldEntry E s lab R0)
    (hC : PromCrP E s cr db) (hsto : E.sto lab = some c) (hf : E.pfr lab = some f)
    (hcpl : Ty.coupledOKIn [] c.ty = true) (hniU : noIallV U = true)
    (hclo : Clo c.ty) (hat : AtOff c.ty b U) (hini : IniAt E.ini c ⟨lab, b⟩ U)
    (hna : ∀ N e, U ≠ .array (.lit N) e) (hus : accs U = some us) (hone : ∀ u, u ∈ us → u = .one)
    (hiniW : ∀ j, j < nWords us → IniW E ⟨lab, b + j⟩)
    (hinR : ∀ j, j < nWords us → InitRr E c lab (b + j))
    (htyc : ∀ j, j < nWords us → VisU E ⟨lab, b + j⟩ → ∃ m, s.mem[s.vs.coh ⟨lab, b + j⟩]? = some m ∧
      m.loc = ⟨lab, b + j⟩ ∧ ∀ k P, AtOff c.ty (b + j) (.word (.lit k) P) → P.ghost = false →
        pwf P = true ∧ ∃ x, m.val = .num x ∧ InP P x)
    (hvn : VRR (fun _ => 0) (CE E.unsee) U (shp U) wsn Rv) (hVn : Valid U wsn) (hln : wsn.length = nWords us)
    (hmem2 : s2.mem = s.mem) (hsub2 : ∀ t, t ∈ s2.promises → t ∈ s.promises)
    (hFl : F.length = nWords us) (hFm : ∀ t, t ∈ s.promises → t ∈ s2.promises ∨ t ∈ F)
    (hFj : ∀ (j : Nat) t, F[j]? = some t → t ∈ s.promises ∧ t ∉ s2.promises ∧ ∃ m w, s.mem[t]? = some m ∧
      wsn[j]? = some w ∧ m.loc = ⟨lab, b + j⟩ ∧ WLe1 w (mw m) ∧ coh1 ⟨lab, b + j⟩ < t ∧
      s2.vs.coh ⟨lab, b + j⟩ = t)
    (hpr2 : ∀ t, t ∈ s2.promises → ∀ m, s.mem[t]? = some m → s2.vs.coh m.loc < t)
    (hcm : ∀ a, s.vs.coh a ≤ coh1 a) (hlP : P0.length = nWords us)
    (hP0 : ∀ (o : Nat) w, P0[o]? = some w → ∀ t, F[o]? = some t → PredAt s.mem ⟨lab, b + o⟩ t w)
    (hwB : ∀ (j : Nat) t, F[j]? = some t → t ≤ wB)
    (hW2 : ∀ t m, s.mem[t]? = some m → m.loc.label = lab → s.vs.coh m.loc < t → t ≤ wB → t ∈ s.promises)
    (hW3 : ∀ t m, t ∈ FpAt E ⟨lab, 0⟩ → s.mem[t]? = some m → m.loc.label = lab → wB < t)
    (hGnd : (Gs.map (·.1)).Nodup) (hGit : ∀ x ∈ Gs, CrItem E s cr lab c x)
    (hGcov : ∀ o tw, InitRr E c lab o → ¬ VisU E ⟨lab, o⟩ → LowOwn s ⟨lab, o⟩ tw → tw ≤ wB → OverT E s ⟨lab, o⟩ tw →
      ∃ x ∈ Gs, ∃ usS i, accs x.2.2.1 = some usS ∧ x.2.1 ≤ o ∧ InAcc usS i (o - x.2.1) ∧
        x.2.2.2.2.2 i = true) :
    ∃ Ra Rp, HeldEntry E s2 lab Ra ∧ VRR (fun _ => 0) (CE E.unsee) U (shp U) P0 Rp ∧
      Ra + Rp + Res.sum (F.map db) ≤ R0 + Rv + Res.sum (F.map cr) := by
  obtain ⟨vals0, hL0, hC0⟩ := hent0.2 c hsto
  rcases own_segR (a := ⟨lab, b⟩) hC0 hat hini hna with
    ⟨bS, oS, S, wS, Rs, Rr, -, hbo, hatS, hwS, hbw, hR0, ⟨hvs, hVs⟩, hput⟩ | ⟨-, -, -, -, -, -, -, hz0⟩
  rotate_left
  · -- a zero-width slot: nothing is fulfilled, nothing read, the entry is unchanged
    obtain rfl := nWords_zero_nil (hz0 _ hus)
    have hF0 : F = [] := List.eq_nil_of_length_eq_zero (by simpa [nWords] using hFl)
    have hP00 : P0 = [] := List.eq_nil_of_length_eq_zero (by simpa [nWords] using hlP)
    have hw0 : wsn = [] := List.eq_nil_of_length_eq_zero (by simpa [nWords] using hln)
    subst hF0 hP00 hw0
    have hlat : ∀ (o : Nat) v, vals0[o]? = some v →
        LatestNP s2.mem (PromAt E s2 ⟨lab, o⟩) ⟨lab, o⟩ v := by
      intro o v hov
      rw [hmem2]
      refine LatestNP_congr (fun t m hm hl => ?_) (hL0 o v hov)
      by_cases hvu : VisU E ⟨lab, o⟩
      · rw [PromAt_word hvu, PromAt_word hvu]
      · have key : t ∈ s2.promises ++ FpAt E ⟨lab, o⟩ ↔ t ∈ s.promises ++ FpAt E ⟨lab, o⟩ := by
          rw [List.mem_append, List.mem_append]
          constructor
          · rintro (h | h)
            · exact Or.inl (hsub2 t h)
            · exact Or.inr h
          · rintro (h | h)
            · rcases hFm t h with h' | h'
              · exact Or.inl h'
              · cases h'
            · exact Or.inr h
        by_cases hq : PredU E ⟨lab, o⟩
        · rw [mem_PromAt_pred hvu hq, mem_PromAt_pred hvu hq, hmem2]
          exact and_congr_left fun _ => key
        · rw [PromAt_nword hvu hq, PromAt_nword hvu hq]
          exact key
    refine ⟨R0, Rv, ⟨fun h => ?_, fun c' hc' => ?_⟩, hvn, fun k => Nat.le_refl _⟩
    · rw [hsto] at h; cases h
    · rw [hsto] at hc'; cases hc'; exact ⟨vals0, hlat, hC0⟩
  have hbo' : bS + oS = b := hbo
  have hsl : ((vals0.drop bS).take wS).length = wS := by
    simp only [List.length_take, List.length_drop]; omega
  obtain ⟨n, Rq, Rr2, hwn, hle, hRs, hvq, hput2⟩ := VRR_at E.unsee hatS hvs (by rw [hsl]; exact hwS)
  have hwU : wc U = some (nWords us) := wc_of_accs hus
  rw [hwU] at hwn
  obtain rfl : nWords us = n := Option.some.inj hwn
  rw [hsl] at hle
  have hlenv : b + nWords us ≤ vals0.length := by
    rw [← hbo', Nat.add_assoc]; exact Nat.le_trans (Nat.add_le_add_left hle bS) hbw
  have hVq0 := Valid_at hatS (fun h => by simp [wc, h] at hwS) hVs (by rw [hsl]; exact hwS) _ hwU
  have hvqe : (((vals0.drop bS).take wS).drop oS).take (nWords us) = (vals0.drop b).take (nWords us) := by
    rw [take_drop_take hle, drop_drop', hbo']
  rw [hvqe] at hvq hVq0
  have hlq : ((vals0.drop b).take (nWords us)).length = nWords us := by
    simp only [List.length_take, List.length_drop]; omega
  have hLq : ∀ (j : Nat) v, ((vals0.drop b).take (nWords us))[j]? = some v →
      LatestNP s.mem (PromAt E s ⟨lab, b + j⟩) ⟨lab, b + j⟩ v := fun j v hj => by
    have hj' : vals0[b + j]? = some v := by
      by_cases hjn : j < nWords us
      · rw [List.getElem?_take_of_lt hjn, List.getElem?_drop] at hj; exact hj
      · rw [List.getElem?_eq_none (by simp; omega)] at hj; cases hj
    exact hL0 _ v hj'
  obtain ⟨M, Ra, Rp, hMl, hMv, hMV, hML, hVp, hacc⟩ := pieceAcctF0 hC hsto hf hcpl hniU hclo hat hus
    hone hiniW hinR htyc hvq hVq0 hlq hLq hvn hVn hln hmem2 hsub2 hFl hFm hFj hpr2 hcm hlP hP0 hwB hW2 hW3
    hGnd hGit hGcov
  have hQ := hput2 M Ra hMv hMl
  have hQV := (VR_put E.unsee hatS (VRR_VR S (RLink_of (Coh_CE _) (CohR_CE _)) hvs) hVs (by rw [hsl]; exact hwS)
    (VRR_VR U (RLink_of (Coh_CE _) (CohR_CE _)) hMv) hMV (by rw [hMl]; exact hwU)).2.2
  rw [hMl] at hQV
  have hQl : (((vals0.drop bS).take wS).take oS ++ M ++ ((vals0.drop bS).take wS).drop (oS + nWords us)).length = wS := by
    simp only [List.length_append, List.length_take, List.length_drop, hMl]; omega
  have hcell' := hput _ _ ⟨hQ, hQV⟩ hQl
  have hsp := splice_seg vals0 M bS wS oS (by rw [hMl]; exact hle)
  rw [hMl] at hsp
  rw [hsp, hbo'] at hcell'
  have hFlt : ∀ j t, F[j]? = some t → j < nWords us := fun j t h => by
    rw [← hFl]; exact (List.getElem?_eq_some_iff.mp h).1
  have hlat' : ∀ (o : Nat) v, (vals0.take b ++ M ++ vals0.drop (b + nWords us))[o]? = some v →
      LatestNP s2.mem (PromAt E s2 ⟨lab, o⟩) ⟨lab, o⟩ v := by
    intro o v hov
    rw [splice_get vals0 M b (nWords us) o hMl hlenv] at hov
    by_cases hr : b ≤ o ∧ o < b + nWords us
    · rw [iteT hr] at hov
      have := hML (o - b) v hov
      have e : b + (o - b) = o := by omega
      rw [e] at this; exact this
    · rw [iteF hr] at hov
      rw [hmem2]
      refine LatestNP_congr (fun t m hm hl => ?_) (hL0 o v hov)
      by_cases hvu : VisU E ⟨lab, o⟩
      · rw [PromAt_word hvu, PromAt_word hvu]
      · have key : t ∈ s2.promises ++ FpAt E ⟨lab, o⟩ ↔ t ∈ s.promises ++ FpAt E ⟨lab, o⟩ := by
          rw [List.mem_append, List.mem_append]
          constructor
          · rintro (h | h)
            · exact Or.inl (hsub2 t h)
            · exact Or.inr h
          · rintro (h | h)
            · rcases hFm t h with h' | h'
              · exact Or.inl h'
              · obtain ⟨j, hj⟩ := List.mem_iff_getElem?.mp h'
                obtain ⟨-, -, m', -, hm', -, hl', -⟩ := hFj j t hj
                rw [hm] at hm'; cases hm'
                have hjn := hFlt j t hj
                have e : o = b + j := congrArg WeakMem.Address.offset (hl.symm.trans hl')
                exact absurd ⟨by omega, by omega⟩ hr
            · exact Or.inr h
        by_cases hq : PredU E ⟨lab, o⟩
        · -- (U3) a predicted slot of the cell: the same memory, the same cut point
          rw [mem_PromAt_pred hvu hq, mem_PromAt_pred hvu hq, hmem2]
          exact and_congr_left fun _ => key
        · rw [PromAt_nword hvu hq, PromAt_nword hvu hq]
          exact key
  have hent : HeldEntry E s2 lab (Ra + Rr2 + Rr) := by
    refine ⟨fun h => ?_, fun c' hc' => ?_⟩
    · rw [hsto] at h; cases h
    · rw [hsto] at hc'; cases hc'; exact ⟨_, hlat', hcell'⟩
  refine ⟨Ra + Rr2 + Rr, Rp, hent, hVp, fun k => ?_⟩
  subst hR0; subst hRs
  have e := hacc k
  simp only [Res.add_apply] at e ⊢
  omega

/-- (D3) **The fulfilling swap of a piece at an own frontier cell, held**: the
cell's entry after the swap holds `Ra`; with the value read's `Rp` and the
fulfilled promises' debts, no more than the entry before, the new value, and
the fulfilled promises' credits. -/
theorem heldPieceF {E : TEnv} {s s2 : St} {cr db : Ts → Res} {lab : AllocLabel} {c : Cell} {f : Ts}
    {b : Nat} {U : Ty} {us : List Acc} {wsn old : List Word} {R0 Rv : Res} {F : List Ts} {wB : Ts}
    {Gs : List (Ts × Nat × Ty × List Word × Res × (Nat → Bool))} {coh1 : Address → Ts} {V : Ts}
    (hent0 : HeldEntry E s lab R0)
    (hC : PromCrP E s cr db) (hsto : E.sto lab = some c) (hf : E.pfr lab = some f)
    (hcpl : Ty.coupledOKIn [] c.ty = true) (hniU : noIallV U = true)
    (hclo : Clo c.ty) (hat : AtOff c.ty b U) (hini : IniAt E.ini c ⟨lab, b⟩ U)
    (hna : ∀ N e, U ≠ .array (.lit N) e) (hus : accs U = some us) (hone : ∀ u, u ∈ us → u = .one)
    (hiniW : ∀ j, j < nWords us → IniW E ⟨lab, b + j⟩)
    (hinR : ∀ j, j < nWords us → InitRr E c lab (b + j))
    (htyc : ∀ j, j < nWords us → VisU E ⟨lab, b + j⟩ → ∃ m, s.mem[s.vs.coh ⟨lab, b + j⟩]? = some m ∧
      m.loc = ⟨lab, b + j⟩ ∧ ∀ k P, AtOff c.ty (b + j) (.word (.lit k) P) → P.ghost = false →
        pwf P = true ∧ ∃ x, m.val = .num x ∧ InP P x)
    (hvn : VRR (fun _ => 0) (CE E.unsee) U (shp U) wsn Rv) (hVn : Valid U wsn) (hln : wsn.length = nWords us)
    (hmem2 : s2.mem = s.mem) (hsub2 : ∀ t, t ∈ s2.promises → t ∈ s.promises)
    (hFl : F.length = nWords us) (hFm : ∀ t, t ∈ s.promises → t ∈ s2.promises ∨ t ∈ F)
    (hFj : ∀ (j : Nat) t, F[j]? = some t → t ∈ s.promises ∧ t ∉ s2.promises ∧ ∃ m w, s.mem[t]? = some m ∧
      wsn[j]? = some w ∧ m.loc = ⟨lab, b + j⟩ ∧ WLe1 w (mw m) ∧ coh1 ⟨lab, b + j⟩ < t ∧
      s2.vs.coh ⟨lab, b + j⟩ = t)
    (hpr2 : ∀ t, t ∈ s2.promises → ∀ m, s.mem[t]? = some m → s2.vs.coh m.loc < t)
    (hcm : ∀ a, s.vs.coh a ≤ coh1 a) (hol : old.length = nWords us)
    (hrd : ∀ j w, old[j]? = some w → ∃ (tm : Ts) (m : Msg), s.mem[tm]? = some m ∧ m.loc = ⟨lab, b + j⟩ ∧
      WeakMem.hiddenFrom s.mem ⟨lab, b + j⟩ tm (max V (s.vs.coh ⟨lab, b + j⟩)) = false ∧ WLe1 (mw m) w ∧
      tm ≤ coh1 ⟨lab, b + j⟩)
    (hwB : ∀ (j : Nat) t, F[j]? = some t → t ≤ wB)
    (hW2 : ∀ t m, s.mem[t]? = some m → m.loc.label = lab → s.vs.coh m.loc < t → t ≤ wB → t ∈ s.promises)
    (hW3 : ∀ t m, t ∈ FpAt E ⟨lab, 0⟩ → s.mem[t]? = some m → m.loc.label = lab → wB < t)
    (hGnd : (Gs.map (·.1)).Nodup) (hGit : ∀ x ∈ Gs, CrItem E s cr lab c x)
    (hGcov : ∀ o tw, InitRr E c lab o → ¬ VisU E ⟨lab, o⟩ → LowOwn s ⟨lab, o⟩ tw → tw ≤ wB → OverT E s ⟨lab, o⟩ tw →
      ∃ x ∈ Gs, ∃ usS i, accs x.2.2.1 = some usS ∧ x.2.1 ≤ o ∧ InAcc usS i (o - x.2.1) ∧
        x.2.2.2.2.2 i = true) :
    ∃ Ra P0 Rp, HeldEntry E s2 lab Ra ∧ WLe P0 old ∧ VRR (fun _ => 0) (CE E.unsee) U (shp U) P0 Rp ∧
      Ra + Rp + Res.sum (F.map db) ≤ R0 + Rv + Res.sum (F.map cr) := by
  obtain ⟨hlow, hgap⟩ := lowGapF hFl hFm hFj hpr2 hwB hW2
  obtain ⟨P0, hWP, hlP, hP0⟩ := pickOldF hFl hFj hlow hgap hol hrd
  obtain ⟨Ra, Rp, hent, hVp, hacc⟩ := heldPieceF0 hent0 hC hsto hf hcpl hniU hclo hat hini hna hus hone
    hiniW hinR htyc hvn hVn hln hmem2 hsub2 hFl hFm hFj hpr2 hcm hlP hP0 hwB hW2 hW3 hGnd hGit hGcov
  exact ⟨Ra, P0, Rp, hent, hWP, hVp, hacc⟩

/-- (D3) Quotient and remainder are unique. -/
theorem mul_add_uniq {n j j' a a' : Nat} (ha : a < n) (ha' : a' < n) (e : j * n + a = j' * n + a') :
    j = j' ∧ a = a' := by
  have hn : 0 < n := Nat.lt_of_le_of_lt (Nat.zero_le _) ha
  have h1 : (j * n + a) / n = j := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hn, Nat.div_eq_of_lt ha, Nat.zero_add]
  have h2 : (j' * n + a') / n = j' := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hn, Nat.div_eq_of_lt ha', Nat.zero_add]
  have hj : j = j' := by rw [← h1, ← h2, e]
  subst hj; exact ⟨rfl, by omega⟩

/-- (D3) `word_typed` at any cell type (buffers included). -/
theorem cell_word_typed {η : TEnv} {T : Ty} {o k : Nat} {P : Proto} (hat : AtOff T o (.word (.lit k) P))
    (hg : P.ghost = false) {w : Word} (hw : WordOK η T o w) :
    pwf P = true ∧ ∃ v, w.val = .num v ∧ InP P v := by
  obtain ⟨b, S, ws, o', w0, hseg, hv, hws, hle, hbo⟩ := hw
  rcases hseg with ⟨rfl, rfl, ha⟩ | ⟨N, us, j, rfl, hus, hj, rfl⟩
  · exact word_typed hat hg ha ⟨0, S, ws, o', w0, Or.inl ⟨rfl, rfl, ha⟩, hv, hws, hle, hbo⟩
  · rcases AtOff_arr_elem hat rfl with h | ⟨us', j', o2, hus', hj', ho, hat2⟩
    · cases h
    · rw [hus] at hus'
      obtain rfl := Option.some.inj hus'
      have hb2 := AtOff_bound hat2 hus (accs_word hg)
      have hn1 : nWords [Acc.one] = 1 := rfl
      rw [hn1] at hb2
      have hl : ws.length = nWords us := by
        have := hv.2 us hus; omega
      have hlt1 : o' < nWords us := by rw [← hl]; exact (List.getElem?_eq_some_iff.mp hws).1
      obtain ⟨-, e2⟩ := mul_add_uniq hlt1 (by omega) (hbo.trans ho)
      subst e2
      exact word_typed hat2 hg (by rw [hus]; exact Option.some_ne_none _)
        ⟨0, S, ws, o', w0, Or.inl ⟨rfl, rfl, by rw [hus]; exact Option.some_ne_none _⟩, hv, hws, hle,
          Nat.zero_add _⟩

/-- (D3) The units of a piece at an initialised place are initialised. -/
theorem IniAt_unitR {E : TEnv} {c : Cell} {lab : AllocLabel} {b : Nat} {U : Ty} {us : List Acc}
    (hini : IniAt E.rc c ⟨lab, b⟩ U) (hna : ∀ N e, U ≠ .array (.lit N) e) (hus : accs U = some us) :
    ∀ j, j < nWords us → InitRr E c lab (b + j) := by
  intro j hj N e usE hT husE
  rcases hini N e hT with ⟨hU, -⟩ | ⟨us', j', o, hus', hj', hjo, hato⟩
  · exact absurd (hU.trans hT) (hna N e)
  · rw [husE] at hus'
    obtain rfl := Option.some.inj hus'
    have hb := AtOff_bound hato husE hus
    have hjo' : j' * nWords usE + o = b := hjo
    have hj'' : j' + 1 ≤ E.rc lab := hj'
    have := Nat.mul_le_mul_right (nWords usE) hj''
    rw [Nat.succ_mul] at this
    omega

/-- (D3) A copy of `TermStepper.cellOK_wordOK` (not imported here). -/
theorem cellOK_wordOK' {η : TEnv} {cl : Cell} {n o : Nat} {vals : List Word} {v : Word}
    (hc : CellOK η n cl.ty vals)
    (hi : ∀ N e us, cl.ty = .array (.lit N) e → accs e = some us → o < n * nWords us)
    (hv : vals[o]? = some v) :
    WordOK η cl.ty o v := by
  rcases hc with ⟨hwc, hval⟩ | ⟨N, e, us, hT, hus, hn, hlen, hsl⟩
  · obtain ⟨L, hL, -⟩ := Option.map_eq_some_iff.1 (show (accs cl.ty).map nWords = some vals.length from hwc)
    exact WordOK_whole ⟨hval, ShapeC_of_wc hwc rfl⟩ (by rw [hL]; exact Option.some_ne_none _) hv
  · have hc : CellOK η n cl.ty vals := .inr ⟨N, e, us, hT, hus, hn, hlen, hsl⟩
    have ho : o < n * nWords us := hi N e us hT hus
    have hj : o / nWords us < n := Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm]; exact ho)
    have hpos : 0 < nWords us :=
      Nat.pos_of_ne_zero fun h => by rw [h, Nat.mul_zero] at ho; exact Nat.not_lt_zero _ ho
    have hm : o % nWords us < nWords us := Nat.mod_lt _ hpos
    have hdm : o / nWords us * nWords us + o % nWords us = o := by
      rw [Nat.mul_comm]; exact Nat.div_add_mod o _
    have hseg : SegOf cl.ty (o / nWords us * nWords us) e :=
      .inr ⟨N, us, o / nWords us, hT, hus, Nat.lt_of_lt_of_le hj hn, rfl⟩
    obtain ⟨hval, -⟩ := CellOK_seg hc hseg hus fun N' e' hT' => by
      rw [hT] at hT'; simp only [Ty.array.injEq, Idx.lit.injEq] at hT'
      obtain ⟨rfl, rfl⟩ := hT'
      exact ⟨us, o / nWords us, hus, hj, rfl⟩
    refine ⟨_, e, _, o % nWords us, v, hseg, hval, ?_, WLe1_refl v, hdm⟩
    rw [List.getElem?_take_of_lt hm, List.getElem?_drop, hdm]; exact hv

/-- (D3) At a visible unit of a piece of an own frontier cell, the coherence
message is typed for the cell. -/
theorem own_htyc {E : TEnv} {s : St} {lab : AllocLabel} {c : Cell} {b : Nat} {U : Ty} {us : List Acc}
    (hoo : OwnOKPF E s.mem s.pairs s.vs s.promises) (hsto : E.sto lab = some c)
    (hown : c.owner = some E.tid) (hat : AtOff c.ty b U) (hus : accs U = some us)
    (hinR : ∀ j, j < nWords us → InitRr E c lab (b + j)) :
    ∀ j, j < nWords us → VisU E ⟨lab, b + j⟩ → ∃ m, s.mem[s.vs.coh ⟨lab, b + j⟩]? = some m ∧
      m.loc = ⟨lab, b + j⟩ ∧ ∀ k P, AtOff c.ty (b + j) (.word (.lit k) P) → P.ghost = false →
        pwf P = true ∧ ∃ x, m.val = .num x ∧ InP P x := by
  intro j hj _
  obtain ⟨vals, hcell, hlat, -⟩ := hoo lab c hsto hown
  have hlt : b + j < vals.length := by
    rcases hcell with ⟨hwc, -⟩ | ⟨N, e, usE, hT, husE, hn, hlen, -⟩
    · obtain ⟨L, hL, hLw⟩ := Option.map_eq_some_iff.1 (show (accs c.ty).map nWords = some vals.length from hwc)
      have := AtOff_bound hat hL hus
      omega
    · have := hinR j hj N e usE hT husE
      rw [hlen]; exact Nat.lt_of_lt_of_le this (Nat.mul_le_mul_right _ hn)
  obtain ⟨⟨m, hm, hl, hcase⟩, -, -⟩ := hlat (b + j) (vals[b + j]'hlt) (List.getElem?_eq_getElem hlt)
  refine ⟨m, hm, hl, fun k P hatk hg => ?_⟩
  rcases hcase with ⟨he, -⟩ | ⟨-, hta⟩
  · obtain ⟨hp, x, hx, hin⟩ := cell_word_typed hatk hg
      (cellOK_wordOK' hcell (hinR j hj) (List.getElem?_eq_getElem hlt))
    exact ⟨hp, x, by rw [he]; exact hx, hin⟩
  · have h' : WordOK E c.ty (b + j) (mw m) := by
      have := hta; unfold TypedAt at this; rw [hl] at this; exact this
    exact cell_word_typed hatk hg h'

set_option maxHeartbeats 1600000 in
/-- (D3) **`xchg` at an own locative of a frontier cell, fulfilling**: as
`tstepMR_xchgLoc`, at a cell with a frontier, when the swap fulfils promises
(memory unchanged); with the fulfilled promises' credits and debts. -/
theorem tstepMCF_xchgLocF {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {a v : At} {u : Ty} {e : Expr} {Rf Rs H : Res}
    {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.xchg a v) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.loc .own u))
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeld (CE η) (stOf mem pairs th) H) (hC : PromCrP (CE η) (stOf mem pairs th) cr db)
    (hfr : ∀ ad μr ru pw, evalAt th.env a = some (.loc μr ru, [pw]) → pw.val = .loc ad 0 →
      (CE η).pfr ad.label ≠ none)
    {Ok : Memory × List Ts × TTh → Prop}
    (hpo : ∀ lab c, (CE η).sto lab = some c → c.owner = some (CE η).tid → (CE η).pfr lab ≠ none → OpTgt th lab →
      PlantOp g mem pairs th (CE η) cr Ok lab c)
    (hniX : OpNI cx th)
    (hclo : ∀ lab c, (CE η).sto lab = some c → Clo c.ty) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hDy : DyFr p annNew (progTgts p) η th.σs th.term) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → r.1 = mem → Ok r →
      ∃ Tot H' C F, ThInvMCF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 Tot H'
          (dropP (CE η) (stOf mem pairs th) cr) db ∧
        MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
        Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) (dropP (CE η) (stOf mem pairs th) cr) +
            pSum (stOf mem pairs th) db + C ≤
          Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | xchg hp hx hu hsub hb =>
  obtain ⟨t, u', o, tv, c₁, hp, hx, hu, hsub, hb⟩ : ∃ t u' o tv c₁, cx.peek a = .ok t ∧
      XchgCell cx t u' o ∧ cx.use v = .ok (tv, c₁) ∧ (SubS c₁ tv u' ∨ SubS c₁ tv o) ∧
      c₁.bind x o = .ok c' := ⟨_, _, _, _, _, hp, hx, hu, hsub, hb⟩
  rw [hpk] at hp; cases hp
  cases hx with
  | rgn _ hc _ _ _ => simp [cellOf] at hc
  | own _ hc _ =>
  simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc; subst hc
  have hi0 := hi.1
  have hsub : SubS c₁ tv u := hsub.elim id id
  have hotv : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have ho : cx.opaqueOK u = true := sub_opaqueOK hsub hotv
  have htb : tb cx.ke.length u = true :=
    tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.loc .own u) = some (.own, u))
  have haf' : (cl ρ η.wit 0 0 u).arrFree = true := arrFree_cl hi0.2.2.2.2.2.2.1.af u 0 0 (bind_arrFree hb)
  have hna : ∀ n e, cl ρ η.wit 0 0 u ≠ .array (.lit n) e := fun n e h => by
    rw [h] at haf'; simp [Ty.arrFree] at haf'
