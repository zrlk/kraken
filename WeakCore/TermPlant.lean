/-- (bufInit re-pin) **A typed `bufInit` initialises at most the real count's slot**: its
index is at most its buffer's real count (`IniR` of the buffer's refined type). -/
theorem bufInit_idx_le {p : Prog} {th : TTh} {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {b i v : At}
    {e : Expr} {Rf Rs : Res}
    (hterm : th.term = .let_ x (.bufInit b i v) e)
    (hT : Typed p cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf) (hE : EnvOK p η) :
    ∀ rt w ad rti wi n, evalAt th.env b = some (rt, [w]) → w.val = .loc ad 0 →
      evalAt th.env i = some (rti, [wi]) → numOf [wi] = some n → n ≤ (CE η).rc ad.label := by
  intro rt0 w0 ad0 rti0 wi0 n0 he0 hw0 hei0 hn0
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  cases hop with
  | bufInit hu hbuf hint heq hlt hu2 hsub hb =>
  obtain ⟨t, tv, u, n, k, j, c₁, c₂, hu, hbuf, hint, heq, hlt, hu2, hsub⟩ : ∃ t tv u n k j c₁ c₂,
      cx.use b = .ok (t, c₁) ∧ bufOf t = some (.own, n, u, k) ∧ IntIdx c₁ i j ∧ EqI c₁ j k ∧
      LtI c₁ k n ∧ c₁.use v = .ok (tv, c₂) ∧ SubS c₂ tv u :=
    ⟨_, _, _, _, _, _, _, _, hu, hbuf, hint, heq, hlt, hu2, hsub⟩
  have ht : t = .refine (.loc .own (.array n u)) (.ini k) := by
    unfold bufOf at hbuf; split at hbuf
    · simp only [Option.some.injEq, Prod.mk.injEq] at hbuf
      obtain ⟨h1, rfl, rfl, rfl⟩ := hbuf; subst h1; rfl
    · simp at hbuf
  subst ht
  obtain ⟨rb, wsb, Rb, Rr1, hea, hvb, hlb, hvrb, hi1, hle1⟩ := useR hu hi hE.2.2
  have hJK : ev ρ j = ev ρ k := heq ρ hi1.1.1
  have hKN : ev ρ k < ev ρ n := hlt ρ hi1.1.1
  obtain ⟨ti, hpi, hti⟩ := hint
  obtain ⟨rti, wsi, hei, hvi, -⟩ := peek_VR hi1.1.2.1 hpi
  obtain ⟨wi, rfl, hwi⟩ := map_singleton (VR_intS hti hvi)
  simp only [VR] at hvb
  obtain ⟨hv, hir⟩ := hvb
  rcases hv with ⟨-, e0, he0⟩ | ⟨ad, c, U, hws, hsto, hat0, hFU, hown, hini0⟩
  · have he0 := Fd_nonmu he0 (fun b => by simp [cl])
    simp only [cl, clI_zero, Ty.array.injEq, Idx.lit.injEq] at he0
    omega
  obtain ⟨w, rfl, hwv⟩ := map_singleton hws
  rw [hea] at he0
  simp only [Option.some.injEq, Prod.mk.injEq, List.cons.injEq] at he0
  obtain ⟨-, rfl, -⟩ := he0
  rw [hwv] at hw0
  cases hw0
  rw [hei] at hei0
  simp only [Option.some.injEq, Prod.mk.injEq, List.cons.injEq] at hei0
  obtain ⟨-, rfl, -⟩ := hei0
  have hni : numOf [wi] = some (ev ρ j) := by simp [numOf, hwi]
  rw [hni] at hn0
  cases hn0
  have hKm : ev ρ k ≤ η.rc ad0.label := by
    simp only [IniR] at hir; have h := hir ad0 (by simp [hwv]); rw [TEnv.selIni_loc] at h; exact h
  show ev ρ j ≤ η.rc ad0.label
  omega
#print axioms TermPlant.bufInit_idx_le

/-- (bufInit re-pin) The index of a typed `bufInit` evaluates to a number. -/
theorem bufInit_idx_ev {p : Prog} {th : TTh} {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {b i v : At}
    {e : Expr} {Rf Rs : Res}
    (hterm : th.term = .let_ x (.bufInit b i v) e)
    (hT : Typed p cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf) (hE : EnvOK p η) :
    ∃ rti wi n, evalAt th.env i = some (rti, [wi]) ∧ numOf [wi] = some n := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  cases hop with
  | bufInit hu hbuf hint heq hlt hu2 hsub hb =>
  obtain ⟨t, tv, u, n, k, j, c₁, c₂, hu, hbuf, hint, heq, hlt, hu2, hsub⟩ : ∃ t tv u n k j c₁ c₂,
      cx.use b = .ok (t, c₁) ∧ bufOf t = some (.own, n, u, k) ∧ IntIdx c₁ i j ∧ EqI c₁ j k ∧
      LtI c₁ k n ∧ c₁.use v = .ok (tv, c₂) ∧ SubS c₂ tv u :=
    ⟨_, _, _, _, _, _, _, _, hu, hbuf, hint, heq, hlt, hu2, hsub⟩
  have ht : t = .refine (.loc .own (.array n u)) (.ini k) := by
    unfold bufOf at hbuf; split at hbuf
    · simp only [Option.some.injEq, Prod.mk.injEq] at hbuf
      obtain ⟨h1, rfl, rfl, rfl⟩ := hbuf; subst h1; rfl
    · simp at hbuf
  subst ht
  obtain ⟨rb, wsb, Rb, Rr1, hea, hvb, hlb, hvrb, hi1, hle1⟩ := useR hu hi hE.2.2
  have hJK : ev ρ j = ev ρ k := heq ρ hi1.1.1
  have hKN : ev ρ k < ev ρ n := hlt ρ hi1.1.1
  obtain ⟨ti, hpi, hti⟩ := hint
  obtain ⟨rti, wsi, hei, hvi, -⟩ := peek_VR hi1.1.2.1 hpi
  obtain ⟨wi, rfl, hwi⟩ := map_singleton (VR_intS hti hvi)
  exact ⟨rti, wi, ev ρ j, hei, by simp [numOf, hwi]⟩
#print axioms TermPlant.bufInit_idx_ev

/-- (OvW3 G-b) `stepOut_ofNSA`-shaped `KeepQ` conclusions with a vacuous re-pin cover are
`KeepQR` ones. -/
theorem stepOutR_of {QE : TEnv → Prop} {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory}
    {pairs : List Ts} {th : TTh} {cx : Cx} {η : TEnv}
    {Rf Rs H : Res} {cr db : Ts → Res} {Q : Memory × List Ts × TTh → Prop}
    (hV : ∀ r ∈ tstep g mem pairs th, ∀ E', RepinCov (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th [])
    (h : tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → Q r →
      ∃ Tot H' C F cr' db' Gd,
      ThInvMCFSQK (fun E' => QE E' ∧ KeepQ (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th cr cr')
        p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr' db' ∧
      MintStep g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧ ClaimAt th.term C F ∧
      Drop (CE η) (stOf mem pairs th) Gd ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr' + pSum (stOf mem pairs th) db + C + Res.sum (Gd.map GdE.R) ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db' + F ∧
      (PubShape cx th → GdCovT (CE η) (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) Gd th)) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → Q r →
      ∃ Tot H' C F cr' db' Gd,
      ThInvMCFSQK (fun E' => QE E' ∧ KeepQR (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th cr cr')
        p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr' db' ∧
      MintStep g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧ ClaimAt th.term C F ∧
      Drop (CE η) (stOf mem pairs th) Gd ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr' + pSum (stOf mem pairs th) db + C + Res.sum (Gd.map GdE.R) ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db' + F ∧
      (PubShape cx th → GdCovT (CE η) (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) Gd th) :=
  ⟨h.1, fun r hr hpa hq =>
    let ⟨Tot, H', C, F, cr', db', Gd, h1, h2⟩ := h.2 r hr hpa hq
    ⟨Tot, H', C, F, cr', db', Gd, ThInvMCFSQK.toR (hV r hr) h1, h2⟩⟩
#print axioms TermPlant.stepOutR_of

