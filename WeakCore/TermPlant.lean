/-! ## (B2, F1) The `bufInit` output and the kept `ini` on the step witness -/

/-- (B2, F1) **A `bufInit` stores below the witness's real count**: at a `bufInit` term of `th` whose
handle and index evaluate, the index is below `E'.rc` at the handle's label. -/
def BiOut (th : TTh) (E' : TEnv) : Prop :=
  ∀ x b i v e rt w ad rti wi n, th.term = .let_ x (.bufInit b i v) e → evalAt th.env b = some (rt, [w]) →
    w.val = .loc ad 0 → evalAt th.env i = some (rti, [wi]) → numOf [wi] = some n → n < E'.rc ad.label

theorem biOut_nb {th : TTh} {E' : TEnv} (h : ∀ x b i v e, th.term ≠ .let_ x (.bufInit b i v) e) :
    BiOut th E' :=
  fun x b i v e _ _ _ _ _ _ ht _ _ _ _ => absurd ht (h x b i v e)

theorem biOut_of {th : TTh} {E' : TEnv} {x : String} {b i v : At} {e : Expr} {rb : Ty} {w : Word} {ad : Address}
    {rti : Ty} {wi : Word} {n : Nat}
    (hterm : th.term = .let_ x (.bufInit b i v) e) (hea : evalAt th.env b = some (rb, [w]))
    (hwv : w.val = .loc ad 0) (hei : evalAt th.env i = some (rti, [wi])) (hni : numOf [wi] = some n)
    (hlt : n < E'.rc ad.label) : BiOut th E' := by
  intro x' b' i' v' e' rt' w' ad' rti' wi' n' ht he hw hei' hn
  rw [hterm] at ht; cases ht
  rw [hea] at he; cases he
  rw [hwv] at hw; cases hw
  rw [hei] at hei'; cases hei'
  rw [hni] at hn; cases hn
  exact hlt

set_option hygiene false in
/-- (B2, F1) `BiOut` at an unchanged witness of a non-`bufInit` term `hterm`. -/
macro "f1q_tac" : tactic => `(tactic| exact fun _ _ _ _ _ _ _ _ _ _ _ ht _ _ _ _ => (by rw [hterm] at ht; cases ht))

/-- (B2, F1) `ThInvMK` with `Q` on the witness. -/
def ThInvMKQ (Q : TEnv → Prop) (p : Prog) (g : G) (E0 : TEnv) (s : St) (S0 : AllocLabel → List Res) (mem : Memory)
    (pairs : List Ts) (th : TTh) (Tot H : Res) : Prop :=
  ∃ E, Q E ∧ EFoot g E0 E s (stOf mem pairs th) ∧ SeenKeep E0 E ∧ BoxNewV E0 E s th ∧ ThInvRE p E th Tot ∧
    MemInv g E (stOf mem pairs th) ∧ MemHeldK E0 s S0 E (stOf mem pairs th) H ∧ CrKeep E0 E s (stOf mem pairs th)

/-- (B2, F1) `ThInvMCFS` with `Q` on the witness. -/
def ThInvMCFSQ (Q : TEnv → Prop) (p : Prog) (g : G) (E : TEnv) (s : St) (S0 : AllocLabel → List Res) (mem : Memory)
    (pairs : List Ts) (th : TTh) (Tot H : Res) (cr db : Ts → Res) : Prop :=
  ∃ E', Q E' ∧ EFoot g E E' s (stOf mem pairs th) ∧ SeenOK E E' Tot H ∧ BoxNewV E E' s th ∧ ThInvRE p E' th Tot ∧
    MemInv g E' (stOf mem pairs th) ∧ MemHeldK E s S0 E' (stOf mem pairs th) H ∧ PromCr E' (stOf mem pairs th) cr db

/-- (B2, F1) `ThInvMCF` with `Q` on the witness. -/
def ThInvMCFQ (Q : TEnv → Prop) (p : Prog) (g : G) (E : TEnv) (s : St) (mem : Memory) (pairs : List Ts) (th : TTh)
    (Tot H : Res) (cr db : Ts → Res) : Prop :=
  ∃ E', Q E' ∧ EFoot g E E' s (stOf mem pairs th) ∧ SeenOK E E' Tot H ∧ BoxNewV E E' s th ∧ ThInvRE p E' th Tot ∧
    MemInv g E' (stOf mem pairs th) ∧ MemHeld E' (stOf mem pairs th) H ∧ PromCr E' (stOf mem pairs th) cr db

theorem ThInvMCFSQ.toS {Q : TEnv → Prop} {p : Prog} {g : G} {E : TEnv} {s : St} {S0 : AllocLabel → List Res}
    {mem : Memory} {pairs : List Ts} {th : TTh} {Tot H : Res} {cr db : Ts → Res}
    (h : ThInvMCFSQ Q p g E s S0 mem pairs th Tot H cr db) : ThInvMCFS p g E s S0 mem pairs th Tot H cr db :=
  let ⟨E', _, h0⟩ := h
  ⟨E', h0⟩

theorem ThInvMCFSQ.mono {Q Q' : TEnv → Prop} {p : Prog} {g : G} {E : TEnv} {s : St} {S0 : AllocLabel → List Res}
    {mem : Memory} {pairs : List Ts} {th : TTh} {Tot H : Res} {cr db : Ts → Res} (hQ : ∀ E', Q E' → Q' E')
    (h : ThInvMCFSQ Q p g E s S0 mem pairs th Tot H cr db) : ThInvMCFSQ Q' p g E s S0 mem pairs th Tot H cr db :=
  let ⟨E', hq, h0⟩ := h
  ⟨E', hQ E' hq, h0⟩

theorem ThInvMCFSQ.toFQ {Q : TEnv → Prop} {p : Prog} {g : G} {E : TEnv} {s : St} {S0 : AllocLabel → List Res}
    {mem : Memory} {pairs : List Ts} {th : TTh} {Tot H : Res} {cr db : Ts → Res}
    (h : ThInvMCFSQ Q p g E s S0 mem pairs th Tot H cr db) : ThInvMCFQ Q p g E s mem pairs th Tot H cr db :=
  let ⟨E', hq, h0, hSK, hBV, h1, h2, h3, h4⟩ := h
  ⟨E', hq, h0, (by seenT), (by boxT), h1, h2, h3.memHeld, h4⟩

theorem ThInvMCFSQ.ofS {Q : TEnv → Prop} {p : Prog} {g : G} {E : TEnv} {s : St} {S0 : AllocLabel → List Res}
    {mem : Memory} {pairs : List Ts} {th : TTh} {Tot H : Res} {cr db : Ts → Res} (hQ : ∀ E', Q E')
    (h : ThInvMCFS p g E s S0 mem pairs th Tot H cr db) : ThInvMCFSQ Q p g E s S0 mem pairs th Tot H cr db :=
  let ⟨E', h0⟩ := h
  ⟨E', hQ E', h0⟩

theorem ThInvMCFQ.toF {Q : TEnv → Prop} {p : Prog} {g : G} {E : TEnv} {s : St} {mem : Memory} {pairs : List Ts}
    {th : TTh} {Tot H : Res} {cr db : Ts → Res}
    (h : ThInvMCFQ Q p g E s mem pairs th Tot H cr db) : ThInvMCF p g E s mem pairs th Tot H cr db :=
  let ⟨E', _, h0⟩ := h
  ⟨E', h0⟩

/-- (G1 × dropA) `ThInvMCFQ` whose credits satisfy `PromCrK`. -/
def ThInvMCFQK (Q : TEnv → Prop) (p : Prog) (g : G) (E : TEnv) (s : St) (mem : Memory) (pairs : List Ts) (th : TTh)
    (Tot H : Res) (cr db : Ts → Res) : Prop :=
  ∃ E', Q E' ∧ EFoot g E E' s (stOf mem pairs th) ∧ SeenOK E E' Tot H ∧ BoxNewV E E' s th ∧ ThInvRE p E' th Tot ∧
    MemInv g E' (stOf mem pairs th) ∧ MemHeld E' (stOf mem pairs th) H ∧ PromCrK E' (stOf mem pairs th) cr db

theorem ThInvMCFQ.toK {Q : TEnv → Prop} {p : Prog} {g : G} {E : TEnv} {s : St} {mem : Memory} {pairs : List Ts}
    {th : TTh} {Tot H : Res} {cr db : Ts → Res}
    (h : ThInvMCFQ Q p g E s mem pairs th Tot H cr db) : ThInvMCFQK Q p g E s mem pairs th Tot H cr db :=
  let ⟨E', hq, h0, hSK, hBV, h1, h2, h3, h4⟩ := h
  ⟨E', hq, h0, hSK, hBV, h1, h2, h3, PromCrK_of h4⟩
#print axioms ThInvMCFQ.toK

/-- (B2, F1) `mc_ofK` keeping `Q` on the witness. -/
theorem mc_ofKQ {Q : TEnv → Prop} {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem mem' : Memory}
    {pairs pairs' : List Ts} {th th' : TTh} {η : TEnv} {Tot H' Rf Rs H : Res} {cr db : Ts → Res}
    (hm : MemInv g (CE η) (stOf mem pairs th)) (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hK : ThInvMKQ Q p g (CE η) (stOf mem pairs th) Sp mem' pairs' th' Tot H') (hle : Tot + H' ≤ Rf + Rs + H) :
    ∃ Tot H' C F, ThInvMCFSQ Q p g (CE η) (stOf mem pairs th) Sp mem' pairs' th' Tot H' cr db ∧
      MintStepN g η (stOf mem pairs th) (stOf mem' pairs' th') C F ∧
      Tot + H' + pSum (stOf mem' pairs' th') cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf mem' pairs' th') db + F := by
  obtain ⟨E, hq, hF, hSK, hBV, hT, hm', hH', hk⟩ := hK
  obtain ⟨hC', e1, e2⟩ := CrKeep_pack (MemInv_promLt hm) (MemInv_nodup hm) hk cr db hC
  refine ⟨Tot, H', .zero, .zero, ⟨E, hq, hF, (by seenT), (by boxT), hT, hm', hH', hC'⟩, .none, ?_⟩
  rw [e1, e2]
  intro k
  have h1 := hle k
  simp only [Res.add_apply, Res.zero_apply] at h1 ⊢
  omega

theorem mc_liftAQ {Q : TEnv → Prop} {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts}
    {th : TTh} {η : TEnv} {Rf Rs H : Res} {cr db : Ts → Res}
    (hm : MemInv g (CE η) (stOf mem pairs th)) (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (h : tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      ∃ Tot H', ThInvMKQ Q p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFSQ Q p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧
      MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F :=
  ⟨h.1, fun r hr hp => by
    obtain ⟨Tot, H', hK, hle⟩ := h.2 r hr hp
    exact mc_ofKQ hm hC hK hle⟩

/-- (D3) `tstepMR_xchgOwn` at an own cell with no frontier (`pfr = none`): `OwnNVP`/`OwnFrontierRMW` replaced by `hnf`. -/
theorem tstepMR_xchgOwnN {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {a v : At} {u : Ty} {e : Expr} {Rf Rs H : Res}
    (hterm : th.term = .let_ x (.xchg a v) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.ptr .own u))
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    {Sp : AllocLabel → List Res} (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hnf : ∀ lab ru pw, evalAt th.env a = some (.ptr .own ru, [pw]) → pw.val = .loc ⟨lab, 0⟩ 0 →
      (CE η).pfr lab = none) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hDy : DyFr p annNew (progTgts p) η th.σs th.term) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      ∃ Tot H', ThInvMKQ (BiOut th) p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | xchg hp hx hu hsub hb =>
  obtain ⟨t, u', o, tv, c₁, hp, hx, hu, hsub, hb⟩ : ∃ t u' o tv c₁, cx.peek a = .ok t ∧
      XchgCell cx t u' o ∧ cx.use v = .ok (tv, c₁) ∧ (SubS c₁ tv u' ∨ SubS c₁ tv o) ∧
      c₁.bind x o = .ok c' := ⟨_, _, _, _, _, hp, hx, hu, hsub, hb⟩
  rw [hpk] at hp; cases hp
  cases hx with
  | rgn _ hc _ _ _ => simp [cellOf] at hc
  | own _ hc _ =>
  simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc; subst hc
  have hi0 := hi.1
  have hsub : SubS c₁ tv u := hsub.elim id id
  have hotv : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have ho : cx.opaqueOK u = true := sub_opaqueOK hsub hotv
  have htb : tb cx.ke.length u = true := tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.ptr .own u) = some (.own, u))
  obtain ⟨lab, c, pw, ru, hea, hpw, hsto, hcty, hacc, hown, hsku, hsig⟩ := ownPtr_view hi0 hpk htv ho
  have hpfN : (CE η).pfr lab = none := hnf lab ru pw hea hpw
  have hnv := NVP_priv (s := stOf mem pairs th) (Priv_of hsto hown hpfN)
  obtain ⟨rv, wsv, Rv, Rr, hev, hvv, hlv, hvrv, hi1, hle⟩ := useR hu hi hE.2.2
  have hsat : Sat c₁.facts ρ := hi1.1.1
  have hna : ∀ N e', c.ty ≠ .array (.lit N) e' := fun N e' h =>
    hacc (by rw [h]; simp [accs])
  obtain ⟨us, hus, ⟨r0, hr0⟩, hld, hstw⟩ := ownLoad (arch := g.arch) (pw := pw) (acq := false) (s := stOf mem pairs th)
    hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hsto hown (Fd_lay hcty).1 (Fd_lay hcty).2.1
    (fun ws => ((Fd_lay hcty).2.2.2 ws).1) (fun R ws => (Fd_VR η hcty).1) hna hsku (peek_cell_lyt hi0.2.1 hpk hea rfl rfl).2 hsig
    (by rw [(Fd_lay hcty).2.2.1]; exact pub_accs hi0.2.2.2.1 hi0.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi0.2.1 htv hpk rfl ho hea rfl)
  obtain ⟨hval, hlen⟩ := ownStoreVal hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 hsat hsub ho htb hvv hlv hsig hus
  have husA : accs c.ty = some us := ((Fd_lay hcty).2.2.1.trans (pub_accs hi0.2.2.2.1 hi0.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi0.2.1 htv hpk rfl ho hea rfl).symm).trans hus
  have hus' : wc c.ty = some (nWords us) := by rw [(Fd_lay hcty).2.1, ← wc_of_sig hsig]; simp [wc, hus]
  replace hval := (Fd_EnvVal (CE η) hcty).2 hval
  have hsigu : sig (close th.σs u) = sig (cl ρ η.wit 0 0 u) :=
    sig_WitL hi0.2.2.2.1 ρ ho (lt_of_guardT htb hi0.2.2.2.2.1)
  have hvalR : EnvValR (CE η) c.ty wsv Rv := by
    obtain ⟨hs, -⟩ := Lay_canon hsub hlv
    have hvu : VRR ρ η u (shp (close th.σs u)) wsv Rv := by rw [← hs]; exact VRR_sub hsat hsub _ _ _ hvrv
    have hvc : VRR (fun _ => 0) (CE η) (cl ρ η.wit 0 0 u) (shp (cl ρ η.wit 0 0 u)) wsv Rv := by
      rw [← shp_of_sig hsigu]
      exact (VRR_close hE.2.1 hE.2.2 ρ u [] 0 ρ (fun _ => 0) (shp (close th.σs u)) wsv Rv (fun k => rfl)
        (fun k hk => absurd hk (Nat.not_lt_zero _))).1 hvu
    refine ⟨?_, hval.2⟩
    rw [(Fd_lay hcty).1]
    exact (Fd_VRR η hcty).2 hvc
  -- the cell's words at their messages, and what memory holds for them
  obtain ⟨vals, hcell, hlat⟩ := OwnOKPF_cellP hm.2.1 hsto hown hpfN
  have hwc := (hcell.plain (notArr_of_wc hus')).1
  obtain ⟨vals', hWv, hP'⟩ := own_msgWordsN (E := CE η) hnv vals hlat
  have hl' : vals'.length = nWords us := by
    rw [← hWv.length]; rw [hus'] at hwc; exact (Option.some.inj hwc).symm
  obtain ⟨R0, H0, rfl, hent0, hX⟩ := MemHeldL_focusE hH lab
  have hvR0 : ValOfR (CE η) c.ty vals' R0 :=
    HeldEntry_vals hent0 hsto hna (by rw [hus', hl']) (fun o w h => (hP' o w h).2)
  have key : tstep g mem pairs th =
      ((loadUnits g.arch pw ⟨lab, 0⟩ false us 0 (stOf mem pairs th)).flatMap fun (s1, old) =>
        (storeUnits g.k g.arch pw ⟨lab, 0⟩ false us wsv 0 s1).map fun s2 => (s2, ru, old)).map
        fun (s', t, ws) => (s'.mem, s'.pairs, withS { th with term := e, env := (x, t, ws) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hev, cellOf, addrOf, hpw, hus]
  rw [key] at ⊢
  have hm1 : ∀ r1, r1 ∈ loadUnits g.arch pw ⟨lab, 0⟩ false us 0 (stOf mem pairs th) → PromAbove r1.1 → MemInv g (CE η) r1.1 :=
    fun r1 h hp => by
      obtain ⟨_, _, f1, f2, f3, f4, f5⟩ := hld r1 h hp
      exact MemInv_load hm f1 f2 f3 f4 f5 (loadUnits_relSt _ _ _ _ h) (loadUnits_vWr _ _ _ _ h)
  obtain ⟨s2, hs2⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := pw) (a := ⟨lab, 0⟩) (rel := false)
    us wsv 0 r0.1 hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem (List.mem_flatMap.2 ⟨r0, hr0, List.mem_map_of_mem hs2⟩)),
    fun r hr hpr0 => ?_⟩
  have hpr := hpr0
  rw [List.mem_map] at hr
  obtain ⟨⟨s', t', ws'⟩, hr, rfl⟩ := hr
  rw [List.mem_flatMap] at hr
  obtain ⟨⟨s1, old⟩, h1, h2⟩ := hr
  rw [List.mem_map] at h2
  obtain ⟨s2, hs2, he2⟩ := h2
  simp only [Prod.mk.injEq] at he2
  obtain ⟨rfl, rfl, rfl⟩ := he2
  have hp1 : PromAbove s1 := storeUnits_promAbove hs2 (fun t ht m hm => hpr t ht m hm)
  obtain ⟨-, hlay, f1, -, fc, f3, -⟩ := hld (s1, old) h1 hp1
  -- the old value, with the cell's resources, at the static type
  have hWold : WLe vals' old := (loadUnits_latestPA hl'
    (fun j w hj => by simpa [offs] using (hP' j w hj).1) h1 hp1).1
  have hvold : VRR ρ η u (shp ru) old R0 := by
    have h1 := VRR_up _ _ _ _ _ hWold hvR0.1
    have h2 : VRR (fun _ => 0) (CE η) c.ty (shp c.ty) old R0 :=
      VRR_mono c.ty (CE (CE η).unsee) (CE η) _ _ _ _ (fun _ _ _ _ h => h) (fun _ _ _ _ h => h) rfl rfl rfl (fun _ _ h => h)
        (fun _ => Nat.le_refl _) (fun _ _ h => h) (fun _ h => h.elim) (fun _ _ h => h) h1
    have h3 := (Fd_VRR η hcty).1 h2
    rw [(Fd_lay hcty).1, ← shp_of_sig hsig] at h3
    exact (VRR_close hE.2.1 hE.2.2 ρ u [] 0 ρ (fun _ => 0) (shp ru) old R0 (fun k => rfl)
      (fun k hk => absurd hk (Nat.not_lt_zero _))).2 h3
  -- the store, from the loaded state
  have hm1' := hm1 (s1, old) h1 hp1
  obtain ⟨g2, -⟩ := storeUnits_latP (a := ⟨lab, 0⟩) us wsv 0 s1 s1.vs.vRelSt hm1'.2.2.1
    hm1'.2.2.2.2.2.2.2.2.2.2.1 (Nat.le_refl _) s2 hs2
  have htail : ∀ j : Nat, j < nWords us → TailP s1 (offs ⟨lab, 0⟩ (0 + j)) := fun j hj => by
    have := cellP_tailLoad (OwnOKPF_cellP hm.2.1 hsto hown hpfN) fc (loadUnits_cohMono us 0 _ _ h1) f1 f3
      hsto hown hus' j hj
    simpa [offs] using this
  have hX1 : MemHeldXL (CE η) s1 lab H0 Sp := MemHeldXL_tr hX (fun _ _ => rfl) (fun _ _ => rfl)
    (fun l' hne o w hl => by rw [← f1] at hl; rw [PromAt_eqp f3]; exact hl) id
  have hX' : MemHeldXL (CE η) s2 lab H0 Sp := MemHeldXL_store (a := ⟨lab, 0⟩) hX1 hm1'.2.2.1 hs2
  have hent : HeldEntry (CE η) s2 lab Rv := HeldEntry_ownN hsto (NVP_store (NVP_eqs hnv f1 f3) hm1'.2.2.1 hs2)
    (storeOwn_latestP hlen (g2 htail))
    (Or.inl ⟨by rw [hus', List.length_map, hlen], hvalR.store hm1'.2.2.2.2.1⟩)
  have hfr := bindR hb hi1 (RLink_of hE.2.1 hE.2.2) hvold hlay
  refine ⟨Rr + R0 + Rs, Rv + H0, ⟨CE η, (by f1q_tac), EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Rr + R0, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0), hDy.letW hterm rfl⟩,
    MemInv_store hm1' hsto hown husA hval hlen s2 hs2, MemHeldK_unfocus hX' hent hnv.2.2,
    CrKeep_trans (CrKeep_eqs f1 f3) (CrKeep_storeN hm1' hs2 (NVP_eqs hnv f1 f3))⟩, Res.le_def.2 fun k => ?_⟩
  have h1 := hle k
  simp only [Res.add_apply] at h1 ⊢
  omega

/-! ### (P4) Components of a cell, with resources -/

/-- (D3) `tstepMR_storeOwn` at an own cell with no frontier (`pfr = none`): `OwnNVP`/`OwnFrontierRMW` replaced by `hnf`. -/
theorem tstepMR_storeOwnN {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v : At} {tok : Option At}
    {u : Ty} {e : Expr} {Rf Rs H : Res}
    (hterm : th.term = .let_ x (.store rel a v tok) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.ptr .own u)) (hnw : wordOf (Ty.ptr .own u) = none)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    {Sp : AllocLabel → List Res} (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hnf : ∀ lab ru pw, evalAt th.env a = some (.ptr .own ru, [pw]) → pw.val = .loc ⟨lab, 0⟩ 0 →
      (CE η).pfr lab = none)
    (hia : StoreIall ρ η cx th)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hDy : DyFr p annNew (progTgts p) η th.σs th.term) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th,
      ∃ Tot H', ThInvMKQ (BiOut th) p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | storeWordGive hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storeWordKeep hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storeWordHand hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storePub hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeRgn hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeCap hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeOwn hp _ hc hwf hu hsub hb =>
  obtain ⟨t, u', tv, c₁, hp, hc, hwf, hu, hsub, hb⟩ : ∃ t u' tv c₁, cx.peek a = .ok t ∧
      cellOf t = some (.own, u') ∧ Ty.wordFreeIn cx.ke u' = true ∧ cx.use v = .ok (tv, c₁) ∧
      SubS c₁ tv u' ∧ c₁.bind x .unit = .ok c' :=
    ⟨_, _, _, _, hp, hc, hwf, hu, hsub, hb⟩
  rw [hpk] at hp; cases hp
  simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc; subst hc
  have hi0 := hi.1
  have hotv : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have ho : cx.opaqueOK u = true := sub_opaqueOK hsub hotv
  have htb : tb cx.ke.length u = true := tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.ptr .own u) = some (.own, u))
  obtain ⟨lab, c, pw, ru, hea, hpw, hsto, hcty, hacc, hown, hsku, hsig⟩ := ownPtr_view hi0 hpk htv ho
  have hpfN : (CE η).pfr lab = none := hnf lab ru pw hea hpw
  have hnv := NVP_priv (s := stOf mem pairs th) (Priv_of hsto hown hpfN)
  obtain ⟨rv, wsv, Rv, Rr, hev, hvv, hlv, hvrv, hi1, hle⟩ := useR hu hi hE.2.2
  have hsat : Sat c₁.facts ρ := hi1.1.1
  have hsigu : sig (close th.σs u) = sig (cl ρ η.wit 0 0 u) :=
    sig_WitL hi0.2.2.2.1 ρ ho (lt_of_guardT htb hi0.2.2.2.2.1)
  have hwcu : wc (cl ρ η.wit 0 0 u) ≠ none := by
    rw [← wc_of_sig hsigu]; exact (Lay_canon hsub hlv).2.2.2.1
  obtain ⟨us, hus⟩ : ∃ us, accs ru = some us := by
    have : wc ru ≠ none := by rw [wc_of_sig hsig]; exact hwcu
    cases h : accs ru with
    | none => simp [wc, h] at this
    | some us => exact ⟨us, rfl⟩
  obtain ⟨hval, hlen⟩ := ownStoreVal hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 hsat hsub ho htb hvv hlv hsig hus
  have husA : accs c.ty = some us := ((Fd_lay hcty).2.2.1.trans (pub_accs hi0.2.2.2.1 hi0.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi0.2.1 htv hpk rfl ho hea rfl).symm).trans hus
  have hus' : wc c.ty = some (nWords us) := by rw [(Fd_lay hcty).2.1, ← wc_of_sig hsig]; simp [wc, hus]
  replace hval := (Fd_EnvVal (CE η) hcty).2 hval
  have hvalR : EnvValR (CE η) c.ty wsv Rv := by
    obtain ⟨hs, -⟩ := Lay_canon hsub hlv
    have hvu : VRR ρ η u (shp (close th.σs u)) wsv Rv := by rw [← hs]; exact VRR_sub hsat hsub _ _ _ hvrv
    have hvc : VRR (fun _ => 0) (CE η) (cl ρ η.wit 0 0 u) (shp (cl ρ η.wit 0 0 u)) wsv Rv := by
      rw [← shp_of_sig hsigu]
      exact (VRR_close hE.2.1 hE.2.2 ρ u [] 0 ρ (fun _ => 0) (shp (close th.σs u)) wsv Rv (fun k => rfl)
        (fun k hk => absurd hk (Nat.not_lt_zero _))).1 hvu
    refine ⟨?_, hval.2⟩
    rw [(Fd_lay hcty).1]
    exact (Fd_VRR η hcty).2 hvc
  have key : tstep g mem pairs th =
      (storeUnits g.k g.arch pw ⟨lab, 0⟩ rel us wsv 0 (stOf mem pairs th)).map fun s' =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, .unit, []) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hev, cellOf, addrOf, hpw, hus, List.map_map]; rfl
  rw [key]
  obtain ⟨s0, hs0⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := pw) (a := ⟨lab, 0⟩) (rel := rel)
    us wsv 0 (stOf mem pairs th) hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hs0), fun r hr => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨s', hs', rfl⟩ := hr
  have hsn := hm.2.2.2.2.1
  have hfr := bindR hb hi1 (RLink_of hE.2.1 hE.2.2) (show VRR ρ η .unit (shp .unit) [] .zero from rfl) (unit_Lay _)
  rw [Res.add_zero] at hfr
  have hnaC : ∀ N e, c.ty ≠ .array (.lit N) e := fun N e he => by rw [he] at husA; simp [accs] at husA
  rcases hpfl : (CE η).pfr lab with _ | f
  · obtain ⟨g2, -⟩ := storeUnits_latP (a := ⟨lab, 0⟩) us wsv 0 (stOf mem pairs th)
      (stOf mem pairs th).vs.vRelSt hm.2.2.1 (MemInv_nodup hm) (Nat.le_refl _) s' hs'
    have htail : ∀ j : Nat, j < nWords us → TailP (stOf mem pairs th) (offs ⟨lab, 0⟩ (0 + j)) := fun j hj => by
      have := OwnOKPF_tail hm.2.1 hsto hown hpfl hus' j hj
      simpa [offs] using this
    obtain ⟨R0, H0, rfl, -, hX⟩ := MemHeldL_focusE hH lab
    have hX' : MemHeldXL (CE η) s' lab H0 Sp := MemHeldXL_store (a := ⟨lab, 0⟩) hX hm.2.2.1 hs'
    have hent : HeldEntry (CE η) s' lab Rv := HeldEntry_ownN hsto (NVP_store hnv hm.2.2.1 hs') (storeOwn_latestP hlen (g2 htail))
      (Or.inl ⟨by rw [hus', List.length_map, hlen], hvalR.store hsn⟩)
    refine ⟨Rr + Rs, Rv + H0, ⟨CE η, (by f1q_tac), EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Rr, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0), hDy.letW hterm rfl⟩,
      MemInv_store hm hsto hown husA hval hlen s' hs', MemHeldK_unfocus hX' hent hnv.2.2, CrKeep_storeN hm hs' hnv⟩, Res.le_def.2 fun k => ?_⟩
    have h1 := hle k
    simp only [Res.add_apply] at h1 ⊢
    omega
  · -- (F2) a cell with a frontier: memory's holding by the mix (`heldMixAt`)
    have hatC : AtOff c.ty (⟨lab, 0⟩ : Address).offset c.ty := .here (Or.inl (by rw [husA]; simp))
    obtain ⟨H2, Sl2, hH2, hHs0, hss⟩ := heldMixAtL (E := CE η) (nI := (CE η).rc) (TEnv.rc_le_ini (CE η) _) (a := ⟨lab, 0⟩) hm hH hsto hpfl hatC
      (IniAt_of_ne fun N e he => hnaC N e he) hnaC
      ((hia x rel a v tok e _ hterm hpk hnw _ pw ⟨lab, 0⟩ hea (by simp [addrOf, hpw]) c hsto).1 _ _ rfl 0 c.ty hatC) hfo.1 hvalR husA hlen hs'
    have hHs := MemHeldK_ofSSet (s0 := stOf mem pairs th) hHs0 hss (Or.inl (Nat.le_refl _))
    refine ⟨Rr + Rs, H2, ⟨CE η, (by f1q_tac), EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Rr, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0), hDy.letW hterm rfl⟩,
      MemInv_store hm hsto hown husA hval hlen s' hs', hHs, CrKeep_storeN hm hs' hnv⟩, Res.le_def.2 fun k => ?_⟩
    have h1 := hle k
    have h2 := hH2 k
    simp only [Res.add_apply] at h1 h2 ⊢
    omega


/-- **(P4) A component store to an own cell, memory's holding** (the
resourceful side of `MemInv_storeAt`): memory holds `H = R0 + H0`, `R0` the
cell's; the component's current words `vq` (its latest) hold `Rq`; after
storing a value holding `Rv` (from any state agreeing with `s` on memory,
promises and coherence), memory holds `R2 + H0`, with `R2 + Rq + H0 = Rv + H`. -/
theorem heldStoreAt {g : G} {E : TEnv} {s : St} {H : Res} {a : Address} {c : Cell} {us : List Acc}
    {ws : List Word} {U : Ty} {Rv : Res} (hm : MemInv g E s) (hH : MemHeld E s H)
    (hsto : E.sto a.label = some c) (hown : c.owner = some E.tid)
    (hnv : NVP E s a.label)
    (hcP : ∃ vals, CellOK E (E.rc a.label) c.ty vals ∧
      ∀ o v, vals[o]? = some v → LatestP s.mem s.promises s.vs.coh ⟨a.label, o⟩ v)
    (hat : AtOff c.ty a.offset U)
    (hini : IniAt E.rc c a U) (hna : ∀ N e, U ≠ .array (.lit N) e)
    (hU : EnvValR E U ws Rv) (hwU : wc U = some (nWords us)) (hlen : ws.length = nWords us) :
    ∃ vq Rq R2 H0, R2 + Rq + H0 = Rv + H ∧ vq.length = nWords us ∧
      (∀ j v, vq[j]? = some v → LatestP s.mem s.promises s.vs.coh (offs a (0 + j)) v) ∧
      VRR (fun _ => 0) (CE E.unsee) U (shp U) vq Rq ∧
      ∀ (k : Promises.Knobs) (arch : Arch) (pw : Word) (rel : Bool) (s1 : St), s1.mem = s.mem →
        s1.promises = s.promises → LoadCoh E s s1 → (∀ b, s.vs.coh b ≤ s1.vs.coh b) →
        SeenLE E s1.vs.vRelSt →
        ∀ s', s' ∈ storeUnits k arch pw a rel us ws 0 s1 → MemHeld E s' (R2 + H0) := by
  obtain ⟨vals, hcell, hlat⟩ := hcP
  obtain ⟨valsm, hW, hP⟩ := own_msgWordsN (E := E) hnv vals hlat
  obtain ⟨R0, H0, rfl, hent0, hX⟩ := MemHeld_focus hH a.label
  have hcR : CellOKR E (E.ini a.label) (E.rc a.label) c.ty valsm R0 :=
    HeldEntry_cell hent0 hsto hcell hW.length.symm (fun o w h => (hP o w h).2)
  rcases own_segR hcR hat (IniAt_mono E.rc_le_ini hini) hna with
    ⟨b, oS, S, wS, Rs, Rr, -, hbo, hatS, hwS, hbw, hR0, ⟨hvs, hVs⟩, hput⟩ | ⟨N0, e0, -, hT0, -, -, hr0, -⟩
  rotate_left
  · rcases hini N0 e0 hT0 with ⟨hUc, -⟩ | ⟨-, j0, -, -, hj0, -, -⟩
    · exact absurd (hUc.trans hT0) (hna N0 e0)
    · have hj1 : j0 < E.rc a.label := hj0
      omega
  have hsl : ((valsm.drop b).take wS).length = wS := by
    simp only [List.length_take, List.length_drop]; omega
  obtain ⟨n, Rq, Rr2, hwn, hle, hRs, hvq, hput2⟩ := VRR_at E.unsee hatS hvs (by rw [hsl]; exact hwS)
  rw [hwU] at hwn
  obtain rfl : nWords us = n := Option.some.inj hwn
  rw [hsl] at hle
  have hlenv : a.offset + nWords us ≤ valsm.length := by
    rw [← hbo, Nat.add_assoc]; exact Nat.le_trans (Nat.add_le_add_left hle b) hbw
  have hvqe : (((valsm.drop b).take wS).drop oS).take (nWords us) = (valsm.drop a.offset).take (nWords us) := by
    rw [take_drop_take hle, drop_drop', hbo]
  rw [hvqe] at hvq
  refine ⟨(valsm.drop a.offset).take (nWords us), Rq, Rv + Rr2 + Rr, H0, ?_, by simp; omega,
    fun j v hj => ?_, hvq, fun k arch pw rel s1 e1 e2 e3 hmono hsn1 s' hs' => ?_⟩
  · subst hR0; subst hRs; exact Res.ext fun k => by simp only [Res.add_apply]; omega
  · have hj' : valsm[a.offset + j]? = some v := by
      by_cases hjn : j < nWords us
      · rw [List.getElem?_take_of_lt hjn, List.getElem?_drop] at hj; exact hj
      · rw [List.getElem?_eq_none (by simp; omega)] at hj; cases hj
    have e : offs a (0 + j) = ⟨a.label, a.offset + j⟩ := by simp [offs]
    rw [e]; exact (hP _ v hj').1
  -- the store
  have hpl1 : PromLt s1 := fun t ht => by
    rw [e1]; rw [e2] at ht; exact hm.2.2.1 t ht
  have hnd1 : s1.promises.Nodup := by rw [e2]; exact hm.2.2.2.2.2.2.2.2.2.2.1
  have e3' : ∀ o, o < vals.length → s1.vs.coh ⟨a.label, o⟩ = s.vs.coh ⟨a.label, o⟩ := by
    obtain ⟨valsB, hcB, hlatB, -⟩ := e3.1 a.label c hsto hown
    have hlB : valsB.length = vals.length := (CellOKR_len hcR hcB).symm.trans hW.length.symm
    intro o ho
    have hA := hlat o (vals[o]'ho) (List.getElem?_eq_getElem ho)
    obtain ⟨⟨m1, hm1, hl1, -⟩, hn1, -⟩ := hlatB o (valsB[o]'(hlB ▸ ho)) (List.getElem?_eq_getElem _)
    rcases Nat.lt_or_ge (s.vs.coh ⟨a.label, o⟩) (s1.vs.coh ⟨a.label, o⟩) with hlt | hge
    · exact absurd (hA.2.2 _ m1 hlt hm1 hl1) hn1
    · exact Nat.le_antisymm hge (hmono _)
  have htail : ∀ j : Nat, j < nWords us → TailP s1 (offs a (0 + j)) := fun j hj => by
    have hlt : a.offset + j < vals.length := by
      have h1 : vals.length = valsm.length := hW.length
      rw [h1]; exact Nat.lt_of_lt_of_le (Nat.add_lt_add_left hj _) hlenv
    have hv := hlat (a.offset + j) (vals[a.offset + j]'hlt) (List.getElem?_eq_getElem hlt)
    have e : offs a (0 + j) = ⟨a.label, a.offset + j⟩ := by simp [offs]
    unfold TailP; rw [e1, e2, e, e3' _ hlt]
    exact fun t m ht hm hl => hv.2.2 t m ht hm hl
  obtain ⟨g2, g3⟩ := storeUnits_latP (a := a) us ws 0 s1 s1.vs.vRelSt hpl1 hnd1 (Nat.le_refl _) s' hs'
  replace g2 := g2 htail
  have hst := hU.store hsn1
  generalize hws' : ws.map (bumpW s1.vs.vRelSt) = ws' at hst
  have hlen' : ws'.length = nWords us := by rw [← hws', List.length_map]; exact hlen
  have hget : ∀ j w, ws[j]? = some w → ws'[j]? = some (bumpW s1.vs.vRelSt w) := fun j w hw => by
    rw [← hws', List.getElem?_map, hw]; rfl
  have hQ := hput2 ws' Rv hst.1 hlen'
  have hQV := (VR_put E.unsee hatS (VRR_VR S (RLink_of (Coh_CE _) (CohR_CE _)) hvs) hVs (by rw [hsl]; exact hwS)
    (VRR_VR U (RLink_of (Coh_CE _) (CohR_CE _)) hst.1) hst.2 (by rw [hlen']; exact hwU)).2.2
  rw [hlen'] at hQV
  have hQl : (((valsm.drop b).take wS).take oS ++ ws' ++ ((valsm.drop b).take wS).drop (oS + nWords us)).length = wS := by
    simp only [List.length_append, List.length_take, List.length_drop, hlen']; omega
  have hcell' := hput _ _ ⟨hQ, hQV⟩ hQl
  have hsp := splice_seg valsm ws' b wS oS (by rw [hlen']; exact hle)
  rw [hlen'] at hsp
  rw [hsp, hbo] at hcell'
  have hlat' : ∀ o v, (valsm.take a.offset ++ ws' ++ valsm.drop (a.offset + nWords us))[o]? = some v →
      LatestP s'.mem s'.promises s'.vs.coh ⟨a.label, o⟩ v := by
    intro o v hov
    rw [splice_get valsm ws' a.offset (nWords us) o hlen' hlenv] at hov
    by_cases hr : a.offset ≤ o ∧ o < a.offset + nWords us
    · rw [iteT hr] at hov
      obtain ⟨hr1, hr2⟩ := hr
      have hj : o - a.offset < ws.length := by rw [hlen]; exact Nat.sub_lt_left_of_lt_add hr1 hr2
      obtain ⟨w, hw⟩ : ∃ w, ws[o - a.offset]? = some w := ⟨ws[o - a.offset], List.getElem?_eq_getElem hj⟩
      rw [hget _ _ hw] at hov
      cases hov
      have := g2 (o - a.offset) w (by rw [← hlen]; exact hj) hw
      have e2 : offs a (0 + (o - a.offset)) = ⟨a.label, o⟩ := by
        simp only [offs, Nat.zero_add]; congr 1; exact Nat.add_sub_of_le hr1
      rw [e2] at this; exact this
    · rw [iteF hr] at hov
      have hold := (hP o v hov).1
      have hov' : o < vals.length := by rw [hW.length]; exact (List.getElem?_eq_some_iff.1 hov).1
      rw [← e1, ← e2] at hold
      replace hold := LatestS_coh_congr (e3' o hov') hold
      refine g3 _ _ (fun j hj e => ?_) hold
      have h' : o = a.offset + j := by simpa [offs] using congrArg WeakMem.Address.offset e
      subst h'
      exact hr ⟨Nat.le_add_right _ _, Nat.add_lt_add_left hj _⟩
  have hent : HeldEntry E s' a.label (Rv + Rr2 + Rr) :=
    HeldEntry_ownN hsto (NVP_store (NVP_eqs hnv e1 e2) hpl1 hs') hlat' hcell'
  have hX1 : MemHeldX E s1 a.label H0 := MemHeldX_tr hX (fun _ _ => rfl) (fun _ _ => rfl)
    (fun l' hne o w hl => by rw [← e1] at hl; rw [PromAt_eqp e2]; exact hl) id
  have hX' : MemHeldX E s' a.label H0 := MemHeldX_store hX1 hpl1 hs'
  exact MemHeld_unfocus hX' hent

/-- (D3) `tstepMR_storeLoc` at an own cell with no frontier (`pfr = none`): `OwnNVP`/`OwnFrontierRMW` replaced by `hnf`. -/
theorem tstepMR_storeLocN {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v : At} {tok : Option At}
    {u : Ty} {e : Expr} {Rf Rs H : Res}
    (hterm : th.term = .let_ x (.store rel a v tok) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.loc .own u)) (hnw : wordOf (Ty.loc .own u) = none)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    {Sp : AllocLabel → List Res} (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hnf : ∀ ad μr ru pw, evalAt th.env a = some (.loc μr ru, [pw]) → pw.val = .loc ad 0 →
      (CE η).pfr ad.label = none)
    (hia : StoreIall ρ η cx th)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hDy : DyFr p annNew (progTgts p) η th.σs th.term) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th,
      ∃ Tot H', ThInvMKQ (BiOut th) p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | storeWordGive hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storeWordKeep hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storeWordHand hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storePub hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeRgn hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeCap hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeOwn hp _ hc hwf hu hsub hb =>
  obtain ⟨t, u', tv, c₁, hp, hc, hwf, hu, hsub, hb⟩ : ∃ t u' tv c₁, cx.peek a = .ok t ∧
      cellOf t = some (.own, u') ∧ Ty.wordFreeIn cx.ke u' = true ∧ cx.use v = .ok (tv, c₁) ∧
      SubS c₁ tv u' ∧ c₁.bind x .unit = .ok c' :=
    ⟨_, _, _, _, hp, hc, hwf, hu, hsub, hb⟩
  rw [hpk] at hp; cases hp
  simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc; subst hc
  have hi0 := hi.1
  have hotv : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have ho : cx.opaqueOK u = true := sub_opaqueOK hsub hotv
  have htb : tb cx.ke.length u = true :=
    tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.loc .own u) = some (.own, u))
  obtain ⟨rv, wsv, Rv, Rr, hev, hvv, hlv, hvrv, hi1, hle⟩ := useR hu hi hE.2.2
  have hsat : Sat c₁.facts ρ := hi1.1.1
  have hsigu : sig (close th.σs u) = sig (cl ρ η.wit 0 0 u) :=
    sig_WitL hi0.2.2.2.1 ρ ho (lt_of_guardT htb hi0.2.2.2.2.1)
  have hwcu : wc (cl ρ η.wit 0 0 u) ≠ none := by
    rw [← wc_of_sig hsigu]; exact (Lay_canon hsub hlv).2.2.2.1
  have hna : ∀ n e, cl ρ η.wit 0 0 u ≠ .array (.lit n) e := fun n e h => hwcu (by rw [h]; simp [wc, accs])
  obtain ⟨ad, c, pw, μr, ru, hea, hpw, hsto, hat, hini, hown, hsku, hsig⟩ := locView hi0 hpk htv ho hwcu
  have hpfN : (CE η).pfr ad.label = none := hnf ad μr ru pw hea hpw
  have hnv := NVP_priv (s := stOf mem pairs th) (Priv_of hsto hown hpfN)
  obtain ⟨us, hus⟩ : ∃ us, accs ru = some us := by
    have : wc ru ≠ none := by rw [wc_of_sig hsig]; exact hwcu
    cases h : accs ru with
    | none => simp [wc, h] at this
    | some us => exact ⟨us, rfl⟩
  obtain ⟨hval, hlen⟩ := ownStoreVal hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 hsat hsub ho htb hvv hlv hsig hus
  have hwUA : accs (cl ρ η.wit 0 0 u) = some us := (accs_rtW hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 ho htb (peek_cell_lyt hi0.2.1 hpk hea rfl rfl).2).symm.trans hus
  have hwU : wc (cl ρ η.wit 0 0 u) = some (nWords us) := by rw [← wc_of_sig hsig]; simp [wc, hus]
  have hvalR := storeValR hE.2.1 hE.2.2 hi0.2.2.2.1 hi0.2.2.2.2.1 hsat hsub ho htb hvrv hlv hval.2
  have key : tstep g mem pairs th =
      (storeUnits g.k g.arch pw ad rel us wsv 0 (stOf mem pairs th)).map fun s' =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, .unit, []) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hev, cellOf, addrOf, hpw, hus, List.map_map]; rfl
  rw [key]
  obtain ⟨s0, hs0⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := pw) (a := ad) (rel := rel)
    us wsv 0 (stOf mem pairs th) hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hs0), fun r hr => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨s', hs', rfl⟩ := hr
  have hfr := bindR hb hi1 (RLink_of hE.2.1 hE.2.2) (show VRR ρ η .unit (shp .unit) [] .zero from rfl) (unit_Lay _)
  rw [Res.add_zero] at hfr
  rcases hpfl : (CE η).pfr ad.label with _ | f
  · obtain ⟨-, Rq, R2, H0, hRe, -, -, -, hput0⟩ := heldStoreAtL hm hH hsto hown hnv (OwnOKPF_cellP hm.2.1 hsto hown hpfl) hat hini hna hvalR hwU hlen
    have hput := fun k0 a0 p0 r0 s0 e1 e2 e3 e4 e5 s9 h9 => MemHeldK_ofSSetE (s0 := stOf mem pairs th) (hput0 k0 a0 p0 r0 s0 e1 e2 e3 e4 e5 s9 h9)
    refine ⟨Rr + Rs, R2 + H0, ⟨CE η, (by f1q_tac), EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Rr, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0), hDy.letW hterm rfl⟩,
      MemInv_storeAt hm hsto hown hat hini hna hval hwUA hlen s' hs',
      hput g.k g.arch pw rel _ rfl rfl (LoadCoh_of_eq hm.2.1 rfl) (fun _ => Nat.le_refl _) hm.2.2.2.2.1 s' hs',
      CrKeep_storeN hm hs' hnv⟩, Res.le_def.2 fun k => ?_⟩
    have h1 := hle k
    have h2 := congrArg (fun R : Res => R k) hRe
    simp only [Res.add_apply] at h1 h2 ⊢
    omega
  · -- (F2) a cell with a frontier: memory's holding by the mix (`heldMixAt`)
    obtain ⟨H2, Sl2, hH2, hHs0, hss⟩ := heldMixAtL (E := CE η) (nI := (CE η).rc) (TEnv.rc_le_ini (CE η) _) hm hH hsto hpfl hat hini hna
      ((hia x rel a v tok e _ hterm hpk hnw _ pw ad hea (by simp [addrOf, hpw]) c hsto).2 _ _ _ rfl hat .refl) hfo.1 hvalR hwUA hlen hs'
    have hHs := MemHeldK_ofSSet (s0 := stOf mem pairs th) hHs0 hss (Or.inl (Nat.le_refl _))
    refine ⟨Rr + Rs, H2, ⟨CE η, (by f1q_tac), EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Rr, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0), hDy.letW hterm rfl⟩,
      MemInv_storeAt hm hsto hown hat hini hna hval hwUA hlen s' hs', hHs,
      CrKeep_storeN hm hs' hnv⟩, Res.le_def.2 fun k => ?_⟩
    have h1 := hle k
    have h2 := hH2 k
    simp only [Res.add_apply] at h1 h2 ⊢
    omega

/-- (D3) `tstepMR_xchgLoc` at an own cell with no frontier (`pfr = none`): `OwnNVP`/`OwnFrontierRMW` replaced by `hnf`. -/
theorem tstepMR_xchgLocN {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {a v : At} {u : Ty} {e : Expr} {Rf Rs H : Res}
    (hterm : th.term = .let_ x (.xchg a v) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.loc .own u))
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    {Sp : AllocLabel → List Res} (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hnf : ∀ ad μr ru pw, evalAt th.env a = some (.loc μr ru, [pw]) → pw.val = .loc ad 0 →
      (CE η).pfr ad.label = none) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hDy : DyFr p annNew (progTgts p) η th.σs th.term) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      ∃ Tot H', ThInvMKQ (BiOut th) p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | xchg hp hx hu hsub hb =>
  obtain ⟨t, u', o, tv, c₁, hp, hx, hu, hsub, hb⟩ : ∃ t u' o tv c₁, cx.peek a = .ok t ∧
      XchgCell cx t u' o ∧ cx.use v = .ok (tv, c₁) ∧ (SubS c₁ tv u' ∨ SubS c₁ tv o) ∧
      c₁.bind x o = .ok c' := ⟨_, _, _, _, _, hp, hx, hu, hsub, hb⟩
  rw [hpk] at hp; cases hp
  cases hx with
  | rgn _ hc _ _ _ => simp [cellOf] at hc
  | own _ hc _ =>
  simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc; subst hc
  have hi0 := hi.1
  have hsub : SubS c₁ tv u := hsub.elim id id
  have hotv : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have ho : cx.opaqueOK u = true := sub_opaqueOK hsub hotv
  have htb : tb cx.ke.length u = true :=
    tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.loc .own u) = some (.own, u))
  have haf' : (cl ρ η.wit 0 0 u).arrFree = true := arrFree_cl hi0.2.2.2.2.2.2.1.af u 0 0 (bind_arrFree hb)
  have hna : ∀ n e, cl ρ η.wit 0 0 u ≠ .array (.lit n) e := fun n e h => by
    rw [h] at haf'; simp [Ty.arrFree] at haf'
  obtain ⟨rv, wsv, Rv, Rr, hev, hvv, hlv, hvrv, hi1, hle⟩ := useR hu hi hE.2.2
  have hsat : Sat c₁.facts ρ := hi1.1.1
  have hwcu : wc (cl ρ η.wit 0 0 u) ≠ none := by
    rw [← wc_of_sig (sig_WitL hi0.2.2.2.1 ρ ho (lt_of_guardT htb hi0.2.2.2.2.1))]
    exact (Lay_canon hsub hlv).2.2.2.1
  obtain ⟨ad, c, pw, μr, ru, hea, hpw, hsto, hat, hini, hown, hsku, hsig⟩ := locView hi0 hpk htv ho hwcu
  have hpfN : (CE η).pfr ad.label = none := hnf ad μr ru pw hea hpw
  have hnv := NVP_priv (s := stOf mem pairs th) (Priv_of hsto hown hpfN)
  obtain ⟨us, hus, ⟨r0, hr0⟩, hld, hstw⟩ := locLoad (arch := g.arch) (pw := pw) (acq := false)
    (s := stOf mem pairs th) hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hsto hown hat hini hna hsku hsig
      (peek_cell_lyt hi0.2.1 hpk hea rfl rfl).2
        (accs_rtW hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 ho htb (peek_cell_lyt hi0.2.1 hpk hea rfl rfl).2)
  obtain ⟨hval, hlen⟩ := ownStoreVal hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 hsat hsub ho htb hvv hlv hsig hus
  have hwUA : accs (cl ρ η.wit 0 0 u) = some us := (accs_rtW hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 ho htb (peek_cell_lyt hi0.2.1 hpk hea rfl rfl).2).symm.trans hus
  have hwU : wc (cl ρ η.wit 0 0 u) = some (nWords us) := by rw [← wc_of_sig hsig]; simp [wc, hus]
  have hvalR := storeValR hE.2.1 hE.2.2 hi0.2.2.2.1 hi0.2.2.2.2.1 hsat hsub ho htb hvrv hlv hval.2
  obtain ⟨vq, Rq, R2, H0, hRe, hvql, hvqlat, hvqR, hput0⟩ := heldStoreAtL hm hH hsto hown hnv (OwnOKPF_cellP hm.2.1 hsto hown hpfN) hat hini hna hvalR hwU hlen
  have hput := fun k0 a0 p0 r0 s0 e1 e2 e3 e4 e5 s9 h9 => MemHeldK_ofSSetE (s0 := stOf mem pairs th) (hput0 k0 a0 p0 r0 s0 e1 e2 e3 e4 e5 s9 h9)
  have key : tstep g mem pairs th =
      ((loadUnits g.arch pw ad false us 0 (stOf mem pairs th)).flatMap fun (s1, old) =>
        (storeUnits g.k g.arch pw ad false us wsv 0 s1).map fun s2 => (s2, ru, old)).map
        fun (s', t, ws) => (s'.mem, s'.pairs, withS { th with term := e, env := (x, t, ws) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hev, cellOf, addrOf, hpw, hus]
  rw [key] at ⊢
  have hm1 : ∀ r1, r1 ∈ loadUnits g.arch pw ad false us 0 (stOf mem pairs th) → PromAbove r1.1 → MemInv g (CE η) r1.1 :=
    fun r1 h hp => by
      obtain ⟨_, _, f1, f2, f3, f4, f5⟩ := hld r1 h hp
      exact MemInv_load hm f1 f2 f3 f4 f5 (loadUnits_relSt _ _ _ _ h) (loadUnits_vWr _ _ _ _ h)
  obtain ⟨s2, hs2⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := pw) (a := ad) (rel := false)
    us wsv 0 r0.1 hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem (List.mem_flatMap.2 ⟨r0, hr0, List.mem_map_of_mem hs2⟩)),
    fun r hr hpr0 => ?_⟩
  have hpr := hpr0
  rw [List.mem_map] at hr
  obtain ⟨⟨s', t', ws'⟩, hr, rfl⟩ := hr
  rw [List.mem_flatMap] at hr
  obtain ⟨⟨s1, old⟩, h1, h2⟩ := hr
  rw [List.mem_map] at h2
  obtain ⟨s2, hs2, he2⟩ := h2
  simp only [Prod.mk.injEq] at he2
  obtain ⟨rfl, rfl, rfl⟩ := he2
  have hp1 : PromAbove s1 := storeUnits_promAbove hs2 (fun t ht m hm => hpr t ht m hm)
  obtain ⟨-, hlay, f1, -, fc, f3, -⟩ := hld (s1, old) h1 hp1
  have hWold : WLe vq old := (loadUnits_latestPA hvql hvqlat h1 hp1).1
  have hvold := oldValR hE.2.1 hE.2.2 hsig (VRR_up _ _ _ _ _ hWold hvqR)
  have hm1' := hm1 (s1, old) h1 hp1
  have hfr := bindR hb hi1 (RLink_of hE.2.1 hE.2.2) hvold hlay
  refine ⟨Rr + Rq + Rs, R2 + H0, ⟨CE η, (by f1q_tac), EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Rr + Rq, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0), hDy.letW hterm rfl⟩,
