/-- (D3) Coherence messages at the units of a piece of an own cell. -/
theorem own_cohF {E : TEnv} {s : St} {lab : AllocLabel} {c : Cell} {b : Nat} {U : Ty} {us : List Acc}
    (hoo : OwnOKPF E s.mem s.pairs s.vs s.promises) (hsto : E.sto lab = some c)
    (hown : c.owner = some E.tid) (hat : AtOff c.ty b U) (hus : accs U = some us)
    (hinR : ∀ j, j < nWords us → InitRr E c lab (b + j)) :
    ∀ j, j < nWords us → ∃ m, s.mem[s.vs.coh ⟨lab, b + j⟩]? = some m ∧ m.loc = ⟨lab, b + j⟩ := by
  intro j hj
  obtain ⟨vals, hcell, hlat, -⟩ := hoo lab c hsto hown
  have hlt : b + j < vals.length := by
    rcases hcell with ⟨hwc, -⟩ | ⟨N, e, usE, hT, husE, hn, hlen, -⟩
    · obtain ⟨L, hL, hLw⟩ := Option.map_eq_some_iff.1 (show (accs c.ty).map nWords = some vals.length from hwc)
      have := AtOff_bound hat hL hus
      omega
    · have := hinR j hj N e usE hT husE
      rw [hlen]; exact Nat.lt_of_lt_of_le this (Nat.mul_le_mul_right _ hn)
  obtain ⟨⟨m, hm, hl, -⟩, -, -⟩ := hlat (b + j) (vals[b + j]'hlt) (List.getElem?_eq_getElem hlt)
  exact ⟨m, hm, hl⟩

