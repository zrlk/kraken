/-- (D3) `tstepMR_stl` at an own cell with no frontier (`pfr = none`): `OwnNVP`/`OwnFrontierRMW` replaced by `hnf`. -/
theorem tstepMR_stlN {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {b i v : At} {e : Expr} {Rf Rs H : Res}
