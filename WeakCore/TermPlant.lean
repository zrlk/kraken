/-- (H, pins) Rechoosing one slot `j` of label `l` keeps every untouched predicted slot
when the step touches slot `j`'s units (whenever they are nonempty). -/
theorem SKeepT_setSlot {E : TEnv} {s s' : St} {S : AllocLabel → List Res} {l : AllocLabel} {j : Nat} {Rj : Res}
    (h : ∀ c N e us, E.sto l = some c → c.ty = .array (.lit N) e → accs e = some us → 0 < nWords us →
      TouchS s s' l (j * nWords us) ((j + 1) * nWords us)) :
    SKeepT E s s' S (updS S l ((S l).set j Rj)) := by
  intro l' c N e us j' R hc hT hu hP hnt hR
  by_cases hl : l' = l
  · subst hl
    rw [updS_self]
    obtain hj | hj : j' ≠ j ∨ j' = j := (Decidable.em (j' = j)).symm
    · rw [List.getElem?_set_ne (Ne.symm hj)]; exact hR
    · subst hj
      obtain ⟨-, hiw, -⟩ := hP
      have hw : 0 < nWords us := by
        have := (IniW_cell hc hT hu).mp hiw
        rcases Nat.eq_zero_or_pos (nWords us) with h0 | h0
        · rw [h0, Nat.mul_zero] at this; exact absurd this (Nat.not_lt_zero _)
        · exact h0
      exact absurd (h c N e us hc hT hu hw) hnt
  · rw [updS_other S _ hl]; exact hR
