/-- (CRC) `tstepMCF_xchgOwnFLD` with the plant items (`PlantOp`/`CrItem`) at a separate credit `cr₁`, below `cr` at the promises the step discharges. -/
theorem tstepMCF_xchgOwnFLDC {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {a v : At} {u : Ty} {e : Expr} {Rf Rs H : Res}
    {cr db cr₁ : Ts → Res}
    (hterm : th.term = .let_ x (.xchg a v) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.ptr .own u))
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    {Sp : AllocLabel → List Res} (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCrP (CE η) (stOf mem pairs th) cr db)
    (hfr : ∀ lab ru pw, evalAt th.env a = some (.ptr .own ru, [pw]) → pw.val = .loc ⟨lab, 0⟩ 0 →
      (CE η).pfr lab ≠ none)
    {Ok : Memory × List Ts × TTh → Prop}
    (hpo : ∀ lab c, (CE η).sto lab = some c → c.owner = some (CE η).tid → (CE η).pfr lab ≠ none → OpTgt th lab →
      PlantOp g mem pairs th (CE η) cr₁ Ok lab c)
