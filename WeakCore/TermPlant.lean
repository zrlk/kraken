/-- (FulP) `stepOutRS_of` at an op whose target has no frontier (the cover and `FulP` are
vacuous). -/
theorem stepOutRS_ofT {QE : TEnv → Prop} {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory}
    {pairs : List Ts} {th : TTh} {cx : Cx} {η : TEnv}
    {Rf Rs H : Res} {cr db : Ts → Res} {Q : Memory × List Ts × TTh → Prop} {q : At}
    (hq : ∀ q', opAtomP th.term = some q' → q' = q)
    (hn : ∀ rt w ad off, evalAt th.env q = some (rt, [w]) → w.val = .loc ad off → (CE η).pfr ad.label = none)
    (hnp : ∀ x a e, th.term ≠ .let_ x (.publish a) e)
    (h : tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → Q r →
      ∃ Tot H' C F cr' db' Gd,
      ThInvMCFSQK (fun E' => QE E' ∧ KeepQ (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th cr cr')
        p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr' db' ∧
      MintStep g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧ ClaimAt th.term C F ∧
      Drop (CE η) (stOf mem pairs th) Gd ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr' + pSum (stOf mem pairs th) db + C + Res.sum (Gd.map GdE.R) ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db' + F ∧
      (PubShape cx th → GdCovT (CE η) (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) Gd th) ∧
        (¬ PubShape cx th → Gd = [])) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → Q r →
      ∃ Tot H' C F cr' db' Gd plh,
      ThInvMCFSQK (fun E' => QE E' ∧ KeepQRS (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th cr cr' plh)
        p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr' db' ∧
      MintStep g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧ ClaimAt th.term C F ∧
      Drop (CE η) (stOf mem pairs th) Gd ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr' + pSum (stOf mem pairs th) db + C + Res.sum (Gd.map GdE.R) +
          pSum (stOf r.1 r.2.1 r.2.2) plh ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db' + F ∧
      (PubShape cx th → GdCovT (CE η) (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) Gd th) ∧
        (¬ PubShape cx th → Gd = []) :=
  stepOutRS_of (hnp := hnp) (fun _ _ _ => repinCovU_tgt hq hn) (fun _ _ _ _ => fulP_tgt hq hn) (fun _ _ _ _ _ => rcKeepP_tgt hq hn) h
#print axioms TermPlant.stepOutRS_ofT

/-- (pool) `claimP_mapQ7` with eight witnesses. -/
theorem claimP_mapQ8 {α γ δ : Type} {L : List α} {th : TTh} {A B : α → Prop}
    {I : α → Res → Res → Res → Res → (Ts → Res) → (Ts → Res) → γ → δ → Prop} {M : α → Res → Res → Prop}
    {R : α → Res → Res → Res → Res → (Ts → Res) → (Ts → Res) → γ → δ → Prop}
    (hnp : ∀ x a e, th.term ≠ .let_ x (.publish a) e)
    (h : L ≠ [] ∧ ∀ r ∈ L, A r → B r → ∃ Tot H' C F cr' db' Gd plh,
      I r Tot H' C F cr' db' Gd plh ∧ M r C F ∧ ClaimAt th.term C F ∧ R r Tot H' C F cr' db' Gd plh) :
    L ≠ [] ∧ ∀ r ∈ L, A r → B r → ∃ Tot H' C F cr' db' Gd plh,
      I r Tot H' C F cr' db' Gd plh ∧ M r C F ∧ ClaimAtP th C F ∧ R r Tot H' C F cr' db' Gd plh :=
  ⟨h.1, fun r hr ha hb => let ⟨Tot, H', C, F, cr', db', Gd, plh, h1, h2, h3, h4⟩ := h.2 r hr ha hb
    ⟨Tot, H', C, F, cr', db', Gd, plh, h1, h2, ClaimAtP.of_not h3 hnp, h4⟩⟩
#print axioms TermPlant.claimP_mapQ8

/-- (OvW3 G-b) A `store` step's footprint: its outcome is a `storeUnits` outcome at the
evaluated target. -/
theorem tstep_store_foot {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {x : String} {rel : Bool} {a v : At} {tok : Option At} {e : Expr}
    (hterm : th.term = .let_ x (.store rel a v tok) e)
    {r : Memory × List Ts × TTh} (hr : r ∈ tstep g mem pairs th) :
    ∃ rt pw ad μ u us, evalAt th.env a = some (rt, [pw]) ∧ addrOf pw = some ad ∧
      cellOf rt = some (μ, u) ∧ accs u = some us ∧
      TgtFoot (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) ad.label ad.offset (nWords us) := by
  simp only [tstep, hterm, evalOp] at hr
  rw [List.mem_map] at hr
  obtain ⟨⟨s', t', ws'⟩, hin, rfl⟩ := hr
  split at hin
  · rename_i rt pw tv ws hea hev
    split at hin
    · rename_i μ u b hc hb
      split at hin
      · rename_i us hus
        rw [List.mem_map] at hin
        obtain ⟨s'', hs'', he⟩ := hin
        injection he with e1 e2
        subst e1
        exact ⟨rt, pw, b, μ, u, us, hea, hb, hc, hus, TgtFoot_of_units hs''⟩
      · simp at hin
    · simp at hin
  · simp at hin
#print axioms TermPlant.tstep_store_foot

/-- (OvW3 G-b) The units a protocol word's store writes are word units. -/
theorem wordStore_unit {p : Prog} {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {K : TEnv → List Word → Prop}
    {env : Env} {a : At} {t : Ty} {μ : Mode} {r : Idx} {P : Proto}
    (hpk : cx.peek a = .ok t) (ht : t = .ptr μ (.word r P) ∨ t = .loc μ (.word r P))
    (hi : FInv ρ η σs K cx env) (hE : EnvOK p η) (htv : TvOK cx) :
    ∀ rt pw ad μ' u us, evalAt env a = some (rt, [pw]) → addrOf pw = some ad → cellOf rt = some (μ', u) →
      accs u = some us → ∀ o, ad.offset ≤ o → o < ad.offset + nWords us → WordUnit (CE η) ⟨ad.label, o⟩ := by
  intro rt pw ad μ' u us hea hab hc hus o h1 h2
  have ho : cx.opaqueOK (.word r P) = true := by simp [Cx.opaqueOK, Ty.guardT]
  have hcell : cellOf t = some (μ, .word r P) := by rcases ht with rfl | rfl <;> rfl
  have hlr := pub_accs hi.2.2.2.1 hi.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi.2.1 htv hpk hcell ho hea hc
  cases hg : P.ghost
  · have hus1 : accs (cl ρ η.wit 0 0 (.word r P)) = some [.one] := by simp [cl, accs, hg]
    rw [hlr, hus1, Option.some.injEq] at hus
    subst hus
    obtain ⟨rt0, ws, hea0, hv, -⟩ := peek_VR hi.2.1 hpk
    obtain ⟨ad0, c, hws, hsto, hat, -, -⟩ := cell_target hcell (Fd_noarr (by rw [hus1]; simp)) hv
    rw [hea, Option.some.injEq, Prod.mk.injEq] at hea0
    obtain ⟨-, rfl⟩ := hea0
    rw [List.map_cons, List.map_nil, List.cons.injEq] at hws
    simp only [addrOf, hws.1, Option.some.injEq] at hab
    subst hab
    have hn1 : nWords [Acc.one] = 1 := by simp [nWords, Acc.size]
    rw [hn1] at h2
    have hoe : o = ad0.offset := Nat.le_antisymm (Nat.lt_succ_iff.1 h2) h1
    subst hoe
    exact ⟨c, hsto, Or.inl ⟨_, P, hg, by simpa only [cl, clI_zero] using hat⟩⟩
  · have hus0 : accs (cl ρ η.wit 0 0 (.word r P)) = some [] := by simp [cl, accs, hg]
    rw [hlr, hus0, Option.some.injEq] at hus
    subst hus
    exact absurd (Nat.lt_of_le_of_lt h1 h2) (by simp [nWords])
#print axioms TermPlant.wordStore_unit

/-- (OvW3 G-b) A protocol word's store needs no re-pin items: a promise it fulfils lies at
a word unit of its target, visible once the target has a frontier. -/
theorem repinCov_wordStore {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {K : TEnv → List Word → Prop}
    {x : String} {rel : Bool} {a v : At} {tok : Option At} {e : Expr} {t : Ty} {μ : Mode} {r : Idx} {P : Proto}
    (hterm : th.term = .let_ x (.store rel a v tok) e)
    (hpk : cx.peek a = .ok t) (ht : t = .ptr μ (.word r P) ∨ t = .loc μ (.word r P))
    (hi : FInv ρ η σs K cx th.env) (hE : EnvOK p η) (htv : TvOK cx) :
    ∀ r ∈ tstep g mem pairs th, ∀ E', RepinCov (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th [] := by
  intro r hr E'
  obtain ⟨rt, pw, ad, μ', u, us, hea, hab, hc, hus, hTF⟩ := tstep_store_foot hterm hr
  have hpw : ∃ off, pw.val = .loc ad off := by
    cases hv : pw.val <;> simp [addrOf, hv] at hab
    subst hab
    exact ⟨_, rfl⟩
  obtain ⟨off, hpw⟩ := hpw
  refine RepinCov_of (opTgtP_store hterm hea hpw) fun c o th0 tw _ _ hpf hnv hlo hth _ _ _ _ => ?_
  exfalso
  obtain ⟨m, hm, hml⟩ := hlo.2.1
  have hin : m.loc.label = ad.label ∧ ad.offset ≤ m.loc.offset ∧ ad.offset + nWords us > m.loc.offset :=
    Classical.byContradiction fun hn => hth (hTF.2.2 th0 m hlo.1 hm hn)
  rw [hml] at hin
  obtain ⟨f, hf⟩ := Option.ne_none_iff_exists'.1 hpf
  exact hnv ⟨wordStore_unit hpk ht hi hE htv rt pw ad μ' u us hea hab hc hus o hin.2.1 hin.2.2, Vis_pfr hf⟩
#print axioms TermPlant.repinCov_wordStore

/-- (OvW3 G-b) **Off the own-path ops** (and off `pub` stores at non-word cells), a step needs
no re-pin items: its atomic operation, if any, is a protocol word's store. -/
theorem repinCov_stepK {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {Rf Rs : Res}
    (hsc : StepScope cx th.term ∨ StepScopeR th.σs cx th.term)
    (hT : Typed p cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hO : ¬ OwnOpT cx th.term) (hps : ¬ PubShape cx th) :
    ∀ r ∈ tstep g mem pairs th, ∀ E', RepinCov (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th [] := by
  intro r hr E'
  cases hq : opAtomP th.term with
  | none => exact RepinCov_nop hq
  | some q =>
  have key : ∀ t0, opAtomP t0 = some q → ¬ OwnRMWT t0 →
      ∃ x rel a v tok e, t0 = .let_ x (.store rel a v tok) e := by
    intro t0 h hn
    unfold opAtomP at h
    split at h
    · exact absurd ⟨_, _, .inl ⟨_, _, rfl⟩⟩ hn
    · exact absurd ⟨_, _, .inr (.inl ⟨_, _, _, rfl⟩)⟩ hn
    · exact absurd ⟨_, _, .inr (.inr (.inl ⟨_, _, _, _, rfl⟩))⟩ hn
    · exact absurd ⟨_, _, .inr (.inr (.inr (.inl ⟨_, _, _, _, rfl⟩)))⟩ hn
    · exact absurd ⟨_, _, .inr (.inr (.inr (.inr (.inl ⟨_, _, _, rfl⟩))))⟩ hn
    · exact absurd ⟨_, _, .inr (.inr (.inr (.inr (.inr ⟨_, _, _, rfl⟩))))⟩ hn
    · exact ⟨_, _, _, _, _, _, rfl⟩
    · cases h
  obtain ⟨x, rel, a, v, tok, e, ht⟩ := key th.term hq fun h => hO (.inl h)
  have hT0 := hT
  rw [ht] at hT0
  cases hT0 with
  | let_ hop _ =>
  cases hop with
  | storeWordGive hp hw | storeWordKeep hp hw | storeWordHand hp hw =>
    obtain ⟨μ, hteq⟩ := wordOf_cases hw
    exact repinCov_wordStore ht hp hteq hi.1 hE htv r hr E'
  | storeOwn hp hnw hc =>
    exfalso
    rcases cell_cases hc with rfl | rfl
    · exact hO (.inr ⟨_, _, _, _, _, _, _, ht, .inl ⟨hp, hnw⟩⟩)
    · exact hO (.inr ⟨_, _, _, _, _, _, _, ht, .inr ⟨hp, hnw⟩⟩)
  | storePub hp hnw hc =>
    exfalso
    rcases cell_cases hc with rfl | rfl
    · exact hps ⟨_, _, _, _, _, _, _, ht, .inl ⟨hp, hnw⟩⟩
    · exact hps ⟨_, _, _, _, _, _, _, ht, .inr ⟨hp, hnw⟩⟩
  | storeRgn hp _ hc | storeCap hp _ hc =>
    exfalso
    rcases hsc with hs | hs
    · rw [ht] at hs
      exact hs _ hp _ _ hc
    · rw [ht] at hs
      simp only [StepScopeR, OpScopeR] at hs
#print axioms TermPlant.repinCov_stepK

