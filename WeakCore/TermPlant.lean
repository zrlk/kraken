/-- (bufInit re-pin) **The re-pin cover with no exclusion**: every unit, inside a solid piece,
of the operation's own frontier target cell whose lowest own promise the step fulfilled,
non-visible, overtaken at the post-state above the new lowest own promise `tw` inside its
window, is covered by a re-pin item. -/
def RepinCovXU (E E' : TEnv) (s s' : St) (th : TTh) (RS : List (AllocLabel × Cell × CrIt)) : Prop :=
  ∀ lab, OpTgtP th lab →
  ∀ c (o : Nat) th0 tw, E.sto lab = some c → c.owner = some E.tid → E.pfr lab ≠ none →
    ¬ VisU E ⟨lab, o⟩ → LowOwn s ⟨lab, o⟩ th0 → th0 ∉ s'.promises →
    LowOwn s' ⟨lab, o⟩ tw → OverT E' s' ⟨lab, o⟩ tw → WinGU E' s' lab o tw →
    (∃ q S usS, Piece c.ty q S ∧ accs S = some usS ∧ q ≤ o ∧ o < q + nWords usS) →
    ∃ y ∈ RS, y.1 = lab ∧ CrCov y.2.2 o

theorem RepinCov_ofX {E E' : TEnv} {s s' : St} {th : TTh} {RS : List (AllocLabel × Cell × CrIt)}
    (h : RepinCovXU E E' s s' th RS) : RepinCovU E E' s s' th RS :=
  fun lab _ hot => h lab hot
#print axioms TermPlant.RepinCov_ofX

theorem RepinCovXU_of {E E' : TEnv} {s s' : St} {th : TTh} {RS : List (AllocLabel × Cell × CrIt)} {l : AllocLabel}
    (htg : ∀ lab, OpTgtP th lab → lab = l)
    (h : ∀ c (o : Nat) th0 tw, E.sto l = some c → c.owner = some E.tid → E.pfr l ≠ none → ¬ VisU E ⟨l, o⟩ →
      LowOwn s ⟨l, o⟩ th0 → th0 ∉ s'.promises → LowOwn s' ⟨l, o⟩ tw → OverT E' s' ⟨l, o⟩ tw →
      WinGU E' s' l o tw → (∃ q S usS, Piece c.ty q S ∧ accs S = some usS ∧ q ≤ o ∧ o < q + nWords usS) →
      ∃ y ∈ RS, y.1 = l ∧ CrCov y.2.2 o) : RepinCovXU E E' s s' th RS := by
  intro lab hot
  obtain rfl := htg lab hot
  exact h
#print axioms TermPlant.RepinCovXU_of

