  obtain ⟨rt, pw, b, μ', ru, hea, hc, hab, hus⟩ := ghostRefK hpk ht hμ hg hi.1 hE htv
  have hnw : wordOf t ≠ none := by rcases ht with rfl | rfl <;> simp [wordOf]
