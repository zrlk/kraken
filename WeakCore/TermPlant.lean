/-- (FulP) A word store fulfils promises only at word units, so `FulP` is vacuous. -/
theorem fulP_wordStore {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {K : TEnv → List Word → Prop}
    {x : String} {rel : Bool} {a v : At} {tok : Option At} {e : Expr} {t : Ty} {μ : Mode} {r : Idx} {P : Proto}
    (hterm : th.term = .let_ x (.store rel a v tok) e)
    (hpk : cx.peek a = .ok t) (ht : t = .ptr μ (.word r P) ∨ t = .loc μ (.word r P))
    (hi : FInv ρ η σs K cx th.env) (hE : EnvOK p η) (htv : TvOK cx) :
    ∀ r ∈ tstep g mem pairs th, FulP (CE η) (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) th := by
  intro r hr
  obtain ⟨rt, pw, ad, μ', u, us, hea, hab, hc, hus, hTF⟩ := tstep_store_foot hterm hr
  intro _ _ _ t0 m c0 ht0 hn0 hm0 _ _ _ hnw
  exfalso
  have hin : m.loc.label = ad.label ∧ ad.offset ≤ m.loc.offset ∧ ad.offset + nWords us > m.loc.offset :=
    Classical.byContradiction fun hn => hn0 (hTF.2.2 t0 m ht0 hm0 hn)
  have e : m.loc = ⟨ad.label, m.loc.offset⟩ := by rw [← hin.1]
  rw [e] at hnw
  exact hnw (wordStore_unit hpk ht hi hE htv rt pw ad μ' u us hea hab hc hus _ hin.2.1 hin.2.2)
#print axioms TermPlant.fulP_wordStore

