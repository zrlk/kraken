        obtain ⟨H', ⟨S', hH'0, hS'⟩, heqH⟩ := heldWordAB (s := flipSt E E' s k) (s' := flipSt E E' s (k + 1)) hHk hsto hat hg hini hp
          hl0 hl1 ⟨v, hval, hinP⟩ hkeep
        have hnIk : ¬ InitAt s.mem m1.loc k := fun h => held_nundefB hHk.memHeld hsto hat hg hini hl0 (h w0 hpred)
        have hWA : WordAt E' m1.loc n P := ⟨c, by rw [hs]; exact hsto, hat, hg⟩
