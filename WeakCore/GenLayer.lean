    by_cases hF : VisU E' ⟨l, o⟩ ∧ ¬ VisU E ⟨l, o⟩
    · rw [PromAt_word hF.1, PromAt_nword hF.2 (fun h => hF.2 ⟨hWU _ hF.1, PredU_vis h⟩),
