  by_cases h : k < P.length
  · exact pre_wit_lt _ _ P k h
  · rw [pre_wit_ge _ P k (by omega), pre_wit_ge _ P k (by omega)]; rfl
theorem subEB_wit_lt {ρ₀ : Nat → Nat} {η : TEnv} {σs : List Ty} {k : Nat} {σ : Ty} (hk : σs[k]? = some σ) :
    (subEB ρ₀ η σs).wit k = cl ρ₀ η.wit 0 0 σ := by
  simp only [subEB, subE, hk]
theorem subEB_wit_ge {ρ₀ : Nat → Nat} {η : TEnv} {σs : List Ty} {k : Nat} (hl : σs.length ≤ k) :
    (subEB ρ₀ η σs).wit k = η.wit (k - σs.length) := by
  have : σs[k]? = none := List.getElem?_eq_none hl
  simp only [subEB, subE, this]
theorem TEnv.pubTop_shiftTNB (σ : Ty) : ∀ (P : List Ty) (η : TEnv),
    (TEnv.pre P η).pubTop (shiftTN P.length σ) = η.pubTop σ
  | [], _ => rfl
  | s :: P, η => by
      show ((TEnv.pre P η).insR 0 (fun _ _ => False) s).pubTop (Ty.shiftT 0 (shiftTN P.length σ)) = _
      rw [TEnv.pubTop_shiftT_insR]; exact TEnv.pubTop_shiftTNB σ P η
theorem TEnv.pubTop_shiftINB (η : TEnv) (σ : Ty) : ∀ d, η.pubTop (shiftIN d σ) = η.pubTop σ
