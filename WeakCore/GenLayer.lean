    refine ⟨Ra, Rb, ⟨hv, IniR_short ?_ ψ, fun _ => Or.inr (IniR_short ?_ ψ)⟩,
      ⟨hv', IniR_short ?_ ψ, fun _ => Or.inr (IniR_short ?_ ψ)⟩, hle⟩
