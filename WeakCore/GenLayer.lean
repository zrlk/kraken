  | refl => intros; exact Iff.rfl
  | intS h =>
      intro η ρ rt ws hs
      unfold IEq at h
      rcases h with rfl | ⟨hd, he⟩
      · exact Iff.rfl
      · simp only [VRF, VRb2, he ρ (hs hd)]
  | prod _ _ ih1 ih2 =>
      intro η ρ rt ws hs
      simp only [VRF, VRb2]
      exact exists_congr fun ra => exists_congr fun rb => and_congr_right fun _ =>
        forall_congr' fun n => imp_congr_right fun _ => and_congr_right fun _ =>
          and_congr (ih1 ρ ra _ hs) (ih2 ρ rb _ hs)
  | iex _ ih =>
      intro η ρ rt ws _
      simp only [VRF, VRb2]
      exact exists_congr fun n => exists_congr fun rb => exists_congr fun w =>
        and_congr_right fun _ => ih (vcons w ρ) rb ws (fun h => absurd h (Nat.succ_ne_zero _))
  | refine h' ih => intro η ρ rt ws hs; simp only [VRF, VRb2]; exact and_congr (ih ρ rt ws hs) (by rw [TEnv.selIni_tyEq η h', PubPosE_tyEq h'])
  | refineIni h h' ih =>
      intro η ρ rt ws hs
      simp only [VRF, VRb2]
      refine and_congr (ih ρ rt ws hs) ?_
      rw [TEnv.selIni_tyEq η h', PubPosE_tyEq h']
      unfold IEq at h
      rcases h with rfl | ⟨hd, he⟩
      · exact Iff.rfl
      · simp only [IniR, he ρ (hs hd)]
