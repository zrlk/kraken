  refine PubPosE_congrB (by rw [pre_box, pre_box]; rfl) (fun bx => ?_)
  rw [pp_substTs]
  congr 1
  funext k rt' ws' i
  by_cases hkc : k < P.length
  · simp only [SubO, hkc, if_true, PTopB]; rw [pre_wit_lt η (subEB ρ₀ η σs) P k hkc]
  · simp only [SubO, hkc, if_false]
    have hw' := pre_wit_ge (subEB ρ₀ η σs) P k (by omega)
    rcases hk : σs[k - P.length]? with _ | σ
    · have hl : σs.length ≤ k - P.length := by simpa using hk
      simp only [PTopB]
      rw [hw', pre_wit_ge η P _ (by omega), subEB_wit_ge hl,
        show k - σs.length - P.length = k - P.length - σs.length by omega]
