/-- An upper bound on the labels of `.loc` values in a message list. -/
def supVB : List Msg → Nat
  | [] => 0
  | m :: ms => (match m.val with | WeakMem.Val.loc a _ => a.label + 1 | _ => 0) + supVB ms

theorem lt_supVB : ∀ {ms : List Msg} {m : Msg}, m ∈ ms → ∀ {a : Address} {t : Nat},
    m.val = WeakMem.Val.loc a t → @LT.lt Nat instLTNat a.label (supVB ms)
  | [], _, hm, _, _, _ => absurd hm List.not_mem_nil
  | m' :: ms, m, hm, a, t, hv => by
    rcases List.mem_cons.mp hm with rfl | hm
    · simp only [supVB, hv]; show @LT.lt Nat instLTNat _ _; omega
    · have := lt_supVB hm hv; simp only [supVB]; show @LT.lt Nat instLTNat _ _; omega

theorem pay_boundB {E : TEnv} {mem : Memory} {Q : List Ts} (h : BoxTopP E mem Q) :
    ∀ x B, E.box x = some B → ∀ w ∈ B.pay, ∀ (a : Address) g, w.val = .loc a g →
      @LT.lt Nat instLTNat a.label (supVB mem.toList) := by
  intro x B hx w hw a g hv
  obtain ⟨o, ho⟩ := List.mem_iff_getElem?.mp hw
  obtain ⟨t, -, ⟨m, hm, -, hmv, -⟩, -⟩ := (h x B hx).2 o w ho
  have hmem : m ∈ mem.toList := Array.mem_toList_iff.mpr (Array.mem_of_getElem? hm)
  exact lt_supVB hmem (hmv.trans hv)

/-- **Supply discharge**: the supply at the thread's own geometry, from `MemInvB` only, plus `hn`.  Base `b := max s.nalloc (supVB s.mem.toList)`.  Fields: sto/ini/pfr from the
`FreshLPA` tuple (the (iii) `FreshLP` clause, with `rini`); box from `BoxInv.1`;
seen from `SeenLE` and pfr = none; payload from `BoxInv.2.1` (`BoxTopP`: a payload word is a memory message's value, so its
label is `< supVB mem ≤ b ≤ k ≤ freshLabel … k`, the last step by `hn : 0 < g.n`). -/
theorem supI_of_memInvB {g : G} {E : TEnv} {s : St} (hm : MemInvB g E s) (hn : 0 < g.n) :
    SupI g.lbase g.n g.i E := by
  obtain ⟨-, -, -, ⟨hF, -⟩, hS, -, -, -, -, ⟨hB, hT, -⟩, -⟩ := hm
  refine ⟨max s.nalloc (supVB s.mem.toList), fun k hk => ?_, ?_⟩
  · have hk1 : s.nalloc ≤ k := Nat.le_trans (Nat.le_max_left _ _) hk
    refine ⟨(hF k hk1).1, hB k hk1, (hF k hk1).2.2.1, (hF k hk1).2.2.2.1, (hF k hk1).2.2.2.2, fun hsn => ?_⟩
    obtain ⟨f, hf, -⟩ := hS _ hsn
    rw [(hF k hk1).2.2.2.2] at hf; cases hf
  · intro x B hx w hw a g' hv k hk heq
    have h1 := pay_boundB hT x B hx w hw a g' hv
    have h2 : k ≤ freshLabel g.lbase g.n g.i k := by
      unfold freshLabel; have := Nat.le_mul_of_pos_left k hn; omega
    have h3 := Nat.le_trans (Nat.le_max_right _ _) hk
    rw [heq] at h1; omega
end
end TermStep.Flat

