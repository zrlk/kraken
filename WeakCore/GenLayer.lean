        (fun j hj => hU2 j (by rw [hMT]; exact hj)))
      (by rw [CE_push0, CE_push0]; exact hE1) (by rw [CE_push0, CE_push0]; exact hE2)
      (by rw [CE_push0, CE_push0]; exact hF1) (by rw [CE_push0, CE_push0]; exact hF2)
