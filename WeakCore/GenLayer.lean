theorem subEB_box (ρ₀ : Nat → Nat) (η : TEnv) (σs : List Ty) : (subEB ρ₀ η σs).box = η.box := rfl
theorem subEB_prog (ρ₀ : Nat → Nat) (η : TEnv) (σs : List Ty) : (subEB ρ₀ η σs).prog = η.prog := rfl
theorem subEB_sto (ρ₀ : Nat → Nat) (η : TEnv) (σs : List Ty) : (subEB ρ₀ η σs).sto = η.sto := rfl
theorem subEB_tid (ρ₀ : Nat → Nat) (η : TEnv) (σs : List Ty) : (subEB ρ₀ η σs).tid = η.tid := rfl
theorem subEB_ini (ρ₀ : Nat → Nat) (η : TEnv) (σs : List Ty) : (subEB ρ₀ η σs).ini = η.ini := rfl
theorem subEB_rini (ρ₀ : Nat → Nat) (η : TEnv) (σs : List Ty) : (subEB ρ₀ η σs).rini = η.rini := rfl
theorem subEB_pfr (ρ₀ : Nat → Nat) (η : TEnv) (σs : List Ty) : (subEB ρ₀ η σs).pfr = η.pfr := rfl
theorem subEB_seen (ρ₀ : Nat → Nat) (η : TEnv) (σs : List Ty) : (subEB ρ₀ η σs).seen = η.seen := rfl
theorem subEB_get_ge {ρ₀ : Nat → Nat} {η : TEnv} {σs : List Ty} {k : Nat} (hl : σs.length ≤ k) :
    (subEB ρ₀ η σs).get k = η.get (k - σs.length) := by
  have : σs[k]? = none := List.getElem?_eq_none hl
  simp only [TEnv.get, subEB, this]
theorem pre_subEB_wit {ρ₀ : Nat → Nat} {η : TEnv} {σs : List Ty} (P : List Ty) :
