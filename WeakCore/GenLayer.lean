            rw [hw, pre_wit_ge η P _ (by omega), subEB_wit_ge hl]
            rw [show k - σs.length - P.length = k - P.length - σs.length by omega]
  | loc μ _ => cases μ <;> rfl
  | ptr μ _ => cases μ <;> rfl
  | ptrOpt μ _ => cases μ <;> rfl
  | _ => rfl
theorem PubPosE_substTsB (σs : List Ty) (η : TEnv) (ρ₀ : Nat → Nat) (hw : ∀ k, Clo (η.wit k)) (P : List Ty)
    (d : Nat) (t : Ty) {rt : Shp} {ws : List Word} :
