    (Bx : WeakMem.AllocLabel → Option Box := η.box) (Rd : Nat := η.rid) (F : List WeakMem.Ts := η.fp) (Ri : WeakMem.AllocLabel → Nat := η.rini) : TEnv :=
  { η with sto := s, ini := i, pfr := P, seen := S, box := Bx, rid := Rd, fp := F, rini := Ri, rels := fun k =>
      relCB ({ η with sto := s, ini := i, pfr := P, seen := S, box := Bx, rid := Rd, fp := F, rini := Ri } : TEnv) (η.wit k),
           urels := fun k => relCB ({ η with sto := s, ini := i, pfr := P, seen := S, box := Bx, rid := Rd, fp := F, rini := Ri } : TEnv).unsee (η.wit k),
           rrs := fun k => relCRB ({ η with sto := s, ini := i, pfr := P, seen := S, box := Bx, rid := Rd, fp := F, rini := Ri } : TEnv) (η.wit k),
           urrs := fun k => relCRB ({ η with sto := s, ini := i, pfr := P, seen := S, box := Bx, rid := Rd, fp := F, rini := Ri } : TEnv).unsee (η.wit k) }
def envWB (E : TEnv) (W : Nat → Ty) : TEnv :=
  { CE E with
    rels := fun k => relCB (CE E) (W k)
    urels := fun k => relCB (CE E).unsee (W k)
    rrs := fun k => relCRB (CE E) (W k)
    urrs := fun k => relCRB (CE E).unsee (W k)
    wit := W }
end
