      intro η ρ rt ws hs
      have e1 := fun rt ws => ih1 (bkG := False) (η := η) ρ rt ws hs
      have e2 := fun rt ws => ih2 (bkG := False) (η := η) ρ rt ws hs
      have e3 := fun rt ws => ih1 (bkG := False) (η := η.unsee) ρ rt ws hs
      have e4 := fun rt ws => ih2 (bkG := False) (η := η.unsee) ρ rt ws hs
      simp only [VRF, VRb2, e1, e2, e3, e4]
  | code h1 h2 _ _ =>
      intro η ρ rt ws hs
      simp only [VRF, VRb2, cl_tyEq0 h1 η.wit 0 hs, cl_tyEq0 h2 η.wit 0 hs]
  | array => intros; simp [VRF, VRb2]
  | ptr hm h _ =>
      intro η ρ rt ws hs
      simp only [VRF, VRb2, cl_tyEq0 h η.wit 0 hs, ModeOK_meqB (i := η.tid) hm]
  | ptrOpt hm h _ =>
