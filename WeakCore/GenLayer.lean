    rels := fun k => match σs[k]? with
      | some σ => fun rt ws => (VRF False) ρ₀ η σ rt ws
      | none => η.rels (k - σs.length)
    urels := fun k => match σs[k]? with
      | some σ => fun rt ws => (VRF False) ρ₀ η.unsee σ rt ws
      | none => η.urels (k - σs.length)
    rrs := fun k => match σs[k]? with
      | some σ => fun rt ws X => VRRB ρ₀ η σ rt ws X
      | none => η.rrs (k - σs.length)
    urrs := fun k => match σs[k]? with
      | some σ => fun rt ws X => VRRB ρ₀ η.unsee σ rt ws X
      | none => η.urrs (k - σs.length) }
