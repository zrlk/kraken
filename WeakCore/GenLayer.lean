      VRRB ρ' η' t (shp t) (mixU us sel ws2 ws1) Rb ∧ Ra + Rb ≤ R1 + R2) :
    ∃ Ra Rb, VRRB ρ η t (shp t) (mixU us sel ws1 ws2) Ra ∧
      VRRB ρ' η' t (shp t) (mixU us sel ws2 ws1) Rb ∧ Ra + Rb ≤ R1 + R2 := by
  by_cases hn : us.length ≤ 1
  · have hnU : nU t ≤ 1 := by rw [nU_of_accs hu]; exact hn
    rw [mixU_small hn l1 l2, mixU_small hn l2 l1]
    cases hs : sel 0
    · refine ⟨R2, R1, ?_, ?_, fun k => by simp only [Res.add_apply]; omega⟩
      · simp only [Bool.false_eq_true, ite_false]
        exact VRR_congrB t ρ2 ρ η2 η _ _ _ (fun j hj => (hI2 j (by rw [MI_small j hnU]; simp [hs, hj])).symm)
          (fun j hj => have h := hT2 j (by rw [MT_small j hnU]; simp [hs, hj]); ⟨h.1.symm, h.2.1.symm, h.2.2.symm⟩)
          hE2.symm h2
      · simp only [Bool.false_eq_true, ite_false]
        exact VRR_congrB t ρ1 ρ' η1 η' _ _ _ (fun j hj => (hJ2 j (by rw [MI_small j hnU]; simp [hs, hj])).symm)
          (fun j hj => have h := hU2 j (by rw [MT_small j hnU]; simp [hs, hj]); ⟨h.1.symm, h.2.1.symm, h.2.2.symm⟩)
          hF1.symm h1
    · refine ⟨R1, R2, ?_, ?_, Res.le_refl _⟩
      · simp only [ite_true]
        exact VRR_congrB t ρ1 ρ η1 η _ _ _ (fun j hj => (hI1 j (by rw [MI_small j hnU]; simp [hs, hj])).symm)
          (fun j hj => have h := hT1 j (by rw [MT_small j hnU]; simp [hs, hj]); ⟨h.1.symm, h.2.1.symm, h.2.2.symm⟩)
          hE1.symm h1
      · simp only [ite_true]
        exact VRR_congrB t ρ2 ρ' η2 η' _ _ _ (fun j hj => (hJ1 j (by rw [MI_small j hnU]; simp [hs, hj])).symm)
          (fun j hj => have h := hU1 j (by rw [MT_small j hnU]; simp [hs, hj]); ⟨h.1.symm, h.2.1.symm, h.2.2.symm⟩)
          hF2.symm h2
  · exact hint (by omega)
end
