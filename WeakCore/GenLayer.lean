      hE1 hE2 hF1 hF2 hc1 hc2 h1 h2
    refine mix2_wrapB hu l1 l2 hI1 hI2 hJ1 hJ2 hT1 hT2 hU1 hU2 hE1 hE2 hF1 hF2 h1 h2 (fun hn => ?_)
