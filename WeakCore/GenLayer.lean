      (∃ c n P, E.sto m.loc.label = some c ∧ AtOff c.ty m.loc.offset (.word (.lit n) P) ∧ P.ghost = false ∧
        IniAt E.ini c m.loc (.word (.lit n) P) ∧ pwf P = true ∧ ∃ v, m.val = .num v ∧ InP P v) ∧
      ∀ t' m', t' ∉ s.promises → s.mem[t']? = some m' → m'.loc = m.loc → t' < t)
    (hfp : E'.fp = E.fp)
    (hfpl : ∀ t m, t ∈ E.fp → s.mem[t]? = some m → Vis E' m.loc.label → Vis E m.loc.label)
    (hq : ∀ a : Address, PredU E' a ↔ PredU E a)
    (htid : E'.tid = E.tid := by first | rfl | assumption)
    (hbx : ∀ l B, E.box l = some B → E'.box l = some B := by first | exact fun _ _ h => h | assumption)
    (hri : ∀ l, E'.rini l = E.rini l := by first | exact fun _ => rfl | assumption) :
    ∃ H' cr' db', (∃ S', MemHeldLB E' s H' S' ∧ SKeep E S S') ∧ PromCrB E' s cr' db' ∧
      (∀ t m, t ∈ s.promises → s.mem[t]? = some m → ¬ (VisU E' m.loc ∧ ¬ VisU E m.loc) →
        cr' t = cr t ∧ db' t = db t) ∧
      H' + pSum s cr' + pSum s db = H + pSum s cr + pSum s db' := by
  have hWU : ∀ b, VisU E' b → WordUnit E b := fun b h => (WordUnit_congr (hs b.label)).1 h.1
  have hVE : ∀ b, VisU E b → VisU E' b := fun b h => ⟨(WordUnit_congr (hs b.label)).2 h.1, hmono _ h.2⟩
  have hFL : ∀ t m, t ∈ s.promises → s.mem[t]? = some m → VisU E' m.loc → ¬ VisU E m.loc →
      FlipT E E' s t := fun t m ht hm h1 h2 => ⟨ht, m, hm, h1, h2⟩
  have hFLat : ∀ t m, FlipT E E' s t → s.mem[t]? = some m → VisU E' m.loc ∧ ¬ VisU E m.loc := by
    rintro t m ⟨-, m', hm', h1, h2⟩ hm
    obtain rfl : m' = m := Option.some.inj (hm'.symm.trans hm)
    exact ⟨h1, h2⟩
  have hdF : ∀ t, t ∈ E.fp → ¬ FlipT E E' s t := by
    rintro t ht ⟨-, m, hm, h1, h2⟩
    exact h2 ⟨hWU _ h1, hfpl t m ht hm h1.2⟩
  have key : ∀ k, ∃ Hk crk dbk, (∃ Sk, MemHeldLB E (flipSt E E' s k) Hk Sk ∧ ∀ l, (∀ o, ¬ PredU E ⟨l, o⟩) ∨ Sk l = S l) ∧
      (∀ t, ¬ (t < k ∧ FlipT E E' s t) → crk t = cr t ∧ dbk t = db t) ∧
      (∀ t m, t < k → FlipT E E' s t → s.mem[t]? = some m → DbResB E' s.mem m t (dbk t) ∧
        ((∃ w, PredAt s.mem m.loc t w ∧ VRes E' m.loc w (crk t)) ∨
          ((∀ w, ¬ PredAt s.mem m.loc t w) ∧ crk t = .zero))) ∧
      Hk + pSum s crk + pSum s db = H + pSum s cr + pSum s dbk := by
    intro k
    induction k with
    | zero =>
      refine ⟨H, cr, db, ⟨S, MemHeldL_trB hH (fun _ => rfl) (fun _ => rfl)
        (fun l o w hl => LatestNP_congrP (fun t m _ _ => ?_) hl) id, fun _ => Or.inr rfl⟩, fun t _ => ⟨rfl, rfl⟩,
        fun t m h => absurd h (Nat.not_lt_zero _), rfl⟩
      rw [flip_at hdF]
      exact ⟨fun h => ⟨h, fun h' => Nat.not_lt_zero _ h'.1⟩, fun h => h.1⟩
    | succ k ih =>
      obtain ⟨Hk, crk, dbk, ⟨Sk, hHk, hSk⟩, hag, hent, heq⟩ := ih
      by_cases hk : FlipT E E' s k
      · obtain ⟨hkp, m, hm, hv1, hv2⟩ := id hk
        have hz : ∀ R w, VRes E m.loc w R → R = .zero := fun R w h =>
          h.elim (fun h1 => absurd ⟨hWU _ hv1, h1.1⟩ hv2) (fun h1 => h1.2)
        obtain ⟨m1, hm1, hd0, hc0⟩ := hC k hkp
        obtain rfl : m1 = m := Option.some.inj (hm1.symm.trans hm)
        have hnpL : ∀ o, ¬ PredU E ⟨m1.loc.label, o⟩ := fun o h => hv2 ⟨hWU _ hv1, (PredU_vis (a := ⟨m1.loc.label, o⟩) h : Vis E m1.loc.label)⟩
        have hcr0 : cr k = .zero := hc0.elim (fun ⟨_, _, h⟩ => hz _ _ h) (fun h => h.2)
        have hdb0 : db k = .zero :=
          (DbRes_nvisUB (fun h => h.elim hv2 (fun h => hv2 ⟨hWU _ hv1, PredU_vis h.1⟩))).1 hd0
        obtain ⟨e1, e2⟩ := hag k (fun h => Nat.lt_irrefl _ h.1)
        have hmemA : ∀ j t m', s.mem[t]? = some m' → m'.loc = m1.loc →
            (t ∈ (flipSt E E' s j).promises ↔ t ∈ s.promises ∧ ¬ t < j) := by
          intro j t m' hm' hl
          rw [mem_flipSt]
          constructor
          · rintro ⟨h1, h2⟩
            exact ⟨h1, fun h => h2 ⟨h, hFL t m' h1 hm' (by rw [hl]; exact hv1) (by rw [hl]; exact hv2)⟩⟩
          · rintro ⟨h1, h2⟩; exact ⟨h1, fun h => h2 h.1⟩
        have hPA : ∀ j, PromAt E (flipSt E E' s j) m1.loc = (flipSt E E' s j).promises := fun j =>
          PromAt_nwordP hv2 (fun h => hv2 ⟨hWU _ hv1, PredU_vis h⟩) (FpAt_priv fun h => hv2 ⟨hWU _ hv1, h⟩)
        have hkeep : ∀ b w, b ≠ m1.loc → LatestNP (flipSt E E' s k).mem (PromAt E (flipSt E E' s k) b) b w →
            LatestNP (flipSt E E' s (k + 1)).mem (PromAt E (flipSt E E' s (k + 1)) b) b w := by
          intro b w hb hl
          refine LatestNP_congrP (fun t m' hm' hl' => ?_) hl
          rw [flip_at hdF, flip_at hdF]
          have htk : t ≠ k := fun e => by
            subst e
            obtain rfl : m1 = m' := Option.some.inj (hm.symm.trans hm')
            exact hb hl'.symm
          exact and_congr_right fun _ => not_congr ⟨fun h => ⟨Nat.lt_succ_of_lt h.1, h.2⟩,
            fun h => ⟨Nat.lt_of_le_of_ne (Nat.le_of_lt_succ h.1) htk, h.2⟩⟩
        by_cases hIW : ¬ IniW E m1.loc
        · 
          obtain ⟨c, N, e, us, hsto, hT, hus, hge⟩ : ∃ c N e us, E.sto m1.loc.label = some c ∧
              c.ty = .array (.lit N) e ∧ accs e = some us ∧ E.ini m1.loc.label * nWords us ≤ m1.loc.offset :=
            Classical.byContradiction fun hno =>
              hIW fun c N e us h1 h2 h3 => Nat.lt_of_not_le fun h4 => hno ⟨c, N, e, us, h1, h2, h3, h4⟩
          have hl1 : ∃ w1, LatestNP (flipSt E E' s (k + 1)).mem (PromAt E (flipSt E E' s (k + 1)) m1.loc) m1.loc w1 := by
            rw [hPA]
            exact LatestNP_ex hm rfl (fun h => ((hmemA (k + 1) k m1 hm rfl).1 h).2 (Nat.lt_succ_self k))
          obtain ⟨S', hH'0, hS'⟩ := held_uninitAB hHk hsto hT hus hge hl1 hkeep
          have hnI' : ¬ IniW E' m1.loc := fun h => hIW ((IniW_congr (hs _) (hi _)).1 h)
          refine ⟨Hk, crk, dbk, ⟨S', hH'0, KeepP_upd hSk hS' hnpL⟩, fun t ht => hag t fun h => ht ⟨Nat.lt_succ_of_lt h.1, h.2⟩,
            fun t m' ht hf hm' => ?_, heq⟩
          by_cases htk : t = k
          · subst htk
            obtain rfl : m1 = m' := Option.some.inj (hm.symm.trans hm')
            rw [e1, e2, hcr0, hdb0]
            refine ⟨(DbRes_uninitB hnI').2 rfl, ?_⟩
            by_cases hp : ∃ w, PredAt s.mem m1.loc t w
            · obtain ⟨w, hw'⟩ := hp; exact Or.inl ⟨w, hw', (VRes_uninit hnI').2 rfl⟩
            · exact Or.inr ⟨fun w hw' => hp ⟨w, hw'⟩, rfl⟩
          · exact hent t m' (Nat.lt_of_le_of_ne (Nat.le_of_lt_succ ht) htk) hf hm'
        have hIW : IniW E m1.loc := Classical.byContradiction hIW
        obtain ⟨⟨c, n, P, hsto, hat, hg, hini, hp, v, hval, hinP⟩, hab⟩ := hw k m1 hkp hm hv1 hv2 hIW
        obtain ⟨w0, hl0⟩ := held_latB hHk.memHeld hsto hat hg hini
        have hl0' := hl0
        rw [hPA] at hl0'
        obtain ⟨t0, m0, ht0, hm0, hl0a, hw0, hlast0⟩ := hl0'
        have ht0k : t0 < k := by
          by_cases hp0 : t0 ∈ s.promises
          · exact Nat.lt_of_not_le fun h => ht0 ((hmemA k t0 m0 hm0 hl0a).2 ⟨hp0, Nat.not_lt.2 h⟩)
          · exact hab t0 m0 hp0 hm0 hl0a
        have hpred : PredAt s.mem m1.loc k w0 := ⟨t0, m0, ht0k, hm0, hl0a, hw0,
          fun t' m' h1 h2 hm' hl' => ((hmemA k t' m' hm' hl').1 (hlast0 t' m' h1 hm' hl')).2 h2⟩
        have hl1 : LatestNP (flipSt E E' s (k + 1)).mem (PromAt E (flipSt E E' s (k + 1)) m1.loc) m1.loc (mw m1) := by
          rw [hPA]
          refine ⟨k, m1, fun h => ((hmemA (k + 1) k m1 hm rfl).1 h).2 (Nat.lt_succ_self k), hm, rfl, rfl,
            fun t' m' h1 hm' hl' => ?_⟩
          by_cases hp' : t' ∈ s.promises
          · exact (hmemA (k + 1) t' m' hm' hl').2 ⟨hp', fun h => Nat.lt_irrefl _ (Nat.lt_of_lt_of_le h1 (Nat.le_of_lt_succ h))⟩
