        exact and_congr_right fun _ => not_congr
          ⟨fun h => ⟨Nat.lt_succ_of_lt h.1, h.2⟩,
            fun h => ⟨Nat.lt_of_le_of_ne (Nat.le_of_lt_succ h.1) (fun e => hk (e ▸ h.2)), h.2⟩⟩
  obtain ⟨HN, crN, dbN, ⟨SN, hHN, hSN⟩, hag, hent, heq⟩ := key s.mem.size
  have hnFL : ∀ t m, t ∈ s.promises → s.mem[t]? = some m → ¬ (VisU E' m.loc ∧ ¬ VisU E m.loc) →
      ¬ FlipT E E' s t := fun t m _ hm hn hf => hn (hFLat t m hf hm)
  refine ⟨HN, crN, dbN, ⟨SN, MemHeldL_trPB hHN hs hi (fun l o w hl => LatestNP_congrP (fun t m hm hloc => ?_) hl) hv,
