      · refine ⟨Hk, crk, dbk, ⟨Sk, MemHeldL_trB hHk (fun _ => rfl) (fun _ => rfl)
          (fun l o w hl => LatestNP_congrP (fun t m' _ _ => ?_) hl) id, hSk⟩,
          fun t ht => hag t (fun h => ht ⟨Nat.lt_succ_of_lt h.1, h.2⟩),
