  | word2 => intros; simp [VRF, VRb2]
  | tok2 => intros; simp [VRF, VRb2]
  | epair => intros; simp [VRF, VRb2]
  | tokE => intros; simp [VRF, VRb2]
  | tokNone => intros; simp [VRF, VRb2]
  | tokSome => intros; simp [VRF, VRb2]
  | share => intros; simp [VRF, VRb2]
  | cap => intros; simp [VRF, VRb2]
