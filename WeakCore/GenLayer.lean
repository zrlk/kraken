-- PORTB TermSound.lean:617 ModeOK_mono
namespace TermSound.Flat
open TermSound.Flat TermMem.Flat TermTear.Flat TermStep.Flat
section
set_option linter.unusedSimpArgs false
open CoreLang CoreTerm CoreTyping TermRun TermClose TermTv
theorem ModeOK_monoB {bkG : Prop} {i : Nat} {P P' : WeakMem.AllocLabel → Option WeakMem.Ts}
    {S S' : WeakMem.AllocLabel → Prop} (hP : ∀ l f, P l = some f → P' l = some f) (hS : ∀ l, S l → S' l)
    {μ : Mode} {l : WeakMem.AllocLabel} {c : Cell} {ws ws' : List Word}
    (hw : ∀ f, (∀ w ∈ ws, f ≤ w.view) → ∀ w ∈ ws', f ≤ w.view) :
    (ModeOKF bkG) i P S μ l c ws → (ModeOKF bkG) i P' S' μ l c ws' := by
  cases μ with
  | own => exact id
  | pub =>
    rintro ⟨f, h1, h2 | h2 | h2⟩
    · exact ⟨f, hP l f h1, Or.inl (hS l h2)⟩
    · exact ⟨f, hP l f h1, Or.inr (Or.inl (hw f h2))⟩
    · exact ⟨f, hP l f h1, Or.inr (Or.inr h2)⟩
  | rgn _ => exact id
end
end TermSound.Flat

-- PORTB TermSound.lean:1537 VRR
namespace TermSound.Flat
open TermSound.Flat TermMem.Flat TermTear.Flat TermStep.Flat
section
set_option linter.unusedSimpArgs false
open CoreLang CoreTerm CoreTyping TermRun TermClose TermTv
/-- D-VRR: `VRRB` with the rrs-only tvar arm (the resource `VRz`). -/
def VRRz (ρ : Nat → Nat) (η : TEnv) : Ty → Shp → List Word → Res → Prop
  | .unit, _, _, R => R = .zero
  | .intS i, _, ws, R => ws.map (·.val) = [.num (ev ρ i)] ∧ R = .zero
  | .int, _, ws, R => (∃ n, ws.map (·.val) = [.num n]) ∧ R = .zero
  | .opq o, _, ws, R => (VRF False) ρ η (.opq o) (.leaf (some 1)) ws ∧ R = .zero
  | .tid, _, ws, R => (VRF False) ρ η .tid (.leaf (some 1)) ws ∧ R = .zero
  | .fix sg w, rt, ws, R => (rt = .fix sg w ∧ ∃ n, ws.map (·.val) = [.num n] ∧ n < pw2 w) ∧ R = .zero
  | .lanes sg w, rt, ws, R => (rt = .lanes sg w ∧ ∃ n, ws.map (·.val) = [.num n]) ∧ R = .zero
  | .refine t ψ, rt, ws, R => VRRz ρ η t rt ws R ∧ IniR ρ (η.selIni t) ψ ws ∧
      (PubPosE η t rt ws → FreshW η ws ∨ IniR ρ η.rc ψ ws)
  | .iex b, rt, ws, R => ∃ n rb w, rt = .iex n rb ∧ VRRz (vcons w ρ) η b rb ws R
  | .prod a b, rt, ws, R => ∃ ra rb, rt = .prod ra rb ∧ ∃ Ra Rb, R = Ra + Rb ∧
      (ra.wc = none → R = .zero) ∧ ∀ n, ra.wc = some n →
      n ≤ ws.length ∧ VRRz ρ η a ra (ws.take n) Ra ∧ VRRz ρ η b rb (ws.drop n) Rb
  | .sum a b, rt, ws, R => ∃ n Ra Rb, rt = .sum n (.sum Ra Rb) ∧
      (((Ty.sum Ra Rb).tier = .boxed ∧ ∃ x s B, ws.map (·.val) = [.loc x 0] ∧ x.offset = 0 ∧
          η.box x.label = some B ∧ n = some (s + 1) ∧
          (s ≤ B.tag ∧ ((armsOf (.sum Ra Rb))[B.tag - s]?).bind wc = some B.pay.length) ∧
          ((η.seen x.label ∧ ∃ f, η.pfr x.label = some f ∧ B.fr ≤ f) ∨ ∀ w ∈ ws, B.fr ≤ w.view) ∧
          (B.tag - s < (armsOf Ra).length →
            (isBoxed Ra = true → VRRz ρ η a (vsh s (shp Ra)) ws R) ∧
            (isBoxed Ra = false → ∃ q, ofArm Ra (B.tag - s) B.pay = some q ∧ ShapeC Ra q ∧ wc Ra ≠ none ∧
              Valid Ra q ∧ VRRz ρ η.unsee a (shp Ra) q R)) ∧
          ((armsOf Ra).length ≤ B.tag - s →
            (isBoxed Rb = true → VRRz ρ η b (vsh (s + (armsOf Ra).length) (shp Rb)) ws R) ∧
            (isBoxed Rb = false → ∃ q, ofArm Rb (B.tag - s - (armsOf Ra).length) B.pay = some q ∧
              ShapeC Rb q ∧ wc Rb ≠ none ∧ Valid Rb q ∧ VRRz ρ η.unsee b (shp Rb) q R))) ∨ ∃ j p,
        decodeArm (Ty.sum Ra Rb).tier (armsOf (.sum Ra Rb)) ws = some (j, p) ∧
        (j < (armsOf Ra).length → ∃ q, ofArm Ra j p = some q ∧ VRRz ρ η a (shp Ra) q R) ∧
        ((armsOf Ra).length ≤ j → ∃ q, ofArm Rb (j - (armsOf Ra).length) p = some q ∧ VRRz ρ η b (shp Rb) q R))
  | .tvar k, rt, ws, R => ∃ ws', WLe ws' ws ∧ η.rrs k rt ws' R
  | .code σ τ _, _, ws, R => (∃ i d, ws.map (·.val) = [.num i] ∧ η.prog[i]? = some d ∧
      η.prog.find? (·.name == d.name) = some d ∧ d.tparams = [] ∧ d.idx = [] ∧
      cl ρ η.wit 0 0 σ = clD d.argTy ∧ cl ρ η.wit 0 0 τ = clD d.retTy) ∧ R = .zero
  | .ptr μ u, _, ws, R => (∃ a c, ws.map (·.val) = [.loc a 0] ∧ a.offset = 0 ∧ η.sto a.label = some c ∧
      Fd c.ty (cl ρ η.wit 0 0 u) ∧ (ModeOKF (False ∨ ∀ N e, c.ty ≠ .array (.lit N) e)) η.tid η.pfr η.seen μ a.label c ws ∧ accs c.ty ≠ none) ∧ R = ownW μ ws
  | .loc μ u, _, ws, R => ((ws.map (·.val) = [.null] ∧ ∃ e, Fd (.array (.lit 0) e) (cl ρ η.wit 0 0 u)) ∨
      ∃ a c U, ws.map (·.val) = [.loc a 0] ∧ η.sto a.label = some c ∧
        AtOff c.ty a.offset U ∧ Fd U (cl ρ η.wit 0 0 u) ∧ (ModeOKF (False ∨ IniAt η.rc c a U)) η.tid η.pfr η.seen μ a.label c ws ∧
          IniAt (modeIni μ η.ini η.rini) c a U) ∧ R = ownW μ ws
  | .ptrOpt μ u, _, ws, R => (ws.map (·.val) = [.null] ∨
      ∃ a c, ws.map (·.val) = [.loc a 0] ∧ a.offset = 0 ∧ η.sto a.label = some c ∧
        Fd c.ty (cl ρ η.wit 0 0 u) ∧ (ModeOKF (False ∨ ∀ N e, c.ty ≠ .array (.lit N) e)) η.tid η.pfr η.seen μ a.label c ws ∧ accs c.ty ≠ none) ∧ R = ownW μ ws
  | .void, _, _, _ => False
  | .tex κ b, rt, ws, R => ∃ n rb s, rt = .tex n rb ∧ Clo s ∧ WitOK κ s ∧ VRRz ρ (η.push0 s) b rb ws R
  | .mu b, rt, ws, R => VRRz ρ (η.push0 (cl ρ η.wit 0 0 (.mu b))) b rt ws R
  | .iall b, rt, ws, R => ∀ n, VRRz (vcons n ρ) η b rt ws R
  
  | .word r P, _, ws, R => (pwf P = true ∧ (P.ghost = false → ∃ n, ws.map (·.val) = [.num n] ∧ InP P n)) ∧
      ((WordHolds P (ws.map (·.val)) ∧ R = .one (.rg (ev ρ r)) + wdW P (ev ρ r)) ∨
        (¬ WordHolds P (ws.map (·.val)) ∧ R = wdW P (ev ρ r)))
  | .word2 r P, _, ws, R => (pwf2 P = true ∧ ∃ n0 n1, ws.map (·.val) = [.num n0, .num n1] ∧ InP2 P n0 n1) ∧
      ((Word2Holds P (ws.map (·.val)) ∧ R = .one (.rg (ev ρ r)) + .one (.wd (ev ρ r))) ∨
        (¬ Word2Holds P (ws.map (·.val)) ∧ R = .one (.wd (ev ρ r))))
  | .epair _ P, _, ws, R => (pwfE P = true ∧ ∃ n0 n1, ws.map (·.val) = [.num n0, .num n1]) ∧ R = .zero
  | .cap _ _, _, _, R => R = .zero
  | .tok r st, _, _, R => R = .one (.rg (ev ρ r)) + tokWd (ev ρ r) st
  | .tok2 r _ _ _, _, _, R => R = .one (.rg (ev ρ r))
  | .tokE r _ e, _, _, R => R = .one (.ep (ev ρ r) (ev ρ e))
  | .share r, _, _, R => R = .one (.sh (ev ρ r))
  
  
  
  | .array _ _, _, _, R => R = .zero

def VRRB (ρ : Nat → Nat) (η : TEnv) : Ty → Shp → List Word → Res → Prop
  | .unit, _, _, R => R = .zero
  | .intS i, _, ws, R => ws.map (·.val) = [.num (ev ρ i)] ∧ R = .zero
  | .int, _, ws, R => (∃ n, ws.map (·.val) = [.num n]) ∧ R = .zero
  | .opq o, _, ws, R => (VRF False) ρ η (.opq o) (.leaf (some 1)) ws ∧ R = .zero
  | .tid, _, ws, R => (VRF False) ρ η .tid (.leaf (some 1)) ws ∧ R = .zero
  | .fix sg w, rt, ws, R => (rt = .fix sg w ∧ ∃ n, ws.map (·.val) = [.num n] ∧ n < pw2 w) ∧ R = .zero
  | .lanes sg w, rt, ws, R => (rt = .lanes sg w ∧ ∃ n, ws.map (·.val) = [.num n]) ∧ R = .zero
  | .refine t ψ, rt, ws, R => VRRB ρ η t rt ws R ∧ IniR ρ (η.selIni t) ψ ws ∧
      (PubPosE η t rt ws → FreshW η ws ∨ IniR ρ η.rc ψ ws)
  | .iex b, rt, ws, R => ∃ n rb w, rt = .iex n rb ∧ VRRB (vcons w ρ) η b rb ws R
  | .prod a b, rt, ws, R => ∃ ra rb, rt = .prod ra rb ∧ ∃ Ra Rb, R = Ra + Rb ∧
      (ra.wc = none → R = .zero) ∧ ∀ n, ra.wc = some n →
      n ≤ ws.length ∧ VRRB ρ η a ra (ws.take n) Ra ∧ VRRB ρ η b rb (ws.drop n) Rb
  | .sum a b, rt, ws, R => ∃ n Ra Rb, rt = .sum n (.sum Ra Rb) ∧
      (((Ty.sum Ra Rb).tier = .boxed ∧ ∃ x s B, ws.map (·.val) = [.loc x 0] ∧ x.offset = 0 ∧
          η.box x.label = some B ∧ n = some (s + 1) ∧
          (s ≤ B.tag ∧ ((armsOf (.sum Ra Rb))[B.tag - s]?).bind wc = some B.pay.length) ∧
          ((η.seen x.label ∧ ∃ f, η.pfr x.label = some f ∧ B.fr ≤ f) ∨ ∀ w ∈ ws, B.fr ≤ w.view) ∧
          (B.tag - s < (armsOf Ra).length →
            (isBoxed Ra = true → VRRB ρ η a (vsh s (shp Ra)) ws R) ∧
            (isBoxed Ra = false → ∃ q, ofArm Ra (B.tag - s) B.pay = some q ∧ ShapeC Ra q ∧ wc Ra ≠ none ∧
              Valid Ra q ∧ VRRB ρ η.unsee a (shp Ra) q R)) ∧
          ((armsOf Ra).length ≤ B.tag - s →
            (isBoxed Rb = true → VRRB ρ η b (vsh (s + (armsOf Ra).length) (shp Rb)) ws R) ∧
            (isBoxed Rb = false → ∃ q, ofArm Rb (B.tag - s - (armsOf Ra).length) B.pay = some q ∧
              ShapeC Rb q ∧ wc Rb ≠ none ∧ Valid Rb q ∧ VRRB ρ η.unsee b (shp Rb) q R))) ∨ ∃ j p,
        decodeArm (Ty.sum Ra Rb).tier (armsOf (.sum Ra Rb)) ws = some (j, p) ∧
        (j < (armsOf Ra).length → ∃ q, ofArm Ra j p = some q ∧ VRRB ρ η a (shp Ra) q R) ∧
        ((armsOf Ra).length ≤ j → ∃ q, ofArm Rb (j - (armsOf Ra).length) p = some q ∧ VRRB ρ η b (shp Rb) q R))
  | .tvar k, rt, ws, R => ∃ ws', WLe ws' ws ∧ (η.rrs k rt ws' R ∨ (VRRz (fun _ => 0) (CE η) (η.wit k) rt ws' R ∧ R = .zero ∧ ∃ S0 w0 R0, η.rrs k S0 w0 R0))
  | .code σ τ _, _, ws, R => (∃ i d, ws.map (·.val) = [.num i] ∧ η.prog[i]? = some d ∧
      η.prog.find? (·.name == d.name) = some d ∧ d.tparams = [] ∧ d.idx = [] ∧
      cl ρ η.wit 0 0 σ = clD d.argTy ∧ cl ρ η.wit 0 0 τ = clD d.retTy) ∧ R = .zero
  | .ptr μ u, _, ws, R => (∃ a c, ws.map (·.val) = [.loc a 0] ∧ a.offset = 0 ∧ η.sto a.label = some c ∧
      Fd c.ty (cl ρ η.wit 0 0 u) ∧ (ModeOKF (False ∨ ∀ N e, c.ty ≠ .array (.lit N) e)) η.tid η.pfr η.seen μ a.label c ws ∧ accs c.ty ≠ none) ∧ R = ownW μ ws
  | .loc μ u, _, ws, R => ((ws.map (·.val) = [.null] ∧ ∃ e, Fd (.array (.lit 0) e) (cl ρ η.wit 0 0 u)) ∨
      ∃ a c U, ws.map (·.val) = [.loc a 0] ∧ η.sto a.label = some c ∧
        AtOff c.ty a.offset U ∧ Fd U (cl ρ η.wit 0 0 u) ∧ (ModeOKF (False ∨ IniAt η.rc c a U)) η.tid η.pfr η.seen μ a.label c ws ∧
          IniAt (modeIni μ η.ini η.rini) c a U) ∧ R = ownW μ ws
  | .ptrOpt μ u, _, ws, R => (ws.map (·.val) = [.null] ∨
      ∃ a c, ws.map (·.val) = [.loc a 0] ∧ a.offset = 0 ∧ η.sto a.label = some c ∧
        Fd c.ty (cl ρ η.wit 0 0 u) ∧ (ModeOKF (False ∨ ∀ N e, c.ty ≠ .array (.lit N) e)) η.tid η.pfr η.seen μ a.label c ws ∧ accs c.ty ≠ none) ∧ R = ownW μ ws
  | .void, _, _, _ => False
  | .tex κ b, rt, ws, R => ∃ n rb s, rt = .tex n rb ∧ Clo s ∧ WitOK κ s ∧ VRRB ρ (η.push0 s) b rb ws R
  | .mu b, rt, ws, R => VRRB ρ (η.push0 (cl ρ η.wit 0 0 (.mu b))) b rt ws R
  | .iall b, rt, ws, R => ∀ n, VRRB (vcons n ρ) η b rt ws R
  
  | .word r P, _, ws, R => (pwf P = true ∧ (P.ghost = false → ∃ n, ws.map (·.val) = [.num n] ∧ InP P n)) ∧
      ((WordHolds P (ws.map (·.val)) ∧ R = .one (.rg (ev ρ r)) + wdW P (ev ρ r)) ∨
        (¬ WordHolds P (ws.map (·.val)) ∧ R = wdW P (ev ρ r)))
  | .word2 r P, _, ws, R => (pwf2 P = true ∧ ∃ n0 n1, ws.map (·.val) = [.num n0, .num n1] ∧ InP2 P n0 n1) ∧
      ((Word2Holds P (ws.map (·.val)) ∧ R = .one (.rg (ev ρ r)) + .one (.wd (ev ρ r))) ∨
        (¬ Word2Holds P (ws.map (·.val)) ∧ R = .one (.wd (ev ρ r))))
  | .epair _ P, _, ws, R => (pwfE P = true ∧ ∃ n0 n1, ws.map (·.val) = [.num n0, .num n1]) ∧ R = .zero
  | .cap _ _, _, _, R => R = .zero
  | .tok r st, _, _, R => R = .one (.rg (ev ρ r)) + tokWd (ev ρ r) st
  | .tok2 r _ _ _, _, _, R => R = .one (.rg (ev ρ r))
  | .tokE r _ e, _, _, R => R = .one (.ep (ev ρ r) (ev ρ e))
  | .share r, _, _, R => R = .one (.sh (ev ρ r))
  
  
  
  | .array _ _, _, _, R => R = .zero
end
end TermSound.Flat

-- D-VRR: the resource VRz embeds in VRRB
namespace TermSound.Flat
section
open CoreLang CoreTerm CoreTyping TermRun TermClose TermTv TermSound
theorem TEnv.pubTop_instT (η : TEnv) (us : List Idx) (d : Nat) (t : Ty) : η.pubTop (instT us d t) = η.pubTop t := by
  cases t with
  | loc μ _ => cases μ <;> rfl
  | ptr μ _ => cases μ <;> rfl
  | ptrOpt μ _ => cases μ <;> rfl
  | _ => rfl
theorem VRRz_VRRB (t : Ty) : ∀ (ρ : Nat → Nat) (η : TEnv) (rt : Shp) (ws : List Word) (R : Res),
    VRRz ρ η t rt ws R → VRRB ρ η t rt ws R := by
  induction t with
  | tvar k =>
    intro ρ η rt ws R h; simp only [VRRz, VRRB] at h ⊢
    obtain ⟨w0, h0, h1⟩ := h; exact ⟨w0, h0, Or.inl h1⟩
  | refine t ψ ih =>
    intro ρ η rt ws R h; simp only [VRRz, VRRB] at h ⊢
    exact ⟨ih _ _ _ _ _ h.1, h.2⟩
  | iex b ih =>
    intro ρ η rt ws R h; simp only [VRRz, VRRB] at h ⊢
    obtain ⟨n, rb, w, hrt, hv⟩ := h; exact ⟨n, rb, w, hrt, ih _ _ _ _ _ hv⟩
  | prod a b iha ihb =>
    intro ρ η rt ws R h; simp only [VRRz, VRRB] at h ⊢
    obtain ⟨ra, rb, h1, Ra, Rb, hR, hz, hf⟩ := h
    exact ⟨ra, rb, h1, Ra, Rb, hR, hz, fun n hn => let ⟨e1, e2, e3⟩ := hf n hn; ⟨e1, iha _ _ _ _ _ e2, ihb _ _ _ _ _ e3⟩⟩
  | sum a b iha ihb =>
    intro ρ η rt ws R h; simp only [VRRz, VRRB] at h ⊢
    obtain ⟨n, Ra, Rb, h1, ⟨hb, x, s, B, hx, ho, hB, hn, hsB, hm, hA, hA'⟩ | ⟨j, p, hd, h2, h3⟩⟩ := h
    · exact ⟨n, Ra, Rb, h1, Or.inl ⟨hb, x, s, B, hx, ho, hB, hn, hsB, hm,
        fun hj => ⟨fun e => iha _ _ _ _ _ ((hA hj).1 e), fun e =>
          let ⟨q, hq, hs1, hw1, hv1, hv⟩ := (hA hj).2 e; ⟨q, hq, hs1, hw1, hv1, iha _ _ _ _ _ hv⟩⟩,
        fun hj => ⟨fun e => ihb _ _ _ _ _ ((hA' hj).1 e), fun e =>
          let ⟨q, hq, hs1, hw1, hv1, hv⟩ := (hA' hj).2 e; ⟨q, hq, hs1, hw1, hv1, ihb _ _ _ _ _ hv⟩⟩⟩⟩
    · exact ⟨n, Ra, Rb, h1, Or.inr ⟨j, p, hd, fun hj => let ⟨q, hq, hv⟩ := h2 hj; ⟨q, hq, iha _ _ _ _ _ hv⟩,
        fun hj => let ⟨q, hq, hv⟩ := h3 hj; ⟨q, hq, ihb _ _ _ _ _ hv⟩⟩⟩
  | tex κ b ih =>
    intro ρ η rt ws R h; simp only [VRRz, VRRB] at h ⊢
    obtain ⟨n, rb, s, hrt, hc, hw, hv⟩ := h; exact ⟨n, rb, s, hrt, hc, hw, ih _ _ _ _ _ hv⟩
  | mu b ih =>
    intro ρ η rt ws R h; simp only [VRRz, VRRB] at h ⊢
    exact ih _ _ _ _ _ h
  | iall b ih =>
    intro ρ η rt ws R h; simp only [VRRz, VRRB] at h ⊢
    exact fun n => ih _ _ _ _ _ (h n)
  | _ => intro ρ η rt ws R h; simpa only [VRRz, VRRB] using h
end
end TermSound.Flat

-- D-VRR (from PORTB) TermSound.lean:1620 `VRR_VR`
namespace TermSound.Flat
open TermSound.Flat TermMem.Flat TermTear.Flat TermStep.Flat
section
set_option linter.unusedSimpArgs false
open CoreLang CoreTerm CoreTyping TermRun TermClose TermTv
theorem VRRz_VRz : ∀ (t : Ty) {ρ : Nat → Nat} {η : TEnv} {rt : Shp} {ws : List Word} {R : Res},
    RLink η → VRRz ρ η t rt ws R → VRz ρ η False t rt ws := by
  intro t
  induction t with
  | refine t ψ ih => intro ρ η rt ws R hl h; simp only [VRRz] at h; simp only [VRz]; exact ⟨ih hl h.1, h.2⟩
  | iex b ih =>
      intro ρ η rt ws R hl h; simp only [VRRz] at h; simp only [VRz]
      obtain ⟨n, rb, w, e, h⟩ := h; exact ⟨n, rb, w, e, ih hl h⟩
  | prod a b iha ihb =>
      intro ρ η rt ws R hl h; simp only [VRRz] at h; simp only [VRz]
