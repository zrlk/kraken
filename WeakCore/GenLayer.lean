      intro η ρ rt ws hs; simp only [VRF, VRb2]
      exact exists_congr fun n => exists_congr fun rb => exists_congr fun s => and_congr_right fun _ =>
        and_congr_right fun _ => and_congr_right fun _ => ih ρ rb ws hs
