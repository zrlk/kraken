        constructor
        · rintro ⟨h, -⟩; exact h.imp id hFp.1
        · intro h
          refine ⟨h.imp id hFp.2, fun h' => hF ?_⟩
          have := hFLat t m h'.2 hm; rw [hloc] at this; exact this
  · obtain ⟨m, hm, hd, hc⟩ := hC t ht
    by_cases hf : FlipT E E' s t
    · obtain ⟨h1, h2⟩ := hent t m (hPb t ht) hf hm
      exact ⟨m, hm, h1, h2⟩
    · obtain ⟨e1, e2⟩ := hag t fun h => hf h.2
      have hn : ¬ (VisU E' m.loc ∧ ¬ VisU E m.loc) := fun h => hf (hFL t m ht hm h.1 h.2)
