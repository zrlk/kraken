  | tvar k => simp [cl, TEnv.pubTop]
  | loc μ _ => cases μ <;> rfl
  | ptr μ _ => cases μ <;> rfl
  | ptrOpt μ _ => cases μ <;> rfl
  | _ => rfl
theorem TEnv.pubTop_substTsB (σs : List Ty) (η : TEnv) (ρ₀ : Nat → Nat) (P : List Ty) (d : Nat) (t : Ty) :
