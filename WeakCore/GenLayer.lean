section
open CoreLang CoreTerm CoreTyping TermRun TermClose TermTv TermSound
def relCB (η : TEnv) (s : Ty) : Shp → List Word → Prop := fun S ws => (VRF False) (fun _ => 0) (CE η) s S ws
def relCRB (η : TEnv) (s : Ty) : Shp → List Word → Res → Prop := fun S ws X => VRRB (fun _ => 0) (CE η) s S ws X
def subEB (ρ₀ : Nat → Nat) (η : TEnv) (σs : List Ty) : TEnv :=
