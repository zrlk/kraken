AArch64 WRC+rel+casa+acq
{
0:X1=x; 0:X3=w;
1:X3=w;
2:X1=x; 2:X3=w;
}
 P0            | P1               | P2           ;
 MOV W0,#2     | MOV W4,#1        | LDAR W0,[X3] ;
 STR W0,[X1]   | MOV W5,#2        | LDR W2,[X1]  ;
 MOV W2,#1     | CASA W4,W5,[X3]  |              ;
 STLR W2,[X3]  |                  |              ;
exists (1:X4=1 /\ 2:X0=2 /\ 2:X2=0)
