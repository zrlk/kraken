 MOV X3,#0                |                 ;
 MOV X12,#1               |                 ;
 MOV X13,#1               |                 ;
 CASP X2,X3,X12,X13,[X15] |                 ;
exists (0:X6=1 /\ 1:X6=1 /\ 1:X7=0)
