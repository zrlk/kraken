AArch64 GOneCaspSingle
{
uint64_t x[2];
0:X14=y; 0:X15=x;
1:X14=x; 1:X15=y;
}
 P0                       | P1              ;
 LDR W6,[X14]             | LDP X6,X7,[X14] ;
