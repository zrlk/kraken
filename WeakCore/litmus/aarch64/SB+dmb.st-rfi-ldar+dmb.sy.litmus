AArch64 SB+dmb.st-rfi-ldar+dmb.sy
{
0:X14=x; 0:X15=y; 0:X16=z;
1:X14=z; 1:X15=x;
}
 P0            | P1           ;
 MOV W8,#1     | MOV W8,#1    ;
 STR W8,[X14]  | STR W8,[X14] ;
 DMB ST        | DMB SY       ;
 MOV W8,#1     | LDR W2,[X15] ;
 STR W8,[X15]  |              ;
 LDAR W2,[X15] |              ;
 LDR W4,[X16]  |              ;
exists (0:X2=1 /\ 0:X4=0 /\ 1:X2=0)
