AArch64 WRC+stlr+swp+ldar
{
0:X14=y; 0:X15=x;
1:X14=x;
2:X14=x; 2:X15=y;
}
 P0            | P1               | P2            ;
 MOV W8,#1     | MOV W11,#2       | LDAR W0,[X14] ;
 STR W8,[X14]  | SWP W11,W0,[X14] | LDR W1,[X15]  ;
 MOV W8,#1     |                  |               ;
 STLR W8,[X15] |                  |               ;
exists (1:X0=1 /\ 2:X0=2 /\ 2:X1=0)
