AArch64 MP+dmb.sy+data-rfi-ldr
{
0:X14=x; 0:X15=y;
1:X14=y; 1:X15=z; 1:X16=x;
}
 P0           | P1           ;
 MOV W8,#1    | LDR W0,[X14] ;
 STR W8,[X14] | EOR W8,W0,W0 ;
 DMB SY       | ADD W8,W8,#1 ;
 MOV W8,#1    | STR W8,[X15] ;
 STR W8,[X15] | LDR W7,[X15] ;
              | DMB LD       ;
              | LDR W5,[X16] ;
exists (1:X0=1 /\ 1:X7=1 /\ 1:X5=0)
