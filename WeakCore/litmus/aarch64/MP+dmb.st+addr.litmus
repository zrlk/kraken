AArch64 MP+dmb.st+addr
{
0:X14=x; 0:X15=y;
1:X14=y; 1:X15=x;
}
 P0           | P1                  ;
 MOV W8,#1    | LDR W0,[X14]        ;
 STR W8,[X14] | EOR W8,W0,W0        ;
 DMB ST       | ADD X10,X15,W8,SXTW ;
 MOV W8,#1    | LDR W1,[X10]        ;
 STR W8,[X15] |                     ;
exists (1:X0=1 /\ 1:X1=0)
