AArch64 WRC+data+addr
{
0:X14=x;
1:X14=x; 1:X15=y;
2:X14=y; 2:X15=x;
}
 P0           | P1           | P2                  ;
 MOV W8,#1    | LDR W0,[X14] | LDR W0,[X14]        ;
 STR W8,[X14] | EOR W8,W0,W0 | EOR W8,W0,W0        ;
              | ADD W8,W8,#1 | ADD X10,X15,W8,SXTW ;
              | STR W8,[X15] | LDR W1,[X10]        ;
exists (1:X0=1 /\ 2:X0=1 /\ 2:X1=0)
