AArch64 MP+stlr+ldr-str-rfi-ldar
{
0:X14=y; 0:X15=x;
1:X14=x; 1:X15=y;
}
 P0            | P1            ;
 MOV W8,#1     | LDR W0,[X14]  ;
 STR W8,[X14]  | MOV W8,#2     ;
 MOV W8,#1     | STR W8,[X14]  ;
 STLR W8,[X15] | LDAR W1,[X14] ;
               | LDR W2,[X15]  ;
exists (1:X0=1 /\ 1:X1=2 /\ 1:X2=0)
