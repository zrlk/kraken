AArch64 MP+casl+ldar
{
0:X14=x; 0:X15=y;
1:X14=y; 1:X15=x;
}
 P0                | P1            ;
 MOV W8,#1         | LDAR W0,[X14] ;
 STR W8,[X14]      | LDR W4,[X15]  ;
 MOV W0,#0         |               ;
 MOV W11,#1        |               ;
 CASL W0,W11,[X15] |               ;
exists (1:X0=1 /\ 1:X4=0)
