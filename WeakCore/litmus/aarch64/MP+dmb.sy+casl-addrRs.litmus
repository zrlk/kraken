AArch64 MP+dmb.sy+casl-addrRs
{
0:X14=x; 0:X15=y;
1:X14=y; 1:X15=x;
}
 P0           | P1                  ;
 MOV W8,#1    | MOV W0,#1           ;
 STR W8,[X14] | MOV W11,#2          ;
 DMB SY       | CASL W0,W11,[X14]   ;
 MOV W8,#1    | EOR W8,W0,W0        ;
 STR W8,[X15] | ADD X10,X15,W8,SXTW ;
              | LDR W5,[X10]        ;
exists (1:X0=1 /\ 1:X5=0)
