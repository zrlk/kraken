X86_64 IRIW+mfence
{ uint64_t x = 0; uint64_t y = 0; }
 P0           | P1           | P2             | P3             ;
 movq $1, (x) | movq $1, (y) | movq (x), %rax | movq (y), %rax ;
              |              | mfence         | mfence         ;
              |              | movq (y), %rbx | movq (x), %rbx ;
exists (2:rax=1 /\ 2:rbx=0 /\ 3:rax=1 /\ 3:rbx=0)
