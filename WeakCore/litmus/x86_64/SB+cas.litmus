X86_64 SB+cas
{ uint64_t x = 0; uint64_t y = 0; }
 P0                      | P1                      ;
 movq $0, %rax           | movq $0, %rax           ;
 movq $1, %r11           | movq $1, %r11           ;
 lock cmpxchgq (x), %r11 | lock cmpxchgq (y), %r11 ;
 movq (y), %rsi          | movq (x), %rsi          ;
exists (0:rsi=0 /\ 1:rsi=0)
