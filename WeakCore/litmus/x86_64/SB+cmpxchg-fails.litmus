X86_64 SB+cmpxchg-fails
{ uint64_t x = 0; uint64_t y = 0; }
 P0                      | P1                      ;
 movq $1, (x)            | movq $1, (y)            ;
 movq $5, %rax           | movq $5, %rax           ;
 movq $2, %r11           | movq $2, %r11           ;
 lock cmpxchgq (y), %r11 | lock cmpxchgq (x), %r11 ;
exists (0:rax=0 /\ 1:rax=0)
