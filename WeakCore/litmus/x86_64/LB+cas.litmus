X86_64 LB+cas
{ uint64_t x = 0; uint64_t y = 0; }
 P0                      | P1                      ;
 movq (x), %rsi          | movq (y), %rsi          ;
 movq $0, %rax           | movq $0, %rax           ;
 movq $1, %r11           | movq $1, %r11           ;
 lock cmpxchgq (y), %r11 | lock cmpxchgq (x), %r11 ;
exists (0:rsi=1 /\ 1:rsi=1)
