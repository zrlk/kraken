    (hP : ∀ t, t ∈ s.promises → t < s.mem.size) (hFb : ∀ t, t ∈ E.fp → t < s.mem.size)
    (hH : MemHeldL E s H Sl) (hC : PromCr E s cr db)
    (hsto : E.sto a.label = some c) (hat : AtOff c.ty a.offset U) (hini : IniAt E.ini c a U)
    (hus : accs U = some [.one]) (hdw : dwf U = true)
    (hval : EnvValR E U [nw] Rv) (hS : SeenLE E s1.vs.vRelSt)
    (e1 : s1.mem = s.mem) (e2 : s1.promises = s.promises) (hcoh1 : ∀ b, s.vs.coh b ≤ s1.vs.coh b)
    (hs2 : s2 ∈ storeUnits k arch pw a rel [.one] [nw] 0 s1)
    (e3 : s'.mem = s2.mem) (e4 : s'.promises = s2.promises)
