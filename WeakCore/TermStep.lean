/-- **(P4) `casCell`, with resources**: the stored value is used (`useR`): its
resources `Rv` go to memory on success (`rmwPlainAcc`) and are dropped on
failure; nothing is minted. -/
theorem casCellC_core {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx c₁ c₂ : Cx} {ρ : Nat → Nat} {η : TEnv} {acq rel : Bool} {w e v : At} {t : String} {ok fail : Expr}
    {tw : Ty} {μ : Mode} {u te tv : Ty} {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .cas acq rel w e v t ok fail)
    (hpk : cx.peek w = .ok tw) (hcw : cellOf tw = some (μ, u)) (hone : u.rawWords = some 1)
    (haff : affine cx.ke u = false)
    (hpe : cx.peek e = .ok te) (hu : cx.use v = .ok (tv, c₁))
    (hsube : SubS c₁ te u) (hsubv : SubS c₁ tv u) (hb : c₁.bind t .unit = .ok c₂)
    (hok : TypedK p η c₂ ok) (hfail : TypedK p η c₁ fail)
    (hcellL : ∀ nw, EnvVal (CE η) (cl ρ η.wit 0 0 u) [nw] → CasCell g mem pairs th η acq rel w nw)
    (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (_hrmw : NoPlantRMW (CE η) th) (hRP : RetPw th.σs th.stack cx.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  have hRL := RLink_of hE.2.1 hE.2.2
  have hotv : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have ho : cx.opaqueOK u = true := sub_opaqueOK hsubv hotv
  have htb : tb cx.ke.length u = true := tb_cellOf (peek_tb htv hpk) hcw
  have hus : accs (cl ρ η.wit 0 0 u) = some [.one] := accs_cl_one hone
  obtain ⟨rv, wsv, Rv, Rr, hev, hvv, hlv, hvrv, hi1, hle⟩ := useR hu hi hE.2.2
  have htv1 := (use_TvOK hu htv).1
  obtain ⟨hval, hlen⟩ := ownStoreVal (ru := cl ρ η.wit 0 0 u) hE.2.1 hi.1.2.2.2.1 hi.1.2.2.2.2.1 hi1.1.1
    hsubv ho htb hvv hlv rfl hus
  obtain ⟨nw, rfl⟩ := len_one hlen
  have hvalR : EnvValR (CE η) (cl ρ η.wit 0 0 u) [nw] Rv :=
    storeValR hE.2.1 hE.2.2 hi.1.2.2.2.1 hi.1.2.2.2.2.1 hi1.1.1 hsubv ho htb hvrv hlv hval.2
  obtain ⟨rte, wse, hee, hve, hle'⟩ := peek_VR hi.1.2.1 hpe
  obtain ⟨hve1, hlene⟩ := ownStoreVal (ru := cl ρ η.wit 0 0 u) hE.2.1 hi.1.2.2.2.1 hi.1.2.2.2.2.1 hi1.1.1
    hsube ho htb hve hle' rfl hus
  obtain ⟨ew, rfl⟩ := len_one hlene
  have hnu : ew.val ≠ .undef := VR_word1_nundef _ hve1.1 hus rfl
  obtain ⟨ad, pw, rw, hea, haddr, hne, hcell⟩ := hcellL nw hval
  obtain ⟨rt2, pw2, ad2, c, hea2, hpw2, hsto, hat, hini, hdw⟩ := plainTarget hi.1 hE hpk hcw hone haff htb
  rw [hea] at hea2
  simp only [Option.some.injEq, Prod.mk.injEq, List.cons.injEq, and_true] at hea2
  obtain ⟨-, rfl⟩ := hea2
  obtain rfl : ad2 = ad := by simp only [addrOf, hpw2, Option.some.injEq] at haddr; exact haddr
  have key : tstep g mem pairs th =
      (Promises.stepRmw g.k g.arch mem pairs (mth (stOf mem pairs th) pw nw nw) 1 ad2 (.cas ew.val)
          (dataE 1 nw) [0] acq rel).map fun (mem', th') =>
        (mem', pairs, withS (if (th'.regs 1).val == ew.val then
            { th with term := ok, env := (t, .unit, []) :: th.env } else { th with term := fail })
          ⟨mem', pairs, th'.vs, th'.promises, th.nalloc, th.undefs + countUndef [th'.regs 1]⟩) := by
    simp only [tstep, hterm, hea, hee, hev, haddr]; rfl
  rw [key] at ⊢
  refine ⟨fun h => stepRmw_ne_nil (loadUnits_one_msg hne) (List.map_eq_nil_iff.1 h), fun r hr hpr0 => ?_⟩
  have hpr := hpr0
  rw [List.mem_map] at hr
  obtain ⟨⟨mem', th'⟩, hin, rfl⟩ := hr
  obtain ⟨s1, rd, hl1, hrd, hpS, hcase⟩ := stepRmw_splitP (s := stOf mem pairs th) hin
  obtain ⟨tm, m, hmt, hml, hrv, hmc⟩ := stepRmw_mem hin
  obtain ⟨hm1, hst2⟩ := hcell s1 [rd] hl1 (hpS (fun t ht m hm => hpr t ht m hm))
  have hP : ∀ t, t ∈ (stOf mem pairs th).promises → t < (stOf mem pairs th).mem.size :=
    fun t ht => hm.2.2.1 t ht
  rcases hcase with ⟨hne', hsame⟩ | ⟨heq, s2, hs2, hsame⟩
  · have hb' : ((th'.regs 1).val == ew.val) = false := by rw [hrd]; simpa using hne'
    simp only [hb']
    have hfl : mem' = mem ∧ th'.promises = th.promises := by
      rcases hmc with ⟨-, h1, h2⟩ | ⟨hs, -⟩
      · exact ⟨h1, h2⟩
      · exfalso
        simp only [WeakMem.rmwSucceeds, WeakMem.RmwKind.succeeds, decide_eq_true_eq] at hs
        rw [hrd] at hrv; exact hne' (hrv.trans hs)
    obtain ⟨rfl, hpr⟩ := hfl
    refine ⟨Rr + Rs, H, .zero, .zero, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c₁, Rr, Rs, rfl, hE, hfail, htv1, hi1, rfl, by rw [use_ret hu]; exact hRP⟩,
      MemInv_same (MemInv_lockS g.arch hm1) hsame, MemHeldK_eqs hH rfl hpr,
      PromCr_keep hC hpr hP (fun t _ => rfl) (fun _ _ _ _ => rfl)⟩, MintStepN.none, ?_⟩
    simp only [pSum, stOf, withS, hpr]
    exact Res.le_def.2 fun k => by
      have := hle k; simp only [Res.add_apply, Res.zero_apply] at this ⊢; omega
  · have hb' : ((th'.regs 1).val == ew.val) = true := by rw [hrd]; simpa using heq
    simp only [hb', ite_true]
    have hmv : m.val = ew.val := by rw [← hrv, hrd]; exact heq
    obtain ⟨f1, -, f2, -⟩ := loadUnits_frame [.one] 0 _ (s1, [rd]) hl1
    have hm1b := MemInv_bumpRel (MemInv_lockR g.arch (stOf mem pairs th) hm1) (max (Promises.pairTop (stOf mem pairs th).pairs rd.rts) rd.view)
    have hmnu : m.val ≠ .undef := by rw [hmv]; exact hnu
    have hcase' : (∃ m0, mem' = mem.push m0 ∧ th'.promises = th.promises) ∨
        (∃ tw pm, tw ∈ th.promises ∧ mem' = mem ∧ th'.promises = th.promises.erase tw ∧
          mem[tw]? = some pm ∧ pm.loc = ad2 ∧
          ∃ tr mr, tr < tw ∧ mem[tr]? = some mr ∧ mr.loc = ad2 ∧ mr.val ≠ .undef) := by
      rcases hmc with ⟨hs, -⟩ | ⟨-, ⟨mv, h1, h2, -⟩ | ⟨tw, pm, h1, h2, h3, h4, h5, -, hadj⟩⟩
      · exfalso; simp [WeakMem.rmwSucceeds, WeakMem.RmwKind.succeeds, hmv] at hs
      · exact Or.inl ⟨_, h1, h2⟩
      · exact Or.inr ⟨tw, pm, h1, h2, h3, h4, h5, tm, m, (rmwAdjacent_spec hadj).1, hmt, hml, hmnu⟩
    obtain ⟨H', hH', hC', hle2⟩ := rmwPlainAccL (E := CE η) (s := stOf mem pairs th)
      (s' := ⟨mem', pairs, th'.vs, th'.promises, th.nalloc, th.undefs + countUndef [th'.regs 1]⟩)
      hP hfo.1 hH hC hsto hat hini hus hdw hvalR hm1b.2.2.2.2.1
      f1 f2 (loadUnits_cohMono _ _ _ _ hl1) hs2
      (hsame.1.trans (lockS_memP _ _).1) (hsame.2.2.2.1.trans (lockS_memP _ _).2) hcase'
    have hfr := bindR hb hi1 hRL (show VRR ρ η .unit (shp .unit) [] .zero from rfl) (unit_Lay _)
    refine ⟨Rr + .zero + Rs, H', .zero, .zero, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c₂, Rr + .zero, Rs, rfl, hE, hok,
      (bind_TvOK hb htv1 (by simp [tb]) (by simp [mg])).1, (by exact hfr), rfl, by rw [bind_ret hb, use_ret hu]; exact hRP⟩,
      MemInv_same (MemInv_lockS g.arch
        (MemInv_setRel (hst2 _ hm1b s2 hs2) (MemInv_lockR g.arch (stOf mem pairs th) hm1).2.2.2.2.1)) hsame, hH', hC'⟩, MintStepN.none, ?_⟩
    simp only [pSum, stOf, withS] at hle2 ⊢
    exact Res.le_def.2 fun k => by
      have h1 := hle k
      have h2 := hle2 k
      simp only [Res.add_apply, Res.zero_apply] at h1 h2 ⊢
      omega

/-- **(P4 step 3) `casCell` on a `pub` cell through a pointer, with resources**
(`tstepM_casCell` with memory's holding and the promise credits). -/
theorem tstepMC_casCell {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {acq rel : Bool} {w e v : At} {t : String} {ok fail : Expr}
    {u : Ty} {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .cas acq rel w e v t ok fail)
    (hpk : cx.peek w = .ok (.ptr .pub u)) (hnw : wordOf (Ty.ptr .pub u) = none)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hrmw : NoPlantRMW (CE η) th) (hRP : RetPw th.σs th.stack cx.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  have _ := hT
  have hCk0 := hCk
  rw [hterm] at hCk0
  cases TermA4.CkW_inv_cas hCk0 with
  | casCell hp _ hc hone haff hpe hu hsube hsubv _ hb hok hfail =>
    rw [hpk] at hp; cases hp
    rcases hc with hc | ⟨_, hc, -⟩
    · simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc
      subst hc
      have ho : cx.opaqueOK u = true := sub_opaqueOK hsubv
        (peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1)
      exact casCellC_core hterm hpk rfl hone haff hpe hu hsube hsubv hb hok.tk hfail.tk
        (plainCellPtr hpk hone ho hi.1 hE htv hm) hi hE htv hm hH hC hfo hrmw hRP
    · simp [cellOf] at hc
  | casShare hp hw | casTake hp hw | casEpoch hp hw =>
    exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw

/-- **(P4 step 3) `casCell` on a `pub` cell through a locative, with
resources** (`tstepM_casCellLoc` with memory's holding and the promise credits). -/
theorem tstepMC_casCellLoc {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {acq rel : Bool} {w e v : At} {t : String} {ok fail : Expr}
    {u : Ty} {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .cas acq rel w e v t ok fail)
    (hpk : cx.peek w = .ok (.loc .pub u)) (hnw : wordOf (Ty.loc .pub u) = none)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hrmw : NoPlantRMW (CE η) th) (hRP : RetPw th.σs th.stack cx.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  have _ := hT
  have hCk0 := hCk
  rw [hterm] at hCk0
  cases TermA4.CkW_inv_cas hCk0 with
  | casCell hp _ hc hone haff hpe hu hsube hsubv _ hb hok hfail =>
    rw [hpk] at hp; cases hp
    rcases hc with hc | ⟨_, hc, -⟩
    · simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc
      subst hc
      have ho : cx.opaqueOK u = true := sub_opaqueOK hsubv
        (peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1)
      refine casCellC_core hterm hpk rfl hone haff hpe hu hsube hsubv hb hok.tk hfail.tk
        (fun nw hval => ?_) hi hE htv hm hH hC hfo hrmw hRP
      obtain ⟨ad, pw, μr, ru, hea, haddr, -, -, -, hne, hld, hsto, hstw⟩ :=
        locCell (acq := acq) (rel := rel) (g := g) (mem := mem) (pairs := pairs) hpk (.inr rfl) ho
          (accs_cl_one hone) hi.1 hE htv hm
      exact ⟨ad, pw, _, hea, haddr, hne, fun s1 ws hl hp => ⟨(hld s1 ws hl hp).2.2,
        fun s1' hm1 s2 hs2 => hsto s1' [nw] hm1 hval rfl s2 hs2⟩⟩
    · simp [cellOf] at hc
  | casShare hp hw | casTake hp hw | casEpoch hp hw =>
    exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw


/-- (P4) The output of the fetch cell lemmas at a `pub` `Int` cell
(`pubIntCell`, `locCell`): the runtime reference, the load (of a number) and
the stores of any number. -/
def FetchIntCell (g : G) (mem : Memory) (pairs : List Ts) (th : TTh) (η : TEnv) (acq rel : Bool)
    (w : At) : Prop :=
  ∃ ad pw rt, evalAt th.env w = some (rt, [pw]) ∧ addrOf pw = some ad ∧ fetchRtTy rt = .int ∧
    loadUnits g.arch pw ad acq [.one] 0 (stOf mem pairs th) ≠ [] ∧
    ∀ s1 ws, (s1, ws) ∈ loadUnits g.arch pw ad acq [.one] 0 (stOf mem pairs th) → PromAbove s1 →
      MemInv g (CE η) s1 ∧ (∃ n, ws.map (·.val) = [.num n]) ∧
      ∀ s1', MemInv g (CE η) s1' → ∀ nw, (∃ m, nw.val = .num m) →
        ∀ s2, s2 ∈ storeUnits g.k g.arch pw ad rel [.one] [nw] 0 s1' → MemInv g (CE η) s2

theorem intValR {η : TEnv} {ρ : Nat → Nat} {w : Word} {m : Nat} (hw : w.val = .num m) :
    EnvValR (CE η) (cl ρ η.wit 0 0 .int) [w] .zero :=
  ⟨by simp [cl, VRR, shp, hw], (intVal (ρ := ρ) (η := η) hw).2⟩

/-- **(P4) `fetchCell`, with resources**: the operand is used (`useR`) and is a
number, so it carries nothing (its resources `Rv` are dropped); the new value
stored is a number too (`rmwPlainAcc` at `Rv = 0`), and the bound `Int`
carries nothing; nothing is minted. -/
theorem fetchCellC_core {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx c₁ c' : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {o : FetchOp} {acq rel : Bool} {a v : At}
    {e : Expr} {tw : Ty} {μ : Mode} {tv : Ty} {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.fetch o acq rel a v) e)
    (hpk : cx.peek a = .ok tw) (hcw : cellOf tw = some (μ, .int))
    (hu : cx.use v = .ok (tv, c₁)) (hsub : SubS c₁ tv .int) (hb : c₁.bind x .int = .ok c')
    (he : TypedK p η c' e) (htv' : TvOK c')
    (hFC : FetchIntCell g mem pairs th η acq rel a)
    (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (_hrmw : NoPlantRMW (CE η) th) (hRP : RetPw th.σs th.stack cx.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  have hRL := RLink_of hE.2.1 hE.2.2
  have htb : tb cx.ke.length .int = true := tb_cellOf (peek_tb htv hpk) hcw
  have hus : accs (cl ρ η.wit 0 0 .int) = some [.one] := by simp [cl, accs]
  obtain ⟨rv, wsv, Rv, Rr, hev, hvv, hlv, hvrv, hi1, hle⟩ := useR hu hi hE.2.2
  have hvi := VR_sub hi1.1.1 hsub _ _ hvv
  simp only [VR] at hvi
  obtain ⟨dd, hdd⟩ := hvi
  obtain ⟨nw, rfl, hnw⟩ := map_singleton hdd
  obtain ⟨ad, pw, rt, hea, haddr, hrt, hne, hcell⟩ := hFC
  obtain ⟨rt2, pw2, ad2, c, hea2, hpw2, hsto, hat, hini, hdw⟩ :=
    plainTarget hi.1 hE hpk hcw (by rfl) (by rfl) htb
  rw [hea] at hea2
  simp only [Option.some.injEq, Prod.mk.injEq, List.cons.injEq, and_true] at hea2
  obtain ⟨-, rfl⟩ := hea2
  obtain rfl : ad2 = ad := by simp only [addrOf, hpw2, Option.some.injEq] at haddr; exact haddr
  have hd : dataE 1 nw = .const nw.val := by simp [dataE, hnw]
  have key : tstep g mem pairs th =
      (Promises.stepRmw g.k g.arch mem pairs (mth (stOf mem pairs th) pw nw nw) 1 ad2 o.kind
          (dataE 1 nw) [0] acq rel).map fun (mem', th') =>
        (mem', pairs, withS { th with term := e, env := (x, fetchRtTy rt, [th'.regs 1]) :: th.env }
          ⟨mem', pairs, th'.vs, th'.promises, th.nalloc, th.undefs + countUndef [th'.regs 1]⟩) := by
    simp only [tstep, hterm, evalOp, hea, hev, haddr, List.map_map]; rfl
  rw [key] at ⊢
  refine ⟨fun h => stepRmw_ne_nil_any (loadUnits_one_msg hne) (List.map_eq_nil_iff.1 h), fun r hr hpr0 => ?_⟩
  have hpr := hpr0
  rw [List.mem_map] at hr
  obtain ⟨⟨mem', th'⟩, hin, rfl⟩ := hr
  obtain ⟨s1, rd, hl1, hrd, s2, hs2, hsame⟩ :=
    stepRmw_splitF (s := stOf mem pairs th) (FetchOp.kind_isFetch o) hd hin
  obtain ⟨tm, m, hmt, hml, hrv, hmc⟩ := stepRmw_mem hin
  have hp2 : PromAbove s2 :=
    PromAbove_lockS (s := setRel s2 (lockR g.arch (stOf mem pairs th) s1).vs) (PromAbove_same hsame (fun t ht m hm => hpr t ht m hm))
  have hp1' : PromAbove (bumpRel (lockR g.arch (stOf mem pairs th) s1) _) := storeUnits_promAbove hs2 hp2
  have hp1 : PromAbove s1 := fun t ht m hm => hp1' t ht m hm
  obtain ⟨hm1, ⟨n, hn⟩, hst⟩ := hcell s1 [rd] hl1 hp1
  simp only [List.map_cons, List.map_nil, List.cons.injEq, and_true] at hn
  obtain ⟨k, hk⟩ := FetchOp.apply_num o n dd
  rw [hnw] at hs2
  have hkv : (cst (o.kind.apply rd.val (.num dd))).val = .num k := by
    simp [cst, Promises.TVal.mk0, hn, hk]
  have hP : ∀ t, t ∈ (stOf mem pairs th).promises → t < (stOf mem pairs th).mem.size :=
    fun t ht => hm.2.2.1 t ht
  obtain ⟨f1, -, f2, -⟩ := loadUnits_frame [.one] 0 _ (s1, [rd]) hl1
  have hm1b := MemInv_bumpRel (MemInv_lockR g.arch (stOf mem pairs th) hm1) (max (Promises.pairTop (stOf mem pairs th).pairs rd.rts) rd.view)
  have hmnu : m.val ≠ .undef := by rw [← hrv, hrd, hn]; simp
  have hcase' : (∃ m0, mem' = mem.push m0 ∧ th'.promises = th.promises) ∨
      (∃ tw pm, tw ∈ th.promises ∧ mem' = mem ∧ th'.promises = th.promises.erase tw ∧
        mem[tw]? = some pm ∧ pm.loc = ad2 ∧
        ∃ tr mr, tr < tw ∧ mem[tr]? = some mr ∧ mr.loc = ad2 ∧ mr.val ≠ .undef) := by
    rcases hmc with ⟨hs, -⟩ | ⟨-, ⟨mv, h1, h2, -⟩ | ⟨tw, pm, h1, h2, h3, h4, h5, -, hadj⟩⟩
    · rw [FetchOp.succeeds] at hs; cases hs
    · exact Or.inl ⟨_, h1, h2⟩
    · exact Or.inr ⟨tw, pm, h1, h2, h3, h4, h5, tm, m, (rmwAdjacent_spec hadj).1, hmt, hml, hmnu⟩
  obtain ⟨H', hH', hC', hle2⟩ := rmwPlainAccL (E := CE η) (s := stOf mem pairs th)
    (s' := ⟨mem', pairs, th'.vs, th'.promises, th.nalloc, th.undefs + countUndef [th'.regs 1]⟩)
    hP hfo.1 hH hC hsto hat hini hus hdw (intValR (ρ := ρ) hkv) hm1b.2.2.2.2.1
    f1 f2 (loadUnits_cohMono _ _ _ _ hl1) hs2
    (hsame.1.trans (lockS_memP _ _).1) (hsame.2.2.2.1.trans (lockS_memP _ _).2) hcase'
  have hfr := bindR hb hi1 hRL (show VRR ρ η .int (shp .int) [rd] .zero by simp [VRR, hn]) (Lay_int rd rfl)
  have hmi := MemInv_same (MemInv_lockS g.arch
    (MemInv_setRel (hst _ hm1b _ ⟨k, hkv⟩ s2 hs2) (MemInv_lockR g.arch (stOf mem pairs th) hm1).2.2.2.2.1)) hsame
  subst hrd
  refine ⟨Rr + .zero + Rs, H', .zero, .zero, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Rr + .zero, Rs, rfl, hE, he, htv',
    (by rw [hrt]; exact hfr), rfl, by rw [bind_ret hb, use_ret hu]; exact hRP⟩, hmi, hH', hC'⟩, MintStepN.none, ?_⟩
  simp only [pSum, stOf, withS] at hle2 ⊢
  exact Res.le_def.2 fun k => by
    have h1 := hle k
    have h2 := hle2 k
    simp only [Res.add_apply, Res.zero_apply] at h1 h2 ⊢
    omega

/-- **(P4 step 3) `fetch` through an own or `pub` pointer, with resources**
(`tstepM_fetch` with memory's holding and the promise credits): `fetchCell` by
`fetchCellC_core`, `fetchEpoch`/`fetchShare` by `fetchWordC`. -/
theorem tstepMC_fetch {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {o : FetchOp} {acq rel : Bool} {a v : At}
    {e : Expr} {μ : Mode} {u : Ty} {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.fetch o acq rel a v) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.ptr μ u)) (hμ : μ = .own ∨ μ = .pub)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hrmw : NoPlantRMW (CE η) th)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  have hnd : th.promises.Nodup := MemInv_nodup hm
  have hT0 := hT
  have hCk0 := hCk
  rw [hterm] at hT0 hCk0
  cases hT0 with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk0
  have htv' := OpT_TvOK hP hop htv
  cases hop with
  | fetchCell hp _ hc hu hsub hb =>
    rw [hpk] at hp; cases hp
    rcases hc with hc | ⟨r, hc, -⟩
    · simp only [cellOf, Option.some.injEq, Prod.mk.injEq] at hc
      obtain ⟨rfl, rfl⟩ := hc
      obtain ⟨lab, pw, ru, hea, hpw, hnwr, hne, hcell⟩ :=
        pubIntCell (acq := acq) (rel := rel) (g := g) (mem := mem) (pairs := pairs) hpk hi.1 hE htv hm
      have hrt : fetchRtTy (.ptr .pub ru) = .int := by
        cases ru <;> simp [fetchRtTy, wordOf]
        exact (hnwr _ _ rfl).elim
      exact fetchCellC_core hterm hpk rfl hu hsub hb ⟨he, hck⟩ htv'
        ⟨⟨lab, 0⟩, pw, _, hea, by simp [addrOf, hpw], hrt, hne, hcell⟩ hi hE htv hm hH hC hfo hrmw hRP
    · simp only [cellOf, Option.some.injEq, Prod.mk.injEq] at hc
      obtain ⟨rfl, -⟩ := hc
      rcases hμ with h | h <;> cases h
  | fetchEpoch hp hw hep _ hj heq hb =>
    rw [hpk] at hp; cases hp
    cases u <;> simp [wordOf] at hw
    obtain ⟨rfl, rfl⟩ := hw
    rename_i r P
    have hpwf := wordRef_pwf hpk (.inl rfl) hμ hi.1 hE htv hm
    have hg : P.ghost = false := by
      have := pwf_epochOK hpwf hep
      unfold epochOK at this; simp only [Bool.and_eq_true, Bool.not_eq_true'] at this
      exact this.1.2
    obtain ⟨lab, pw, μ', r', hea, hpw, hne, hcell⟩ :=
      wordCellF (acq := acq) (rel := rel) (g := g) (mem := mem) (pairs := pairs) hpk hμ hg hi.1 hE htv hm
    exact fetchWordC hterm hpk rfl hg hpwf ⟨⟨lab, 0⟩, pw, _, r', hea, by simp [addrOf, hpw], rfl, hne, hcell⟩
      rfl hj (.inl ⟨hep, heq, hb⟩) ⟨he, hck⟩ htv' hi hE hm hH hC hrmw hnd hRP
  | fetchShare hp hw hep hj heq hok hb =>
    rw [hpk] at hp; cases hp
    cases u <;> simp [wordOf] at hw
    obtain ⟨rfl, rfl⟩ := hw
    rename_i r P
    have hpwf := wordRef_pwf hpk (.inl rfl) hμ hi.1 hE htv hm
    have hg : P.ghost = false := by
      have hok' := hok
      unfold fetchOK at hok'; simp only [Bool.and_eq_true, Bool.not_eq_true'] at hok'
      exact hok'.1.1.1.1
    obtain ⟨lab, pw, μ', r', hea, hpw, hne, hcell⟩ :=
      wordCellF (acq := acq) (rel := rel) (g := g) (mem := mem) (pairs := pairs) hpk hμ hg hi.1 hE htv hm
    exact fetchWordC hterm hpk rfl hg hpwf ⟨⟨lab, 0⟩, pw, _, r', hea, by simp [addrOf, hpw], rfl, hne, hcell⟩
      rfl hj (.inr ⟨_, hep, heq, hok, hb⟩) ⟨he, hck⟩ htv' hi hE hm hH hC hrmw hnd hRP

/-- **(P4 step 3) `fetch` through an own or `pub` locative, with resources**
(`tstepM_fetchLoc` with memory's holding and the promise credits): as
`tstepMC_fetch`, with the cells from `locCell`. -/
theorem tstepMC_fetchLoc {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {o : FetchOp} {acq rel : Bool} {a v : At}
    {e : Expr} {μ : Mode} {u : Ty} {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.fetch o acq rel a v) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.loc μ u)) (hμ : μ = .own ∨ μ = .pub)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hrmw : NoPlantRMW (CE η) th)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  have hnd : th.promises.Nodup := MemInv_nodup hm
  have hT0 := hT
  have hCk0 := hCk
  rw [hterm] at hT0 hCk0
  cases hT0 with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk0
  have htv' := OpT_TvOK hP hop htv
  cases hop with
  | fetchCell hp _ hc hu hsub hb =>
    rw [hpk] at hp; cases hp
    rcases hc with hc | ⟨r, hc, -⟩
    · simp only [cellOf, Option.some.injEq, Prod.mk.injEq] at hc
      obtain ⟨rfl, rfl⟩ := hc
      have hus1 : accs (cl ρ η.wit 0 0 .int) = some [.one] := by simp [cl, accs]
      obtain ⟨ad, pw, μr, ru, hea, haddr, -, hsku, -, hne, hld, hsto, hstw⟩ :=
        locCell (acq := acq) (rel := rel) (g := g) (mem := mem) (pairs := pairs) hpk hμ
          (by simp [Cx.opaqueOK, Ty.guardT]) hus1 hi.1 hE htv hm
      have hrt : fetchRtTy (.loc μr ru) = .int := by
        cases ru <;> simp [fetchRtTy, wordOf]
        simp [skel, etok, close, substTs] at hsku
      refine fetchCellC_core hterm hpk rfl hu hsub hb ⟨he, hck⟩ htv'
        ⟨ad, pw, _, hea, haddr, hrt, hne, fun s1 ws hl hp => ?_⟩ hi hE htv hm hH hC hfo hrmw hRP
      obtain ⟨hvr, -, hm1⟩ := hld s1 ws hl hp
      exact ⟨hm1, by simpa [VR] using hvr, fun s1' hm1' w ⟨m, hw⟩ s2 hs2 =>
        hsto s1' [w] hm1' (intVal (ρ := ρ) hw) rfl s2 hs2⟩
    · simp only [cellOf, Option.some.injEq, Prod.mk.injEq] at hc
      obtain ⟨rfl, -⟩ := hc
      rcases hμ with h | h <;> cases h
  | fetchEpoch hp hw hep _ hj heq hb =>
    rw [hpk] at hp; cases hp
    cases u <;> simp [wordOf] at hw
    obtain ⟨rfl, rfl⟩ := hw
    rename_i r P
    have hpwf := wordRef_pwf hpk (.inr rfl) hμ hi.1 hE htv hm
    have hg : P.ghost = false := by
      have := pwf_epochOK hpwf hep
      unfold epochOK at this; simp only [Bool.and_eq_true, Bool.not_eq_true'] at this
      exact this.1.2
    have hus1 : accs (cl ρ η.wit 0 0 (.word r P)) = some [.one] := by simp [cl, accs, hg]
    obtain ⟨ad, pw, μr, ru, hea, haddr, -, hsku, -, hne, hld, hsto, hstw⟩ :=
      locCell (acq := acq) (rel := rel) (g := g) (mem := mem) (pairs := pairs) hpk hμ
        (by simp [Cx.opaqueOK, Ty.guardT]) hus1 hi.1 hE htv hm
    obtain ⟨r', rfl⟩ := eskel_word (show etok (skel ru) = .word (.lit 0) P by rw [hsku]; rfl)
    exact fetchWordC hterm hpk rfl hg hpwf ⟨ad, pw, _, r', hea, haddr, rfl, hne,
        fun s1 ws hl hp => ⟨(hld s1 ws hl hp).2.2, (hld s1 ws hl hp).1,
          fun s1' hm1' w hw s2 hs2 => hsto s1' [w] hm1' hw rfl s2 hs2⟩⟩
      rfl hj (.inl ⟨hep, heq, hb⟩) ⟨he, hck⟩ htv' hi hE hm hH hC hrmw hnd hRP
  | fetchShare hp hw hep hj heq hok hb =>
    rw [hpk] at hp; cases hp
    cases u <;> simp [wordOf] at hw
    obtain ⟨rfl, rfl⟩ := hw
    rename_i r P
    have hpwf := wordRef_pwf hpk (.inr rfl) hμ hi.1 hE htv hm
    have hg : P.ghost = false := by
      have hok' := hok
      unfold fetchOK at hok'; simp only [Bool.and_eq_true, Bool.not_eq_true'] at hok'
      exact hok'.1.1.1.1
    have hus1 : accs (cl ρ η.wit 0 0 (.word r P)) = some [.one] := by simp [cl, accs, hg]
    obtain ⟨ad, pw, μr, ru, hea, haddr, -, hsku, -, hne, hld, hsto, hstw⟩ :=
      locCell (acq := acq) (rel := rel) (g := g) (mem := mem) (pairs := pairs) hpk hμ
        (by simp [Cx.opaqueOK, Ty.guardT]) hus1 hi.1 hE htv hm
    obtain ⟨r', rfl⟩ := eskel_word (show etok (skel ru) = .word (.lit 0) P by rw [hsku]; rfl)
    exact fetchWordC hterm hpk rfl hg hpwf ⟨ad, pw, _, r', hea, haddr, rfl, hne,
        fun s1 ws hl hp => ⟨(hld s1 ws hl hp).2.2, (hld s1 ws hl hp).1,
          fun s1' hm1' w hw s2 hs2 => hsto s1' [w] hm1' hw rfl s2 hs2⟩⟩
      rfl hj (.inr ⟨_, hep, heq, hok, hb⟩) ⟨he, hck⟩ htv' hi hE hm hH hC hrmw hnd hRP

/-- **(P4) `mkWord2`, with credits**: the token's region key moves into the new
pair value, which holds it (`Word2Holds`, from the rule's holding clause);
memory is unchanged. -/
theorem tstepMC_mkWord2 {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x rn : String} {P : Proto2} {v0 v1 tk : At} {e : Expr}
    {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.mkWord2 rn P v0 v1 tk) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | mkWord2 hidx hpwf hu heq hv0 hv1 hst hcl hho hb =>
  rename_i c₁ r r' j0 j1 k0 k1 c cl
  obtain ⟨rt0, ws0, R0, Rr, -, -, -, hR0, hi1, hle⟩ := useR hu hi hE.2.2
  have hR : R0 = .one (.rg (ev ρ r)) + .one (.wd (ev ρ r)) := by
    simp only [VRR, tokWd_none] at hR0; rw [hR0, heq ρ hi1.1.1]
  obtain ⟨tv0, htvk0, hio0⟩ := hv0
  obtain ⟨tv1, htvk1, hio1⟩ := hv1
  obtain ⟨rt0, w0, hea0, hwv0, -⟩ := atom_num hi1.1.2.1 htvk0 hio0
  obtain ⟨rt1, w1, hea1, hwv1, -⟩ := atom_num hi1.1.2.1 htvk1 hio1
  have key : tstep g mem pairs th =
      [((stOf mem pairs th).mem, (stOf mem pairs th).pairs,
        withS { th with term := e, env := (x, .word2 (.lit 0) P, [w0, w1]) :: th.env } (stOf mem pairs th))] := by
