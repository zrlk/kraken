      (∃ tw pm, tw ∈ s.promises ∧ s'.mem = s.mem ∧ s'.promises = s.promises.erase tw ∧
        s.mem[tw]? = some pm ∧ pm.loc = a ∧
        ∃ tr mr, tr < tw ∧ s.mem[tr]? = some mr ∧ mr.loc = a ∧ mr.val ≠ .undef)) :
