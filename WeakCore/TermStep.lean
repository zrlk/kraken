theorem CkW_newBufCell {p : Prog} {ω : Nat → Ty} {cx : Cx} {x : String} {n : At} {τ : Ty} {e : Expr}
    {ρ : Nat → Nat} {K : Nat}
    (h : TermA4.CkW p ω cx (.let_ x (.newBuf n τ) e)) (hWc : ∀ k, tb 0 (ω k) = true)
    (hwf : τ.wf cx.ke.length cx.inames.length = true) (hg : cx.opaqueOK τ = true) :
    TermA4.wrapTop (cl ρ ω 0 0 (.array (.lit K) τ)) = true := by
  obtain ⟨-, -, -, -, -, ha⟩ := TermA4.CkW_let h
  refine TermA4.wrapTop_cl0 (O := cx.opq) hWc h.2.2 ?_ (fun j hj => ?_) ?_
  · simp [tb, tb_of_wf τ hwf]
  · simp only [Cx.opaqueOK, List.all_eq_true] at hg; simpa [Ty.guardT] using hg j hj
  · simpa [TermScope.opArgOK, TermScope.opTys, TermScope.wrapOK, TermScope.wrapOKE] using ha

