  have hRk := OpT_retSk hop
  cases hop with
  | loadOwn hp hnw _ _ _ | loadPub hp hnw _ _ _ _ | loadRgn hp hnw _ _ _ _ | loadCap hp hnw _ _ _ _ _
  | loadTorn hp hnw _ _ _ _ => exfalso; rw [hpk] at hp; cases hp; simp [wordOf] at hnw
  | loadWord hp hw hg hb =>
  rw [hpk] at hp; cases hp
  simp only [wordOf, Option.some.injEq] at hw; subst hw
  have hg' : P.ghost = false := hg
  have hus1 : accs (cl ρ η.wit 0 0 (.word r P)) = some [.one] := by simp [cl, accs, hg']
  obtain ⟨ad, pw, μr, ru, hea, haddr, hus, hsku, -, hne, hld, -, hstw⟩ :=
    locCell (acq := acq) (rel := false) (g := g) (mem := mem) (pairs := pairs)
      hpk hμ (by simp [Cx.opaqueOK, Ty.guardT]) hus1 hi0 hE htv hm
  obtain ⟨r', rfl⟩ := eskel_word (show etok (skel ru) = .word (.lit 0) P by rw [hsku]; rfl)
  have key : tstep g mem pairs th =
      (loadUnits g.arch pw ad acq [.one] 0 (stOf mem pairs th)).map fun (s', ws) =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, .int, ws) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, cellOf, haddr, wordOf, Option.isSome_some,
      ↓reduceIte, hus, List.map_map]; rfl
  rw [key] at ⊢
  refine ⟨fun h => hne (List.map_eq_nil_iff.1 h), fun r0 hr hpr0 => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨⟨s', wsr⟩, hl, rfl⟩ := hr
  obtain ⟨hvr, -, hm'⟩ := hld s' wsr hl (hpr0)
  obtain ⟨f1, -, f3, -⟩ := loadUnits_frame [.one] 0 _ (s', wsr) hl
  obtain ⟨w, n, rfl, hvr'⟩ := word_bind hg' hvr
  have hfr := bindR0 hb (pushR x n hi) hvr' (Lay_int w rfl) trivial
  refine mc_keep (C := .zero) (F := .zero) ⟨vcons n ρ, η, c', Rf, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩
    hm' f1 f3 hH hC .none ?_
  first | exact Res.le_refl _ | (rw [Res.add_zero, Res.add_zero]; exact Res.le_refl _)

/-- **(P4) `mkTicket`, with credits**: the region key moves into the epoch
counter's word (`mkTicket_presR`); memory is unchanged. -/
theorem tstepMC_mkTicket {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x rn : String} {N P : Proto} {v tk : At} {e : Expr}
    {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.mkTicket rn N P v tk) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  obtain ⟨hne, hall⟩ := tstep_mkTicketR (g := g) (mem := mem) (pairs := pairs) hterm hP hT hCk hi hE htv hRP hPS
  refine ⟨hne, fun r0 hr => ?_⟩
  have hR := hall r0 hr
  have key : tstep g mem pairs th = (evalOp g th.env th.σs (stOf mem pairs th) (.mkTicket rn N P v tk)).map
      fun (s', t, ws) => (s'.mem, s'.pairs, withS { th with term := e, env := (x, t, ws) :: th.env } s') := by
    simp [tstep, hterm]
  rw [key, List.mem_map] at hr
  obtain ⟨⟨s', t, ws⟩, hev, rfl⟩ := hr
  have hs' : s' = stOf mem pairs th := by
    simp only [evalOp] at hev
    revert hev
    cases evalAt th.env v <;> simp [ol]
    intro h _ _; exact h
  subst hs'
  refine mc_keep (C := .zero) (F := .zero) hR (by rw [stOf_withS]; exact hm) (by rw [stOf_withS])
    (by rw [stOf_withS]) hH hC .none ?_
  first | exact Res.le_refl _ | (rw [Res.add_zero, Res.add_zero]; exact Res.le_refl _)

/-- **(P4) `claim`, with credits**: memory unchanged; the frame trades the
epoch key for the region key, recorded as `MintStep.claim`. -/
theorem tstepMC_claim {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {w tk : At} {e : Expr}
    {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.claim w tk) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStep g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧ ClaimAt th.term C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  obtain ⟨hne, hall⟩ := tstep_claimR (g := g) (mem := mem) (pairs := pairs) hterm hP hT hCk hi hE htv hRP hPS
  refine ⟨hne, fun r0 hr => ?_⟩
  obtain ⟨n, j, Tot', hR, hle⟩ := hall r0 hr
  rw [tstep_capOp hterm trivial, List.mem_map] at hr
  obtain ⟨⟨s', t, ws⟩, hev, rfl⟩ := hr
  have hs' : s' = stOf mem pairs th := by
    simp only [evalOp, List.mem_singleton, Prod.mk.injEq] at hev; exact hev.1
  subst hs'
  exact mc_keepM hR (by rw [stOf_withS]; exact hm) (by rw [stOf_withS]) (by rw [stOf_withS]) hH hC
    (.claim n j) (fun _ _ _ _ => ⟨x, w, tk, e, hterm⟩) hle

/-! ### (P4 step 3, W1) Word stores with resources and promise credits -/

/-- (P4) A word's resources depend on its value only. -/
theorem VRR_word_vals {ρ : Nat → Nat} {E : TEnv} {r : Idx} {P : Proto} {sh sh' : Shp} {ws ws' : List Word}
    {R : Res} (h : VRR ρ E (.word r P) sh ws R) (hv : ws'.map (·.val) = ws.map (·.val)) :
    VRR ρ E (.word r P) sh' ws' R := by
  simp only [VRR] at h ⊢; rw [hv]; exact h

theorem Fd_word_eq {T : Ty} {n : Nat} {P : Proto} (h : Fd T (.word (.lit n) P)) : T = .word (.lit n) P := by
  generalize hU : Ty.word (.lit n) P = U at h
  cases h with
  | refl => rfl
  | fold => simp [cl] at hU

theorem offs_zero (A : Address) : offs A 0 = A := by simp [offs]

/-- (W1) A word value carries at least its word key. -/
theorem wdW_le_VRR_word {ρ : Nat → Nat} {η : TEnv} {n : Nat} {P : Proto} {S : Shp} {ws : List Word} {R : Res}
    (h : VRR ρ η (.word (.lit n) P) S ws R) : wdW P n ≤ R := by
  simp only [VRR] at h
  rcases h.2 with ⟨-, rfl⟩ | ⟨-, rfl⟩
  · exact fun k => by simp only [Res.add_apply, ev]; omega
  · exact Res.le_refl _

/-- (W1) A pair value carries its word key. -/
theorem wd_le_VRR_word2 {ρ : Nat → Nat} {η : TEnv} {n : Nat} {P : Proto2} {S : Shp} {ws : List Word} {R : Res}
    (h : VRR ρ η (.word2 (.lit n) P) S ws R) : Res.one (.wd n) ≤ R := by
  simp only [VRR] at h
  rcases h.2 with ⟨-, rfl⟩ | ⟨-, rfl⟩
  · exact fun k => by simp only [Res.add_apply, ev]; omega
  · exact Res.le_refl _

/-- (P4) The resources `WRes` gives a word value at a non-ghost protocol word,
are those `VRR` gives it. -/
theorem WRes_of_VRR {E : TEnv} {A : Address} {c : Cell} {n : Nat} {P : Proto} {ρ : Nat → Nat} {E' : TEnv}
    {sh : Shp} {w : Word} {Rv : Res} (hsto : E.sto A.label = some c) (hat : AtOff c.ty A.offset (.word (.lit n) P))
    (hg : P.ghost = false) (hv : VRR ρ E' (.word (.lit n) P) sh [w] Rv) :
    ∀ w' R, w'.val = w.val → WRes E A w' R → R + wdW P n = Rv := by
  intro w' R hw' hR
  have hu : ∀ n' P', WordAt E A n' P' → n' = n ∧ P' = P := by
    rintro n' P' ⟨c', hc', hat', hg'⟩
    rw [hsto] at hc'; cases hc'
    obtain ⟨h1, h2⟩ := AtOff_word_uniq hg' hg hat' hat
    cases h1; exact ⟨rfl, h2⟩
  have hW : WordAt E A n P := ⟨c, hsto, hat, hg⟩
  simp only [VRR, List.map_cons, List.map_nil] at hv
  obtain ⟨-, hv⟩ := hv
  unfold WRes at hR; rw [hw'] at hR
  rcases hR with ⟨n', P', hW', hh, rfl⟩ | ⟨hn, rfl⟩
  · obtain ⟨rfl, rfl⟩ := hu n' P' hW'
    rcases hv with ⟨-, rfl⟩ | ⟨hn, -⟩
    · simp [ev]
    · exact absurd hh hn
  · rcases hv with ⟨hh, -⟩ | ⟨-, rfl⟩
    · exact absurd hh (hn n P hW)
    · simp [ev]

/-- **(P4) A one-word store at a non-ghost protocol word, memory's side**
(own or published cell, the word anywhere in it): appending makes the stored
word the latest at the word unit, so the cell's entry trades the word's old
resources for the stored word's `Rv` (the old ones are dropped); fulfilling
an own promise `tw` leaves every reading (and `H`) unchanged and erases `tw`,
whose debit is `Rv` (`WRes` of the stored value) and whose credit is lost. -/
theorem wordStoreHeld {g : G} {η : TEnv} {s s' : St} {H : Res} {cr db : Ts → Res}
    {A : Address} {c : Cell} {n : Nat} {P : Proto} {w : Word} {Rv : Res}
    {k : Promises.Knobs} {arch : Arch} {pw : Word} {rel : Bool}
    (hm : MemInv g (CE η) s) (hH : MemHeld (CE η) s H) (hC : PromCr (CE η) s cr db)
    (hsto : η.sto A.label = some c) (hat : AtOff c.ty A.offset (.word (.lit n) P)) (hg : P.ghost = false)
    (hini : IniAt η.ini c A (.word (.lit n) P))
    (hv : VRR (fun _ => 0) (CE (CE η).unsee) (.word (.lit n) P) (shp (.word (.lit n) P)) [w] (Rv + wdW P n))
    (hs : s' ∈ storeUnits k arch pw A rel [.one] [w] 0 s) (hnI : NoInitF (CE η) s A) :
    ∃ H', MemHeld (CE η) s' H' ∧ PromCr (CE η) s' cr db ∧
      H' + pSum s' cr + pSum s db ≤ Rv + H + pSum s cr + pSum s' db := by
  have hWU0 : WordUnit (CE η) A := ⟨c, hsto, Or.inl ⟨_, P, hg, hat⟩⟩
  have hWR := WRes_of_VRR (E := CE η) hsto hat hg hv
  have hkeep : ∀ B x, B ≠ A → LatestNP s.mem (PromAt (CE η) s B) B x →
      LatestNP s'.mem (PromAt (CE η) s' B) B x :=
    fun B x hB hx => storeUnits_NPkeep [.one] [w] 0 s s' hs B x (fun j hj => by
      have : j = 0 := by simp [nWords, Acc.size] at hj; omega
      subst this; simpa [offs_zero] using hB) hx
  have hPb : ∀ t, t ∈ s.promises → t < s.mem.size := fun t ht => hm.2.2.1 t ht
  simp only [storeUnits, List.mem_flatMap, List.mem_singleton] at hs
  obtain ⟨⟨mem', th'⟩, hst, rfl⟩ := hs
  rw [offs_zero] at hst
  have hval : exprVal (mth s pw w w) (dataE 1 w) = w.val := exprVal_dataE _ 1 w (by simp [mth, regsOf])
  -- the cell's entry, with a new latest word of the stored value at `A`
  have hrep : ∀ x' : Word, x'.val = w.val →
      LatestNP mem' (PromAt (CE η) { s with mem := mem', vs := th'.vs, promises := th'.promises } A) A x' →
      ∃ H', MemHeld (CE η) { s with mem := mem', vs := th'.vs, promises := th'.promises } H' ∧ H' ≤ Rv + H := by
    intro x' hmw hnew
    obtain ⟨R0, H0, rfl, hent0, hX⟩ := MemHeld_focus hH A.label
    obtain ⟨vals0, hL0, hC0⟩ := hent0.2 c hsto
    have hna : ∀ N e, Ty.word (.lit n) P ≠ .array (.lit N) e := fun N e h => by cases h
    have hwU : wc (Ty.word (.lit n) P) = some 1 := by simp [wc, accs, hg, nWords, Acc.size]
    obtain ⟨b, oS, S, wS, Rsg, Rrc, -, hbo, hatS, hwS, hbw, hR0, ⟨hvs, hVs⟩, hput⟩ := (own_segR hC0 hat hini hna).resolve_right (fun ⟨_, _, _, _, _, _, _, hz⟩ => by have h := hz _ (by simp [accs, hg] : accs (Ty.word (.lit n) P) = some [.one]); simp [nWords, Acc.size] at h)
    have hsl : ((vals0.drop b).take wS).length = wS := by
      simp only [List.length_take, List.length_drop]; omega
    obtain ⟨n1, Rq, Rr2, hwn, hle2, hRs, hRq0, hput2⟩ := VRR_at (CE η).unsee hatS hvs (by rw [hsl]; exact hwS)
    rw [hwU] at hwn
    obtain rfl : 1 = n1 := Option.some.inj hwn
    rw [hsl] at hle2
    have hlenv : A.offset + 1 ≤ vals0.length := by
      rw [← hbo, Nat.add_assoc]; exact Nat.le_trans (Nat.add_le_add_left hle2 b) hbw
    have hq : VRR (fun _ => 0) (CE (CE η).unsee) (.word (.lit n) P) (shp (.word (.lit n) P)) [x'] (Rv + wdW P n) :=
      VRR_word_vals hv (by simp [hmw])
    have hQ := hput2 [x'] (Rv + wdW P n) hq rfl
    have hQV := (VR_put (CE η).unsee hatS (VRR_VR S (RLink_of (Coh_CE _) (CohR_CE _)) hvs) hVs
      (by rw [hsl]; exact hwS) (VRR_VR _ (RLink_of (Coh_CE _) (CohR_CE _)) hq) trivial (by rw [hwU]; rfl)).2.2
    simp only [List.length_singleton] at hQV
    have hQl : (((vals0.drop b).take wS).take oS ++ [x'] ++ ((vals0.drop b).take wS).drop (oS + 1)).length = wS := by
      simp only [List.length_append, List.length_take, List.length_drop, List.length_singleton]; omega
    have hcell' := hput _ _ ⟨hQ, hQV⟩ hQl
    have hsp := splice_seg vals0 [x'] b wS oS (by simpa using hle2)
    simp only [List.length_singleton] at hsp
    rw [hsp, hbo] at hcell'
    have hlat' : ∀ o x, (vals0.take A.offset ++ [x'] ++ vals0.drop (A.offset + 1))[o]? = some x →
        LatestNP mem' (PromAt (CE η) { s with mem := mem', vs := th'.vs, promises := th'.promises } ⟨A.label, o⟩)
          ⟨A.label, o⟩ x := by
      intro o x hov
      rw [splice_get vals0 [x'] A.offset 1 o rfl hlenv] at hov
      by_cases hr : A.offset ≤ o ∧ o < A.offset + 1
      · rw [iteT hr] at hov
        obtain rfl : o = A.offset := Nat.le_antisymm (Nat.lt_succ_iff.1 hr.2) hr.1
        simp only [Nat.sub_self, List.getElem?_cons_zero, Option.some.injEq] at hov
        subst hov
        exact hnew
      · rw [iteF hr] at hov
        refine hkeep _ x (fun e => hr ?_) (hL0 o x hov)
        have h2 : o = A.offset := congrArg (·.offset) e
        exact ⟨Nat.le_of_eq h2.symm, by rw [h2]; exact Nat.lt_succ_self _⟩
    have hent : HeldEntry (CE η) { s with mem := mem', vs := th'.vs, promises := th'.promises } A.label
        (Rv + wdW P n + Rr2 + Rrc) := by
      refine ⟨fun h => (by rw [show (CE η).sto A.label = η.sto A.label from rfl, hsto] at h; cases h),
        fun c2 hc2 => ?_⟩
      rw [show (CE η).sto A.label = η.sto A.label from rfl, hsto] at hc2; cases hc2
      exact ⟨_, hlat', hcell'⟩
    have hX' := MemHeldX_tr (E' := CE η) (s' := { s with mem := mem', vs := th'.vs, promises := th'.promises })
      hX (fun _ _ => rfl) (fun _ _ => rfl)
      (fun l' hne o x hl => hkeep _ x (fun e => hne (congrArg (·.label) e)) hl) id
    subst hR0; subst hRs
    have hw0 := wdW_le_VRR_word hRq0
    refine ⟨Rv + wdW P n + Rr2 + Rrc + H0, MemHeld_unfocus hX' hent, Res.le_def.2 fun k => ?_⟩
    have := hw0 k
    simp only [Res.add_apply] at this ⊢
    omega
  rcases stepStore_casesE hst with ⟨hmem, hpr⟩ | ⟨t, m, hmem, htp, hpr, hmt, hloc, hmv, -⟩
  · -- append: the stored word is the latest at the word unit
    have hp1 : th'.promises = s.promises := hpr
    obtain ⟨m0, hm0e⟩ : ∃ m0 : Msg, m0 = ⟨A, exprVal (mth s pw w w) (dataE 1 w),
        Promises.storeMview (mth s pw w w) (dataE 1 w) [0] rel⟩ := ⟨_, rfl⟩
    rw [← hm0e] at hmem
    have hloc0 : m0.loc = A := by rw [hm0e]
    have hmw : (mw m0).val = w.val := by rw [hm0e]; exact hval
    have hnew : LatestNP mem' (PromAt (CE η) { s with mem := mem', vs := th'.vs, promises := th'.promises } A) A (mw m0) := by
      by_cases hV : Vis (CE η) A.label
      · rw [PromAt_word ⟨hWU0, hV⟩, hmem]
        have := LatestNP_push_top (P := []) (M := s.mem) m0 (fun t ht => by cases ht)
        rwa [hloc0] at this
      · rw [PromAt_nwordP (fun h => hV h.2) (fun h => hV (PredU_vis h)) (FpAt_priv hV), hmem]
        have := LatestNP_push_top (P := th'.promises) (M := s.mem) m0 (fun t ht => hPb t (by rw [← hp1]; exact ht))
        rwa [hloc0] at this
    obtain ⟨H', hH', hle⟩ := hrep (mw m0) hmw hnew
    have hC' : PromCr (CE η) { s with mem := mem', vs := th'.vs, promises := th'.promises } cr db :=
      PromCr_keep hC hp1 hPb (fun t ht => by show mem'[t]? = _; rw [hmem]; exact push_lt ht) (fun _ _ _ _ => rfl)
    have e1 : ∀ f, pSum { s with mem := mem', vs := th'.vs, promises := th'.promises } f = pSum s f := fun f => by
      unfold pSum; rw [show ({ s with mem := mem', vs := th'.vs, promises := th'.promises } : St).promises = s.promises from hp1]
    refine ⟨H', hH', hC', Res.le_def.2 fun k => ?_⟩
    rw [e1, e1]
    have := Res.le_def.1 hle k
    simp only [Res.add_apply] at this ⊢
    omega
  · -- fulfil: the promise erased
    have hp1 : th'.promises = s.promises.erase t := hpr
    have hC' : PromCr (CE η) { s with mem := mem', vs := th'.vs, promises := th'.promises } cr db :=
      PromCr_erase hC hp1 hPb (fun t _ => by show mem'[t]? = _; rw [hmem]) (fun _ _ _ _ => rfl)
    have e1 := pSum_erase (f := cr) (s' := { s with mem := mem', vs := th'.vs, promises := th'.promises }) hp1 htp
    have e2 := pSum_erase (f := db) (s' := { s with mem := mem', vs := th'.vs, promises := th'.promises }) hp1 htp
    have hkeepA : (∀ x, LatestNP s.mem (PromAt (CE η) s A) A x →
          LatestNP mem' (PromAt (CE η) { s with mem := mem', vs := th'.vs, promises := th'.promises } A) A x) →
        MemHeld (CE η) { s with mem := mem', vs := th'.vs, promises := th'.promises } H := by
      intro hA
      refine MemHeld_tr hH (fun _ => rfl) (fun _ => rfl) (fun l o x hx => ?_) id
      by_cases hB : (⟨l, o⟩ : Address) = A
      · rw [hB] at hx ⊢; exact hA x hx
      · exact hkeep _ x hB hx
    by_cases hV : Vis (CE η) A.label
    · -- visible: readings unchanged; the debit is the stored value's
      have hH' : MemHeld (CE η) { s with mem := mem', vs := th'.vs, promises := th'.promises } H := by
        refine MemHeld_tr hH (fun _ => rfl) (fun _ => rfl) (fun l o x hx => ?_) id
        by_cases hB : (⟨l, o⟩ : Address) = A
        · rw [hB] at hx ⊢
          rw [PromAt_word ⟨hWU0, hV⟩] at hx ⊢
          show LatestNP mem' [] A x
          rw [hmem]; exact hx
        · exact hkeep _ x hB hx
      have hdb : db t = Rv := by
        obtain ⟨m', hm', hd, -⟩ := hC t htp
        rw [hmt] at hm'; cases hm'
        have hd := (DbRes_nInit (by rw [hloc]; exact hnI t m htp hmt hloc (Or.inl ⟨n, P, c, hsto, hat, hg⟩))).1 hd
        rw [hloc] at hd
        exact Res.add_right_cancel (hWR (mw m) (db t) (by simp [mw, hmv, hval])
          ((VRes_vis hV (IniW_word (E := CE η) hsto hat hg hini)).1 hd))
      refine ⟨H, hH', hC', Res.le_def.2 fun k => ?_⟩
      rw [e1, e2, hdb]
      simp only [Res.add_apply]
      omega
    · -- own cell: no debit; the reading stays or moves to the stored word
      have hown : Priv (CE η) A.label := Classical.byContradiction hV
      have hdb : db t = .zero := by
        obtain ⟨m', hm', hd, -⟩ := hC t htp
        rw [hmt] at hm'; cases hm'
        exact DbRes_ownz (by rw [hloc]; exact hown) hd
      have hpre : PromAt (CE η) s A = s.promises := PromAt_own hown
      have hpost : PromAt (CE η) { s with mem := mem', vs := th'.vs, promises := th'.promises } A =
          s.promises.erase t := by rw [PromAt_own hown]; exact hp1
      have hmem' : mem' = s.mem := hmem
      by_cases hup : LatestNP s.mem (s.promises.erase t) A (mw m)
      · obtain ⟨H', hH', hle⟩ := hrep (mw m) (by simp [mw, hmv, hval]) (by rw [hpost, hmem']; exact hup)
        refine ⟨H', hH', hC', Res.le_def.2 fun k => ?_⟩
        rw [e1, e2, hdb]
        have := Res.le_def.1 hle k
        simp only [Res.add_apply, Res.zero_apply] at this ⊢
        omega
      · have hH' := hkeepA fun x hx => by
          rw [hpre] at hx; rw [hpost, hmem']
          rcases LatestNP_erase_same hx hmt hloc with h | h
          · exact h
          · exact absurd h hup
        refine ⟨H, hH', hC', Res.le_def.2 fun k => ?_⟩
        rw [e1, e2, hdb]
        simp only [Res.add_apply, Res.zero_apply]
        omega

theorem seg_arr_width {T S e : Ty} {b N : Nat} {us : List TermRun.Acc} {wS : Nat} (hs : SegOf T b S)
    (hT : T = .array (.lit N) e) (hu : accs e = some us) (hw : wc S = some wS) : wS = nWords us := by
  rcases hs with ⟨-, -, h3⟩ | ⟨N', us', j, hT', -, -, -⟩
  · rw [hT] at h3; simp [accs] at h3
  · rw [hT] at hT'; injection hT' with _ h2; subst h2; simp [wc, hu] at hw; exact hw.symm
#print axioms seg_arr_width

/-- `wordStoreHeld` with slot lists: the export keeps every untouched slot. -/
theorem wordStoreHeldL {g : G} {η : TEnv} {s s' : St} {H : Res} {Sl : AllocLabel → List Res} {cr db : Ts → Res}
    {A : Address} {c : Cell} {n : Nat} {P : Proto} {w : Word} {Rv : Res}
    {k : Promises.Knobs} {arch : Arch} {pw : Word} {rel : Bool}
    (hm : MemInv g (CE η) s) (hH : MemHeldL (CE η) s H Sl) (hC : PromCr (CE η) s cr db)
    (hsto : η.sto A.label = some c) (hat : AtOff c.ty A.offset (.word (.lit n) P)) (hg : P.ghost = false)
    (hini : IniAt η.ini c A (.word (.lit n) P))
    (hv : VRR (fun _ => 0) (CE (CE η).unsee) (.word (.lit n) P) (shp (.word (.lit n) P)) [w] (Rv + wdW P n))
    (hs : s' ∈ storeUnits k arch pw A rel [.one] [w] 0 s) (hnI : NoInitF (CE η) s A) :
    ∃ H', MemHeldK (CE η) s Sl (CE η) s' H' ∧ PromCr (CE η) s' cr db ∧
      H' + pSum s' cr + pSum s db ≤ Rv + H + pSum s cr + pSum s' db := by
  have hWU0 : WordUnit (CE η) A := ⟨c, hsto, Or.inl ⟨_, P, hg, hat⟩⟩
  have hWR := WRes_of_VRR (E := CE η) hsto hat hg hv
  have hkeep : ∀ B x, B ≠ A → LatestNP s.mem (PromAt (CE η) s B) B x →
      LatestNP s'.mem (PromAt (CE η) s' B) B x :=
    fun B x hB hx => storeUnits_NPkeep [.one] [w] 0 s s' hs B x (fun j hj => by
      have : j = 0 := by simp [nWords, Acc.size] at hj; omega
      subst this; simpa [offs_zero] using hB) hx
  have hPb : ∀ t, t ∈ s.promises → t < s.mem.size := fun t ht => hm.2.2.1 t ht
  have htA : ∀ lo hi, lo ≤ A.offset → A.offset < hi → TouchS s s' A.label lo hi := fun lo hi h1 h2 =>
    TouchS_store (s0 := s) hs (by simp [nWords, Acc.size]) rfl (fun _ => Nat.le_refl _) h1 h2
  simp only [storeUnits, List.mem_flatMap, List.mem_singleton] at hs
  obtain ⟨⟨mem', th'⟩, hst, rfl⟩ := hs
  rw [offs_zero] at hst
  have hval : exprVal (mth s pw w w) (dataE 1 w) = w.val := exprVal_dataE _ 1 w (by simp [mth, regsOf])
  -- the cell's entry, with a new latest word of the stored value at `A`
  have hrep : ∀ x' : Word, x'.val = w.val →
      LatestNP mem' (PromAt (CE η) { s with mem := mem', vs := th'.vs, promises := th'.promises } A) A x' →
      ∃ H', MemHeldK (CE η) s Sl (CE η) { s with mem := mem', vs := th'.vs, promises := th'.promises } H' ∧ H' ≤ Rv + H := by
    intro x' hmw hnew
    obtain ⟨H0, rfl, hent0, hX⟩ := MemHeldL_focus hH A.label
    obtain ⟨vals0, hL0, hC0⟩ := hent0.2 c hsto
    have hna : ∀ N e, Ty.word (.lit n) P ≠ .array (.lit N) e := fun N e h => by cases h
    have hwU : wc (Ty.word (.lit n) P) = some 1 := by simp [wc, accs, hg, nWords, Acc.size]
    obtain ⟨b, oS, S, wS, kk, Rsg, hseg, hbo, hatS, hwS, hbw, hkk, ⟨hvs, hVs⟩, hkb, hput⟩ := (own_segL (Nat.le_refl _) hC0 hat hini hna).resolve_right (fun ⟨_, _, _, _, _, _, _, hz⟩ => by have h := hz _ (by simp [accs, hg] : accs (Ty.word (.lit n) P) = some [.one]); simp [nWords, Acc.size] at h)
    have hsl : ((vals0.drop b).take wS).length = wS := by
      simp only [List.length_take, List.length_drop]; omega
    obtain ⟨n1, Rq, Rr2, hwn, hle2, hRs, hRq0, hput2⟩ := VRR_at (CE η).unsee hatS hvs (by rw [hsl]; exact hwS)
    rw [hwU] at hwn
    obtain rfl : 1 = n1 := Option.some.inj hwn
    rw [hsl] at hle2
    have hlenv : A.offset + 1 ≤ vals0.length := by
      rw [← hbo, Nat.add_assoc]; exact Nat.le_trans (Nat.add_le_add_left hle2 b) hbw
    have hq : VRR (fun _ => 0) (CE (CE η).unsee) (.word (.lit n) P) (shp (.word (.lit n) P)) [x'] (Rv + wdW P n) :=
      VRR_word_vals hv (by simp [hmw])
    have hQ := hput2 [x'] (Rv + wdW P n) hq rfl
    have hQV := (VR_put (CE η).unsee hatS (VRR_VR S (RLink_of (Coh_CE _) (CohR_CE _)) hvs) hVs
      (by rw [hsl]; exact hwS) (VRR_VR _ (RLink_of (Coh_CE _) (CohR_CE _)) hq) trivial (by rw [hwU]; rfl)).2.2
    simp only [List.length_singleton] at hQV
    have hQl : (((vals0.drop b).take wS).take oS ++ [x'] ++ ((vals0.drop b).take wS).drop (oS + 1)).length = wS := by
      simp only [List.length_append, List.length_take, List.length_drop, List.length_singleton]; omega
    have hcell' := hput _ _ ⟨hQ, hQV⟩ hQl
    have hsp := splice_seg vals0 [x'] b wS oS (by simpa using hle2)
    simp only [List.length_singleton] at hsp
    rw [hsp, hbo] at hcell'
    have hlat' : ∀ o x, (vals0.take A.offset ++ [x'] ++ vals0.drop (A.offset + 1))[o]? = some x →
        LatestNP mem' (PromAt (CE η) { s with mem := mem', vs := th'.vs, promises := th'.promises } ⟨A.label, o⟩)
          ⟨A.label, o⟩ x := by
      intro o x hov
      rw [splice_get vals0 [x'] A.offset 1 o rfl hlenv] at hov
      by_cases hr : A.offset ≤ o ∧ o < A.offset + 1
      · rw [iteT hr] at hov
        obtain rfl : o = A.offset := Nat.le_antisymm (Nat.lt_succ_iff.1 hr.2) hr.1
        simp only [Nat.sub_self, List.getElem?_cons_zero, Option.some.injEq] at hov
        subst hov
        exact hnew
      · rw [iteF hr] at hov
        refine hkeep _ x (fun e => hr ?_) (hL0 o x hov)
        have h2 : o = A.offset := congrArg (·.offset) e
        exact ⟨Nat.le_of_eq h2.symm, by rw [h2]; exact Nat.lt_succ_self _⟩
    have hent : HeldEntryL (CE η) { s with mem := mem', vs := th'.vs, promises := th'.promises } A.label
        ((Sl A.label).set kk (Rv + wdW P n + Rr2)) := by
      refine ⟨fun h => (by rw [show (CE η).sto A.label = η.sto A.label from rfl, hsto] at h; cases h),
        fun c2 hc2 => ?_⟩
      rw [show (CE η).sto A.label = η.sto A.label from rfl, hsto] at hc2; cases hc2
      exact ⟨_, hlat', hcell'⟩
    have hX' := MemHeldXL_tr (E' := CE η) (s' := { s with mem := mem', vs := th'.vs, promises := th'.promises })
      hX (fun _ _ => rfl) (fun _ _ => rfl)
      (fun l' hne o x hl => hkeep _ x (fun e => hne (congrArg (·.label) e)) hl) id
    have hkl : kk < (Sl A.label).length := (List.getElem?_eq_some_iff.1 hkk).1
    have hR0 : Res.sum (Sl A.label) = Rsg + Res.sum ((Sl A.label).set kk .zero) := by
      rw [Res.sum_set_zero _ kk hkl, (List.getElem?_eq_some_iff.1 hkk).2]
    have hK := MemHeldK_slotSet (E0 := CE η) (s0 := s) hX' hent (fun c1 N e us1 hc1 hT hu1 => by
      rw [show (CE η).sto A.label = η.sto A.label from rfl, hsto] at hc1; cases hc1
      obtain ⟨hb, -⟩ := hkb N e us1 hT hu1
      have hw := seg_arr_width hseg hT hu1 hwS
      refine htA _ _ (by rw [← hbo, hb]; exact Nat.le_add_right _ _) ?_
      have h1 : oS + 1 ≤ wS := hle2
      rw [← hbo, hb, Nat.succ_mul]; exact Nat.add_lt_add_left (by rw [← hw]; omega) _)
    rw [Res.sum_set _ kk _ hkl] at hK
    rw [hR0]; subst hRs
    have hw0 := wdW_le_VRR_word hRq0
    refine ⟨Rv + wdW P n + Rr2 + Res.sum ((Sl A.label).set kk .zero) + H0, hK, Res.le_def.2 fun k => ?_⟩
    have := hw0 k
    simp only [Res.add_apply] at this ⊢
    omega
  rcases stepStore_casesE hst with ⟨hmem, hpr⟩ | ⟨t, m, hmem, htp, hpr, hmt, hloc, hmv, -⟩
  · -- append: the stored word is the latest at the word unit
    have hp1 : th'.promises = s.promises := hpr
    obtain ⟨m0, hm0e⟩ : ∃ m0 : Msg, m0 = ⟨A, exprVal (mth s pw w w) (dataE 1 w),
        Promises.storeMview (mth s pw w w) (dataE 1 w) [0] rel⟩ := ⟨_, rfl⟩
    rw [← hm0e] at hmem
    have hloc0 : m0.loc = A := by rw [hm0e]
    have hmw : (mw m0).val = w.val := by rw [hm0e]; exact hval
    have hnew : LatestNP mem' (PromAt (CE η) { s with mem := mem', vs := th'.vs, promises := th'.promises } A) A (mw m0) := by
      by_cases hV : Vis (CE η) A.label
      · rw [PromAt_word ⟨hWU0, hV⟩, hmem]
        have := LatestNP_push_top (P := []) (M := s.mem) m0 (fun t ht => by cases ht)
        rwa [hloc0] at this
      · rw [PromAt_nwordP (fun h => hV h.2) (fun h => hV (PredU_vis h)) (FpAt_priv hV), hmem]
        have := LatestNP_push_top (P := th'.promises) (M := s.mem) m0 (fun t ht => hPb t (by rw [← hp1]; exact ht))
        rwa [hloc0] at this
    obtain ⟨H', hH', hle⟩ := hrep (mw m0) hmw hnew
    have hC' : PromCr (CE η) { s with mem := mem', vs := th'.vs, promises := th'.promises } cr db :=
      PromCr_keep hC hp1 hPb (fun t ht => by show mem'[t]? = _; rw [hmem]; exact push_lt ht) (fun _ _ _ _ => rfl)
    have e1 : ∀ f, pSum { s with mem := mem', vs := th'.vs, promises := th'.promises } f = pSum s f := fun f => by
      unfold pSum; rw [show ({ s with mem := mem', vs := th'.vs, promises := th'.promises } : St).promises = s.promises from hp1]
    refine ⟨H', hH', hC', Res.le_def.2 fun k => ?_⟩
    rw [e1, e1]
    have := Res.le_def.1 hle k
    simp only [Res.add_apply] at this ⊢
    omega
  · -- fulfil: the promise erased
    have hp1 : th'.promises = s.promises.erase t := hpr
    have hC' : PromCr (CE η) { s with mem := mem', vs := th'.vs, promises := th'.promises } cr db :=
      PromCr_erase hC hp1 hPb (fun t _ => by show mem'[t]? = _; rw [hmem]) (fun _ _ _ _ => rfl)
    have e1 := pSum_erase (f := cr) (s' := { s with mem := mem', vs := th'.vs, promises := th'.promises }) hp1 htp
    have e2 := pSum_erase (f := db) (s' := { s with mem := mem', vs := th'.vs, promises := th'.promises }) hp1 htp
    have hkeepA : (∀ x, LatestNP s.mem (PromAt (CE η) s A) A x →
          LatestNP mem' (PromAt (CE η) { s with mem := mem', vs := th'.vs, promises := th'.promises } A) A x) →
        MemHeldK (CE η) s Sl (CE η) { s with mem := mem', vs := th'.vs, promises := th'.promises } H := by
      intro hA
      refine MemHeldK_tr hH (fun _ => rfl) (fun _ => rfl) (fun l o x hx => ?_) id
      by_cases hB : (⟨l, o⟩ : Address) = A
      · rw [hB] at hx ⊢; exact hA x hx
      · exact hkeep _ x hB hx
    by_cases hV : Vis (CE η) A.label
    · -- visible: readings unchanged; the debit is the stored value's
      have hH' : MemHeldK (CE η) s Sl (CE η) { s with mem := mem', vs := th'.vs, promises := th'.promises } H := by
        refine MemHeldK_tr hH (fun _ => rfl) (fun _ => rfl) (fun l o x hx => ?_) id
        by_cases hB : (⟨l, o⟩ : Address) = A
        · rw [hB] at hx ⊢
          rw [PromAt_word ⟨hWU0, hV⟩] at hx ⊢
          show LatestNP mem' [] A x
          rw [hmem]; exact hx
        · exact hkeep _ x hB hx
      have hdb : db t = Rv := by
        obtain ⟨m', hm', hd, -⟩ := hC t htp
        rw [hmt] at hm'; cases hm'
        have hd := (DbRes_nInit (by rw [hloc]; exact hnI t m htp hmt hloc (Or.inl ⟨n, P, c, hsto, hat, hg⟩))).1 hd
        rw [hloc] at hd
        exact Res.add_right_cancel (hWR (mw m) (db t) (by simp [mw, hmv, hval])
          ((VRes_vis hV (IniW_word (E := CE η) hsto hat hg hini)).1 hd))
      refine ⟨H, hH', hC', Res.le_def.2 fun k => ?_⟩
      rw [e1, e2, hdb]
      simp only [Res.add_apply]
      omega
    · -- own cell: no debit; the reading stays or moves to the stored word
      have hown : Priv (CE η) A.label := Classical.byContradiction hV
      have hdb : db t = .zero := by
        obtain ⟨m', hm', hd, -⟩ := hC t htp
        rw [hmt] at hm'; cases hm'
        exact DbRes_ownz (by rw [hloc]; exact hown) hd
      have hpre : PromAt (CE η) s A = s.promises := PromAt_own hown
      have hpost : PromAt (CE η) { s with mem := mem', vs := th'.vs, promises := th'.promises } A =
          s.promises.erase t := by rw [PromAt_own hown]; exact hp1
      have hmem' : mem' = s.mem := hmem
      by_cases hup : LatestNP s.mem (s.promises.erase t) A (mw m)
      · obtain ⟨H', hH', hle⟩ := hrep (mw m) (by simp [mw, hmv, hval]) (by rw [hpost, hmem']; exact hup)
        refine ⟨H', hH', hC', Res.le_def.2 fun k => ?_⟩
        rw [e1, e2, hdb]
        have := Res.le_def.1 hle k
        simp only [Res.add_apply, Res.zero_apply] at this ⊢
        omega
      · have hH' := hkeepA fun x hx => by
          rw [hpre] at hx; rw [hpost, hmem']
          rcases LatestNP_erase_same hx hmt hloc with h | h
          · exact h
          · exact absurd h hup
        refine ⟨H, hH', hC', Res.le_def.2 fun k => ?_⟩
        rw [e1, e2, hdb]
        simp only [Res.add_apply, Res.zero_apply]
        omega

#print axioms wordStoreHeldL

/-- (P4) In a well-formed protocol, a number in clause `c` holds iff that
clause holds (the clauses are disjoint, `pwf_disjoint`). -/
theorem WordHolds_clause {P : Proto} (hp : pwf P = true) (hg : P.ghost = false) {c : Nat} {cl : Clause}
    (hc : P.clauses[c]? = some cl) (k : Nat) :
    WordHolds P [.num (cl.scale * k + cl.off)] ↔ cl.holds = true := by
  constructor
  · rintro ⟨-, n, c', cl', k', he, hc', hh, hn⟩
    simp only [List.cons.injEq, WeakMem.Val.num.injEq, and_true] at he
    have e := pwf_disjoint hp hc hc' (inCl_of cl k) (by rw [he, hn]; exact inCl_of cl' k')
    subst e; rw [hc] at hc'; cases hc'; exact hh
  · intro hh
    exact ⟨hg, _, c, cl, k, rfl, hc, hh, rfl⟩

/-- **(P4) A word store's frame side**: the token comes out of the frame
(`rg n`); the stored word holds `Rv` — `rg n` after a Give (holding state),
nothing after a Keep or a Hand; a Keep binds the token back. So the new frame
`Tf` and the stored word together hold at most the old frame. -/
theorem storeWord_frame {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {K : TEnv → Nat → List Word → Res → Prop}
    {cx c₁ c' : Cx} {env : Env} {x : String} {v tk : At} {r r' i j k' : Idx} {P : Proto} {c₂ : Nat}
    {xt : Ty} {Rf : Res} {cl' : Clause}
    (hi : FInvR ρ η σs K cx env Rf) (hcr : CohR η) (hL : RLink η) (hpwf : pwf P = true) (hg : P.ghost = false)
    (hu : cx.use tk = .ok (.tok r' (some (P, i)), c₁)) (hr : EqI c₁ r r') (hj : IntIdx c₁ v j)
    (hst : InState c₁ P j c₂ k') (hcl : P.clauses[c₂]? = some cl') (hb : c₁.bind x xt = .ok c')
    (hxt : (xt = .unit ∧ cl'.holds = true) ∨ (xt = .unit ∧ cl'.holds = false) ∨
      (xt = .tok r' (some (P, j)) ∧ cl'.holds = false)) :
    ∃ rt w Tf Rv, evalAt env v = some (rt, [w]) ∧ w.val = .num (ev ρ j) ∧
      FInvR ρ η σs K c' ((x, .unit, []) :: env) Tf ∧ Tf + Rv ≤ Rf ∧
      ∀ (E : TEnv) (sh : Shp), VRR (fun _ => 0) E (.word (.lit (ev ρ r)) P) sh [w] (Rv + wdW P (ev ρ r)) := by
  obtain ⟨rt0, ws0, Rt, Rr, -, -, -, hvt, hi1, hle⟩ := useR hu hi hcr
  simp only [VRR, tokWd_some, Res.add_zero] at hvt
  have hsat : Sat c₁.facts ρ := hi1.1.1
  have hrr : ev ρ r = ev ρ r' := hr ρ hsat
  obtain ⟨tv, htvk, hio⟩ := hj
  obtain ⟨rt, w, hev, hwv, -⟩ := atom_num hi1.1.2.1 htvk hio
  obtain ⟨cl, hcl0, hent⟩ := hst
  rw [hcl] at hcl0; cases hcl0
  have hjv : ev ρ j = cl'.scale * ev ρ k' + cl'.off := hent ρ hsat
  have hiff := WordHolds_clause hpwf hg hcl (ev ρ k')
  rw [← hjv] at hiff
  have hInP : InP P (ev ρ j) := ⟨c₂, cl', ev ρ k', hcl, hjv⟩
  have hvw : ∀ (Rv : Res), ((WordHolds P [.num (ev ρ j)] ∧ Rv = .one (.rg (ev ρ r))) ∨
      (¬ WordHolds P [.num (ev ρ j)] ∧ Rv = .zero)) →
      ∀ (E : TEnv) (sh : Shp), VRR (fun _ => 0) E (.word (.lit (ev ρ r)) P) sh [w] (Rv + wdW P (ev ρ r)) := by
    intro Rv hRv E sh
    simp only [VRR, List.map_cons, List.map_nil, hwv]
    refine ⟨⟨hpwf, fun _ => ⟨_, rfl, hInP⟩⟩, ?_⟩
    rcases hRv with ⟨h1, rfl⟩ | ⟨h1, rfl⟩
    · exact Or.inl ⟨h1, by simp [ev]⟩
    · exact Or.inr ⟨h1, by simp [ev]⟩
  rcases hxt with ⟨rfl, hh⟩ | ⟨rfl, hh⟩ | ⟨rfl, hh⟩
  · -- Give: the token goes into the word
    have hfr := bindR hb hi1 hL (show VRR ρ η .unit (shp .unit) [] .zero from rfl) (unit_Lay _)
    rw [Res.add_zero] at hfr
    refine ⟨rt, w, Rr, Rt, hev, hwv, hfr, ?_, hvw _ (Or.inl ⟨hiff.2 hh, by rw [hvt, hrr]⟩)⟩
    rw [Res.add_comm]; exact hle
  · -- Hand: the token is dropped
    have hfr := bindR hb hi1 hL (show VRR ρ η .unit (shp .unit) [] .zero from rfl) (unit_Lay _)
    rw [Res.add_zero] at hfr
    refine ⟨rt, w, Rr, .zero, hev, hwv, hfr, ?_, hvw _ (Or.inr ⟨fun h => by simp [hiff.1 h] at hh, rfl⟩)⟩
    rw [Res.add_zero]
    exact Res.le_def.2 fun k => by have := (Res.le_def.1 hle) k; simp only [Res.add_apply] at this; omega
  · -- Keep: the token is bound back
    have hfr := bindR hb hi1 hL (show VRR ρ η (.tok r' (some (P, j))) (shp .unit) [] Rt from hvt) (tok_Lay _ _ _ _)
    refine ⟨rt, w, Rr + Rt, .zero, hev, hwv, hfr, ?_, hvw _ (Or.inr ⟨fun h => by simp [hiff.1 h] at hh, rfl⟩)⟩
    rw [Res.add_zero, Res.add_comm]; exact hle

/-- (U3, fix b) A plain store fulfils no promise that initialises its unit
(`NoInitF` at every unit the store writes): such a promise is a `bufInit`
holder, fulfilled by the `bufInit` alone. -/
def StoreNI (E : TEnv) (s : St) (th : TTh) : Prop :=
  ∀ x rel a v tok e, th.term = .let_ x (.store rel a v tok) e →
    ∀ rt pw ad μ ru us j, evalAt th.env a = some (rt, [pw]) → addrOf pw = some ad →
      cellOf rt = some (μ, ru) → accs ru = some us → j < nWords us → NoInitF E s (offs ad j)

/-- (P4) The common end of the word stores: the step's outcomes, memory's and
the credits' side by `wordStoreHeld`, the frame's by `Tf + Rv ≤ Rf`. -/
theorem storeWordC_fin {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {c' : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {e : Expr}
    {pw w : Word} {A : Address} {c : Cell} {n : Nat} {P : Proto} {Rf Rs H Tf Rv : Res} {cr db : Ts → Res}
    (hkey : tstep g mem pairs th = (storeUnits g.k g.arch pw A rel [.one] [w] 0 (stOf mem pairs th)).map fun s' =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, .unit, []) :: th.env } s'))
    (hmi : ∀ s', s' ∈ storeUnits g.k g.arch pw A rel [.one] [w] 0 (stOf mem pairs th) → MemInv g (CE η) s')
    (hsto : η.sto A.label = some c) (hat : AtOff c.ty A.offset (.word (.lit n) P)) (hg : P.ghost = false)
    (hini : IniAt η.ini c A (.word (.lit n) P))
    (hv : VRR (fun _ => 0) (CE (CE η).unsee) (.word (.lit n) P) (shp (.word (.lit n) P)) [w] (Rv + wdW P n))
    (hfr : FInvR ρ η th.σs (ResumeR p th.stack Rs) c' ((x, .unit, []) :: th.env) Tf) (hle : Tf + Rv ≤ Rf)
    (hE : EnvOK p η) (he : TypedK p η c' e) (htv' : TvOK c')
    (hm : MemInv g (CE η) (stOf mem pairs th)) (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hnI : NoInitF (CE η) (stOf mem pairs th) A) (hRP : RetPw th.σs th.stack c'.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  rw [hkey]
  obtain ⟨s0, hs0⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := pw) (a := A) (rel := rel)
    [.one] [w] 0 (stOf mem pairs th) rfl
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hs0), fun r hr => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨s', hs', rfl⟩ := hr
  obtain ⟨H', hH', hC', hb⟩ := wordStoreHeldL hm hH hC hsto hat hg hini hv hs' hnI
  refine ⟨Tf + Rs, H', .zero, .zero, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Tf, Rs, rfl, hE, he, htv', hfr, rfl, hRP⟩, hmi s' hs', hH', hC'⟩,
    .none, ?_⟩
  show Tf + Rs + H' + pSum s' cr + pSum (stOf mem pairs th) db + Res.zero ≤
    Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum s' db + Res.zero
  rw [Res.add_zero, Res.add_zero]
  refine Res.le_def.2 fun k => ?_
  have h1 := (Res.le_def.1 hle) k
  have h2 := (Res.le_def.1 hb) k
  simp only [Res.add_apply] at h1 h2 ⊢
  omega

/-- (P4) A protocol word in memory has a well-formed protocol: memory's
holding records the cell's value, whose word component says so (`VRR` at
`word`). -/
theorem pwf_of_held {η : TEnv} {s : St} {H : Res} {A : Address} {c : Cell} {n : Nat} {P : Proto}
    (hH : MemHeld (CE η) s H) (hsto : η.sto A.label = some c) (hat : AtOff c.ty A.offset (.word (.lit n) P))
    (hini : IniAt η.ini c A (.word (.lit n) P)) (hg : P.ghost = false := by assumption) : pwf P = true := by
  obtain ⟨R0, H0, -, hent0, -⟩ := MemHeld_focus hH A.label
  obtain ⟨vals0, -, hC0⟩ := hent0.2 c hsto
  have hna : ∀ N e, Ty.word (.lit n) P ≠ .array (.lit N) e := fun N e h => by cases h
  obtain ⟨b, oS, S, wS, Rsg, Rrc, -, -, hatS, hwS, hbw, -, ⟨hvs, -⟩, -⟩ := (own_segR hC0 hat hini hna).resolve_right (fun ⟨_, _, _, _, _, _, _, hz⟩ => by have h := hz _ (by simp [accs, hg] : accs (Ty.word (.lit n) P) = some [.one]); simp [nWords, Acc.size] at h)
  have hsl : ((vals0.drop b).take wS).length = wS := by
    simp only [List.length_take, List.length_drop]; omega
  obtain ⟨n1, Rq, Rr2, -, -, -, hvq, -⟩ := VRR_at (CE η).unsee hatS hvs (by rw [hsl]; exact hwS)
  simp only [VRR] at hvq
  exact hvq.1.1

/-- (P4 step 3) The holding facts of the three word-store rules: Give ends in a
holding state and binds `Unit`; Hand and Keep end in a non-holding one, Hand
binding `Unit`, Keep the token. -/
def StoreKind (xt : Ty) (r' : Idx) (P : Proto) (j : Idx) (cl' : Clause) : Prop :=
  (xt = .unit ∧ cl'.holds = true) ∨ (xt = .unit ∧ cl'.holds = false) ∨
    (xt = .tok r' (some (P, j)) ∧ cl'.holds = false)

/-- **(P4 step 3) A protocol word's store through an own or `pub` pointer, with
resources and credits** (`storeWordOwn_core`/`storeWordPub_core`): the cell is
the word (`Fd_word_eq`); `storeWordC_fin` does the rest. -/
theorem storeWordPtrC_core {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx c₁ c' : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v tk : At}
    {μ : Mode} {r r' i j k' : Idx} {P : Proto} {c₂ : Nat} {e : Expr} {xt : Ty} {cl' : Clause}
    {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.store rel a v (some tk)) e)
    (hpk : cx.peek a = .ok (.ptr μ (.word r P))) (hμ : μ = .own ∨ μ = .pub) (hg : P.ghost = false)
    (hu : cx.use tk = .ok (.tok r' (some (P, i)), c₁)) (hr : EqI c₁ r r') (hj : IntIdx c₁ v j)
    (hst : InState c₁ P j c₂ k') (hcl : P.clauses[c₂]? = some cl') (hxt : StoreKind xt r' P j cl')
    (hb : c₁.bind x xt = .ok c') (he : TypedK p η c' e) (htv' : TvOK c')
    (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hni : StoreNI (CE η) (stOf mem pairs th) th) (hRPc : RetPw th.σs th.stack c'.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  obtain ⟨hi1, -⟩ := use_FInv hu hi.1
  have ho : cx.opaqueOK (.word r P) = true := by simp [Cx.opaqueOK, Ty.guardT]
  have hcellW : ∀ {lab : AllocLabel} {c : Cell}, Fd c.ty (cl ρ η.wit 0 0 (.word r P)) →
      c.ty = .word (.lit (ev ρ r)) P := fun hcty => by
    have h' := hcty; simp only [cl, clI_zero] at h'; exact Fd_word_eq h'
  rcases hμ with rfl | rfl
  · obtain ⟨lab, c, pw, ru, hea, hpw, hsto, hcty, -, hown, hsku, -⟩ := ownPtr_view hi.1 hpk htv ho
    have hct := hcellW (lab := lab) hcty
    have hat : AtOff c.ty (⟨lab, 0⟩ : Address).offset (.word (.lit (ev ρ r)) P) := by
      rw [hct]; exact .here (Or.inl (by simp [accs, hg]))
    have hini : IniAt η.ini c ⟨lab, 0⟩ (.word (.lit (ev ρ r)) P) := IniAt_of_ne fun N e h => by rw [hct] at h; cases h
    have hpwf := pwf_of_held hH.memHeld hsto hat hini
    obtain ⟨rt, w, Tf, Rv, hev, hwv, hfr, hle, hvR⟩ :=
      storeWord_frame hi hE.2.2 (RLink_of hE.2.1 hE.2.2) hpwf hg hu hr hj hst hcl hb hxt
    obtain ⟨r'', rfl⟩ := eskel_word (show etok (skel ru) = .word (.lit 0) P by rw [hsku]; rfl)
    have hus : accs (Ty.word r'' P) = some [.one] := by simp [accs, hg]
    have hval := (Fd_EnvVal (CE η) hcty).2 (storeWord_val (r := r) hpwf hi1.1 hst hwv)
    have husA : accs c.ty = some [Acc.one] := by rw [hct]; simp [accs, hg]
    have hus' : wc c.ty = some (nWords [Acc.one]) := by rw [hct]; simp [wc, accs, hg]
    have key : tstep g mem pairs th =
        (storeUnits g.k g.arch pw ⟨lab, 0⟩ rel [.one] [w] 0 (stOf mem pairs th)).map fun s' =>
          (s'.mem, s'.pairs, withS { th with term := e, env := (x, .unit, []) :: th.env } s') := by
      simp only [tstep, hterm, evalOp, hea, hev, cellOf, addrOf, hpw, hus, List.map_map]; rfl
    exact storeWordC_fin (A := ⟨lab, 0⟩) key (fun s' hs' => MemInv_store hm hsto hown husA hval rfl s' hs')
      hsto hat hg hini (hvR _ _) hfr hle hE he htv' hm hH hC
      (by simpa [offs_zero] using hni x rel a v (some tk) e hterm _ pw ⟨lab, 0⟩ _ _ [.one] 0 hea (by simp [addrOf, hpw]) rfl hus (by simp [nWords, Acc.size])) hRPc
  · obtain ⟨lab, c, pw, ru, f, hea, hpw, hsto, hcty, hf, -, -, hsku, -⟩ := pubPtr_view hi.1 hpk htv ho
    have hct := hcellW (lab := lab) hcty
    have hat : AtOff c.ty (⟨lab, 0⟩ : Address).offset (.word (.lit (ev ρ r)) P) := by
      rw [hct]; exact .here (Or.inl (by simp [accs, hg]))
    have hini : IniAt η.ini c ⟨lab, 0⟩ (.word (.lit (ev ρ r)) P) := IniAt_of_ne fun N e h => by rw [hct] at h; cases h
    have hpwf := pwf_of_held hH.memHeld hsto hat hini
    obtain ⟨rt, w, Tf, Rv, hev, hwv, hfr, hle, hvR⟩ :=
      storeWord_frame hi hE.2.2 (RLink_of hE.2.1 hE.2.2) hpwf hg hu hr hj hst hcl hb hxt
    obtain ⟨r'', rfl⟩ := eskel_word (show etok (skel ru) = .word (.lit 0) P by rw [hsku]; rfl)
    have hus : accs (Ty.word r'' P) = some [.one] := by simp [accs, hg]
    have husc : accs c.ty = some [.one] := by rw [hct]; simp [accs, hg]
    have hval := (Fd_EnvVal (CE η) hcty).2 (storeWord_val (r := r) hpwf hi1.1 hst hwv)
    have key : tstep g mem pairs th =
        (storeUnits g.k g.arch pw ⟨lab, 0⟩ rel [.one] [w] 0 (stOf mem pairs th)).map fun s' =>
          (s'.mem, s'.pairs, withS { th with term := e, env := (x, .unit, []) :: th.env } s') := by
      simp only [tstep, hterm, evalOp, hea, hev, cellOf, addrOf, hpw, hus, List.map_map]; rfl
    refine storeWordC_fin (A := ⟨lab, 0⟩) key (fun s' hs' => ?_) hsto hat hg hini (hvR _ _) hfr hle hE he htv' hm hH hC
      (by simpa [offs_zero] using hni x rel a v (some tk) e hterm _ pw ⟨lab, 0⟩ _ _ [.one] 0 hea (by simp [addrOf, hpw]) rfl hus (by simp [nWords, Acc.size])) hRPc
    by_cases hown : c.owner = some η.tid
    · exact MemInv_storeF hm hsto hown husc hval rfl s' hs'
    · have hna : ∀ N e, c.ty ≠ .array (.lit N) e := fun N e he => by rw [he] at husc; simp [accs] at husc
      exact MemInv_storePubAt (a := ⟨lab, 0⟩) hm hsto hown hf (.here (Or.inl (by rw [husc]; simp)))
        (IniAt_of_ne fun N e he => hna N e he) hna hval husc rfl s' hs'

/-- **(P4 step 3) A protocol word's store** (own or `pub` pointer, Give, Keep,
Hand), **with resources and promise credits** (`tstepM_storeWord`): Give moves
the token `rg n` from the frame into the stored (holding) word; Keep re-binds
it and stores a non-holding word; Hand drops it (a ticket word holds nothing).
Memory's side is `wordStoreHeld`: an append trades the word's old resources
for the new ones; a fulfilment of an own promise pays its debit (the stored
word's resources) and loses its credit. Nothing is minted. -/
theorem tstepMC_storeWord {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v : At} {tok : Option At}
    {μ : Mode} {r : Idx} {P : Proto} {e : Expr} {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.store rel a v tok) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.ptr μ (.word r P))) (hμ : μ = .own ∨ μ = .pub)
    (hg : P.ghost = false)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hni : StoreNI (CE η) (stOf mem pairs th) th) (hRP : RetPw th.σs th.stack cx.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  have hT0 := hT
  have hCk0 := hCk
  rw [hterm] at hT0 hCk0
  cases hT0 with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk0
  have htv' := OpT_TvOK hP hop htv
  cases hop with
  | storeOwn hp hnw | storePub hp hnw | storeRgn hp hnw | storeCap hp hnw =>
    exfalso; rw [hpk] at hp; cases hp; simp [wordOf] at hnw
  | storeWordGive hp hw hu hr hj _ _ hst hcl _ _ hh _ hb =>
    rw [hpk] at hp; cases hp
    simp only [wordOf, Option.some.injEq, Prod.mk.injEq] at hw; obtain ⟨rfl, rfl⟩ := hw
    exact storeWordPtrC_core hterm hpk hμ hg hu hr hj hst hcl (Or.inl ⟨rfl, hh⟩) hb ⟨he, hck⟩ htv' hi hE htv hm hH hC hni (by rw [bind_ret hb, use_ret hu]; exact hRP)
  | storeWordHand hp hw hu hr hj _ _ hst hcl _ _ hh _ _ hb =>
    rw [hpk] at hp; cases hp
    simp only [wordOf, Option.some.injEq, Prod.mk.injEq] at hw; obtain ⟨rfl, rfl⟩ := hw
    exact storeWordPtrC_core hterm hpk hμ hg hu hr hj hst hcl (Or.inr (Or.inl ⟨rfl, hh⟩)) hb ⟨he, hck⟩ htv' hi hE htv hm hH hC hni (by rw [bind_ret hb, use_ret hu]; exact hRP)
  | storeWordKeep hp hw hu hr hj _ _ hst hcl _ _ hh _ hb =>
    rw [hpk] at hp; cases hp
    simp only [wordOf, Option.some.injEq, Prod.mk.injEq] at hw; obtain ⟨rfl, rfl⟩ := hw
    exact storeWordPtrC_core hterm hpk hμ hg hu hr hj hst hcl (Or.inr (Or.inr ⟨rfl, hh⟩)) hb ⟨he, hck⟩ htv' hi hE htv hm hH hC hni (by rw [bind_ret hb, use_ret hu]; exact hRP)

/-- **(P4 step 3) A protocol word's store through an own or `pub` locative,
with resources and credits** (`storeWordLoc_core`): the word is a component of
its cell (`cell_target`); own cell `MemInv_storeAt`, another thread's
`MemInv_storePubAt`; `storeWordC_fin` does the rest. -/
theorem storeWordLocC_core {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx c₁ c' : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v tk : At}
    {μ : Mode} {r r' i j k' : Idx} {P : Proto} {c₂ : Nat} {e : Expr} {xt : Ty} {cl' : Clause}
    {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.store rel a v (some tk)) e)
    (hpk : cx.peek a = .ok (.loc μ (.word r P))) (hμ : μ = .own ∨ μ = .pub) (hg : P.ghost = false)
    (hu : cx.use tk = .ok (.tok r' (some (P, i)), c₁)) (hr : EqI c₁ r r') (hj : IntIdx c₁ v j)
    (hst : InState c₁ P j c₂ k') (hcl : P.clauses[c₂]? = some cl') (hxt : StoreKind xt r' P j cl')
    (hb : c₁.bind x xt = .ok c') (he : TypedK p η c' e) (htv' : TvOK c')
    (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hni : StoreNI (CE η) (stOf mem pairs th) th) (hRPc : RetPw th.σs th.stack c'.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  have hi0 := hi.1
  obtain ⟨hi1, -⟩ := use_FInv hu hi0
  have ho : cx.opaqueOK (.word r P) = true := by simp [Cx.opaqueOK, Ty.guardT]
  have hus1 : accs (cl ρ η.wit 0 0 (.word r P)) = some [.one] := by simp [cl, accs, hg]
  have hcell : cellOf (Ty.loc μ (.word r P)) = some (μ, .word r P) := by simp [cellOf]
  obtain ⟨rt, ws, hea, hv, hl⟩ := peek_VR hi0.2.1 hpk
  obtain ⟨ad, c, hws, hsto, hat, hmode, hini⟩ := cell_target hcell (Fd_noarr (by rw [hus1]; simp)) hv
  obtain ⟨pw, rfl, hpw⟩ := map_singleton hws
  have hsk := hl.2.1
  obtain ⟨μr, ru, rfl, -, -⟩ : ∃ μr ru, rt = .loc μr ru ∧ skelM μr = skelM μ ∧
      etok (skel ru) = etok (skel (close th.σs (.word r P))) := by
    simp only [close, substTs, skel, etok] at hsk
    obtain ⟨μr, ru, rfl, h1, h2⟩ := eskel_eq_loc hsk
    exact ⟨μr, ru, rfl, h1, h2⟩
  have hlr := pub_accs hi0.2.2.2.1 hi0.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi0.2.1 htv hpk hcell ho hea rfl
  have hus : accs ru = some [.one] := by rw [hlr, hus1]
  have hat' : AtOff c.ty ad.offset (.word (.lit (ev ρ r)) P) := by simpa only [cl, clI_zero] using hat
  have hini' : IniAt η.ini c ad (.word (.lit (ev ρ r)) P) := by simpa only [cl, clI_zero] using (IniAt_mono (modeIni_le_ini _ _ _) hini)
  have hpwf := pwf_of_held hH.memHeld hsto hat' hini'
  obtain ⟨rt, w, Tf, Rv, hev, hwv, hfr, hle, hvR⟩ :=
    storeWord_frame hi hE.2.2 (RLink_of hE.2.1 hE.2.2) hpwf hg hu hr hj hst hcl hb hxt
  have hval := storeWord_val (η := η) (r := r) hpwf hi1.1 hst hwv
  have hna : ∀ N e, cl ρ η.wit 0 0 (.word r P) ≠ .array (.lit N) e := fun N e h => by simp [cl] at h
  have hwUA : accs (cl ρ η.wit 0 0 (.word r P)) = some [Acc.one] := hus1
  have hwU : wc (cl ρ η.wit 0 0 (.word r P)) = some (nWords [Acc.one]) := by simp [wc, hus1]
  have key : tstep g mem pairs th =
      (storeUnits g.k g.arch pw ad rel [.one] [w] 0 (stOf mem pairs th)).map fun s' =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, .unit, []) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hev, cellOf, addrOf, hpw, hus, List.map_map]; rfl
  refine storeWordC_fin key (fun s' hs' => ?_) hsto hat' hg hini' (hvR _ _) hfr hle hE he htv' hm hH hC
    (by simpa [offs_zero] using hni x rel a v (some tk) e hterm _ pw ad _ _ [.one] 0 hea (by simp [addrOf, hpw]) rfl hus (by simp [nWords, Acc.size])) hRPc
  by_cases hown : c.owner = some η.tid
  · exact MemInv_storeAtI hm hsto hown hat (IniAt_mono (modeIni_le_ini _ _ _) hini) hna hval hwUA rfl s' hs'
  · have hpub : μ = .pub := by
      rcases hμ with rfl | rfl
      · exact absurd hmode hown
      · rfl
    subst hpub
    simp only [ModeOK] at hmode
    obtain ⟨f, hf, -⟩ := hmode
    exact MemInv_storePubAt hm hsto hown hf hat hini hna hval hus1 rfl s' hs'

/-- **(P4 step 3) A protocol word's store through an own or `pub` locative**,
with resources and credits (`tstepM_storeWordLoc`), as `tstepMC_storeWord`. -/
theorem tstepMC_storeWordLoc {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v : At} {tok : Option At}
    {μ : Mode} {r : Idx} {P : Proto} {e : Expr} {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.store rel a v tok) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.loc μ (.word r P))) (hμ : μ = .own ∨ μ = .pub)
    (hg : P.ghost = false)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hni : StoreNI (CE η) (stOf mem pairs th) th) (hRP : RetPw th.σs th.stack cx.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  have hT0 := hT
  have hCk0 := hCk
  rw [hterm] at hT0 hCk0
  cases hT0 with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk0
  have htv' := OpT_TvOK hP hop htv
  cases hop with
  | storeOwn hp hnw | storePub hp hnw | storeRgn hp hnw | storeCap hp hnw =>
    exfalso; rw [hpk] at hp; cases hp; simp [wordOf] at hnw
  | storeWordGive hp hw hu hr hj _ _ hst hcl _ _ hh _ hb =>
    rw [hpk] at hp; cases hp
    simp only [wordOf, Option.some.injEq, Prod.mk.injEq] at hw; obtain ⟨rfl, rfl⟩ := hw
    exact storeWordLocC_core hterm hpk hμ hg hu hr hj hst hcl (Or.inl ⟨rfl, hh⟩) hb ⟨he, hck⟩ htv' hi hE htv hm hH hC hni (by rw [bind_ret hb, use_ret hu]; exact hRP)
  | storeWordHand hp hw hu hr hj _ _ hst hcl _ _ hh _ _ hb =>
    rw [hpk] at hp; cases hp
    simp only [wordOf, Option.some.injEq, Prod.mk.injEq] at hw; obtain ⟨rfl, rfl⟩ := hw
    exact storeWordLocC_core hterm hpk hμ hg hu hr hj hst hcl (Or.inr (Or.inl ⟨rfl, hh⟩)) hb ⟨he, hck⟩ htv' hi hE htv hm hH hC hni (by rw [bind_ret hb, use_ret hu]; exact hRP)
  | storeWordKeep hp hw hu hr hj _ _ hst hcl _ _ hh _ hb =>
    rw [hpk] at hp; cases hp
    simp only [wordOf, Option.some.injEq, Prod.mk.injEq] at hw; obtain ⟨rfl, rfl⟩ := hw
    exact storeWordLocC_core hterm hpk hμ hg hu hr hj hst hcl (Or.inr (Or.inr ⟨rfl, hh⟩)) hb ⟨he, hck⟩ htv' hi hE htv hm hH hC hni (by rw [bind_ret hb, use_ret hu]; exact hRP)

/-- (P4) `ghostRef` at any continuation: a reference to a ghost word has an
empty access list. -/
theorem ghostRefK {p : Prog} {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {K : TEnv → List Word → Prop}
    {env : Env} {a : At} {t : Ty} {μ : Mode} {r : Idx} {P : Proto}
    (hpk : cx.peek a = .ok t) (ht : t = .ptr μ (.word r P) ∨ t = .loc μ (.word r P))
    (hμ : μ = .own ∨ μ = .pub) (hg : P.ghost = true)
    (hi : FInv ρ η σs K cx env) (hE : EnvOK p η) (htv : TvOK cx) :
    ∃ rt pw b μ' ru, evalAt env a = some (rt, [pw]) ∧ cellOf rt = some (μ', ru) ∧
      addrOf pw = some b ∧ accs ru = some [] := by
  have ho : cx.opaqueOK (.word r P) = true := by simp [Cx.opaqueOK, Ty.guardT]
  rcases ht with rfl | rfl
  · rcases hμ with rfl | rfl
    · obtain ⟨lab, c, pw, ru, hea, hpw, -, -, -, -, hsku, -⟩ := ownPtr_view hi hpk htv ho
      obtain ⟨r'', rfl⟩ := eskel_word (show etok (skel ru) = .word (.lit 0) P by rw [hsku]; rfl)
      exact ⟨_, pw, ⟨lab, 0⟩, _, _, hea, rfl, by simp [addrOf, hpw], by simp [accs, hg]⟩
    · obtain ⟨lab, c, pw, ru, f, hea, hpw, -, -, -, -, -, hsku, -⟩ := pubPtr_view hi hpk htv ho
      obtain ⟨r'', rfl⟩ := eskel_word (show etok (skel ru) = .word (.lit 0) P by rw [hsku]; rfl)
      exact ⟨_, pw, ⟨lab, 0⟩, _, _, hea, rfl, by simp [addrOf, hpw], by simp [accs, hg]⟩
  · have hus1 : accs (cl ρ η.wit 0 0 (.word r P)) = some [] := by simp [cl, accs, hg]
    have hcell : cellOf (Ty.loc μ (.word r P)) = some (μ, .word r P) := by simp [cellOf]
    obtain ⟨rt, ws, hea, hv, hl⟩ := peek_VR hi.2.1 hpk
    obtain ⟨ad, c, hws, -, -, -, -⟩ := cell_target hcell (Fd_noarr (by rw [hus1]; simp)) hv
    obtain ⟨pw, rfl, hpw⟩ := map_singleton hws
    have hsk := hl.2.1
    obtain ⟨μr, ru, rfl⟩ : ∃ μr ru, rt = .loc μr ru := by
      simp only [close, substTs, skel, etok] at hsk
      obtain ⟨μr, ru, rfl, -, -⟩ := eskel_eq_loc hsk
      exact ⟨μr, ru, rfl⟩
    have hlr := pub_accs hi.2.2.2.1 hi.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi.2.1 htv hpk hcell ho hea rfl
    exact ⟨_, pw, ad, μr, ru, hea, rfl, by simp [addrOf, hpw], by rw [hlr, hus1]⟩

/-- **(P4 step 3) A store to a ghost word, with resources and credits**
(`tstepM_storeWordGhost`): memory, its holding and the credits are untouched;
a Give or a Hand drops the token (a ghost word holds nothing), a Keep re-binds
it. -/
theorem tstepMC_storeWordGhost {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v : At} {tok : Option At}
    {t : Ty} {μ : Mode} {r : Idx} {P : Proto} {e : Expr} {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.store rel a v tok) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok t) (ht : t = .ptr μ (.word r P) ∨ t = .loc μ (.word r P))
    (hμ : μ = .own ∨ μ = .pub) (hg : P.ghost = true)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  obtain ⟨rt, pw, b, μ', ru, hea, hc, hab, hus⟩ := ghostRefK hpk ht hμ hg hi.1 hE htv
  have hnw : wordOf t ≠ none := by rcases ht with rfl | rfl <;> simp [wordOf]
  have hT0 := hT
  have hCk0 := hCk
  rw [hterm] at hT0 hCk0
  cases hT0 with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk0
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  have fin : ∀ {Tf : Res}, FInvR ρ η th.σs (ResumeR p th.stack Rs) c' ((x, .unit, []) :: th.env) Tf →
      Tf ≤ Rf → (∃ rv w, evalAt th.env v = some (rv, [w])) →
      tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
        ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
        Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
          Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
    intro Tf hfr hle hevx
    obtain ⟨rv, w, hev⟩ := hevx
    have key : tstep g mem pairs th =
        [((stOf mem pairs th).mem, (stOf mem pairs th).pairs,
          withS { th with term := e, env := (x, .unit, []) :: th.env } (stOf mem pairs th))] := by
      simp only [tstep, hterm, evalOp, hea, hev, hc, hab, hus, storeUnits, List.map]
    rw [key]
    refine ⟨by simp, fun r hr => ?_⟩
    simp only [List.mem_singleton] at hr
    subst hr
    refine ⟨Tf + Rs, H, .zero, .zero, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Tf, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩, hm, MemHeldK_of hH, hC⟩, .none, ?_⟩
    show Tf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf mem pairs th) db + Res.zero ≤
      Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf mem pairs th) db + Res.zero
    refine Res.le_def.2 fun k => ?_
    have h1 := (Res.le_def.1 hle) k
    simp only [Res.add_apply] at h1 ⊢
    omega
  have hL := RLink_of hE.2.1 hE.2.2
  cases hop with
  | storeOwn hp hnw' | storePub hp hnw' | storeRgn hp hnw' | storeCap hp hnw' =>
    exfalso; rw [hpk] at hp; cases hp; exact hnw hnw'
  | storeWordGive hp hw hu _ hj _ _ hst _ _ _ _ _ hb =>
    obtain ⟨-, -, Rt, Rr, -, -, -, -, hi1, hle⟩ := useR hu hi hE.2.2
    obtain ⟨tv, htvk, hio⟩ := hj
    obtain ⟨rv, w, hev, -, -⟩ := atom_num hi1.1.2.1 htvk hio
    have hfr := bindR hb hi1 hL (show VRR ρ η .unit (shp .unit) [] .zero from rfl) (unit_Lay _)
    rw [Res.add_zero] at hfr
    exact fin hfr (Res.le_def.2 fun k => by
      have := (Res.le_def.1 hle) k; simp only [Res.add_apply] at this; omega) ⟨rv, w, hev⟩
  | storeWordHand hp hw hu _ hj _ _ hst _ _ _ _ _ _ hb =>
    obtain ⟨-, -, Rt, Rr, -, -, -, -, hi1, hle⟩ := useR hu hi hE.2.2
    obtain ⟨tv, htvk, hio⟩ := hj
    obtain ⟨rv, w, hev, -, -⟩ := atom_num hi1.1.2.1 htvk hio
    have hfr := bindR hb hi1 hL (show VRR ρ η .unit (shp .unit) [] .zero from rfl) (unit_Lay _)
    rw [Res.add_zero] at hfr
    exact fin hfr (Res.le_def.2 fun k => by
      have := (Res.le_def.1 hle) k; simp only [Res.add_apply] at this; omega) ⟨rv, w, hev⟩
  | storeWordKeep hp hw hu _ hj _ _ hst _ _ _ _ _ hb =>
    obtain ⟨rt0, ws0, Rt, Rr, hev0, hv0, hl0, hvt, hi1, hle⟩ := useR hu hi hE.2.2
    simp only [VRR] at hvt
    obtain ⟨tv, htvk, hio⟩ := hj
    obtain ⟨rv, w, hev, -, -⟩ := atom_num hi1.1.2.1 htvk hio
    have hfr := bindR (R := Rt) (rt := .unit) (ws := []) hb hi1 hL (by simp only [VRR]; exact hvt) (tok_Lay _ _ _ _)
    exact fin hfr (by rw [Res.add_comm]; exact hle) ⟨rv, w, hev⟩

/-- **(P4 step 3) A store to a protocol word** (Give, Keep, Hand) through an
own or `pub` pointer or locative, runtime or ghost, with resources and promise
credits (`tstepM_storeWordAny`). -/
theorem tstepMC_storeWordAny {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v : At} {tok : Option At}
    {t : Ty} {μ : Mode} {r : Idx} {P : Proto} {e : Expr} {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.store rel a v tok) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok t) (ht : t = .ptr μ (.word r P) ∨ t = .loc μ (.word r P))
    (hμ : μ = .own ∨ μ = .pub)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hni : StoreNI (CE η) (stOf mem pairs th) th) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  cases hg : P.ghost
  · rcases ht with rfl | rfl
    · exact tstepMC_storeWord hterm hP hpk hμ hg hT hCk hi hE htv hm hH hC hni hRP
    · exact tstepMC_storeWordLoc hterm hP hpk hμ hg hT hCk hi hE htv hm hH hC hni hRP
  · exact tstepMC_storeWordGhost hterm hP hpk ht hμ hg hT hCk hi hE htv hm hH hC hRP hPS

/-! ### (P4 step 3, W2) Protocol RMWs: what a word value holds -/

theorem VRR_word_wr {ρ₀ : Nat → Nat} {η : TEnv} {n : Nat} {P : Proto} {S : Shp} {w : Word} {R : Res}
    (h : VRR ρ₀ η (.word (.lit n) P) S [w] R) : R = wr P n w.val + wdW P n := by
  simp only [VRR] at h
  rcases h.2 with ⟨hh, rfl⟩ | ⟨hh, rfl⟩
  · simp only [List.map_cons, List.map_nil] at hh; simp [wr, hh, ev]
  · simp only [List.map_cons, List.map_nil] at hh; simp [wr, hh, ev]

/-- (U3, fix b) A non-ghost protocol word memory holds is a number. -/
theorem VRR_word_nundef {ρ₀ : Nat → Nat} {η : TEnv} {r : Idx} {P : Proto} {S : Shp} {w : Word} {R : Res}
    (h : VRR ρ₀ η (.word r P) S [w] R) (hg : P.ghost = false) : w.val ≠ .undef := by
  simp only [VRR] at h
  obtain ⟨v, hv, -⟩ := h.1.2 hg
  simp only [List.map_cons, List.map_nil, List.cons.injEq, and_true] at hv
  rw [hv]; intro h; cases h

theorem VRR_word_of {ρ₀ : Nat → Nat} {η : TEnv} {n : Nat} {P : Proto} {S : Shp} {w : Word}
    (hp : pwf P = true) (hin : ∃ v, w.val = .num v ∧ InP P v) :
    VRR ρ₀ η (.word (.lit n) P) S [w] (wr P n w.val + wdW P n) := by
  obtain ⟨v, hv, hvp⟩ := hin
  simp only [VRR]
  refine ⟨⟨hp, fun _ => ⟨v, by simp [hv], hvp⟩⟩, ?_⟩
  by_cases hh : WordHolds P [w.val]
  · exact Or.inl ⟨by simpa using hh, by simp [wr, hh, ev]⟩
  · exact Or.inr ⟨by simpa using hh, by simp [wr, hh, ev]⟩

/-- (P4) At a non-ghost word position, `WRes` is `wr`. -/
theorem WordAt_uniq {E : TEnv} {a : Address} {n n' : Nat} {P P' : Proto}
    (h : WordAt E a n P) (h' : WordAt E a n' P') : n = n' ∧ P = P' := by
  obtain ⟨c, hc, hat, hg⟩ := h
  obtain ⟨c', hc', hat', hg'⟩ := h'
  rw [hc] at hc'; cases hc'
  obtain ⟨e1, rfl⟩ := AtOff_word_uniq hg hg' hat hat'
  cases e1; exact ⟨rfl, rfl⟩

theorem WRes_wr {E : TEnv} {a : Address} {n : Nat} {P : Proto} (hw : WordAt E a n P) (w : Word) :
    WRes E a w (wr P n w.val) := by
  by_cases hh : WordHolds P [w.val]
  · exact Or.inl ⟨n, P, hw, hh, by simp [wr, hh]⟩
  · refine Or.inr ⟨fun n' P' hw' hh' => ?_, by simp [wr, hh]⟩
    obtain ⟨rfl, rfl⟩ := WordAt_uniq hw hw'
    exact hh hh'

theorem WRes_eq_wr {E : TEnv} {a : Address} {n : Nat} {P : Proto} (hw : WordAt E a n P) {w : Word} {R : Res}
    (h : WRes E a w R) : R = wr P n w.val :=
  WRes_uniq (fun _ _ _ _ h1 h2 => WordAt_uniq h1 h2) h (WRes_wr hw w)

theorem WordAt_unit {E : TEnv} {a : Address} {n : Nat} {P : Proto} (hw : WordAt E a n P) : WordUnit E a := by
  obtain ⟨c, hc, hat, hg⟩ := hw
  exact ⟨c, hc, Or.inl ⟨_, P, hg, hat⟩⟩

theorem wc_word {r : Idx} {P : Proto} (hg : P.ghost = false) : wc (.word r P) = some 1 := by
  simp [wc, accs_word hg, nWords, Acc.size]

/-- **(P4) Memory's holding across a new latest word at a word unit**: the
word at `a` (latest, promises included) goes from `w0` to `w1`, every other
address keeps its reading; the cell's entry changes by the word's holding. -/
theorem heldWord {E : TEnv} {s s' : St} {H : Res} {a : Address} {c : Cell} {n : Nat} {P : Proto}
    {w0 w1 : Word}
    (hH : MemHeld E s H) (hsto : E.sto a.label = some c) (hat : AtOff c.ty a.offset (.word (.lit n) P))
    (hg : P.ghost = false) (hini : IniAt E.ini c a (.word (.lit n) P)) (hp : pwf P = true)
    (hl0 : LatestNP s.mem (PromAt E s a) a w0) (hl1 : LatestNP s'.mem (PromAt E s' a) a w1)
    (hin : ∃ v, w1.val = .num v ∧ InP P v)
    (hkeep : ∀ b w, b ≠ a → LatestNP s.mem (PromAt E s b) b w → LatestNP s'.mem (PromAt E s' b) b w) :
    ∃ H', MemHeld E s' H' ∧ H' + wr P n w0.val = H + wr P n w1.val := by
  obtain ⟨R0, H0, rfl, hent0, hX⟩ := MemHeld_focus hH a.label
  obtain ⟨vals, hL, hC⟩ := hent0.2 c hsto
  obtain ⟨b, o, S, wS, Rs, Rr, -, hbo, hatS, hwS, hbw, hR0, ⟨hvs, hVs⟩, hput⟩ :=
    (own_segR hC hat hini (fun N e h => by cases h)).resolve_right (fun ⟨_, _, _, _, _, _, _, hz⟩ => by have h := hz _ (by simp [accs, hg] : accs (Ty.word (.lit n) P) = some [.one]); simp [nWords, Acc.size] at h)
  have hsl : ((vals.drop b).take wS).length = wS := by
    simp only [List.length_take, List.length_drop]; omega
  obtain ⟨n1, Rq, Rr2, hwn, hle, hRs, hvq, hput2⟩ := VRR_at E.unsee hatS hvs (by rw [hsl]; exact hwS)
  rw [wc_word hg] at hwn
  obtain rfl : 1 = n1 := Option.some.inj hwn
  rw [hsl] at hle
  have hlenv : a.offset + 1 ≤ vals.length := by
    rw [← hbo, Nat.add_assoc]; exact Nat.le_trans (Nat.add_le_add_left hle b) hbw
  have hvqe : (((vals.drop b).take wS).drop o).take 1 = (vals.drop a.offset).take 1 := by
    rw [take_drop_take hle, drop_drop', hbo]
  rw [hvqe] at hvq
  have hget : vals[a.offset]? = some vals[a.offset] := List.getElem?_eq_getElem (by omega)
  have hone : (vals.drop a.offset).take 1 = [vals[a.offset]] := by
    apply List.ext_getElem?; intro i
    rw [slice_get]
    by_cases hi : i < 1
    · rw [iteT hi]; obtain rfl : i = 0 := by omega
      simp only [Nat.add_zero, List.getElem?_cons_zero]; exact hget
    · rw [iteF hi]; simp; omega
  rw [hone] at hvq
  have ea : (⟨a.label, a.offset⟩ : Address) = a := rfl
  have hw0 : vals[a.offset] = w0 := by
    exact LatestNP_uniq (hL a.offset _ hget) hl0
  rw [hw0] at hvq
  have hRq := VRR_word_wr hvq
  -- the new word
  have hq := hput2 [w1] (wr P n w1.val + wdW P n) (VRR_word_of hp hin) rfl
  have hQV := (VR_put E.unsee hatS (VRR_VR S (RLink_of (Coh_CE _) (CohR_CE _)) hvs) hVs
    (by rw [hsl]; exact hwS) (VRR_VR _ (RLink_of (Coh_CE _) (CohR_CE _)) (VRR_word_of (ρ₀ := fun _ => 0)
      (η := CE E.unsee) (S := shp (.word (.lit n) P)) hp hin)) (by simp [Valid]) (wc_word hg)).2.2
  have hQl : (((vals.drop b).take wS).take o ++ [w1] ++ ((vals.drop b).take wS).drop (o + 1)).length = wS := by
    simp only [List.length_append, List.length_take, List.length_drop, List.length_singleton]; omega
  have hcell' := hput _ _ ⟨hq, hQV⟩ hQl
  have hsp := splice_seg vals [w1] b wS o (by simpa using hle)
  simp only [List.length_singleton] at hsp
  rw [hsp, hbo] at hcell'
  have hc2 : CellOKR E (E.ini a.label) (E.rc a.label) c.ty (vals.take a.offset ++ [w1] ++ vals.drop (a.offset + 1))
      (wr P n w1.val + wdW P n + Rr2 + Rr) := hcell'
  have hent : HeldEntry E s' a.label (wr P n w1.val + wdW P n + Rr2 + Rr) := by
    refine ⟨fun h => (by rw [hsto] at h; cases h), fun c3 hc3 => ?_⟩
    rw [hsto] at hc3; cases hc3
    refine ⟨vals.take a.offset ++ [w1] ++ vals.drop (a.offset + 1), fun (o' : Nat) w hw => ?_, hc2⟩
    rw [splice_get vals [w1] a.offset 1 o' rfl hlenv] at hw
    by_cases hr : a.offset ≤ o' ∧ o' < a.offset + 1
    · rw [iteT hr] at hw
      obtain rfl : o' = a.offset := Nat.le_antisymm (Nat.le_of_lt_succ hr.2) hr.1
      simp only [Nat.sub_self, List.getElem?_cons_zero, Option.some.injEq] at hw
      subst hw
      exact hl1
    · rw [iteF hr] at hw
      refine hkeep _ w (fun e => hr ?_) (hL o' w hw)
      have : o' = a.offset := by rw [← e]
      subst this; exact ⟨Nat.le_refl _, Nat.lt_succ_self _⟩
  have hX' : MemHeldX E s' a.label H0 := MemHeldX_tr hX (fun _ _ => rfl) (fun _ _ => rfl)
    (fun l' hne o' w hl => hkeep _ w (fun e => hne (by rw [← e])) hl) id
  refine ⟨_, MemHeld_unfocus hX' hent, Res.ext fun k => ?_⟩
  subst hR0; subst hRs; subst hRq
  simp only [Res.add_apply]; omega

/-- `heldWord` with slot lists; the export keeps every untouched slot. -/
theorem heldWordL {E : TEnv} {s s' : St} {Sl : AllocLabel → List Res} {H : Res} {a : Address} {c : Cell} {n : Nat} {P : Proto}
    {w0 w1 : Word}
    (hH : MemHeldL E s H Sl) (hsto : E.sto a.label = some c) (hat : AtOff c.ty a.offset (.word (.lit n) P))
    (hg : P.ghost = false) (hini : IniAt E.ini c a (.word (.lit n) P)) (hp : pwf P = true)
    (hl0 : LatestNP s.mem (PromAt E s a) a w0) (hl1 : LatestNP s'.mem (PromAt E s' a) a w1)
    (hin : ∃ v, w1.val = .num v ∧ InP P v)
    (hkeep : ∀ b w, b ≠ a → LatestNP s.mem (PromAt E s b) b w → LatestNP s'.mem (PromAt E s' b) b w)
    (htA : ∀ lo hi, lo ≤ a.offset → a.offset < hi → TouchS s s' a.label lo hi) :
    ∃ H', MemHeldK E s Sl E s' H' ∧ H' + wr P n w0.val = H + wr P n w1.val := by
  obtain ⟨H0, rfl, hent0, hX⟩ := MemHeldL_focus hH a.label
  obtain ⟨vals, hL, hC⟩ := hent0.2 c hsto
  obtain ⟨b, o, S, wS, kk, Rs, hseg, hbo, hatS, hwS, hbw, hkk, ⟨hvs, hVs⟩, hkb, hput⟩ :=
    (own_segL (Nat.le_refl _) hC hat hini (fun N e h => by cases h)).resolve_right (fun ⟨_, _, _, _, _, _, _, hz⟩ => by have h := hz _ (by simp [accs, hg] : accs (Ty.word (.lit n) P) = some [.one]); simp [nWords, Acc.size] at h)
  have hsl : ((vals.drop b).take wS).length = wS := by
    simp only [List.length_take, List.length_drop]; omega
  obtain ⟨n1, Rq, Rr2, hwn, hle, hRs, hvq, hput2⟩ := VRR_at E.unsee hatS hvs (by rw [hsl]; exact hwS)
  rw [wc_word hg] at hwn
  obtain rfl : 1 = n1 := Option.some.inj hwn
  rw [hsl] at hle
  have hlenv : a.offset + 1 ≤ vals.length := by
    rw [← hbo, Nat.add_assoc]; exact Nat.le_trans (Nat.add_le_add_left hle b) hbw
  have hvqe : (((vals.drop b).take wS).drop o).take 1 = (vals.drop a.offset).take 1 := by
    rw [take_drop_take hle, drop_drop', hbo]
  rw [hvqe] at hvq
  have hget : vals[a.offset]? = some vals[a.offset] := List.getElem?_eq_getElem (by omega)
  have hone : (vals.drop a.offset).take 1 = [vals[a.offset]] := by
    apply List.ext_getElem?; intro i
    rw [slice_get]
    by_cases hi : i < 1
    · rw [iteT hi]; obtain rfl : i = 0 := by omega
      simp only [Nat.add_zero, List.getElem?_cons_zero]; exact hget
    · rw [iteF hi]; simp; omega
  rw [hone] at hvq
  have ea : (⟨a.label, a.offset⟩ : Address) = a := rfl
  have hw0 : vals[a.offset] = w0 := by
    exact LatestNP_uniq (hL a.offset _ hget) hl0
  rw [hw0] at hvq
  have hRq := VRR_word_wr hvq
  -- the new word
  have hq := hput2 [w1] (wr P n w1.val + wdW P n) (VRR_word_of hp hin) rfl
  have hQV := (VR_put E.unsee hatS (VRR_VR S (RLink_of (Coh_CE _) (CohR_CE _)) hvs) hVs
    (by rw [hsl]; exact hwS) (VRR_VR _ (RLink_of (Coh_CE _) (CohR_CE _)) (VRR_word_of (ρ₀ := fun _ => 0)
      (η := CE E.unsee) (S := shp (.word (.lit n) P)) hp hin)) (by simp [Valid]) (wc_word hg)).2.2
  have hQl : (((vals.drop b).take wS).take o ++ [w1] ++ ((vals.drop b).take wS).drop (o + 1)).length = wS := by
    simp only [List.length_append, List.length_take, List.length_drop, List.length_singleton]; omega
  have hcell' := hput _ _ ⟨hq, hQV⟩ hQl
  have hsp := splice_seg vals [w1] b wS o (by simpa using hle)
  simp only [List.length_singleton] at hsp
  rw [hsp, hbo] at hcell'
  have hc2 := hcell'
  have hent : HeldEntryL E s' a.label ((Sl a.label).set kk (wr P n w1.val + wdW P n + Rr2)) := by
    refine ⟨fun h => (by rw [hsto] at h; cases h), fun c3 hc3 => ?_⟩
    rw [hsto] at hc3; cases hc3
    refine ⟨vals.take a.offset ++ [w1] ++ vals.drop (a.offset + 1), fun (o' : Nat) w hw => ?_, hc2⟩
    rw [splice_get vals [w1] a.offset 1 o' rfl hlenv] at hw
    by_cases hr : a.offset ≤ o' ∧ o' < a.offset + 1
    · rw [iteT hr] at hw
      obtain rfl : o' = a.offset := Nat.le_antisymm (Nat.le_of_lt_succ hr.2) hr.1
      simp only [Nat.sub_self, List.getElem?_cons_zero, Option.some.injEq] at hw
      subst hw
      exact hl1
    · rw [iteF hr] at hw
      refine hkeep _ w (fun e => hr ?_) (hL o' w hw)
      have : o' = a.offset := by rw [← e]
      subst this; exact ⟨Nat.le_refl _, Nat.lt_succ_self _⟩
  have hX' : MemHeldXL E s' a.label H0 Sl := MemHeldXL_tr hX (fun _ _ => rfl) (fun _ _ => rfl)
    (fun l' hne o' w hl => hkeep _ w (fun e => hne (by rw [← e])) hl) id
  have hkl : kk < (Sl a.label).length := (List.getElem?_eq_some_iff.1 hkk).1
  have hR0 : Res.sum (Sl a.label) = Rs + Res.sum ((Sl a.label).set kk .zero) := by
    rw [Res.sum_set_zero _ kk hkl, (List.getElem?_eq_some_iff.1 hkk).2]
  have hK := MemHeldK_slotSet (E0 := E) (s0 := s) hX' hent (fun c1 N e us1 hc1 hT hu1 => by
    rw [hsto] at hc1; cases hc1
    obtain ⟨hb, -⟩ := hkb N e us1 hT hu1
    have hw := seg_arr_width hseg hT hu1 hwS
    refine htA _ _ (by rw [← hbo, hb]; exact Nat.le_add_right _ _) ?_
    have h1 : o + 1 ≤ wS := hle
    rw [← hbo, hb, Nat.succ_mul]; exact Nat.add_lt_add_left (by rw [← hw]; omega) _)
  rw [Res.sum_set _ kk _ hkl] at hK
  refine ⟨_, hK, Res.ext fun k => ?_⟩
  rw [hR0]; subst hRs; subst hRq
  simp only [Res.add_apply]; omega
#print axioms heldWordL

/-! ### (P4 step 3, W2) What an RMW does to memory and the promises -/

/-- (P4) **An RMW's memory effect**: it reads message `t` (its value is the
register's); a failure writes nothing; a success appends above everything at
`a` (`rmwAdjacent t mem.size`) or fulfils an own promise `tw` adjacent to `t`. -/
theorem stepRmw_mem_at {k : Promises.Knobs} {arch : Arch} {mem : Memory} {pairs : List Ts}
    {th : Promises.Thread} {dst : WeakMem.Reg} {a : Address} {kind : WeakMem.RmwKind} {newv : WeakMem.Expr}
    {deps : List WeakMem.Reg} {acq rel : Bool} {mem' : Memory} {th' : Promises.Thread}
    (h : (mem', th') ∈ Promises.stepRmwAt k arch mem pairs th dst a kind newv deps acq rel) :
    ∃ t m, mem[t]? = some m ∧ m.loc = a ∧ (th'.regs dst).val = m.val ∧
      ((WeakMem.rmwSucceeds kind m.val = false ∧ mem' = mem ∧ th'.promises = th.promises) ∨
       (WeakMem.rmwSucceeds kind m.val = true ∧
         ((∃ mv, mem' = mem.push ⟨a, kind.apply m.val (Promises.rmwNewVal th.regs newv), mv⟩ ∧
             th'.promises = th.promises ∧ WeakMem.rmwAdjacent mem a t mem.size = true) ∨
          (∃ tw pm, tw ∈ th.promises ∧ mem' = mem ∧ th'.promises = th.promises.erase tw ∧
             mem[tw]? = some pm ∧ pm.loc = a ∧ pm.val = kind.apply m.val (Promises.rmwNewVal th.regs newv) ∧
             WeakMem.rmwAdjacent mem a t tw = true)))) := by
  simp only [Promises.stepRmwAt, List.mem_flatMap, List.mem_filter, List.mem_range] at h
  obtain ⟨t, ⟨htl, hrd⟩, h⟩ := h
  simp only [WeakMem.readable, Bool.and_eq_true] at hrd
  cases hm : mem[t]? with
  | none => rw [hm] at hrd; simp at hrd
  | some m =>
  rw [hm] at hrd
  have hloc : m.loc = a := by simpa using hrd.1
  have e : mem[t]! = m := by simp [getElem!_def, hm]
  rw [e] at h
  refine ⟨t, m, hm, hloc, ?_⟩
  split at h
  · rename_i hfail
    simp only [List.mem_singleton, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    refine ⟨by split <;> simp [Promises.stepFence, rmwDst_val], Or.inl ⟨by simpa using hfail, rfl, by split <;> rfl⟩⟩
  · rename_i hsucc
    have hs : WeakMem.rmwSucceeds kind m.val = true := by simpa using hsucc
    rw [List.mem_append] at h
    rcases h with h | h
    · split at h
      · rename_i hadj
        simp only [List.mem_singleton, Prod.mk.injEq] at h
        obtain ⟨rfl, rfl⟩ := h
        exact ⟨by split <;> simp [Promises.stepFence, rmwDst_val], Or.inr ⟨hs, Or.inl ⟨_, rfl, by split <;> rfl, hadj⟩⟩⟩
      · simp at h
    · rw [List.mem_filterMap] at h
      obtain ⟨tw, htw, hf⟩ := h
      cases hpm : mem[tw]? with
      | none => simp [hpm] at hf
      | some pm =>
        try simp only [hpm] at hf
        simp only [Option.ite_none_right_eq_some, Option.some.injEq, Prod.mk.injEq] at hf
        obtain ⟨hcond, rfl, rfl⟩ := hf
        simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hcond
        exact ⟨by split <;> simp [Promises.stepFence, rmwDst_val], Or.inr ⟨hs, Or.inr ⟨tw, pm, htw, rfl, by split <;> rfl, hpm,
          hcond.1.1.1.1, hcond.1.1.1.2, hcond.2⟩⟩⟩

theorem stepRmw_mem {k : Promises.Knobs} {arch : Arch} {mem : Memory} {pairs : List Ts}
    {th : Promises.Thread} {dst : WeakMem.Reg} {a : Address} {kind : WeakMem.RmwKind} {newv : WeakMem.Expr}
    {deps : List WeakMem.Reg} {acq rel : Bool} {mem' : Memory} {th' : Promises.Thread}
    (h : (mem', th') ∈ Promises.stepRmw k arch mem pairs th dst a kind newv deps acq rel) :
    ∃ t m, mem[t]? = some m ∧ m.loc = a ∧ (th'.regs dst).val = m.val ∧
      ((WeakMem.rmwSucceeds kind m.val = false ∧ mem' = mem ∧ th'.promises = th.promises) ∨
       (WeakMem.rmwSucceeds kind m.val = true ∧
         ((∃ mv, mem' = mem.push ⟨a, kind.apply m.val (Promises.rmwNewVal th.regs newv), mv⟩ ∧
             th'.promises = th.promises ∧ WeakMem.rmwAdjacent mem a t mem.size = true) ∨
          (∃ tw pm, tw ∈ th.promises ∧ mem' = mem ∧ th'.promises = th.promises.erase tw ∧
             mem[tw]? = some pm ∧ pm.loc = a ∧ pm.val = kind.apply m.val (Promises.rmwNewVal th.regs newv) ∧
             WeakMem.rmwAdjacent mem a t tw = true)))) := by
  have hx := stepRmw_mem_at (th := if arch = .tso then Promises.stepFence th .sy else th) h
  simp only [lockTh_prom, lockTh_regs] at hx
  exact hx

theorem rmwAdjacent_spec {mem : Memory} {a : Address} {t tw : Ts} (h : WeakMem.rmwAdjacent mem a t tw = true) :
    t < tw ∧ ∀ (t' : Ts) (m' : Msg), t < t' → t' < tw → mem[t']? = some m' → m'.loc ≠ a := by
  simp only [WeakMem.rmwAdjacent, WeakMem.betweenAt, Bool.and_eq_true, decide_eq_true_eq, Bool.not_eq_true',
    List.any_eq_false, List.mem_range] at h
  refine ⟨h.1, fun t' m' h1 h2 hm' hl => ?_⟩
  have := h.2 t' (lt_of_get hm')
  simp [h1, h2, hm', hl] at this

/-- (S4f) A message `t` at `a` that is not hidden below coherence, and not an
own promise, is `a`'s latest non-promise one at an own cell (`TailP`). -/
theorem latestNP_of_read {s : St} {a : Address} {t : Ts} {m : Msg} (htl : TailP s a)
    (hh : WeakMem.hiddenFrom s.mem a t (s.vs.coh a) = false) (hm : s.mem[t]? = some m) (hl : m.loc = a)
    (hn : t ∉ s.promises) :
    t ∉ s.promises ∧ ∀ (t' : Ts) (m' : Msg), t < t' → s.mem[t']? = some m' → m'.loc = a → t' ∈ s.promises := by
  refine ⟨hn, fun t' m' hlt hm' hl' => ?_⟩
  by_cases hc : s.vs.coh a < t'
  · exact htl t' m' hc hm' hl'
  · exfalso
    have hh' : WeakMem.hiddenFrom s.mem a t (s.vs.coh a) = true := by
      unfold WeakMem.hiddenFrom
      rw [List.any_eq_true]
      exact ⟨t', List.mem_range.2 (Nat.lt_succ_of_le (Nat.le_of_not_lt hc)), by simp [hlt, hm', hl']⟩
    rw [hh] at hh'; cases hh'

/-- (S4f) An own cell's protocol word has only own promises past coherence. -/
theorem own_tailW {E : TEnv} {s : St} {a : Address} {c : Cell} {n : Nat} {P : Proto}
    (hcP : ∃ vals, CellOK E (E.rc a.label) c.ty vals ∧
      ∀ o v, vals[o]? = some v → LatestP s.mem s.promises s.vs.coh ⟨a.label, o⟩ v)
    (hsto : E.sto a.label = some c)
    (hat : AtOff c.ty a.offset (.word (.lit n) P)) (hg : P.ghost = false)
    (hini : IniAt E.rc c a (.word (.lit n) P)) : TailP s a := by
  obtain ⟨vals, hcell, hlat⟩ := hcP
  obtain ⟨b, o, S, wS, -, hbo, hatS, hwS, hbw, -⟩ := own_seg hcell hat hini (fun N e h => by cases h)
  obtain ⟨L, hL, hn⟩ := wc_some hwS
  have hb := AtOff_bound hatS hL (accs_word hg)
  rw [show nWords [Acc.one] = 1 from rfl] at hb
  have hlt : a.offset < vals.length := by
    rw [← hbo]
    exact Nat.lt_of_lt_of_le (Nat.add_lt_add_left (show o < wS by rw [← hn]; exact hb) b) hbw
  exact fun t m ht hm' hl => (hlat a.offset (vals[a.offset]'hlt) (List.getElem?_eq_getElem hlt)).2.2 t m ht hm' hl

/-! ### (S7c) The accounting flip at a frontier (publish, plant)

An own cell becomes visible (`Vis`) when it gets a frontier.  Memory's reading
of its word units then stops skipping the thread's own promises, so its
entries move from the latest non-promise words to the latest words, and each
promise there gets a credit and a debit.  `MemHeld_flip` does it one promise
at a time, oldest first (`flipSt`), each a `heldWord` trade: the promise's
predecessor (the old reading) is its credit, its own word (the new reading)
its debit, a telescoping equality. -/

/-- (S7c) `MemHeld_tr` reading the new view's promises directly (the views may
differ in their frontiers). -/
theorem MemHeld_trP {E E' : TEnv} {s s' : St} {H : Res} (h : MemHeld E s H)
    (hsto : ∀ l, E'.sto l = E.sto l) (hini : ∀ l, E'.ini l = E.ini l)
    (hlat : ∀ l o w, LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w → LatestNP s'.mem (PromAt E' s' ⟨l, o⟩) ⟨l, o⟩ w)
    (hv : ∀ {T : Ty} {vs : List Word} {R : Res}, ValOfR E T vs R → ValOfR E' T vs R)
    (hri : ∀ l, E'.rini l = E.rini l := by first | exact fun _ => rfl | assumption) :
    MemHeld E' s' H := by
  obtain ⟨L, Rl, hnd, hcov, rfl, hent⟩ := h
  refine ⟨L, Rl, hnd, fun l c hc => hcov l c (by rw [← hsto l]; exact hc), rfl, fun l hl => ?_⟩
  obtain ⟨h0, h1⟩ := hent l hl
  refine ⟨fun hn => h0 (by rw [← hsto l]; exact hn), fun c hc => ?_⟩
  obtain ⟨vals, hL, hC⟩ := h1 c (by rw [← hsto l]; exact hc)
  refine ⟨vals, fun o w hw => hlat l o w (hL o w hw), ?_⟩
  rw [hini l]
  rcases hC with ⟨h1, h2⟩ | ⟨N, e, us, Rs, hT, hu, hn, hl, hRs, hR, hj⟩
  · exact Or.inl ⟨h1, hv h2⟩
  · exact Or.inr ⟨N, e, us, Rs, hT, hu, hn, hl, hRs, hR, fun j Rj h1 h2 => slotR_imp (hj j Rj h1 h2) (TEnv.rc_congr (hini l) (hri l)) hv⟩

/-- (S7c) `LatestNP` reads the skipped list only at its address. -/
theorem LatestNP_congrP {M : Memory} {P P' : List Ts} {a : Address} {w : Word}
    (h : ∀ t m, M[t]? = some m → m.loc = a → (t ∈ P ↔ t ∈ P')) (hl : LatestNP M P a w) : LatestNP M P' a w := by
  obtain ⟨t, m, ht, hm, hloc, hw, hlast⟩ := hl
  exact ⟨t, m, fun h' => ht ((h t m hm hloc).2 h'), hm, hloc, hw,
    fun t' m' hlt hm' hl' => (h t' m' hm' hl').1 (hlast t' m' hlt hm' hl')⟩

/-- (S7c) Memory's holding reads every word position of a cell: a non-ghost
word unit has a reading. -/
theorem held_lat {E : TEnv} {s : St} {H : Res} {a : Address} {c : Cell} {n : Nat} {P : Proto}
    (hH : MemHeld E s H) (hsto : E.sto a.label = some c) (hat : AtOff c.ty a.offset (.word (.lit n) P))
    (hg : P.ghost = false) (hini : IniAt E.ini c a (.word (.lit n) P)) :
    ∃ w0, LatestNP s.mem (PromAt E s a) a w0 := by
  obtain ⟨R0, H0, rfl, hent0, -⟩ := MemHeld_focus hH a.label
  obtain ⟨vals, hL, hC⟩ := hent0.2 c hsto
  obtain ⟨b, o, S, wS, Rs, Rr, -, hbo, hatS, hwS, hbw, -, ⟨hvs, -⟩, -⟩ :=
    (own_segR hC hat hini (fun N e h => by cases h)).resolve_right (fun ⟨_, _, _, _, _, _, _, hz⟩ => by have h := hz _ (by simp [accs, hg] : accs (Ty.word (.lit n) P) = some [.one]); simp [nWords, Acc.size] at h)
  have hsl : ((vals.drop b).take wS).length = wS := by
    simp only [List.length_take, List.length_drop]; omega
  obtain ⟨n1, Rq, Rr2, hwn, hle, -, -, -⟩ := VRR_at E.unsee hatS hvs (by rw [hsl]; exact hwS)
  rw [wc_word hg] at hwn
  obtain rfl : 1 = n1 := Option.some.inj hwn
  rw [hsl] at hle
  have hlenv : a.offset + 1 ≤ vals.length := by
    rw [← hbo, Nat.add_assoc]; exact Nat.le_trans (Nat.add_le_add_left hle b) hbw
  exact ⟨vals[a.offset], hL a.offset _ (List.getElem?_eq_getElem (by omega))⟩

/-- (U3, fix b) Memory's latest word at an initialised visible-or-own word unit
is a number (its reading is a protocol word). -/
theorem held_nundef {E : TEnv} {s : St} {H : Res} {a : Address} {c : Cell} {n : Nat} {P : Proto}
    (hH : MemHeld E s H) (hsto : E.sto a.label = some c) (hat : AtOff c.ty a.offset (.word (.lit n) P))
    (hg : P.ghost = false) (hini : IniAt E.ini c a (.word (.lit n) P)) {w0 : Word}
    (hl0 : LatestNP s.mem (PromAt E s a) a w0) : w0.val ≠ .undef := by
  obtain ⟨R0, H0, rfl, hent0, -⟩ := MemHeld_focus hH a.label
  obtain ⟨vals, hL, hC⟩ := hent0.2 c hsto
  obtain ⟨b, o, S, wS, Rs, Rr, -, hbo, hatS, hwS, hbw, -, ⟨hvs, -⟩, -⟩ :=
    (own_segR hC hat hini (fun N e h => by cases h)).resolve_right (fun ⟨_, _, _, _, _, _, _, hz⟩ => by have h := hz _ (by simp [accs, hg] : accs (Ty.word (.lit n) P) = some [.one]); simp [nWords, Acc.size] at h)
  have hsl : ((vals.drop b).take wS).length = wS := by
    simp only [List.length_take, List.length_drop]; omega
  obtain ⟨n1, Rq, Rr2, hwn, hle, -, hvq, -⟩ := VRR_at E.unsee hatS hvs (by rw [hsl]; exact hwS)
  rw [wc_word hg] at hwn
  obtain rfl : 1 = n1 := Option.some.inj hwn
  rw [hsl] at hle
  have hlenv : a.offset + 1 ≤ vals.length := by
    rw [← hbo, Nat.add_assoc]; exact Nat.le_trans (Nat.add_le_add_left hle b) hbw
  have hvqe : (((vals.drop b).take wS).drop o).take 1 = (vals.drop a.offset).take 1 := by
    rw [take_drop_take hle, drop_drop', hbo]
  rw [hvqe] at hvq
  have hget : vals[a.offset]? = some vals[a.offset] := List.getElem?_eq_getElem (by omega)
  have hone : (vals.drop a.offset).take 1 = [vals[a.offset]] := by
    apply List.ext_getElem?; intro i
    rw [slice_get]
    by_cases hi : i < 1
    · rw [iteT hi]; obtain rfl : i = 0 := by omega
      simp only [Nat.add_zero, List.getElem?_cons_zero]; exact hget
    · rw [iteF hi]; simp; omega
  rw [hone] at hvq
  have hw0 : vals[a.offset] = w0 := LatestNP_uniq (hL a.offset _ hget) hl0
  rw [hw0] at hvq
  exact VRR_word_nundef hvq hg

/-- (S7c) Updating one promise's credit from nothing. -/
theorem pSum_upd0 {s : St} {f : Ts → Res} {k : Ts} {R : Res} (hnd : s.promises.Nodup) (hk : k ∈ s.promises)
    (hz : f k = .zero) : pSum s (fun t => if t = k then R else f t) = R + pSum s f := by
  unfold pSum
  rw [sum_map_erase hk, sum_map_erase (f := f) hk, hz, Res.zero_add]
  simp only [↓reduceIte]
  congr 1
  exact congrArg Res.sum (List.map_congr_left fun t ht => iteF ((List.Nodup.mem_erase_iff hnd).1 ht).1)

/-- (S7c) `t` is an own promise at a unit the flip makes visible. -/
def FlipT (E E' : TEnv) (s : St) (t : Ts) : Prop :=
  t ∈ s.promises ∧ ∃ m, s.mem[t]? = some m ∧ VisU E' m.loc ∧ ¬ VisU E m.loc

open Classical in
/-- (S7c) The flip's intermediate state: the flipped promises below `k`
dropped (memory reads them). -/
noncomputable def flipSt (E E' : TEnv) (s : St) (k : Nat) : St :=
  { s with promises := s.promises.filter fun t => decide (¬ (t < k ∧ FlipT E E' s t)) }

theorem mem_flipSt {E E' : TEnv} {s : St} {k : Nat} {t : Ts} :
    t ∈ (flipSt E E' s k).promises ↔ t ∈ s.promises ∧ ¬ (t < k ∧ FlipT E E' s t) := by
  simp only [flipSt, List.mem_filter, decide_eq_true_eq]

theorem flip_at {E E' : TEnv} {s : St} {k : Nat} {t : Ts} {b : Address}
    (hd : ∀ t, t ∈ E.fp → ¬ FlipT E E' s t) :
    t ∈ PromAt E (flipSt E E' s k) b ↔ t ∈ PromAt E s b ∧ ¬ (t < k ∧ FlipT E E' s t) := by
  by_cases hv : VisU E b
  · rw [PromAt_word hv, PromAt_word hv]
    exact ⟨fun h => (by cases h), fun h => (by cases h.1)⟩
  by_cases hq : PredU E b
  · rw [mem_PromAt_pred hv hq, mem_PromAt_pred hv hq, List.mem_append, List.mem_append, mem_flipSt]
    constructor
    · rintro ⟨⟨h1, h2⟩ | h, ha⟩
      · exact ⟨⟨Or.inl h1, ha⟩, h2⟩
      · exact ⟨⟨Or.inr h, ha⟩, fun h' => hd t (FpAt_sub h) h'.2⟩
    · rintro ⟨⟨h1 | h1, ha⟩, h2⟩
      · exact ⟨Or.inl ⟨h1, h2⟩, ha⟩
      · exact ⟨Or.inr h1, ha⟩
  · rw [PromAt_nword hv hq, PromAt_nword hv hq, List.mem_append, List.mem_append, mem_flipSt]
    constructor
    · rintro (⟨h1, h2⟩ | h)
      · exact ⟨Or.inl h1, h2⟩
      · exact ⟨Or.inr h, fun h' => hd t (FpAt_sub h) h'.2⟩
    · rintro ⟨h1 | h1, h2⟩
      · exact Or.inl ⟨h1, h2⟩
      · exact Or.inr h1

/-- (S7c) Away from the flipped units a `VRes` reading carries over to a view
with more visible cells. -/
theorem VRes_nfu {E E' : TEnv} {a : Address} {w : Word} {R : Res} (hs : E'.sto a.label = E.sto a.label)
    (hi : E'.ini a.label = E.ini a.label)
    (hmono : Vis E a.label → Vis E' a.label) (hn : ¬ (VisU E' a ∧ ¬ VisU E a)) (h : VRes E a w R) :
    VRes E' a w R := by
  rcases h with ⟨hV, hI, hW⟩ | ⟨hV, rfl⟩
  · exact Or.inl ⟨hmono hV, (IniW_congr hs hi).2 hI, (WRes_congr hs).2 hW⟩
  · by_cases hV' : Vis E' a.label ∧ IniW E' a
    · have hI : IniW E a := (IniW_congr hs hi).1 hV'.2
      have hV0 : ¬ Vis E a.label := fun h => hV ⟨h, hI⟩
      have hnv : ¬ VisU E' a := fun h => hn ⟨h, fun h' => hV0 h'.2⟩
      exact Or.inl ⟨hV'.1, hV'.2, Or.inr ⟨fun n P hwa _ => hnv ⟨WordAt_unit hwa, hV'.1⟩, rfl⟩⟩
    · exact Or.inr ⟨hV', rfl⟩

/-- (U3, fix b) `VRes_nfu` for the debit; (H) the predicted units, the thread
and the boxes kept. -/
theorem DbRes_nfu {E E' : TEnv} {mem : Memory} {m : Msg} {tw : Ts} {R : Res}
    (hs : E'.sto m.loc.label = E.sto m.loc.label) (hi : E'.ini m.loc.label = E.ini m.loc.label)
    (hmono : Vis E m.loc.label → Vis E' m.loc.label) (hn : ¬ (VisU E' m.loc ∧ ¬ VisU E m.loc))
    (h : DbRes E mem m tw R) (hq : PredU E' m.loc ↔ PredU E m.loc) (ht : E'.tid = E.tid)
    (hb : ∀ l B, E.box l = some B → E'.box l = some B) : DbRes E' mem m tw R := by
  have hD : DesigAt E' mem m.loc tw ↔ DesigAt E mem m.loc tw := by
    unfold DesigAt; rw [hq, DStart_congr hs ht]
  by_cases hI : InitAt mem m.loc tw
  · rcases h with ⟨hV, hIW, h3, -⟩ | ⟨hV, rfl⟩
    · obtain ⟨R₁, Z, hF, hS, hZ, hR⟩ := h3 hI
      exact Or.inl ⟨hmono hV, (IniW_congr hs hi).2 hIW, fun _ => ⟨R₁, Z, (FRes_congr hs).2 hF,
        fun h' => BlkDb_mono hs hb (hS (hD.1 h')), fun h' => hZ (fun h'' => h' (hD.2 h'')), hR⟩,
        fun h' => absurd hI h'⟩
    · by_cases hV' : Vis E' m.loc.label ∧ IniW E' m.loc
      · have hIW : IniW E m.loc := (IniW_congr hs hi).1 hV'.2
        have hnv : ¬ VisU E' m.loc := fun h => hn ⟨h, fun h' => hV ⟨h'.2, hIW⟩⟩
        refine (DbRes_zero hnv fun hd => ?_).2 rfl
        obtain ⟨hq0, -, -⟩ := hD.1 hd
        exact hV ⟨PredU_vis hq0, hq0.2.1⟩
      · exact Or.inr ⟨hV', rfl⟩
  · exact (DbRes_nInit hI).2 (VRes_nfu hs hi hmono hn ((DbRes_nInit hI).1 h))

/-- (S7f α) There is a latest message at `a` off `P` once one message at `a`
is off `P`. -/
theorem LatestNP_ex {M : Memory} {P : List Ts} {a : Address} {t : Ts} {m : Msg}
    (hm : M[t]? = some m) (hl : m.loc = a) (ht : t ∉ P) : ∃ w, LatestNP M P a w := by
  have key : ∀ n, (∃ t, t < n ∧ ∃ m, M[t]? = some m ∧ m.loc = a ∧ t ∉ P) →
      ∃ t m, M[t]? = some m ∧ m.loc = a ∧ t ∉ P ∧
        ∀ t' m', t < t' → t' < n → M[t']? = some m' → m'.loc = a → t' ∈ P := by
    intro n
    induction n with
    | zero => rintro ⟨t, h, -⟩; exact absurd h (Nat.not_lt_zero _)
    | succ n ih =>
      intro hex
      by_cases hn : ∃ m, M[n]? = some m ∧ m.loc = a ∧ n ∉ P
      · obtain ⟨m, h1, h2, h3⟩ := hn
        exact ⟨n, m, h1, h2, h3, fun t' _ h1' h2' _ _ => absurd h1' (Nat.not_lt.2 (Nat.le_of_lt_succ h2'))⟩
      · obtain ⟨t, htn, hgood⟩ := hex
        have htn' : t < n := Nat.lt_of_le_of_ne (Nat.le_of_lt_succ htn) (fun e => hn (by subst e; exact hgood))
        obtain ⟨t0, m0, h1, h2, h3, h4⟩ := ih ⟨t, htn', hgood⟩
        refine ⟨t0, m0, h1, h2, h3, fun t' m' hlt hlt' hm' hl' => ?_⟩
        by_cases he : t' = n
        · subst he; exact Classical.byContradiction fun hP => hn ⟨m', hm', hl', hP⟩
        · exact h4 t' m' hlt (Nat.lt_of_le_of_ne (Nat.le_of_lt_succ hlt') he) hm' hl'
  obtain ⟨t0, m0, h1, h2, h3, h4⟩ := key M.size ⟨t, lt_of_get hm, m, hm, hl, ht⟩
  exact ⟨mw m0, t0, m0, h3, h1, h2, rfl, fun t' m' hlt hm' hl' => h4 t' m' hlt (lt_of_get hm') hm' hl'⟩

/-- (S7f α) A buffer's accounting reads only its initialised slots: words at
or past slot `n` may change. -/
theorem CellOKR_uninit {η : TEnv} {n nr N : Nat} {T e : Ty} {us : List Acc} {vals vals' : List Word} {R : Res}
    (h : CellOKR η n nr T vals R) (hT : T = .array (.lit N) e) (hus : accs e = some us)
    (hl : vals'.length = vals.length) (hag : ∀ o, o < n * nWords us → vals'[o]? = vals[o]?) :
    CellOKR η n nr T vals' R := by
  rcases h with ⟨h1, -⟩ | ⟨N', e', us', Rs, hT', hu', hn, hlen, hRs, hR, hj⟩
  · subst hT; simp [wc, accs] at h1
  · obtain ⟨rfl, rfl⟩ : N' = N ∧ e' = e := by rw [hT] at hT'; cases hT'; exact ⟨rfl, rfl⟩
    obtain rfl : us' = us := by rw [hus] at hu'; exact (Option.some.inj hu').symm
    refine Or.inr ⟨N', e', us', Rs, hT', hu', hn, by rw [hl]; exact hlen, hRs, hR, fun j Rj hjn hRj => ?_⟩
    have e1 : (vals'.drop (j * nWords us')).take (nWords us') = (vals.drop (j * nWords us')).take (nWords us') := by
      apply List.ext_getElem?; intro i
      rw [slice_get, slice_get]
      by_cases hi : i < nWords us'
      · rw [iteT hi, iteT hi]
        have hm : (j + 1) * nWords us' ≤ n * nWords us' := Nat.mul_le_mul_right _ hjn
        rw [Nat.succ_mul] at hm
        exact hag _ (Nat.lt_of_lt_of_le (Nat.add_lt_add_left hi _) hm)
      · rw [iteF hi, iteF hi]
    rw [e1]; exact hj j Rj hjn hRj

/-- (S7f α) **Memory's holding across a new reading at an uninitialised
buffer slot**: unchanged (the slot is not accounted, `BufOKR`). -/
theorem held_uninit {E : TEnv} {s s' : St} {H : Res} {a : Address} {c : Cell} {N : Nat} {e : Ty} {us : List Acc}
    (hH : MemHeld E s H) (hsto : E.sto a.label = some c) (hT : c.ty = .array (.lit N) e) (hus : accs e = some us)
    (hge : E.ini a.label * nWords us ≤ a.offset)
    (hl1 : ∃ w1, LatestNP s'.mem (PromAt E s' a) a w1)
    (hkeep : ∀ b w, b ≠ a → LatestNP s.mem (PromAt E s b) b w → LatestNP s'.mem (PromAt E s' b) b w) :
    MemHeld E s' H := by
  obtain ⟨R0, H0, rfl, hent0, hX⟩ := MemHeld_focus hH a.label
  obtain ⟨vals, hL, hC⟩ := hent0.2 c hsto
  obtain ⟨w1, hw1⟩ := hl1
  have hX' : MemHeldX E s' a.label H0 := MemHeldX_tr hX (fun _ _ => rfl) (fun _ _ => rfl)
    (fun l' hne o' w hl => hkeep _ w (fun e => hne (by rw [← e])) hl) id
  refine MemHeld_unfocus hX' ⟨(fun h => by rw [hsto] at h; cases h), fun c3 hc3 => ?_⟩
  rw [hsto] at hc3; cases hc3
  by_cases hlenv : a.offset + 1 ≤ vals.length
  · have hlen' : (vals.take a.offset ++ [w1] ++ vals.drop (a.offset + 1)).length = vals.length := by
      rw [List.length_append, List.length_append, List.length_take, Nat.min_eq_left (Nat.le_of_succ_le hlenv),
        List.length_singleton, List.length_drop]
      exact Nat.add_sub_of_le hlenv
    have hag : ∀ o, o < E.ini a.label * nWords us →
        (vals.take a.offset ++ [w1] ++ vals.drop (a.offset + 1))[o]? = vals[o]? := fun o ho => by
      rw [splice_get vals [w1] a.offset 1 o rfl hlenv,
        iteF (fun h => Nat.lt_irrefl _ (Nat.lt_of_lt_of_le ho (Nat.le_trans hge h.1)))]
    refine ⟨vals.take a.offset ++ [w1] ++ vals.drop (a.offset + 1), fun (o' : Nat) w hw => ?_,
      CellOKR_uninit hC hT hus hlen' hag⟩
    · rw [splice_get vals [w1] a.offset 1 o' rfl hlenv] at hw
      by_cases hr : a.offset ≤ o' ∧ o' < a.offset + 1
      · rw [iteT hr] at hw
        obtain rfl : o' = a.offset := Nat.le_antisymm (Nat.le_of_lt_succ hr.2) hr.1
        simp only [Nat.sub_self, List.getElem?_cons_zero, Option.some.injEq] at hw
        subst hw
        exact hw1
      · rw [iteF hr] at hw
        refine hkeep _ w (fun e => hr ?_) (hL o' w hw)
        have : o' = a.offset := by rw [← e]
        subst this; exact ⟨Nat.le_refl _, Nat.lt_succ_self _⟩
  · refine ⟨vals, fun o' w hw => hkeep _ w (fun e => ?_) (hL o' w hw), hC⟩
    have : o' = a.offset := by rw [← e]
    have hlt := (List.getElem?_eq_some_iff.1 hw).1
    exact hlenv (by rw [← this]; exact Nat.succ_le_of_lt hlt)

/-- **(S7c) The accounting flip**: from view `E` to `E'` with the same Σ,
`ini`, thread, more visible cells (`hmono`) and values (`hv`).  Memory's
reading changes exactly at the flipped units (visible at `E'`, not at `E`);
side condition `hw`, for each own promise there at an initialised address
(`IniW`): it is a non-ghost `.word` of a literal region, initialised, of a
well-formed protocol, holding one of its states (the `hwu` of
`promise_acct`), and every non-promise message at its address is below it (the
coherence tail, `own_tailW`, with `PromAbove`).  Then memory's holding and the
credits move by a telescoping equality: each flipped promise's credit is its
predecessor's holding, its debit its own word's; the other credits are kept.
(S7f α) A flipped promise at an uninitialised buffer slot needs nothing: the
slot is not accounted (`held_uninit`), its credit and debit stay nothing
(`VRes_uninit`). -/
theorem MemHeld_flip {E E' : TEnv} {s : St} {H : Res} {cr db : Ts → Res}
    (hH : MemHeld E s H) (hC : PromCr E s cr db)
    (hPb : ∀ t, t ∈ s.promises → t < s.mem.size) (hnd : s.promises.Nodup)
    (hs : ∀ l, E'.sto l = E.sto l) (hi : ∀ l, E'.ini l = E.ini l)
    (hmono : ∀ l, Vis E l → Vis E' l)
    (hv : ∀ {T : Ty} {vs : List Word} {R : Res}, ValOfR E T vs R → ValOfR E' T vs R)
    (hw : ∀ t m, t ∈ s.promises → s.mem[t]? = some m → VisU E' m.loc → ¬ VisU E m.loc → IniW E m.loc →
      (∃ c n P, E.sto m.loc.label = some c ∧ AtOff c.ty m.loc.offset (.word (.lit n) P) ∧ P.ghost = false ∧
        IniAt E.ini c m.loc (.word (.lit n) P) ∧ pwf P = true ∧ ∃ v, m.val = .num v ∧ InP P v) ∧
      ∀ t' m', t' ∉ s.promises → s.mem[t']? = some m' → m'.loc = m.loc → t' < t)
    (hfp : E'.fp = E.fp)
    (hfpl : ∀ t m, t ∈ E.fp → s.mem[t]? = some m → Vis E' m.loc.label → Vis E m.loc.label)
    (hq : ∀ a : Address, PredU E' a ↔ PredU E a)
    (htid : E'.tid = E.tid := by first | rfl | assumption)
    (hbx : ∀ l B, E.box l = some B → E'.box l = some B := by first | exact fun _ _ h => h | assumption)
    (hri : ∀ l, E'.rini l = E.rini l := by first | exact fun _ => rfl | assumption) :
    ∃ H' cr' db', MemHeld E' s H' ∧ PromCr E' s cr' db' ∧
      (∀ t m, t ∈ s.promises → s.mem[t]? = some m → ¬ (VisU E' m.loc ∧ ¬ VisU E m.loc) →
        cr' t = cr t ∧ db' t = db t) ∧
      H' + pSum s cr' + pSum s db = H + pSum s cr + pSum s db' := by
  have hWU : ∀ b, VisU E' b → WordUnit E b := fun b h => (WordUnit_congr (hs b.label)).1 h.1
  have hVE : ∀ b, VisU E b → VisU E' b := fun b h => ⟨(WordUnit_congr (hs b.label)).2 h.1, hmono _ h.2⟩
  have hFL : ∀ t m, t ∈ s.promises → s.mem[t]? = some m → VisU E' m.loc → ¬ VisU E m.loc →
      FlipT E E' s t := fun t m ht hm h1 h2 => ⟨ht, m, hm, h1, h2⟩
  have hFLat : ∀ t m, FlipT E E' s t → s.mem[t]? = some m → VisU E' m.loc ∧ ¬ VisU E m.loc := by
    rintro t m ⟨-, m', hm', h1, h2⟩ hm
    obtain rfl : m' = m := Option.some.inj (hm'.symm.trans hm)
    exact ⟨h1, h2⟩
  have hdF : ∀ t, t ∈ E.fp → ¬ FlipT E E' s t := by
    rintro t ht ⟨-, m, hm, h1, h2⟩
    exact h2 ⟨hWU _ h1, hfpl t m ht hm h1.2⟩
  have key : ∀ k, ∃ Hk crk dbk, MemHeld E (flipSt E E' s k) Hk ∧
      (∀ t, ¬ (t < k ∧ FlipT E E' s t) → crk t = cr t ∧ dbk t = db t) ∧
      (∀ t m, t < k → FlipT E E' s t → s.mem[t]? = some m → DbRes E' s.mem m t (dbk t) ∧
        ((∃ w, PredAt s.mem m.loc t w ∧ VRes E' m.loc w (crk t)) ∨
          ((∀ w, ¬ PredAt s.mem m.loc t w) ∧ crk t = .zero))) ∧
      Hk + pSum s crk + pSum s db = H + pSum s cr + pSum s dbk := by
    intro k
    induction k with
    | zero =>
      refine ⟨H, cr, db, MemHeld_tr hH (fun _ => rfl) (fun _ => rfl)
        (fun l o w hl => LatestNP_congrP (fun t m _ _ => ?_) hl) id, fun t _ => ⟨rfl, rfl⟩,
        fun t m h => absurd h (Nat.not_lt_zero _), rfl⟩
      rw [flip_at hdF]
      exact ⟨fun h => ⟨h, fun h' => Nat.not_lt_zero _ h'.1⟩, fun h => h.1⟩
    | succ k ih =>
      obtain ⟨Hk, crk, dbk, hHk, hag, hent, heq⟩ := ih
      by_cases hk : FlipT E E' s k
      · obtain ⟨hkp, m, hm, hv1, hv2⟩ := id hk
        have hz : ∀ R w, VRes E m.loc w R → R = .zero := fun R w h =>
          h.elim (fun h1 => absurd ⟨hWU _ hv1, h1.1⟩ hv2) (fun h1 => h1.2)
        obtain ⟨m1, hm1, hd0, hc0⟩ := hC k hkp
        obtain rfl : m1 = m := Option.some.inj (hm1.symm.trans hm)
        have hcr0 : cr k = .zero := hc0.elim (fun ⟨_, _, h⟩ => hz _ _ h) (fun h => h.2)
        have hdb0 : db k = .zero :=
          (DbRes_nvisU (fun h => h.elim hv2 (fun h => hv2 ⟨hWU _ hv1, PredU_vis h.1⟩))).1 hd0
        obtain ⟨e1, e2⟩ := hag k (fun h => Nat.lt_irrefl _ h.1)
        have hmemA : ∀ j t m', s.mem[t]? = some m' → m'.loc = m1.loc →
            (t ∈ (flipSt E E' s j).promises ↔ t ∈ s.promises ∧ ¬ t < j) := by
          intro j t m' hm' hl
          rw [mem_flipSt]
          constructor
          · rintro ⟨h1, h2⟩
            exact ⟨h1, fun h => h2 ⟨h, hFL t m' h1 hm' (by rw [hl]; exact hv1) (by rw [hl]; exact hv2)⟩⟩
          · rintro ⟨h1, h2⟩; exact ⟨h1, fun h => h2 h.1⟩
        have hPA : ∀ j, PromAt E (flipSt E E' s j) m1.loc = (flipSt E E' s j).promises := fun j =>
          PromAt_nwordP hv2 (fun h => hv2 ⟨hWU _ hv1, PredU_vis h⟩) (FpAt_priv fun h => hv2 ⟨hWU _ hv1, h⟩)
        have hkeep : ∀ b w, b ≠ m1.loc → LatestNP (flipSt E E' s k).mem (PromAt E (flipSt E E' s k) b) b w →
            LatestNP (flipSt E E' s (k + 1)).mem (PromAt E (flipSt E E' s (k + 1)) b) b w := by
          intro b w hb hl
          refine LatestNP_congrP (fun t m' hm' hl' => ?_) hl
          rw [flip_at hdF, flip_at hdF]
          have htk : t ≠ k := fun e => by
            subst e
            obtain rfl : m1 = m' := Option.some.inj (hm.symm.trans hm')
            exact hb hl'.symm
          exact and_congr_right fun _ => not_congr ⟨fun h => ⟨Nat.lt_succ_of_lt h.1, h.2⟩,
            fun h => ⟨Nat.lt_of_le_of_ne (Nat.le_of_lt_succ h.1) htk, h.2⟩⟩
        by_cases hIW : ¬ IniW E m1.loc
        · -- (S7f α) an uninitialised buffer slot: nothing moves
          obtain ⟨c, N, e, us, hsto, hT, hus, hge⟩ : ∃ c N e us, E.sto m1.loc.label = some c ∧
              c.ty = .array (.lit N) e ∧ accs e = some us ∧ E.ini m1.loc.label * nWords us ≤ m1.loc.offset :=
            Classical.byContradiction fun hno =>
              hIW fun c N e us h1 h2 h3 => Nat.lt_of_not_le fun h4 => hno ⟨c, N, e, us, h1, h2, h3, h4⟩
          have hl1 : ∃ w1, LatestNP (flipSt E E' s (k + 1)).mem (PromAt E (flipSt E E' s (k + 1)) m1.loc) m1.loc w1 := by
            rw [hPA]
            exact LatestNP_ex hm rfl (fun h => ((hmemA (k + 1) k m1 hm rfl).1 h).2 (Nat.lt_succ_self k))
          have hH' := held_uninit hHk hsto hT hus hge hl1 hkeep
          have hnI' : ¬ IniW E' m1.loc := fun h => hIW ((IniW_congr (hs _) (hi _)).1 h)
          refine ⟨Hk, crk, dbk, hH', fun t ht => hag t fun h => ht ⟨Nat.lt_succ_of_lt h.1, h.2⟩,
            fun t m' ht hf hm' => ?_, heq⟩
          by_cases htk : t = k
          · subst htk
            obtain rfl : m1 = m' := Option.some.inj (hm.symm.trans hm')
            rw [e1, e2, hcr0, hdb0]
            refine ⟨(DbRes_uninit hnI').2 rfl, ?_⟩
            by_cases hp : ∃ w, PredAt s.mem m1.loc t w
            · obtain ⟨w, hw'⟩ := hp; exact Or.inl ⟨w, hw', (VRes_uninit hnI').2 rfl⟩
            · exact Or.inr ⟨fun w hw' => hp ⟨w, hw'⟩, rfl⟩
          · exact hent t m' (Nat.lt_of_le_of_ne (Nat.le_of_lt_succ ht) htk) hf hm'
        have hIW : IniW E m1.loc := Classical.byContradiction hIW
        obtain ⟨⟨c, n, P, hsto, hat, hg, hini, hp, v, hval, hinP⟩, hab⟩ := hw k m1 hkp hm hv1 hv2 hIW
        obtain ⟨w0, hl0⟩ := held_lat hHk hsto hat hg hini
        have hl0' := hl0
        rw [hPA] at hl0'
        obtain ⟨t0, m0, ht0, hm0, hl0a, hw0, hlast0⟩ := hl0'
        have ht0k : t0 < k := by
          by_cases hp0 : t0 ∈ s.promises
          · exact Nat.lt_of_not_le fun h => ht0 ((hmemA k t0 m0 hm0 hl0a).2 ⟨hp0, Nat.not_lt.2 h⟩)
          · exact hab t0 m0 hp0 hm0 hl0a
        have hpred : PredAt s.mem m1.loc k w0 := ⟨t0, m0, ht0k, hm0, hl0a, hw0,
          fun t' m' h1 h2 hm' hl' => ((hmemA k t' m' hm' hl').1 (hlast0 t' m' h1 hm' hl')).2 h2⟩
        have hl1 : LatestNP (flipSt E E' s (k + 1)).mem (PromAt E (flipSt E E' s (k + 1)) m1.loc) m1.loc (mw m1) := by
          rw [hPA]
          refine ⟨k, m1, fun h => ((hmemA (k + 1) k m1 hm rfl).1 h).2 (Nat.lt_succ_self k), hm, rfl, rfl,
            fun t' m' h1 hm' hl' => ?_⟩
          by_cases hp' : t' ∈ s.promises
          · exact (hmemA (k + 1) t' m' hm' hl').2 ⟨hp', fun h => Nat.lt_irrefl _ (Nat.lt_of_lt_of_le h1 (Nat.le_of_lt_succ h))⟩
          · exact absurd (hab t' m' hp' hm' hl') (Nat.lt_asymm h1)
        obtain ⟨H', hH', heqH⟩ := heldWord (s := flipSt E E' s k) (s' := flipSt E E' s (k + 1)) hHk hsto hat hg hini hp
          hl0 hl1 ⟨v, hval, hinP⟩ hkeep
        have hnIk : ¬ InitAt s.mem m1.loc k := fun h => held_nundef hHk hsto hat hg hini hl0 (h w0 hpred)
        have hWA : WordAt E' m1.loc n P := ⟨c, by rw [hs]; exact hsto, hat, hg⟩
        refine ⟨H', fun t => if t = k then wr P n w0.val else crk t,
          fun t => if t = k then wr P n (mw m1).val else dbk t, hH', fun t ht => ?_, fun t m' ht hf hm' => ?_, ?_⟩
        · have htk : t ≠ k := fun e => ht ⟨by rw [e]; exact Nat.lt_succ_self k, by rw [e]; exact hk⟩
          simp only [htk, ↓reduceIte]
          exact hag t fun h => ht ⟨Nat.lt_succ_of_lt h.1, h.2⟩
        · by_cases htk : t = k
          · subst htk
            obtain rfl : m1 = m' := Option.some.inj (hm.symm.trans hm')
            simp only [↓reduceIte]
            have hIW' : IniW E' m1.loc := (IniW_congr (hs _) (hi _)).2 hIW
            exact ⟨(DbRes_nInit hnIk).2 ((VRes_vis hv1.2 hIW').2 (WRes_wr hWA _)),
              Or.inl ⟨w0, hpred, (VRes_vis hv1.2 hIW').2 (WRes_wr hWA _)⟩⟩
          · simp only [htk, ↓reduceIte]
            exact hent t m' (Nat.lt_of_le_of_ne (Nat.le_of_lt_succ ht) htk) hf hm'
        · rw [pSum_upd0 hnd hkp (by rw [e1, hcr0]), pSum_upd0 hnd hkp (by rw [e2, hdb0])]
          exact Res.ext fun i => by
            have h1 := congrArg (fun R : Res => R i) heq
            have h2 := congrArg (fun R : Res => R i) heqH
            simp only [Res.add_apply] at h1 h2 ⊢
            omega
      · refine ⟨Hk, crk, dbk, MemHeld_tr hHk (fun _ => rfl) (fun _ => rfl)
          (fun l o w hl => LatestNP_congrP (fun t m' _ _ => ?_) hl) id,
          fun t ht => hag t (fun h => ht ⟨Nat.lt_succ_of_lt h.1, h.2⟩),
          fun t m' ht hf hm' => hent t m' (Nat.lt_of_le_of_ne (Nat.le_of_lt_succ ht) (fun e => hk (e ▸ hf))) hf hm',
          heq⟩
        rw [flip_at hdF, flip_at hdF]
        exact and_congr_right fun _ => not_congr
          ⟨fun h => ⟨Nat.lt_succ_of_lt h.1, h.2⟩,
            fun h => ⟨Nat.lt_of_le_of_ne (Nat.le_of_lt_succ h.1) (fun e => hk (e ▸ h.2)), h.2⟩⟩
  obtain ⟨HN, crN, dbN, hHN, hag, hent, heq⟩ := key s.mem.size
  have hnFL : ∀ t m, t ∈ s.promises → s.mem[t]? = some m → ¬ (VisU E' m.loc ∧ ¬ VisU E m.loc) →
      ¬ FlipT E E' s t := fun t m _ hm hn hf => hn (hFLat t m hf hm)
  refine ⟨HN, crN, dbN, MemHeld_trP hHN hs hi (fun l o w hl => LatestNP_congrP (fun t m hm hloc => ?_) hl) hv,
    fun t ht => ?_, fun t m ht hm hn => hag t fun h => hnFL t m ht hm hn h.2, heq⟩
  · rw [flip_at hdF]
    by_cases hF : VisU E' ⟨l, o⟩ ∧ ¬ VisU E ⟨l, o⟩
    · rw [PromAt_word hF.1, PromAt_nword hF.2 (fun h => hF.2 ⟨hWU _ hF.1, PredU_vis h⟩),
        FpAt_priv (a := ⟨l, o⟩) (fun h => hF.2 ⟨hWU _ hF.1, h⟩),
        List.append_nil]
      refine ⟨fun ⟨hp, hn⟩ => absurd ⟨hPb t hp, hFL t m hp hm (by rw [hloc]; exact hF.1)
        (by rw [hloc]; exact hF.2)⟩ hn, fun h => by cases h⟩
    · by_cases hV : VisU E ⟨l, o⟩
      · rw [PromAt_word hV, PromAt_word (hVE _ hV)]
        exact ⟨fun h => h.1, fun h => by cases h⟩
      · have hV' : ¬ VisU E' ⟨l, o⟩ := fun h => hF ⟨h, hV⟩
        have hFp : t ∈ FpAt E ⟨l, o⟩ ↔ t ∈ FpAt E' ⟨l, o⟩ := by
          by_cases hv0 : Vis E l
          · rw [FpAt_vis (a := ⟨l, o⟩) hv0, FpAt_vis (a := ⟨l, o⟩) (hmono _ hv0), hfp]
          · rw [FpAt_priv (a := ⟨l, o⟩) hv0]
            constructor
            · intro h; cases h
            · intro h
              by_cases hv1 : Vis E' l
              · rw [FpAt_vis (a := ⟨l, o⟩) hv1, hfp] at h
                exact absurd (hfpl t m h hm (by rw [hloc]; exact hv1)) (by rw [hloc]; exact hv0)
              · rw [FpAt_priv (a := ⟨l, o⟩) hv1] at h; cases h
        by_cases hqE : PredU E ⟨l, o⟩
        · rw [mem_PromAt_pred hV hqE, mem_PromAt_pred hV' ((hq _).2 hqE), List.mem_append, List.mem_append]
          constructor
          · rintro ⟨⟨h, ha⟩, -⟩; exact ⟨h.imp id hFp.1, ha⟩
          · rintro ⟨h, ha⟩
            refine ⟨⟨h.imp id hFp.2, ha⟩, fun h' => hF ?_⟩
            have := hFLat t m h'.2 hm; rw [hloc] at this; exact this
        rw [PromAt_nword hV hqE, PromAt_nword hV' (fun h => hqE ((hq _).1 h)), List.mem_append, List.mem_append]
        constructor
        · rintro ⟨h, -⟩; exact h.imp id hFp.1
        · intro h
          refine ⟨h.imp id hFp.2, fun h' => hF ?_⟩
          have := hFLat t m h'.2 hm; rw [hloc] at this; exact this
  · obtain ⟨m, hm, hd, hc⟩ := hC t ht
    by_cases hf : FlipT E E' s t
    · obtain ⟨h1, h2⟩ := hent t m (hPb t ht) hf hm
      exact ⟨m, hm, h1, h2⟩
    · obtain ⟨e1, e2⟩ := hag t fun h => hf h.2
      have hn : ¬ (VisU E' m.loc ∧ ¬ VisU E m.loc) := fun h => hf (hFL t m ht hm h.1 h.2)
      rw [e1, e2]
      refine ⟨m, hm, DbRes_nfu (hs _) (hi _) (hmono _) hn hd (hq _) htid hbx, ?_⟩
      rcases hc with ⟨w, hw', hcw⟩ | ⟨hnw, hcz⟩
      · exact Or.inl ⟨w, hw', VRes_nfu (hs _) (hi _) (hmono _) hn hcw⟩
      · exact Or.inr ⟨hnw, hcz⟩

/-- (S7c) **The flip's side condition at label `l`** (the `hwu` of
`promise_acct`, for the promises a frontier at `l` makes visible): if `l` is
private, each own promise at one of its word units is at a non-ghost `.word`
of a literal region, initialised, of a well-formed protocol, and holds one of
its states.  (S7f α) Only at initialised addresses (`IniW`): a promise at an
uninitialised buffer slot is accounted as the slot's initialisation, at its
fulfilment, and needs nothing at the flip (`MemHeld_flip`). -/
def FlipOK (E : TEnv) (s : St) (l : AllocLabel) : Prop :=
  Priv E l → ∀ t m, t ∈ s.promises → s.mem[t]? = some m → m.loc.label = l → WordUnit E m.loc → IniW E m.loc →
    ∃ c n P, E.sto l = some c ∧ AtOff c.ty m.loc.offset (.word (.lit n) P) ∧ P.ghost = false ∧
      IniAt E.ini c m.loc (.word (.lit n) P) ∧ pwf P = true ∧ ∃ v, m.val = .num v ∧ InP P v

/-- **(S7c) The flip at one label `l`** (publish, plant): `E'` differs from
`E` only in making `l` visible.  `MemHeld_flip`, its side condition from
`FlipOK` and the own cell's coherence tail (`own_tailW`, `PromAbove`). -/
theorem MemHeld_flipL {g : G} {E E' : TEnv} {s : St} {H : Res} {cr db : Ts → Res} {l : AllocLabel}
    (hm : MemInv g E s) (hH : MemHeld E s H) (hC : PromCr E s cr db) (hpa : PromAbove s)
    (hs : ∀ l, E'.sto l = E.sto l) (hi : ∀ l, E'.ini l = E.ini l)
    (hmono : ∀ l, Vis E l → Vis E' l) (hl : ∀ l', l' ≠ l → Vis E' l' → Vis E l')
    (hv : ∀ {T : Ty} {vs : List Word} {R : Res}, ValOfR E T vs R → ValOfR E' T vs R)
    (hf : FlipOK E s l) (hfo : FpOK E s)
    (hol : OwnL E l) (hpm : ∀ l', E.pfr l' ≠ none → E'.pfr l' ≠ none)
    (hpo : ∀ l', l' ≠ l → E'.pfr l' ≠ none → E.pfr l' ≠ none)
    (hfp : E'.fp = E.fp := by first | rfl | assumption)
    (hri : ∀ l, E'.rini l = E.rini l := by first | exact fun _ => rfl | assumption)
    (htid : E'.tid = E.tid := by first | rfl | assumption)
    (hbx : ∀ l B, E.box l = some B → E'.box l = some B := by first | exact fun _ _ h => h | assumption) :
    ∃ H' cr' db', MemHeld E' s H' ∧ PromCr E' s cr' db' ∧
      H' + pSum s cr' + pSum s db = H + pSum s cr + pSum s db' := by
  -- (U3) the flip creates no predicted unit: a private cell has no planted count
  have hq : ∀ a : Address, PredU E' a ↔ PredU E a := fun a => by
    have hrc' : E'.rc a.label = E.rc a.label := TEnv.rc_congr (hi _) (hri _)
    unfold PredU
    rw [IniW_congrU (hs _) (hi _), IniWr_congr (hs _) hrc']
    by_cases hv0 : E.pfr a.label = none
    · refine ⟨fun h => absurd h ?_, fun h => absurd hv0 h.1⟩
      rintro ⟨hpf', hiw, hnr⟩
      have hle : a.label = l := Classical.byContradiction fun hne => hpo _ hne hpf' hv0
      obtain ⟨c, hc, hown⟩ := hol
      rw [← hle] at hc
      have hrc : E.ini a.label ≤ E.rc a.label := Nat.le_of_not_lt fun hlt => by
        obtain ⟨f, hf, -⟩ := hm.2.2.2.2.2.1.2 _ c hc hown hlt
        rw [hv0] at hf; cases hf
      exact hnr fun c' N e us hc' hT hu =>
        Nat.lt_of_lt_of_le (hiw c' N e us hc' hT hu) (Nat.mul_le_mul_right _ hrc)
    · exact ⟨fun h => ⟨hv0, h.2⟩, fun h => ⟨hpm _ hv0, h.2⟩⟩
  obtain ⟨H', cr', db', h1, h2, -, h3⟩ := MemHeld_flip hH hC (MemInv_promLt hm) (hm.2.2.2.2.2.2.2.2.2.2.1 : s.promises.Nodup) hs hi hmono hv
    (fun t m ht hm' hv1 hv2 hIW => by
      have hwu : WordUnit E m.loc := (WordUnit_congr (hs _)).1 hv1.1
      have hpv : Priv E m.loc.label := Classical.byContradiction fun h => hv2 ⟨hwu, h⟩
      have hle : m.loc.label = l := Classical.byContradiction fun h => hl _ h hv1.2 hpv
      obtain ⟨c, n, P, hsto, hat, hg, hini, hp, hin⟩ := hf (by rw [← hle]; exact hpv) t m ht hm' hle hwu hIW
      rw [← hle] at hsto
      obtain ⟨⟨c', hc', hown⟩, hpf0⟩ := hpv
      rw [hsto] at hc'
      obtain rfl : c = c' := Option.some.inj hc'
      refine ⟨⟨c, n, P, hsto, hat, hg, hini, hp, hin⟩, fun t' m' ht' hm'' hl' => ?_⟩
      -- a cell without a frontier has no planted count (`OwnHidP`'s second part)
      have hrc : E.ini m.loc.label ≤ E.rc m.loc.label := Nat.le_of_not_lt fun hlt => by
        obtain ⟨f, hf, -⟩ := hm.2.2.2.2.2.1.2 _ c hsto hown hlt
        rw [hpf0] at hf; cases hf
      have htail := own_tailW (OwnOKPF_cellP hm.2.1 hsto hown hpf0) hsto hat hg (IniAt_monoAt hrc hini)
      have h1 := hpa t ht m hm'
      by_cases hlt : s.vs.coh m.loc < t'
      · exact absurd (htail t' m' hlt hm'' hl') ht'
      · exact Nat.lt_of_le_of_lt (Nat.le_of_not_lt hlt) h1) hfp (fun t m ht hm _ => hfo.2 t m ht hm) hq
  exact ⟨H', cr', db', h1, h2, h3⟩

/-- **(S7c) The flip at a plant** (`MemInv_plant`'s view change: `l`, a
private cell, gets the frontier `s.vs.vWr`).  ThInvMC-level plant: S7d. -/
theorem MemHeld_plant {g : G} {E E' : TEnv} {s : St} {H : Res} {cr db : Ts → Res} {l : AllocLabel}
    (hm : MemInv g E s) (hH : MemHeld E s H) (hC : PromCr E s cr db) (hpa : PromAbove s)
    (hnone : E.pfr l = none)
    (hp : E.prog = E'.prog) (ht : E.tid = E'.tid) (hs : E'.sto = E.sto) (hi : E'.ini = E.ini)
    (hP : E'.pfr = fun l' => if l' = l then some s.vs.vWr else E.pfr l')
    (hbx : ∀ l B, E.box l = some B → E'.box l = some B) (hf : FlipOK E s l) (hfo : FpOK E s)
    (hfp : E'.fp = E.fp) (hol : OwnL E l)
    (hri : ∀ l, E'.rini l = E.rini l := by first | exact fun _ => rfl | assumption) :
    ∃ H' cr' db', MemHeld E' s H' ∧ PromCr E' s cr' db' ∧
      H' + pSum s cr' + pSum s db = H + pSum s cr + pSum s db' := by
  have hpf : ∀ l', l' ≠ l → E'.pfr l' = E.pfr l' := fun l' h => by rw [hP]; simp [h]
  have hrile : ∀ l, E.rini l ≤ E'.rini l := fun l => by rw [hri l]; exact Nat.le_refl _
  refine MemHeld_flipL hm hH hC hpa (fun l => by rw [hs]) (fun l => by rw [hi]) (fun l' hv hpv => hv ?_)
    (fun l' hne hv hpv => hv ⟨?_, by rw [hpf l' hne]; exact hpv.2⟩)
    (fun h => ValOfR_mono hp ht (fun l c h => by rw [hs]; exact h) (fun l => by rw [hi]; exact Nat.le_refl _) h
      (fun l' f h => by
        rw [hP]
        by_cases he : l' = l
        · subst he; rw [hnone] at h; cases h
        · simp [he, h]) hbx) hf hfo hol
    (fun l' h => by rw [hP]; by_cases he : l' = l <;> simp [he, h])
    (fun l' hne h => by rw [hpf l' hne] at h; exact h) hfp hri ht.symm hbx
  · obtain ⟨⟨c, h1, h2⟩, h3⟩ := hpv
    refine ⟨⟨c, by rw [← hs]; exact h1, by rw [ht]; exact h2⟩, ?_⟩
    by_cases he : l' = l
    · subst he; exact hnone
    · rw [← hpf l' he]; exact h3
  · obtain ⟨⟨c, h1, h2⟩, -⟩ := hpv
    exact ⟨c, by rw [hs]; exact h1, by rw [← ht]; exact h2⟩

/-- **(S7c) The flip at `publish`** (`pubP`: `lab` gets a frontier if it had
none). -/
theorem MemHeld_pub {g : G} {η : TEnv} {s : St} {H : Res} {cr db : Ts → Res} {lab : AllocLabel} {V : Ts}
    {S : AllocLabel → Prop}
    (hm : MemInv g (CE η) s) (hH : MemHeld (CE η) s H) (hC : PromCr (CE η) s cr db) (hpa : PromAbove s)
    (hf : FlipOK (CE η) s lab) (hfo : FpOK (CE η) s) (hol : OwnL (CE η) lab) :
    ∃ H' cr' db', MemHeld (CE (η.withSto η.sto η.ini (pubP η lab V) S)) s H' ∧
      PromCr (CE (η.withSto η.sto η.ini (pubP η lab V) S)) s cr' db' ∧
      H' + pSum s cr' + pSum s db = H + pSum s cr + pSum s db' := by
  refine MemHeld_flipL hm hH hC hpa (fun _ => rfl) (fun _ => rfl) (fun l' hv hpv => hv ⟨hpv.1, ?_⟩)
    (fun l' hne hv hpv => hv ⟨hpv.1, ?_⟩)
    (fun h => ValOfR_mono (η₁ := CE η) (η₂ := CE (η.withSto η.sto η.ini (pubP η lab V) S))
      rfl rfl (fun _ _ h => h) (fun _ => Nat.le_refl _) h (pubP_mono η lab _) (fun _ _ h => h)) hf hfo hol
    (fun l' h h0 => h (by
      have h0' : pubP η lab V l' = none := h0
      show η.pfr l' = none
      cases e : η.pfr l' with
      | none => rfl
      | some f => rw [pubP_mono η lab V l' f e] at h0'; cases h0'))
    (fun l' hne h h0 => h (by
      show pubP η lab V l' = none
      simp only [pubP, hne, ↓reduceIte]; exact h0))
  · have h2 : pubP η lab V l' = none := hpv.2
    cases h : η.pfr l' with
    | none => exact h
    | some f => rw [pubP_mono η lab V l' f h] at h2; cases h2
  · show pubP η lab V l' = none
    have h2 : η.pfr l' = none := hpv.2
    simp only [pubP, hne, ↓reduceIte]; exact h2

theorem MemHeldL_trP {E E' : TEnv} {s s' : St} {H : Res} {S : AllocLabel → List Res} (h : MemHeldL E s H S)
    (hsto : ∀ l, E'.sto l = E.sto l) (hini : ∀ l, E'.ini l = E.ini l)
    (hlat : ∀ l o w, LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w → LatestNP s'.mem (PromAt E' s' ⟨l, o⟩) ⟨l, o⟩ w)
    (hv : ∀ {T : Ty} {vs : List Word} {R : Res}, ValOfR E T vs R → ValOfR E' T vs R)
    (hri : ∀ l, E'.rini l = E.rini l := by first | exact fun _ => rfl | assumption) :
    MemHeldL E' s' H S := by
  obtain ⟨L, hnd, hcov, hoff, rfl, hent⟩ := h
  exact ⟨L, hnd, fun l c hc => hcov l c (by rw [← hsto l]; exact hc), hoff, rfl,
    fun l hl => HeldEntryL_tr (hent l hl) (hsto l) (hini l) (hri l) (hlat l) hv⟩
#print axioms MemHeldL_trP

/-- (H, pins) Lists kept at every label with a predicted unit, after one more label without one changed. -/
theorem KeepP_upd {E : TEnv} {S Sk S' : AllocLabel → List Res} {L : AllocLabel}
    (hk : ∀ l, (∀ o, ¬ PredU E ⟨l, o⟩) ∨ Sk l = S l) (h2 : ∀ l', l' ≠ L → S' l' = Sk l')
    (hnp : ∀ o, ¬ PredU E ⟨L, o⟩) : ∀ l, (∀ o, ¬ PredU E ⟨l, o⟩) ∨ S' l = S l := fun l => by
  by_cases e : l = L
  · subst e; exact Or.inl hnp
  · rcases hk l with h | h
    · exact Or.inl h
    · exact Or.inr (by rw [h2 l e, h])
#print axioms KeepP_upd

theorem SKeep_ofKeepP {E : TEnv} {S S' : AllocLabel → List Res}
    (h : ∀ l, (∀ o, ¬ PredU E ⟨l, o⟩) ∨ S' l = S l) : SKeep E S S' :=
  fun l _ _ _ _ _ _ _ _ _ hj hR => (h l).elim (fun h => absurd hj (h _)) (fun h => by rw [h]; exact hR)
#print axioms SKeep_ofKeepP

/-- `heldWord` with slot lists: only the word's label's list changes. -/
theorem heldWordA {E : TEnv} {s s' : St} {H : Res} {Sl : AllocLabel → List Res} {a : Address} {c : Cell} {n : Nat} {P : Proto}
    {w0 w1 : Word}
    (hH : MemHeldL E s H Sl) (hsto : E.sto a.label = some c) (hat : AtOff c.ty a.offset (.word (.lit n) P))
    (hg : P.ghost = false) (hini : IniAt E.ini c a (.word (.lit n) P)) (hp : pwf P = true)
    (hl0 : LatestNP s.mem (PromAt E s a) a w0) (hl1 : LatestNP s'.mem (PromAt E s' a) a w1)
    (hin : ∃ v, w1.val = .num v ∧ InP P v)
    (hkeep : ∀ b w, b ≠ a → LatestNP s.mem (PromAt E s b) b w → LatestNP s'.mem (PromAt E s' b) b w) :
    ∃ H', (∃ S', MemHeldL E s' H' S' ∧ ∀ l', l' ≠ a.label → S' l' = Sl l') ∧ H' + wr P n w0.val = H + wr P n w1.val := by
  obtain ⟨R0, H0, rfl, hent0, hX⟩ := MemHeldL_focusE hH a.label
  obtain ⟨vals, hL, hC⟩ := hent0.2 c hsto
  obtain ⟨b, o, S, wS, Rs, Rr, -, hbo, hatS, hwS, hbw, hR0, ⟨hvs, hVs⟩, hput⟩ :=
    (own_segR hC hat hini (fun N e h => by cases h)).resolve_right (fun ⟨_, _, _, _, _, _, _, hz⟩ => by have h := hz _ (by simp [accs, hg] : accs (Ty.word (.lit n) P) = some [.one]); simp [nWords, Acc.size] at h)
  have hsl : ((vals.drop b).take wS).length = wS := by
    simp only [List.length_take, List.length_drop]; omega
  obtain ⟨n1, Rq, Rr2, hwn, hle, hRs, hvq, hput2⟩ := VRR_at E.unsee hatS hvs (by rw [hsl]; exact hwS)
  rw [wc_word hg] at hwn
  obtain rfl : 1 = n1 := Option.some.inj hwn
  rw [hsl] at hle
  have hlenv : a.offset + 1 ≤ vals.length := by
    rw [← hbo, Nat.add_assoc]; exact Nat.le_trans (Nat.add_le_add_left hle b) hbw
  have hvqe : (((vals.drop b).take wS).drop o).take 1 = (vals.drop a.offset).take 1 := by
    rw [take_drop_take hle, drop_drop', hbo]
  rw [hvqe] at hvq
  have hget : vals[a.offset]? = some vals[a.offset] := List.getElem?_eq_getElem (by omega)
  have hone : (vals.drop a.offset).take 1 = [vals[a.offset]] := by
    apply List.ext_getElem?; intro i
    rw [slice_get]
    by_cases hi : i < 1
    · rw [iteT hi]; obtain rfl : i = 0 := by omega
      simp only [Nat.add_zero, List.getElem?_cons_zero]; exact hget
    · rw [iteF hi]; simp; omega
  rw [hone] at hvq
  have ea : (⟨a.label, a.offset⟩ : Address) = a := rfl
  have hw0 : vals[a.offset] = w0 := by
    exact LatestNP_uniq (hL a.offset _ hget) hl0
  rw [hw0] at hvq
  have hRq := VRR_word_wr hvq
  -- the new word
  have hq := hput2 [w1] (wr P n w1.val + wdW P n) (VRR_word_of hp hin) rfl
  have hQV := (VR_put E.unsee hatS (VRR_VR S (RLink_of (Coh_CE _) (CohR_CE _)) hvs) hVs
    (by rw [hsl]; exact hwS) (VRR_VR _ (RLink_of (Coh_CE _) (CohR_CE _)) (VRR_word_of (ρ₀ := fun _ => 0)
      (η := CE E.unsee) (S := shp (.word (.lit n) P)) hp hin)) (by simp [Valid]) (wc_word hg)).2.2
  have hQl : (((vals.drop b).take wS).take o ++ [w1] ++ ((vals.drop b).take wS).drop (o + 1)).length = wS := by
    simp only [List.length_append, List.length_take, List.length_drop, List.length_singleton]; omega
  have hcell' := hput _ _ ⟨hq, hQV⟩ hQl
  have hsp := splice_seg vals [w1] b wS o (by simpa using hle)
  simp only [List.length_singleton] at hsp
  rw [hsp, hbo] at hcell'
  have hc2 : CellOKR E (E.ini a.label) (E.rc a.label) c.ty (vals.take a.offset ++ [w1] ++ vals.drop (a.offset + 1))
      (wr P n w1.val + wdW P n + Rr2 + Rr) := hcell'
  have hent : HeldEntry E s' a.label (wr P n w1.val + wdW P n + Rr2 + Rr) := by
    refine ⟨fun h => (by rw [hsto] at h; cases h), fun c3 hc3 => ?_⟩
    rw [hsto] at hc3; cases hc3
    refine ⟨vals.take a.offset ++ [w1] ++ vals.drop (a.offset + 1), fun (o' : Nat) w hw => ?_, hc2⟩
    rw [splice_get vals [w1] a.offset 1 o' rfl hlenv] at hw
    by_cases hr : a.offset ≤ o' ∧ o' < a.offset + 1
    · rw [iteT hr] at hw
      obtain rfl : o' = a.offset := Nat.le_antisymm (Nat.le_of_lt_succ hr.2) hr.1
      simp only [Nat.sub_self, List.getElem?_cons_zero, Option.some.injEq] at hw
      subst hw
      exact hl1
    · rw [iteF hr] at hw
      refine hkeep _ w (fun e => hr ?_) (hL o' w hw)
      have : o' = a.offset := by rw [← e]
      subst this; exact ⟨Nat.le_refl _, Nat.lt_succ_self _⟩
  have hX' : MemHeldXL E s' a.label H0 Sl := MemHeldXL_tr hX (fun _ _ => rfl) (fun _ _ => rfl)
    (fun l' hne o' w hl => hkeep _ w (fun e => hne (by rw [← e])) hl) id
  refine ⟨_, MemHeldL_unfocusAny hX' hent, Res.ext fun k => ?_⟩
  subst hR0; subst hRs; subst hRq
  simp only [Res.add_apply]; omega
#print axioms heldWordA

/-- `held_uninit` with slot lists. -/
theorem held_uninitA {E : TEnv} {s s' : St} {H : Res} {Sl : AllocLabel → List Res} {a : Address} {c : Cell} {N : Nat} {e : Ty} {us : List Acc}
    (hH : MemHeldL E s H Sl) (hsto : E.sto a.label = some c) (hT : c.ty = .array (.lit N) e) (hus : accs e = some us)
    (hge : E.ini a.label * nWords us ≤ a.offset)
    (hl1 : ∃ w1, LatestNP s'.mem (PromAt E s' a) a w1)
    (hkeep : ∀ b w, b ≠ a → LatestNP s.mem (PromAt E s b) b w → LatestNP s'.mem (PromAt E s' b) b w) :
    ∃ S', MemHeldL E s' H S' ∧ ∀ l', l' ≠ a.label → S' l' = Sl l' := by
  obtain ⟨R0, H0, rfl, hent0, hX⟩ := MemHeldL_focusE hH a.label
  obtain ⟨vals, hL, hC⟩ := hent0.2 c hsto
  obtain ⟨w1, hw1⟩ := hl1
  have hX' : MemHeldXL E s' a.label H0 Sl := MemHeldXL_tr hX (fun _ _ => rfl) (fun _ _ => rfl)
    (fun l' hne o' w hl => hkeep _ w (fun e => hne (by rw [← e])) hl) id
  refine MemHeldL_unfocusAny hX' ⟨(fun h => by rw [hsto] at h; cases h), fun c3 hc3 => ?_⟩
  rw [hsto] at hc3; cases hc3
  by_cases hlenv : a.offset + 1 ≤ vals.length
  · have hlen' : (vals.take a.offset ++ [w1] ++ vals.drop (a.offset + 1)).length = vals.length := by
      rw [List.length_append, List.length_append, List.length_take, Nat.min_eq_left (Nat.le_of_succ_le hlenv),
        List.length_singleton, List.length_drop]
      exact Nat.add_sub_of_le hlenv
    have hag : ∀ o, o < E.ini a.label * nWords us →
        (vals.take a.offset ++ [w1] ++ vals.drop (a.offset + 1))[o]? = vals[o]? := fun o ho => by
      rw [splice_get vals [w1] a.offset 1 o rfl hlenv,
        iteF (fun h => Nat.lt_irrefl _ (Nat.lt_of_lt_of_le ho (Nat.le_trans hge h.1)))]
    refine ⟨vals.take a.offset ++ [w1] ++ vals.drop (a.offset + 1), fun (o' : Nat) w hw => ?_,
      CellOKR_uninit hC hT hus hlen' hag⟩
    · rw [splice_get vals [w1] a.offset 1 o' rfl hlenv] at hw
      by_cases hr : a.offset ≤ o' ∧ o' < a.offset + 1
      · rw [iteT hr] at hw
        obtain rfl : o' = a.offset := Nat.le_antisymm (Nat.le_of_lt_succ hr.2) hr.1
        simp only [Nat.sub_self, List.getElem?_cons_zero, Option.some.injEq] at hw
        subst hw
        exact hw1
      · rw [iteF hr] at hw
        refine hkeep _ w (fun e => hr ?_) (hL o' w hw)
        have : o' = a.offset := by rw [← e]
        subst this; exact ⟨Nat.le_refl _, Nat.lt_succ_self _⟩
  · refine ⟨vals, fun o' w hw => hkeep _ w (fun e => ?_) (hL o' w hw), hC⟩
    have : o' = a.offset := by rw [← e]
    have hlt := (List.getElem?_eq_some_iff.1 hw).1
    exact hlenv (by rw [← this]; exact Nat.succ_le_of_lt hlt)
#print axioms held_uninitA

/-- `MemHeld_flip` with slot lists: every label with a predicted unit keeps its list. -/
theorem MemHeld_flipS {E E' : TEnv} {s : St} {H : Res} {S : AllocLabel → List Res} {cr db : Ts → Res}
    (hH : MemHeldL E s H S) (hC : PromCr E s cr db)
    (hPb : ∀ t, t ∈ s.promises → t < s.mem.size) (hnd : s.promises.Nodup)
    (hs : ∀ l, E'.sto l = E.sto l) (hi : ∀ l, E'.ini l = E.ini l)
    (hmono : ∀ l, Vis E l → Vis E' l)
    (hv : ∀ {T : Ty} {vs : List Word} {R : Res}, ValOfR E T vs R → ValOfR E' T vs R)
    (hw : ∀ t m, t ∈ s.promises → s.mem[t]? = some m → VisU E' m.loc → ¬ VisU E m.loc → IniW E m.loc →
      (∃ c n P, E.sto m.loc.label = some c ∧ AtOff c.ty m.loc.offset (.word (.lit n) P) ∧ P.ghost = false ∧
        IniAt E.ini c m.loc (.word (.lit n) P) ∧ pwf P = true ∧ ∃ v, m.val = .num v ∧ InP P v) ∧
      ∀ t' m', t' ∉ s.promises → s.mem[t']? = some m' → m'.loc = m.loc → t' < t)
    (hfp : E'.fp = E.fp)
    (hfpl : ∀ t m, t ∈ E.fp → s.mem[t]? = some m → Vis E' m.loc.label → Vis E m.loc.label)
    (hq : ∀ a : Address, PredU E' a ↔ PredU E a)
    (htid : E'.tid = E.tid := by first | rfl | assumption)
    (hbx : ∀ l B, E.box l = some B → E'.box l = some B := by first | exact fun _ _ h => h | assumption)
    (hri : ∀ l, E'.rini l = E.rini l := by first | exact fun _ => rfl | assumption) :
    ∃ H' cr' db', (∃ S', MemHeldL E' s H' S' ∧ SKeep E S S') ∧ PromCr E' s cr' db' ∧
      (∀ t m, t ∈ s.promises → s.mem[t]? = some m → ¬ (VisU E' m.loc ∧ ¬ VisU E m.loc) →
        cr' t = cr t ∧ db' t = db t) ∧
      H' + pSum s cr' + pSum s db = H + pSum s cr + pSum s db' := by
  have hWU : ∀ b, VisU E' b → WordUnit E b := fun b h => (WordUnit_congr (hs b.label)).1 h.1
  have hVE : ∀ b, VisU E b → VisU E' b := fun b h => ⟨(WordUnit_congr (hs b.label)).2 h.1, hmono _ h.2⟩
  have hFL : ∀ t m, t ∈ s.promises → s.mem[t]? = some m → VisU E' m.loc → ¬ VisU E m.loc →
      FlipT E E' s t := fun t m ht hm h1 h2 => ⟨ht, m, hm, h1, h2⟩
  have hFLat : ∀ t m, FlipT E E' s t → s.mem[t]? = some m → VisU E' m.loc ∧ ¬ VisU E m.loc := by
    rintro t m ⟨-, m', hm', h1, h2⟩ hm
    obtain rfl : m' = m := Option.some.inj (hm'.symm.trans hm)
    exact ⟨h1, h2⟩
  have hdF : ∀ t, t ∈ E.fp → ¬ FlipT E E' s t := by
    rintro t ht ⟨-, m, hm, h1, h2⟩
    exact h2 ⟨hWU _ h1, hfpl t m ht hm h1.2⟩
  have key : ∀ k, ∃ Hk crk dbk, (∃ Sk, MemHeldL E (flipSt E E' s k) Hk Sk ∧ ∀ l, (∀ o, ¬ PredU E ⟨l, o⟩) ∨ Sk l = S l) ∧
      (∀ t, ¬ (t < k ∧ FlipT E E' s t) → crk t = cr t ∧ dbk t = db t) ∧
      (∀ t m, t < k → FlipT E E' s t → s.mem[t]? = some m → DbRes E' s.mem m t (dbk t) ∧
        ((∃ w, PredAt s.mem m.loc t w ∧ VRes E' m.loc w (crk t)) ∨
          ((∀ w, ¬ PredAt s.mem m.loc t w) ∧ crk t = .zero))) ∧
      Hk + pSum s crk + pSum s db = H + pSum s cr + pSum s dbk := by
    intro k
    induction k with
    | zero =>
      refine ⟨H, cr, db, ⟨S, MemHeldL_tr hH (fun _ => rfl) (fun _ => rfl)
        (fun l o w hl => LatestNP_congrP (fun t m _ _ => ?_) hl) id, fun _ => Or.inr rfl⟩, fun t _ => ⟨rfl, rfl⟩,
        fun t m h => absurd h (Nat.not_lt_zero _), rfl⟩
      rw [flip_at hdF]
      exact ⟨fun h => ⟨h, fun h' => Nat.not_lt_zero _ h'.1⟩, fun h => h.1⟩
    | succ k ih =>
      obtain ⟨Hk, crk, dbk, ⟨Sk, hHk, hSk⟩, hag, hent, heq⟩ := ih
      by_cases hk : FlipT E E' s k
      · obtain ⟨hkp, m, hm, hv1, hv2⟩ := id hk
        have hz : ∀ R w, VRes E m.loc w R → R = .zero := fun R w h =>
          h.elim (fun h1 => absurd ⟨hWU _ hv1, h1.1⟩ hv2) (fun h1 => h1.2)
        obtain ⟨m1, hm1, hd0, hc0⟩ := hC k hkp
        obtain rfl : m1 = m := Option.some.inj (hm1.symm.trans hm)
        have hnpL : ∀ o, ¬ PredU E ⟨m1.loc.label, o⟩ := fun o h => hv2 ⟨hWU _ hv1, (PredU_vis (a := ⟨m1.loc.label, o⟩) h : Vis E m1.loc.label)⟩
        have hcr0 : cr k = .zero := hc0.elim (fun ⟨_, _, h⟩ => hz _ _ h) (fun h => h.2)
        have hdb0 : db k = .zero :=
          (DbRes_nvisU (fun h => h.elim hv2 (fun h => hv2 ⟨hWU _ hv1, PredU_vis h.1⟩))).1 hd0
        obtain ⟨e1, e2⟩ := hag k (fun h => Nat.lt_irrefl _ h.1)
        have hmemA : ∀ j t m', s.mem[t]? = some m' → m'.loc = m1.loc →
            (t ∈ (flipSt E E' s j).promises ↔ t ∈ s.promises ∧ ¬ t < j) := by
          intro j t m' hm' hl
          rw [mem_flipSt]
          constructor
          · rintro ⟨h1, h2⟩
            exact ⟨h1, fun h => h2 ⟨h, hFL t m' h1 hm' (by rw [hl]; exact hv1) (by rw [hl]; exact hv2)⟩⟩
          · rintro ⟨h1, h2⟩; exact ⟨h1, fun h => h2 h.1⟩
        have hPA : ∀ j, PromAt E (flipSt E E' s j) m1.loc = (flipSt E E' s j).promises := fun j =>
          PromAt_nwordP hv2 (fun h => hv2 ⟨hWU _ hv1, PredU_vis h⟩) (FpAt_priv fun h => hv2 ⟨hWU _ hv1, h⟩)
        have hkeep : ∀ b w, b ≠ m1.loc → LatestNP (flipSt E E' s k).mem (PromAt E (flipSt E E' s k) b) b w →
            LatestNP (flipSt E E' s (k + 1)).mem (PromAt E (flipSt E E' s (k + 1)) b) b w := by
          intro b w hb hl
          refine LatestNP_congrP (fun t m' hm' hl' => ?_) hl
          rw [flip_at hdF, flip_at hdF]
          have htk : t ≠ k := fun e => by
            subst e
            obtain rfl : m1 = m' := Option.some.inj (hm.symm.trans hm')
            exact hb hl'.symm
          exact and_congr_right fun _ => not_congr ⟨fun h => ⟨Nat.lt_succ_of_lt h.1, h.2⟩,
            fun h => ⟨Nat.lt_of_le_of_ne (Nat.le_of_lt_succ h.1) htk, h.2⟩⟩
        by_cases hIW : ¬ IniW E m1.loc
        · -- (S7f α) an uninitialised buffer slot: nothing moves
          obtain ⟨c, N, e, us, hsto, hT, hus, hge⟩ : ∃ c N e us, E.sto m1.loc.label = some c ∧
              c.ty = .array (.lit N) e ∧ accs e = some us ∧ E.ini m1.loc.label * nWords us ≤ m1.loc.offset :=
            Classical.byContradiction fun hno =>
              hIW fun c N e us h1 h2 h3 => Nat.lt_of_not_le fun h4 => hno ⟨c, N, e, us, h1, h2, h3, h4⟩
          have hl1 : ∃ w1, LatestNP (flipSt E E' s (k + 1)).mem (PromAt E (flipSt E E' s (k + 1)) m1.loc) m1.loc w1 := by
            rw [hPA]
            exact LatestNP_ex hm rfl (fun h => ((hmemA (k + 1) k m1 hm rfl).1 h).2 (Nat.lt_succ_self k))
          obtain ⟨S', hH'0, hS'⟩ := held_uninitA hHk hsto hT hus hge hl1 hkeep
          have hnI' : ¬ IniW E' m1.loc := fun h => hIW ((IniW_congr (hs _) (hi _)).1 h)
          refine ⟨Hk, crk, dbk, ⟨S', hH'0, KeepP_upd hSk hS' hnpL⟩, fun t ht => hag t fun h => ht ⟨Nat.lt_succ_of_lt h.1, h.2⟩,
            fun t m' ht hf hm' => ?_, heq⟩
          by_cases htk : t = k
          · subst htk
            obtain rfl : m1 = m' := Option.some.inj (hm.symm.trans hm')
            rw [e1, e2, hcr0, hdb0]
            refine ⟨(DbRes_uninit hnI').2 rfl, ?_⟩
            by_cases hp : ∃ w, PredAt s.mem m1.loc t w
            · obtain ⟨w, hw'⟩ := hp; exact Or.inl ⟨w, hw', (VRes_uninit hnI').2 rfl⟩
            · exact Or.inr ⟨fun w hw' => hp ⟨w, hw'⟩, rfl⟩
          · exact hent t m' (Nat.lt_of_le_of_ne (Nat.le_of_lt_succ ht) htk) hf hm'
        have hIW : IniW E m1.loc := Classical.byContradiction hIW
        obtain ⟨⟨c, n, P, hsto, hat, hg, hini, hp, v, hval, hinP⟩, hab⟩ := hw k m1 hkp hm hv1 hv2 hIW
        obtain ⟨w0, hl0⟩ := held_lat hHk.memHeld hsto hat hg hini
        have hl0' := hl0
        rw [hPA] at hl0'
        obtain ⟨t0, m0, ht0, hm0, hl0a, hw0, hlast0⟩ := hl0'
        have ht0k : t0 < k := by
          by_cases hp0 : t0 ∈ s.promises
          · exact Nat.lt_of_not_le fun h => ht0 ((hmemA k t0 m0 hm0 hl0a).2 ⟨hp0, Nat.not_lt.2 h⟩)
          · exact hab t0 m0 hp0 hm0 hl0a
        have hpred : PredAt s.mem m1.loc k w0 := ⟨t0, m0, ht0k, hm0, hl0a, hw0,
          fun t' m' h1 h2 hm' hl' => ((hmemA k t' m' hm' hl').1 (hlast0 t' m' h1 hm' hl')).2 h2⟩
        have hl1 : LatestNP (flipSt E E' s (k + 1)).mem (PromAt E (flipSt E E' s (k + 1)) m1.loc) m1.loc (mw m1) := by
          rw [hPA]
          refine ⟨k, m1, fun h => ((hmemA (k + 1) k m1 hm rfl).1 h).2 (Nat.lt_succ_self k), hm, rfl, rfl,
            fun t' m' h1 hm' hl' => ?_⟩
          by_cases hp' : t' ∈ s.promises
          · exact (hmemA (k + 1) t' m' hm' hl').2 ⟨hp', fun h => Nat.lt_irrefl _ (Nat.lt_of_lt_of_le h1 (Nat.le_of_lt_succ h))⟩
          · exact absurd (hab t' m' hp' hm' hl') (Nat.lt_asymm h1)
        obtain ⟨H', ⟨S', hH'0, hS'⟩, heqH⟩ := heldWordA (s := flipSt E E' s k) (s' := flipSt E E' s (k + 1)) hHk hsto hat hg hini hp
          hl0 hl1 ⟨v, hval, hinP⟩ hkeep
        have hnIk : ¬ InitAt s.mem m1.loc k := fun h => held_nundef hHk.memHeld hsto hat hg hini hl0 (h w0 hpred)
        have hWA : WordAt E' m1.loc n P := ⟨c, by rw [hs]; exact hsto, hat, hg⟩
        refine ⟨H', fun t => if t = k then wr P n w0.val else crk t,
          fun t => if t = k then wr P n (mw m1).val else dbk t, ⟨S', hH'0, KeepP_upd hSk hS' hnpL⟩, fun t ht => ?_, fun t m' ht hf hm' => ?_, ?_⟩
        · have htk : t ≠ k := fun e => ht ⟨by rw [e]; exact Nat.lt_succ_self k, by rw [e]; exact hk⟩
          simp only [htk, ↓reduceIte]
          exact hag t fun h => ht ⟨Nat.lt_succ_of_lt h.1, h.2⟩
        · by_cases htk : t = k
          · subst htk
            obtain rfl : m1 = m' := Option.some.inj (hm.symm.trans hm')
            simp only [↓reduceIte]
            have hIW' : IniW E' m1.loc := (IniW_congr (hs _) (hi _)).2 hIW
            exact ⟨(DbRes_nInit hnIk).2 ((VRes_vis hv1.2 hIW').2 (WRes_wr hWA _)),
              Or.inl ⟨w0, hpred, (VRes_vis hv1.2 hIW').2 (WRes_wr hWA _)⟩⟩
          · simp only [htk, ↓reduceIte]
            exact hent t m' (Nat.lt_of_le_of_ne (Nat.le_of_lt_succ ht) htk) hf hm'
        · rw [pSum_upd0 hnd hkp (by rw [e1, hcr0]), pSum_upd0 hnd hkp (by rw [e2, hdb0])]
          exact Res.ext fun i => by
            have h1 := congrArg (fun R : Res => R i) heq
            have h2 := congrArg (fun R : Res => R i) heqH
            simp only [Res.add_apply] at h1 h2 ⊢
            omega
      · refine ⟨Hk, crk, dbk, ⟨Sk, MemHeldL_tr hHk (fun _ => rfl) (fun _ => rfl)
          (fun l o w hl => LatestNP_congrP (fun t m' _ _ => ?_) hl) id, hSk⟩,
          fun t ht => hag t (fun h => ht ⟨Nat.lt_succ_of_lt h.1, h.2⟩),
          fun t m' ht hf hm' => hent t m' (Nat.lt_of_le_of_ne (Nat.le_of_lt_succ ht) (fun e => hk (e ▸ hf))) hf hm',
          heq⟩
        rw [flip_at hdF, flip_at hdF]
        exact and_congr_right fun _ => not_congr
          ⟨fun h => ⟨Nat.lt_succ_of_lt h.1, h.2⟩,
            fun h => ⟨Nat.lt_of_le_of_ne (Nat.le_of_lt_succ h.1) (fun e => hk (e ▸ h.2)), h.2⟩⟩
  obtain ⟨HN, crN, dbN, ⟨SN, hHN, hSN⟩, hag, hent, heq⟩ := key s.mem.size
  have hnFL : ∀ t m, t ∈ s.promises → s.mem[t]? = some m → ¬ (VisU E' m.loc ∧ ¬ VisU E m.loc) →
      ¬ FlipT E E' s t := fun t m _ hm hn hf => hn (hFLat t m hf hm)
  refine ⟨HN, crN, dbN, ⟨SN, MemHeldL_trP hHN hs hi (fun l o w hl => LatestNP_congrP (fun t m hm hloc => ?_) hl) hv,
    SKeep_ofKeepP hSN⟩,
    fun t ht => ?_, fun t m ht hm hn => hag t fun h => hnFL t m ht hm hn h.2, heq⟩
  · rw [flip_at hdF]
    by_cases hF : VisU E' ⟨l, o⟩ ∧ ¬ VisU E ⟨l, o⟩
    · rw [PromAt_word hF.1, PromAt_nword hF.2 (fun h => hF.2 ⟨hWU _ hF.1, PredU_vis h⟩),
        FpAt_priv (a := ⟨l, o⟩) (fun h => hF.2 ⟨hWU _ hF.1, h⟩),
        List.append_nil]
      refine ⟨fun ⟨hp, hn⟩ => absurd ⟨hPb t hp, hFL t m hp hm (by rw [hloc]; exact hF.1)
        (by rw [hloc]; exact hF.2)⟩ hn, fun h => by cases h⟩
    · by_cases hV : VisU E ⟨l, o⟩
      · rw [PromAt_word hV, PromAt_word (hVE _ hV)]
        exact ⟨fun h => h.1, fun h => by cases h⟩
      · have hV' : ¬ VisU E' ⟨l, o⟩ := fun h => hF ⟨h, hV⟩
        have hFp : t ∈ FpAt E ⟨l, o⟩ ↔ t ∈ FpAt E' ⟨l, o⟩ := by
          by_cases hv0 : Vis E l
          · rw [FpAt_vis (a := ⟨l, o⟩) hv0, FpAt_vis (a := ⟨l, o⟩) (hmono _ hv0), hfp]
          · rw [FpAt_priv (a := ⟨l, o⟩) hv0]
            constructor
            · intro h; cases h
            · intro h
              by_cases hv1 : Vis E' l
              · rw [FpAt_vis (a := ⟨l, o⟩) hv1, hfp] at h
                exact absurd (hfpl t m h hm (by rw [hloc]; exact hv1)) (by rw [hloc]; exact hv0)
              · rw [FpAt_priv (a := ⟨l, o⟩) hv1] at h; cases h
        by_cases hqE : PredU E ⟨l, o⟩
        · rw [mem_PromAt_pred hV hqE, mem_PromAt_pred hV' ((hq _).2 hqE), List.mem_append, List.mem_append]
          constructor
          · rintro ⟨⟨h, ha⟩, -⟩; exact ⟨h.imp id hFp.1, ha⟩
          · rintro ⟨h, ha⟩
            refine ⟨⟨h.imp id hFp.2, ha⟩, fun h' => hF ?_⟩
            have := hFLat t m h'.2 hm; rw [hloc] at this; exact this
        rw [PromAt_nword hV hqE, PromAt_nword hV' (fun h => hqE ((hq _).1 h)), List.mem_append, List.mem_append]
        constructor
        · rintro ⟨h, -⟩; exact h.imp id hFp.1
        · intro h
          refine ⟨h.imp id hFp.2, fun h' => hF ?_⟩
          have := hFLat t m h'.2 hm; rw [hloc] at this; exact this
  · obtain ⟨m, hm, hd, hc⟩ := hC t ht
    by_cases hf : FlipT E E' s t
    · obtain ⟨h1, h2⟩ := hent t m (hPb t ht) hf hm
      exact ⟨m, hm, h1, h2⟩
    · obtain ⟨e1, e2⟩ := hag t fun h => hf h.2
      have hn : ¬ (VisU E' m.loc ∧ ¬ VisU E m.loc) := fun h => hf (hFL t m ht hm h.1 h.2)
      rw [e1, e2]
      refine ⟨m, hm, DbRes_nfu (hs _) (hi _) (hmono _) hn hd (hq _) htid hbx, ?_⟩
      rcases hc with ⟨w, hw', hcw⟩ | ⟨hnw, hcz⟩
      · exact Or.inl ⟨w, hw', VRes_nfu (hs _) (hi _) (hmono _) hn hcw⟩
      · exact Or.inr ⟨hnw, hcz⟩
#print axioms MemHeld_flipS

/-- `MemHeld_flipL` with slot lists. -/
theorem MemHeld_flipLS {g : G} {E E' : TEnv} {s : St} {H : Res} {S : AllocLabel → List Res} {cr db : Ts → Res} {l : AllocLabel}
    (hm : MemInv g E s) (hH : MemHeldL E s H S) (hC : PromCr E s cr db) (hpa : PromAbove s)
    (hs : ∀ l, E'.sto l = E.sto l) (hi : ∀ l, E'.ini l = E.ini l)
    (hmono : ∀ l, Vis E l → Vis E' l) (hl : ∀ l', l' ≠ l → Vis E' l' → Vis E l')
    (hv : ∀ {T : Ty} {vs : List Word} {R : Res}, ValOfR E T vs R → ValOfR E' T vs R)
    (hf : FlipOK E s l) (hfo : FpOK E s)
    (hol : OwnL E l) (hpm : ∀ l', E.pfr l' ≠ none → E'.pfr l' ≠ none)
    (hpo : ∀ l', l' ≠ l → E'.pfr l' ≠ none → E.pfr l' ≠ none)
    (hfp : E'.fp = E.fp := by first | rfl | assumption)
    (hri : ∀ l, E'.rini l = E.rini l := by first | exact fun _ => rfl | assumption)
    (htid : E'.tid = E.tid := by first | rfl | assumption)
    (hbx : ∀ l B, E.box l = some B → E'.box l = some B := by first | exact fun _ _ h => h | assumption) :
    ∃ H' cr' db', (∃ S', MemHeldL E' s H' S' ∧ SKeep E S S') ∧ PromCr E' s cr' db' ∧
      H' + pSum s cr' + pSum s db = H + pSum s cr + pSum s db' := by
  -- (U3) the flip creates no predicted unit: a private cell has no planted count
  have hq : ∀ a : Address, PredU E' a ↔ PredU E a := fun a => by
    have hrc' : E'.rc a.label = E.rc a.label := TEnv.rc_congr (hi _) (hri _)
    unfold PredU
    rw [IniW_congrU (hs _) (hi _), IniWr_congr (hs _) hrc']
    by_cases hv0 : E.pfr a.label = none
    · refine ⟨fun h => absurd h ?_, fun h => absurd hv0 h.1⟩
      rintro ⟨hpf', hiw, hnr⟩
      have hle : a.label = l := Classical.byContradiction fun hne => hpo _ hne hpf' hv0
      obtain ⟨c, hc, hown⟩ := hol
      rw [← hle] at hc
      have hrc : E.ini a.label ≤ E.rc a.label := Nat.le_of_not_lt fun hlt => by
        obtain ⟨f, hf, -⟩ := hm.2.2.2.2.2.1.2 _ c hc hown hlt
        rw [hv0] at hf; cases hf
      exact hnr fun c' N e us hc' hT hu =>
        Nat.lt_of_lt_of_le (hiw c' N e us hc' hT hu) (Nat.mul_le_mul_right _ hrc)
    · exact ⟨fun h => ⟨hv0, h.2⟩, fun h => ⟨hpm _ hv0, h.2⟩⟩
  obtain ⟨H', cr', db', h1, h2, -, h3⟩ := MemHeld_flipS hH hC (MemInv_promLt hm) (hm.2.2.2.2.2.2.2.2.2.2.1 : s.promises.Nodup) hs hi hmono hv
    (fun t m ht hm' hv1 hv2 hIW => by
      have hwu : WordUnit E m.loc := (WordUnit_congr (hs _)).1 hv1.1
      have hpv : Priv E m.loc.label := Classical.byContradiction fun h => hv2 ⟨hwu, h⟩
      have hle : m.loc.label = l := Classical.byContradiction fun h => hl _ h hv1.2 hpv
      obtain ⟨c, n, P, hsto, hat, hg, hini, hp, hin⟩ := hf (by rw [← hle]; exact hpv) t m ht hm' hle hwu hIW
      rw [← hle] at hsto
      obtain ⟨⟨c', hc', hown⟩, hpf0⟩ := hpv
      rw [hsto] at hc'
      obtain rfl : c = c' := Option.some.inj hc'
      refine ⟨⟨c, n, P, hsto, hat, hg, hini, hp, hin⟩, fun t' m' ht' hm'' hl' => ?_⟩
      -- a cell without a frontier has no planted count (`OwnHidP`'s second part)
      have hrc : E.ini m.loc.label ≤ E.rc m.loc.label := Nat.le_of_not_lt fun hlt => by
        obtain ⟨f, hf, -⟩ := hm.2.2.2.2.2.1.2 _ c hsto hown hlt
        rw [hpf0] at hf; cases hf
      have htail := own_tailW (OwnOKPF_cellP hm.2.1 hsto hown hpf0) hsto hat hg (IniAt_monoAt hrc hini)
      have h1 := hpa t ht m hm'
      by_cases hlt : s.vs.coh m.loc < t'
      · exact absurd (htail t' m' hlt hm'' hl') ht'
      · exact Nat.lt_of_le_of_lt (Nat.le_of_not_lt hlt) h1) hfp (fun t m ht hm _ => hfo.2 t m ht hm) hq
  exact ⟨H', cr', db', h1, h2, h3⟩
#print axioms MemHeld_flipLS

/-- `MemHeld_pub` with slot lists. -/
theorem MemHeld_pubS {g : G} {η : TEnv} {s : St} {H : Res} {Sl : AllocLabel → List Res} {cr db : Ts → Res} {lab : AllocLabel} {V : Ts}
    {S : AllocLabel → Prop}
    (hm : MemInv g (CE η) s) (hH : MemHeldL (CE η) s H Sl) (hC : PromCr (CE η) s cr db) (hpa : PromAbove s)
    (hf : FlipOK (CE η) s lab) (hfo : FpOK (CE η) s) (hol : OwnL (CE η) lab) :
    ∃ H' cr' db', (∃ S', MemHeldL (CE (η.withSto η.sto η.ini (pubP η lab V) S)) s H' S' ∧ SKeep (CE η) Sl S') ∧
      PromCr (CE (η.withSto η.sto η.ini (pubP η lab V) S)) s cr' db' ∧
      H' + pSum s cr' + pSum s db = H + pSum s cr + pSum s db' := by
  refine MemHeld_flipLS hm hH hC hpa (fun _ => rfl) (fun _ => rfl) (fun l' hv hpv => hv ⟨hpv.1, ?_⟩)
    (fun l' hne hv hpv => hv ⟨hpv.1, ?_⟩)
    (fun h => ValOfR_mono (η₁ := CE η) (η₂ := CE (η.withSto η.sto η.ini (pubP η lab V) S))
      rfl rfl (fun _ _ h => h) (fun _ => Nat.le_refl _) h (pubP_mono η lab _) (fun _ _ h => h)) hf hfo hol
    (fun l' h h0 => h (by
      have h0' : pubP η lab V l' = none := h0
      show η.pfr l' = none
      cases e : η.pfr l' with
      | none => rfl
      | some f => rw [pubP_mono η lab V l' f e] at h0'; cases h0'))
    (fun l' hne h h0 => h (by
      show pubP η lab V l' = none
      simp only [pubP, hne, ↓reduceIte]; exact h0))
  · have h2 : pubP η lab V l' = none := hpv.2
    cases h : η.pfr l' with
    | none => exact h
    | some f => rw [pubP_mono η lab V l' f h] at h2; cases h2
  · show pubP η lab V l' = none
    have h2 : η.pfr l' = none := hpv.2
    simp only [pubP, hne, ↓reduceIte]; exact h2
#print axioms MemHeld_pubS

/-! ### (B2, ownPub) The `publish` footprint's `SeenOK` -/

/-- (B2, ownPub) The own-key bound (the caller's `ownNet_of`). -/
def OwnLe1 (Rf Rs H : Res) : Prop := ∀ l, (Rf + Rs + H) (.own l) ≤ 1

/-- (B2, ownPub) The own-key bound a step needs: at a `publish`, of the published label only. -/
def PubLe1 (th : TTh) (Rf Rs H : Res) : Prop :=
  ∀ x a e, th.term = .let_ x (.publish a) e → ∀ rt ws ad g0, evalAt th.env a = some (rt, ws) →
    ws.map (·.val) = [.loc ad g0] → (Rf + Rs + H) (.own ad.label) ≤ 1

theorem PubLe1.of_le1 {th : TTh} {Rf Rs H : Res} (h : OwnLe1 Rf Rs H) : PubLe1 th Rf Rs H :=
  fun _ _ _ _ _ _ ad _ _ _ => h ad.label

theorem VRes_own0 {E : TEnv} {a : Address} {w : Word} {R : Res} (h : VRes E a w R) (l : Nat) :
    R (.own l) = 0 := by
  rcases h with ⟨-, -, ⟨n, P, -, -, rfl⟩ | ⟨-, rfl⟩⟩ | ⟨-, rfl⟩ <;> simp

theorem DbRes_own0 {E : TEnv} {mem : Memory} {m : Msg} {tw : Ts} {R : Res}
    (h : DbRes E mem m tw R) (l : Nat) : R (.own l) = 0 := by
  rcases h with ⟨hV, hI, h3, h4⟩ | ⟨-, rfl⟩
  · by_cases hi : InitAt mem m.loc tw
    · obtain ⟨R₁, Z, hF, hS, hZ, rfl⟩ := h3 hi
      have hZo : Z (.own l) = 0 := by
        by_cases hd : DesigAt E mem m.loc tw
        · obtain ⟨Zb, Zz, -, -, rfl⟩ := hS hd
          exact noOwnR_own _ l
        · rw [hZ hd]; rfl
      have hR1 : R₁ (.own l) = 0 := by
        rcases hF with ⟨n, P, -, rfl⟩ | ⟨-, rfl⟩
        · simp only [Res.add_apply, wr, wdW]
          split <;> split <;> simp
        · rfl
      simp only [Res.add_apply, hZo, hR1]
    · exact VRes_own0 (Or.inl ⟨hV, hI, h4 hi⟩) l
  · rfl

theorem sum_map_key0 {f : Ts → Res} {k : Key} :
    ∀ {L : List Ts}, (∀ t, t ∈ L → f t k = 0) → Res.sum (L.map f) k = 0
  | [], _ => rfl
  | t :: L, h => by
      simp only [List.map_cons, Res.sum_cons, Res.add_apply]
      rw [h t (List.mem_cons_self ..), sum_map_key0 (fun t' ht' => h t' (List.mem_cons_of_mem _ ht'))]

/-- (B2) Promise credits and debits carry no own-handle key (`TermTyped.PromCr_own_zero`, here). -/
theorem PromCr_own0 {E : TEnv} {s : St} {cr db : Ts → Res} (h : PromCr E s cr db) (l : Nat) :
    pSum s cr (.own l) = 0 ∧ pSum s db (.own l) = 0 := by
  refine ⟨sum_map_key0 fun t ht => ?_, sum_map_key0 fun t ht => ?_⟩
  · obtain ⟨m, -, -, ⟨w, -, hw⟩ | ⟨-, hz⟩⟩ := h t ht
    · exact VRes_own0 hw l
    · rw [hz]; rfl
  · obtain ⟨m, -, hd, -⟩ := h t ht
    exact DbRes_own0 hd l

/-- (B2) A `publish` spending `own ad.label` under `OwnLe1`: the new frame and holding carry none. -/
theorem pub_zero {Rr Rs H' A B Rf H A' B' : Res} {ws : List Word} {ad : Address} {g0 : Nat}
    (hle : Rr + Rs + H' + A + B + ownW .own ws ≤ Rf + Rs + H + A' + B')
    (hA : A' (.own ad.label) = 0) (hB : B' (.own ad.label) = 0) (hw : ws.map (·.val) = [.loc ad g0])
    (h2 : (Rf + Rs + H) (.own ad.label) ≤ 1) : (Rr + Rs) (.own ad.label) = 0 ∧ H' (.own ad.label) = 0 := by
  have h := Res.le_def.1 hle (.own ad.label)
  rw [ownW_own_loc hw] at h
  simp only [Res.add_apply, Res.one_apply, ite_true] at h h2 ⊢
  omega

/-- (B2) `publish`'s footprint (`pubS`) has `SeenOK` once the published label's key is gone. -/
theorem SeenOK_pubS {η : TEnv} {lab : AllocLabel} {P : AllocLabel → Option Ts} {Tot H : Res}
    (hz : Tot (.own lab) = 0 ∧ H (.own lab) = 0) :
    SeenOK (CE η) (CE (η.withSto η.sto η.ini P (pubS η lab))) Tot H := by
  intro l hl hn _
  rcases hl with rfl | h
  · exact hz
  · exact absurd h hn

/-- **Publishing one own cell, with resources**: `pubCell_post`'s footprint, extension and `MemInv`,
plus the flipped holding (`MemHeld_pubS`), the moved credits, `SeenOK` and the telescoping bound.  The
frame `Tot` gives up the cell's own key (`hT`); `h1` bounds that key's count. -/
theorem pubCellR_post {Sp : AllocLabel → List Res} {p : Prog} {g : G} {η : TEnv} {s : St} {lab : AllocLabel}
    {c : Cell} {Rd : Nat} {Tot H Rf Rs F : Res} {cr db : Ts → Res}
    (hE : EnvOK p η) (hm : MemInv g (CE η) s) (hH : MemHeldL (CE η) s H Sp) (hC : PromCr (CE η) s cr db)
    (hpa : PromAbove s) (hfo : FpOK (CE η) s) (hsto : η.sto lab = some c) (hown : c.owner = some η.tid)
    (hR : η.rid ≤ Rd)
    (hF : (∀ b S, SegOf c.ty b S → accs S ≠ none → TearOK S) ∧ Ty.coupledOKIn [] c.ty = true ∧
      Ty.noOwnIn [] c.ty = true ∧ rgnFree c.ty = true)
    (hnh : NoHold (CE η) s lab) (hgp : g.pf lab) (hwp : FlipOK (CE η) s lab)
    (hT : Tot + Res.one (.own lab) ≤ Rf + Rs + F) (hF0 : F (.own lab) = 0)
    (h1 : (Rf + Rs + H) (.own lab) ≤ 1) :
    Ext η (pubEnvAt η lab s.vs.vWr Rd) ∧ ∃ H' cr' db',
      EFoot g (CE η) (CE (pubEnvAt η lab s.vs.vWr Rd)) s (fenceS s .st) ∧
      SeenOK (CE η) (CE (pubEnvAt η lab s.vs.vWr Rd)) Tot H' ∧
      MemInv g (CE (pubEnvAt η lab s.vs.vWr Rd)) (fenceS s .st) ∧
      MemHeldK (CE η) s Sp (CE (pubEnvAt η lab s.vs.vWr Rd)) (fenceS s .st) H' ∧
      PromCr (CE (pubEnvAt η lab s.vs.vWr Rd)) (fenceS s .st) cr' db' ∧
      Tot + H' + pSum s cr' + pSum s db + Res.one (.own lab) ≤ Rf + Rs + H + pSum s cr + pSum s db' + F := by
  obtain ⟨-, hx, hmi⟩ := pubCell_post (Rd := Rd) hE hm hsto hown hR hF hnh hgp
  obtain ⟨H', cr', db', ⟨S', hH'L, hSK⟩, hC', heq⟩ :=
    MemHeld_pubS (V := s.vs.vWr) (S := pubS η lab) hm hH hC hpa hwp hfo ⟨c, hsto, hown⟩
  have hle : Tot + H' + pSum s cr' + pSum s db + Res.one (.own lab) ≤
      Rf + Rs + H + pSum s cr + pSum s db' + F :=
    Res.le_def.2 fun k => by
      have ha := Res.le_def.1 hT k
      have hb := congrArg (fun R : Res => R k) heq
      simp only [Res.add_apply] at ha hb ⊢; omega
  have hz : Tot (.own lab) = 0 ∧ H' (.own lab) = 0 := by
    have ha := Res.le_def.1 hT (.own lab)
    have hb := congrArg (fun R : Res => R (.own lab)) heq
    have hc := PromCr_own0 hC lab
    have hd := PromCr_own0 hC' lab
    simp only [Res.add_apply, Res.one_apply, ite_true] at ha hb h1 hc hd ⊢
    omega
  exact ⟨hx, H', cr', db', EFoot_pub (hgp := hgp) rfl rfl rfl rfl rfl ⟨c, hsto, hown⟩ (fun _ => rfl) (fun _ => Iff.rfl) hnh.2.2,
    SeenOK_pubS (P := pubP η lab s.vs.vWr) hz, hmi, ⟨S', MemHeldL_eqs hH'L rfl rfl, hSK.toT _ _⟩,
    PromCr_keep hC' rfl (MemInv_promLt hm) (fun _ _ => rfl) (fun _ _ _ _ => rfl), hle⟩

/-- **(P4) `publish`, with resources**: the view publishes the cell (`pfr`
grows, `seen` gains it), memory and its holding are unchanged; the published
handle binds carrying nothing (the used one carried at most its share).
(S7c) The view change flips the published cell's accounting (`MemHeld_pub`,
side condition `hwp`), so the credits move: the conclusion is `ThInvMCF`'s,
with new credits and debits and a telescoping total. -/
theorem tstepMR_publish {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {a : At} {e : Expr}
    {Rf Rs H : Res}
    (hterm : th.term = .let_ x (.publish a) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hsc : PubScope cx a)
    {cr db : Ts → Res} (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hwp : ∀ rt ws ad, evalAt th.env a = some (rt, ws) → ws.map (·.val) = [.loc ad 0] →
      FlipOK (CE η) (stOf mem pairs th) ad.label)
    (hwin : ∀ rt ws ad, evalAt th.env a = some (rt, ws) → ws.map (·.val) = [.loc ad 0] →
      NoHold (CE η) (stOf mem pairs th) ad.label)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hown1 : PubLe1 th Rf Rs H := by assumption)
    (hPb : ∀ y a e rt ws ad, th.term = .let_ y (.publish a) e → evalAt th.env a = some (rt, ws) →
      ws.map (·.val) = [.loc ad 0] → g.pf ad.label := by exact fun _ _ _ _ _ _ _ _ _ => trivial) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      ∃ Tot H' cr' db' rt ws, evalAt th.env a = some (rt, ws) ∧
        (∀ ad g', ws.map (·.val) = [.loc ad g'] → η.sto ad.label ≠ none) ∧
        ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr' db' ∧
        Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr' + pSum (stOf mem pairs th) db + ownW .own ws ≤
          Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db' := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | publish hu hsh hb =>
    obtain ⟨u, c₁, hu, hsh, hb⟩ : ∃ u c₁, cx.use a = .ok (.ptr .own u, c₁) ∧
        Ty.sharedOKIn c₁.ke (.ptr .pub u) = true ∧ c₁.bind x (.ptr .pub u) = .ok c' := ⟨_, _, hu, hsh, hb⟩
    obtain ⟨rt, ws, R0, Rr, hea, hv, hl, hvR, hi1R, hle⟩ := useR hu hi hE.2.2
    have hR0 := VRR_cell_R rfl hvR
    have hi1 := hi1R.1
    simp only [VR] at hv
    obtain ⟨⟨lab, off⟩, c, hws, hoff, hsto, hcty, hmode, hacc⟩ := hv
    simp only at hoff; subst hoff
    obtain ⟨pw, rfl, hpw⟩ : ∃ pw, ws = [pw] ∧ pw.val = .loc ⟨lab, 0⟩ 0 := by
      match ws, hws with
      | [pw], h => exact ⟨pw, rfl, by simpa using h⟩
      | [], h => simp at h
      | _ :: _ :: _, h => simp at h
    have hsk := hl.2.1
    rw [close_ptr] at hsk
    obtain ⟨ru, rfl, hsku⟩ : ∃ ru, rt = .ptr .own ru ∧ etok (skel ru) = etok (skel (close th.σs u)) := by
      cases rt <;> simp [skel, etok] at hsk
      case ptr μ ru =>
        cases μ <;> simp [skelM, etok] at hsk
        exact ⟨ru, rfl, hsk⟩
      case refine t ψ => unfold rf at hsk; split at hsk <;> simp [etok] at hsk
    have hown : c.owner = some η.tid := hmode
    have hwsv : [pw].map (·.val) = [.loc ⟨lab, 0⟩ 0] := by simp [hpw]
    simp only [Ty.sharedOKIn, Bool.and_eq_true] at hsh
    have hF := pubTyFacts hi1 hE (by simpa [tb] using tb_use hu htv) hcty hacc hsh.1.1 hsh.1.2
      (hsc _ (use_cases hu).1 _ _ (Or.inl rfl))
    have key : tstep g mem pairs th =
        [((fenceS (stOf mem pairs th) .st).mem, (fenceS (stOf mem pairs th) .st).pairs,
          withS { th with term := e, env := (x, .ptr .pub ru, [pw]) :: th.env } (fenceS (stOf mem pairs th) .st))] := by
      simp only [tstep, hterm, evalOp, hea]; rfl
    rw [key]
    refine ⟨by simp, fun r hr hpa0 => ?_⟩
    simp only [List.mem_singleton] at hr
    subst hr
    have hpa : PromAbove (stOf mem pairs th) := fun t ht m hm' => hpa0 t ht m hm'
    have hT0 : Rr + Rs + Res.one (.own lab) ≤ Rf + Rs + Res.zero :=
      Res.le_def.2 fun k => by
        have h1 := Res.le_def.1 hle k
        have h3 := congrArg (fun R : Res => R k) (hR0.trans (ownW_own_loc hwsv))
        simp only [Res.add_apply] at h1 h3 ⊢; simp only [Res.zero] at ⊢; omega
    obtain ⟨hx, H', cr', db', hfoot, hseen, hmi, hHn, hCn, hleT⟩ :=
      pubCellR_post (Sp := Sp) (Rd := η.rid) hE hm hH hC hpa hfo hsto hown (Nat.le_refl _) hF
        (hwin _ _ ⟨lab, 0⟩ hea hwsv) (hPb x a e _ _ ⟨lab, 0⟩ hterm hea hwsv) (hwp _ _ ⟨lab, 0⟩ hea hwsv) hT0 rfl
        (hown1 _ _ _ hterm _ _ ⟨lab, 0⟩ 0 hea hwsv)
    have hvr : VR ρ (pubEnvAt η lab (stOf mem pairs th).vs.vWr η.rid) (.ptr .pub u) (shp (.ptr .pub ru)) [pw] := by
      simp only [VR]
      exact ⟨⟨lab, 0⟩, c, hws, rfl, hsto, hcty,
        ⟨(η.pfr lab).getD (stOf mem pairs th).vs.vWr, by simp [pubEnvAt, TEnv.withSto, pubP], Or.inl (Or.inl rfl)⟩, hacc⟩
    have hE' : EnvOK p (pubEnvAt η lab (stOf mem pairs th).vs.vWr η.rid) := ⟨hE.1, hx.1, hx.2.2.2.2.2.2.2.2.2.2.1⟩
    have hvz : VRR ρ (pubEnvAt η lab (stOf mem pairs th).vs.vWr η.rid) (.ptr .pub u) (shp (.ptr .pub ru)) [pw] .zero := by
      simp only [VR] at hvr; simp only [VRR]; exact ⟨hvr, rfl⟩
    have hfr := bindR hb (FInvR_ext hE.2.1 hE.2.2 hx hi1R) (RLink_of hE'.2.1 hE'.2.2) hvz (Lay_ptr_remode hl rfl rfl)
    rw [Res.add_zero] at hfr
    refine ⟨Rr + Rs, H', cr', db', _, [pw], hea,
      (fun ad g' h => by simp only [List.map_cons, List.map_nil, hpw] at h; cases h; simp [hsto]),
      ⟨_, hfoot, hseen, (by boxT), ⟨ρ, _, c', Rr, Rs, rfl, hE', ⟨he, hck⟩, htv', hfr, rfl,
        retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩, hmi, hHn, hCn⟩, ?_⟩
    rw [ownW_own_loc hwsv]
    rw [Res.add_zero] at hleT
    exact hleT
  | publishBuf hu hsh hb =>
    obtain ⟨n, k, u, c₁, hu, hsh, hb⟩ : ∃ n k u c₁, cx.use a = .ok (.refine (.loc .own (.array n u)) (.ini k), c₁) ∧
        Ty.sharedOKIn c₁.ke (.loc .pub (.array n u)) = true ∧
        c₁.bind x (.refine (.loc .pub (.array n u)) (.ini k)) = .ok c' := ⟨_, _, _, _, hu, hsh, hb⟩
    obtain ⟨rb, wsb, R0, Rr, hea, hvb, hlb, hvR, hi1R, hle⟩ := useR hu hi hE.2.2
    have hR0 := VRR_buf_R rfl hvR
    have hi1 := hi1R.1
    obtain ⟨-, μr, nr, ur, ψ, wsb', hea', hvb', hlay⟩ := ownBuf_inv hu hi.1
    rw [hea] at hea'
    cases hea'
    have hl := hlay .pub .pub rfl rfl
    have key : tstep g mem pairs th =
        [((fenceS (stOf mem pairs th) .st).mem, (fenceS (stOf mem pairs th) .st).pairs,
          withS { th with term := e, env := (x, .refine (.loc .pub (.array nr ur)) ψ, wsb) :: th.env }
            (fenceS (stOf mem pairs th) .st))] := by
      simp only [tstep, hterm, evalOp, hea]; rfl
    rw [key]
    refine ⟨by simp, fun r hr hpa0 => ?_⟩
    simp only [List.mem_singleton] at hr
    subst hr
    simp only [VR] at hvb'
    obtain ⟨hv, hir⟩ := hvb'
    rcases hv with ⟨hnull, e0, he0⟩ | ⟨ad, c, U, hws, hsto, hat, hFU, hmode, hini⟩
    · -- a null handle (an empty buffer): only the fence
      have hvr : VR ρ η (.refine (.loc .pub (.array n u)) (.ini k)) (shp (.refine (.loc .pub (.array nr ur)) ψ)) wsb := by
        simp only [VR]; exact ⟨Or.inl ⟨hnull, e0, he0⟩, IniR_mono (TEnv.selIni_le_ini η _) hir⟩
      have hvz : VRR ρ η (.refine (.loc .pub (.array n u)) (.ini k)) (shp (.refine (.loc .pub (.array nr ur)) ψ)) wsb .zero := by
        simp only [VRR]; exact ⟨⟨Or.inl ⟨hnull, e0, he0⟩, rfl⟩, IniR_mono (TEnv.selIni_le_ini η _) hir⟩
      have hfr := bindR hb hi1R (RLink_of hE.2.1 hE.2.2) hvz hl
      rw [Res.add_zero] at hfr
      have hleT : Rr + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf mem pairs th) db + ownW .own wsb ≤
          Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf mem pairs th) db :=
        Res.le_def.2 fun k => by
          have h1 := Res.le_def.1 hle k
          have h3 := congrArg (fun R : Res => R k) hR0
          simp only [Res.add_apply] at h1 h3 ⊢; omega
      exact ⟨Rr + Rs, H, cr, db, _, wsb, hea, (fun ad' g' h => by rw [hnull] at h; cases h), ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Rr, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩, MemInv_fence hm,
        MemHeldK_eqs hH rfl rfl, PromCr_keep hC rfl (MemInv_promLt hm) (fun _ _ => rfl) (fun _ _ _ _ => rfl)⟩, hleT⟩
    · obtain rfl := Fd_nonmu hFU (fun b => by simp [cl])
      have hown : c.owner = some η.tid := hmode
      simp only [Ty.sharedOKIn, Bool.and_eq_true] at hsh
      have hF := pubTyFactsBuf hi1 hE hm hsto hown (by simpa [tb] using tb_use hu htv) hat hsh.1.1 hsh.1.2
        (hsc _ (use_cases hu).1 _ _ (Or.inr ⟨_, rfl⟩))
      have hpa : PromAbove (stOf mem pairs th) := fun t ht m hm' => hpa0 t ht m hm'
      have hT0 : Rr + Rs + Res.one (.own ad.label) ≤ Rf + Rs + Res.zero :=
        Res.le_def.2 fun k => by
          have h1 := Res.le_def.1 hle k
          have h3 := congrArg (fun R : Res => R k) (hR0.trans (ownW_own_loc hws))
          simp only [Res.add_apply] at h1 h3 ⊢; simp only [Res.zero] at ⊢; omega
      obtain ⟨hx, H', cr', db', hfoot, hseen, hmi, hHn, hCn, hleT⟩ :=
        pubCellR_post (Sp := Sp) (Rd := η.rid) hE hm hH hC hpa hfo hsto hown (Nat.le_refl _) hF
          (hwin _ _ ad hea hws) (hPb x a e _ _ ad hterm hea hws) (hwp _ _ ad hea hws) hT0 rfl
          (hown1 _ _ _ hterm _ _ ad 0 hea hws)
      have hvr : VR ρ (pubEnvAt η ad.label (stOf mem pairs th).vs.vWr η.rid)
          (.refine (.loc .pub (.array n u)) (.ini k)) (shp (.refine (.loc .pub (.array nr ur)) ψ)) wsb := by
        simp only [VR]
        exact ⟨Or.inr ⟨ad, c, _, hws, hsto, hat, .refl,
          ⟨(η.pfr ad.label).getD (stOf mem pairs th).vs.vWr, by simp [pubEnvAt, TEnv.withSto, pubP], Or.inl (Or.inl rfl)⟩,
          (IniAt_mono (modeIni_le_ini _ _ _) hini)⟩, IniR_mono (TEnv.selIni_le_ini η _) hir⟩
      have hE' : EnvOK p (pubEnvAt η ad.label (stOf mem pairs th).vs.vWr η.rid) := ⟨hE.1, hx.1, hx.2.2.2.2.2.2.2.2.2.2.1⟩
      have hvz : VRR ρ (pubEnvAt η ad.label (stOf mem pairs th).vs.vWr η.rid)
          (.refine (.loc .pub (.array n u)) (.ini k)) (shp (.refine (.loc .pub (.array nr ur)) ψ)) wsb .zero := by
        simp only [VR] at hvr; simp only [VRR]; exact ⟨⟨hvr.1, rfl⟩, hvr.2⟩
      have hfr := bindR hb (FInvR_ext hE.2.1 hE.2.2 hx hi1R) (RLink_of hE'.2.1 hE'.2.2) hvz hl
      rw [Res.add_zero] at hfr
      refine ⟨Rr + Rs, H', cr', db', _, wsb, hea, (fun ad' g' h => by rw [hws] at h; cases h; simp [hsto]),
        ⟨_, hfoot, hseen, (by boxT), ⟨ρ, _, c', Rr, Rs, rfl, hE', ⟨he, hck⟩, htv', hfr, rfl,
          retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩, hmi, hHn, hCn⟩, ?_⟩
      rw [ownW_own_loc hws]
      rw [Res.add_zero] at hleT
      exact hleT

/-- (S4f) `stepRmw_mem`, with the read not hidden below coherence and a
success's coherence moved past the read. -/
theorem stepRmw_memR_at {k : Promises.Knobs} {arch : Arch} {mem : Memory} {pairs : List Ts}
    {th : Promises.Thread} {dst : WeakMem.Reg} {a : Address} {kind : WeakMem.RmwKind} {newv : WeakMem.Expr}
    {deps : List WeakMem.Reg} {acq rel : Bool} {mem' : Memory} {th' : Promises.Thread}
    (h : (mem', th') ∈ Promises.stepRmwAt k arch mem pairs th dst a kind newv deps acq rel) :
    ∃ t m, mem[t]? = some m ∧ m.loc = a ∧ (th'.regs dst).val = m.val ∧
      ((WeakMem.rmwSucceeds kind m.val = false ∧ mem' = mem ∧ th'.promises = th.promises) ∨
       (WeakMem.rmwSucceeds kind m.val = true ∧
         ((∃ mv, mem' = mem.push ⟨a, kind.apply m.val (Promises.rmwNewVal th.regs newv), mv⟩ ∧
             th'.promises = th.promises ∧ WeakMem.rmwAdjacent mem a t mem.size = true) ∨
          (∃ tw pm, tw ∈ th.promises ∧ mem' = mem ∧ th'.promises = th.promises.erase tw ∧
             mem[tw]? = some pm ∧ pm.loc = a ∧ pm.val = kind.apply m.val (Promises.rmwNewVal th.regs newv) ∧
             WeakMem.rmwAdjacent mem a t tw = true)))) ∧
      WeakMem.hiddenFrom mem a t (th.vs.coh a) = false ∧
      (WeakMem.rmwSucceeds kind m.val = true → t < th'.vs.coh a) := by
  simp only [Promises.stepRmwAt, List.mem_flatMap, List.mem_filter, List.mem_range] at h
  obtain ⟨t, ⟨htl, hrd⟩, h⟩ := h
  simp only [WeakMem.readable, Bool.and_eq_true] at hrd
  cases hm : mem[t]? with
  | none => rw [hm] at hrd; simp at hrd
  | some m =>
  rw [hm] at hrd
  have hloc : m.loc = a := by simpa using hrd.1
  have hh0 : WeakMem.hiddenFrom mem a t (Promises.readBoundOf arch th.vs (Promises.depBound th.regs deps) a) = false := by
    simpa using hrd.2
  have hh : WeakMem.hiddenFrom mem a t (th.vs.coh a) = false :=
    hiddenFrom_mono (by unfold Promises.readBoundOf; exact Nat.le_trans (Nat.le_max_right _ _) (Nat.le_max_left _ _)) hh0
  have e : mem[t]! = m := by simp [getElem!_def, hm]
  rw [e] at h
  refine ⟨t, m, hm, hloc, ?_⟩
  split at h
  · rename_i hfail
    simp only [List.mem_singleton, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    refine ⟨by split <;> simp [Promises.stepFence, rmwDst_val], Or.inl ⟨by simpa using hfail, rfl, by split <;> rfl⟩, hh,
      fun hs => by simp [hs] at hfail⟩
  · rename_i hsucc
    have hs : WeakMem.rmwSucceeds kind m.val = true := by simpa using hsucc
    rw [List.mem_append] at h
    rcases h with h | h
    · split at h
      · rename_i hadj
        simp only [List.mem_singleton, Prod.mk.injEq] at h
        obtain ⟨rfl, rfl⟩ := h
        have ht := lt_of_get hm
        exact ⟨by split <;> simp [Promises.stepFence, rmwDst_val], Or.inr ⟨hs, Or.inl ⟨_, rfl, by split <;> rfl, hadj⟩⟩, hh,
          fun _ => by split <;> simp [Promises.stepFence, rmwDst_val] <;> omega⟩
      · simp at h
    · rw [List.mem_filterMap] at h
      obtain ⟨tw, htw, hf⟩ := h
      cases hpm : mem[tw]? with
      | none => simp [hpm] at hf
      | some pm =>
        try simp only [hpm] at hf
        simp only [Option.ite_none_right_eq_some, Option.some.injEq, Prod.mk.injEq] at hf
        obtain ⟨hcond, rfl, rfl⟩ := hf
        simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hcond
        have htt := (rmwAdjacent_spec hcond.2).1
        exact ⟨by split <;> simp [Promises.stepFence, rmwDst_val], Or.inr ⟨hs, Or.inr ⟨tw, pm, htw, rfl, by split <;> rfl, hpm,
          hcond.1.1.1.1, hcond.1.1.1.2, hcond.2⟩⟩, hh, fun _ => by split <;> simp [Promises.stepFence, rmwDst_val] <;> omega⟩

theorem stepRmw_memR {k : Promises.Knobs} {arch : Arch} {mem : Memory} {pairs : List Ts}
    {th : Promises.Thread} {dst : WeakMem.Reg} {a : Address} {kind : WeakMem.RmwKind} {newv : WeakMem.Expr}
    {deps : List WeakMem.Reg} {acq rel : Bool} {mem' : Memory} {th' : Promises.Thread}
    (h : (mem', th') ∈ Promises.stepRmw k arch mem pairs th dst a kind newv deps acq rel) :
    ∃ t m, mem[t]? = some m ∧ m.loc = a ∧ (th'.regs dst).val = m.val ∧
      ((WeakMem.rmwSucceeds kind m.val = false ∧ mem' = mem ∧ th'.promises = th.promises) ∨
       (WeakMem.rmwSucceeds kind m.val = true ∧
         ((∃ mv, mem' = mem.push ⟨a, kind.apply m.val (Promises.rmwNewVal th.regs newv), mv⟩ ∧
             th'.promises = th.promises ∧ WeakMem.rmwAdjacent mem a t mem.size = true) ∨
          (∃ tw pm, tw ∈ th.promises ∧ mem' = mem ∧ th'.promises = th.promises.erase tw ∧
             mem[tw]? = some pm ∧ pm.loc = a ∧ pm.val = kind.apply m.val (Promises.rmwNewVal th.regs newv) ∧
             WeakMem.rmwAdjacent mem a t tw = true)))) ∧
      WeakMem.hiddenFrom mem a t (th.vs.coh a) = false ∧
      (WeakMem.rmwSucceeds kind m.val = true → t < th'.vs.coh a) := by
  have hx := stepRmw_memR_at (th := if arch = .tso then Promises.stepFence th .sy else th) h
  simp only [lockTh_prom, lockTh_regs, lockTh_coh] at hx
  exact hx

/-- (D1, P1; N2) The current term is no RMW (`cas`, `fetch`) at one of the
thread's own **private** cells (no frontier) with `rc < ini`.  At a private
cell `rc < ini` is impossible (`OwnHidP`), so this is a fact of memory's
invariant; at a planted or published cell an RMW is allowed: one fulfilling a
designated promise would read the cell's `undef` placeholder (`FirstW`), which
a typed `cas` cannot expect and a `fetch` cannot combine (`rmwPlainAccL`). -/
def NoPlantRMW (E : TEnv) (th : TTh) : Prop :=
  ∀ w rt pw ad, ((∃ acq rel e v x ok fail, th.term = .cas acq rel w e v x ok fail) ∨
      (∃ x o acq rel v e, th.term = .let_ x (.fetch o acq rel w v) e)) →
    evalAt th.env w = some (rt, [pw]) → addrOf pw = some ad → OwnL E ad.label →
    E.pfr ad.label = none → IniWr E ad

/-- (S4f) At an own cell, a successful RMW whose result keeps the promises
above coherence read the latest non-promise message. -/
theorem rmw_ownLatest {g : G} {E : TEnv} {s : St} {mem' : Memory} {P' : List Ts} {coh' : Address → Ts}
    {a : Address} {c : Cell} {n : Nat} {P : Proto} {tm : Ts} {m : Msg} {wv : WeakMem.Val}
    (hm : MemInv g E s)
    (hnpl : Priv E a.label → IniWr E a) (hsto : E.sto a.label = some c) (hat : AtOff c.ty a.offset (.word (.lit n) P))
    (hg : P.ghost = false) (hini : IniAt E.ini c a (.word (.lit n) P))
    (hmt : s.mem[tm]? = some m) (hml : m.loc = a) (hhid : WeakMem.hiddenFrom s.mem a tm (s.vs.coh a) = false)
    (hcoh : tm < coh' a)
    (hcs : (∃ mv, mem' = s.mem.push ⟨a, wv, mv⟩ ∧ P' = s.promises ∧
        WeakMem.rmwAdjacent s.mem a tm s.mem.size = true) ∨
      (∃ tw pm, tw ∈ s.promises ∧ mem' = s.mem ∧ P' = s.promises.erase tw ∧
        s.mem[tw]? = some pm ∧ pm.loc = a ∧ pm.val = wv ∧ WeakMem.rmwAdjacent s.mem a tm tw = true))
    (hpa : ∀ t, t ∈ P' → ∀ m, mem'[t]? = some m → coh' m.loc < t) :
    Priv E a.label → tm ∉ s.promises ∧
      ∀ (t' : Ts) (m' : Msg), tm < t' → s.mem[t']? = some m' → m'.loc = a → t' ∈ s.promises := by
  intro hpv
  have hle := hnpl hpv
  obtain ⟨c', hc', ho'⟩ := hpv.1
  rw [hsto] at hc'; cases hc'
  refine latestNP_of_read (own_tailW (OwnOKPF_cellP hm.2.1 hsto ho' hpv.2) hsto hat hg (iniAt_rc_of_iniWr hsto hle hini)) hhid hmt hml (fun htp => ?_)
  have hin' : tm ∈ P' := by
    rcases hcs with ⟨_, _, hp, _⟩ | ⟨tw, _, _, _, hp, _, _, _, hadj⟩
    · rw [hp]; exact htp
    · rw [hp]; exact (List.mem_erase_of_ne (Nat.ne_of_lt (rmwAdjacent_spec hadj).1)).2 htp
  have hmem' : mem'[tm]? = some m := by
    rcases hcs with ⟨_, hmm, _, _⟩ | ⟨_, _, _, hmm, _⟩
    · rw [hmm, push_lt (lt_of_get hmt)]; exact hmt
    · rw [hmm]; exact hmt
  have := hpa tm hin' m hmem'
  rw [hml] at this
  exact absurd hcoh (Nat.lt_asymm this)

/-- (U3, fix b) A fetch-op writing a number read a number. -/
theorem apply_fetch_nundef {o : WeakMem.RmwKind} (ho : o.isFetch = true) {x y : WeakMem.Val} {v : Nat}
    (h : o.apply x y = .num v) : x ≠ .undef := by
  rintro rfl
  cases o <;> cases y <;> simp_all [WeakMem.RmwKind.apply, WeakMem.RmwKind.isFetch]

/-- **(P4) A successful RMW at a word unit, memory and credits**: reading
message `m` (at `t`) and writing `wv`, by appending (above everything at `a`)
or by fulfilling an own promise adjacent to `t`. Memory's holding and the
credits change exactly by the word's holding, from `m`'s value to `wv`; the
written message and its predecessor (`m`) are what `MintStep` names. (S4f) At
an own cell `m` is the latest non-promise message (`hown`), and a fulfilled
promise there carries nothing. -/
theorem rmwWordAcc {E : TEnv} {s s' : St} {H : Res} {cr db : Ts → Res} {a : Address} {c : Cell} {n : Nat}
    {P : Proto} {t : Ts} {m : Msg} {wv : WeakMem.Val}
    (hP : ∀ t, t ∈ s.promises → t < s.mem.size) (hH : MemHeld E s H) (hC : PromCr E s cr db)
    (hsto : E.sto a.label = some c) (hat : AtOff c.ty a.offset (.word (.lit n) P))
    (hg : P.ghost = false) (hini : IniAt E.ini c a (.word (.lit n) P)) (hp : pwf P = true)
    (hm : s.mem[t]? = some m) (hloc : m.loc = a) (hin : ∃ v, wv = .num v ∧ InP P v)
    (hcase : (∃ mv, s'.mem = s.mem.push ⟨a, wv, mv⟩ ∧ s'.promises = s.promises ∧
        WeakMem.rmwAdjacent s.mem a t s.mem.size = true) ∨
      (∃ tw pm, tw ∈ s.promises ∧ s'.mem = s.mem ∧ s'.promises = s.promises.erase tw ∧
        s.mem[tw]? = some pm ∧ pm.loc = a ∧ pm.val = wv ∧ WeakMem.rmwAdjacent s.mem a t tw = true))
    (hown : Priv E a.label → t ∉ s.promises ∧
      ∀ (t' : Ts) (m' : Msg), t < t' → s.mem[t']? = some m' → m'.loc = a → t' ∈ s.promises)
    (hnd : s.promises.Nodup) (hmu : m.val ≠ .undef) :
    ∃ H', MemHeld E s' H' ∧ PromCr E s' cr db ∧
      H' + pSum s' cr + pSum s db + wr P n m.val = H + pSum s cr + pSum s' db + wr P n wv ∧
      ∃ (tw : Ts) (m' : Msg), PredAt s'.mem a tw (mw m) ∧ s'.mem[tw]? = some m' ∧ m'.loc = a ∧ m'.val = wv ∧
        (s.promises.Nodup → tw ∉ s'.promises) := by
  have hWA : WordAt E a n P := ⟨c, hsto, hat, hg⟩
  have hWU : WordUnit E a := WordAt_unit hWA
  have ht := lt_of_get hm
  rcases hcase with ⟨mv, hmem, hpr, hadj⟩ | ⟨tw, pm, htw, hmem, hpr, hpm, hpl, hpv, hadj⟩
  · -- append: the new message is the latest at `a`
    obtain ⟨-, hbtw⟩ := rmwAdjacent_spec hadj
    obtain ⟨v, rfl, hv⟩ := hin
    have hl01 : LatestNP s.mem (PromAt E s a) a (mw m) ∧
        LatestNP s'.mem (PromAt E s' a) a (mw ⟨a, .num v, mv⟩) := by
      by_cases hV : Vis E a.label
      · rw [PromAt_word ⟨hWU, hV⟩, PromAt_word ⟨hWU, hV⟩]
        refine ⟨⟨t, m, by simp, hm, hloc, rfl, fun t' m' hlt hm' hl' =>
          absurd hl' (hbtw t' m' hlt (lt_of_get hm') hm')⟩, ?_⟩
        rw [hmem]; exact LatestNP_push_top _ (fun t ht => by cases ht)
      · have ho : Priv E a.label := Classical.byContradiction hV
        rw [PromAt_own ho, PromAt_own ho]
        obtain ⟨hn, hlast⟩ := hown ho
        refine ⟨⟨t, m, hn, hm, hloc, rfl, hlast⟩, ?_⟩
        rw [hmem, hpr]; exact LatestNP_push_top _ hP
    obtain ⟨H', hH', hEq⟩ := heldWord hH hsto hat hg hini hp hl01.1 hl01.2 ⟨v, rfl, hv⟩
      (fun b w hb hl => by
        refine PromAt_atSame ?_ hl
        rw [hmem, hpr]
        exact AtSame_push (fun e => hb e.symm))
    have hpS : ∀ f, pSum s' f = pSum s f := fun f => by unfold pSum; rw [hpr]
    refine ⟨H', hH', PromCr_keep hC hpr hP (fun t ht => by rw [hmem]; exact push_lt ht) (fun _ _ _ _ => rfl),
      ?_, s.mem.size, ⟨a, .num v, mv⟩, ?_, by rw [hmem]; simp, rfl, rfl, fun _ h => ?_⟩
    · rw [hpS, hpS]
      exact Res.ext fun k => by
        have := congrArg (fun R : Res => R k) hEq
        simp only [Res.add_apply, mw] at this ⊢
        omega
    · refine ⟨t, m, ht, by rw [hmem]; rw [push_lt ht]; exact hm, hloc, rfl, fun t' m' h1 h2 h3 => ?_⟩
      rw [hmem, push_lt h2] at h3
      exact hbtw t' m' h1 h2 h3
    · rw [hpr] at h; exact Nat.lt_irrefl _ (hP _ h)
  · obtain ⟨htt, hbtw⟩ := rmwAdjacent_spec hadj
    have hpred : PredAt s.mem a tw (mw m) := ⟨t, m, htt, hm, hloc, rfl, hbtw⟩
    obtain ⟨m0, hm0, hdb, hcr⟩ := hC tw htw
    rw [hpm] at hm0; cases hm0
    have hdb := (DbRes_nInit (by rw [hpl]; exact fun h => hmu (by simpa [mw] using h _ hpred))).1 hdb
    rw [hpl] at hdb hcr
    have e1 := pSum_erase (f := cr) hpr htw
    have e2 := pSum_erase (f := db) hpr htw
    have hC' : PromCr E s' cr db := PromCr_erase hC hpr hP (fun t _ => by rw [hmem]) (fun _ _ _ _ => rfl)
    by_cases hV : Vis E a.label
    · -- fulfil, visible: memory unchanged, the promise's credit pays its debit
      have hH' : MemHeld E s' H := MemHeld_tr hH (fun _ => rfl) (fun _ => rfl) (fun l o w hl => by
        by_cases hw : VisU E ⟨l, o⟩
        · rw [PromAt_word hw] at hl ⊢; rw [hmem]; exact hl
        · refine PromAt_atSame ?_ hl
          rw [hmem, hpr]
          refine AtSame_erase (fun m0 hm0 e => hw ?_)
          rw [hpm] at hm0; cases hm0; rw [← e, hpl]; exact ⟨hWU, hV⟩) id
      have hIW : IniW E a := IniW_word hsto hat hg hini
      have hdb' := WRes_eq_wr hWA ((VRes_vis hV hIW).1 hdb)
      have hcr' : cr tw = wr P n m.val := by
        rcases hcr with ⟨w, hw, hcw⟩ | ⟨hnw, -⟩
        · rw [PredAt_uniq hw hpred] at hcw; exact WRes_eq_wr hWA ((VRes_vis hV hIW).1 hcw)
        · exact absurd hpred (hnw _)
      refine ⟨H, hH', hC', ?_,
        tw, pm, by rw [hmem]; exact hpred, by rw [hmem]; exact hpm, hpl, hpv, fun hnd => ?_⟩
      · rw [e1, e2]
        exact Res.ext fun k => by
          have h1 := congrArg (fun R : Res => R k) hdb'
          have h2 := congrArg (fun R : Res => R k) hcr'
          simp only [Res.add_apply] at h1 h2 ⊢
          simp only [mw, hpv] at h1
          omega
      · rw [hpr]; exact hnd.not_mem_erase
    · -- fulfil, own cell: the reading moves from `m` to the promise; no credits
      have ho : Priv E a.label := Classical.byContradiction hV
      have hdb0 : db tw = .zero := VRes_ownz ho _ _ hdb
      have hcr0 : cr tw = .zero := by
        rcases hcr with ⟨w, -, hcw⟩ | ⟨-, h⟩
        · exact VRes_ownz ho _ _ hcw
        · exact h
      obtain ⟨hn, hlast⟩ := hown ho
      have hl0 : LatestNP s.mem (PromAt E s a) a (mw m) := by
        rw [PromAt_own ho]; exact ⟨t, m, hn, hm, hloc, rfl, hlast⟩
      have hl1 : LatestNP s'.mem (PromAt E s' a) a (mw pm) := by
        rw [PromAt_own ho, hpr, hmem]
        refine ⟨tw, pm, hnd.not_mem_erase, hpm, hpl, rfl, fun t' m' hlt hm' hl' => ?_⟩
        exact (List.mem_erase_of_ne (Nat.ne_of_gt hlt)).2 (hlast t' m' (Nat.lt_trans htt hlt) hm' hl')
      obtain ⟨v, rfl, hv⟩ := hin
      obtain ⟨H', hH', hEq⟩ := heldWord hH hsto hat hg hini hp hl0 hl1 ⟨v, by simp [mw, hpv], hv⟩
        (fun b w hb hl => by
          refine PromAt_atSame ?_ hl
          rw [hmem, hpr]
          exact AtSame_erase (fun m0 hm0 e => hb (by rw [hpm] at hm0; cases hm0; rw [← e]; exact hpl)))
      refine ⟨H', hH', hC', ?_,
        tw, pm, by rw [hmem]; exact hpred, by rw [hmem]; exact hpm, hpl, hpv, fun _ => by rw [hpr]; exact hnd.not_mem_erase⟩
      rw [e1, e2, hdb0, hcr0]
      exact Res.ext fun k => by
        have := congrArg (fun R : Res => R k) hEq
        simp only [Res.add_apply, Res.zero_apply, mw, hpv] at this ⊢
        omega

/-- `rmwWordAcc` with slot lists. -/
theorem rmwWordAccL {E : TEnv} {s s' : St} {H : Res} {Sl : AllocLabel → List Res} {cr db : Ts → Res} {a : Address} {c : Cell} {n : Nat}
    {P : Proto} {t : Ts} {m : Msg} {wv : WeakMem.Val}
    (hP : ∀ t, t ∈ s.promises → t < s.mem.size) (hH : MemHeldL E s H Sl) (hC : PromCr E s cr db)
    (hsto : E.sto a.label = some c) (hat : AtOff c.ty a.offset (.word (.lit n) P))
    (hg : P.ghost = false) (hini : IniAt E.ini c a (.word (.lit n) P)) (hp : pwf P = true)
    (hm : s.mem[t]? = some m) (hloc : m.loc = a) (hin : ∃ v, wv = .num v ∧ InP P v)
    (hcase : (∃ mv, s'.mem = s.mem.push ⟨a, wv, mv⟩ ∧ s'.promises = s.promises ∧
        WeakMem.rmwAdjacent s.mem a t s.mem.size = true) ∨
      (∃ tw pm, tw ∈ s.promises ∧ s'.mem = s.mem ∧ s'.promises = s.promises.erase tw ∧
        s.mem[tw]? = some pm ∧ pm.loc = a ∧ pm.val = wv ∧ WeakMem.rmwAdjacent s.mem a t tw = true))
    (hown : Priv E a.label → t ∉ s.promises ∧
      ∀ (t' : Ts) (m' : Msg), t < t' → s.mem[t']? = some m' → m'.loc = a → t' ∈ s.promises)
    (hnd : s.promises.Nodup) (hmu : m.val ≠ .undef) :
    ∃ H', MemHeldK E s Sl E s' H' ∧ PromCr E s' cr db ∧
      H' + pSum s' cr + pSum s db + wr P n m.val = H + pSum s cr + pSum s' db + wr P n wv ∧
      ∃ (tw : Ts) (m' : Msg), PredAt s'.mem a tw (mw m) ∧ s'.mem[tw]? = some m' ∧ m'.loc = a ∧ m'.val = wv ∧
        (s.promises.Nodup → tw ∉ s'.promises) := by
  have hWA : WordAt E a n P := ⟨c, hsto, hat, hg⟩
  have hWU : WordUnit E a := WordAt_unit hWA
  have ht := lt_of_get hm
  rcases hcase with ⟨mv, hmem, hpr, hadj⟩ | ⟨tw, pm, htw, hmem, hpr, hpm, hpl, hpv, hadj⟩
  · -- append: the new message is the latest at `a`
    obtain ⟨-, hbtw⟩ := rmwAdjacent_spec hadj
    obtain ⟨v, rfl, hv⟩ := hin
    have hl01 : LatestNP s.mem (PromAt E s a) a (mw m) ∧
        LatestNP s'.mem (PromAt E s' a) a (mw ⟨a, .num v, mv⟩) := by
      by_cases hV : Vis E a.label
      · rw [PromAt_word ⟨hWU, hV⟩, PromAt_word ⟨hWU, hV⟩]
        refine ⟨⟨t, m, by simp, hm, hloc, rfl, fun t' m' hlt hm' hl' =>
          absurd hl' (hbtw t' m' hlt (lt_of_get hm') hm')⟩, ?_⟩
        rw [hmem]; exact LatestNP_push_top _ (fun t ht => by cases ht)
      · have ho : Priv E a.label := Classical.byContradiction hV
        rw [PromAt_own ho, PromAt_own ho]
        obtain ⟨hn, hlast⟩ := hown ho
        refine ⟨⟨t, m, hn, hm, hloc, rfl, hlast⟩, ?_⟩
        rw [hmem, hpr]; exact LatestNP_push_top _ hP
    obtain ⟨H', hH', hEq⟩ := heldWordL hH hsto hat hg hini hp hl01.1 hl01.2 ⟨v, rfl, hv⟩
      (fun b w hb hl => by
        refine PromAt_atSame ?_ hl
        rw [hmem, hpr]
        exact AtSame_push (fun e => hb e.symm))
      (fun lo hi h1 h2 => ⟨s.mem.size, ⟨a, .num v, mv⟩, by rw [hmem]; simp, rfl, h1, h2, Or.inl (Nat.le_refl _)⟩)
    have hpS : ∀ f, pSum s' f = pSum s f := fun f => by unfold pSum; rw [hpr]
    refine ⟨H', hH', PromCr_keep hC hpr hP (fun t ht => by rw [hmem]; exact push_lt ht) (fun _ _ _ _ => rfl),
      ?_, s.mem.size, ⟨a, .num v, mv⟩, ?_, by rw [hmem]; simp, rfl, rfl, fun _ h => ?_⟩
    · rw [hpS, hpS]
      exact Res.ext fun k => by
        have := congrArg (fun R : Res => R k) hEq
        simp only [Res.add_apply, mw] at this ⊢
        omega
    · refine ⟨t, m, ht, by rw [hmem]; rw [push_lt ht]; exact hm, hloc, rfl, fun t' m' h1 h2 h3 => ?_⟩
      rw [hmem, push_lt h2] at h3
      exact hbtw t' m' h1 h2 h3
    · rw [hpr] at h; exact Nat.lt_irrefl _ (hP _ h)
  · obtain ⟨htt, hbtw⟩ := rmwAdjacent_spec hadj
    have hpred : PredAt s.mem a tw (mw m) := ⟨t, m, htt, hm, hloc, rfl, hbtw⟩
    obtain ⟨m0, hm0, hdb, hcr⟩ := hC tw htw
    rw [hpm] at hm0; cases hm0
    have hdb := (DbRes_nInit (by rw [hpl]; exact fun h => hmu (by simpa [mw] using h _ hpred))).1 hdb
    rw [hpl] at hdb hcr
    have e1 := pSum_erase (f := cr) hpr htw
    have e2 := pSum_erase (f := db) hpr htw
    have hC' : PromCr E s' cr db := PromCr_erase hC hpr hP (fun t _ => by rw [hmem]) (fun _ _ _ _ => rfl)
    by_cases hV : Vis E a.label
    · -- fulfil, visible: memory unchanged, the promise's credit pays its debit
      have hH' : MemHeldK E s Sl E s' H := MemHeldK_tr hH (fun _ => rfl) (fun _ => rfl) (fun l o w hl => by
        by_cases hw : VisU E ⟨l, o⟩
        · rw [PromAt_word hw] at hl ⊢; rw [hmem]; exact hl
        · refine PromAt_atSame ?_ hl
          rw [hmem, hpr]
          refine AtSame_erase (fun m0 hm0 e => hw ?_)
          rw [hpm] at hm0; cases hm0; rw [← e, hpl]; exact ⟨hWU, hV⟩) id
      have hIW : IniW E a := IniW_word hsto hat hg hini
      have hdb' := WRes_eq_wr hWA ((VRes_vis hV hIW).1 hdb)
      have hcr' : cr tw = wr P n m.val := by
        rcases hcr with ⟨w, hw, hcw⟩ | ⟨hnw, -⟩
        · rw [PredAt_uniq hw hpred] at hcw; exact WRes_eq_wr hWA ((VRes_vis hV hIW).1 hcw)
        · exact absurd hpred (hnw _)
      refine ⟨H, hH', hC', ?_,
        tw, pm, by rw [hmem]; exact hpred, by rw [hmem]; exact hpm, hpl, hpv, fun hnd => ?_⟩
      · rw [e1, e2]
        exact Res.ext fun k => by
          have h1 := congrArg (fun R : Res => R k) hdb'
          have h2 := congrArg (fun R : Res => R k) hcr'
          simp only [Res.add_apply] at h1 h2 ⊢
          simp only [mw, hpv] at h1
          omega
      · rw [hpr]; exact hnd.not_mem_erase
    · -- fulfil, own cell: the reading moves from `m` to the promise; no credits
      have ho : Priv E a.label := Classical.byContradiction hV
      have hdb0 : db tw = .zero := VRes_ownz ho _ _ hdb
      have hcr0 : cr tw = .zero := by
        rcases hcr with ⟨w, -, hcw⟩ | ⟨-, h⟩
        · exact VRes_ownz ho _ _ hcw
        · exact h
      obtain ⟨hn, hlast⟩ := hown ho
      have hl0 : LatestNP s.mem (PromAt E s a) a (mw m) := by
        rw [PromAt_own ho]; exact ⟨t, m, hn, hm, hloc, rfl, hlast⟩
      have hl1 : LatestNP s'.mem (PromAt E s' a) a (mw pm) := by
        rw [PromAt_own ho, hpr, hmem]
        refine ⟨tw, pm, hnd.not_mem_erase, hpm, hpl, rfl, fun t' m' hlt hm' hl' => ?_⟩
        exact (List.mem_erase_of_ne (Nat.ne_of_gt hlt)).2 (hlast t' m' (Nat.lt_trans htt hlt) hm' hl')
      obtain ⟨v, rfl, hv⟩ := hin
      obtain ⟨H', hH', hEq⟩ := heldWordL hH hsto hat hg hini hp hl0 hl1 ⟨v, by simp [mw, hpv], hv⟩
        (fun b w hb hl => by
          refine PromAt_atSame ?_ hl
          rw [hmem, hpr]
          exact AtSame_erase (fun m0 hm0 e => hb (by rw [hpm] at hm0; cases hm0; rw [← e]; exact hpl)))
        (fun lo hi h1 h2 => ⟨tw, pm, by rw [hmem]; exact hpm, by rw [hpl], by rw [hpl]; exact h1, by rw [hpl]; exact h2,
          Or.inr (Or.inr ⟨htw, by rw [hpr]; exact hnd.not_mem_erase⟩)⟩)
      refine ⟨H', hH', hC', ?_,
        tw, pm, by rw [hmem]; exact hpred, by rw [hmem]; exact hpm, hpl, hpv, fun _ => by rw [hpr]; exact hnd.not_mem_erase⟩
      rw [e1, e2, hdb0, hcr0]
      exact Res.ext fun k => by
        have := congrArg (fun R : Res => R k) hEq
        simp only [Res.add_apply, Res.zero_apply, mw, hpv] at this ⊢
        omega
#print axioms rmwWordAccL

