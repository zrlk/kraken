/-- **(P4) Memory's holding across new latest words at a two-word component**
(a protocol or epoch pair) at `a`, `a.next`: both units are word units, so the
readings there are the latest messages; every other address keeps its reading.
The cell's entry trades the component's old resources `R0` (of the old latest
words) for the new ones `Rx`. -/
theorem heldPair {E : TEnv} {s s' : St} {H : Res} {a : Address} {c : Cell} {U : Ty} {x0 x1 : Word} {Rx : Res}
    (hH : MemHeld E s H) (hsto : E.sto a.label = some c) (hat : AtOff c.ty a.offset U)
    (hini : IniAt E.ini c a U) (hwU : wc U = some 2) (hna : ∀ N e, U ≠ .array (.lit N) e)
    (hl1 : LatestNP s'.mem (PromAt E s' a) a x0) (hl1' : LatestNP s'.mem (PromAt E s' a.next) a.next x1)
    (hx : ValOfR E U [x0, x1] Rx)
    (hkeep : ∀ b w, b ≠ a → b ≠ a.next → LatestNP s.mem (PromAt E s b) b w →
      LatestNP s'.mem (PromAt E s' b) b w) :
    ∃ H' w0 w1 R0, MemHeld E s' H' ∧ LatestNP s.mem (PromAt E s a) a w0 ∧
      LatestNP s.mem (PromAt E s a.next) a.next w1 ∧
      VRR (fun _ => 0) (CE E.unsee) U (shp U) [w0, w1] R0 ∧ H' + R0 = H + Rx := by
  obtain ⟨R0, H0, rfl, hent0, hX⟩ := MemHeld_focus hH a.label
  obtain ⟨vals, hL, hC⟩ := hent0.2 c hsto
  obtain ⟨b, o, S, wS, Rs, Rr, -, hbo, hatS, hwS, hbw, hR0, ⟨hvs, hVs⟩, hput⟩ := (own_segR hC hat hini hna).resolve_right (fun ⟨_, _, _, _, _, _, _, hz⟩ => by obtain ⟨uU, hu, hn⟩ := wc_some hwU; have h := hz _ hu; omega)
  have hsl : ((vals.drop b).take wS).length = wS := by
    simp only [List.length_take, List.length_drop]; omega
  obtain ⟨n1, Rq, Rr2, hwn, hle, hRs, hvq, hput2⟩ := VRR_at E.unsee hatS hvs (by rw [hsl]; exact hwS)
  rw [hwU] at hwn
  obtain rfl : 2 = n1 := Option.some.inj hwn
  rw [hsl] at hle
  have hlenv : a.offset + 2 ≤ vals.length := by
    rw [← hbo, Nat.add_assoc]; exact Nat.le_trans (Nat.add_le_add_left hle b) hbw
  have hvqe : (((vals.drop b).take wS).drop o).take 2 = (vals.drop a.offset).take 2 := by
    rw [take_drop_take hle, drop_drop', hbo]
  rw [hvqe] at hvq
  have hg0 : vals[a.offset]? = some vals[a.offset] := List.getElem?_eq_getElem (by omega)
  have hg1 : vals[a.offset + 1]? = some vals[a.offset + 1] := List.getElem?_eq_getElem (by omega)
  have htwo : (vals.drop a.offset).take 2 = [vals[a.offset], vals[a.offset + 1]] := by
    apply List.ext_getElem?; intro i
    rw [slice_get]
    by_cases hi : i < 2
    · rw [iteT hi]
      rcases (show i = 0 ∨ i = 1 by omega) with rfl | rfl
      · simp [hg0]
      · simp [hg1]
    · rw [iteF hi]; simp; omega
  rw [htwo] at hvq
  have ea : (⟨a.label, a.offset⟩ : Address) = a := rfl
  have ea1 : (⟨a.label, a.offset + 1⟩ : Address) = a.next := by simp [WeakMem.Address.next]
  have hw0 : LatestNP s.mem (PromAt E s a) a vals[a.offset] := by
    have := hL a.offset _ hg0; rw [ea] at this; exact this
  have hw1 : LatestNP s.mem (PromAt E s a.next) a.next vals[a.offset + 1] := by
    have := hL (a.offset + 1) _ hg1; rw [ea1] at this; exact this
  have hq := hput2 [x0, x1] Rx hx.1 rfl
  have hQV := (VR_put E.unsee hatS (VRR_VR S (RLink_of (Coh_CE _) (CohR_CE _)) hvs) hVs
    (by rw [hsl]; exact hwS) (VRR_VR _ (RLink_of (Coh_CE _) (CohR_CE _)) hx.1) hx.2 hwU).2.2
  have hQl : (((vals.drop b).take wS).take o ++ [x0, x1] ++ ((vals.drop b).take wS).drop (o + 2)).length = wS := by
    simp only [List.length_append, List.length_take, List.length_drop, List.length_cons, List.length_nil]; omega
  have hcell' := hput _ _ ⟨hq, hQV⟩ hQl
  have hsp := splice_seg vals [x0, x1] b wS o (by simpa using hle)
  rw [show [x0, x1].length = 2 from rfl] at hsp
  rw [hsp, hbo] at hcell'
  have hent : HeldEntry E s' a.label (Rx + Rr2 + Rr) := by
    refine ⟨fun h => (by rw [hsto] at h; cases h), fun c3 hc3 => ?_⟩
    rw [hsto] at hc3; cases hc3
    refine ⟨vals.take a.offset ++ [x0, x1] ++ vals.drop (a.offset + 2), fun (o' : Nat) w hw => ?_, hcell'⟩
    rw [splice_get vals [x0, x1] a.offset 2 o' rfl hlenv] at hw
    by_cases hr : (a.offset : Nat) ≤ o' ∧ o' < (a.offset : Nat) + 2
    · rw [iteT hr] at hw
      obtain ⟨hr1, hr2⟩ := hr
      have hor : o' = a.offset ∨ o' = a.offset + 1 := by
        rcases Nat.lt_or_ge o' (a.offset + 1) with h | h
        · exact Or.inl (Nat.le_antisymm (Nat.le_of_lt_succ h) hr1)
        · exact Or.inr (Nat.le_antisymm (Nat.le_of_lt_succ hr2) h)
      rcases hor with rfl | rfl
      · simp only [Nat.sub_self, List.getElem?_cons_zero, Option.some.injEq] at hw
        subst hw
        rw [ea]; exact hl1
      · simp only [Nat.add_sub_cancel_left, List.getElem?_cons_succ, List.getElem?_cons_zero,
          Option.some.injEq] at hw
        subst hw
        rw [ea1]; exact hl1'
    · rw [iteF hr] at hw
      refine hkeep _ w (fun e => hr ?_) (fun e => hr ?_) (hL o' w hw)
      · have : o' = a.offset := by rw [← e]
        subst this; exact ⟨Nat.le_refl _, Nat.lt_succ_of_lt (Nat.lt_succ_self _)⟩
      · have : o' = a.offset + 1 := by
          have := congrArg (·.offset) e; simpa [WeakMem.Address.next] using this
        subst this; exact ⟨Nat.le_succ _, Nat.lt_succ_self _⟩
  have hX' : MemHeldX E s' a.label H0 := MemHeldX_tr hX (fun _ _ => rfl) (fun _ _ => rfl)
    (fun l' hne o' w hl => hkeep _ w (fun e => hne (by rw [← e]))
      (fun e => hne (by have := congrArg (·.label) e; simpa [WeakMem.Address.next] using this)) hl) id
  refine ⟨_, _, _, Rq, MemHeld_unfocus hX' hent, hw0, hw1, hvq, Res.ext fun k => ?_⟩
  subst hR0; subst hRs
  simp only [Res.add_apply]; omega

/-- `heldPair` with slot lists; the export keeps every untouched slot. -/
theorem heldPairL {E : TEnv} {s s' : St} {H : Res} {Sl : AllocLabel → List Res} {a : Address} {c : Cell} {U : Ty} {x0 x1 : Word} {Rx : Res}
    (hH : MemHeldL E s H Sl) (hsto : E.sto a.label = some c) (hat : AtOff c.ty a.offset U)
    (hini : IniAt E.ini c a U) (hwU : wc U = some 2) (hna : ∀ N e, U ≠ .array (.lit N) e)
    (hl1 : LatestNP s'.mem (PromAt E s' a) a x0) (hl1' : LatestNP s'.mem (PromAt E s' a.next) a.next x1)
    (hx : ValOfR E U [x0, x1] Rx)
    (hkeep : ∀ b w, b ≠ a → b ≠ a.next → LatestNP s.mem (PromAt E s b) b w →
      LatestNP s'.mem (PromAt E s' b) b w)
    (htA : ∀ lo hi, lo ≤ a.offset → a.offset < hi → TouchS s s' a.label lo hi) :
    ∃ H' w0 w1 R0, MemHeldK E s Sl E s' H' ∧ LatestNP s.mem (PromAt E s a) a w0 ∧
      LatestNP s.mem (PromAt E s a.next) a.next w1 ∧
      VRR (fun _ => 0) (CE E.unsee) U (shp U) [w0, w1] R0 ∧ H' + R0 = H + Rx := by
  obtain ⟨H0, rfl, hent0, hX⟩ := MemHeldL_focus hH a.label
  obtain ⟨vals, hL, hC⟩ := hent0.2 c hsto
  obtain ⟨b, o, S, wS, kk, Rs, hseg, hbo, hatS, hwS, hbw, hkk, ⟨hvs, hVs⟩, hkb, hput⟩ := (own_segL (Nat.le_refl _) hC hat hini hna).resolve_right (fun ⟨_, _, _, _, _, _, _, hz⟩ => by obtain ⟨uU, hu, hn⟩ := wc_some hwU; have h := hz _ hu; omega)
  have hsl : ((vals.drop b).take wS).length = wS := by
    simp only [List.length_take, List.length_drop]; omega
  obtain ⟨n1, Rq, Rr2, hwn, hle, hRs, hvq, hput2⟩ := VRR_at E.unsee hatS hvs (by rw [hsl]; exact hwS)
  rw [hwU] at hwn
  obtain rfl : 2 = n1 := Option.some.inj hwn
  rw [hsl] at hle
  have hlenv : a.offset + 2 ≤ vals.length := by
    rw [← hbo, Nat.add_assoc]; exact Nat.le_trans (Nat.add_le_add_left hle b) hbw
  have hvqe : (((vals.drop b).take wS).drop o).take 2 = (vals.drop a.offset).take 2 := by
    rw [take_drop_take hle, drop_drop', hbo]
  rw [hvqe] at hvq
  have hg0 : vals[a.offset]? = some vals[a.offset] := List.getElem?_eq_getElem (by omega)
  have hg1 : vals[a.offset + 1]? = some vals[a.offset + 1] := List.getElem?_eq_getElem (by omega)
  have htwo : (vals.drop a.offset).take 2 = [vals[a.offset], vals[a.offset + 1]] := by
    apply List.ext_getElem?; intro i
    rw [slice_get]
    by_cases hi : i < 2
    · rw [iteT hi]
      rcases (show i = 0 ∨ i = 1 by omega) with rfl | rfl
      · simp [hg0]
      · simp [hg1]
    · rw [iteF hi]; simp; omega
  rw [htwo] at hvq
  have ea : (⟨a.label, a.offset⟩ : Address) = a := rfl
  have ea1 : (⟨a.label, a.offset + 1⟩ : Address) = a.next := by simp [WeakMem.Address.next]
  have hw0 : LatestNP s.mem (PromAt E s a) a vals[a.offset] := by
    have := hL a.offset _ hg0; rw [ea] at this; exact this
  have hw1 : LatestNP s.mem (PromAt E s a.next) a.next vals[a.offset + 1] := by
    have := hL (a.offset + 1) _ hg1; rw [ea1] at this; exact this
  have hq := hput2 [x0, x1] Rx hx.1 rfl
  have hQV := (VR_put E.unsee hatS (VRR_VR S (RLink_of (Coh_CE _) (CohR_CE _)) hvs) hVs
    (by rw [hsl]; exact hwS) (VRR_VR _ (RLink_of (Coh_CE _) (CohR_CE _)) hx.1) hx.2 hwU).2.2
  have hQl : (((vals.drop b).take wS).take o ++ [x0, x1] ++ ((vals.drop b).take wS).drop (o + 2)).length = wS := by
    simp only [List.length_append, List.length_take, List.length_drop, List.length_cons, List.length_nil]; omega
  have hcell' := hput _ _ ⟨hq, hQV⟩ hQl
  have hsp := splice_seg vals [x0, x1] b wS o (by simpa using hle)
  rw [show [x0, x1].length = 2 from rfl] at hsp
  rw [hsp, hbo] at hcell'
  have hent : HeldEntryL E s' a.label ((Sl a.label).set kk (Rx + Rr2)) := by
    refine ⟨fun h => (by rw [hsto] at h; cases h), fun c3 hc3 => ?_⟩
    rw [hsto] at hc3; cases hc3
    refine ⟨vals.take a.offset ++ [x0, x1] ++ vals.drop (a.offset + 2), fun (o' : Nat) w hw => ?_, hcell'⟩
    rw [splice_get vals [x0, x1] a.offset 2 o' rfl hlenv] at hw
    by_cases hr : (a.offset : Nat) ≤ o' ∧ o' < (a.offset : Nat) + 2
    · rw [iteT hr] at hw
      obtain ⟨hr1, hr2⟩ := hr
      have hor : o' = a.offset ∨ o' = a.offset + 1 := by
        rcases Nat.lt_or_ge o' (a.offset + 1) with h | h
        · exact Or.inl (Nat.le_antisymm (Nat.le_of_lt_succ h) hr1)
        · exact Or.inr (Nat.le_antisymm (Nat.le_of_lt_succ hr2) h)
      rcases hor with rfl | rfl
      · simp only [Nat.sub_self, List.getElem?_cons_zero, Option.some.injEq] at hw
        subst hw
        rw [ea]; exact hl1
      · simp only [Nat.add_sub_cancel_left, List.getElem?_cons_succ, List.getElem?_cons_zero,
          Option.some.injEq] at hw
        subst hw
        rw [ea1]; exact hl1'
    · rw [iteF hr] at hw
      refine hkeep _ w (fun e => hr ?_) (fun e => hr ?_) (hL o' w hw)
      · have : o' = a.offset := by rw [← e]
        subst this; exact ⟨Nat.le_refl _, Nat.lt_succ_of_lt (Nat.lt_succ_self _)⟩
      · have : o' = a.offset + 1 := by
          have := congrArg (·.offset) e; simpa [WeakMem.Address.next] using this
        subst this; exact ⟨Nat.le_succ _, Nat.lt_succ_self _⟩
  have hX' : MemHeldXL E s' a.label H0 Sl := MemHeldXL_tr hX (fun _ _ => rfl) (fun _ _ => rfl)
    (fun l' hne o' w hl => hkeep _ w (fun e => hne (by rw [← e]))
      (fun e => hne (by have := congrArg (·.label) e; simpa [WeakMem.Address.next] using this)) hl) id
  have hkl : kk < (Sl a.label).length := (List.getElem?_eq_some_iff.1 hkk).1
  have hR0 : Res.sum (Sl a.label) = Rs + Res.sum ((Sl a.label).set kk .zero) := by
    rw [Res.sum_set_zero _ kk hkl, (List.getElem?_eq_some_iff.1 hkk).2]
  have hK := MemHeldK_slotSet (E0 := E) (s0 := s) hX' hent (fun c1 N e us1 hc1 hT hu1 => by
    rw [hsto] at hc1; cases hc1
    obtain ⟨hb, -⟩ := hkb N e us1 hT hu1
    have hw := seg_arr_width hseg hT hu1 hwS
    refine htA _ _ (by rw [← hbo, hb]; exact Nat.le_add_right _ _) ?_
    have h1 : o + 2 ≤ wS := hle
    rw [← hbo, hb, Nat.succ_mul]; exact Nat.add_lt_add_left (by rw [← hw]; omega) _)
  rw [Res.sum_set _ kk _ hkl] at hK
  refine ⟨_, _, _, Rq, hK, hw0, hw1, hvq, Res.ext fun k => ?_⟩
  rw [hR0]; subst hRs
  simp only [Res.add_apply]; omega
