/-! ### (P4 step 3, W2) Protocol-word `cas`, with resources -/

theorem rmwNewVal_dataE (r0 w r2 : Word) : Promises.rmwNewVal (regsOf r0 w r2) (dataE 1 w) = w.val := by
  cases h : w.val <;> simp [dataE, h, Promises.rmwNewVal, regsOf]

theorem InP_of_st {ρ : Nat → Nat} {cx : Cx} {P : Proto} {j k' : Idx} {c₂ : Nat}
    (hsat : Sat cx.facts ρ) (hst : InState cx P j c₂ k') : InP P (ev ρ j) := by
  obtain ⟨cl', hcl', hent⟩ := hst
  exact ⟨c₂, cl', ev ρ k', hcl', hent ρ hsat⟩

theorem holds_of_st {ρ : Nat → Nat} {cx : Cx} {P : Proto} {i k : Idx} {c : Nat} {cl : Clause}
    (hg : P.ghost = false) (hsat : Sat cx.facts ρ) (hst : InState cx P i c k)
    (hcl : P.clauses[c]? = some cl) (hh : cl.holds = true) : WordHolds P [.num (ev ρ i)] := by
  obtain ⟨cl0, h0, hent⟩ := hst
  rw [hcl] at h0; cases h0
  exact ⟨hg, ev ρ i, c, cl, ev ρ k, rfl, hcl, hh, hent ρ hsat⟩

theorem nholds_of_st {ρ : Nat → Nat} {cx : Cx} {P : Proto} {i k : Idx} {c : Nat} {cl : Clause}
    (hp : pwf P = true) (hsat : Sat cx.facts ρ) (hst : InState cx P i c k)
    (hcl : P.clauses[c]? = some cl) (hh : cl.holds = false) : ¬ WordHolds P [.num (ev ρ i)] := by
  obtain ⟨cl0, h0, hent⟩ := hst
  rw [hcl] at h0; cases h0
  rintro ⟨-, n, c2, cl2, k2, hv, hc2, hh2, hn⟩
  simp only [List.cons.injEq, WeakMem.Val.num.injEq, and_true] at hv
  have e := pwf_disjoint (n := ev ρ i) hp hcl hc2 (by rw [hent ρ hsat]; exact inCl_of cl _) (by rw [hv, hn]; exact inCl_of cl2 k2)
  subst e
  rw [hcl] at hc2; cases hc2
  rw [hh] at hh2; cases hh2

theorem epoch_succ {ρ : Nat → Nat} {cx : Cx} {P : Proto} {i j k k' : Idx} {c c' : Nat}
    (hp : pwf P = true) (he : P.epoch = true) (hsat : Sat cx.facts ρ)
    (hi : InState cx P i c k) (hj : InState cx P j c' k') (hs : Step cx P c k c' k') :
    ev ρ j = ev ρ i + 1 := by
  have hok := pwf_epochOK hp he
  simp only [epochOK, Bool.and_eq_true, beq_iff_eq] at hok
  obtain ⟨⟨⟨⟨⟨⟨hcl, htr⟩, hw⟩, -⟩, -⟩, -⟩, -⟩ := hok
  obtain ⟨a, ha, hia⟩ := hi
  obtain ⟨b, hb, hjb⟩ := hj
  have e1 := hia ρ hsat
  have e2 := hjb ρ hsat
  rw [hcl] at ha hb
  rcases hs with ⟨dk, hdk, hent⟩ | hw'
  · rw [htr] at hdk
    simp only [List.mem_singleton, Prod.mk.injEq] at hdk
    obtain ⟨rfl, rfl, rfl⟩ := hdk
    simp only [List.getElem?_cons_zero, Option.some.injEq] at ha hb
    subst ha; subst hb
    have e3 := hent ρ hsat
    simp only at e1 e2
    omega
  · simp only [List.isEmpty_iff] at hw
    rw [hw] at hw'; cases hw'

theorem ShareMove_lit {P : Proto} {c c' : Nat} {k k' : Idx} {d : Int} (ρ : Nat → Nat)
    (h : ShareMove P c k c' k' d) : ShareMove P c (.lit (ev ρ k)) c' (.lit (ev ρ k')) d := by
  cases h with
  | none h1 h2 h3 h4 => exact .none h1 h2 h3 h4
  | stay h1 h2 h3 => exact .stay h1 h2 (fun _ => h3 ρ)
  | up h1 h2 h3 => exact .up h1 h2 (fun _ => h3 ρ)
  | down h1 h2 h3 => exact .down h1 h2 (fun _ => h3 ρ)
  | enter h1 h2 h3 h4 h5 => exact .enter h1 h2 h3 h4 (fun _ => h5 ρ)
  | leave h1 h2 h3 h4 h5 => exact .leave h1 h2 h3 h4 (fun _ => h5 ρ)
  | dlend h1 h3 => exact .dlend h1 (fun _ => h3 ρ)
  | dret h1 h3 => exact .dret h1 (fun _ => h3 ρ)
  | dstay h1 h3 => exact .dstay h1 (fun _ => h3 ρ)

theorem Enc_of_st {ρ : Nat → Nat} {cx : Cx} {P : Proto} {i k : Idx} {c : Nat}
    (hsat : Sat cx.facts ρ) (hst : InState cx P i c k) : Enc P c (ev ρ k) (ev ρ i) := by
  obtain ⟨cl, hcl, hent⟩ := hst
  exact ⟨cl, hcl, hent ρ hsat⟩

/-- (P4) The word a reference (pointer or locative) to a protocol word targets. -/
theorem wordTarget {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {K : TEnv → List Word → Prop}
    {cx : Cx} {env : Env} {w : At} {tw : Ty} {μ : Mode} {r : Idx} {P : Proto}
    (hi : FInv ρ η σs K cx env) (hpk : cx.peek w = .ok tw) (hc : cellOf tw = some (μ, .word r P))
    (hg : P.ghost = false) :
    ∃ rt pw ad c, evalAt env w = some (rt, [pw]) ∧ pw.val = .loc ad 0 ∧ η.sto ad.label = some c ∧
      AtOff c.ty ad.offset (.word (.lit (ev ρ r)) P) ∧ IniAt η.ini c ad (.word (.lit (ev ρ r)) P) := by
  have hcl : cl ρ η.wit 0 0 (.word r P) = .word (.lit (ev ρ r)) P := by simp [cl, clI_zero]
  obtain ⟨rt, ws, hea, hv, -⟩ := peek_VR hi.2.1 hpk
  obtain ⟨ad, c, hws, hsto, hat, -, hini⟩ :=
    cell_target hc (Fd_noarr (by rw [hcl, accs_word hg]; simp)) hv
  obtain ⟨pw, rfl, hpw⟩ := map_singleton hws
  rw [hcl] at hat hini
  exact ⟨rt, pw, ad, c, hea, hpw, hsto, hat, (IniAt_mono (modeIni_le_ini _ _ _) hini)⟩

theorem pSum_withS (mem' : Memory) (pairs : List Ts) (X : TTh) (S : St) (f : Ts → Res) :
    pSum (stOf mem' pairs (withS X S)) f = Res.sum (S.promises.map f) := rfl

theorem pSum_stOf (mem : Memory) (pairs : List Ts) (th : TTh) (f : Ts → Res) :
    pSum (stOf mem pairs th) f = Res.sum (th.promises.map f) := rfl


/-- **(P4) A protocol word's `cas`, with resources**, given the word's cell
(`hcell`, from `casWordCell`/`wordLocCell`), its target (`wordTarget`) and the
success frame: failure keeps everything (memory, holding, credits; no mint);
success moves the word from `ew` to `nw` (`rmwWordAcc`), which the success
frame pays for (`hres`) with the mint `hmint` licenses. -/
theorem casWordC_core {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx cok : Cx} {ρ : Nat → Nat} {η : TEnv} {acq rel : Bool} {w e v : At} {t : String} {ok fail : Expr}
    {P : Proto} {n : Nat} {ad : Address} {c : Cell} {pw ew nw : Word} {rw rte rtv : Ty}
    {Rf Rs Rok H C F : Res} {cr db : Ts → Res}
    (hterm : th.term = .cas acq rel w e v t ok fail)
    (hea : evalAt th.env w = some (rw, [pw])) (haddr : addrOf pw = some ad)
    (hee : evalAt th.env e = some (rte, [ew])) (hev : evalAt th.env v = some (rtv, [nw]))
    (hne : loadUnits g.arch pw ad acq [.one] 0 (stOf mem pairs th) ≠ [])
    (hcell : ∀ s1 ws, (s1, ws) ∈ loadUnits g.arch pw ad acq [.one] 0 (stOf mem pairs th) → PromAbove s1 →
        MemInv g (CE η) s1 ∧ ∀ s1', MemInv g (CE η) s1' →
          ∀ s2, s2 ∈ storeUnits g.k g.arch pw ad rel [.one] [nw] 0 s1' → MemInv g (CE η) s2)
    (hsto : η.sto ad.label = some c) (hat : AtOff c.ty ad.offset (.word (.lit n) P))
    (hini : IniAt η.ini c ad (.word (.lit n) P)) (hg : P.ghost = false) (hpwf : pwf P = true)
    (hnin : ∃ k, nw.val = .num k ∧ InP P k) (hnd : th.promises.Nodup)
    (hok : TypedK p η cok ok) (htvok : TvOK cok)
    (hiok : FInvR ρ η th.σs (ResumeR p th.stack Rs) cok ((t, .unit, []) :: th.env) Rok)
    (hres : Rok + wr P n nw.val + C ≤ Rf + wr P n ew.val + F)
    (hmint : ∀ (s' : St) (tw : Ts) (w0 : Word) (m' : Msg), PredAt s'.mem ad tw w0 → w0.val = ew.val →
        s'.mem[tw]? = some m' → m'.loc = ad → m'.val = nw.val → tw ∉ s'.promises →
        MintStepN g η (stOf mem pairs th) s' C F)
    (hfail : TypedK p η cx fail)
    (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hrmw : NoPlantRMW (CE η) th)
    (hewu : ew.val ≠ .undef) (hRPf : RetPw th.σs th.stack cx.ret) (hRPo : RetPw th.σs th.stack cok.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  have key : tstep g mem pairs th =
      (Promises.stepRmw g.k g.arch mem pairs (mth (stOf mem pairs th) pw nw nw) 1 ad (.cas ew.val)
          (dataE 1 nw) [0] acq rel).map fun (mem', th') =>
        (mem', pairs, withS (if (th'.regs 1).val == ew.val then
            { th with term := ok, env := (t, .unit, []) :: th.env } else { th with term := fail })
          ⟨mem', pairs, th'.vs, th'.promises, th.nalloc, th.undefs + countUndef [th'.regs 1]⟩) := by
    simp only [tstep, hterm, hea, hee, hev, haddr]; rfl
  rw [key] at ⊢
  refine ⟨fun h => stepRmw_ne_nil (loadUnits_one_msg hne) (List.map_eq_nil_iff.1 h), fun r hr hpr0 => ?_⟩
  have hpr := hpr0
  rw [List.mem_map] at hr
  obtain ⟨⟨mem', th'⟩, hin, rfl⟩ := hr
  obtain ⟨s1, rd, hl1, hrd, hpS, hcase⟩ := stepRmw_splitP (s := stOf mem pairs th) hin
  obtain ⟨tm, m, hmt, hml, hrv, hmc, hhid, hcoh⟩ := stepRmw_memR hin
  obtain ⟨hm1, hst2⟩ := hcell s1 [rd] hl1 (hpS (fun t ht m hm => hpr t ht m hm))
  have hP : ∀ t, t ∈ (stOf mem pairs th).promises → t < (stOf mem pairs th).mem.size :=
    fun t ht => hm.2.2.1 t ht
  rcases hcase with ⟨hne', hsame⟩ | ⟨heq, s2, hs2, hsame⟩
  · have hb : ((th'.regs 1).val == ew.val) = false := by rw [hrd]; simpa using hne'
    simp only [hb]
    have hfl : mem' = mem ∧ th'.promises = th.promises := by
      rcases hmc with ⟨-, h1, h2⟩ | ⟨hs, -⟩
      · exact ⟨h1, h2⟩
      · exfalso
        simp only [WeakMem.rmwSucceeds, WeakMem.RmwKind.succeeds, decide_eq_true_eq] at hs
        rw [hrd] at hrv; exact hne' (hrv.trans hs)
    obtain ⟨rfl, hpr⟩ := hfl
    refine ⟨Rf + Rs, H, .zero, .zero, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, cx, Rf, Rs, rfl, hE, hfail, htv, hi, rfl, hRPf⟩,
      MemInv_same (MemInv_lockS g.arch hm1) hsame, MemHeldK_eqs hH rfl hpr,
      PromCr_keep hC hpr hP (fun t _ => rfl) (fun _ _ _ _ => rfl)⟩, MintStepN.none, ?_⟩
    simp only [pSum, stOf, withS, hpr]
    exact Res.le_def.2 fun k => by simp only [Res.add_apply]; omega
  · have hb : ((th'.regs 1).val == ew.val) = true := by rw [hrd]; simpa using heq
    simp only [hb, ite_true]
    have hmv : m.val = ew.val := by rw [← hrv, hrd]; exact heq
    rcases hmc with ⟨hs, -⟩ | ⟨hsc, hcs⟩
    · exfalso
      simp [WeakMem.rmwSucceeds, WeakMem.RmwKind.succeeds, hmv] at hs
    have hwv : WeakMem.RmwKind.apply (.cas ew.val) m.val
        (Promises.rmwNewVal (mth (stOf mem pairs th) pw nw nw).regs (dataE 1 nw)) = nw.val := by
      simp only [WeakMem.RmwKind.apply, mth]; exact rmwNewVal_dataE pw nw nw
    rw [hwv] at hcs
    obtain ⟨H', hH', hC', hEq, tw, m', hpred, hm', hl', hv', hnp⟩ :=
      rmwWordAccL (E := CE η) (s := stOf mem pairs th)
        (s' := ⟨mem', pairs, th'.vs, th'.promises, th.nalloc, th.undefs + countUndef [th'.regs 1]⟩)
        hP hH hC hsto hat hg hini hpwf hmt hml hnin hcs
        (rmw_ownLatest (E := CE η) (s := stOf mem pairs th) hm (fun hp => hrmw w _ pw ad (.inl ⟨_, _, _, _, _, _, _, hterm⟩) hea haddr hp.1 hp.2) hsto hat hg hini hmt hml hhid (hcoh hsc) hcs
          (fun t ht m hm => hpr t ht m hm)) hnd (by rw [hmv]; exact hewu)
    refine ⟨Rok + Rs, H', C, F, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, cok, Rok, Rs, rfl, hE, hok, htvok, hiok, rfl, hRPo⟩,
      MemInv_same (MemInv_lockS g.arch
        (MemInv_setRel (hst2 _ (MemInv_bumpRel (MemInv_lockR g.arch (stOf mem pairs th) hm1) _) s2 hs2) (MemInv_lockR g.arch (stOf mem pairs th) hm1).2.2.2.2.1)) hsame, hH', hC'⟩,
      hmint _ tw (mw m) m' hpred (by simp [mw, hmv]) hm' hl' hv' (hnp hnd), ?_⟩
    simp only [pSum, stOf, withS] at hEq ⊢
    exact Res.le_def.2 fun k => by
      have h1 := hres k
      have h2 := congrArg (fun R : Res => R k) hEq
      simp only [Res.add_apply] at h1 h2 ⊢
      rw [hmv] at h2
      omega


/-- (P4) The output of the `cas` cell lemmas (`casWordCell`, `wordLocCell`). -/
def CasCell (g : G) (mem : Memory) (pairs : List Ts) (th : TTh) (η : TEnv) (acq rel : Bool) (w : At)
    (nw : Word) : Prop :=
  ∃ ad pw rw, evalAt th.env w = some (rw, [pw]) ∧ addrOf pw = some ad ∧
    loadUnits g.arch pw ad acq [.one] 0 (stOf mem pairs th) ≠ [] ∧
    ∀ s1 ws, (s1, ws) ∈ loadUnits g.arch pw ad acq [.one] 0 (stOf mem pairs th) → PromAbove s1 →
      MemInv g (CE η) s1 ∧ ∀ s1', MemInv g (CE η) s1' →
        ∀ s2, s2 ∈ storeUnits g.k g.arch pw ad rel [.one] [nw] 0 s1' → MemInv g (CE η) s2

/-- `casWordC_core` from the reference's static type: the operands' values,
the word target, matched with the cell lemma's address. -/
theorem casWordC_mid {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx cok : Cx} {ρ : Nat → Nat} {η : TEnv} {acq rel : Bool} {w e v : At} {t : String} {ok fail : Expr}
    {tw : Ty} {μ : Mode} {r i j k' : Idx} {P : Proto} {c₂ : Nat} {Rf Rs Rok H C F : Res} {cr db : Ts → Res}
    (hterm : th.term = .cas acq rel w e v t ok fail)
    (hpk : cx.peek w = .ok tw) (hcw : cellOf tw = some (μ, .word r P)) (hg : P.ghost = false)
    (hpwf : pwf P = true)
    (hie : IntIdx cx e i) (hj : IntIdx cx v j) (hst : InState cx P j c₂ k')
    (hcellL : ∀ nw : Word, nw.val = .num (ev ρ j) → CasCell g mem pairs th η acq rel w nw)
    (hnd : th.promises.Nodup)
    (hok : TypedK p η cok ok) (htvok : TvOK cok)
    (hiok : FInvR ρ η th.σs (ResumeR p th.stack Rs) cok ((t, .unit, []) :: th.env) Rok)
    (hres : Rok + wr P (ev ρ r) (.num (ev ρ j)) + C ≤ Rf + wr P (ev ρ r) (.num (ev ρ i)) + F)
    (hmint : ∀ (s' : St) (ad : Address) (tw : Ts) (w0 : Word) (m' : Msg), WordAt (CE η) ad (ev ρ r) P →
        PredAt s'.mem ad tw w0 → w0.val = .num (ev ρ i) →
        s'.mem[tw]? = some m' → m'.loc = ad → m'.val = .num (ev ρ j) → tw ∉ s'.promises →
        MintStepN g η (stOf mem pairs th) s' C F)
    (hfail : TypedK p η cx fail)
    (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hrmw : NoPlantRMW (CE η) th) (hRP : RetPw th.σs th.stack cx.ret) (hRPo : RetPw th.σs th.stack cok.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  obtain ⟨te, hte, hio⟩ := hie
  obtain ⟨rte, ew, hee, hewv, -⟩ := atom_num hi.1.2.1 hte hio
  obtain ⟨tv, htvk, hjo⟩ := hj
  obtain ⟨rtv, nw, hev, hnwv, -⟩ := atom_num hi.1.2.1 htvk hjo
  obtain ⟨ad, pw, rw, hea, haddr, hne, hcell⟩ := hcellL nw hnwv
  obtain ⟨rt2, pw2, ad2, c, hea2, hpw2, hsto, hat, hini⟩ := wordTarget hi.1 hpk hcw hg
  rw [hea] at hea2
  simp only [Option.some.injEq, Prod.mk.injEq, List.cons.injEq, and_true] at hea2
  obtain ⟨-, rfl⟩ := hea2
  obtain rfl : ad2 = ad := by simp only [addrOf, hpw2, Option.some.injEq] at haddr; exact haddr
  exact casWordC_core hterm hea haddr hee hev hne hcell hsto hat hini hg hpwf
    ⟨_, hnwv, InP_of_st hi.1.1 hst⟩ hnd hok htvok hiok (by rw [hewv, hnwv]; exact hres)
    (fun s' tw w0 m' h1 h2 h3 h4 h5 h6 =>
      hmint s' ad2 tw w0 m' ⟨c, hsto, hat, hg⟩ h1 (h2.trans hewv) h3 h4 (h5.trans hnwv) h6)
    hfail hi hE htv hm hH hC hrmw (by rw [hewv]; intro h; cases h) hRP hRPo

theorem wr_holds {P : Proto} {n : Nat} {a : WeakMem.Val} (h : WordHolds P [a]) :
    wr P n a = .one (.rg n) := by simp [wr, h]

theorem wr_nholds {P : Proto} {n : Nat} {a : WeakMem.Val} (h : ¬ WordHolds P [a]) :
    wr P n a = .zero := by simp [wr, h]

theorem take_res {P : Proto} {n : Nat} {a b : WeakMem.Val} (Rf : Res) (ha : WordHolds P [a])
    (hb : ¬ WordHolds P [b]) : Rf + Res.one (.rg n) + wr P n b + .zero ≤ Rf + wr P n a + .zero := by
  rw [wr_holds ha, wr_nholds hb]
  exact Res.le_def.2 fun k => by simp only [Res.add_apply, Res.zero_apply]; omega

theorem mint_res {P : Proto} {n : Nat} {a b : WeakMem.Val} {Rf R : Res} (h : wr P n b = wr P n a) :
    Rf + R + wr P n b + .zero ≤ Rf + wr P n a + R := by
  rw [h]
  exact Res.le_def.2 fun k => by simp only [Res.add_apply, Res.zero_apply]; omega

/-- **(P4) A protocol word's `cas`, with resources, by its typing rule**:
`casShare` (no lend: nothing moves; lend up: a fresh `share` minted by
`MintStep.share`; lend down: the returned share is dropped), `casTake` (the
word's region token moves from memory to the bound token) and `casEpoch` (an
epoch token minted by `MintStep.epoch`, the counter keeps holding). -/
theorem casWordC_typed {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {acq rel : Bool} {w e v : At} {t : String} {ok fail : Expr}
    {tw : Ty} {μ : Mode} {r : Idx} {P : Proto} {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .cas acq rel w e v t ok fail)
    (hpk : cx.peek w = .ok tw) (hcw : cellOf tw = some (μ, .word r P)) (hwo : wordOf tw = some (r, P))
    (hg : P.ghost = false) (hpwf : pwf P = true)
    (hL : ∀ {j k' : Idx} {c₂ : Nat}, InState cx P j c₂ k' → ∀ nw : Word, nw.val = .num (ev ρ j) →
      CasCell g mem pairs th η acq rel w nw)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hrmw : NoPlantRMW (CE η) th)
    (hnd : th.promises.Nodup) (hRP : RetPw th.σs th.stack cx.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  have hsat : Sat cx.facts ρ := hi.1.1
  have hRL := RLink_of hE.2.1 hE.2.2
  have hT0 := hT
  have hCk0 := hCk
  rw [hterm] at hT0 hCk0
  cases TermA4.CkW_inv_cas hCk0 with
  | casCell hp hnw => exfalso; rw [hpk] at hp; cases hp; rw [hwo] at hnw; cases hnw
  | casShare hp hw _ hie hj hsti hcl hst hcl' hh _ hh' hlend hok hfail =>
    rw [hpk] at hp; cases hp
    rw [hwo] at hw; simp only [Option.some.injEq, Prod.mk.injEq] at hw; obtain ⟨rfl, rfl⟩ := hw
    have hwe := (wr_holds (n := ev ρ r) (holds_of_st hg hsat hst hcl' hh')).trans
      (wr_holds (n := ev ρ r) (holds_of_st hg hsat hsti hcl hh)).symm
    have htv2 := LendCx_TvOK hlend htv
    cases hlend with
    | none hsm hb =>
      have hiok := bindR hb hi hRL (show VRR ρ η .unit (shp .unit) [] .zero from rfl) (unit_Lay _)
      exact casWordC_mid (C := .zero) (F := .zero) hterm hpk hcw hg hpwf hie hj hst (hL hst) hnd hok.tk htv2 hiok
        (by (try dsimp only); rw [hwe]; exact Res.le_def.2 fun k => by simp only [Res.add_apply, Res.zero_apply]; omega)
        (fun _ _ _ _ _ _ _ _ _ _ _ _ => MintStepN.none) hfail.tk hi hE htv hm hH hC hrmw hRP (retPw_eq hRP (by first | exact (bind_ret hb :) | exact (bind_ret hb).trans (use_ret hu)))
    | up hsm _ hb =>
      have hiok := bindR (rt := .unit) (ws := []) (R := .one (.sh (ev ρ r))) hb hi hRL rfl (Lay_etok_unit rfl)
      exact casWordC_mid (C := .zero) (F := .one (.sh (ev ρ r))) hterm hpk hcw hg hpwf hie hj hst (hL hst)
        hnd hok.tk htv2 hiok
        (by (try dsimp only); rw [hwe]; exact Res.le_def.2 fun k => by simp only [Res.add_apply, Res.zero_apply]; omega)
        (fun _ _ _ _ _ hW h1 h2 h3 h4 h5 h6 =>
          MintStepN.share hW (ShareMove_lit ρ hsm) h1 h2 (Enc_of_st hsat hsti) h3 h4 h5 (Enc_of_st hsat hst) h6)
        hfail.tk hi hE htv hm hH hC hrmw hRP (retPw_eq hRP (by first | exact (bind_ret hb :) | exact (bind_ret hb).trans (use_ret hu)))
    | down _ _ _ _ hu hb =>
      obtain ⟨-, -, R, Rr, -, -, -, -, hi1, hle⟩ := useR hu hi hE.2.2
      have hiok := bindR hb hi1 hRL (show VRR ρ η .unit (shp .unit) [] .zero from rfl) (unit_Lay _)
      exact casWordC_mid (C := .zero) (F := .zero) hterm hpk hcw hg hpwf hie hj hst (hL hst) hnd hok.tk htv2 hiok
        (by
          rw [hwe]
          exact Res.le_def.2 fun k => by
            have := hle k
            simp only [Res.add_apply, Res.zero_apply] at this ⊢; omega)
        (fun _ _ _ _ _ _ _ _ _ _ _ _ => MintStepN.none) hfail.tk hi hE htv hm hH hC hrmw hRP (retPw_eq hRP (by first | exact (bind_ret hb :) | exact (bind_ret hb).trans (use_ret hu)))
  | casTake hp hw hgh hie hj hsti hcl hst hcl' hh hstp hh' hl1 hl2 hacq hb hok hfail =>
    rw [hpk] at hp; cases hp
    rw [hwo] at hw; simp only [Option.some.injEq, Prod.mk.injEq] at hw; obtain ⟨rfl, rfl⟩ := hw
    have hiok := bindR (rt := .unit) (ws := []) hb hi hRL rfl (Lay_etok_unit rfl)
    have htv' := (bind_TvOK hb htv (by simp [tb]) (by simp [mg])).1
    have hres := take_res (n := ev ρ r) Rf (holds_of_st hg hsat hsti hcl hh) (nholds_of_st hpwf hsat hst hcl' hh')
    split at hok
    · exact casWordC_mid (C := .zero) (F := .zero) hterm hpk hcw hg hpwf hie hj hst (hL hst) hnd hok.tk htv' hiok
        hres (fun _ _ _ _ _ _ _ _ _ _ _ _ => MintStepN.none) hfail.tk hi hE htv hm hH hC hrmw hRP (retPw_eq hRP (by first | exact (bind_ret hb :) | exact (bind_ret hb).trans (use_ret hu)))
    · exact casWordC_mid (C := .zero) (F := .zero) hterm hpk hcw hg hpwf hie hj hst (hL hst) hnd hok.tk htv' hiok
        hres (fun _ _ _ _ _ _ _ _ _ _ _ _ => MintStepN.none) hfail.tk hi hE htv hm hH hC hrmw hRP (retPw_eq hRP (by first | exact (bind_ret hb :) | exact (bind_ret hb).trans (use_ret hu)))
  | casEpoch hp hw hep hacq hie hj hsti hst hstep hb hok hfail =>
    rw [hpk] at hp; cases hp
    rw [hwo] at hw; simp only [Option.some.injEq, Prod.mk.injEq] at hw; obtain ⟨rfl, rfl⟩ := hw
    have hsucc := epoch_succ hpwf hep hsat hsti hst hstep
    have hiok := bindR (rt := .unit) (ws := []) hb hi hRL rfl (Lay_etok_unit rfl)
    exact casWordC_mid (C := .zero) hterm hpk hcw hg hpwf hie hj hst (hL hst)
      hnd hok.tk (bind_TvOK hb htv (by simp [tb]) (by simp [mg])).1 hiok
      (mint_res ((wr_holds (WordHolds_epoch hpwf hep _)).trans (wr_holds (WordHolds_epoch hpwf hep _)).symm))
      (fun _ _ _ _ _ hW h1 h2 h3 h4 h5 h6 => MintStepN.epoch hW hep h1 h2 (by omega) h3 h4 h5 h6)
      hfail.tk hi hE htv hm hH hC hrmw hRP (retPw_eq hRP (by first | exact (bind_ret hb :) | exact (bind_ret hb).trans (use_ret hu)))

/-- **(P4 step 3) `cas` on a protocol word through an own or `pub` pointer,
with resources** (`tstepM_casWord` with memory's holding and the promise
credits). -/
theorem tstepMC_casWord {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {acq rel : Bool} {w e v : At} {t : String} {ok fail : Expr}
    {μ : Mode} {r : Idx} {P : Proto} {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .cas acq rel w e v t ok fail)
    (hpk : cx.peek w = .ok (.ptr μ (.word r P))) (hμ : μ = .own ∨ μ = .pub) (hg : P.ghost = false)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hrmw : NoPlantRMW (CE η) th) (hRP : RetPw th.σs th.stack cx.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F :=
  casWordC_typed hterm hpk rfl rfl hg (wordRef_pwf hpk (.inl rfl) hμ hi.1 hE htv hm)
    (fun hst nw hnwv => by
      obtain ⟨lab, pw, rw, hea, hpw, hne, hcell⟩ := casWordCell (acq := acq) (rel := rel) (g := g)
        (mem := mem) (pairs := pairs) hpk hμ hg hst hnwv hi.1 hE htv hm
      exact ⟨⟨lab, 0⟩, pw, rw, hea, by simp [addrOf, hpw], hne, hcell⟩)
    hT hCk hi hE htv hm hH hC hrmw (MemInv_nodup hm) hRP

/-- **(P4 step 3) `cas` on a protocol word through an own or `pub` locative,
with resources** (`tstepM_casWordLoc` with memory's holding and the promise
credits). -/
theorem tstepMC_casWordLoc {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {acq rel : Bool} {w e v : At} {t : String} {ok fail : Expr}
    {μ : Mode} {r : Idx} {P : Proto} {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .cas acq rel w e v t ok fail)
    (hpk : cx.peek w = .ok (.loc μ (.word r P))) (hμ : μ = .own ∨ μ = .pub) (hg : P.ghost = false)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hrmw : NoPlantRMW (CE η) th) (hRP : RetPw th.σs th.stack cx.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F :=
  casWordC_typed hterm hpk rfl rfl hg (wordRef_pwf hpk (.inr rfl) hμ hi.1 hE htv hm)
    (fun hst _ hnwv => wordLocCell (acq := acq) (rel := rel) (g := g)
        (mem := mem) (pairs := pairs) hpk hμ hg hst hnwv hi.1 hE htv hm)
    hT hCk hi hE htv hm hH hC hrmw (MemInv_nodup hm) hRP


/-! ### (P4 step 3, W2) Fetch-ops on protocol words, with resources -/

theorem VRR_fetchEpoch {ρ : Nat → Nat} {η : TEnv} {r r' : Idx} {P : Proto} {rd : Word} {n : Nat}
    (hn : rd.val = .num n) :
    VRR ρ η (fetchEpochTy r P) (shp (fetchEpochTy r' P)) [rd] (.one (.ep (ev ρ r) (n + 1))) := by
  simp only [fetchEpochTy, VRR, shp]
  refine ⟨_, _, n, rfl, _, _, rfl, .zero, .one (.ep (ev ρ r) (n + 1)), (Res.zero_add _).symm,
    fun h => ?_, fun k hk => ?_⟩
  · simp [Shp.wc, wc, accs] at h
  · simp [Shp.wc, wc, accs] at hk
    subst hk
    have e1 : ev (vcons n ρ) (r.shift 0) = ev ρ r := ev_shift 0 n ρ r
    simp [hn, ev, vcons, vins, nWords, Acc.size, e1]

theorem fetch_holds {P : Proto} {d v : Nat} (hf : fetchOK P d = true) (hn : InP P v) :
    WordHolds P [.num v] := by
  obtain ⟨c, cl, k, hc, rfl⟩ := hn
  unfold fetchOK at hf
  simp only [Bool.and_eq_true, Bool.not_eq_true', List.all_eq_true] at hf
  have h := hf.2 (c, cl) (by simpa using TermStep.mem_enumFrom P.clauses 0 c cl hc)
  exact ⟨hf.1.1.1.1, _, c, cl, k, rfl, hc, h.1, rfl⟩

theorem FetchOp.succeeds (o : FetchOp) (v : WeakMem.Val) : WeakMem.rmwSucceeds o.kind v = true := by
  cases o <;> rfl

/-- **(P4) A fetch-op at a protocol word, with resources**: `fetch_core` with
the word target; the op always succeeds, moving the word from the value read
`rd` to `o(rd, d)` (`rmwWordAcc`), which the continuation's frame pays for
with the mint `hpost` licenses. -/
theorem fetchC_core {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {η : TEnv} {x : String} {o : FetchOp} {acq rel : Bool} {a v : At} {e : Expr}
    {ad : Address} {c : Cell} {n : Nat} {P : Proto} {pw nw : Word} {rt rv : Ty} {dd : Nat}
    {Rf Rs H : Res} {cr db : Ts → Res} {Q : List Word → Prop} {SOK : Word → Prop}
    (hterm : th.term = .let_ x (.fetch o acq rel a v) e)
    (hea : evalAt th.env a = some (rt, [pw])) (haddr : addrOf pw = some ad)
    (hev : evalAt th.env v = some (rv, [nw])) (hnw : nw.val = .num dd)
    (hne : loadUnits g.arch pw ad acq [.one] 0 (stOf mem pairs th) ≠ [])
    (hcell : ∀ s1 ws, (s1, ws) ∈ loadUnits g.arch pw ad acq [.one] 0 (stOf mem pairs th) → PromAbove s1 →
      MemInv g (CE η) s1 ∧ Q ws ∧ ∀ s1', MemInv g (CE η) s1' → ∀ w, SOK w →
        ∀ s2, s2 ∈ storeUnits g.k g.arch pw ad rel [.one] [w] 0 s1' → MemInv g (CE η) s2)
    (hsto : η.sto ad.label = some c) (hat : AtOff c.ty ad.offset (.word (.lit n) P))
    (hini : IniAt η.ini c ad (.word (.lit n) P)) (hg : P.ghost = false) (hpwf : pwf P = true)
    (hnd : th.promises.Nodup)
    (hpost : ∀ rd, Q [rd] → SOK (cst (o.kind.apply rd.val (.num dd))) ∧
      (∃ k, o.kind.apply rd.val (.num dd) = .num k ∧ InP P k) ∧
      ∃ ρ' cx' Rok C F, TypedK p η cx' e ∧ TvOK cx' ∧ RetPw th.σs th.stack cx'.ret ∧
        FInvR ρ' η th.σs (ResumeR p th.stack Rs) cx' ((x, fetchRtTy rt, [rd]) :: th.env) Rok ∧
        Rok + wr P n (o.kind.apply rd.val (.num dd)) + C ≤ Rf + wr P n rd.val + F ∧
        ∀ (s' : St) (tw : Ts) (w0 : Word) (m' : Msg), PredAt s'.mem ad tw w0 → w0.val = rd.val →
          s'.mem[tw]? = some m' → m'.loc = ad → m'.val = o.kind.apply rd.val (.num dd) →
          tw ∉ s'.promises → MintStepN g η (stOf mem pairs th) s' C F)
    (hE : EnvOK p η) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hrmw : NoPlantRMW (CE η) th) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  have hd : dataE 1 nw = .const nw.val := by simp [dataE, hnw]
  have key : tstep g mem pairs th =
      (Promises.stepRmw g.k g.arch mem pairs (mth (stOf mem pairs th) pw nw nw) 1 ad o.kind
          (dataE 1 nw) [0] acq rel).map fun (mem', th') =>
        (mem', pairs, withS { th with term := e, env := (x, fetchRtTy rt, [th'.regs 1]) :: th.env }
          ⟨mem', pairs, th'.vs, th'.promises, th.nalloc, th.undefs + countUndef [th'.regs 1]⟩) := by
    simp only [tstep, hterm, evalOp, hea, hev, haddr, List.map_map]; rfl
  rw [key] at ⊢
  refine ⟨fun h => stepRmw_ne_nil_any (loadUnits_one_msg hne) (List.map_eq_nil_iff.1 h), fun r hr hpr0 => ?_⟩
  have hpr := hpr0
  rw [List.mem_map] at hr
  obtain ⟨⟨mem', th'⟩, hin, rfl⟩ := hr
  obtain ⟨s1, rd, hl1, hrd, s2, hs2, hsame⟩ :=
    stepRmw_splitF (s := stOf mem pairs th) (FetchOp.kind_isFetch o) hd hin
  obtain ⟨tm, m, hmt, hml, hrv, hmc, hhid, hcoh⟩ := stepRmw_memR hin
  have hp2 : PromAbove s2 :=
    PromAbove_lockS (s := setRel s2 (lockR g.arch (stOf mem pairs th) s1).vs) (PromAbove_same hsame (fun t ht m hm => hpr t ht m hm))
  have hp1' : PromAbove (bumpRel (lockR g.arch (stOf mem pairs th) s1) _) := storeUnits_promAbove hs2 hp2
  have hp1 : PromAbove s1 := fun t ht m hm => hp1' t ht m hm
  obtain ⟨hm1, hq, hst⟩ := hcell s1 [rd] hl1 hp1
  obtain ⟨hsok, hwin, ρ', cx', Rok, C, F, he', htv', hRPo, hi', hres, hmint⟩ := hpost rd hq
  rw [hnw] at hs2
  subst hrd
  have hP : ∀ t, t ∈ (stOf mem pairs th).promises → t < (stOf mem pairs th).mem.size :=
    fun t ht => hm.2.2.1 t ht
  rcases hmc with ⟨hs, -⟩ | ⟨hsc, hcs⟩
  · rw [FetchOp.succeeds] at hs; cases hs
  have hwv : WeakMem.RmwKind.apply o.kind m.val
      (Promises.rmwNewVal (mth (stOf mem pairs th) pw nw nw).regs (dataE 1 nw)) =
        o.kind.apply (th'.regs 1).val (.num dd) := by
    simp only [mth]; rw [rmwNewVal_dataE pw nw nw, hnw, hrv]
  rw [hwv] at hcs
  obtain ⟨H', hH', hC', hEq, tw, m', hpred, hm', hl', hv', hnp⟩ :=
    rmwWordAccL (E := CE η) (s := stOf mem pairs th)
      (s' := ⟨mem', pairs, th'.vs, th'.promises, th.nalloc, th.undefs + countUndef [th'.regs 1]⟩)
      hP hH hC hsto hat hg hini hpwf hmt hml hwin hcs
      (rmw_ownLatest (E := CE η) (s := stOf mem pairs th) hm (fun hp => hrmw a _ pw ad (.inr ⟨_, _, _, _, _, _, hterm⟩) hea haddr hp.1 hp.2) hsto hat hg hini hmt hml hhid (hcoh hsc) hcs
        (fun t ht m hm => hpr t ht m hm)) hnd
        (by obtain ⟨v, hv, -⟩ := hwin; rw [← hrv]; exact apply_fetch_nundef (FetchOp.kind_isFetch o) hv)
  refine ⟨Rok + Rs, H', C, F, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ', η, cx', Rok, Rs, rfl, hE, he', htv', hi', rfl, hRPo⟩,
    MemInv_same (MemInv_lockS g.arch
      (MemInv_setRel (hst _ (MemInv_bumpRel (MemInv_lockR g.arch (stOf mem pairs th) hm1) _) _ hsok s2 hs2) (MemInv_lockR g.arch (stOf mem pairs th) hm1).2.2.2.2.1)) hsame, hH', hC'⟩,
    hmint _ tw (mw m) m' hpred (by simp [mw, hrv]) hm' hl' hv' (hnp hnd), ?_⟩
  simp only [pSum, stOf, withS] at hEq ⊢
  rw [← hrv] at hEq
  exact Res.le_def.2 fun k => by
    have h1 := hres k
    have h2 := congrArg (fun R : Res => R k) hEq
    simp only [Res.add_apply] at h1 h2 ⊢
    omega

/-- (P4) The output of the fetch cell lemmas at a protocol word (`wordCellF`,
`locCell`): the runtime reference (to a word of `P`), the load and the stores
of any value of the word. -/
def FetchCell (g : G) (mem : Memory) (pairs : List Ts) (th : TTh) (ρ : Nat → Nat) (η : TEnv) (acq rel : Bool)
    (w : At) (r : Idx) (P : Proto) : Prop :=
  ∃ ad pw rt r', evalAt th.env w = some (rt, [pw]) ∧ addrOf pw = some ad ∧ wordOf rt = some (r', P) ∧
    loadUnits g.arch pw ad acq [.one] 0 (stOf mem pairs th) ≠ [] ∧
    ∀ s1 ws, (s1, ws) ∈ loadUnits g.arch pw ad acq [.one] 0 (stOf mem pairs th) → PromAbove s1 →
      MemInv g (CE η) s1 ∧ VR ρ η (.word r P) (shp (.word r' P)) ws ∧
      ∀ s1', MemInv g (CE η) s1' → ∀ nw, EnvVal (CE η) (cl ρ η.wit 0 0 (.word r P)) [nw] →
        ∀ s2, s2 ∈ storeUnits g.k g.arch pw ad rel [.one] [nw] 0 s1' → MemInv g (CE η) s2

/-- **(P4) `fetch add` on a protocol word, with resources**: `fetchEpoch` (the
bound package carries the epoch token `ep n (v + 1)`, minted by
`MintStep.epoch`; the counter keeps holding) and `fetchShare` (every state
holds, so the word's holding is unchanged; the bound `Int` carries nothing). -/
theorem fetchWordC {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx c' : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {o : FetchOp} {acq rel : Bool} {a v : At} {e : Expr}
    {tw : Ty} {μ : Mode} {r j : Idx} {P : Proto} {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.fetch o acq rel a v) e)
    (hpk : cx.peek a = .ok tw) (hcw : cellOf tw = some (μ, .word r P)) (hg : P.ghost = false)
    (hpwf : pwf P = true) (hFC : FetchCell g mem pairs th ρ η acq rel a r P)
    (ho : o = .add) (hj : IntIdx cx v j)
    (hcase : (P.epoch = true ∧ EqI cx j (.lit 1) ∧ cx.bind x (fetchEpochTy r P) = .ok c') ∨
      (∃ d, P.epoch = false ∧ EqI cx j (.lit d) ∧ fetchOK P d = true ∧ cx.bind x .int = .ok c'))
    (he : TypedK p η c' e) (htv' : TvOK c')
    (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hrmw : NoPlantRMW (CE η) th)
    (hnd : th.promises.Nodup) (hRP : RetPw th.σs th.stack cx.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  subst ho
  have hRL := RLink_of hE.2.1 hE.2.2
  obtain ⟨ad, pw, rt, r', hea, haddr, hwo, hne, hcell⟩ := hFC
  obtain ⟨rt2, pw2, ad2, c, hea2, hpw2, hsto, hat, hini⟩ := wordTarget hi.1 hpk hcw hg
  rw [hea] at hea2
  simp only [Option.some.injEq, Prod.mk.injEq, List.cons.injEq, and_true] at hea2
  obtain ⟨-, rfl⟩ := hea2
  obtain rfl : ad2 = ad := by simp only [addrOf, hpw2, Option.some.injEq] at haddr; exact haddr
  obtain ⟨tv, htvk, hjo⟩ := hj
  obtain ⟨rtv, nw, hev, hnwv, -⟩ := atom_num hi.1.2.1 htvk hjo
  rcases hcase with ⟨hep, heq, hb⟩ | ⟨d, hep, heq, hok, hb⟩
  · have hj1 := heq ρ hi.1.1
    simp only [ev] at hj1
    rw [hj1] at hnwv
    have hrt : fetchRtTy rt = fetchEpochTy r' P := by simp [fetchRtTy, hwo, hep]
    refine fetchC_core hterm hea haddr hev hnwv hne hcell hsto hat hini hg hpwf hnd (fun rd hq => ?_) hE hm hH hC hrmw
    simp only [VR] at hq
    obtain ⟨n, hn, -⟩ := hq.2 hg
    simp only [List.map_cons, List.map_nil, List.cons.injEq, and_true] at hn
    have happ : (FetchOp.add).kind.apply rd.val (.num 1) = .num (n + 1) := by
      simp [hn, FetchOp.kind, WeakMem.RmwKind.apply]
    refine ⟨wordVal hpwf (m := n + 1) (by simp [cst, Promises.TVal.mk0, happ]) (InP_epoch hpwf hep (n + 1)),
      ⟨n + 1, happ, InP_epoch hpwf hep (n + 1)⟩, ρ, c', Rf + .one (.ep (ev ρ r) (n + 1)), .zero, .one (.ep (ev ρ r) (n + 1)), he, htv', (by rw [bind_ret hb]; exact hRP), ?_,
      ?_, ?_⟩
    · rw [hrt]
      exact bindR hb hi hRL (VRR_fetchEpoch hn) (Lay_fetchEpoch _ r r' P rd)
    · rw [happ, hn]
      exact mint_res ((wr_holds (WordHolds_epoch hpwf hep _)).trans (wr_holds (WordHolds_epoch hpwf hep _)).symm)
    · intro s' tw w0 m' h1 h2 h3 h4 h5 h6
      rw [happ] at h5
      exact MintStepN.epoch ⟨c, hsto, hat, hg⟩ hep h1 (h2.trans hn) (Nat.lt_succ_self n) h3 h4 h5 h6
  · have hjd := heq ρ hi.1.1
    simp only [ev] at hjd
    rw [hjd] at hnwv
    have hrt : fetchRtTy rt = .int := by simp [fetchRtTy, hwo, hep]
    refine fetchC_core hterm hea haddr hev hnwv hne hcell hsto hat hini hg hpwf hnd (fun rd hq => ?_) hE hm hH hC hrmw
    simp only [VR] at hq
    obtain ⟨n, hn, hin⟩ := hq.2 hg
    simp only [List.map_cons, List.map_nil, List.cons.injEq, and_true] at hn
    have happ : (FetchOp.add).kind.apply rd.val (.num d) = .num (n + d) := by
      simp [hn, FetchOp.kind, WeakMem.RmwKind.apply]
    refine ⟨wordVal hpwf (m := n + d) (by simp [cst, Promises.TVal.mk0, happ]) (InP_fetch hok hin),
      ⟨n + d, happ, InP_fetch hok hin⟩, ρ, c', Rf + .zero, .zero, .zero, he, htv', (by rw [bind_ret hb]; exact hRP), ?_, ?_,
      fun _ _ _ _ _ _ _ _ _ _ => MintStepN.none⟩
    · rw [hrt]
      exact bindR hb hi hRL (show VRR ρ η .int (shp .int) [rd] .zero by simp [VRR, hn]) (Lay_int rd rfl)
    · rw [happ, hn, wr_holds (fetch_holds hok (InP_fetch hok hin)), wr_holds (fetch_holds hok hin)]
      exact Res.le_def.2 fun k => by simp only [Res.add_apply, Res.zero_apply]; omega


/-! ### (P4 step 3, W2) Plain cells: `casCell` and `fetchCell`, with resources -/

theorem dwf_of_affine : ∀ (t : Ty) (ke : KEnv), Ty.affineIn ke t = false → dwf t = true := by
  intro t
  induction t with
  | prod a b iha ihb =>
      intro ke h; simp only [Ty.affineIn, Bool.or_eq_false_iff] at h; simp [dwf, iha ke h.1, ihb ke h.2]
  | array i e ih => intro ke h; simp only [Ty.affineIn] at h; simp [dwf, ih ke h]
  | mu t ih => intro ke h; simp only [Ty.affineIn] at h; simp [dwf, ih _ h]
  | word r P => intro ke h; simp [Ty.affineIn] at h
  | word2 r P => intro ke h; simp [Ty.affineIn] at h
  | _ => intro ke _; rfl

theorem lockS_memP (arch : Arch) (s : St) : (lockS arch s).mem = s.mem ∧ (lockS arch s).promises = s.promises := by
  unfold lockS fenceS; split <;> exact ⟨rfl, rfl⟩

/-- **(P4) Memory's holding across a new latest word at a one-word component**
`U` of a cell (any cell, any component; `heldWord` for words): the old word
`w0` (latest, as `MemHeld` reads it) holds `Rq`; if the new word `w1` holds at
most `Rq + Rv`, memory holds at most `H + Rv`. -/
theorem heldOne {E : TEnv} {s s' : St} {H Rv : Res} {a : Address} {c : Cell} {U : Ty}
    (hH : MemHeld E s H) (hsto : E.sto a.label = some c) (hat : AtOff c.ty a.offset U)
    (hini : IniAt E.ini c a U) (hna : ∀ N e, U ≠ .array (.lit N) e) (hwc : wc U = some 1)
    (hnew : ∀ w0 Rq, LatestNP s.mem (PromAt E s a) a w0 → VRR (fun _ => 0) (CE E.unsee) U (shp U) [w0] Rq →
      Valid U [w0] → ∃ w1 R1, LatestNP s'.mem (PromAt E s' a) a w1 ∧
        VRR (fun _ => 0) (CE E.unsee) U (shp U) [w1] R1 ∧ Valid U [w1] ∧ R1 ≤ Rq + Rv)
    (hkeep : ∀ b w, b ≠ a → LatestNP s.mem (PromAt E s b) b w → LatestNP s'.mem (PromAt E s' b) b w) :
    ∃ H', MemHeld E s' H' ∧ H' ≤ H + Rv := by
  obtain ⟨R0, H0, rfl, hent0, hX⟩ := MemHeld_focus hH a.label
  obtain ⟨vals, hL, hC⟩ := hent0.2 c hsto
  obtain ⟨b, o, S, wS, Rs, Rr, -, hbo, hatS, hwS, hbw, hR0, ⟨hvs, hVs⟩, hput⟩ := (own_segR hC hat hini hna).resolve_right (fun ⟨_, _, _, _, _, _, _, hz⟩ => by obtain ⟨uU, hu, hn⟩ := wc_some hwc; have h := hz _ hu; omega)
  have hsl : ((vals.drop b).take wS).length = wS := by
    simp only [List.length_take, List.length_drop]; omega
  obtain ⟨n1, Rq, Rr2, hwn, hle, hRs, hvq, hput2⟩ := VRR_at E.unsee hatS hvs (by rw [hsl]; exact hwS)
  obtain ⟨n2, hwn2, -, -, hVq⟩ := VR_at E.unsee hatS (VRR_VR S (RLink_of (Coh_CE _) (CohR_CE _)) hvs) hVs
    (by rw [hsl]; exact hwS)
  rw [hwc] at hwn hwn2
  obtain rfl : 1 = n1 := Option.some.inj hwn
  obtain rfl : 1 = n2 := Option.some.inj hwn2
  rw [hsl] at hle
  have hlenv : a.offset + 1 ≤ vals.length := by
    rw [← hbo, Nat.add_assoc]; exact Nat.le_trans (Nat.add_le_add_left hle b) hbw
  have hvqe : (((vals.drop b).take wS).drop o).take 1 = (vals.drop a.offset).take 1 := by
    rw [take_drop_take hle, drop_drop', hbo]
  rw [hvqe] at hvq hVq
  have hget : vals[a.offset]? = some vals[a.offset] := List.getElem?_eq_getElem (by omega)
  have hone : (vals.drop a.offset).take 1 = [vals[a.offset]] := by
    apply List.ext_getElem?; intro i
    rw [slice_get]
    by_cases hi : i < 1
    · rw [iteT hi]; obtain rfl : i = 0 := by omega
      simp only [Nat.add_zero, List.getElem?_cons_zero]; exact hget
    · rw [iteF hi]; simp; omega
  rw [hone] at hvq hVq
  have hl0 : LatestNP s.mem (PromAt E s a) a vals[a.offset] := hL a.offset _ hget
  obtain ⟨w1, R1, hl1, hv1, hV1, hR1⟩ := hnew _ Rq hl0 hvq hVq
  have hq := hput2 [w1] R1 hv1 rfl
  have hQV := (VR_put E.unsee hatS (VRR_VR S (RLink_of (Coh_CE _) (CohR_CE _)) hvs) hVs
    (by rw [hsl]; exact hwS) (VRR_VR _ (RLink_of (Coh_CE _) (CohR_CE _)) hv1) hV1 hwc).2.2
  have hQl : (((vals.drop b).take wS).take o ++ [w1] ++ ((vals.drop b).take wS).drop (o + 1)).length = wS := by
    simp only [List.length_append, List.length_take, List.length_drop, List.length_singleton]; omega
  have hcell' := hput _ _ ⟨hq, hQV⟩ hQl
  have hsp := splice_seg vals [w1] b wS o (by simpa using hle)
  simp only [List.length_singleton] at hsp
  rw [hsp, hbo] at hcell'
  have hent : HeldEntry E s' a.label (R1 + Rr2 + Rr) := by
    refine ⟨fun h => (by rw [hsto] at h; cases h), fun c3 hc3 => ?_⟩
    rw [hsto] at hc3; cases hc3
    refine ⟨vals.take a.offset ++ [w1] ++ vals.drop (a.offset + 1), fun (o' : Nat) w hw => ?_, hcell'⟩
    rw [splice_get vals [w1] a.offset 1 o' rfl hlenv] at hw
    by_cases hr : a.offset ≤ o' ∧ o' < a.offset + 1
    · rw [iteT hr] at hw
      obtain rfl : o' = a.offset := Nat.le_antisymm (Nat.le_of_lt_succ hr.2) hr.1
      simp only [Nat.sub_self, List.getElem?_cons_zero, Option.some.injEq] at hw
      subst hw
      exact hl1
    · rw [iteF hr] at hw
      refine hkeep _ w (fun e => hr ?_) (hL o' w hw)
      have : o' = a.offset := by rw [← e]
      subst this; exact ⟨Nat.le_refl _, Nat.lt_succ_self _⟩
  have hX' : MemHeldX E s' a.label H0 := MemHeldX_tr hX (fun _ _ => rfl) (fun _ _ => rfl)
    (fun l' hne o' w hl => hkeep _ w (fun e => hne (by rw [← e])) hl) id
  refine ⟨_, MemHeld_unfocus hX' hent, Res.le_def.2 fun k => ?_⟩
  subst hR0; subst hRs
  have := hR1 k
  simp only [Res.add_apply] at this ⊢; omega

/-- `heldOne` with slot lists; the export keeps every untouched slot. -/
theorem heldOneL {E : TEnv} {s s' : St} {Sl : AllocLabel → List Res} {H Rv : Res} {a : Address} {c : Cell} {U : Ty}
    (hH : MemHeldL E s H Sl) (hsto : E.sto a.label = some c) (hat : AtOff c.ty a.offset U)
    (hini : IniAt E.ini c a U) (hna : ∀ N e, U ≠ .array (.lit N) e) (hwc : wc U = some 1)
    (hnew : ∀ w0 Rq, LatestNP s.mem (PromAt E s a) a w0 → VRR (fun _ => 0) (CE E.unsee) U (shp U) [w0] Rq →
      Valid U [w0] → ∃ w1 R1, LatestNP s'.mem (PromAt E s' a) a w1 ∧
        VRR (fun _ => 0) (CE E.unsee) U (shp U) [w1] R1 ∧ Valid U [w1] ∧ R1 ≤ Rq + Rv)
    (hkeep : ∀ b w, b ≠ a → LatestNP s.mem (PromAt E s b) b w → LatestNP s'.mem (PromAt E s' b) b w)
    (htA : ∀ lo hi, lo ≤ a.offset → a.offset < hi → TouchS s s' a.label lo hi) :
    ∃ H', MemHeldK E s Sl E s' H' ∧ H' ≤ H + Rv := by
  obtain ⟨H0, rfl, hent0, hX⟩ := MemHeldL_focus hH a.label
  obtain ⟨vals, hL, hC⟩ := hent0.2 c hsto
  obtain ⟨b, o, S, wS, kk, Rs, hseg, hbo, hatS, hwS, hbw, hkk, ⟨hvs, hVs⟩, hkb, hput⟩ := (own_segL (Nat.le_refl _) hC hat hini hna).resolve_right (fun ⟨_, _, _, _, _, _, _, hz⟩ => by obtain ⟨uU, hu, hn⟩ := wc_some hwc; have h := hz _ hu; omega)
  have hsl : ((vals.drop b).take wS).length = wS := by
    simp only [List.length_take, List.length_drop]; omega
  obtain ⟨n1, Rq, Rr2, hwn, hle, hRs, hvq, hput2⟩ := VRR_at E.unsee hatS hvs (by rw [hsl]; exact hwS)
  obtain ⟨n2, hwn2, -, -, hVq⟩ := VR_at E.unsee hatS (VRR_VR S (RLink_of (Coh_CE _) (CohR_CE _)) hvs) hVs
    (by rw [hsl]; exact hwS)
  rw [hwc] at hwn hwn2
  obtain rfl : 1 = n1 := Option.some.inj hwn
  obtain rfl : 1 = n2 := Option.some.inj hwn2
  rw [hsl] at hle
  have hlenv : a.offset + 1 ≤ vals.length := by
    rw [← hbo, Nat.add_assoc]; exact Nat.le_trans (Nat.add_le_add_left hle b) hbw
  have hvqe : (((vals.drop b).take wS).drop o).take 1 = (vals.drop a.offset).take 1 := by
    rw [take_drop_take hle, drop_drop', hbo]
  rw [hvqe] at hvq hVq
  have hget : vals[a.offset]? = some vals[a.offset] := List.getElem?_eq_getElem (by omega)
  have hone : (vals.drop a.offset).take 1 = [vals[a.offset]] := by
    apply List.ext_getElem?; intro i
    rw [slice_get]
    by_cases hi : i < 1
    · rw [iteT hi]; obtain rfl : i = 0 := by omega
      simp only [Nat.add_zero, List.getElem?_cons_zero]; exact hget
    · rw [iteF hi]; simp; omega
  rw [hone] at hvq hVq
  have hl0 : LatestNP s.mem (PromAt E s a) a vals[a.offset] := hL a.offset _ hget
  obtain ⟨w1, R1, hl1, hv1, hV1, hR1⟩ := hnew _ Rq hl0 hvq hVq
  have hq := hput2 [w1] R1 hv1 rfl
  have hQV := (VR_put E.unsee hatS (VRR_VR S (RLink_of (Coh_CE _) (CohR_CE _)) hvs) hVs
    (by rw [hsl]; exact hwS) (VRR_VR _ (RLink_of (Coh_CE _) (CohR_CE _)) hv1) hV1 hwc).2.2
  have hQl : (((vals.drop b).take wS).take o ++ [w1] ++ ((vals.drop b).take wS).drop (o + 1)).length = wS := by
    simp only [List.length_append, List.length_take, List.length_drop, List.length_singleton]; omega
  have hcell' := hput _ _ ⟨hq, hQV⟩ hQl
  have hsp := splice_seg vals [w1] b wS o (by simpa using hle)
  simp only [List.length_singleton] at hsp
  rw [hsp, hbo] at hcell'
  have hent : HeldEntryL E s' a.label ((Sl a.label).set kk (R1 + Rr2)) := by
    refine ⟨fun h => (by rw [hsto] at h; cases h), fun c3 hc3 => ?_⟩
    rw [hsto] at hc3; cases hc3
    refine ⟨vals.take a.offset ++ [w1] ++ vals.drop (a.offset + 1), fun (o' : Nat) w hw => ?_, hcell'⟩
    rw [splice_get vals [w1] a.offset 1 o' rfl hlenv] at hw
    by_cases hr : a.offset ≤ o' ∧ o' < a.offset + 1
    · rw [iteT hr] at hw
      obtain rfl : o' = a.offset := Nat.le_antisymm (Nat.le_of_lt_succ hr.2) hr.1
      simp only [Nat.sub_self, List.getElem?_cons_zero, Option.some.injEq] at hw
      subst hw
      exact hl1
    · rw [iteF hr] at hw
      refine hkeep _ w (fun e => hr ?_) (hL o' w hw)
      have : o' = a.offset := by rw [← e]
      subst this; exact ⟨Nat.le_refl _, Nat.lt_succ_self _⟩
  have hX' : MemHeldXL E s' a.label H0 Sl := MemHeldXL_tr hX (fun _ _ => rfl) (fun _ _ => rfl)
    (fun l' hne o' w hl => hkeep _ w (fun e => hne (by rw [← e])) hl) id
  have hkl : kk < (Sl a.label).length := (List.getElem?_eq_some_iff.1 hkk).1
  have hR0 : Res.sum (Sl a.label) = Rs + Res.sum ((Sl a.label).set kk .zero) := by
    rw [Res.sum_set_zero _ kk hkl, (List.getElem?_eq_some_iff.1 hkk).2]
  have hK := MemHeldK_slotSet (E0 := E) (s0 := s) hX' hent (fun c1 N e us1 hc1 hT hu1 => by
    rw [hsto] at hc1; cases hc1
    obtain ⟨hb, -⟩ := hkb N e us1 hT hu1
    have hw := seg_arr_width hseg hT hu1 hwS
    refine htA _ _ (by rw [← hbo, hb]; exact Nat.le_add_right _ _) ?_
    have h1 : o + 1 ≤ wS := hle
    rw [← hbo, hb, Nat.succ_mul]; exact Nat.add_lt_add_left (by rw [← hw]; omega) _)
  rw [Res.sum_set _ kk _ hkl] at hK
  refine ⟨_, hK, Res.le_def.2 fun k => ?_⟩
  rw [hR0]; subst hRs
  have := hR1 k
  simp only [Res.add_apply] at this ⊢; omega
