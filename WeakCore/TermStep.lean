/-- **(P4) `mkEPair`, with credits**: two numbers, holding nothing; memory and
the frame's resources unchanged. -/
theorem tstepMC_mkEPair {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x rn : String} {P : ECounter} {v0 v1 : At} {e : Expr}
