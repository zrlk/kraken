/-! ### (U3 R1) Transfer of values along label agreement

The inhabitation side condition `hinh` of `MemInv_plantE` is a value of the
certificate run, moved to the planted environment.  `VR_monoG` / `VR_monoH`:
`VR` moves along agreement on the labels its words name (box payloads by an
explicit transfer, `PayT`); `noJunk`: those labels are exactly the ones `VR`
checks (published cells and boxes). -/

/-- (U3 R1) Every reference word of `ws` names a label in `G`. -/
def LabsIn (G : AllocLabel → Prop) (ws : List Word) : Prop :=
  ∀ w ∈ ws, ∀ (a : Address) (g : Nat), w.val = .loc a g → G a.label

theorem LabsIn_sub {G : AllocLabel → Prop} {ws ws' : List Word} (h : LabsIn G ws) (hs : ∀ w ∈ ws', w ∈ ws) :
    LabsIn G ws' := fun w hw => h w (hs w hw)

theorem LabsIn_one {G : AllocLabel → Prop} {ws : List Word} {a : Address} {g : Nat} (h : LabsIn G ws)
    (hv : ws.map (·.val) = [.loc a g]) : G a.label := by
  match ws, hv with
  | [w], hv =>
    simp only [List.map_cons, List.map_nil, List.cons.injEq, and_true] at hv
    exact h w (List.mem_singleton.2 rfl) a g hv
  | [], hv => cases hv
  | _ :: _ :: _, hv => simp at hv

theorem decodeArm_labs {G : AllocLabel → Prop} {tr : Tier} {as : List Ty} {ws : List Word} {j : Nat}
    {p : List Word} (h : decodeArm tr as ws = some (j, p)) (hG : LabsIn G ws) : LabsIn G p := by
  unfold decodeArm at h
  split at h
  · rename_i w
    split at h
    · rename_i a g hv
      simp only [Option.bind_eq_bind, Option.bind_eq_some_iff, Option.pure_def, Option.some.injEq] at h
      obtain ⟨⟨j', x⟩, -, h⟩ := h
      simp only [Prod.mk.injEq] at h
      obtain ⟨-, rfl⟩ := h
      intro w' hw' a' g' hv'
      rw [List.mem_singleton] at hw'; subst hw'
      simp only [Val.loc.injEq] at hv'
      obtain ⟨rfl, -⟩ := hv'
      exact hG w (List.mem_singleton.2 rfl) a g hv
    · simp only [Option.bind_eq_bind, Option.bind_eq_some_iff, Option.pure_def] at h
      obtain ⟨arm, -, h⟩ := h
      split at h <;> simp only [Option.some.injEq, Prod.mk.injEq, reduceCtorEq] at h
      · obtain ⟨-, rfl⟩ := h; intro _ hw; cases hw
      · obtain ⟨-, rfl⟩ := h; intro _ hw _ _ hv; rw [List.mem_singleton] at hw; subst hw; cases hv
    · cases h
  · rename_i t w
    split at h
    · simp only [Option.bind_eq_bind, Option.bind_eq_some_iff, Option.pure_def] at h
      obtain ⟨arm, -, h⟩ := h
      split at h <;> simp only [Option.some.injEq, Prod.mk.injEq] at h <;> obtain ⟨-, rfl⟩ := h
      · intro _ hw; cases hw
      · exact LabsIn_sub hG fun w' hw => by rw [List.mem_singleton] at hw; subst hw; simp
    · cases h
  · cases h

theorem ofArm_labs {G : AllocLabel → Prop} {t : Ty} {j : Nat} {p q : List Word}
    (h : ofArm t j p = some q) (hG : LabsIn G p) : LabsIn G q := by
  unfold ofArm at h
  split at h
  · unfold encodeArm at h
    split at h
    · simp only [Option.bind_eq_bind, Option.bind_eq_some_iff] at h
      obtain ⟨arm, -, h⟩ := h
      split at h
      · split at h
        · rename_i a g hv
          simp only [Option.some.injEq] at h; subst h
          intro w' hw' a' g' hv'
          rw [List.mem_singleton] at hw'; subst hw'
          simp only [Val.loc.injEq] at hv'
          obtain ⟨rfl, -⟩ := hv'
          exact hG _ (List.mem_singleton.2 rfl) a g hv
        · split at h
          · simp only [Option.some.injEq] at h; subst h
            intro _ hw _ _ hv; rw [List.mem_singleton] at hw; subst hw; cases hv
          · cases h
        · cases h
      · split at h
        · rename_i a g hv
          simp only [Option.some.injEq] at h; subst h
          intro w' hw' a' g' hv'
          rw [List.mem_singleton] at hw'; subst hw'
          simp only [Val.loc.injEq] at hv'
          obtain ⟨rfl, -⟩ := hv'
          exact hG _ (List.mem_singleton.2 rfl) a g hv
        · split at h
          · simp only [Option.some.injEq] at h; subst h
            intro _ hw _ _ hv; rw [List.mem_singleton] at hw; subst hw; cases hv
          · cases h
        · cases h
      · simp only [Option.some.injEq] at h; subst h
        intro _ hw _ _ hv; rw [List.mem_singleton] at hw; subst hw; cases hv
      · cases h
    · split at h
      · simp only [Option.some.injEq] at h; subst h
        intro _ hw _ _ hv; simp only [List.mem_cons, List.not_mem_nil, or_false] at hw
        rcases hw with rfl | rfl <;> cases hv
      · rename_i w
        simp only [Option.some.injEq] at h; subst h
        intro w' hw a g hv; simp only [List.mem_cons, List.not_mem_nil, or_false] at hw
        rcases hw with rfl | rfl
        · cases hv
        · exact hG w' (List.mem_singleton.2 rfl) a g hv
      · cases h
    · cases h
  · split at h
    · simp only [Option.some.injEq] at h; subst h; exact hG
    · cases h

