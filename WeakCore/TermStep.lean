/-- (P4) Lifting a frame-only step: memory, its holding and the view are kept. -/
theorem liftMR {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {η : TEnv} {Rf Rs H : Res}
    (hm : MemInv g (CE η) (stOf mem pairs th)) (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (h : tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvRE p (CE η) r.2.2 (Rf + Rs))
    (hs : ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2)) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th,
      ∃ Tot H', ThInvMK p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H :=
  ⟨h.1, fun r hr => ⟨Rf + Rs, H, ⟨CE η, EFoot_refl, (by seenT), (by boxT), h.2 r hr, MemInv_same hm (hs r hr),
    MemHeldK_eqs hH (hs r hr).1 (hs r hr).2.2.2.1,
    CrKeep_eqs (hs r hr).1 (hs r hr).2.2.2.1⟩, Res.le_refl _⟩⟩

/-- (P4) **`inl` into a boxed sum, unboxed operand, with resources**: the
operand's resources move into the new box's reference; memory's holding is
unchanged (`MemHeld_box`). -/
theorem tstepMR_inlB {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {ρ : Nat → Nat} {η : TEnv} {x : String} {τ : Ty} {a : At} {e : Expr} {t : Ty} {c₁ : Cx}
    {rt : Ty} {ws : List Word} {R Rr Rf Rs H : Res} (hterm : th.term = .let_ x (.inl τ a) e) (hn : 0 < g.n)
    (hc' : ∀ c', c₁.bind x (.sum t τ) = .ok c' → TypedK p η c' e ∧ TvOK c')
    (hb : ∃ c', c₁.bind x (.sum t τ) = .ok c')
    (hi1 : FInvR ρ η th.σs (ResumeR p th.stack Rs) c₁ th.env Rr) (hle : R + Rr ≤ Rf)
    (hea : evalAt th.env a = some (rt, ws)) (hv : VRR ρ η t (shp rt) ws R) (hl : Lay th.σs t rt ws)
    (hS : (Ty.sum rt (close th.σs τ)).tier = .boxed) (hrb : isBoxed rt = false)
    (hE : EnvOK p η) (hm : MemInv g (CE η) (stOf mem pairs th)) (hbf : g.boxFence = true) (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hRP : RetPw th.σs th.stack c₁.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th,
      ∃ Tot H', ThInvMK p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H := by
  obtain ⟨c', hb⟩ := hb
  obtain ⟨he, htv'⟩ := hc' c' hb
  obtain ⟨hshape, hsk, hwc, hval, hly⟩ := hl
  obtain ⟨j, p0, arm, us, has, harm, hus, hnw, q1, hq1, eq1⟩ := asArm_box rt ws hval hshape hwc hrb
  have hj : j < (armsOf rt).length := (List.getElem?_eq_some_iff.mp harm).1
  have harmS : (armsOf (.sum rt (close th.σs τ)))[j]? = some arm := by
    simp only [armsOf]; rw [List.getElem?_append_left hj]; exact harm
  have hSb : isBoxed (.sum rt (close th.σs τ)) = true := by simp [isBoxed, sumHead, hS]
  have hRa : isBoxed rt = false := hrb
  let s := stOf mem pairs th
  let lbl := freshLabel g.lbase g.n g.i s.nalloc
  let V := s.vs.vRelSt
  have hbnone : η.box lbl = none := hm.2.2.2.2.2.2.2.2.2.1.1 s.nalloc (Nat.le_refl _)
  have hstoL : η.sto lbl = none := (hm.2.2.2.1.1 s.nalloc (Nat.le_refl _)).1
  have hpfL : η.pfr lbl = none := (hm.2.2.2.1.1 s.nalloc (Nat.le_refl _)).2.2.2
  have key : tstep g mem pairs th =
      (alloc g.k g.arch lbl (.one :: us) (cst (.num j) :: p0) s).map fun (s', pw) =>
        ((if g.boxFence then fenceS s' .st else s').mem, (if g.boxFence then fenceS s' .st else s').pairs,
          withS { th with term := e, env := (x, .sum rt (close th.σs τ), [pw]) :: th.env }
            (if g.boxFence then fenceS s' .st else s')) := by
    simp only [tstep, hterm, evalOp, hea, projM_nbB hrb, has, ol, Option.map_some, Option.toList_some,
      List.flatMap_cons, List.flatMap_nil, List.append_nil, injM_box hSb (by rw [harmS]; exact hus), List.map_map]
    rfl
  rw [key]
  refine ⟨?_, ?_⟩
  · obtain ⟨r, hr⟩ := alloc_nonempty (k := g.k) (arch := g.arch) (lbl := lbl) (us := .one :: us)
      (ws := cst (.num j) :: p0) (s := s) (by simp [nWords, Acc.size] at hnw ⊢; omega)
    exact List.ne_nil_of_mem (List.mem_map_of_mem hr)
  · intro r hr
    rw [List.mem_map] at hr
    obtain ⟨⟨s', pw⟩, hal, rfl⟩ := hr
    let B : Box := ⟨j, p0.map (bumpW V), (CE η).tid, s'.vs.vWr⟩
    let η' := η.withSto η.sto (P := fun l => if l = lbl then some s'.vs.vWr else η.pfr l)
      (S := fun l => l = lbl ∨ η.seen l) (Bx := fun l => if l = lbl then some B else η.box l)
    have hx : Ext η η' := Ext_withSto hE.2.1 (fun _ _ h => h) (fun _ => Nat.le_refl _) (hS := fun _ h => Or.inr h)
      (hP := fun l f h => by
        have hne : l ≠ lbl := fun e => by rw [e, hpfL] at h; cases h
        simp only [hne, ↓reduceIte]; exact h)
      (hB := fun l B' h => by
        have hne : l ≠ lbl := fun e => by rw [e, hbnone] at h; cases h
        simp only [hne, ↓reduceIte]; exact h)
    have hcr' : CohR η' := hx.2.2.2.2.2.2.2.2.2.2.1
    have hCE : CE η' = seeBoxE (CE η) lbl B s'.vs.vWr := rfl
    have hBS : BoxSeen η' lbl B := ⟨by simp [η', TEnv.withSto], s'.vs.vWr, by simp [η', TEnv.withSto], Nat.le_refl _⟩
    have hHb := MemHeldL_box hm hH hal B
    obtain ⟨hm', hpw⟩ := MemInv_boxF (us := us) hm hn hbf hal hnw.symm
    simp only at hpw hHb
    subst hpw
    obtain ⟨q', hq', eq'⟩ := ofArm_wle (WLe_bump V p0) hq1
    have hwq : WLe ws q' := WLe_trans (asArm_ofArm_wle has hq1 eq1) eq'
    have eqw : VEq ws q' := eq1.symm.trans eq'.vals
    have hv2 : VRR ρ η'.unsee t (shp rt) q' R :=
      VRR_ext hE.2.1.unsee hE.2.2.unsee (Ext_unsee hx) (VRR_store hE.2.1 hE.2.2 (V := V) (fun l hl => hm.2.2.2.2.1 l hl)
        (LocAbove_ofArm hq' (LocAbove_bump V p0)) (VRR_up _ _ _ _ _ hwq hv))
    have hvr : VRR ρ η' (.sum t τ) (shp (.sum rt (close th.σs τ))) [cst (.loc ⟨lbl, 0⟩ 0)] R :=
      VRR_boxL (B := B) hS hRa rfl rfl (by simp [η', TEnv.withSto]) (Or.inl hBS) hj hq' hv2
        (ShapeC_vals eqw hshape) hwc (Valid_vals _ _ _ eqw hval)
        (by show ((armsOf (.sum rt (close th.σs τ)))[j]?).bind wc = some (p0.map (bumpW V)).length
            rw [harmS]; simp [wc, hus, hnw, List.length_map])
    have hf := FInvR_mono (bindR hb (FInvR_ext hE.2.1 hE.2.2 hx hi1) (RLink_of hx.1 hcr') hvr
      (Lay_box ⟨hshape, hsk, hwc, hval, hly⟩ hS)) (res_swap_le hle)
    refine ⟨Rf + Rs, H, ⟨CE η', by rw [hCE]; exact EFoot_seeBox (nalloc_alloc_box hm.2.2.1 hal) rfl hpfL hstoL (alloc_size_fr hal) (by first | exact Nat.le_refl _ | (simp only [hbf, ↓reduceIte]; exact Nat.le_refl _) | (simp only [hbf, ↓reduceIte, stOf, withS]; exact Nat.le_refl _)) (alloc_size_len _ hal (by first | exact hlen | exact hnw.symm)), (by seenT), (by rw [hCE]; refine BoxNewV_seeBox hbnone ?_; intro e0 env0 he hs hev; have hev' := envV_tail he hev; exact payV_lt (TermViewInv.asArm_V has (TermViewInv.evalAt_V hev' hea)) hs.2.2.2.2.2 (alloc_size_len _ hal (by first | exact hlen | exact hnw.symm))),
      ⟨ρ, η', c', Rf, Rs, rfl, ⟨hE.1, hx.1, hcr'⟩, he.ext hx, htv', hf, rfl, by rw [bind_ret hb]; exact hRP⟩, ?_, ?_, ?_⟩,
      Res.le_refl _⟩
    · rw [hCE]; exact hm'
    · rw [hCE]; exact MemHeldK_of (MemHeldL_seeE (lbl := lbl) (F := s'.vs.vWr) hHb hstoL hpfL)
    · rw [hCE]; exact CrKeep_seeE (lbl := lbl) (F := s'.vs.vWr) (CrKeep_box hm hal B) hstoL

/-- (P4) **`inr` into a boxed sum, unboxed operand, with resources.** -/
theorem tstepMR_inrB {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {ρ : Nat → Nat} {η : TEnv} {x : String} {τ : Ty} {a : At} {e : Expr} {t : Ty} {c₁ : Cx}
    {rt : Ty} {ws : List Word} {R Rr Rf Rs H : Res} (hterm : th.term = .let_ x (.inr τ a) e) (hn : 0 < g.n)
    (hc' : ∀ c', c₁.bind x (.sum τ t) = .ok c' → TypedK p η c' e ∧ TvOK c')
    (hb : ∃ c', c₁.bind x (.sum τ t) = .ok c')
    (hi1 : FInvR ρ η th.σs (ResumeR p th.stack Rs) c₁ th.env Rr) (hle : R + Rr ≤ Rf)
    (hea : evalAt th.env a = some (rt, ws)) (hv : VRR ρ η t (shp rt) ws R) (hl : Lay th.σs t rt ws)
    (hS : (Ty.sum (close th.σs τ) rt).tier = .boxed) (hrb : isBoxed rt = false)
    (hE : EnvOK p η) (hm : MemInv g (CE η) (stOf mem pairs th)) (hbf : g.boxFence = true) (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hRP : RetPw th.σs th.stack c₁.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th,
      ∃ Tot H', ThInvMK p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H := by
  obtain ⟨c', hb⟩ := hb
  obtain ⟨he, htv'⟩ := hc' c' hb
  obtain ⟨hshape, hsk, hwc, hval, hly⟩ := hl
  obtain ⟨j, p0, arm, us, has, harm, hus, hnw, q1, hq1, eq1⟩ := asArm_box rt ws hval hshape hwc hrb
  let τc := close th.σs τ
  let n := (armsOf τc).length
  have harmS : (armsOf (.sum τc rt))[n + j]? = some arm := by
    simp only [armsOf]; rw [List.getElem?_append_right (Nat.le_add_right _ _), Nat.add_sub_cancel_left]
    exact harm
  have hSb : isBoxed (.sum τc rt) = true := by simp [isBoxed, sumHead, τc, hS]
  have hRb : isBoxed rt = false := hrb
  let s := stOf mem pairs th
  let lbl := freshLabel g.lbase g.n g.i s.nalloc
  let V := s.vs.vRelSt
  have hbnone : η.box lbl = none := hm.2.2.2.2.2.2.2.2.2.1.1 s.nalloc (Nat.le_refl _)
  have hstoL : η.sto lbl = none := (hm.2.2.2.1.1 s.nalloc (Nat.le_refl _)).1
  have hpfL : η.pfr lbl = none := (hm.2.2.2.1.1 s.nalloc (Nat.le_refl _)).2.2.2
  have key : tstep g mem pairs th =
      (alloc g.k g.arch lbl (.one :: us) (cst (.num (n + j)) :: p0) s).map fun (s', pw) =>
        ((if g.boxFence then fenceS s' .st else s').mem, (if g.boxFence then fenceS s' .st else s').pairs,
          withS { th with term := e, env := (x, .sum τc rt, [pw]) :: th.env }
            (if g.boxFence then fenceS s' .st else s')) := by
    simp only [tstep, hterm, evalOp, hea, projM_nbB hrb, has, ol, Option.map_some, Option.toList_some,
      List.flatMap_cons, List.flatMap_nil, List.append_nil, injM_box (t := Ty.sum (close th.σs τ) rt) (j := (armsOf (close th.σs τ)).length + j) hSb (by rw [harmS]; exact hus), List.map_map]
    rfl
  rw [key]
  refine ⟨?_, ?_⟩
  · obtain ⟨r, hr⟩ := alloc_nonempty (k := g.k) (arch := g.arch) (lbl := lbl) (us := .one :: us)
      (ws := cst (.num (n + j)) :: p0) (s := s) (by simp [nWords, Acc.size] at hnw ⊢; omega)
    exact List.ne_nil_of_mem (List.mem_map_of_mem hr)
  · intro r hr
    rw [List.mem_map] at hr
    obtain ⟨⟨s', pw⟩, hal, rfl⟩ := hr
    let B : Box := ⟨n + j, p0.map (bumpW V), (CE η).tid, s'.vs.vWr⟩
    let η' := η.withSto η.sto (P := fun l => if l = lbl then some s'.vs.vWr else η.pfr l)
      (S := fun l => l = lbl ∨ η.seen l) (Bx := fun l => if l = lbl then some B else η.box l)
    have hx : Ext η η' := Ext_withSto hE.2.1 (fun _ _ h => h) (fun _ => Nat.le_refl _) (hS := fun _ h => Or.inr h)
      (hP := fun l f h => by
        have hne : l ≠ lbl := fun e => by rw [e, hpfL] at h; cases h
        simp only [hne, ↓reduceIte]; exact h)
      (hB := fun l B' h => by
        have hne : l ≠ lbl := fun e => by rw [e, hbnone] at h; cases h
        simp only [hne, ↓reduceIte]; exact h)
    have hcr' : CohR η' := hx.2.2.2.2.2.2.2.2.2.2.1
    have hCE : CE η' = seeBoxE (CE η) lbl B s'.vs.vWr := rfl
    have hBS : BoxSeen η' lbl B := ⟨by simp [η', TEnv.withSto], s'.vs.vWr, by simp [η', TEnv.withSto], Nat.le_refl _⟩
    have hHb := MemHeldL_box hm hH hal B
    obtain ⟨hm', hpw⟩ := MemInv_boxF (us := us) hm hn hbf hal hnw.symm
    simp only at hpw hHb
    subst hpw
    obtain ⟨q', hq', eq'⟩ := ofArm_wle (WLe_bump V p0) hq1
    have hwq : WLe ws q' := WLe_trans (asArm_ofArm_wle has hq1 eq1) eq'
    have eqw : VEq ws q' := eq1.symm.trans eq'.vals
    have hv2 : VRR ρ η'.unsee t (shp rt) q' R :=
      VRR_ext hE.2.1.unsee hE.2.2.unsee (Ext_unsee hx) (VRR_store hE.2.1 hE.2.2 (V := V) (fun l hl => hm.2.2.2.2.1 l hl)
        (LocAbove_ofArm hq' (LocAbove_bump V p0)) (VRR_up _ _ _ _ _ hwq hv))
    have hvr : VRR ρ η' (.sum τ t) (shp (.sum τc rt)) [cst (.loc ⟨lbl, 0⟩ 0)] R :=
      VRR_boxR (B := B) hS hRb rfl rfl (by simp [η', TEnv.withSto]) (Or.inl hBS) (Nat.le_add_right _ _)
        (by show ofArm rt (n + j - n) _ = _; rw [Nat.add_sub_cancel_left]; exact hq') hv2
        (ShapeC_vals eqw hshape) hwc (Valid_vals _ _ _ eqw hval)
        (by show ((armsOf (.sum τc rt))[n + j]?).bind wc = some (p0.map (bumpW V)).length
            rw [harmS]; simp [wc, hus, hnw, List.length_map])
    have hf := FInvR_mono (bindR hb (FInvR_ext hE.2.1 hE.2.2 hx hi1) (RLink_of hx.1 hcr') hvr
      (TermSound.Lay_boxR ⟨hshape, hsk, hwc, hval, hly⟩ hS)) (res_swap_le hle)
    refine ⟨Rf + Rs, H, ⟨CE η', by rw [hCE]; exact EFoot_seeBox (nalloc_alloc_box hm.2.2.1 hal) rfl hpfL hstoL (alloc_size_fr hal) (by first | exact Nat.le_refl _ | (simp only [hbf, ↓reduceIte]; exact Nat.le_refl _) | (simp only [hbf, ↓reduceIte, stOf, withS]; exact Nat.le_refl _)) (alloc_size_len _ hal (by first | exact hlen | exact hnw.symm)), (by seenT), (by rw [hCE]; refine BoxNewV_seeBox hbnone ?_; intro e0 env0 he hs hev; have hev' := envV_tail he hev; exact payV_lt (TermViewInv.asArm_V has (TermViewInv.evalAt_V hev' hea)) hs.2.2.2.2.2 (alloc_size_len _ hal (by first | exact hlen | exact hnw.symm))),
      ⟨ρ, η', c', Rf, Rs, rfl, ⟨hE.1, hx.1, hcr'⟩, he.ext hx, htv', hf, rfl, by rw [bind_ret hb]; exact hRP⟩, ?_, ?_, ?_⟩,
      Res.le_refl _⟩
    · rw [hCE]; exact hm'
    · rw [hCE]; exact MemHeldK_of (MemHeldL_seeE (lbl := lbl) (F := s'.vs.vWr) hHb hstoL hpfL)
    · rw [hCE]; exact CrKeep_seeE (lbl := lbl) (F := s'.vs.vWr) (CrKeep_box hm hal B) hstoL

/-- (P4) **`inl` into a boxed sum, boxed operand, with resources**: the
operand's reference carries its box's payload resources; the re-boxed
reference carries the same (`VRR_ren`). -/
theorem tstepMR_inlBB {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {ρ : Nat → Nat} {η : TEnv} {x : String} {τ : Ty} {a : At} {e : Expr} {t : Ty} {c₁ : Cx}
    {rt : Ty} {ws : List Word} {R Rr Rf Rs H : Res} (hterm : th.term = .let_ x (.inl τ a) e) (hn : 0 < g.n)
    (hc' : ∀ c', c₁.bind x (.sum t τ) = .ok c' → TypedK p η c' e ∧ TvOK c')
    (hb : ∃ c', c₁.bind x (.sum t τ) = .ok c')
    (hi1 : FInvR ρ η th.σs (ResumeR p th.stack Rs) c₁ th.env Rr) (hle : R + Rr ≤ Rf)
    (hea : evalAt th.env a = some (rt, ws)) (hvV : VR ρ η t (shp rt) ws) (hv : VRR ρ η t (shp rt) ws R)
    (hl : Lay th.σs t rt ws)
    (hS : (Ty.sum rt (close th.σs τ)).tier = .boxed) (hrb : isBoxed rt = true)
    (hsg : sig rt = sig (cl ρ η.wit 0 0 t))
    (hE : EnvOK p η) (hm : MemInv g (CE η) (stOf mem pairs th)) (hbf : g.boxFence = true) (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hpx : PAx g mem pairs th) (hRP : RetPw th.σs th.stack c₁.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      ∃ Tot H', ThInvMK p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H := by
  obtain ⟨c', hb⟩ := hb
  obtain ⟨he, htv'⟩ := hc' c' hb
  have hbi := hm.2.2.2.2.2.2.2.2.2.1
  obtain ⟨w, x0, B0, arm, us, rfl, hw, hx0, hB0, harm, hus, hnw, hsto0, hini0, hsee0⟩ :=
    boxed_operand hE.2.1 hbi hrb hsg hvV
  have hj : B0.tag < (armsOf rt).length := (List.getElem?_eq_some_iff.mp harm).1
  let S := Ty.sum rt (close th.σs τ)
  have harmS : (armsOf S)[B0.tag]? = some arm := by
    simp only [S, armsOf]; rw [List.getElem?_append_left hj]; exact harm
  have hSb : isBoxed S = true := by simp [S, isBoxed, sumHead, hS]
  let s := stOf mem pairs th
  obtain ⟨hne, hpr⟩ := projM_own (g := g) (s := s) (t := rt) hbi hsee0 hrb hw hx0 hB0 harm hus hnw.symm
  have key : tstep g mem pairs th = (projM g s rt [w]).flatMap fun r1 =>
      (injM g r1.1 S r1.2.1 r1.2.2).map fun r2 =>
        (r2.1.mem, r2.1.pairs, withS { th with term := e, env := (x, S, r2.2) :: th.env } r2.1) := by
    simp only [tstep, hterm, evalOp, hea, List.map_flatMap, List.map_map]; rfl
  have hinj : ∀ r1 ∈ projM g s rt [w], PromAbove r1.1 → injM g r1.1 S r1.2.1 r1.2.2 =
      (alloc g.k g.arch (freshLabel g.lbase g.n g.i r1.1.nalloc) (.one :: us) (cst (.num B0.tag) :: r1.2.2) r1.1).map
        fun (s', pw) => (if g.boxFence then fenceS s' .st else s', [pw]) := by
    intro r1 h1 hp
    rw [((hpr r1 h1).2 hp).1]; exact injM_box hSb (by rw [harmS]; exact hus)
  unfold PAx at hpx
  rw [key] at hpx
  rw [key]
  refine ⟨?_, ?_⟩
  · rcases hpx with h0 | ⟨r, hr, -⟩
    rotate_left
    · exact List.ne_nil_of_mem hr
    obtain ⟨r1, h1, hp1⟩ := hne h0
    have hlen : r1.2.2.length = nWords us := by rw [← ((hpr r1 h1).2 hp1).2.1.length, hnw]
    obtain ⟨r, hr⟩ := alloc_nonempty (k := g.k) (arch := g.arch)
      (lbl := freshLabel g.lbase g.n g.i r1.1.nalloc) (us := .one :: us)
      (ws := cst (.num B0.tag) :: r1.2.2) (s := r1.1) (by simp [nWords, Acc.size] at hlen ⊢; omega)
    have hmem : ((injM g r1.1 S r1.2.1 r1.2.2).map fun r2 =>
        (r2.1.mem, r2.1.pairs, withS { th with term := e, env := (x, S, r2.2) :: th.env } r2.1)) ≠ [] := by
      rw [hinj r1 h1 hp1, List.map_map]; exact List.ne_nil_of_mem (List.mem_map_of_mem hr)
    intro hnil; rw [List.flatMap_eq_nil_iff] at hnil; exact hmem (hnil r1 h1)
  · intro r hr hpr0
    rw [List.mem_flatMap] at hr
    obtain ⟨r1, h1, hr⟩ := hr
    have hp1 : PromAbove r1.1 := by
      obtain ⟨f1, f2⟩ := (hpr r1 h1).1
      have hpl1 : PromLt r1.1 := fun t ht => by rw [f1]; exact hm.2.2.1 t (by rw [← f2]; exact ht)
      have hpa' := hpr0
      obtain ⟨r2, hr2, rfl⟩ := List.mem_map.1 hr
      exact injM_pa hpl1 hr2 hpa'
    obtain ⟨-, hWp, e1, e2, e3, e4, e5, e6, e7⟩ := (hpr r1 h1).2 hp1
    rw [hinj r1 h1 hp1, List.map_map, List.mem_map] at hr
    obtain ⟨⟨s', pw⟩, hal, rfl⟩ := hr
    obtain ⟨s1, j1, p1⟩ := r1
    simp only at hWp e1 e2 e3 e4 e5 e6 e7 hal ⊢
    have hm1 : MemInv g (CE η) s1 := MemInv_load hm e1 e2 (LoadCoh_rd hm.2.1 hsto0 hB0 e3) e4 e5 e6 e7
    have hH1 : MemHeldL (CE η) s1 H Sp := MemHeldL_eqs hH e1 e4
    have hlen : p1.length = nWords us := by rw [← hWp.length, hnw]
    let lbl := freshLabel g.lbase g.n g.i s1.nalloc
    let V := s1.vs.vRelSt
    let B : Box := ⟨B0.tag, p1.map (bumpW V), (CE η).tid, s'.vs.vWr⟩
    have hHb := MemHeldL_box hm1 hH1 hal B
    obtain ⟨hm', hpw⟩ := MemInv_boxF (us := us) hm1 hn hbf hal hlen
    simp only at hpw hHb
    subst hpw
    have hbnone : η.box lbl = none := hm1.2.2.2.2.2.2.2.2.2.1.1 s1.nalloc (Nat.le_refl _)
    have hstoL : η.sto lbl = none := (hm1.2.2.2.1.1 s1.nalloc (Nat.le_refl _)).1
    have hpfL : η.pfr lbl = none := (hm1.2.2.2.1.1 s1.nalloc (Nat.le_refl _)).2.2.2
    have hne0 : x0.label ≠ lbl := fun e => by rw [e, hbnone] at hB0; cases hB0
    let η' := η.withSto η.sto (P := fun l => if l = lbl then some s'.vs.vWr else η.pfr l)
      (S := fun l => l = lbl ∨ η.seen l) (Bx := fun l => if l = lbl then some B else η.box l)
    have hx : Ext η η' := Ext_withSto hE.2.1 (fun _ _ h => h) (fun _ => Nat.le_refl _) (hS := fun _ h => Or.inr h)
      (hP := fun l f h => by
        have hne : l ≠ lbl := fun e => by rw [e, hpfL] at h; cases h
        simp only [hne, ↓reduceIte]; exact h)
      (hB := fun l B' h => by
        have hne : l ≠ lbl := fun e => by rw [e, hbnone] at h; cases h
        simp only [hne, ↓reduceIte]; exact h)
    have hcr' : CohR η' := hx.2.2.2.2.2.2.2.2.2.2.1
    have hCE : CE η' = seeBoxE (CE η) lbl B s'.vs.vWr := rfl
    have hBS : BoxSeen η' lbl B := ⟨by simp [η', TEnv.withSto], s'.vs.vWr, by simp [η', TEnv.withSto], Nat.le_refl _⟩
    have hv0 : VRR ρ η' t (vsh 0 (shp rt)) [w] R := by rw [vsh_zero rt hrb]; exact VRR_ext hE.2.1 hE.2.2 hx hv
    have hv1 : VRR ρ η' t (vsh 0 (shp rt)) [cst (.loc ⟨lbl, 0⟩ 0)] R :=
      VRR_ren (B1 := B0) (B2 := B) hx.1 hcr' hw rfl rfl
        (by simp [η', TEnv.withSto, hne0, hB0]) (by simp [η', TEnv.withSto])
        (by simpa [η', TEnv.withSto] using hsto0)
        (by simp [η', TEnv.withSto, hini0]) rfl (WLe_trans hWp (WLe_bump V p1)) (Or.inl hBS)
        (by rw [vsh_zero rt hrb] at *; exact bh_shp rt hrb) hv0
        (by simp [η', TEnv.withSto, hini0])
    have hvr : VRR ρ η' (.sum t τ) (shp S) [cst (.loc ⟨lbl, 0⟩ 0)] R :=
      VRR_boxLB (B := B) hS hrb rfl rfl (by simp [η', TEnv.withSto]) (Or.inl hBS) hj hv1
        (by show ((armsOf S)[B0.tag]?).bind wc = some (p1.map (bumpW V)).length
            rw [harmS]; simp [wc, hus, hlen, List.length_map])
    have hf := FInvR_mono (bindR hb (FInvR_ext hE.2.1 hE.2.2 hx hi1) (RLink_of hx.1 hcr') hvr
      (Lay_box hl hS)) (res_swap_le hle)
    refine ⟨Rf + Rs, H, ⟨CE η', EFoot_congr (s1 := s1) (by rw [hCE]; exact EFoot_seeBox (nalloc_alloc_box hm1.2.2.1 hal) rfl hpfL hstoL (alloc_size_fr hal) (by first | exact Nat.le_refl _ | (simp only [hbf, ↓reduceIte]; exact Nat.le_refl _) | (simp only [hbf, ↓reduceIte, stOf, withS]; exact Nat.le_refl _)) (alloc_size_len _ hal (by first | exact hlen | exact hnw.symm))) e5 e7 (congrArg Array.size e1) e4 e1, (by seenT), (by rw [hCE]; refine BoxNewV_seeBox hbnone ?_; intro e0 env0 he hs hev; have hev' := envV_tail he hev; obtain ⟨hp1, hV1⟩ := pV_of_proj h1 hea hs hev'; exact payV_lt hp1 hV1 (alloc_size_len _ hal hlen)),
      ⟨ρ, η', c', Rf, Rs, rfl, ⟨hE.1, hx.1, hcr'⟩, he.ext hx, htv', hf, rfl, by rw [bind_ret hb]; exact hRP⟩, ?_, ?_, ?_⟩,
      Res.le_refl _⟩
    · rw [hCE]; exact hm'
    · rw [hCE]; exact MemHeldK_of (MemHeldL_seeE (lbl := lbl) (F := s'.vs.vWr) hHb hstoL hpfL)
    · rw [hCE]; exact CrKeep_trans (CrKeep_eqs e1 e4) (CrKeep_seeE (lbl := lbl) (F := s'.vs.vWr) (CrKeep_box hm1 hal B) hstoL)

/-- (P4) **`inr` into a boxed sum, boxed operand, with resources.** -/
theorem tstepMR_inrBB {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {ρ : Nat → Nat} {η : TEnv} {x : String} {τ : Ty} {a : At} {e : Expr} {t : Ty} {c₁ : Cx}
    {rt : Ty} {ws : List Word} {R Rr Rf Rs H : Res} (hterm : th.term = .let_ x (.inr τ a) e) (hn : 0 < g.n)
    (hc' : ∀ c', c₁.bind x (.sum τ t) = .ok c' → TypedK p η c' e ∧ TvOK c')
    (hb : ∃ c', c₁.bind x (.sum τ t) = .ok c')
    (hi1 : FInvR ρ η th.σs (ResumeR p th.stack Rs) c₁ th.env Rr) (hle : R + Rr ≤ Rf)
    (hea : evalAt th.env a = some (rt, ws)) (hvV : VR ρ η t (shp rt) ws) (hv : VRR ρ η t (shp rt) ws R)
    (hl : Lay th.σs t rt ws)
    (hS : (Ty.sum (close th.σs τ) rt).tier = .boxed) (hrb : isBoxed rt = true)
    (hsg : sig rt = sig (cl ρ η.wit 0 0 t))
    (hE : EnvOK p η) (hm : MemInv g (CE η) (stOf mem pairs th)) (hbf : g.boxFence = true) (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hpx : PAx g mem pairs th) (hRP : RetPw th.σs th.stack c₁.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      ∃ Tot H', ThInvMK p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H := by
  obtain ⟨c', hb⟩ := hb
  obtain ⟨he, htv'⟩ := hc' c' hb
  have hbi := hm.2.2.2.2.2.2.2.2.2.1
  obtain ⟨w, x0, B0, arm, us, rfl, hw, hx0, hB0, harm, hus, hnw, hsto0, hini0, hsee0⟩ :=
    boxed_operand hE.2.1 hbi hrb hsg hvV
  have hj : B0.tag < (armsOf rt).length := (List.getElem?_eq_some_iff.mp harm).1
  let n := (armsOf (close th.σs τ)).length
  let S := Ty.sum (close th.σs τ) rt
  have harmS : (armsOf S)[n + B0.tag]? = some arm := by
    simp only [S, armsOf]; rw [List.getElem?_append_right (Nat.le_add_right _ _), Nat.add_sub_cancel_left]
    exact harm
  have hSb : isBoxed S = true := by simp [S, isBoxed, sumHead, hS]
  let s := stOf mem pairs th
  obtain ⟨hne, hpr⟩ := projM_own (g := g) (s := s) (t := rt) hbi hsee0 hrb hw hx0 hB0 harm hus hnw.symm
  have key : tstep g mem pairs th = (projM g s rt [w]).flatMap fun r1 =>
      (injM g r1.1 S (n + r1.2.1) r1.2.2).map fun r2 =>
        (r2.1.mem, r2.1.pairs, withS { th with term := e, env := (x, S, r2.2) :: th.env } r2.1) := by
    simp only [tstep, hterm, evalOp, hea, List.map_flatMap, List.map_map]; rfl
  have hinj : ∀ r1 ∈ projM g s rt [w], PromAbove r1.1 → injM g r1.1 S (n + r1.2.1) r1.2.2 =
      (alloc g.k g.arch (freshLabel g.lbase g.n g.i r1.1.nalloc) (.one :: us) (cst (.num (n + B0.tag)) :: r1.2.2) r1.1).map
        fun (s', pw) => (if g.boxFence then fenceS s' .st else s', [pw]) := by
    intro r1 h1 hp
    rw [((hpr r1 h1).2 hp).1]; exact injM_box hSb (by rw [harmS]; exact hus)
  unfold PAx at hpx
  rw [key] at hpx
  rw [key]
  refine ⟨?_, ?_⟩
  · rcases hpx with h0 | ⟨r, hr, -⟩
    rotate_left
    · exact List.ne_nil_of_mem hr
    obtain ⟨r1, h1, hp1⟩ := hne h0
    have hlen : r1.2.2.length = nWords us := by rw [← ((hpr r1 h1).2 hp1).2.1.length, hnw]
    obtain ⟨r, hr⟩ := alloc_nonempty (k := g.k) (arch := g.arch)
      (lbl := freshLabel g.lbase g.n g.i r1.1.nalloc) (us := .one :: us)
      (ws := cst (.num (n + B0.tag)) :: r1.2.2) (s := r1.1) (by simp [nWords, Acc.size] at hlen ⊢; omega)
    have hmem : ((injM g r1.1 S (n + r1.2.1) r1.2.2).map fun r2 =>
        (r2.1.mem, r2.1.pairs, withS { th with term := e, env := (x, S, r2.2) :: th.env } r2.1)) ≠ [] := by
      rw [hinj r1 h1 hp1, List.map_map]; exact List.ne_nil_of_mem (List.mem_map_of_mem hr)
    intro hnil; rw [List.flatMap_eq_nil_iff] at hnil; exact hmem (hnil r1 h1)
  · intro r hr hpr0
    rw [List.mem_flatMap] at hr
    obtain ⟨r1, h1, hr⟩ := hr
    have hp1 : PromAbove r1.1 := by
      obtain ⟨f1, f2⟩ := (hpr r1 h1).1
      have hpl1 : PromLt r1.1 := fun t ht => by rw [f1]; exact hm.2.2.1 t (by rw [← f2]; exact ht)
      have hpa' := hpr0
      obtain ⟨r2, hr2, rfl⟩ := List.mem_map.1 hr
      exact injM_pa hpl1 hr2 hpa'
    obtain ⟨-, hWp, e1, e2, e3, e4, e5, e6, e7⟩ := (hpr r1 h1).2 hp1
    rw [hinj r1 h1 hp1, List.map_map, List.mem_map] at hr
    obtain ⟨⟨s', pw⟩, hal, rfl⟩ := hr
    obtain ⟨s1, j1, p1⟩ := r1
    simp only at hWp e1 e2 e3 e4 e5 e6 e7 hal ⊢
    have hm1 : MemInv g (CE η) s1 := MemInv_load hm e1 e2 (LoadCoh_rd hm.2.1 hsto0 hB0 e3) e4 e5 e6 e7
    have hH1 : MemHeldL (CE η) s1 H Sp := MemHeldL_eqs hH e1 e4
    have hlen : p1.length = nWords us := by rw [← hWp.length, hnw]
    let lbl := freshLabel g.lbase g.n g.i s1.nalloc
    let V := s1.vs.vRelSt
    let B : Box := ⟨n + B0.tag, p1.map (bumpW V), (CE η).tid, s'.vs.vWr⟩
    have hHb := MemHeldL_box hm1 hH1 hal B
    obtain ⟨hm', hpw⟩ := MemInv_boxF (us := us) hm1 hn hbf hal hlen
    simp only at hpw hHb
    subst hpw
    have hbnone : η.box lbl = none := hm1.2.2.2.2.2.2.2.2.2.1.1 s1.nalloc (Nat.le_refl _)
    have hstoL : η.sto lbl = none := (hm1.2.2.2.1.1 s1.nalloc (Nat.le_refl _)).1
    have hpfL : η.pfr lbl = none := (hm1.2.2.2.1.1 s1.nalloc (Nat.le_refl _)).2.2.2
    have hne0 : x0.label ≠ lbl := fun e => by rw [e, hbnone] at hB0; cases hB0
    let η' := η.withSto η.sto (P := fun l => if l = lbl then some s'.vs.vWr else η.pfr l)
      (S := fun l => l = lbl ∨ η.seen l) (Bx := fun l => if l = lbl then some B else η.box l)
    have hx : Ext η η' := Ext_withSto hE.2.1 (fun _ _ h => h) (fun _ => Nat.le_refl _) (hS := fun _ h => Or.inr h)
      (hP := fun l f h => by
        have hne : l ≠ lbl := fun e => by rw [e, hpfL] at h; cases h
        simp only [hne, ↓reduceIte]; exact h)
      (hB := fun l B' h => by
        have hne : l ≠ lbl := fun e => by rw [e, hbnone] at h; cases h
        simp only [hne, ↓reduceIte]; exact h)
    have hcr' : CohR η' := hx.2.2.2.2.2.2.2.2.2.2.1
    have hCE : CE η' = seeBoxE (CE η) lbl B s'.vs.vWr := rfl
    have hBS : BoxSeen η' lbl B := ⟨by simp [η', TEnv.withSto], s'.vs.vWr, by simp [η', TEnv.withSto], Nat.le_refl _⟩
    have hv0 : VRR ρ η' t (vsh 0 (shp rt)) [w] R := by rw [vsh_zero rt hrb]; exact VRR_ext hE.2.1 hE.2.2 hx hv
    have hv1 : VRR ρ η' t (vsh n (shp rt)) [cst (.loc ⟨lbl, 0⟩ 0)] R :=
      VRR_ren (B1 := B0) (B2 := B) hx.1 hcr' hw rfl rfl
        (by simp [η', TEnv.withSto, hne0, hB0]) (by simp [η', TEnv.withSto])
        (by simpa [η', TEnv.withSto] using hsto0)
        (by simp [η', TEnv.withSto, hini0]) (show B0.tag + n = (n + B0.tag) + 0 by omega) (WLe_trans hWp (WLe_bump V p1)) (Or.inl hBS)
        (by rw [vsh_zero rt hrb] at *; exact bh_shp rt hrb) hv0
        (by simp [η', TEnv.withSto, hini0])
    have hvr : VRR ρ η' (.sum τ t) (shp S) [cst (.loc ⟨lbl, 0⟩ 0)] R :=
      VRR_boxRB (B := B) hS hrb rfl rfl (by simp [η', TEnv.withSto]) (Or.inl hBS) (Nat.le_add_right _ _) hv1
        (by show ((armsOf S)[n + B0.tag]?).bind wc = some (p1.map (bumpW V)).length
            rw [harmS]; simp [wc, hus, hlen, List.length_map])
    have hf := FInvR_mono (bindR hb (FInvR_ext hE.2.1 hE.2.2 hx hi1) (RLink_of hx.1 hcr') hvr
      (TermSound.Lay_boxR hl hS)) (res_swap_le hle)
    refine ⟨Rf + Rs, H, ⟨CE η', EFoot_congr (s1 := s1) (by rw [hCE]; exact EFoot_seeBox (nalloc_alloc_box hm1.2.2.1 hal) rfl hpfL hstoL (alloc_size_fr hal) (by first | exact Nat.le_refl _ | (simp only [hbf, ↓reduceIte]; exact Nat.le_refl _) | (simp only [hbf, ↓reduceIte, stOf, withS]; exact Nat.le_refl _)) (alloc_size_len _ hal (by first | exact hlen | exact hnw.symm))) e5 e7 (congrArg Array.size e1) e4 e1, (by seenT), (by rw [hCE]; refine BoxNewV_seeBox hbnone ?_; intro e0 env0 he hs hev; have hev' := envV_tail he hev; obtain ⟨hp1, hV1⟩ := pV_of_proj h1 hea hs hev'; exact payV_lt hp1 hV1 (alloc_size_len _ hal hlen)),
      ⟨ρ, η', c', Rf, Rs, rfl, ⟨hE.1, hx.1, hcr'⟩, he.ext hx, htv', hf, rfl, by rw [bind_ret hb]; exact hRP⟩, ?_, ?_, ?_⟩,
      Res.le_refl _⟩
    · rw [hCE]; exact hm'
    · rw [hCE]; exact MemHeldK_of (MemHeldL_seeE (lbl := lbl) (F := s'.vs.vWr) hHb hstoL hpfL)
    · rw [hCE]; exact CrKeep_trans (CrKeep_eqs e1 e4) (CrKeep_seeE (lbl := lbl) (F := s'.vs.vWr) (CrKeep_box hm1 hal B) hstoL)

section
variable {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {cx : Cx} {ρ : Nat → Nat} {η : TEnv}

/-- **(P4) `inl`, every tier, with resources**: a boxed sum moves the
operand's resources into the box reference; memory's holding is unchanged. -/
theorem tstepMR_inlT {Sp : AllocLabel → List Res} {x : String} {τ : Ty} {a : At} {e : Expr} {Rf Rs H : Res}
    (hterm : th.term = .let_ x (.inl τ a) e) (hP : ProgT p) (hn : 0 < g.n)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hbf : g.boxFence = true)
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hpx : PAx g mem pairs th) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      ∃ Tot H', ThInvMK p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H := by
  have hT0 := hT
  have hCk0 := hCk
  rw [hterm] at hT0 hCk0
  cases hT0 with
  | let_ hop he =>
    rename_i c'
    obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk0
    have htv' := OpT_TvOK hP hop htv
    cases hop with
    | inl _ hu hb =>
      obtain ⟨t, c₁, hu, hb⟩ : ∃ t c₁, cx.use a = .ok (t, c₁) ∧ c₁.bind x (.sum t τ) = .ok c' :=
        ⟨_, _, hu, hb⟩
      obtain ⟨rt, ws, R, Rr, hea, hvV, hl, hv, hi1, hle⟩ := useR hu hi hE.2.2
      have hsk : (Ty.sum rt (close th.σs τ)).tier = (close th.σs (.sum _ τ)).tier :=
        tier_of_eskel (by show Ty.sum (etok (skel rt)) _ = _; rw [hl.2.1]; rfl)
      have hc' : ∀ c'', c₁.bind x (.sum t τ) = .ok c'' → TypedK p η c'' e ∧ TvOK c'' := fun c'' h => by
        rw [hb] at h; cases h; exact ⟨⟨he, hck⟩, htv'⟩
      by_cases hS : (Ty.sum rt (close th.σs τ)).tier = .boxed
      · cases hrb : isBoxed rt with
        | false => exact paW <| tstepMR_inlB (hbf := hbf) hterm hn hc' ⟨c', hb⟩ hi1 hle hea hv hl hS hrb hE hm hH (by rw [use_ret hu]; exact hRP)
        | true =>
            have ho : cx.opaqueOK _ = true :=
              peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
            have htb := (use_TvOK hu htv).2.1
            exact tstepMR_inlBB (hbf := hbf) hterm hn hc' ⟨c', hb⟩ hi1 hle hea hvV hv hl hS hrb
              (lay_closed hi.1.2.2.2.1 hi.1.2.2.2.2.1 ho htb hl) hE hm hH hpx (by rw [use_ret hu]; exact hRP)
      · refine paW <| liftMR hm hH (tstep_inlR hterm hP (fun t' c₁' hu' => ?_) hT hCk hi hE htv hRP hPS)
          (same_inl hterm fun t0 ws0 hea0 => ?_)
        · rw [hu, Except.ok.injEq, Prod.mk.injEq] at hu'; obtain ⟨rfl, rfl⟩ := hu'
          rw [← hsk]; exact hS
        · rw [hea, Option.some.injEq, Prod.mk.injEq] at hea0; obtain ⟨rfl, rfl⟩ := hea0
          exact hS

/-- **(P4) `inr`, every tier, with resources.** -/
theorem tstepMR_inrT {Sp : AllocLabel → List Res} {x : String} {τ : Ty} {a : At} {e : Expr} {Rf Rs H : Res}
    (hterm : th.term = .let_ x (.inr τ a) e) (hP : ProgT p) (hn : 0 < g.n)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hbf : g.boxFence = true)
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hpx : PAx g mem pairs th) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      ∃ Tot H', ThInvMK p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H := by
  have hT0 := hT
  have hCk0 := hCk
  rw [hterm] at hT0 hCk0
  cases hT0 with
  | let_ hop he =>
    rename_i c'
    obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk0
    have htv' := OpT_TvOK hP hop htv
    cases hop with
    | inr _ hu hb =>
      obtain ⟨t, c₁, hu, hb⟩ : ∃ t c₁, cx.use a = .ok (t, c₁) ∧ c₁.bind x (.sum τ t) = .ok c' :=
        ⟨_, _, hu, hb⟩
      obtain ⟨rt, ws, R, Rr, hea, hvV, hl, hv, hi1, hle⟩ := useR hu hi hE.2.2
      have hsk : (Ty.sum (close th.σs τ) rt).tier = (close th.σs (.sum τ _)).tier :=
        tier_of_eskel (by show Ty.sum _ (etok (skel rt)) = _; rw [hl.2.1]; rfl)
      have hc' : ∀ c'', c₁.bind x (.sum τ t) = .ok c'' → TypedK p η c'' e ∧ TvOK c'' := fun c'' h => by
        rw [hb] at h; cases h; exact ⟨⟨he, hck⟩, htv'⟩
      by_cases hS : (Ty.sum (close th.σs τ) rt).tier = .boxed
      · cases hrb : isBoxed rt with
        | false => exact paW <| tstepMR_inrB (hbf := hbf) hterm hn hc' ⟨c', hb⟩ hi1 hle hea hv hl hS hrb hE hm hH (by rw [use_ret hu]; exact hRP)
        | true =>
            have ho : cx.opaqueOK _ = true :=
              peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
            have htb := (use_TvOK hu htv).2.1
            exact tstepMR_inrBB (hbf := hbf) hterm hn hc' ⟨c', hb⟩ hi1 hle hea hvV hv hl hS hrb
              (lay_closed hi.1.2.2.2.1 hi.1.2.2.2.2.1 ho htb hl) hE hm hH hpx (by rw [use_ret hu]; exact hRP)
      · refine paW <| liftMR hm hH (tstep_inrR hterm hP (fun t' c₁' hu' => ?_) hT hCk hi hE htv hRP hPS)
          (same_inr hterm fun t0 ws0 hea0 => ?_)
        · rw [hu, Except.ok.injEq, Prod.mk.injEq] at hu'; obtain ⟨rfl, rfl⟩ := hu'
          rw [← hsk]; exact hS
        · rw [hea, Option.some.injEq, Prod.mk.injEq] at hea0; obtain ⟨rfl, rfl⟩ := hea0
          exact hS
end

/-- (P4) **`case` on a box, an unboxed summand, with resources**: the
payload, rebuilt, is bound carrying the scrutinee's resources. -/
theorem case_armNBR {Sp : AllocLabel → List Res} {p : Prog} {g : G} {th : TTh} {ρ : Nat → Nat} {η : TEnv} {s1 : St} {xv : String}
    {e' : Expr} {u ty : Ty} {c₁ c' : Cx} {j : Nat} {p1 q1 : List Word} {R Rr Rf Rs H : Res}
    (hb : c₁.bind xv u = .ok c') (he : TypedK p η c' e') (htv : TvOK c')
    (hi1 : FInvR ρ η th.σs (ResumeR p th.stack Rs) c₁ th.env Rr) (hle : R + Rr ≤ Rf) (hE : EnvOK p η)
    (hm1 : MemInv g (CE η) s1) (hH1 : MemHeldL (CE η) s1 H Sp) {S0 : St}
    (hk1 : CrKeep (CE η) (CE η) S0 s1)
    (hty : isBoxed ty = false) (hq : ofArm ty j p1 = some q1) (hlay : Lay th.σs u ty q1)
    (hvr : VRR ρ η u (shp ty) q1 R) (hRP : RetPw th.σs th.stack c₁.ret) :
    injM g s1 ty j p1 ≠ [] ∧ ∀ r2 ∈ injM g s1 ty j p1, ∃ Tot H',
      ThInvMK p g (CE η) S0 Sp r2.1.mem r2.1.pairs (withS { th with term := e', env := (xv, ty, r2.2) :: th.env } r2.1) Tot H' ∧
      Tot + H' ≤ Rf + Rs + H := by
  rw [injM_nbB hty, hq]
  refine ⟨by simp [ol], fun r2 hr2 => ?_⟩
  simp [ol] at hr2; subst hr2
  have hf := FInvR_mono (bindR hb hi1 (RLink_of hE.2.1 hE.2.2) hvr hlay) (res_swap_le hle)
  exact ⟨Rf + Rs, H, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Rf, Rs, rfl, hE, he, htv, by simpa [withS] using hf, rfl, by rw [bind_ret hb]; exact hRP⟩, hm1, MemHeldK_of hH1, hk1⟩,
    Res.le_refl _⟩

/-- (P4) **`case` on a box, a boxed summand, with resources**: the re-boxed
reference carries the scrutinee's resources (`VRR_ren`); memory's holding is
unchanged (`MemHeld_box`). -/
theorem case_armBR {Sp : AllocLabel → List Res} {p : Prog} {g : G} {th : TTh} {ρ : Nat → Nat} {η : TEnv} {s1 : St} {xv : String}
    {e' : Expr} {u ty : Ty} {c₁ c' : Cx} {j : Nat} {p1 : List Word} {us : List Acc} {w : Word}
    {x0 : Address} {B0 : Box} {s0 : Nat} {R Rr Rf Rs H : Res}
    (hb : c₁.bind xv u = .ok c') (he : TypedK p η c' e') (htv : TvOK c')
    (hi1 : FInvR ρ η th.σs (ResumeR p th.stack Rs) c₁ th.env Rr) (hle : R + Rr ≤ Rf) (hE : EnvOK p η)
    (hm1 : MemInv g (CE η) s1) (hH1 : MemHeldL (CE η) s1 H Sp)
    {S0 : St}
    (hk1 : CrKeep (CE η) (CE η) S0 s1) (hn1 : s1.nalloc = S0.nalloc)
    (hn : 0 < g.n) (hbf : g.boxFence = true) (hty : isBoxed ty = true) (hus : (armsOf ty)[j]?.bind accs = some us)
    (hlen : p1.length = nWords us) (hw : w.val = .loc x0 0) (hB0 : η.box x0.label = some B0)
    (hsto0 : η.sto x0.label = none) (hini0 : η.ini x0.label = 0) (ht : B0.tag = j + s0)
    (hWp : WLe B0.pay p1) (hv : VRR ρ η u (vsh s0 (shp ty)) [w] R) (hlay : ∀ pw, Lay th.σs u ty [pw])
    (hpV : TermViewInv.StV S0 → TermViewInv.EnvV S0.mem.size th.env →
      TermViewInv.WsV s1.mem.size p1 ∧ s1.vs.vRelSt ≤ s1.mem.size) (hRP : RetPw th.σs th.stack c₁.ret) :
    injM g s1 ty j p1 ≠ [] ∧ ∀ r2 ∈ injM g s1 ty j p1, ∃ Tot H',
      ThInvMK p g (CE η) S0 Sp r2.1.mem r2.1.pairs (withS { th with term := e', env := (xv, ty, r2.2) :: th.env } r2.1) Tot H' ∧
      Tot + H' ≤ Rf + Rs + H := by
  rw [injM_box hty hus]
  refine ⟨?_, fun r2 hr2 => ?_⟩
  · obtain ⟨r, hr⟩ := alloc_nonempty (k := g.k) (arch := g.arch)
      (lbl := freshLabel g.lbase g.n g.i s1.nalloc) (us := .one :: us)
      (ws := cst (.num j) :: p1) (s := s1) (by simp [nWords, Acc.size] at hlen ⊢; omega)
    exact List.ne_nil_of_mem (List.mem_map_of_mem hr)
  · rw [List.mem_map] at hr2
    obtain ⟨⟨s', pw⟩, hal, rfl⟩ := hr2
    let lbl := freshLabel g.lbase g.n g.i s1.nalloc
    let V := s1.vs.vRelSt
    let B : Box := ⟨j, p1.map (bumpW V), (CE η).tid, s'.vs.vWr⟩
    have hHb := MemHeldL_box hm1 hH1 hal B
    obtain ⟨hm', hpw⟩ := MemInv_boxF (us := us) hm1 hn hbf hal hlen
    simp only at hpw hHb
    subst hpw
    have hbnone : η.box lbl = none := hm1.2.2.2.2.2.2.2.2.2.1.1 s1.nalloc (Nat.le_refl _)
    have hstoL : η.sto lbl = none := (hm1.2.2.2.1.1 s1.nalloc (Nat.le_refl _)).1
    have hpfL : η.pfr lbl = none := (hm1.2.2.2.1.1 s1.nalloc (Nat.le_refl _)).2.2.2
    have hne0 : x0.label ≠ lbl := fun e => by rw [e, hbnone] at hB0; cases hB0
    let η' := η.withSto η.sto (P := fun l => if l = lbl then some s'.vs.vWr else η.pfr l)
      (S := fun l => l = lbl ∨ η.seen l) (Bx := fun l => if l = lbl then some B else η.box l)
    have hx : Ext η η' := Ext_withSto hE.2.1 (fun _ _ h => h) (fun _ => Nat.le_refl _) (hS := fun _ h => Or.inr h)
      (hP := fun l f h => by
        have hne : l ≠ lbl := fun e => by rw [e, hpfL] at h; cases h
        simp only [hne, ↓reduceIte]; exact h)
      (hB := fun l B' h => by
        have hne : l ≠ lbl := fun e => by rw [e, hbnone] at h; cases h
        simp only [hne, ↓reduceIte]; exact h)
    have hcr' : CohR η' := hx.2.2.2.2.2.2.2.2.2.2.1
    have hCE : CE η' = seeBoxE (CE η) lbl B s'.vs.vWr := rfl
    have hBS : BoxSeen η' lbl B := ⟨by simp [η', TEnv.withSto], s'.vs.vWr, by simp [η', TEnv.withSto], Nat.le_refl _⟩
    have hv0 : VRR ρ η' u (vsh s0 (shp ty)) [w] R := VRR_ext hE.2.1 hE.2.2 hx hv
    have hv1 : VRR ρ η' u (vsh 0 (shp ty)) [cst (.loc ⟨lbl, 0⟩ 0)] R :=
      VRR_ren (B1 := B0) (B2 := B) hx.1 hcr' hw rfl rfl
        (by simp [η', TEnv.withSto, hne0, hB0]) (by simp [η', TEnv.withSto])
        (by simpa [η', TEnv.withSto] using hsto0)
        (by simp [η', TEnv.withSto, hini0]) (by show B0.tag + 0 = j + s0; omega)
        (WLe_trans hWp (WLe_bump V p1)) (Or.inl hBS) (bh_shp ty hty) hv0
        (by simp [η', TEnv.withSto, hini0])
    rw [vsh_zero ty hty] at hv1
    have hf := FInvR_mono (bindR hb (FInvR_ext hE.2.1 hE.2.2 hx hi1) (RLink_of hx.1 hcr') hv1 (hlay _))
      (res_swap_le hle)
    refine ⟨Rf + Rs, H, ⟨CE η', by
        rw [hCE]
        show EFoot g (CE η) (seeBoxE (CE η) (freshLabel g.lbase g.n g.i s1.nalloc) B s'.vs.vWr) S0 _
        rw [hn1]
        exact EFoot_seeBox (by rw [← hn1]; exact nalloc_alloc_box hm1.2.2.1 hal) rfl (by rw [← hn1]; exact hpfL)
          (by rw [← hn1]; exact hstoL) (Nat.le_trans hk1.2.1 (alloc_size_fr hal)) (by first | exact Nat.le_refl _ | (simp only [hbf, ↓reduceIte]; exact Nat.le_refl _) | (simp only [hbf, ↓reduceIte, stOf, withS]; exact Nat.le_refl _)) (Nat.le_trans (Nat.add_le_add_right hk1.2.1 _) (alloc_size_len _ hal hlen)), (by seenT), (by rw [hCE]; refine BoxNewV_seeBox hbnone ?_; intro e0 env0 he hs hev; have hev' := envV_tail he hev; obtain ⟨hp1, hV1⟩ := hpV hs hev'; exact payV_lt hp1 hV1 (alloc_size_len _ hal hlen)),
      ⟨ρ, η', c', Rf, Rs, rfl, ⟨hE.1, hx.1, hcr'⟩, he.ext hx, htv,
      by simpa [withS] using hf, rfl, by rw [bind_ret hb]; exact hRP⟩, ?_, ?_, ?_⟩, Res.le_refl _⟩
    · rw [hCE]; exact hm'
    · rw [hCE]; exact MemHeldK_of (MemHeldL_seeE (lbl := lbl) (F := s'.vs.vWr) hHb hstoL hpfL)
    · rw [hCE]; exact CrKeep_trans hk1 (CrKeep_seeE (lbl := lbl) (F := s'.vs.vWr) (CrKeep_box hm1 hal B) hstoL)

/-- (P4) **`case` on a boxed scrutinee, with resources**: the scrutinee's
reference carries its box's payload resources (`VRR`'s boxed clause), which
the summand bound gets; memory's holding is unchanged. -/
theorem tstepMR_caseB {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {ρ : Nat → Nat} {η : TEnv} {a : At} {x y : String} {e₁ e₂ : Expr} {u v : Ty} {c₁ c₂ c₃ : Cx}
    {ra rb : Ty} {ws : List Word} {R Rr Rf Rs H : Res} (hterm : th.term = .case a x e₁ y e₂) (hn : 0 < g.n)
    (hb1 : c₁.bind x u = .ok c₂) (he1 : TypedK p η c₂ e₁) (htv1 : TvOK c₂)
    (hb2 : c₁.bind y v = .ok c₃) (he2 : TypedK p η c₃ e₂) (htv2 : TvOK c₃)
    (hi1 : FInvR ρ η th.σs (ResumeR p th.stack Rs) c₁ th.env Rr) (hle : R + Rr ≤ Rf)
    (hea : evalAt th.env a = some (.sum ra rb, ws)) (hvV : VR ρ η (.sum u v) (shp (.sum ra rb)) ws)
    (hvR : VRR ρ η (.sum u v) (shp (.sum ra rb)) ws R)
    (hl : Lay th.σs (.sum u v) (.sum ra rb) ws) (hS : (Ty.sum ra rb).tier = .boxed)
    (hsg : sig (.sum ra rb) = sig (cl ρ η.wit 0 0 (.sum u v)))
    (hE : EnvOK p η) (hm : MemInv g (CE η) (stOf mem pairs th)) (hbf : g.boxFence = true) (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hpx : PAx g mem pairs th) (hRP1 : RetPw th.σs th.stack c₁.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      ∃ Tot H', ThInvMK p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H := by
  have hbi := hm.2.2.2.2.2.2.2.2.2.1
  have hrb : isBoxed (.sum ra rb) = true := by simp [isBoxed, sumHead, hS]
  obtain ⟨w, x0, B0, arm, us, rfl, hw, hx0, hB0, harm, hus, hnw, hsto0, hini0, hsee0⟩ :=
    boxed_operand hE.2.1 hbi hrb hsg hvV
  -- the box clause, at offset 0
  have hv' := hvR
  simp only [VRR, shp] at hv'
  obtain ⟨n0, Ra, Rb, hR, hv'⟩ := hv'
  simp only [lnorm, Shp.sum.injEq, Ty.sum.injEq] at hR
  obtain ⟨rfl, rfl, rfl⟩ := hR
  have htl : (Ty.sum (lnorm ra) (lnorm rb)).tier = .boxed := by
    rw [← hS]; exact tier_lnorm (.sum ra rb)
  have hv3 := hv'.resolve_right (fun ⟨j, p, hd, _, _⟩ => by rw [htl] at hd; simp [decodeArm] at hd)
  obtain ⟨-, x1, s0, B, hx1, -, hB, hn1, -, -, hA, hB'⟩ := hv3
  rw [wc_boxed hS] at hn1
  have hs0 : s0 = 0 := by simp at hn1; omega
  subst hs0
  simp only [List.map_cons, List.map_nil, hw, List.cons.injEq, and_true] at hx1
  cases hx1
  rw [hB0, Option.some.injEq] at hB
  subst hB
  have la : (armsOf (lnorm ra)).length = (armsOf ra).length := by rw [armsOf_lnorm, List.length_map]
  simp only [Nat.sub_zero, Nat.zero_add, la, isBoxed_lnorm, shp_lnorm] at hA hB'
  -- the summands
  have hsg2 : Ty.sum (sig ra) (sig rb) = Ty.sum (sig (cl ρ η.wit 0 0 u)) (sig (cl ρ η.wit 0 0 v)) := hsg
  simp only [Ty.sum.injEq] at hsg2
  have hs := hl.2.1
  simp only [close, substTs, skel, etok, Ty.sum.injEq] at hs
  obtain ⟨hsa, hsb⟩ := hs
  obtain ⟨-, -, -, -, hly⟩ := hl
  simp only [close, substTs, lyt, etok, Ty.sum.injEq] at hly
  have layB : ∀ (ty : Ty) (t : Ty), isBoxed ty = true → etok (skel ty) = etok (skel (close th.σs t)) →
      etok (lyt 0 ty) = etok (lyt 0 (close th.σs t)) → ∀ pw, Lay th.σs t ty [pw] := by
    intro ty t hty hk hy pw
    refine ⟨fun us hu => ?_, hk, by rw [wc_isBoxed ty hty]; simp, Valid_boxed ty _ hty, hy⟩
    have h1 := wc_isBoxed ty hty
    simp only [wc, hu, Option.map_some, Option.some.injEq] at h1
    simp [h1]
  let s := stOf mem pairs th
  obtain ⟨hne, hpr⟩ := projM_own (g := g) (s := s) (t := .sum ra rb) hbi hsee0 hrb hw hx0 hB0 harm hus hnw.symm
  have hlen : ∀ p1 : List Word, WLe B0.pay p1 → p1.length = nWords us := fun p1 h => h.length.symm.trans hnw.symm
  by_cases hj : B0.tag < (armsOf ra).length
  · have hArm : ∀ s1 p1, MemInv g (CE η) s1 → MemHeldL (CE η) s1 H Sp →
        CrKeep (CE η) (CE η) (stOf mem pairs th) s1 → s1.nalloc = (stOf mem pairs th).nalloc → WLe B0.pay p1 →
        (TermViewInv.StV (stOf mem pairs th) → TermViewInv.EnvV (stOf mem pairs th).mem.size th.env →
          TermViewInv.WsV s1.mem.size p1 ∧ s1.vs.vRelSt ≤ s1.mem.size) →
        injM g s1 ra B0.tag p1 ≠ [] ∧ ∀ r2 ∈ injM g s1 ra B0.tag p1, ∃ Tot H',
          ThInvMK p g (CE η) (stOf mem pairs th) Sp r2.1.mem r2.1.pairs (withS { th with term := e₁, env := (x, ra, r2.2) :: th.env } r2.1) Tot H' ∧
          Tot + H' ≤ Rf + Rs + H := by
      intro s1 p1 hm1 hH1 hk1 hn1 hWp hpV
      cases hty : isBoxed ra with
      | false =>
          obtain ⟨q, hq, hsq, hwq, hvd, hvr⟩ := (hA hj).2 hty
          obtain ⟨q1, hq1, hs1, hw1, hv1, hvr1⟩ :=
            case_arm_nbR hE.2.1 hE.2.2 hty hsg2.1 hq hsq hwq hvd (by rw [shp_lnorm]; exact hvr) hWp
          exact case_armNBR hb1 he1 htv1 hi1 hle hE hm1 hH1 hk1 hty hq1 ⟨hs1, hsa, hw1, hv1, hly.1⟩ hvr1 hRP1
      | true =>
          have harmA : (armsOf ra)[B0.tag]? = some arm := by
            rw [← harm]; simp only [armsOf]; rw [List.getElem?_append_left hj]
          exact case_armBR (hbf := hbf) (s0 := 0) hb1 he1 htv1 hi1 hle hE hm1 hH1 hk1 hn1 hn hty (by rw [harmA]; exact hus)
            (hlen p1 hWp) hw hB0 hsto0 hini0 (by omega) hWp ((hA hj).1 hty) (layB ra u hty hsa hly.1) hpV hRP1
    simp only [PAx, tstep, hterm, hea] at hpx ⊢
    refine ⟨?_, fun r hr hpr0 => ?_⟩
    · rcases hpx with h0 | ⟨r, hr, -⟩
      rotate_left
      · exact List.ne_nil_of_mem hr
      obtain ⟨r1, h1, hp1⟩ := hne h0
      obtain ⟨htag, hWp, e1, e2, e3, e4, e5, e6, e7⟩ := (hpr r1 h1).2 hp1
      have hm1 := MemInv_load hm e1 e2 (LoadCoh_rd hm.2.1 hsto0 hB0 e3) e4 e5 e6 e7
      have hH1 := MemHeldL_eqs hH e1 e4
      have hk1 := CrKeep_eqs (E := CE η) (s := s) e1 e4
      obtain ⟨s1, j1, p1⟩ := r1
      simp only at htag hWp hm1 hH1 hk1
      subst htag
      intro hnil
      rw [List.flatMap_eq_nil_iff] at hnil
      have h2 := hnil _ h1
      simp only [hj, ite_true, List.map_eq_nil_iff] at h2
      exact (hArm s1 p1 hm1 hH1 hk1 e5 hWp (pV_of_proj h1 hea)).1 h2
    · rw [List.mem_flatMap] at hr
      obtain ⟨r1, h1, hr⟩ := hr
      have hp1 : PromAbove r1.1 := by
        obtain ⟨f1, f2⟩ := (hpr r1 h1).1
        have hpl1 : PromLt r1.1 := fun t ht => by rw [f1]; exact hm.2.2.1 t (by rw [← f2]; exact ht)
        have hpa' := hpr0
        try simp only at hr
        split at hr
        · obtain ⟨r2, hr2, rfl⟩ := List.mem_map.1 hr; exact injM_pa hpl1 hr2 hpa'
        · obtain ⟨r2, hr2, rfl⟩ := List.mem_map.1 hr; exact injM_pa hpl1 hr2 hpa'
      obtain ⟨htag, hWp, e1, e2, e3, e4, e5, e6, e7⟩ := (hpr r1 h1).2 hp1
      have hm1 := MemInv_load hm e1 e2 (LoadCoh_rd hm.2.1 hsto0 hB0 e3) e4 e5 e6 e7
      have hH1 := MemHeldL_eqs hH e1 e4
      have hk1 := CrKeep_eqs (E := CE η) (s := s) e1 e4
      obtain ⟨s1, j1, p1⟩ := r1
      simp only at htag hWp hm1 hH1 hk1
      subst htag
      simp only [hj, ite_true, List.mem_map] at hr
      obtain ⟨r2, hr2, rfl⟩ := hr
      exact (hArm s1 p1 hm1 hH1 hk1 e5 hWp (pV_of_proj h1 hea)).2 r2 hr2
  · have hj' : (armsOf ra).length ≤ B0.tag := by omega
    have hArm : ∀ s1 p1, MemInv g (CE η) s1 → MemHeldL (CE η) s1 H Sp →
        CrKeep (CE η) (CE η) (stOf mem pairs th) s1 → s1.nalloc = (stOf mem pairs th).nalloc → WLe B0.pay p1 →
        (TermViewInv.StV (stOf mem pairs th) → TermViewInv.EnvV (stOf mem pairs th).mem.size th.env →
          TermViewInv.WsV s1.mem.size p1 ∧ s1.vs.vRelSt ≤ s1.mem.size) →
        injM g s1 rb (B0.tag - (armsOf ra).length) p1 ≠ [] ∧
          ∀ r2 ∈ injM g s1 rb (B0.tag - (armsOf ra).length) p1, ∃ Tot H',
          ThInvMK p g (CE η) (stOf mem pairs th) Sp r2.1.mem r2.1.pairs (withS { th with term := e₂, env := (y, rb, r2.2) :: th.env } r2.1) Tot H' ∧
          Tot + H' ≤ Rf + Rs + H := by
      intro s1 p1 hm1 hH1 hk1 hn1 hWp hpV
      cases hty : isBoxed rb with
      | false =>
          obtain ⟨q, hq, hsq, hwq, hvd, hvr⟩ := (hB' hj').2 hty
          obtain ⟨q1, hq1, hs1, hw1, hv1, hvr1⟩ :=
            case_arm_nbR hE.2.1 hE.2.2 hty hsg2.2 hq hsq hwq hvd (by rw [shp_lnorm]; exact hvr) hWp
          exact case_armNBR hb2 he2 htv2 hi1 hle hE hm1 hH1 hk1 hty hq1 ⟨hs1, hsb, hw1, hv1, hly.2⟩ hvr1 hRP1
      | true =>
          have harmB : (armsOf rb)[B0.tag - (armsOf ra).length]? = some arm := by
            rw [← harm]; simp only [armsOf]; rw [List.getElem?_append_right hj']
          exact case_armBR (hbf := hbf) (s0 := (armsOf ra).length) hb2 he2 htv2 hi1 hle hE hm1 hH1 hk1 hn1 hn hty
            (by rw [harmB]; exact hus) (hlen p1 hWp)
            hw hB0 hsto0 hini0 (by omega) hWp ((hB' hj').1 hty) (layB rb v hty hsb hly.2) hpV hRP1
    simp only [PAx, tstep, hterm, hea] at hpx ⊢
    refine ⟨?_, fun r hr hpr0 => ?_⟩
    · rcases hpx with h0 | ⟨r, hr, -⟩
      rotate_left
      · exact List.ne_nil_of_mem hr
      obtain ⟨r1, h1, hp1⟩ := hne h0
      obtain ⟨htag, hWp, e1, e2, e3, e4, e5, e6, e7⟩ := (hpr r1 h1).2 hp1
      have hm1 := MemInv_load hm e1 e2 (LoadCoh_rd hm.2.1 hsto0 hB0 e3) e4 e5 e6 e7
      have hH1 := MemHeldL_eqs hH e1 e4
      have hk1 := CrKeep_eqs (E := CE η) (s := s) e1 e4
      obtain ⟨s1, j1, p1⟩ := r1
      simp only at htag hWp hm1 hH1 hk1
      subst htag
      intro hnil
      rw [List.flatMap_eq_nil_iff] at hnil
      have h2 := hnil _ h1
      simp only [hj, ite_false, List.map_eq_nil_iff] at h2
      exact (hArm s1 p1 hm1 hH1 hk1 e5 hWp (pV_of_proj h1 hea)).1 h2
    · rw [List.mem_flatMap] at hr
      obtain ⟨r1, h1, hr⟩ := hr
      have hp1 : PromAbove r1.1 := by
        obtain ⟨f1, f2⟩ := (hpr r1 h1).1
        have hpl1 : PromLt r1.1 := fun t ht => by rw [f1]; exact hm.2.2.1 t (by rw [← f2]; exact ht)
        have hpa' := hpr0
        try simp only at hr
        split at hr
        · obtain ⟨r2, hr2, rfl⟩ := List.mem_map.1 hr; exact injM_pa hpl1 hr2 hpa'
        · obtain ⟨r2, hr2, rfl⟩ := List.mem_map.1 hr; exact injM_pa hpl1 hr2 hpa'
      obtain ⟨htag, hWp, e1, e2, e3, e4, e5, e6, e7⟩ := (hpr r1 h1).2 hp1
      have hm1 := MemInv_load hm e1 e2 (LoadCoh_rd hm.2.1 hsto0 hB0 e3) e4 e5 e6 e7
      have hH1 := MemHeldL_eqs hH e1 e4
      have hk1 := CrKeep_eqs (E := CE η) (s := s) e1 e4
      obtain ⟨s1, j1, p1⟩ := r1
      simp only at htag hWp hm1 hH1 hk1
      subst htag
      simp only [hj, ite_false, List.mem_map] at hr
      obtain ⟨r2, hr2, rfl⟩ := hr
      exact (hArm s1 p1 hm1 hH1 hk1 e5 hWp (pV_of_proj h1 hea)).2 r2 hr2

/-- **(P4) `case`, every tier, with resources**: a boxed scrutinee hands its
resources to the summand bound; an unboxed one is P3's `tstep_caseR`. Memory's
holding is unchanged. -/
theorem tstepMR_caseT {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {cx : Cx}
    {ρ : Nat → Nat} {η : TEnv} {a : At} {x y : String} {e₁ e₂ : Expr} {Rf Rs H : Res}
    (hterm : th.term = .case a x e₁ y e₂) (hn : 0 < g.n)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hbf : g.boxFence = true)
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hpx : PAx g mem pairs th) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      ∃ Tot H', ThInvMK p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H := by
  have hT0 := hT
  have hCk0 := hCk
  rw [hterm] at hT0 hCk0
  cases hT0 with
  | case hu hb1 he1 hb2 he2 =>
    obtain ⟨u, v, c₁, c₂, c₃, hu, hb1, he1, hb2, he2⟩ : ∃ u v c₁ c₂ c₃,
        cx.use a = .ok (.sum u v, c₁) ∧ c₁.bind x u = .ok c₂ ∧ Typed p c₂ e₁ ∧
        c₁.bind y v = .ok c₃ ∧ Typed p c₃ e₂ := ⟨_, _, _, _, _, hu, hb1, he1, hb2, he2⟩
    obtain ⟨rt, ws, R, Rr, hea, hvV, hl, hv, hi1, hle⟩ := useR hu hi hE.2.2
    have hs := hl.2.1
    simp only [close, substTs, skel, etok] at hs
    obtain ⟨ra, rb, rfl, -, -⟩ := eskel_eq_sum hs
    by_cases hS : (Ty.sum ra rb).tier = .boxed
    · have htv12 := case_TvOK hu hb1 hb2 htv
      have ho : cx.opaqueOK _ = true :=
        peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
      have htb := (use_TvOK hu htv).2.1
      have hsg := lay_closed (ρ := ρ) hi.1.2.2.2.1 hi.1.2.2.2.2.1 ho htb hl
      exact tstepMR_caseB (hbf := hbf) hterm hn hb1 ⟨he1, (TermA4.CkW_case hCk0 hu hb1 hb2).1⟩ htv12.1 hb2 ⟨he2, (TermA4.CkW_case hCk0 hu hb1 hb2).2⟩ htv12.2 hi1 hle hea hvV hv hl hS hsg hE hm hH hpx (by rw [use_ret hu]; exact hRP)
    · have hnb : ∀ t' c₁', cx.use a = .ok (t', c₁') → (close th.σs t').tier ≠ .boxed := fun t' c₁' hu' => by
        rw [hu, Except.ok.injEq, Prod.mk.injEq] at hu'; obtain ⟨rfl, rfl⟩ := hu'
        rw [← tier_of_eskel hl.2.1]; exact hS
      refine paW <| liftMR hm hH (tstep_caseR hterm hnb hT hCk hi hE htv hRP hPS) ?_
      have hT' := hT
      rw [hterm] at hT'
      obtain ⟨ra', rb', ws', j, p', hea', hS', has, -, -⟩ := case_step hT' hi.1 hnb htv
      obtain ⟨hta, htb⟩ := tier_sum hS'
      intro r hr
      by_cases hj : j < (armsOf ra').length
      · simp only [tstep, hterm, hea', projM_nb hS', has, ol, Option.map_some, Option.toList_some,
          List.flatMap_cons, List.flatMap_nil, hj, ite_true, injM_nb hta, List.append_nil, List.mem_map,
          Option.mem_toList, Option.map_eq_some_iff] at hr
        obtain ⟨_, ⟨_, _, rfl⟩, rfl⟩ := hr
        exact ⟨rfl, rfl, rfl, rfl, rfl⟩
      · simp only [tstep, hterm, hea', projM_nb hS', has, ol, Option.map_some, Option.toList_some,
          List.flatMap_cons, List.flatMap_nil, hj, ite_false, injM_nb htb, List.append_nil, List.mem_map,
          Option.mem_toList, Option.map_eq_some_iff] at hr
        obtain ⟨_, ⟨_, _, rfl⟩, rfl⟩ := hr
        exact ⟨rfl, rfl, rfl, rfl, rfl⟩

/-! ### (P4) Components of a cell, with resources (names suffixed `S`) -/

theorem stOf_withS (s : St) (th : TTh) : stOf s.mem s.pairs (withS th s) = s := by
  cases s; rfl

section
variable {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}

/-- (D1) `region` publishes its cell's initialisation: every outcome's state is
the old one behind the release fence (`fenceS .st`), as after `publish`. -/
theorem fence_region {a : At} {rn pn tn : String} {e : Expr} (hterm : th.term = .region a rn pn tn e) :
    ∀ r ∈ tstep g mem pairs th, stOf r.1 r.2.1 r.2.2 = fenceS (stOf mem pairs th) .st := by
  intro r hr; simp only [tstep, hterm] at hr
  repeat' split at hr
  all_goals first
    | (simp only [List.mem_singleton] at hr; subst hr; exact stOf_withS _ _)
    | (simp at hr)

theorem same_openPub {a : At} {rn pn cn : String} {e : Expr} (hterm : th.term = .openPub a rn pn cn e) :
    ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) := by
  intro r hr; simp only [tstep, hterm] at hr; same_tac hr

variable {cx : Cx} {ρ : Nat → Nat} {η : TEnv}

theorem tstepM_region {a : At} {rn pn tn : String} {e : Expr}
    (hterm : th.term = .region a rn pn tn e) (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 :=
  ⟨(tstep_region hterm hT hi hE htv hRP hPS).1, fun r hr =>
    ⟨CE η, EFoot_refl, (tstep_region hterm hT hi hE htv hRP hPS).2 r hr, by
      rw [fence_region hterm r hr]; exact MemInv_fenceG _ hm⟩⟩

theorem tstepM_openPub {a : At} {rn pn cn : String} {e : Expr}
    (hterm : th.term = .openPub a rn pn cn e) (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 :=
  lift hm (tstep_openPub hterm hT hi hE htv hRP hPS) (same_openPub hterm)

end

/-- (T3c-5e) The ops T3c's thread lemmas cover (T3c-5h: all of `fold`).  Out: what is
left to T3d/T3e — tickets, capabilities (`borrow`, `freeze`, `endBorrow`),
region cells (a `rgn` pointer's `load`/`store`/`xchg`) and torn reads
(`validate`).  T3d-1 brought in `mkWord` (runtime and ghost), a protocol word's
`load` and `store` (Give, Keep, Hand; a ghost word's store touches no memory)
through an own or `pub` pointer or locative, and the protocol and epoch pairs: `mkWord2`, `mkEPair`, and
a pair's `ldp` and `stp` (Give, Keep) through an own or `pub` reference (S5: or locative).  Item 18 brought in
`fetch` through an own or `pub` pointer or locative (`tstepM_fetch`, `tstepM_fetchLoc`).  S7: `publish`
of a region-free cell type only (`PubScope`), until region cells are covered (R2). -/
def OpScope (cx : Cx) : Op → Prop
  | .validate _ | .borrow _ _ | .freeze _ | .endBorrow _ => False
  -- T3d-1: a pair's ldp (protocol or epoch pair) and stp (protocol pair)
  -- through a reference (own or pub); S5: or a locative
  | .ldp _ a _ _ => ∀ t, cx.peek a = .ok t → ∃ μ u, (t = .ptr μ u ∨ t = .loc μ u) ∧ (μ = .own ∨ μ = .pub) ∧
      ((∃ r P, u = .word2 r P) ∨ (∃ r P, u = .epair r P))
  | .stp _ a _ _ _ => ∀ t, cx.peek a = .ok t → ∃ μ r P,
      (t = .ptr μ (.word2 r P) ∨ t = .loc μ (.word2 r P)) ∧ (μ = .own ∨ μ = .pub)
  | .mkTicket _ _ _ _ _ | .claim _ _ => False                      -- ticket locks: T3d
  -- item 18: a fetch-op through a pointer or locative (own or pub)
  | .fetch _ _ _ a _ => ∀ t, cx.peek a = .ok t → ∃ μ u, (t = .ptr μ u ∨ t = .loc μ u) ∧ (μ = .own ∨ μ = .pub)
  -- T3d-1: a protocol word's load through a pointer or locative (own or pub)
  | .load _ a => ∀ t, cx.peek a = .ok t → ∀ r u, cellOf t ≠ some (.rgn r, u)
  -- T3d-1: a protocol word's store through a pointer or locative (Give, Keep,
  -- Hand; runtime or ghost)
  | .store _ a _ _ => ∀ t, cx.peek a = .ok t → ∀ r u, cellOf t ≠ some (.rgn r, u)
  | .xchg a _ => ∀ t, cx.peek a = .ok t → ∀ r u, cellOf t ≠ some (.rgn r, u)
  -- S7 (until R2): a published cell's type is region-free
  | .publish a => PubScope cx a
  -- D1 (until R2): `intoRgn` makes a region cell; region cells are out
  | .intoRgn _ _ => False
  -- S7 (until R2): `share` witnesses are region-free, checked where chosen
  -- (at the instantiation, so polymorphic bodies stay in scope)
  | .packT _ σ τ => PackTOK σ τ ∧ noIallV σ = true
  | .call _ _ _ ts => ∀ σ ∈ ts, rgnFree σ = true ∧ noIallV σ = true
  -- (StoNI) an allocated cell's type is `∀`-free at value positions
  | .new a => ∀ t c₁, cx.use a = .ok (t, c₁) → noIallV t = true
  | .newBuf _ τ => noIallV τ = true
  -- a spawn site has no thread step (`evalOp` gives `[]`; the spawn is a configuration step)
  | .spawn .. => False
  -- (E1) an external call likewise: `evalOp` gives `[]`; its step is `TermExtStep.Ext`
  | .ext .. => False
  | _ => True

/-- (T3c-5e) The terms T3c's thread lemmas cover.  T3d-2 stage 1 brought in
`region` (own pointer or buffer) and `openPub` (`tstepM_region`,
`tstepM_openPub`).  T3d-1 brought in a protocol word's `cas` (`casShare`, `casTake`,
`casEpoch`) through an own or `pub` pointer or locative (a ghost word has no
`cas`: `cas_ghost_absurd`), `casCell` on a `pub`
cell (through a pointer or locative; the typing rule makes it one word), and a pair's `casp` (`caspMove`, `caspTake`,
`caspBump`, `caspE`) through an own or `pub` reference (S5: or locative). -/
def StepScope (cx : Cx) : Expr → Prop
  | .let_ _ op _ => OpScope cx op
  -- T3d-1: a protocol word's cas (own or pub reference), or a cas on a pub
  -- cell that is not a protocol word
  | .cas _ _ w _ _ _ _ _ => ∀ t, cx.peek w = .ok t →
      (∃ μ r P, (t = .ptr μ (.word r P) ∨ t = .loc μ (.word r P)) ∧ (μ = .own ∨ μ = .pub)) ∨
      (∃ u, (t = .ptr .pub u ∨ t = .loc .pub u) ∧ wordOf t = none)
  -- T3d-1: a pair's casp (own or pub reference); S5: or a locative
  | .casp _ _ w _ _ _ _ _ _ _ => ∀ t, cx.peek w = .ok t → ∃ μ u, (t = .ptr μ u ∨ t = .loc μ u) ∧
      (μ = .own ∨ μ = .pub) ∧
      ((∃ r P, u = .word2 r P) ∨ (∃ r P, u = .epair r P))
  -- S7 (until R2): type arguments are region-free
  | .tail _ _ _ ts => ∀ σ ∈ ts, rgnFree σ = true ∧ noIallV σ = true
  | _ => True

/-- The term is a spawn site `let x = spawn ..`, or (E1) an external-call site
`let x = ext ..`: it has no thread step (its step is a configuration step). -/
def SpawnT : Expr → Prop
  | .let_ _ (.spawn ..) _ => True
  | .let_ _ (.ext ..) _ => True
  | _ => False

/-- A thread that takes a step is not at a spawn site. -/
theorem not_spawnT_of_mem {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {r : Memory × List Ts × TTh}
    (hr : r ∈ tstep g mem pairs th) : ¬ SpawnT th.term := by
  intro h
  generalize ht : th.term = t at h
  cases t with
  | let_ x op e =>
    cases op with
    | spawn f a T ts => simp [tstep, ht, evalOp] at hr
    | ext n a => simp [tstep, ht, evalOp] at hr
    | _ => exact h.elim
  | _ => exact h.elim

theorem cell_cases {t u : Ty} {μ : Mode} (h : cellOf t = some (μ, u)) : t = .ptr μ u ∨ t = .loc μ u := by
  cases t <;> simp [cellOf] at h <;> (obtain ⟨rfl, rfl⟩ := h) <;> simp

/-- (T3c-5e) **P1 + P4 at the thread, every in-scope term** (closes T3c-5 at the
thread level): a well-typed frame over an invariant memory, not finished, takes
a step, and every outcome is again a well-typed frame over an invariant memory.
Side condition: the scope (`StepScope`) only.  (T3c-7a removed `hnpF`: a store
to another thread's cell may fulfil the thread's promises.) -/
theorem tstepMF_step {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv}
    [ProgRetIall p] (hP : ProgT p) (hp : g.p = p) (hn : 0 < g.n) (hnd : isDone th = false)
    (hsc : StepScope cx th.term)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hbf : g.boxFence = true)
    (hpx : PAx g mem pairs th) (hwin : PubWinT (CE η) (stOf mem pairs th) th)
    (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hSub : PwSubS) (hSig : PwSig) (hZ : ZOK g (CE η) th := by exact fun _ _ h => False.elim h)
    (hPb : ∀ y a e rt ws ad, th.term = .let_ y (.publish a) e → evalAt th.env a = some (rt, ws) →
      ws.map (·.val) = [.loc ad 0] → g.pf ad.label := by exact fun _ _ _ _ _ _ _ _ _ => trivial) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  have hT0 := hT
  generalize ht : th.term = t0 at hT0 hsc
  cases hT0 with
  | let_ hop _ =>
    cases hop with
    | spawn => exact False.elim hsc
    | ext => exact False.elim hsc
    | atom | pair | addS | addI | subS | pack | rem | nameI | bits | bit1 | vmatch | band
    | cvt | toInt | asLanes | fop | fcmp | fop1 | lane | setLane =>
        exact paW <| tstepM_pure ht trivial hP hT hi hE htv hm hRP hPS
    | packT => exact paW <| tstepM_pure ht hsc hP hT hi hE htv hm hRP hPS
    | inl => exact tstepM_inlT (hbf := hbf) ht hP hn hT hi hE htv hm hpx hRP hPS
    | inr => exact tstepM_inrT (hbf := hbf) ht hP hn hT hi hE htv hm hpx hRP hPS
    | new => exact paW <| tstepM_new ht hsc hP hn hT hi hE htv hm hRP hPS
    | publish | publishBuf =>
        exact paW <| (tstepM_publish (hPb := hPb) ht hP hT hi hE htv hm hsc (fun rt ws ad => hwin _ _ _ rt ws ad ht) hRP hPS).imp
          id fun h r hr => (h r hr).toF
    | intoRgn | intoRgnBuf => exact False.elim hsc
    | newBuf => exact paW <| tstepM_newBuf ht hsc hP hn hT hi hE htv hm hRP hPS
    | idxOwn | idxShared => exact paW <| tstepM_idx ht hP hT hi hE htv hm hRP hPS
    | bufInit => exact tstepM_bufInit ht hP hT hi hE htv hm hZ hRP hPS
    | null => exact paW <| tstepM_null ht hP hT hi hE htv hm hRP hPS
    | fldOwn | fldShared => exact paW <| tstepM_fld ht hP hT hi hE htv hm hRP hPS
    | fence => exact paW <| tstepM_fence ht hP hT hi hE htv hm hRP hPS
    | zero => exact paW <| tstepM_zero ht hP hT hi hE htv hm hRP hPS
    | call => exact paW <| tstepM_call hp hP ht hT hi hE htv hm hsc hRP
    | fnptr => exact paW <| tstepM_fnptr hp hP ht hT hi hE htv hm hRP hPS
    | callc => exact paW <| tstepM_callc hp hP ht hT hi hE htv hm hRP hSig
    | xchgAt => exact tstepM_xchgAt ht hP hT hi hE htv hm hRP hPS
    | loadAt => exact tstepM_loadAt ht hP hT hi hE htv hm hRP hPS
    | xchgAtF => exact tstepM_xchgAtF ht hP hT hi hE htv hm hRP hPS
    | loadAtF => exact tstepM_loadAtF ht hP hT hi hE htv hm hRP hPS
    | ldlw => exact tstepM_ldlw ht hP hT hi hE htv hm hpx hRP hPS
    | ldl => exact tstepM_ldl ht hP hT hi hE htv hm hpx hRP hPS
    | stlw => exact tstepM_stlw ht hP hT hi hE htv hm hpx hRP hPS
    | stl => exact tstepM_stl ht hP hT hi hE htv hm hpx hRP hPS
    | fold => exact paW <| tstepM_fold ht hP hT hi hE htv hm hRP hPS
    | mkWord _ _ _ _ _ _ _ hng _ _ => exact paW <| tstepM_mkWord ht hP hT hi hE htv hm hng hRP hPS
    | mkWordGhost _ _ _ _ _ _ _ hg _ _ => exact paW <| tstepM_mkWordGhost ht hP hT hi hE htv hm hg hRP hPS
    | validate | borrow | freeze | endBorrow =>
        exact False.elim hsc
    | mkWord2 => exact paW <| tstepM_mkWord2 ht hP hT hi hE htv hm hRP hPS
    | mkEPair => exact paW <| tstepM_mkEPair ht hP hT hi hE htv hm hRP hPS
    | ldp hpk =>
        obtain ⟨μ, u, hteq | hteq, hμ, hu⟩ := hsc _ hpk
        · rw [hteq] at hpk
          rcases hμ with rfl | rfl
          · exact tstepM_ldpOwn ht hP hu hpk hT hi hE htv hm hRP hPS
          · exact tstepM_ldpPub ht hP hu hpk hT hi hE htv hm hRP hPS
        · rw [hteq] at hpk
          exact tstepM_ldpLoc ht hP hu hpk hμ hT hi hE htv hm hRP hPS
    | stpGive hpk | stpKeep hpk =>
        obtain ⟨μ, r, P, hteq | hteq, hμ⟩ := hsc _ hpk
        · rw [hteq] at hpk
          exact paW <| tstepM_stp ht hP hpk hμ hT hi hE htv hm hRP
        · rw [hteq] at hpk
          exact paW <| tstepM_stpLoc ht hP hpk hμ hT hi hE htv hm hRP
    | mkTicket | claim => exact False.elim hsc
    | fetchCell hpk | fetchEpoch hpk | fetchShare hpk =>
        obtain ⟨μ, u, hteq | hteq, hμ⟩ := hsc _ hpk
        · rw [hteq] at hpk
          exact tstepM_fetch ht hP hpk hμ hT hi hE htv hm hRP hPS
        · rw [hteq] at hpk
          exact tstepM_fetchLoc ht hP hpk hμ hT hi hE htv hm hRP hPS
    | loadWord hpk hw =>
        obtain ⟨μ, hteq | hteq⟩ := wordOf_cases hw <;> subst hteq
        · cases μ with
          | own => exact tstepM_loadWordOwn ht hP hpk hT hi hE htv hm hRP hPS
          | pub => exact tstepM_loadWordPub ht hP hpk hT hi hE htv hm hRP hPS
          | rgn r' => exact ((hsc _ hpk) r' _ rfl).elim
        · cases μ with
          | own => exact tstepM_loadWordLoc ht hP hpk (.inl rfl) hT hi hE htv hm hRP hPS
          | pub => exact tstepM_loadWordLoc ht hP hpk (.inr rfl) hT hi hE htv hm hRP hPS
          | rgn r' => exact ((hsc _ hpk) r' _ rfl).elim
    | storeWordGive hpk hw | storeWordKeep hpk hw | storeWordHand hpk hw =>
        obtain ⟨μ, hteq⟩ := wordOf_cases hw
        cases μ with
        | own => exact paW <| tstepM_storeWordAny ht hP hpk hteq (.inl rfl) hT hi hE htv hm hRP hPS
        | pub => exact paW <| tstepM_storeWordAny ht hP hpk hteq (.inr rfl) hT hi hE htv hm hRP hPS
        | rgn r' => rcases hteq with rfl | rfl <;> exact ((hsc _ hpk) r' _ rfl).elim
    | loadRgn hpk _ hc | loadCap hpk _ hc | loadTorn hpk _ hc => exact absurd hc (hsc _ hpk _ _)
    | storeRgn hpk _ hc | storeCap hpk _ hc => exact absurd hc (hsc _ hpk _ _)
    | loadOwn hpk hnw hc =>
        rcases cell_cases hc with rfl | rfl
        · exact tstepM_loadOwn ht hP hpk hnw hT hi hE htv hm hRP hPS
        · exact tstepM_loadLoc ht hP hpk hnw hT hi hE htv hm hRP hPS
    | loadPub hpk hnw hc =>
        rcases cell_cases hc with rfl | rfl
        · exact tstepM_loadPub ht hP hpk hnw hT hi hE htv hm hRP hPS
        · exact tstepM_loadPubLoc ht hP hpk hnw hT hi hE htv hm hRP hPS
    | storeOwn hpk hnw hc =>
        rcases cell_cases hc with rfl | rfl
        · exact paW <| tstepM_storeOwn ht hP hpk hnw hT hi hE htv hm hRP hPS
        · exact paW <| tstepM_storeLoc ht hP hpk hnw hT hi hE htv hm hRP hPS
    | storePub hpk hnw hc =>
        rcases cell_cases hc with rfl | rfl
        · exact paW <| tstepM_storePub ht hP hpk hnw hT hi hE htv hm hRP hPS
        · exact paW <| tstepM_storePubLoc ht hP hpk hnw hT hi hE htv hm hRP hPS
    | xchg hpk hx =>
        cases hx with
        | own _ hc =>
            rcases cell_cases hc with rfl | rfl
            · exact tstepM_xchgOwn ht hP hpk hT hi hE htv hm hRP hPS
            · exact tstepM_xchgLoc ht hP hpk hT hi hE htv hm hRP hPS
        | rgn _ hc => exact absurd hc (hsc _ hpk _ _)
  | split => exact paW <| tstepM_split ht hT hi hE htv hm hRP hPS
  | unpack => exact paW <| tstepM_unpack ht hT hi hE htv hm hRP hPS
  | unpackT => exact paW <| tstepM_unpackT ht hT hi hE htv hm hRP hPS
  | ifnull => exact paW <| tstepM_ifnull ht hT hi hE htv hm hRP hPS
  | parity => exact paW <| tstepM_parity ht hT hi hE htv hm hRP hPS
  | ifeqPlain | ifeq | ifeqRec | ifeqZero => exact paW <| tstepM_ifeq ht hT hi hE htv hm hRP hPS
  | case => exact tstepM_caseT (hbf := hbf) ht hn hT hi hE htv hm hpx hRP hPS
  | region | regionBuf => exact paW <| tstepM_region ht hT hi hE htv hm hRP hPS
  | openPub => exact paW <| tstepM_openPub ht hT hi hE htv hm hRP hPS
  | casCell hpk | casShare hpk | casTake hpk | casEpoch hpk =>
      rcases hsc _ hpk with ⟨μ, r, P, hteq, hμ⟩ | ⟨u, rfl | rfl, hnw⟩
      · cases hg : P.ghost
        · rcases hteq with rfl | rfl
          · exact tstepM_casWord ht hpk hμ hg hT hi hE htv hm hRP
          · exact tstepM_casWordLoc ht hpk hμ hg hT hi hE htv hm hRP
        · exact (cas_ghost_absurd (by rw [← ht]; exact hT) hpk hteq
            (wordRef_pwf hpk hteq hμ hi hE htv hm) hg).elim
      · exact tstepM_casCell ht hpk hnw hT hi hE htv hm hRP
      · exact tstepM_casCellLoc ht hpk hnw hT hi hE htv hm hRP
  | caspMove hpk | caspTake hpk | caspE hpk | caspBump hpk =>
      obtain ⟨μ, u, hteq | hteq, hμ, hu⟩ := hsc _ hpk
      · rw [hteq] at hpk
        exact tstepM_casp ht hpk hμ hu hT hi hE htv hm hRP
      · rw [hteq] at hpk
        exact tstepM_caspLoc ht hpk hμ hu hT hi hE htv hm hRP
  | ret =>
      have hst : th.stack ≠ [] := by
        intro h; simp [isDone, ht, h] at hnd
      exact paW <| tstepM_ret ht hst hT hi hE htv hm
  | tail => exact paW <| tstepM_tail hp hP ht hT hi hE htv hm hsc hRP hPS hSub


theorem tstepM_step {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv}
    [ProgRetIall p] (hP : ProgT p) (hp : g.p = p) (hn : 0 < g.n) (hnd : isDone th = false)
    (hsc : StepScope cx th.term)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hbf : g.boxFence = true)
    (hpx : PAx g mem pairs th) (hwin : PubWinT (CE η) (stOf mem pairs th) th) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hSub : PwSubS) (hSig : PwSig) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvM p g r.1 r.2.1 r.2.2 :=
  let h := tstepMF_step (g := gZ0 g) (hbf := hbf) hP hp hn hnd hsc hT hi hE htv hm hpx hwin hRP hPS hSub hSig
  ⟨h.1, fun r hr hpa => (h.2 r hr hpa).toM hbf⟩

/-- (HPA) `tstepM_step` in its all-results form (`PromAbove` of every result). -/
theorem tstepM_stepA {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv}
    [ProgRetIall p] (hP : ProgT p) (hp : g.p = p) (hn : 0 < g.n) (hnd : isDone th = false)
    (hsc : StepScope cx th.term)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hbf : g.boxFence = true)
    (hpa : ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2)) (hpx : PAx g mem pairs th)
    (hwin : PubWinT (CE η) (stOf mem pairs th) th) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hSub : PwSubS) (hSig : PwSig) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvM p g r.1 r.2.1 r.2.2 :=
  paA (tstepM_step hP hp hn hnd hsc hT hi hE htv hm hbf hpx hwin hRP hPS hSub hSig) hpa

/-- (option (3)) The capability terms `borrow`/`freeze`/`endBorrow`: frame-only steps that
`StepScopeR` admits and `StepScope` does not. -/
def CapT (t : Expr) : Prop :=
  ∃ x e, (∃ a b, t = .let_ x (.borrow a b) e) ∨ (∃ a, t = .let_ x (.freeze a) e) ∨
    (∃ a, t = .let_ x (.endBorrow a) e)

/-- (option (3)) The run scope.  `StepScope ∨ StepScopeR` differs from `StepScope` only at the
capability ops and at `mkTicket`/`claim`; `opOK` already rejects the latter, so this loses no
in-scope program. -/
def ScopeD (σs : List Ty) (cx : Cx) (t : Expr) : Prop :=
  StepScope cx t ∨ (StepScopeR σs cx t ∧ CapT t)

/-- `StepScope` gives `ScopeD`. -/
theorem ScopeD.of_step {σs : List Ty} {cx : Cx} {t : Expr} (h : StepScope cx t) : ScopeD σs cx t := .inl h

theorem capT_inv {t : Expr} (h : CapT t) : ∃ x op e, t = .let_ x op e ∧ CapOp op ∧
    (∀ a tk, op ≠ .claim a tk) := by
  obtain ⟨x, e, ⟨a, b, rfl⟩ | ⟨a, rfl⟩ | ⟨a, rfl⟩⟩ := h
  · exact ⟨x, .borrow a b, e, rfl, trivial, by intros; simp⟩
  · exact ⟨x, .freeze a, e, rfl, trivial, by intros; simp⟩
  · exact ⟨x, .endBorrow a, e, rfl, trivial, by intros; simp⟩

/-- (option (3)) `find?` through a filter. -/
theorem find?_filter_and {α : Type} (P q : α → Bool) :
    ∀ l : List α, (l.filter q).find? P = l.find? (fun a => P a && q a)
  | [] => rfl
  | a :: l => by
      have ih := find?_filter_and P q l
      cases hq : q a <;> cases hp : P a <;> simp [List.filter, List.find?, hq, hp, ih]

theorem find?_and_of {α : Type} (P q : α → Bool) :
    ∀ (l : List α) (e : α), l.find? P = some e → q e = true → l.find? (fun a => P a && q a) = some e
  | [], _, h, _ => by simp at h
  | a :: l, e, h, he => by
      cases hp : P a
      · simp only [List.find?, hp] at h
        simp only [List.find?, hp, Bool.false_and]
        exact find?_and_of P q l e h he
      · simp only [List.find?, hp, Option.some.injEq] at h
        subst h
        simp [List.find?, hp, he]

/-- With `firstOK`, a lookup in the filtered context finds the original entry (no `Nodup`). -/
theorem find_firstOK (l : List (String × Ty × Bool)) (x : String) (e : String × Ty × Bool)
    (h : (l.filter (Cx.firstOK l)).find? (·.1 == x) = some e) : l.find? (·.1 == x) = some e := by
  rw [find?_filter_and] at h
  have hs := List.find?_some h
  simp only [Bool.and_eq_true, beq_iff_eq] at hs
  obtain ⟨hx, hq⟩ := hs
  have hmem : e ∈ l := List.mem_of_find?_eq_some h
  obtain ⟨e0, h0⟩ : ∃ e0, l.find? (·.1 == x) = some e0 := by
    cases h' : l.find? (·.1 == x) with
    | some e0 => exact ⟨e0, rfl⟩
    | none => exact absurd (List.find?_eq_none.1 h' e hmem) (by simp [hx])
  have hx0 : e0.1 = x := by have := List.find?_some h0; simpa using this
  have hk0 : Cx.firstOK l e0 = true := by
    unfold Cx.firstOK at hq ⊢; rw [hx] at hq; rw [hx0, h0]; rw [h0] at hq; exact hq
  have := find?_and_of (fun a : String × Ty × Bool => a.1 == x) (Cx.firstOK l) l e0 h0 hk0
  rw [this] at h; cases h; exact h0

theorem VarsOK_firstOK {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {vars : List (String × Ty × Bool)} {env : Env}
    (h : VarsOK ρ η σs vars env) : VarsOK ρ η σs (vars.filter (Cx.firstOK vars)) env :=
  fun x e he => h x e (find_firstOK vars x e he)

/-- (option (3)) The plain capability step (`cap_presR` without resources). -/
theorem cap_pres {p : Prog} {cx c' : Cx} {x : String} {op : Op} {ρ : Nat → Nat} {η : TEnv} {σs : List Ty}
    {K : TEnv → List Word → Prop} {env : Env} {g : G} {s s' : St} {rt : Ty} {ws : List Word}
    (hT : OpT p cx x op c') (hA : CapOp op) (hncl : ∀ a tk, op ≠ .claim a tk)
    (hi : FInv ρ η σs K cx env) (hr : (s', rt, ws) ∈ evalOp g env σs s op) :
    FInv ρ η σs K c' ((x, rt, ws) :: env) := by
  cases hT <;> simp only [CapOp] at hA
  case borrow c₁ y c a t t' r hva hpk hlo hu hb =>
    simp only [evalOp, List.mem_singleton, Prod.mk.injEq] at hr
    obtain ⟨-, rfl, rfl⟩ := hr
    have hay : a = .var y := by cases a <;> simp [varOf, pure, Except.pure, throw, throwThe, MonadExceptOf.throw] at hva ⊢ <;> exact hva
    subst hay
    have htk : (∃ q st, t = .tok q st) ∨ (∃ q P i j, t = .tok2 q P i j) ∨ ∃ q, t = .share q := by
      cases t <;> simp [lendOf, throw, throwThe, MonadExceptOf.throw] at hlo <;> simp
    have haf : affine cx.ke t = true := by
      rcases htk with ⟨q, st, rfl⟩ | ⟨q, P, i, j, rfl⟩ | ⟨q, rfl⟩ <;> simp [affine, Ty.affineIn]
    obtain ⟨hp, hc⟩ := use_cases hu
    rw [hpk] at hp
    simp only [Except.ok.injEq] at hp
    subst hp
    rcases hc with ⟨hna, -⟩ | ⟨y', hy', rfl⟩
    · rw [haf] at hna; cases hna
    · simp only [At.var.injEq] at hy'
      subst hy'
      have hi1 := (use_FInv hu hi).1
      have hfr : FInv ρ η σs K { cx with vars := cx.vars.map (markU y), lent := y :: cx.lent } env :=
        ⟨hi1.1, hi1.2.1, hi1.2.2⟩
      exact bind_FInv hb hfr (by simp [VR]) (Lay_cap σs c r)
  case freeze c₁ a r hu hsr hb =>
    simp only [evalOp, List.mem_singleton, Prod.mk.injEq] at hr
    obtain ⟨-, rfl, rfl⟩ := hr
    exact bind_FInv hb (use_FInv hu hi).1 (by simp [VR]) (Lay_cap σs .frz r)
  case endBorrow y a hva hy hb =>
    simp only [evalOp, List.mem_singleton, Prod.mk.injEq] at hr
    obtain ⟨-, rfl, rfl⟩ := hr
    obtain ⟨F, hceq, hF⟩ := endCx_eq cx y
    rw [hceq] at hb
    have hv : VarsOK ρ η σs ((cx.vars.filter (Cx.firstOK cx.vars)).map F) env :=
      VarsOK_flags F (fun e => ⟨(hF e).1, (hF e).2.1⟩) (VarsOK_firstOK hi.2.1)
    have hfr : FInv ρ η σs K
          { cx with
          lent := cx.lent.erase y
          vars := (cx.vars.filter (Cx.firstOK cx.vars)).map F } env :=
      ⟨hi.1, hv, hi.2.2⟩
    exact bind_FInv hb hfr (by simp [VR]) (Lay_unitT σs)
  case claim => exact absurd rfl (hncl _ _)

/-- A capability op leaves the state unchanged. -/
theorem cap_state {g : G} {env : Env} {σs : List Ty} {s : St} {op : Op} (hA : CapOp op) :
    ∀ r ∈ evalOp g env σs s op, r.1 = s := by
  intro r hr
  cases op <;> simp only [CapOp] at hA <;> simp only [evalOp, List.mem_singleton] at hr <;> subst hr <;> rfl

/-- (option (3)) **The plain capability step at the thread**: it steps, every result is typed at
the same environment, and the state (memory, promises, views) is unchanged. -/
theorem tstep_cap {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} (hP : ProgT p) (hc : CapT th.term)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th,
      ThInvE p (CE η) r.2.2 ∧ Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) := by
  obtain ⟨x, op, e, hterm, hA, hncl⟩ := capT_inv hc
  have hsame := same_let (g := g) (mem := mem) (pairs := pairs) hterm
    (fun f is a ts h => by subst h; simp [CapOp] at hA) (fun f a h => by subst h; simp [CapOp] at hA)
    (fun r hr => same_of_eq (cap_state hA r hr))
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
      rename_i c₁
      have key := tstep_capOp (g := g) (mem := mem) (pairs := pairs) hterm hA
      refine ⟨?_, fun r hr => ⟨?_, hsame r hr⟩⟩
      · rw [key]; cases op <;> simp only [CapOp] at hA <;> simp [evalOp]
      · rw [key] at hr
        simp only [List.mem_map] at hr
        obtain ⟨⟨s', t, ws⟩, hm, rfl⟩ := hr
        exact ⟨ρ, η, c₁, rfl, hE, he, OpT_TvOK hP hop htv, cap_pres hop hA hncl hi hm, retPw_skel hPS hRP (skel_subst_eq (OpT_retSk hop) th.σs 0 0 0)⟩


/-- (T3c-5e) `ThInvM` with the step's side conditions at the same frame. -/
def ThInvS (p : Prog) (g : G) (mem : Memory) (pairs : List Ts) (th : TTh) : Prop :=
  ∃ ρ η cx, EnvOK p η ∧ Typed p cx th.term ∧ TvOK cx ∧ FInv ρ η th.σs (Resume p th.stack) cx th.env ∧
    MemInv g (CE η) (stOf mem pairs th) ∧ ScopeD th.σs cx th.term ∧ g.boxFence = true ∧
    PubWinT (CE η) (stOf mem pairs th) th ∧ RetPw th.σs th.stack cx.ret

/-- (S7b′) `PubWinT` at every typing of a thread's frame. -/
def PubWinS (p : Prog) (g : G) (mem : Memory) (pairs : List Ts) (th : TTh) : Prop :=
  ∀ ρ η cx, EnvOK p η → Typed p cx th.term → TvOK cx → FInv ρ η th.σs (Resume p th.stack) cx th.env →
    MemInv g (CE η) (stOf mem pairs th) → PubWinT (CE η) (stOf mem pairs th) th

theorem ThInvS_ThInvM {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    (h : ThInvS p g mem pairs th) : ThInvM p g mem pairs th :=
  let ⟨ρ, η, cx, hE, hT, htv, hi, hm, _, hbf, _, hrp⟩ := h
  ⟨CE η, ⟨ρ, η, cx, rfl, hE, hT, htv, hi, hrp⟩, hm, hbf⟩

/-- (T3c-5e) `tstepM_step`, packaged: a thread that is not finished and meets
the side conditions steps, into `ThInvM`. -/
theorem tstepS {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    [ProgRetIall p] (hP : ProgT p) (hp : g.p = p) (hn : 0 < g.n) (hnd : isDone th = false)
    (h : ThInvS p g mem pairs th)
    (hpx : PAx g mem pairs th) (hPS : PwSkel) (hSub : PwSubS) (hSig : PwSig) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvM p g r.1 r.2.1 r.2.2 := by
  obtain ⟨_, η, _, hE, hT, htv, hi, hm, hsc, hbf, hwin, hrp⟩ := h
  rcases hsc with hs | ⟨-, hc⟩
  · exact tstepM_step hP hp hn hnd hs hT hi hE htv hm hbf hpx hwin hrp hPS hSub hSig
  · have k := tstep_cap (g := g) (mem := mem) (pairs := pairs) hP hc hT hi hE htv hrp hPS
    exact ⟨k.1, fun r hr _ => ⟨CE η, (k.2 r hr).1, MemInv_same hm (k.2 r hr).2, hbf⟩⟩


/-- (HPA) `tstepS` in its all-results form (`PromAbove` of every result). -/
theorem tstepSA {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    [ProgRetIall p] (hP : ProgT p) (hp : g.p = p) (hn : 0 < g.n) (hnd : isDone th = false)
    (h : ThInvS p g mem pairs th)
    (hpa : ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2)) (hpx : PAx g mem pairs th) (hPS : PwSkel) (hSub : PwSubS) (hSig : PwSig) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvM p g r.1 r.2.1 r.2.2 :=
  paA (tstepS hP hp hn hnd h hpx hPS hSub hSig) hpa

/-- (HPA) A finished thread does not step. -/
theorem tstep_done {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} (h : isDone th = true) :
    tstep g mem pairs th = [] := by
  cases ht : th.term <;> cases hs : th.stack <;> simp [isDone, ht, hs] at h <;> simp [tstep, ht, hs]

/-- **(HPA) Per-step preservation for the taken result** (the restated
`tstepM_step`, the shape the typed run uses): a typed, in-scope thread over an
invariant memory; every result with `PromAbove` is again in `ThInvM`. -/
def StepPresW (p : Prog) : Prop :=
  ∀ (g : G) (mem : Memory) (pairs : List Ts) (th : TTh), g.p = p → 0 < g.n → ThInvS p g mem pairs th →
    ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvM p g r.1 r.2.1 r.2.2

/-- **(HPA) `StepPresW` of a well-typed program** (`tstepS`; a finished
thread has no result, and the result's `PromAbove` gives `PAx`). -/
theorem stepPresW_of {p : Prog} [ProgRetIall p] (hP : ProgT p) (hPS : PwSkel) (hSub : PwSubS) (hSig : PwSig) : StepPresW p := by
  intro g mem pairs th hp hn hS r hr hpa
  cases hnd : isDone th
  · exact (tstepS hP hp hn hnd hS (PAx_of_mem hr hpa) hPS hSub hSig).2 r hr hpa
  · rw [tstep_done hnd] at hr; cases hr
