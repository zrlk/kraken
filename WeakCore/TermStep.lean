  have hfr := bindR hb hi (RLink_of hE.2.1 hE.2.2) hvr (Lay_epair th.σs r P w0 w1)
  have hfr' : FInvR ρ η th.σs (ResumeR p th.stack Rs) c' ((x, .epair (.lit 0) P, [w0, w1]) :: th.env) Rf := by
