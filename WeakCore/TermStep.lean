      exact ⟨rt, ws, he, bindRZ hb hi hL (VRR_ofVR_loc hv (ownW_ne_own hne _)) hl⟩

/-- **P3 at the thread, `idx`.** -/
theorem tstep_idxR {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {b i : At} {e : Expr} {Rf Rs : Res}
    (hterm : th.term = .let_ x (.idx b i) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hpw : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvRE p (CE η) r.2.2 (Rf + Rs) := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
      rename_i c₁
      obtain ⟨c₁, -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
      obtain ⟨rt, ws, hev, hf⟩ := idx_stepR (g := g) (s := stOf mem pairs th) hop hi htv
        (RLink_of hE.2.1 hE.2.2) hE.2.2
      have key : tstep g mem pairs th = (evalOp g th.env th.σs (stOf mem pairs th) (.idx b i)).map
          fun (s', t, ws) => (s'.mem, s'.pairs, withS { th with term := e, env := (x, t, ws) :: th.env } s') := by
        simp [tstep, hterm]
      rw [key, hev]
      refine ⟨by simp, ?_⟩
      intro r hr
      simp only [List.map_cons, List.map_nil, List.mem_singleton] at hr
      subst hr
      exact ⟨ρ, η, c₁, Rf, Rs, rfl, hE, ⟨he, hck⟩, OpT_TvOK hP hop htv, hf, rfl, retPw_skel hPS hpw (skel_subst_eq (OpT_retSk hop) th.σs 0 0 0)⟩

/-! ### `zero`, resourceful: the zero value carries nothing

A port of `ZP`/`ZAP`/`zp`/`zap` (TermStep §12) with `VRR … .zero` for `VR`. -/

/-- The resourceful claim for one type. -/
def ZPR (u : Ty) : Prop :=
  ∀ (env : IEnv) (ke : KEnv), u.arrFree = true → KNone ke → zeroableIn env ke u = true →
    ∃ zs, zeroWords u = some zs ∧ wc u = some zs.length ∧
      ∀ ws : List Word, ws.map (·.val) = zs →
        Valid u ws ∧ ∀ (ρ : Nat → Nat) (η : TEnv), IAgree env ρ → VRR ρ η u (shp u) ws .zero

/-- The resourceful claim for a sum component. -/
def ZAPR (sel : Ty → Bool) (t : Ty) : Prop :=
  ∀ (env : IEnv) (ke : KEnv), t.arrFree = true → KNone ke → zeroArmP sel env ke t = some true →
    ∃ j arm p, (armsOf t).findIdx? sel = some j ∧ (armsOf t)[j]? = some arm ∧
      zeroWords arm = some p ∧ wc arm = some p.length ∧
      (∀ ws : List Word, ws.map (·.val) = p → Valid arm ws) ∧
      (t.tier ≠ .boxed → ∀ pw : List Word, pw.map (·.val) = p →
        ∃ q, ofArm t j pw = some q ∧ wc t = some q.length ∧ Valid t q ∧
          ∀ (ρ : Nat → Nat) (η : TEnv), IAgree env ρ → VRR ρ η t (shp t) q .zero)

theorem zap_leafR {sel : Ty → Bool} {t : Ty} (hA : armsOf t = [t]) (hs : sumHead t = false)
    (hz : ∀ env ke, zeroArmP sel env ke t = if sel t then some (zeroableIn env ke t) else none)
    (hZ : ZPR t) : ZAPR sel t := by
  intro env ke haf hk h
  rw [hz] at h
  split at h
  · rename_i hsel
    simp only [Option.some.injEq] at h
    obtain ⟨zs, hzw, hwc, hv⟩ := hZ env ke haf hk h
    refine ⟨0, t, zs, by simp [hA, hsel], by simp [hA], hzw, hwc, fun ws e => (hv ws e).1,
      fun _ pw e => ⟨pw, by simp [ofArm, hs], ?_, (hv pw e).1, fun ρ η ha => (hv pw e).2 ρ η ha⟩⟩
    rw [hwc, ← e, List.length_map]
  · simp at h

theorem zap_wrapR {sel : Ty → Bool} {t u : Ty} {env env' : IEnv}
    (hA : armsOf t = armsOf u) (hs : sumHead t = sumHead u) (ht : t.tier = u.tier) (hw : wc t = wc u)
    (hval : ∀ q, Valid u q → Valid t q)
    (hvr : ∀ q, (∀ (ρ : Nat → Nat) (η : TEnv), IAgree env' ρ → VRR ρ η u (shp u) q .zero) →
      ∀ (ρ : Nat → Nat) (η : TEnv), IAgree env ρ → VRR ρ η t (shp t) q .zero)
    (h : ∃ j arm p, (armsOf u).findIdx? sel = some j ∧ (armsOf u)[j]? = some arm ∧
      zeroWords arm = some p ∧ wc arm = some p.length ∧
      (∀ ws : List Word, ws.map (·.val) = p → Valid arm ws) ∧
      (u.tier ≠ .boxed → ∀ pw : List Word, pw.map (·.val) = p →
        ∃ q, ofArm u j pw = some q ∧ wc u = some q.length ∧ Valid u q ∧
          ∀ (ρ : Nat → Nat) (η : TEnv), IAgree env' ρ → VRR ρ η u (shp u) q .zero)) :
    ∃ j arm p, (armsOf t).findIdx? sel = some j ∧ (armsOf t)[j]? = some arm ∧
      zeroWords arm = some p ∧ wc arm = some p.length ∧
      (∀ ws : List Word, ws.map (·.val) = p → Valid arm ws) ∧
      (t.tier ≠ .boxed → ∀ pw : List Word, pw.map (·.val) = p →
        ∃ q, ofArm t j pw = some q ∧ wc t = some q.length ∧ Valid t q ∧
          ∀ (ρ : Nat → Nat) (η : TEnv), IAgree env ρ → VRR ρ η t (shp t) q .zero) := by
  obtain ⟨j, arm, p, hf, ha, hzw, hwc, hva, hinj⟩ := h
  have eo : ofArm t = ofArm u := (asArm_congr hs ht hA).2
  refine ⟨j, arm, p, hA ▸ hf, hA ▸ ha, hzw, hwc, hva, fun htb pw e => ?_⟩
  obtain ⟨q, hq, hwq, hvq, hrq⟩ := hinj (ht ▸ htb) pw e
  exact ⟨q, eo ▸ hq, hw ▸ hwq, hval q hvq, hvr q hrq⟩

theorem zapR : ∀ (t : Ty), (∀ u ∈ armsOf t, ZPR u) → ∀ sel, ZAPR sel t := by
  intro t
  induction t with
  | sum c d ihc ihd =>
      intro hIH sel env ke haf hk h
      have hIHc : ∀ u ∈ armsOf c, ZPR u := fun u hu => hIH u (by simp [armsOf, hu])
      have hIHd : ∀ u ∈ armsOf d, ZPR u := fun u hu => hIH u (by simp [armsOf, hu])
      simp only [Ty.arrFree, Bool.and_eq_true] at haf
      simp only [zeroArmP] at h
      cases hzc : zeroArmP sel env ke c with
      | some x =>
          cases x
          · simp [hzc] at h
          obtain ⟨j, arm, p, hf, harm, hzw, hwc, hva, hinj⟩ := ihc hIHc sel env ke haf.1 hk hzc
          have hj : j < (armsOf c).length := (List.getElem?_eq_some_iff.mp harm).1
          have harmS : (armsOf (.sum c d))[j]? = some arm := by
            simp only [armsOf]; rw [List.getElem?_append_left hj]; exact harm
          refine ⟨j, arm, p, by simp [armsOf, hf], harmS, hzw, hwc, hva, fun ht pw e => ?_⟩
          have hmem : arm ∈ armsOf (.sum c d) := List.mem_of_getElem? harmS
          obtain ⟨⟨k, hk', -⟩, -⟩ := arm_of_tier ht hmem
          have hpw : PayOK arm pw :=
            atom_payok (atom_of_mem _ _ hmem) (hva pw e) (shape_of_wc (by rw [hwc, ← e, List.length_map])) hk'
          obtain ⟨q, hq⟩ := encode_ok ht harmS hpw
          obtain ⟨p', hd, ep, hp', q', hq', eq'⟩ := enc_canon ht harmS hpw hq
          have e' : p'.map (·.val) = p := by rw [← e]; exact ep.symm
          obtain ⟨q0, hq0, hwc0, hv0, hvr0⟩ := hinj (tier_sum ht).1 p' e'
          refine ⟨q, by simp only [ofArm, sumHead, ite_true]; exact hq,
            wc_of_shape (wc_sum_ne _ _) (shape_sum hq),
            Or.inr ⟨j, p', arm, hd, harmS, hp', ⟨q', hq', eq'⟩,
              fun _ => ⟨q0, hq0, shape_of_wc hwc0, by rw [hwc0]; simp, hv0⟩,
              fun h => absurd h (by omega)⟩, fun ρ η ha => ?_⟩
          refine ⟨_, _, _, rfl, Or.inr ⟨j, p', ?_, fun _ => ⟨q0, ofArm_lnorm hq0, ?_⟩,
            fun h => absurd h (by have := ArmsLe.length (arms_lnorm c); omega)⟩⟩
          · have := decodeArm_mono (arms_lnorm (.sum c d)) hd
            rw [← tier_lnorm (.sum c d)] at this; exact this
          · rw [shp_lnorm]; exact hvr0 ρ η ha
      | none =>
          simp [hzc] at h
          obtain ⟨j, arm, p, hf, harm, hzw, hwc, hva, hinj⟩ := ihd hIHd sel env ke haf.2 hk h
          have hnc := zeroArmP_none sel c env ke hzc
          generalize hm : (armsOf c).length = m
          have harmS : (armsOf (.sum c d))[j + m]? = some arm := by
            simp only [armsOf]; rw [List.getElem?_append_right (by omega)]
            rw [hm, Nat.add_sub_cancel]; exact harm
          refine ⟨j + m, arm, p, by simp [armsOf, hnc, hf, hm], harmS, hzw, hwc, hva, fun ht pw e => ?_⟩
          have hmem : arm ∈ armsOf (.sum c d) := List.mem_of_getElem? harmS
          obtain ⟨⟨k, hk', -⟩, -⟩ := arm_of_tier ht hmem
          have hpw : PayOK arm pw :=
            atom_payok (atom_of_mem _ _ hmem) (hva pw e) (shape_of_wc (by rw [hwc, ← e, List.length_map])) hk'
          obtain ⟨q, hq⟩ := encode_ok ht harmS hpw
          obtain ⟨p', hd, ep, hp', q', hq', eq'⟩ := enc_canon ht harmS hpw hq
          have e' : p'.map (·.val) = p := by rw [← e]; exact ep.symm
          obtain ⟨q0, hq0, hwc0, hv0, hvr0⟩ := hinj (tier_sum ht).2 p' e'
          have hlen : (armsOf (lnorm c)).length = m := by rw [← ArmsLe.length (arms_lnorm _)]; exact hm
          refine ⟨q, by simp only [ofArm, sumHead, ite_true]; exact hq,
            wc_of_shape (wc_sum_ne _ _) (shape_sum hq),
            Or.inr ⟨j + m, p', arm, hd, harmS, hp', ⟨q', hq', eq'⟩,
              fun h => absurd h (by omega),
              fun _ => ⟨q0, by rw [hm, Nat.add_sub_cancel]; exact hq0, shape_of_wc hwc0, by rw [hwc0]; simp, hv0⟩⟩,
            fun ρ η ha => ?_⟩
          refine ⟨_, _, _, rfl, Or.inr ⟨j + m, p', ?_, fun h => absurd h (by omega),
            fun _ => ⟨q0, ?_, ?_⟩⟩⟩
          · have := decodeArm_mono (arms_lnorm (.sum c d)) hd
            rw [← tier_lnorm (.sum c d)] at this; exact this
          · rw [hlen, Nat.add_sub_cancel]; exact ofArm_lnorm hq0
          · rw [shp_lnorm]; exact hvr0 ρ η ha
  | void => intro _ sel env ke _ _ h; simp [zeroArmP] at h
  | refine u ψ ih =>
      intro hIH sel env ke haf hk h
      simp only [zeroArmP] at h
      cases hx : zeroArmP sel env ke u with
      | none => simp [hx] at h
      | some x =>
          simp only [hx, Option.map_some, Option.some.injEq, Bool.and_eq_true] at h
          obtain ⟨rfl, hzh⟩ := h
          exact zap_wrapR (t := .refine u ψ) (u := u) rfl rfl (tier_refine u ψ) (by simp [wc, accs]) (fun q hv => hv)
            (fun q hr ρ η ha => ⟨hr ρ η ha, IniR_of_zeroHolds ha _ q ψ hzh⟩)
            (ih (by simpa [armsOf] using hIH) sel env ke (by simpa [Ty.arrFree] using haf) hk hx)
  | iall u ih =>
      intro hIH sel env ke haf hk h
      simp only [zeroArmP] at h
      exact zap_wrapR (t := .iall u) (u := u) (env' := none :: env) rfl rfl (tier_iall u) (by simp [wc, accs])
        (fun q hv => hv)
        (fun q hr ρ η ha => by simp only [VRR]; exact fun n => hr _ η (ha.cons n))
        (ih (by simpa [armsOf] using hIH) sel _ ke (by simpa [Ty.arrFree] using haf) hk h)
  | iex u ih =>
      intro hIH sel env ke haf hk h
      simp only [zeroArmP] at h
      exact zap_wrapR (t := .iex u) (u := u) (env' := some 0 :: env) rfl rfl (tier_iex u) (wc_iex u) (fun q hv => hv)
        (fun q hr ρ η ha => ⟨_, _, 0, rfl, hr _ η ha.cons0⟩)
        (ih (by simpa [armsOf] using hIH) sel _ ke (by simpa [Ty.arrFree] using haf) hk h)
  | mu u ih =>
      intro hIH sel env ke haf hk h
      simp only [zeroArmP] at h
      exact zap_wrapR (t := .mu u) (u := u) (env' := env) rfl rfl (tier_mu u) (by simp [wc, accs]) (fun q hv => hv)
        (fun q hr ρ η ha => hr ρ _ ha)
        (ih (by simpa [armsOf] using hIH) sel env _ (by simpa [Ty.arrFree] using haf) hk.cons h)
  | tex κ u _ =>
      intro _ sel env ke _ _ h
      simp only [zeroArmP] at h
      cases hx : zeroArmP sel env (none :: ke) u <;> simp [hx] at h
  | _ =>
      intro hIH sel
      exact zap_leafR (by simp [armsOf]) (by simp [sumHead]) (fun env ke => by simp only [zeroArmP] <;> rfl)
        (hIH _ (by simp [armsOf]))

theorem zpR : ∀ (n : Nat) (T : Ty), sizeOf T < n → ZPR T := by
  intro n
  induction n with
  | zero => intro T h; omega
  | succ n ih =>
    intro T hT env ke haf hk hz
    cases T with
    | unit =>
        refine ⟨[], by simp [zeroWords], by simp [wc, accs, nWords], fun ws e => ⟨trivial, fun ρ η _ => ?_⟩⟩
        simp [VRR]
    | int =>
        refine ⟨[.num 0], by simp [zeroWords], by simp [wc, accs, nWords, Acc.size], fun ws e => ⟨trivial, fun ρ η _ => ?_⟩⟩
        simp only [VRR]; exact ⟨⟨0, e⟩, trivial⟩
    | intS i =>
        simp only [zeroableIn, beq_iff_eq] at hz
        refine ⟨[.num 0], by simp [zeroWords], by simp [wc, accs, nWords, Acc.size], fun ws e => ⟨trivial, fun ρ η ha => ?_⟩⟩
        simp only [VRR]; rw [ev_of_evalIn ha i 0 hz]; exact ⟨e, trivial⟩
    | fix sg w =>
        refine ⟨[.num 0], by simp [zeroWords], by simp [wc, accs, nWords, Acc.size], fun ws e => ⟨trivial, fun ρ η _ => ?_⟩⟩
        simp only [VRR, shp]; exact ⟨⟨trivial, 0, e, pw2_pos w⟩, trivial⟩
    | lanes sg w =>
        refine ⟨[.num 0], by simp [zeroWords], by simp [wc, accs, nWords, Acc.size], fun ws e => ⟨trivial, fun ρ η _ => ?_⟩⟩
        simp only [VRR, shp]; exact ⟨⟨trivial, 0, e⟩, trivial⟩
    | ptrOpt μ u =>
        refine ⟨[.null], by simp [zeroWords], by simp [wc, accs, nWords, Acc.size], fun ws e => ⟨Or.inl e, fun ρ η _ => ?_⟩⟩
        simp only [VRR]; exact ⟨Or.inl e, (ownW_null _ e).symm⟩
    | loc μ u =>
        cases u with
        | array i e0 =>
            simp only [zeroableIn, beq_iff_eq] at hz
            refine ⟨[.null], by simp [zeroWords], by simp [wc, accs, nWords, Acc.size], fun ws e => ⟨Or.inl e, fun ρ η ha => ?_⟩⟩
            simp only [VRR]
            refine ⟨Or.inl ⟨e, cl ρ η.wit 0 0 e0, ?_⟩, (ownW_null _ e).symm⟩
            rw [show cl ρ η.wit 0 0 (.array i e0) = .array (.lit 0) (cl ρ η.wit 0 0 e0) by
              simp [cl, clI_zero, ev_of_evalIn ha i 0 hz]]
            exact .refl
        | _ => simp [zeroableIn] at hz
    | prod a b =>
        simp only [zeroableIn, Bool.and_eq_true] at hz
        simp only [Ty.arrFree, Bool.and_eq_true] at haf
        have ha : sizeOf a < n := by simp at hT; omega
        have hb : sizeOf b < n := by simp at hT; omega
        obtain ⟨za, hza, hwa, hva⟩ := ih a ha env ke haf.1 hk hz.1
        obtain ⟨zb, hzb, hwb, hvb⟩ := ih b hb env ke haf.2 hk hz.2
        refine ⟨za ++ zb, by simp [zeroWords, hza, hzb], by simp [wc_prod, hwa, hwb], fun ws e => ?_⟩
        have e1 : (ws.take za.length).map (·.val) = za := by rw [List.map_take, e]; simp
        have e2 : (ws.drop za.length).map (·.val) = zb := by rw [List.map_drop, e]; simp
        have hl : za.length ≤ ws.length := by
          have := congrArg List.length e; simp at this; omega
        refine ⟨fun k hk' => ?_, fun ρ η hag => ?_⟩
        · rw [hwa, Option.some.injEq] at hk'; subst hk'
          exact ⟨(hva _ e1).1, (hvb _ e2).1⟩
        · simp only [VRR, shp]
          refine ⟨_, _, rfl, .zero, .zero, by simp, fun _ => trivial, fun k hk' => ?_⟩
          rw [shp_wc, hwa, Option.some.injEq] at hk'; subst hk'
          exact ⟨hl, (hva _ e1).2 ρ η hag, (hvb _ e2).2 ρ η hag⟩
    | refine u ψ =>
        simp only [zeroableIn, Bool.and_eq_true] at hz
        have hu : sizeOf u < n := by simp at hT; omega
        obtain ⟨z, hzw, hw, hv⟩ := ih u hu env ke (by simpa [Ty.arrFree] using haf) hk hz.1
        refine ⟨z, by simpa [zeroWords] using hzw, by simpa [wc, accs] using hw, fun ws e => ⟨(hv ws e).1, fun ρ η ha => ?_⟩⟩
        simp only [VRR, shp]
        exact ⟨(hv ws e).2 ρ η ha, IniR_of_zeroHolds ha _ ws ψ hz.2⟩
    | iall u =>
        simp only [zeroableIn] at hz
        have hu : sizeOf u < n := by simp at hT; omega
        obtain ⟨z, hzw, hw, hv⟩ := ih u hu _ ke (by simpa [Ty.arrFree] using haf) hk hz
        refine ⟨z, by simpa [zeroWords] using hzw, by simpa [wc, accs] using hw, fun ws e => ⟨(hv ws e).1, fun ρ η ha => ?_⟩⟩
        simp only [VRR, shp]
        exact fun m => (hv ws e).2 _ η (ha.cons m)
    | iex u =>
        simp only [zeroableIn] at hz
        have hu : sizeOf u < n := by simp at hT; omega
        obtain ⟨z, hzw, hw, hv⟩ := ih u hu _ ke (by simpa [Ty.arrFree] using haf) hk hz
        refine ⟨z, by simpa [zeroWords] using hzw, by rw [wc_iex]; exact hw, fun ws e => ⟨(hv ws e).1, fun ρ η ha => ?_⟩⟩
        simp only [VRR, shp]
        exact ⟨_, _, 0, rfl, (hv ws e).2 _ η ha.cons0⟩
    | mu u =>
        simp only [zeroableIn] at hz
        have hu : sizeOf u < n := by simp at hT; omega
        obtain ⟨z, hzw, hw, hv⟩ := ih u hu env _ (by simpa [Ty.arrFree] using haf) hk.cons hz
        refine ⟨z, by simpa [zeroWords] using hzw, by simpa [wc, accs] using hw, fun ws e => ⟨(hv ws e).1, fun ρ η ha => ?_⟩⟩
        simp only [VRR, shp]
        exact (hv ws e).2 ρ _ ha
    | sum a b =>
        have hIH : ∀ u ∈ armsOf (.sum a b), ZPR u := by
          intro u hu
          refine ih u ?_
          simp only [armsOf, List.mem_append] at hu
          rcases hu with hu | hu
          · have := armsOf_sizeOf a u hu; simp at hT; omega
          · have := armsOf_sizeOf b u hu; simp at hT; omega
        have key : ∀ sel : Ty → Bool, (Ty.sum a b).tier ≠ .boxed →
            zeroIdx (Ty.sum a b).tier (armsOf (.sum a b)) = (armsOf (.sum a b)).findIdx? sel →
            zeroArmP sel env ke (.sum a b) = some true →
            ∃ zs, zeroWords (.sum a b) = some zs ∧ wc (.sum a b) = some zs.length ∧
              ∀ ws : List Word, ws.map (·.val) = zs →
                Valid (.sum a b) ws ∧ ∀ (ρ : Nat → Nat) (η : TEnv), IAgree env ρ →
                  VRR ρ η (.sum a b) (shp (.sum a b)) ws .zero := by
          intro sel ht hzi h
          obtain ⟨j, arm, p, hf, harm, hzw, _, _, hinj⟩ := zapR _ hIH sel env ke haf hk h
          have e : (p.map cst).map (·.val) = p := map_val_cst p
          obtain ⟨q, hq, hwq, hvq, hrq⟩ := hinj ht _ e
          simp only [ofArm, sumHead, ite_true] at hq
          refine ⟨q.map (·.val), zeroWords_sum (hzi.trans hf) harm hzw hq, by simpa using hwq,
            fun ws e' => ⟨Valid_vals _ _ _ e'.symm hvq, fun ρ η ha => VRR_up _ _ _ _ _ (WLe_of_view0 e' (encodeArm_view0
              (fun w hw => by simp only [List.mem_map] at hw; obtain ⟨v, _, rfl⟩ := hw; rfl) hq)) (hrq ρ η ha)⟩⟩
        simp only [zeroableIn] at hz
        split at hz
        · rename_i hn
          refine key Ty.payloadFree (by rw [hn]; simp) (by rw [hn]; rfl) ?_
          simp only [zeroArmP]; simpa using hz
        · rename_i hw
          refine key (fun _ => true) (by rw [hw]; simp) ?_ ?_
          · rw [hw]
            cases hA : armsOf (Ty.sum a b) with
            | nil => rfl
            | cons x xs => simp [zeroIdx, List.findIdx?_cons]
          · simp only [zeroArmP]; simpa using hz
        · cases hz
    | tvar k => simp only [zeroableIn] at hz; rw [hk k] at hz; cases hz
    | array i u => simp [Ty.arrFree] at haf
    | _ => simp [zeroableIn] at hz

/-- **P3 at the thread, `zero`**: the zero value carries nothing (`zpR`, read
back along `VRR_close`). -/
theorem tstep_zeroR {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {τ : Ty} {e : Expr} {Rf Rs : Res}
    (hterm : th.term = .let_ x (.zero τ) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hpw : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvRE p (CE η) r.2.2 (Rf + Rs) := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hk := OpT_retSk hop
  cases hop with
  | zero hwf hsc hz hb =>
  have hC : ∀ k, Clo (η.wit k) := fun k => (hE.2.1 k).1
  have ho := bind_opaqueOK hb
  have haf := bind_arrFree hb
  have hr : ∀ k, τ.guardT k = false → k < th.σs.length := lt_of_guardT (tb_of_wf τ hwf) hi.1.2.2.2.2.1
  have hsig : sig (close th.σs τ) = sig (cl ρ η.wit 0 0 τ) := sig_WitL hi.1.2.2.2.1 ρ ho hr
  have hafT : (cl ρ η.wit 0 0 τ).arrFree = true := arrFree_cl hi.1.2.2.2.2.2.2.1.af τ 0 0 haf
  have hafR : (close th.σs τ).arrFree = true := by rw [← arrFree_sig, hsig, arrFree_sig]; exact hafT
  have hR := KindSound.zero_close cx.ke th.σs τ hi.1.2.2.2.2.2.1.2.1 hz
  obtain ⟨zs, hzs, -⟩ := zp _ _ (Nat.lt_succ_self _) [] [] hafR knone_nil hR
  have hZ := zrel_WitL hi.1.2.2.2.1 hC ρ ho hr
  have hTz := (zrel_zero _ _ [] [] hZ hsig knone_nil).1 hR
  have hwT := zrel_words _ _ _ [] zs (Nat.lt_succ_self _) hZ hsig hzs
  obtain ⟨zs', hzw', hwc, hv⟩ := zpR _ _ (Nat.lt_succ_self _) [] [] hafT knone_nil hTz
  obtain rfl : zs = zs' := Option.some.inj (hwT.symm.trans hzw')
  have key : tstep g mem pairs th =
      [((stOf mem pairs th).mem, (stOf mem pairs th).pairs,
        withS { th with term := e, env := (x, close th.σs τ, zs.map cst) :: th.env } (stOf mem pairs th))] := by
    simp only [tstep, hterm, evalOp, hzs]; rfl
  rw [key]
  refine ⟨by simp, fun r hr' => ?_⟩
  simp only [List.mem_singleton] at hr'
  subst hr'
  obtain ⟨hV0, hvr0⟩ := hv _ (map_val_cst zs)
  have hwcr : wc (close th.σs τ) = some zs.length := by rw [wc_of_sig hsig]; exact hwc
  have hvr : VRR ρ η τ (shp (close th.σs τ)) (zs.map cst) .zero := by
    rw [shp_of_sig hsig]
    exact (VRR_close hE.2.1 hE.2.2 ρ τ [] 0 ρ ρ (shp (cl ρ η.wit 0 0 τ)) _ .zero (fun k => rfl)
      (fun k hk => absurd hk (Nat.not_lt_zero _))).2 (hvr0 ρ (CE η) (agree_nil _))
  have hlay : Lay th.σs τ (close th.σs τ) (zs.map cst) := by
    refine ⟨fun us h => ?_, rfl, by simp [hwcr], Valid_of_sig hsig.symm hV0, rfl⟩
    simp [wc, h] at hwcr; simp; omega
  have hf := bindRZ hb hi (RLink_of hE.2.1 hE.2.2) hvr hlay
  exact ⟨ρ, η, c', Rf, Rs, rfl, hE, ⟨he, hck⟩, htv', by simpa [withS] using hf, rfl, retPw_skel hPS hpw (skel_subst_eq hk th.σs 0 0 0)⟩

/-! ### (P3 f) The resourceful thread step, every frame-only term -/

/-- (P3 f) The ops whose resourceful thread lemmas exist: the pure ones, the
non-boxed injections, calls, the capability ops, `mkTicket`, and (P3 g)
`fnptr`, `null`, `zero`, `fold`, `fence`, `fld`, `idx`.  Memory ops are P4;
`validate` is T3e. -/
def OpScopeR (σs : List Ty) (cx : Cx) : Op → Prop
  | .inl τ a => ∀ t c₁, cx.use a = .ok (t, c₁) → (close σs (.sum t τ)).tier ≠ .boxed
  | .inr τ a => ∀ t c₁, cx.use a = .ok (t, c₁) → (close σs (.sum τ t)).tier ≠ .boxed
  | .pack _ _ τ => PackOK τ
  | .atom _ | .add _ _ | .sub _ _ | .nameI _ | .rem _ _ | .pair _ _ => True
  | .bits _ _ _ | .bit1 _ _ | .vmatch _ _ _ | .band _ _ => True
  | .cvt _ _ _ | .toInt _ | .asLanes _ _ _ | .fop _ _ _ | .fcmp _ _ _ | .fop1 _ _ => True
  | .lane _ _ | .setLane _ _ _ => True
  -- S7 (until R2): `share` witnesses are region-free, checked where chosen
  | .packT _ σ τ => PackTOK σ τ ∧ noIallV σ = true
  | .call _ _ _ ts => ∀ σ ∈ ts, rgnFree σ = true ∧ noIallV σ = true
  | .callc _ _ | .mkTicket _ _ _ _ _ => True
  | .borrow _ _ | .freeze _ | .endBorrow _ | .claim _ _ => True
  | .fnptr _ | .null _ _ | .zero _ | .fold _ _ | .fence _ | .fld _ _ | .idx _ _ => True
  | _ => False

/-- (P3 f) The terms covered: every control term, `region` and `openPub`, a
non-boxed `case`, and the ops of `OpScopeR`; not `cas`/`casp` (P4). -/
def StepScopeR (σs : List Ty) (cx : Cx) : Expr → Prop
  | .let_ _ op _ => OpScopeR σs cx op
  | .case a _ _ _ _ => ∀ t c₁, cx.use a = .ok (t, c₁) → (close σs t).tier ≠ .boxed
  | .cas .. | .casp .. => False
  | .tail _ _ _ ts => ∀ σ ∈ ts, rgnFree σ = true ∧ noIallV σ = true
  | _ => True

/-- (P3 f) How a frame-only step may move the thread's bound: unchanged;
grown by the fresh region `region` names (D5's `F`); or `claim`'s exchange of
a ticket's epoch for the owner's region. -/
inductive TotStep (t : Expr) (η : TEnv) (Tot : Res) : Res → Prop
  | same : TotStep t η Tot Tot
  | fresh : TotStep t η Tot (Tot + (Res.one (.rg (ridNext η)) + Res.one (.wd (ridNext η))))
  /-- (claim export) only at a `claim` term. -/
  | claim {Tot' : Res} (n j : Nat) : (∃ x w tk e, t = .let_ x (.claim w tk) e) →
      Tot' + Res.one (.ep n j) ≤ Tot + Res.one (.rg n) → TotStep t η Tot Tot'

theorem tot_same {p : Prog} {E : TEnv} {η : TEnv} {t : Expr} {T : Res} {A : List (Memory × List Ts × TTh)}
    (h : A ≠ [] ∧ ∀ r ∈ A, ThInvRE p E r.2.2 T) :
    A ≠ [] ∧ ∀ r ∈ A, ∃ T', ThInvRE p E r.2.2 T' ∧ TotStep t η T T' :=
  ⟨h.1, fun r hr => ⟨T, h.2 r hr, .same⟩⟩

theorem tot_fresh {p : Prog} {E : TEnv} {η : TEnv} {t : Expr} {T : Res} {A : List (Memory × List Ts × TTh)}
    (h : A ≠ [] ∧ ∀ r ∈ A, ThInvRE p E r.2.2 (T + (Res.one (.rg (ridNext η)) + Res.one (.wd (ridNext η))))) :
    A ≠ [] ∧ ∀ r ∈ A, ∃ T', ThInvRE p E r.2.2 T' ∧ TotStep t η T T' :=
  ⟨h.1, fun r hr => ⟨_, h.2 r hr, .fresh⟩⟩

theorem tot_claim {p : Prog} {E : TEnv} {η : TEnv} {t : Expr} {T : Res} {A : List (Memory × List Ts × TTh)}
    (ht : ∃ x w tk e, t = .let_ x (.claim w tk) e)
    (h : A ≠ [] ∧ ∀ r ∈ A, ∃ n j T', ThInvRE p E r.2.2 T' ∧ T' + Res.one (.ep n j) ≤ T + Res.one (.rg n)) :
    A ≠ [] ∧ ∀ r ∈ A, ∃ T', ThInvRE p E r.2.2 T' ∧ TotStep t η T T' :=
  ⟨h.1, fun r hr => by
    obtain ⟨n, j, T', h1, h2⟩ := h.2 r hr
    exact ⟨T', h1, .claim n j ht h2⟩⟩

/-- **P3 at the thread, every frame-only term** (closes T3d-2 stage A's P3):
a well-typed resourceful frame, not finished and in scope, takes a step, and
every outcome is again a resourceful frame, its bound moved only as `TotStep`
allows. -/
theorem tstepR_step {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {Rf Rs : Res}
    [ProgRetIall p] (hP : ProgT p) (hp : g.p = p) (hnd : isDone th = false)
    (hsc : StepScopeR th.σs cx th.term)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) [TermA4.ProgCkWC p] (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hpw : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hSub : PwSubS)
    (hSig : PwSig) :
    tstep g mem pairs th ≠ [] ∧
      ∀ r ∈ tstep g mem pairs th, ∃ Tot', ThInvRE p (CE η) r.2.2 Tot' ∧ TotStep th.term η (Rf + Rs) Tot' := by
  have hT0 := hT
  generalize ht : th.term = t0 at hT0 hsc
  cases hT0 with
  | let_ hop _ =>
    cases hop
    all_goals first
      | exact False.elim hsc
      | exact tot_same (tstep_pureR ht trivial hP hT hCk hi hE htv hpw hPS)
      | exact tot_same (tstep_pureR ht hsc hP hT hCk hi hE htv hpw hPS)
      | exact tot_same (tstep_inlR ht hP hsc hT hCk hi hE htv hpw hPS)
      | exact tot_same (tstep_inrR ht hP hsc hT hCk hi hE htv hpw hPS)
      | exact tot_same (tstep_callR hp hP ht hT hCk hi hE htv KindSound.zero_close hsc hpw)
      | exact tot_same (tstep_callcR hp hP ht hT hCk hi hE htv hpw hSig)
      | exact tot_same (tstep_mkTicketR ht hP hT hCk hi hE htv hpw hPS)
      | exact tot_claim ⟨_, _, _, _, by first | rfl | exact ht⟩ (tstep_claimR ht hP hT hCk hi hE htv hpw hPS)
      | exact tot_same (tstep_capR ht trivial (fun _ _ h => by cases h) hP hT hCk hi hE htv hpw hPS)
      | exact tot_same (tstep_fnptrR hp hP ht hT hCk hi hE htv hpw hPS)
      | exact tot_same (tstep_fenceR ht hP hT hCk hi hE htv hpw hPS)
      | exact tot_same (tstep_nullR ht hP hT hCk hi hE htv hpw hPS)
      | exact tot_same (tstep_zeroR ht hP hT hCk hi hE htv hpw hPS)
      | exact tot_same (tstep_foldR ht hP hT hCk hi hE htv hpw hPS)
      | exact tot_same (tstep_fldR ht hP hT hCk hi hE htv hpw hPS)
      | exact tot_same (tstep_idxR ht hP hT hCk hi hE htv hpw hPS)
  | split => exact tot_same (tstep_splitR ht hT hCk hi hE htv hpw hPS)
  | unpack => exact tot_same (tstep_unpackR ht hT hCk hi hE htv hpw hPS)
  | unpackT => exact tot_same (tstep_unpackTR ht hT hCk hi hE htv hpw hPS)
  | ifnull => exact tot_same (tstep_ifnullR ht hT hCk hi hE htv hpw hPS)
  | parity => exact tot_same (tstep_parityR ht hT hCk hi hE htv hpw hPS)
  | ifeqPlain | ifeq | ifeqRec | ifeqZero => exact tot_same (tstep_ifeqR ht hT hCk hi hE htv hpw hPS)
  | case => exact tot_same (tstep_caseR ht hsc hT hCk hi hE htv hpw hPS)
  | region | regionBuf => exact tot_fresh (tstep_regionR ht hT hCk hi hE htv hpw hPS)
  | openPub => exact tot_same (tstep_openPubR ht hT hCk hi hE htv hpw hPS)
  | casCell | casShare | casTake | casEpoch => exact False.elim hsc
  | caspMove | caspTake | caspE | caspBump => exact False.elim hsc
  | ret =>
      have hst : th.stack ≠ [] := by
        intro h; simp [isDone, ht, h] at hnd
      exact tot_same (tstep_retR ht hst hT hi hE htv)
  | tail => exact tot_same (tstep_tailR hp hP ht hT hCk hi hE htv KindSound.zero_close hsc hpw hPS hSub)

/-! ### (P4 step 1) Memory holdings

What memory holds: the resources of the value cells'
latest words that are not the thread's outstanding promises, by `VRR`
(`ValOfR`, `CellOKR`, `BufOKR`), summed over Σ's labels (`MemHeld`); and what
a step may create (`MintStep`). -/

/-- (P4) A memory value with its resources: `ValOf` with `VRR` for `VR`. -/
def ValOfR (η : TEnv) (T : Ty) (ws : List Word) (R : Res) : Prop :=
  VRR (fun _ => 0) (CE η.unsee) T (shp T) ws R ∧ Valid T ws

theorem ValOfR.valOf {η : TEnv} {T : Ty} {ws : List Word} {R : Res} (h : ValOfR η T ws R) :
    ValOf η T ws :=
  ⟨VRR_VR T (RLink_of (Coh_CE _) (CohR_CE _)) h.1, h.2⟩

/-- (P4) A buffer's words with their resources: slot `j` below `n` is a value
holding `Rs[j]`, and the buffer holds their sum. -/
def BufOKR (η : TEnv) (n nr : Nat) (T : Ty) (vals : List Word) (R : Res) : Prop :=
  ∃ N e us Rs, T = .array (.lit N) e ∧ accs e = some us ∧ n ≤ N ∧ vals.length = N * nWords us ∧
    Rs.length = n ∧ R = Res.sum Rs ∧
    ∀ j Rj, j < n → Rs[j]? = some Rj →
      (nr ≤ j → nWords us = 0 → Rj = .zero) ∧
      (j < nr ∨ 0 < nWords us → ValOfR η e ((vals.drop (j * nWords us)).take (nWords us)) Rj)

theorem BufOKR.bufOK {η : TEnv} {n nr : Nat} {T : Ty} {vals : List Word} {R : Res} (hnr : n ≤ nr)
    (h : BufOKR η n nr T vals R) : BufOK η n T vals := by
  obtain ⟨N, e, us, Rs, hT, hu, hn, hl, hRs, -, hj⟩ := h
  refine ⟨N, e, us, hT, hu, hn, hl, fun j hjn => ?_⟩
  have hlt : j < Rs.length := by omega
  exact ((hj j Rs[j] hjn (List.getElem?_eq_getElem hlt)).2 (.inl (by omega))).valOf
#print axioms BufOKR.bufOK

/-- (H) A slot clause of `BufOKR` under a map of its value part. -/
theorem slotR_imp {nr nr' j nw : Nat} {Rj : Res} {B B' : Prop}
    (h : (nr ≤ j → nw = 0 → Rj = .zero) ∧ (j < nr ∨ 0 < nw → B)) (hnr : nr' = nr) (f : B → B') :
    (nr' ≤ j → nw = 0 → Rj = .zero) ∧ (j < nr' ∨ 0 < nw → B') := by
  subst hnr; exact ⟨h.1, fun h' => f (h.2 h')⟩
#print axioms slotR_imp

/-- (H) A slot clause survives raising the real count past an initialised slot `j ≤ nr`. -/
theorem slotR_raise {nr j j' nw : Nat} {Rj : Res} {B : Prop}
    (h : (nr ≤ j' → nw = 0 → Rj = .zero) ∧ (j' < nr ∨ 0 < nw → B)) (hjr : j ≤ nr) (hne : j' ≠ j) :
    (max nr (j + 1) ≤ j' → nw = 0 → Rj = .zero) ∧ (j' < max nr (j + 1) ∨ 0 < nw → B) := by
  rcases Nat.le_total nr (j + 1) with hm | hm
  · rw [Nat.max_eq_right hm]
    exact ⟨fun h1 h2 => h.1 (by omega) h2, fun h1 => h.2 (by omega)⟩
  · rw [Nat.max_eq_left hm]; exact h
#print axioms slotR_raise

/-- (H) With every slot real (`n ≤ nr`), `BufOKR` is a value per slot. -/
theorem BufOKR.full {η : TEnv} {n nr : Nat} {T : Ty} {vals : List Word} {R : Res} (hn : n ≤ nr) :
    BufOKR η n nr T vals R ↔ ∃ N e us Rs, T = .array (.lit N) e ∧ accs e = some us ∧ n ≤ N ∧
      vals.length = N * nWords us ∧ Rs.length = n ∧ R = Res.sum Rs ∧
      ∀ j Rj, j < n → Rs[j]? = some Rj → ValOfR η e ((vals.drop (j * nWords us)).take (nWords us)) Rj := by
  constructor
  · rintro ⟨N, e, us, Rs, h1, h2, h3, h4, h5, h6, h7⟩
    exact ⟨N, e, us, Rs, h1, h2, h3, h4, h5, h6, fun j Rj hj hR => (h7 j Rj hj hR).2 (.inl (by omega))⟩
  · rintro ⟨N, e, us, Rs, h1, h2, h3, h4, h5, h6, h7⟩
    exact ⟨N, e, us, Rs, h1, h2, h3, h4, h5, h6, fun j Rj hj hR =>
      ⟨fun h _ => absurd h (by omega), fun _ => h7 j Rj hj hR⟩⟩
#print axioms BufOKR.full

/-- (P4) A cell's words with their resources: `CellOK` with `VRR`. -/
def CellOKR (η : TEnv) (n nr : Nat) (T : Ty) (vals : List Word) (R : Res) : Prop :=
  (wc T = some vals.length ∧ ValOfR η T vals R) ∨ BufOKR η n nr T vals R

theorem CellOKR.cellOK {η : TEnv} {n nr : Nat} {T : Ty} {vals : List Word} {R : Res}
    (hnr : n ≤ nr) (h : CellOKR η n nr T vals R) : CellOK η n T vals := by
  rcases h with ⟨h1, h2⟩ | h
  · exact Or.inl ⟨h1, h2.valOf⟩
  · exact Or.inr (h.bufOK hnr)

/-- (P4) `w` is the word of the latest message to `a` that is not one of the
promises `P`: every later message to `a` is one. -/
def LatestNP (mem : Memory) (P : List Ts) (a : Address) (w : Word) : Prop :=
  ∃ (t : Ts) (m : Msg), t ∉ P ∧ mem[t]? = some m ∧ m.loc = a ∧ mw m = w ∧
    ∀ (t' : Ts) (m' : Msg), t < t' → mem[t']? = some m' → m'.loc = a → t' ∈ P

/-- (P4) There is at most one such word. -/
theorem LatestNP_uniq {mem : Memory} {P : List Ts} {a : Address} {w w' : Word}
    (h : LatestNP mem P a w) (h' : LatestNP mem P a w') : w = w' := by
  obtain ⟨t, m, ht, hm, hl, rfl, hlast⟩ := h
  obtain ⟨t', m', ht', hm', hl', rfl, hlast'⟩ := h'
  rcases Nat.lt_trichotomy t t' with hlt | rfl | hlt
  · exact absurd (hlast t' m' hlt hm' hl') ht'
  · rw [hm] at hm'; cases hm'; rfl
  · exact absurd (hlast' t m hlt hm hl) ht

/-- (P4) Address `a` is a word of a non-ghost protocol word, or of a protocol pair, in its cell
(a ghost word is zero-width and shares its offset with the next component). -/
def WordUnit (E : TEnv) (a : Address) : Prop :=
  ∃ c, E.sto a.label = some c ∧ ((∃ r P, P.ghost = false ∧ AtOff c.ty a.offset (.word r P)) ∨
    (∃ r P, AtOff c.ty a.offset (.word2 r P)) ∨ (∃ r P, 1 ≤ a.offset ∧ AtOff c.ty (a.offset - 1) (.word2 r P)))

/-- (S4f) Label `l` is one of the thread's own cells. -/
def OwnL (E : TEnv) (l : AllocLabel) : Prop := ∃ c, E.sto l = some c ∧ c.owner = some E.tid

/-- (S7c) Label `l` is one of the thread's **private**
cells: its own, without a frontier (neither published nor planted). -/
def Priv (E : TEnv) (l : AllocLabel) : Prop := OwnL E l ∧ E.pfr l = none

/-- (S4f, S7c) **Memory's reading sees the thread's own promises at label
`l`**: `l` is not a private cell.  Private cells are read as their owner reads
them (`OwnOKP`, own promises skipped); their promises carry no credit.  (S7c,
A′: the S4 `Pending` disjunct is the frontier: an own cell becomes visible
when it gets one, at `publish` or at a plant, `MemHeld_flip`.) -/
def Vis (E : TEnv) (l : AllocLabel) : Prop := ¬ Priv E l

/-- (S4f) A word unit at a visible label: memory reads it promises included. -/
def VisU (E : TEnv) (a : Address) : Prop := WordUnit E a ∧ Vis E a.label

theorem OwnL_of {E : TEnv} {l : AllocLabel} {c : Cell} (h : E.sto l = some c) (ho : c.owner = some E.tid) :
    OwnL E l := ⟨c, h, ho⟩

theorem Vis_of {E : TEnv} {l : AllocLabel} {c : Cell} (h : E.sto l = some c) (ho : c.owner ≠ some E.tid) :
    Vis E l := fun ⟨⟨c', h', ho'⟩, _⟩ => by rw [h] at h'; cases h'; exact ho ho'

theorem Vis_none {E : TEnv} {l : AllocLabel} (h : E.sto l = none) : Vis E l :=
  fun ⟨⟨c', h', _⟩, _⟩ => by rw [h] at h'; cases h'

/-- (S7c) A cell with a frontier is visible. -/
theorem Vis_pfr {E : TEnv} {l : AllocLabel} {f : Ts} (h : E.pfr l = some f) : Vis E l :=
  fun ⟨_, h'⟩ => by rw [h] at h'; cases h'

theorem Priv_of {E : TEnv} {l : AllocLabel} {c : Cell} (h : E.sto l = some c) (ho : c.owner = some E.tid)
    (hp : E.pfr l = none) : Priv E l := ⟨⟨c, h, ho⟩, hp⟩

theorem Vis_congr {E E' : TEnv} {l : AllocLabel} (hs : E'.sto l = E.sto l) (ht : E'.tid = E.tid)
    (hp : E'.pfr l = E.pfr l := by first | rfl | assumption) :
    Vis E' l ↔ Vis E l := by
  unfold Vis Priv OwnL; rw [hs, ht, hp]

theorem VisU_own {E : TEnv} {a : Address} (h : Priv E a.label) : ¬ VisU E a := fun hv => hv.2 h

open Classical in
/-- The foreign promises memory's reading
skips at `a` off the visible word units: the other threads' (`E.fp`) at a
visible (shared) cell, none at a private one. -/
noncomputable def FpAt (E : TEnv) (a : Address) : List Ts := if Vis E a.label then E.fp else []

/-- (U3) A *predicted* unit: in a visible buffer, below the
reader-visible count `ini` but not the real one `rc` (a planted cell's
predicted slots). -/
def PredU (E : TEnv) (a : Address) : Prop := E.pfr a.label ≠ none ∧ IniW E a ∧ ¬ IniWr E a

/-- (U3) A predicted unit is visible (it has a frontier). -/
theorem PredU_vis {E : TEnv} {a : Address} (h : PredU E a) : Vis E a.label := fun hp => h.1 hp.2

/-- (U3) `h` is the first write at `a`: the lowest message there that is not
the allocation placeholder `.undef`. -/
def FirstW (mem : Memory) (a : Address) (h : Ts) : Prop :=
  (∃ m, mem[h]? = some m ∧ m.loc = a ∧ m.val ≠ .undef) ∧
    ∀ t m, t < h → mem[t]? = some m → m.loc = a → m.val = .undef

/-- (U3) `t` lies above the first write at `a`. -/
def AboveFW (mem : Memory) (a : Address) (t : Ts) : Prop := ∃ h, FirstW mem a h ∧ h < t

open Classical in
/-- (P4, S4f, S7i) The promises `MemHeld` skips at `a`: none at a visible word
unit; elsewhere the thread's own, and (S7i) at a shared cell also the other
threads' (`FpAt`), so that every thread reads a shared cell's non-word units
as the global reading does (`MemHeldG`). -/
noncomputable def PromAt (E : TEnv) (s : St) (a : Address) : List Ts :=
  if VisU E a then [] else if PredU E a then (s.promises ++ FpAt E a).filter (fun t => decide (AboveFW s.mem a t))
  else s.promises ++ FpAt E a

theorem PromAt_word {E : TEnv} {s : St} {a : Address} (h : VisU E a) : PromAt E s a = [] := by
  simp only [PromAt, h, ↓reduceIte]

theorem PromAt_nword {E : TEnv} {s : St} {a : Address} (h : ¬VisU E a) (hq : ¬PredU E a) :
    PromAt E s a = s.promises ++ FpAt E a := by
  simp only [PromAt, h, hq, ↓reduceIte]

open Classical in
/-- (U3) At a predicted unit: the promises above the first write. -/
theorem PromAt_pred {E : TEnv} {s : St} {a : Address} (h : ¬VisU E a) (hq : PredU E a) :
    PromAt E s a = (s.promises ++ FpAt E a).filter (fun t => decide (AboveFW s.mem a t)) := by
  simp only [PromAt, h, hq, ↓reduceIte]

open Classical in
/-- (U3) Membership at a predicted unit. -/
theorem mem_PromAt_pred {E : TEnv} {s : St} {a : Address} {t : Ts} (h : ¬VisU E a) (hq : PredU E a) :
    t ∈ PromAt E s a ↔ t ∈ s.promises ++ FpAt E a ∧ AboveFW s.mem a t := by
  rw [PromAt_pred h hq, List.mem_filter, decide_eq_true_eq]

theorem PredU_own {E : TEnv} {a : Address} (h : Priv E a.label) : ¬ PredU E a := fun hq => hq.1 h.2

theorem FpAt_priv {E : TEnv} {a : Address} (h : ¬ Vis E a.label) : FpAt E a = [] := by
  simp only [FpAt, h, ↓reduceIte]

theorem FpAt_vis {E : TEnv} {a : Address} (h : Vis E a.label) : FpAt E a = E.fp := by
  simp only [FpAt, h, ↓reduceIte]

theorem FpAt_sub {E : TEnv} {a : Address} {t : Ts} (h : t ∈ FpAt E a) : t ∈ E.fp := by
  by_cases hv : Vis E a.label
  · rwa [FpAt_vis hv] at h
  · rw [FpAt_priv hv] at h; cases h

/-- (S7i) With no foreign promise, the reading skips the own promises only. -/
theorem FpAt_nil {E : TEnv} {a : Address} (h : E.fp = []) : FpAt E a = [] := by
  unfold FpAt; split <;> simp [h]

theorem PromAt_own {E : TEnv} {s : St} {a : Address} (h : Priv E a.label) : PromAt E s a = s.promises := by
  rw [PromAt_nword (VisU_own h) (PredU_own h), FpAt_priv (fun hv => hv h), List.append_nil]

/-- (S7i) Off the visible word units of a private cell, or with no foreign
promise: the own promises. -/
theorem PromAt_nwordP {E : TEnv} {s : St} {a : Address} (h : ¬VisU E a) (hq : ¬PredU E a) (hf : FpAt E a = []) :
    PromAt E s a = s.promises := by
  rw [PromAt_nword h hq, hf, List.append_nil]

theorem PromAt_sub {E : TEnv} {s : St} {a : Address} {t : Ts} (h : t ∈ PromAt E s a) :
    t ∈ s.promises ∨ t ∈ E.fp := by
  by_cases hw : VisU E a
  · rw [PromAt_word hw] at h; cases h
  · by_cases hq : PredU E a
    · exact (List.mem_append.1 ((mem_PromAt_pred hw hq).1 h).1).imp id FpAt_sub
    · rw [PromAt_nword hw hq, List.mem_append] at h
      exact h.imp id FpAt_sub

/-- (P4) With no promise of `P` at `a`, skipping `P` changes nothing. -/
theorem LatestNP_noProm {M : Memory} {P : List Ts} {a : Address} {w : Word}
    (hP : ∀ t m, t ∈ P → M[t]? = some m → m.loc ≠ a) : LatestNP M P a w ↔ LatestNP M [] a w := by
  constructor
  · rintro ⟨t, m, -, hm, hl, hw, hlast⟩
    exact ⟨t, m, by simp, hm, hl, hw, fun t' m' hlt hm' hl' =>
      absurd hl' (hP t' m' (hlast t' m' hlt hm' hl') hm')⟩
  · rintro ⟨t, m, -, hm, hl, hw, hlast⟩
    exact ⟨t, m, fun h => hP t m h hm hl, hm, hl, hw, fun t' m' hlt hm' hl' =>
      absurd (hlast t' m' hlt hm' hl') (by simp)⟩

/-- (P4) With no own promise at `a` (e.g. `NoProm`), the three readings agree. -/
theorem PromAt_noProm {E : TEnv} {s : St} {a : Address} {w : Word}
    (hnp : ∀ t m, t ∈ s.promises → s.mem[t]? = some m → m.loc ≠ a)
    (hfp : ∀ t m, t ∈ E.fp → s.mem[t]? = some m → m.loc ≠ a) :
    (LatestNP s.mem (PromAt E s a) a w ↔ LatestNP s.mem s.promises a w) ∧
      (LatestNP s.mem s.promises a w ↔ LatestNP s.mem [] a w) := by
  have h1 := LatestNP_noProm (w := w) hnp
  exact ⟨(LatestNP_noProm fun t m ht hm => (PromAt_sub ht).elim (fun h => hnp t m h hm)
    (fun h => hfp t m h hm)).trans h1.symm, h1⟩


theorem WordUnit_mono {E E' : TEnv} {a : Address} (hs : ∀ l c, E.sto l = some c → E'.sto l = some c)
    (h : WordUnit E a) : WordUnit E' a := by
  obtain ⟨c, hc, h⟩ := h
  exact ⟨c, hs _ _ hc, h⟩

theorem WordUnit_back {E E' : TEnv} {a : Address} {c : Cell} (hs : ∀ l c, E.sto l = some c → E'.sto l = some c)
    (hc : E.sto a.label = some c) (h : WordUnit E' a) : WordUnit E a := by
  obtain ⟨c', hc', h⟩ := h
  rw [hs _ _ hc] at hc'
  cases hc'
  exact ⟨c, hc, h⟩

theorem WordUnit_congr {E E' : TEnv} {a : Address} (h : E'.sto a.label = E.sto a.label) :
    WordUnit E' a ↔ WordUnit E a := by
  unfold WordUnit; rw [h]

theorem VisU_congr {E E' : TEnv} {a : Address} (h : E'.sto a.label = E.sto a.label) (ht : E'.tid = E.tid)
    (hp : E'.pfr a.label = E.pfr a.label := by first | rfl | assumption) :
    VisU E' a ↔ VisU E a := by
  unfold VisU; rw [WordUnit_congr h, Vis_congr h ht hp]

theorem FpAt_congr {E E' : TEnv} {a : Address} (h : E'.sto a.label = E.sto a.label)
    (ht : E'.tid = E.tid := by first | rfl | assumption)
    (hp : E'.pfr a.label = E.pfr a.label := by first | rfl | assumption)
    (hf : E'.fp = E.fp := by first | rfl | assumption) :
    FpAt E' a = FpAt E a := by
  unfold FpAt; rw [Vis_congr h ht hp, hf]

theorem IniW_congrU {E E' : TEnv} {a : Address} (h : E'.sto a.label = E.sto a.label)
    (hi : E'.ini a.label = E.ini a.label) : IniW E' a ↔ IniW E a := by
  unfold IniW; rw [h, hi]

theorem IniWr_congr {E E' : TEnv} {a : Address} (h : E'.sto a.label = E.sto a.label)
    (hr : E'.rc a.label = E.rc a.label) : IniWr E' a ↔ IniWr E a := by
  unfold IniWr; rw [h, hr]

theorem PredU_congr {E E' : TEnv} {a : Address} (h : E'.sto a.label = E.sto a.label)
    (ht : E'.tid = E.tid) (hp : E'.pfr a.label = E.pfr a.label)
    (hi : E'.ini a.label = E.ini a.label) (hr : E'.rc a.label = E.rc a.label) :
    PredU E' a ↔ PredU E a := by
  unfold PredU; rw [hp, IniW_congrU h hi, IniWr_congr h hr]

theorem IniWr_of {E : TEnv} {a : Address} {c : Cell} {N : Nat} {e : Ty} {us : List Acc}
    (hc : E.sto a.label = some c) (hT : c.ty = .array (.lit N) e) (hu : accs e = some us)
    (h : a.offset < E.rc a.label * nWords us) : IniWr E a := fun c' N' e' us' hc' hT' hu' => by
  rw [hc] at hc'; cases hc'; rw [hT] at hT'; cases hT'; rw [hu] at hu'; cases hu'; exact h

/-- (U3) Raising `ini` and `rc` of a label to a common floor `k` creates no
predicted unit. -/
theorem PredU_bump {E E' : TEnv} {l : AllocLabel} {o k : Nat}
    (hs : E'.sto l = E.sto l) (ht : E'.tid = E.tid) (hp : E'.pfr l = E.pfr l)
    (hi : E'.ini l = max (E.ini l) k) (hr : E'.rc l = max (E.rc l) k)
    (h : PredU E' ⟨l, o⟩) : PredU E ⟨l, o⟩ := by
  obtain ⟨hv, hiw, hnr⟩ := h
  refine ⟨fun h0 => hv (by show E'.pfr l = none; rw [hp]; exact h0), fun c N e us hc hT hu => ?_,
    fun hr0 => hnr fun c N e us hc hT hu => ?_⟩
  · have h1 : o < E'.ini l * nWords us := hiw c N e us (by show E'.sto l = some c; rw [hs]; exact hc) hT hu
    rw [hi] at h1
    show o < E.ini l * nWords us
    refine Classical.byContradiction fun hn => hnr (IniWr_of (a := ⟨l, o⟩) (by show E'.sto l = some c; rw [hs]; exact hc) hT hu ?_)
    show o < E'.rc l * nWords us
    rw [hr]
    rcases Nat.le_total (E.ini l) k with hle | hle
    · rw [Nat.max_eq_right hle] at h1
      exact Nat.lt_of_lt_of_le h1 (Nat.mul_le_mul_right _ (Nat.le_max_right _ _))
    · rw [Nat.max_eq_left hle] at h1; exact absurd h1 hn
  · have h0 : o < E.rc l * nWords us := hr0 c N e us (by show E.sto l = some c; rw [← hs]; exact hc) hT hu
    show o < E'.rc l * nWords us
    rw [hr]; exact Nat.lt_of_lt_of_le h0 (Nat.mul_le_mul_right _ (Nat.le_max_left _ _))

/-- (U3) A cell that is no literal array has no predicted unit. -/
theorem PredU_nonArr {E : TEnv} {a : Address} {c : Cell} (hc : E.sto a.label = some c)
    (hna : ∀ N e, c.ty ≠ .array (.lit N) e) : ¬ PredU E a :=
  fun hq => hq.2.2 fun c' N e _ hc' hT _ => by
    rw [hc] at hc'; cases hc'; exact absurd hT (hna N e)

/-- (U3) A slot initialised in the real count (`InitRr`) is not predicted. -/
theorem PredU_initRr {E : TEnv} {c : Cell} {l : AllocLabel} {o : Nat} (hc : E.sto l = some c)
    (h : InitRr E c l o) : ¬ PredU E ⟨l, o⟩ :=
  fun hq => hq.2.2 fun c' N e us hc' hT hu => by
    have hc'' : E.sto l = some c' := hc'
    rw [hc] at hc''; cases hc''; exact h N e us hT hu

theorem PromAt_congr {E E' : TEnv} {s : St} {a : Address} (h : E'.sto a.label = E.sto a.label)
    (ht : E'.tid = E.tid := by first | rfl | assumption)
    (hp : E'.pfr a.label = E.pfr a.label := by first | rfl | assumption)
    (hf : E'.fp = E.fp := by first | rfl | assumption)
    (hi : E'.ini a.label = E.ini a.label := by first | rfl | assumption)
    (hr : E'.rc a.label = E.rc a.label := by first | rfl | assumption) :
    PromAt E' s a = PromAt E s a := by
  by_cases hw : VisU E a
  · rw [PromAt_word hw, PromAt_word ((VisU_congr h ht hp).2 hw)]
  · have hw' : ¬ VisU E' a := fun h' => hw ((VisU_congr h ht hp).1 h')
    by_cases hq : PredU E a
    · rw [PromAt_pred hw hq, PromAt_pred hw' ((PredU_congr h ht hp hi hr).2 hq), FpAt_congr h ht hp hf]
    · rw [PromAt_nword hw hq, PromAt_nword hw' (fun h' => hq ((PredU_congr h ht hp hi hr).1 h')),
        FpAt_congr h ht hp hf]

/-- **The foreign promises' side
condition** at the thread's view `E` and state `s`: each is a message in memory
(below its size), at a visible cell.  Assumed by stage A's steps (it constrains
only `E.fp`, `[]` in stage A); established globally from `PromsOK` in S8. -/
def FpOK (E : TEnv) (s : St) : Prop :=
  (∀ t, t ∈ E.fp → t < s.mem.size) ∧ ∀ t m, t ∈ E.fp → s.mem[t]? = some m → Vis E m.loc.label

theorem PromAt_eqp {E : TEnv} {s s' : St} {a : Address} (h : s'.promises = s.promises)
    (hm : s'.mem = s.mem := by first | assumption | rfl) : PromAt E s' a = PromAt E s a := by
  unfold PromAt; rw [h, hm]

/-- (U3) Two memories and skip lists that agree at `a`: the same messages
there, and the same of them skipped. -/
def AtSame (M : Memory) (P : List Ts) (M' : Memory) (P' : List Ts) (a : Address) : Prop :=
  (∀ (t : Ts) (m : Msg), m.loc = a → (M[t]? = some m ↔ M'[t]? = some m)) ∧
    ∀ (t : Ts) (m : Msg), M[t]? = some m → m.loc = a → (t ∈ P ↔ t ∈ P')

theorem AtSame_refl {M : Memory} {P : List Ts} {a : Address} : AtSame M P M P a :=
  ⟨fun _ _ _ => Iff.rfl, fun _ _ _ _ => Iff.rfl⟩

theorem AtSame_trans {M M' M'' : Memory} {P P' P'' : List Ts} {a : Address}
    (h1 : AtSame M P M' P' a) (h2 : AtSame M' P' M'' P'' a) : AtSame M P M'' P'' a :=
  ⟨fun t m hl => (h1.1 t m hl).trans (h2.1 t m hl),
    fun t m hm hl => (h1.2 t m hm hl).trans (h2.2 t m ((h1.1 t m hl).1 hm) hl)⟩

theorem AtSame_symm {M M' : Memory} {P P' : List Ts} {a : Address}
    (h : AtSame M P M' P' a) : AtSame M' P' M P a :=
  ⟨fun t m hl => (h.1 t m hl).symm, fun t m hm hl => (h.2 t m ((h.1 t m hl).2 hm) hl).symm⟩

theorem AtSame_push {M : Memory} {P : List Ts} {a : Address} {x : Msg} (hx : x.loc ≠ a) :
    AtSame M P (M.push x) P a := by
  refine ⟨fun t m hl => ?_, fun _ _ _ _ => Iff.rfl⟩
  rw [Array.getElem?_push]
  by_cases e : t = M.size
  · subst e
    rw [ite_eq_left rfl, show M[M.size]? = none by simp]
    exact ⟨fun h => (by cases h), fun h => absurd (by cases h; exact hl) hx⟩
  · rw [ite_eq_right e]

theorem AtSame_erase {M : Memory} {P : List Ts} {a : Address} {t : Ts}
    (ht : ∀ m, M[t]? = some m → m.loc ≠ a) : AtSame M P M (P.erase t) a := by
  refine ⟨fun _ _ _ => Iff.rfl, fun t' m hm hl => ?_⟩
  have hne : t' ≠ t := fun e => by subst e; exact ht m hm hl
  exact (List.mem_erase_of_ne hne).symm

theorem AtSame_app {M M' : Memory} {P P' : List Ts} {a : Address} (F : List Ts)
    (h : AtSame M P M' P' a) : AtSame M (P ++ F) M' (P' ++ F) a :=
  ⟨h.1, fun t m hm hl => by simp only [List.mem_append]; exact or_congr_left (h.2 t m hm hl)⟩

theorem LatestNP_atSame {M M' : Memory} {P P' : List Ts} {a : Address} {w : Word}
    (hA : AtSame M P M' P' a) (h : LatestNP M P a w) : LatestNP M' P' a w := by
  obtain ⟨t, m, ht, hm, hl, hw, hlast⟩ := h
  refine ⟨t, m, fun h => ht ((hA.2 t m hm hl).2 h), (hA.1 t m hl).1 hm, hl, hw, fun t' m' hlt hm' hl' => ?_⟩
  have hm0 := (hA.1 t' m' hl').2 hm'
  exact (hA.2 t' m' hm0 hl').1 (hlast t' m' hlt hm0 hl')

theorem FirstW_atSame {M M' : Memory} {a : Address} {h : Ts}
    (hA : ∀ (t : Ts) (m : Msg), m.loc = a → (M[t]? = some m ↔ M'[t]? = some m)) (hf : FirstW M a h) : FirstW M' a h := by
  obtain ⟨⟨m, hm, hl, hv⟩, hlow⟩ := hf
  exact ⟨⟨m, (hA h m hl).1 hm, hl, hv⟩, fun t m' hlt hm' hl' => hlow t m' hlt ((hA t m' hl').2 hm') hl'⟩

theorem AboveFW_atSame {M M' : Memory} {a : Address} {t : Ts}
    (hA : ∀ (t : Ts) (m : Msg), m.loc = a → (M[t]? = some m ↔ M'[t]? = some m)) : AboveFW M a t ↔ AboveFW M' a t :=
  ⟨fun ⟨h, hf, hlt⟩ => ⟨h, FirstW_atSame hA hf, hlt⟩,
    fun ⟨h, hf, hlt⟩ => ⟨h, FirstW_atSame (fun t m hl => (hA t m hl).symm) hf, hlt⟩⟩

/-- (U3) Memory's reading at `a` depends only on what is at `a`. -/
theorem PromAt_atSame {E : TEnv} {s s' : St} {a : Address} {w : Word}
    (hA : AtSame s.mem s.promises s'.mem s'.promises a) (h : LatestNP s.mem (PromAt E s a) a w) :
    LatestNP s'.mem (PromAt E s' a) a w := by
  refine LatestNP_atSame ⟨hA.1, fun t m hm hl => ?_⟩ h
  by_cases hw : VisU E a
  · rw [PromAt_word hw, PromAt_word hw]
  · by_cases hq : PredU E a
    · rw [mem_PromAt_pred hw hq, mem_PromAt_pred hw hq, (AtSame_app (FpAt E a) hA).2 t m hm hl,
        AboveFW_atSame hA.1]
    · rw [PromAt_nword hw hq, PromAt_nword hw hq]; exact (AtSame_app (FpAt E a) hA).2 t m hm hl

/-- (U3) A memory that grows only at label `l` agrees with the old one off `l`. -/
theorem AtSame_growsL {M M' : Memory} {P P' : List Ts} {l : AllocLabel} {a : Address}
    (h1 : ∀ t, t < M.size → M'[t]? = M[t]?) (h2 : ∀ t m, M.size ≤ t → M'[t]? = some m → m.loc.label = l)
    (hne : a.label ≠ l) (hP : ∀ t m, M[t]? = some m → m.loc = a → (t ∈ P ↔ t ∈ P')) :
    AtSame M P M' P' a := by
  refine ⟨fun t m hl => ⟨fun hm => by rw [h1 t (lt_of_get hm)]; exact hm, fun hm' => ?_⟩, hP⟩
  by_cases hs : t < M.size
  · rw [h1 t hs] at hm'; exact hm'
  · have := h2 t m (Nat.le_of_not_lt hs) hm'
    rw [hl] at this; exact absurd this hne

/-- (U3) Dropping from the skip list only `t`, a message at `A`: the reading
stays or moves to `t`. -/
theorem LatestNP_subErase {M : Memory} {P P' : List Ts} {A : Address} {x : Word} {t : Ts} {m : Msg}
    (h : LatestNP M P A x) (hmt : M[t]? = some m) (hloc : m.loc = A)
    (hsub : ∀ u, u ∈ P' → u ∈ P) (hd : ∀ u, u ∈ P → u ∉ P' → u = t) :
    LatestNP M P' A x ∨ LatestNP M P' A (mw m) := by
  obtain ⟨t0, m0, ht0, hm0, hl0, hw0, hlast⟩ := h
  by_cases hc : t0 < t ∧ t ∉ P'
  · refine Or.inr ⟨t, m, hc.2, hmt, hloc, rfl, fun t' m' hlt hm' hl' => ?_⟩
    exact Classical.byContradiction fun hn =>
      Nat.ne_of_gt hlt (hd t' (hlast t' m' (Nat.lt_trans hc.1 hlt) hm' hl') hn)
  · refine Or.inl ⟨t0, m0, fun h => ht0 (hsub _ h), hm0, hl0, hw0, fun t' m' hlt hm' hl' => ?_⟩
    exact Classical.byContradiction fun hn => by
      have e := hd t' (hlast t' m' hlt hm' hl') hn
      subst e; exact hc ⟨hlt, hn⟩

/-- (P4) A latest word at both readings (own promises skipped, none skipped)
is one at the per-address reading. -/
theorem PromAt_lat {E : TEnv} {s s' : St} {a : Address} {w : Word}
    (h1 : ∀ F : List Ts, LatestNP s.mem (s.promises ++ F) a w → LatestNP s'.mem (s'.promises ++ F) a w)
    (h0 : LatestNP s.mem [] a w → LatestNP s'.mem [] a w)
    (hq : PredU E a → AtSame s.mem s.promises s'.mem s'.promises a) :
    LatestNP s.mem (PromAt E s a) a w → LatestNP s'.mem (PromAt E s' a) a w := by
  by_cases hw : VisU E a
  · rw [PromAt_word hw, PromAt_word hw]; exact h0
  · by_cases hq0 : PredU E a
    · exact PromAt_atSame (hq hq0)
    · rw [PromAt_nword hw hq0, PromAt_nword hw hq0]; exact h1 _

/-- **(P4) Memory's holding** `H`, at the thread's `E` and state `s`: a sum
over a duplicate-free list of labels covering Σ, of each cell's resources,
those of its latest words that are not the thread's outstanding promises (a
label outside Σ holds nothing). -/
def MemHeld (E : TEnv) (s : St) (H : Res) : Prop :=
  ∃ (L : List AllocLabel) (Rl : AllocLabel → Res), L.Nodup ∧ (∀ l c, E.sto l = some c → l ∈ L) ∧
    H = Res.sum (L.map Rl) ∧
    ∀ l, l ∈ L → (E.sto l = none → Rl l = .zero) ∧
      ∀ c, E.sto l = some c → ∃ vals, (∀ o w, vals[o]? = some w → LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w) ∧
        CellOKR E (E.ini l) (E.rc l) c.ty vals (Rl l)

/-- (P4) Address `a` is a non-ghost protocol word of `P` naming region `n`. -/
def WordAt (E : TEnv) (a : Address) (n : Nat) (P : Proto) : Prop :=
  ∃ c, E.sto a.label = some c ∧ AtOff c.ty a.offset (.word (.lit n) P) ∧ P.ghost = false

/-- (P4) `v` encodes state `(c, k)` of `P`: clause `c` at parameter `k`. -/
def Enc (P : Proto) (c k v : Nat) : Prop :=
  ∃ cl, P.clauses[c]? = some cl ∧ v = cl.scale * k + cl.off

/-- (P4) A message newly written at `a` in `s'`, holding `num v`. -/
def NewMsg (s s' : St) (a : Address) (v : Nat) : Prop :=
  ∃ (t : Ts) (m : Msg), s.mem[t]? = none ∧ s'.mem[t]? = some m ∧ m.loc = a ∧ m.val = .num v


/-! ### (P4 step 3) Promise credits and debits -/

/-- (P4) `w` is the word of the latest message to `a` strictly before `t`:
what an RMW writing at `t` must read (`rmwAdjacent`). -/
def PredAt (mem : Memory) (a : Address) (t : Ts) (w : Word) : Prop :=
  ∃ (t0 : Ts) (m : Msg), t0 < t ∧ mem[t0]? = some m ∧ m.loc = a ∧ mw m = w ∧
    ∀ (t' : Ts) (m' : Msg), t0 < t' → t' < t → mem[t']? = some m' → m'.loc ≠ a

theorem PredAt_uniq {mem : Memory} {a : Address} {t : Ts} {w w' : Word}
    (h : PredAt mem a t w) (h' : PredAt mem a t w') : w = w' := by
  obtain ⟨t0, m, hl, hm, ha, rfl, hn⟩ := h
  obtain ⟨t1, m1, hl1, hm1, ha1, rfl, hn1⟩ := h'
  rcases Nat.lt_trichotomy t0 t1 with h | rfl | h
  · exact absurd ha1 (hn t1 m1 h hl1 hm1)
  · rw [hm] at hm1; cases hm1; rfl
  · exact absurd ha (hn1 t0 m h hl hm)

/-- A memory that keeps every index below `n` keeps the predecessor of any
`t ≤ n`. -/
theorem PredAt_prefix {mem mem' : Memory} {n : Nat} (hp : ∀ t, t < n → mem'[t]? = mem[t]?)
    {a : Address} {t : Ts} {w : Word} (ht : t ≤ n) : PredAt mem a t w ↔ PredAt mem' a t w := by
  constructor
  · rintro ⟨t0, m, hl, hm, ha, hw, hn⟩
    refine ⟨t0, m, hl, by rw [hp t0 (Nat.lt_of_lt_of_le hl ht)]; exact hm, ha, hw, fun t' m' h1 h2 h3 => ?_⟩
    exact hn t' m' h1 h2 (by rw [← hp t' (Nat.lt_of_lt_of_le h2 ht)]; exact h3)
  · rintro ⟨t0, m, hl, hm, ha, hw, hn⟩
    refine ⟨t0, m, hl, by rw [← hp t0 (Nat.lt_of_lt_of_le hl ht)]; exact hm, ha, hw, fun t' m' h1 h2 h3 => ?_⟩
    exact hn t' m' h1 h2 (by rw [hp t' (Nat.lt_of_lt_of_le h2 ht)]; exact h3)

/-- (P4) The resources a word `w` carries at `a`: the region token of a
non-ghost protocol word in a holding state, else none. -/
def WRes (E : TEnv) (a : Address) (w : Word) (R : Res) : Prop :=
  (∃ n P, WordAt E a n P ∧ WordHolds P [w.val] ∧ R = Res.one (.rg n)) ∨
  ((∀ n P, WordAt E a n P → ¬ WordHolds P [w.val]) ∧ R = .zero)

theorem WRes_uniq {E : TEnv} {a : Address} {w : Word} {R R' : Res}
    (hu : ∀ n P n' P', WordAt E a n P → WordAt E a n' P' → n = n' ∧ P = P')
    (h : WRes E a w R) (h' : WRes E a w R') : R = R' := by
  rcases h with ⟨n, P, hw, hh, rfl⟩ | ⟨hn, rfl⟩ <;> rcases h' with ⟨n', P', hw', hh', rfl⟩ | ⟨hn', rfl⟩
  · obtain ⟨rfl, rfl⟩ := hu n P n' P' hw hw'; rfl
  · exact absurd hh (hn' n P hw)
  · exact absurd hh' (hn n' P' hw')
  · rfl

theorem WordAt_congr {E E' : TEnv} {a : Address} (hs : E'.sto a.label = E.sto a.label) {n : Nat} {P : Proto} :
    WordAt E' a n P ↔ WordAt E a n P := by
  unfold WordAt; rw [hs]

theorem WRes_congr {E E' : TEnv} {a : Address} (hs : E'.sto a.label = E.sto a.label) {w : Word} {R : Res} :
    WRes E' a w R ↔ WRes E a w R := by
  unfold WRes; simp only [WordAt_congr hs]

theorem IniW_congr {E E' : TEnv} {a : Address} (hs : E'.sto a.label = E.sto a.label)
    (hi : E'.ini a.label = E.ini a.label) : IniW E' a ↔ IniW E a := by
  unfold IniW; rw [hs, hi]

theorem IniW_none {E : TEnv} {a : Address} (h : E.sto a.label = none) : IniW E a :=
  fun _ _ _ _ hc => by rw [h] at hc; cases hc

/-- (S4f, S7f α) `WRes` where memory reads promises (`Vis`) at an initialised
address (`IniW`); nothing at an own cell, nor at an uninitialised buffer slot
(memory's holding counts only initialised slots, `BufOKR`: a promise there is
accounted as the slot's initialisation, at its fulfilment). -/
def VRes (E : TEnv) (a : Address) (w : Word) (R : Res) : Prop :=
  (Vis E a.label ∧ IniW E a ∧ WRes E a w R) ∨ (¬ (Vis E a.label ∧ IniW E a) ∧ R = .zero)

theorem VRes_vis {E : TEnv} {a : Address} {w : Word} {R : Res} (h : Vis E a.label) (hi : IniW E a) :
    VRes E a w R ↔ WRes E a w R :=
  ⟨fun h' => h'.elim (fun h1 => h1.2.2) (fun h1 => absurd ⟨h, hi⟩ h1.1), fun h' => Or.inl ⟨h, hi, h'⟩⟩

theorem VRes_own {E : TEnv} {a : Address} {w : Word} {R : Res} (h : Priv E a.label) : VRes E a w R ↔ R = .zero :=
  ⟨fun h' => h'.elim (fun h1 => absurd h h1.1) (fun h1 => h1.2), fun h' => Or.inr ⟨fun hv => hv.1 h, h'⟩⟩

/-- (S7f α) Nothing is read for a promise at an uninitialised buffer slot. -/
theorem VRes_uninit {E : TEnv} {a : Address} {w : Word} {R : Res} (h : ¬ IniW E a) : VRes E a w R ↔ R = .zero :=
  ⟨fun h' => h'.elim (fun h1 => absurd h1.2.1 h) (fun h1 => h1.2), fun h' => Or.inr ⟨fun hv => h hv.2, h'⟩⟩

theorem VRes_congr {E E' : TEnv} {a : Address} (hs : E'.sto a.label = E.sto a.label) (ht : E'.tid = E.tid)
    {w : Word} {R : Res} (hp : E'.pfr a.label = E.pfr a.label := by first | rfl | assumption)
    (hi : E'.ini a.label = E.ini a.label := by first | rfl | assumption) :
    VRes E' a w R ↔ VRes E a w R := by
  unfold VRes; rw [Vis_congr hs ht hp, WRes_congr hs, IniW_congr hs hi]

open Classical in
/-- (P4) What a word of region `n` and protocol `P` with value `v` holds. -/
noncomputable def wr (P : Proto) (n : Nat) (v : WeakMem.Val) : Res :=
  if WordHolds P [v] then Res.one (.rg n) else .zero

/-- (U3, fix b) Promise `tw` *initialises* unit `a`: the message just below it
there, if any, is the allocation placeholder `.undef` (a predicted slot's
holder). -/
def InitAt (mem : Memory) (a : Address) (tw : Ts) : Prop := ∀ w, PredAt mem a tw w → w.val = .undef

/-- (U3, fix b) The whole of what word `w` holds at `a`: at a non-ghost protocol
word, its region token if holding and its word token. -/
def FRes (E : TEnv) (a : Address) (w : Word) (R : Res) : Prop :=
  (∃ n P, WordAt E a n P ∧ R = wr P n w.val + wdW P n) ∨ ((∀ n P, ¬ WordAt E a n P) ∧ R = .zero)

/-- (H) An atomic component type: neither a pair nor a `μ` (the types `AtOff`
descends through). -/
def AtomT (U : Ty) : Prop := (∀ a b, U ≠ .prod a b) ∧ ∀ t, U ≠ .mu t

/-- (H) **Block start**: `a` starts a positive-width atomic component `U` of a
slot of a buffer whose element layout is all `.one` units; `U` is not a
non-ghost protocol word (whose holding is the word part, `FRes`). -/
def BlkStart (E : TEnv) (a : Address) (U : Ty) : Prop :=
  ∃ c N e us j o w, E.sto a.label = some c ∧ c.ty = .array (.lit N) e ∧ accs e = some us ∧
    (∀ u ∈ us, u = .one) ∧ j < N ∧ a.offset = j * nWords us + o ∧ AtOff e o U ∧ AtomT U ∧
    wc U = some w ∧ 0 < w ∧ ∀ r P, U = .word r P → P.ghost = true

/-- (H) Designated word: the first word of a slot of a buffer whose element
layout is all `.one` units, at least one. -/
def SlotStart (E : TEnv) (a : Address) : Prop :=
  ∃ cl N e us, E.sto a.label = some cl ∧ cl.ty = .array (.lit N) e ∧ accs e = some us ∧
    0 < nWords us ∧ (∀ u ∈ us, u = .one) ∧ a.offset % nWords us = 0

/-- (H) The zero-width atomic components of a type, in layout order (the
descent of `AtOff`: pairs and `μ` unfoldings). -/
inductive ZwL : Ty → List Ty → Prop
  | zero {t : Ty} : AtomT t → wc t = some 0 → ZwL t [t]
  | pos {t : Ty} {n : Nat} : AtomT t → wc t = some (n + 1) → ZwL t []
  | prod {a b : Ty} {A B : List Ty} : ZwL a A → ZwL b B → ZwL (.prod a b) (A ++ B)
  | mu {t : Ty} {L : List Ty} : ZwL (unfold1 (.mu t)) L → ZwL (.mu t) L

/-- (H) A designated start: a block start or a slot start of a cell of the
thread's own. -/
def DStart (E : TEnv) (a : Address) : Prop :=
  (∃ c, E.sto a.label = some c ∧ c.owner = some E.tid) ∧ ((∃ U, BlkStart E a U) ∨ SlotStart E a)

/-- (H) **A designated promise** `tw` at `a`: the first write at a designated
start of a predicted unit (a planted holder). -/
def DesigAt (E : TEnv) (mem : Memory) (a : Address) (tw : Ts) : Prop :=
  PredU E a ∧ DStart E a ∧ FirstW mem a tw

/-- (H) The block part of a designated debit: the value of the block starting
at `a`, on its units' first writes, at an environment whose boxes `E` keeps. -/
def BlkZ (E : TEnv) (mem : Memory) (a : Address) (Z : Res) : Prop :=
  (∃ U w ws, BlkStart E a U ∧ wc U = some w ∧ ws.length = w ∧
    (∀ o x, ws[o]? = some x → ∃ h m, FirstW mem ⟨a.label, a.offset + o⟩ h ∧ mem[h]? = some m ∧ x = mw m) ∧
    ∃ E0 : TEnv, (∀ l B, E0.box l = some B → E.box l = some B) ∧ VRR (fun _ => 0) (CE E0.unsee) U (shp U) ws Z) ∨
  ((∀ U, ¬ BlkStart E a U) ∧ Z = .zero)

/-- (H) The zero-width part of a designated debit, at a slot start: the values
of the slot's zero-width components. -/
def ZwZ (E : TEnv) (a : Address) (Z : Res) : Prop :=
  (SlotStart E a ∧ ∃ c N e us, ∃ (Us : List Ty) (Rs : List Res), ∃ E0 : TEnv, E.sto a.label = some c ∧ c.ty = .array (.lit N) e ∧
    accs e = some us ∧ ZwL e Us ∧ Rs.length = Us.length ∧ Z = Res.sum Rs ∧
    (∀ l B, E0.box l = some B → E.box l = some B) ∧
    ∀ (i : Nat) U Ri, Us[i]? = some U → Rs[i]? = some Ri → VRR (fun _ => 0) (CE E0.unsee) U (shp U) [] Ri) ∨
  (¬ SlotStart E a ∧ Z = .zero)

/-- (H) A resource without its own-handle keys (a planted value holds none: own handles
are never shareable, so the designated debit drops them). -/
def noOwnR (R : Res) : Res := fun k => match k with
  | .own _ => 0
  | k => R k

@[simp] theorem noOwnR_own (R : Res) (l : Nat) : noOwnR R (.own l) = 0 := rfl

theorem noOwnR_le (R : Res) : noOwnR R ≤ R := fun k => by
  cases k <;> simp [noOwnR]

/-- (H) **The non-word part of a designated debit**: its block part plus its
zero-width part, own-handle keys dropped. -/
def BlkDb (E : TEnv) (mem : Memory) (a : Address) (Z : Res) : Prop :=
  ∃ Zb Zz, BlkZ E mem a Zb ∧ ZwZ E a Zz ∧ Z = noOwnR (Zb + Zz)

/-- (H) Where a promise's debit may be non-zero: a visible word unit, or a
designated start of a predicted unit. -/
def VisD (E : TEnv) (a : Address) : Prop := VisU E a ∨ (PredU E a ∧ DStart E a)

/-- (U3, fix b) **A promise's debit** (message `m` at `tw`): where memory reads
promises (`Vis`, `IniW`), what the promised word holds (`WRes`), and the whole
word (`FRes`) when the promise initialises its unit, plus (H) the non-word
part (`BlkDb`) of a designated promise; elsewhere nothing. -/
def DbRes (E : TEnv) (mem : Memory) (m : Msg) (tw : Ts) (R : Res) : Prop :=
  (Vis E m.loc.label ∧ IniW E m.loc ∧
      (InitAt mem m.loc tw → ∃ R₁ Z, FRes E m.loc (mw m) R₁ ∧
         (DesigAt E mem m.loc tw → BlkDb E mem m.loc Z) ∧
         (¬ DesigAt E mem m.loc tw → Z = .zero) ∧ R = R₁ + Z) ∧
      (¬ InitAt mem m.loc tw → WRes E m.loc (mw m) R)) ∨

    (¬ (Vis E m.loc.label ∧ IniW E m.loc) ∧ R = .zero)

theorem DbRes_nInit {E : TEnv} {mem : Memory} {m : Msg} {tw : Ts} {R : Res} (h : ¬ InitAt mem m.loc tw) :
    DbRes E mem m tw R ↔ VRes E m.loc (mw m) R := by
  constructor
  · rintro (⟨h1, h2, -, h4⟩ | ⟨h1, h2⟩)
    · exact Or.inl ⟨h1, h2, h4 h⟩
    · exact Or.inr ⟨h1, h2⟩
  · rintro (⟨h1, h2, h3⟩ | ⟨h1, h2⟩)
    · exact Or.inl ⟨h1, h2, fun h' => absurd h' h, fun _ => h3⟩
    · exact Or.inr ⟨h1, h2⟩

theorem FRes_congr {E E' : TEnv} {a : Address} (hs : E'.sto a.label = E.sto a.label) {w : Word} {R : Res} :
    FRes E' a w R ↔ FRes E a w R := by
  unfold FRes; simp only [WordAt_congr hs]

theorem SlotStart_congr {E E' : TEnv} {a : Address} (hs : E'.sto a.label = E.sto a.label) :
    SlotStart E' a ↔ SlotStart E a := by
  unfold SlotStart; rw [hs]
#print axioms SlotStart_congr

theorem BlkStart_congr {E E' : TEnv} {a : Address} (hs : E'.sto a.label = E.sto a.label) {U : Ty} :
    BlkStart E' a U ↔ BlkStart E a U := by
  unfold BlkStart; rw [hs]
#print axioms BlkStart_congr

theorem DStart_congr {E E' : TEnv} {a : Address} (hs : E'.sto a.label = E.sto a.label) (ht : E'.tid = E.tid) :
    DStart E' a ↔ DStart E a := by
  unfold DStart
  rw [hs, ht]
  exact and_congr Iff.rfl (or_congr (exists_congr fun U => BlkStart_congr hs) (SlotStart_congr hs))
#print axioms DStart_congr

theorem DesigAt_congr {E E' : TEnv} {mem : Memory} {a : Address} {tw : Ts} (hs : E'.sto a.label = E.sto a.label)
    (ht : E'.tid = E.tid) (hp : E'.pfr a.label = E.pfr a.label) (hi : E'.ini a.label = E.ini a.label)
    (hr : E'.rc a.label = E.rc a.label) : DesigAt E' mem a tw ↔ DesigAt E mem a tw := by
  unfold DesigAt; rw [PredU_congr hs ht hp hi hr, DStart_congr hs ht]
#print axioms DesigAt_congr

theorem FirstW_grow {mem mem' : Memory} {a : Address} {h : Ts} (hp : ∀ t, t < mem.size → mem'[t]? = mem[t]?)
    (hf : FirstW mem a h) : FirstW mem' a h := by
  obtain ⟨⟨m, hm, h2, h3⟩, h4⟩ := hf
  have hlt := lt_of_get hm
  exact ⟨⟨m, by rw [hp h hlt]; exact hm, h2, h3⟩, fun t m' ht hm' hl =>
    h4 t m' ht (by rw [← hp t (Nat.lt_trans ht hlt)]; exact hm') hl⟩
#print axioms FirstW_grow

theorem FirstW_shrink {mem mem' : Memory} {a : Address} {h : Ts} (hp : ∀ t, t < mem.size → mem'[t]? = mem[t]?)
    (hh : h < mem.size) (hf : FirstW mem' a h) : FirstW mem a h := by
  obtain ⟨⟨m, hm, h2, h3⟩, h4⟩ := hf
  exact ⟨⟨m, by rw [← hp h hh]; exact hm, h2, h3⟩, fun t m' ht hm' hl =>
    h4 t m' ht (by rw [hp t (Nat.lt_trans ht hh)]; exact hm') hl⟩
#print axioms FirstW_shrink

theorem DesigAt_mem {E : TEnv} {mem mem' : Memory} {a : Address} {tw : Ts}
    (hp : ∀ t, t < mem.size → mem'[t]? = mem[t]?) (htw : tw < mem.size) :
    DesigAt E mem' a tw ↔ DesigAt E mem a tw :=
  ⟨fun ⟨h1, h2, h3⟩ => ⟨h1, h2, FirstW_shrink hp htw h3⟩, fun ⟨h1, h2, h3⟩ => ⟨h1, h2, FirstW_grow hp h3⟩⟩
#print axioms DesigAt_mem

/-- (H) The first write at `a` initialises it: everything below it there is the placeholder. -/
theorem FirstW_initAt {mem : Memory} {a : Address} {tw : Ts} (h : FirstW mem a tw) : InitAt mem a tw := by
  rintro w ⟨t0, m, hlt, hm, hl, rfl, -⟩
  exact h.2 t0 m hlt hm hl
#print axioms FirstW_initAt

theorem BlkZ_mono {E E' : TEnv} {mem : Memory} {a : Address} (hs : E'.sto a.label = E.sto a.label)
    (hb : ∀ l B, E.box l = some B → E'.box l = some B) {Z : Res} (h : BlkZ E mem a Z) : BlkZ E' mem a Z := by
  rcases h with ⟨U, w, ws, h1, h2, h3, h4, E0, h5, h6⟩ | ⟨h1, h2⟩
  · exact Or.inl ⟨U, w, ws, (BlkStart_congr hs).2 h1, h2, h3, h4, E0, fun l B h => hb l B (h5 l B h), h6⟩
  · exact Or.inr ⟨fun U h => h1 U ((BlkStart_congr hs).1 h), h2⟩
#print axioms BlkZ_mono

theorem BlkZ_grow {E : TEnv} {mem mem' : Memory} {a : Address} {Z : Res}
    (hp : ∀ t, t < mem.size → mem'[t]? = mem[t]?) (h : BlkZ E mem a Z) : BlkZ E mem' a Z := by
  rcases h with ⟨U, w, ws, h1, h2, h3, h4, h5⟩ | h
  · refine Or.inl ⟨U, w, ws, h1, h2, h3, fun o x hx => ?_, h5⟩
    obtain ⟨t, m, hf, hm, hxm⟩ := h4 o x hx
    exact ⟨t, m, FirstW_grow hp hf, by rw [hp t (lt_of_get hm)]; exact hm, hxm⟩
  · exact Or.inr h
#print axioms BlkZ_grow

theorem ZwZ_mono {E E' : TEnv} {a : Address} (hs : E'.sto a.label = E.sto a.label)
    (hb : ∀ l B, E.box l = some B → E'.box l = some B) {Z : Res} (h : ZwZ E a Z) : ZwZ E' a Z := by
  rcases h with ⟨hS, c, N, e, us, Us, Rs, E0, h1, h2, h3, h4, h5, h6, h7, h8⟩ | ⟨hS, h0⟩
  · exact Or.inl ⟨(SlotStart_congr hs).2 hS, c, N, e, us, Us, Rs, E0, by rw [hs]; exact h1, h2, h3, h4, h5, h6,
      fun l B h => hb l B (h7 l B h), h8⟩
  · exact Or.inr ⟨fun h => hS ((SlotStart_congr hs).1 h), h0⟩
#print axioms ZwZ_mono

theorem BlkDb_mono {E E' : TEnv} {mem : Memory} {a : Address} (hs : E'.sto a.label = E.sto a.label)
    (hb : ∀ l B, E.box l = some B → E'.box l = some B) {Z : Res} (h : BlkDb E mem a Z) : BlkDb E' mem a Z :=
  let ⟨Zb, Zz, h1, h2, h3⟩ := h
  ⟨Zb, Zz, BlkZ_mono hs hb h1, ZwZ_mono hs hb h2, h3⟩
#print axioms BlkDb_mono

theorem BlkDb_grow {E : TEnv} {mem mem' : Memory} {a : Address} {Z : Res}
    (hp : ∀ t, t < mem.size → mem'[t]? = mem[t]?) (h : BlkDb E mem a Z) : BlkDb E mem' a Z :=
  let ⟨Zb, Zz, h1, h2, h3⟩ := h
  ⟨Zb, Zz, BlkZ_grow hp h1, h2, h3⟩
#print axioms BlkDb_grow

theorem VisD_congr {E E' : TEnv} {a : Address} (hs : E'.sto a.label = E.sto a.label) (ht : E'.tid = E.tid)
    (hp : E'.pfr a.label = E.pfr a.label) (hi : E'.ini a.label = E.ini a.label)
    (hr : E'.rc a.label = E.rc a.label) : VisD E' a ↔ VisD E a := by
  unfold VisD; rw [VisU_congr hs ht hp, PredU_congr hs ht hp hi hr, DStart_congr hs ht]
#print axioms VisD_congr

theorem not_DesigAt_of {E : TEnv} {mem : Memory} {a : Address} {tw : Ts} (h : ¬ VisD E a) :
    ¬ DesigAt E mem a tw := fun ⟨h1, h2, _⟩ => h (Or.inr ⟨h1, h2⟩)
#print axioms not_DesigAt_of

theorem DbRes_congr {E E' : TEnv} {mem : Memory} {m : Msg} {tw : Ts} {R : Res}
    (hs : E'.sto m.loc.label = E.sto m.loc.label) (ht : E'.tid = E.tid)
    (hp : E'.pfr m.loc.label = E.pfr m.loc.label := by first | rfl | assumption)
    (hi : E'.ini m.loc.label = E.ini m.loc.label := by first | rfl | assumption)
    (hb : ∀ l B, E.box l = some B → E'.box l = some B := by first | exact fun _ _ h => h | assumption)
    (h : DbRes E mem m tw R)
    (hr : E'.rc m.loc.label = E.rc m.loc.label := by first | rfl | assumption) : DbRes E' mem m tw R := by
  have hD := DesigAt_congr (mem := mem) (tw := tw) hs ht hp hi hr
  rcases h with ⟨h1, h2, h3, h4⟩ | ⟨h1, h2⟩
  · refine Or.inl ⟨(Vis_congr hs ht hp).2 h1, (IniW_congr hs hi).2 h2, fun hI => ?_,
      fun hI => (WRes_congr hs).2 (h4 hI)⟩
    obtain ⟨R₁, Z, hF, hS, hZ, hR⟩ := h3 hI
    exact ⟨R₁, Z, (FRes_congr hs).2 hF, fun h' => BlkDb_mono hs hb (hS (hD.1 h')),
      fun h' => hZ (fun h'' => h' (hD.2 h'')), hR⟩
  · exact Or.inr ⟨by rw [Vis_congr hs ht hp, IniW_congr hs hi]; exact h1, h2⟩

theorem InitAt_prefix {mem mem' : Memory} {a : Address} {tw : Ts} (hp : ∀ t, t < tw → mem'[t]? = mem[t]?) :
    InitAt mem' a tw ↔ InitAt mem a tw := by
  unfold InitAt
  exact forall_congr' fun w => imp_congr_left (PredAt_prefix hp (Nat.le_refl _)).symm

/-- (U3, fix b; H) The debit reads memory below its size (the designated
block's first writes). -/
theorem DbRes_mem {E : TEnv} {mem mem' : Memory} {m : Msg} {tw : Ts} {R : Res}
    (hp : ∀ t, t < mem.size → mem'[t]? = mem[t]?) (htw : tw < mem.size) (h : DbRes E mem m tw R) :
    DbRes E mem' m tw R := by
  have hI : InitAt mem' m.loc tw ↔ InitAt mem m.loc tw := InitAt_prefix fun t ht => hp t (Nat.lt_trans ht htw)
  have hD : DesigAt E mem' m.loc tw ↔ DesigAt E mem m.loc tw := DesigAt_mem hp htw
  rcases h with ⟨h1, h2, h3, h4⟩ | h
  · refine Or.inl ⟨h1, h2, fun hi => ?_, fun hi => h4 (fun h' => hi (hI.2 h'))⟩
    obtain ⟨R₁, Z, hF, hS, hZ, hR⟩ := h3 (hI.1 hi)
    exact ⟨R₁, Z, hF, fun h' => BlkDb_grow hp (hS (hD.1 h')), fun h' => hZ (fun h'' => h' (hD.2 h'')), hR⟩
  · exact Or.inr h

/-- (U3, fix b; H) Off the visible word units and the designated promises, no
debit. -/
theorem DbRes_zero {E : TEnv} {mem : Memory} {m : Msg} {tw : Ts} {R : Res} (h : ¬ VisU E m.loc)
    (hd : ¬ DesigAt E mem m.loc tw) : DbRes E mem m tw R ↔ R = .zero := by
  have hnw : Vis E m.loc.label → ∀ n P, ¬ WordAt E m.loc n P := fun hV n P hw => by
    obtain ⟨c, hc, hat, hg⟩ := hw
    exact h ⟨⟨c, hc, Or.inl ⟨_, P, hg, hat⟩⟩, hV⟩
  constructor
  · rintro (⟨hV, -, h3, h4⟩ | ⟨-, h0⟩)
    · by_cases hi : InitAt mem m.loc tw
      · obtain ⟨R₁, Z, hF, -, hZ, hR⟩ := h3 hi
        rw [hR, hZ hd, Res.add_zero]
        rcases hF with ⟨n, P, hw, -⟩ | ⟨-, h0⟩
        · exact absurd hw (hnw hV n P)
        · exact h0
      · rcases h4 hi with ⟨n, P, hw, -, -⟩ | ⟨-, h0⟩
        · exact absurd hw (hnw hV n P)
        · exact h0
    · exact h0
  · rintro rfl
    by_cases hV : Vis E m.loc.label ∧ IniW E m.loc
    · exact Or.inl ⟨hV.1, hV.2, fun _ => ⟨.zero, .zero, Or.inr ⟨hnw hV.1, rfl⟩,
          fun hS => absurd hS hd, fun _ => rfl, (Res.add_zero _).symm⟩,
        fun _ => Or.inr ⟨fun n P hw => absurd hw (hnw hV.1 n P), rfl⟩⟩
    · exact Or.inr ⟨hV, rfl⟩
#print axioms DbRes_zero

/-- (H) An uninitialised unit carries no debit: the designated part needs
`PredU`, hence `IniW`. -/
theorem DbRes_noIni {E : TEnv} {mem : Memory} {m : Msg} {tw : Ts} {R : Res} (hn : ¬ IniW E m.loc)
    (h : DbRes E mem m tw R) : R = .zero := by
  rcases h with ⟨-, hi, -⟩ | ⟨-, h⟩
  · exact absurd hi hn
  · exact h
#print axioms DbRes_noIni

/-- (H) `DbRes_noIni` at the region and word keys. -/
theorem DbRes_rgwd_noIni {E : TEnv} {mem : Memory} {m : Msg} {tw : Ts} {R : Res} (hn : ¬ IniW E m.loc)
    (h : DbRes E mem m tw R) (n : Nat) : R (.rg n) = 0 ∧ R (.wd n) = 0 := by
  rw [DbRes_noIni hn h]; exact ⟨rfl, rfl⟩
#print axioms DbRes_rgwd_noIni

/-- (H) A designated unit is initialised (`PredU`). -/
theorem DesigAt_iniW {E : TEnv} {mem : Memory} {a : Address} {tw : Ts} (h : DesigAt E mem a tw) :
    IniW E a := h.1.2.1
#print axioms DesigAt_iniW

/-- (U3, fix b) Off `VisD`, no debit. -/
theorem DbRes_nvisU {E : TEnv} {mem : Memory} {m : Msg} {tw : Ts} {R : Res} (hd : ¬ VisD E m.loc) :
    DbRes E mem m tw R ↔ R = .zero :=
  DbRes_zero (fun h' => hd (Or.inl h')) (not_DesigAt_of hd)

/-- (U3, fix b) At an uninitialised address, no debit. -/
theorem DbRes_uninit {E : TEnv} {mem : Memory} {m : Msg} {tw : Ts} {R : Res} (h : ¬ IniW E m.loc) :
    DbRes E mem m tw R ↔ R = .zero :=
  ⟨fun h' => h'.elim (fun h1 => absurd h1.2.1 h) (fun h1 => h1.2), fun h' => Or.inr ⟨fun hv => h hv.2, h'⟩⟩

/-- (U3, fix b) Where memory reads promises: the debit by `InitAt`. -/
theorem DbRes_vis {E : TEnv} {mem : Memory} {m : Msg} {tw : Ts} {R : Res} (h : Vis E m.loc.label)
    (hi : IniW E m.loc) :
    DbRes E mem m tw R ↔ (InitAt mem m.loc tw → ∃ R₁ Z, FRes E m.loc (mw m) R₁ ∧
         (DesigAt E mem m.loc tw → BlkDb E mem m.loc Z) ∧
         (¬ DesigAt E mem m.loc tw → Z = .zero) ∧ R = R₁ + Z) ∧
      (¬ InitAt mem m.loc tw → WRes E m.loc (mw m) R) :=
  ⟨fun h' => h'.elim (fun h1 => h1.2.2) (fun h1 => absurd ⟨h, hi⟩ h1.1), fun h' => Or.inl ⟨h, hi, h'⟩⟩

theorem not_VisD_priv {E : TEnv} {a : Address} (h : Priv E a.label) : ¬ VisD E a := by
  rintro (h' | ⟨h', -⟩)
  · exact h'.2 h
  · exact PredU_own h h'
#print axioms not_VisD_priv

/-- (U3, fix b) At a private cell, no debit. -/
theorem DbRes_ownz {E : TEnv} {mem : Memory} {m : Msg} {tw : Ts} (h : Priv E m.loc.label) {R : Res}
    (hd : DbRes E mem m tw R) : R = .zero :=
  (DbRes_nvisU (not_VisD_priv h)).1 hd

theorem DbRes_noword {E : TEnv} {mem : Memory} {m : Msg} {tw : Ts} {R : Res} (h : DbRes E mem m tw R)
    (hn : ∀ n P, ¬ WordAt E m.loc n P) (hns : ¬ DesigAt E mem m.loc tw) : R = .zero := by
  rcases h with ⟨-, -, h3, h4⟩ | ⟨-, h⟩
  · by_cases hi : InitAt mem m.loc tw
    · obtain ⟨R₁, Z, hF, -, hZ, hR⟩ := h3 hi
      rw [hR, hZ hns, Res.add_zero]
      rcases hF with ⟨n, P, hw, -⟩ | ⟨-, h⟩
      · exact absurd hw (hn n P)
      · exact h
    · rcases h4 hi with ⟨n, P, hw, -, -⟩ | ⟨-, h⟩
      · exact absurd hw (hn n P)
      · exact h
  · exact h

/-- (U3, fix b) No `rg n` in a debit where no Σ word names region `n`. -/
theorem DbRes_rg_noWord {E : TEnv} {mem : Memory} {m : Msg} {tw : Ts} {R : Res} (h : DbRes E mem m tw R)
    {n : Nat} (hn : ∀ P, ¬ WordAt E m.loc n P) (hns : ¬ DesigAt E mem m.loc tw) : R (.rg n) = 0 := by
  rcases h with ⟨-, -, h3, h4⟩ | ⟨-, rfl⟩
  · by_cases hi : InitAt mem m.loc tw
    · obtain ⟨R₁, Z, hF, -, hZ, rfl⟩ := h3 hi
      rw [hZ hns, Res.add_zero]
      rcases hF with ⟨n', P, hw, rfl⟩ | ⟨-, rfl⟩
      · have : n ≠ n' := fun e => hn P (e ▸ hw)
        simp only [Res.add_apply, wr, wdW]
        split <;> split <;> simp [this]
      · rfl
    · rcases h4 hi with ⟨n', P, hw, -, rfl⟩ | ⟨-, rfl⟩
      · have : n ≠ n' := fun e => hn P (e ▸ hw)
        simp [this]
      · rfl
  · rfl

/-- (U3, fix b) `VRes_move` (TermInterf) for the debit: same store, thread,
frontier at the label; `ini` the same or grown over an initialised address;
(H) the real count the same, or the cell not the thread's (no designated
promise). -/
theorem DbRes_move {E E' : TEnv} {mem : Memory} {m : Msg} {tw : Ts} {R : Res}
    (hs : E'.sto m.loc.label = E.sto m.loc.label) (ht : E'.tid = E.tid) (hp : E'.pfr m.loc.label = E.pfr m.loc.label)
    (hi : E'.ini m.loc.label = E.ini m.loc.label ∨ (E.ini m.loc.label ≤ E'.ini m.loc.label ∧ IniW E m.loc))
    (hr : E'.rc m.loc.label = E.rc m.loc.label ∨ ∀ c, E.sto m.loc.label = some c → c.owner ≠ some E.tid)
    (h : DbRes E mem m tw R)
    (hb : ∀ l B, E.box l = some B → E'.box l = some B := by first | exact fun _ _ h => h | assumption) :
    DbRes E' mem m tw R := by
  have hV := Vis_congr hs ht hp
  have hD : DesigAt E' mem m.loc tw ↔ DesigAt E mem m.loc tw := by
    rcases hr with hr | hno
    · rcases hi with hi | ⟨hle, hiw⟩
      · exact DesigAt_congr hs ht hp hi hr
      · have hiw' : IniW E' m.loc := fun c N e us hc hT hu => by
          rw [hs] at hc
          exact Nat.lt_of_lt_of_le (hiw c N e us hc hT hu) (Nat.mul_le_mul_right _ hle)
        unfold DesigAt PredU
        rw [hp, IniWr_congr hs hr, DStart_congr hs ht]
        exact Iff.intro (fun h => ⟨⟨h.1.1, hiw, h.1.2.2⟩, h.2⟩) (fun h => ⟨⟨h.1.1, hiw', h.1.2.2⟩, h.2⟩)
    · have hn : ∀ F : TEnv, F.sto m.loc.label = E.sto m.loc.label → F.tid = E.tid → ¬ DesigAt F mem m.loc tw :=
        fun F hFs hFt ⟨_, ⟨⟨c, hc, ho⟩, _⟩, _⟩ => hno c (by rw [← hFs]; exact hc) (by rw [← hFt]; exact ho)
      exact ⟨fun h' => absurd h' (hn E' hs ht), fun h' => absurd h' (hn E rfl rfl)⟩
  rcases hi with hi | ⟨hle, hiw⟩
  · rcases h with ⟨h1, h2, h3, h4⟩ | ⟨h1, h2⟩
    · refine Or.inl ⟨hV.2 h1, (IniW_congr hs hi).2 h2, fun hI => ?_, fun hI => (WRes_congr hs).2 (h4 hI)⟩
      obtain ⟨R₁, Z, hF, hS, hZ, hR⟩ := h3 hI
      exact ⟨R₁, Z, (FRes_congr hs).2 hF, fun h' => BlkDb_mono hs hb (hS (hD.1 h')),
        fun h' => hZ (fun h'' => h' (hD.2 h'')), hR⟩
    · exact Or.inr ⟨by rw [hV, IniW_congr hs hi]; exact h1, h2⟩
  · have hiw' : IniW E' m.loc := fun c N e us hc hT hu => by
      rw [hs] at hc
      exact Nat.lt_of_lt_of_le (hiw c N e us hc hT hu) (Nat.mul_le_mul_right _ hle)
    rcases h with ⟨h1, -, h3, h4⟩ | ⟨h1, h2⟩
    · refine Or.inl ⟨hV.2 h1, hiw', fun hI => ?_, fun hI => (WRes_congr hs).2 (h4 hI)⟩
      obtain ⟨R₁, Z, hF, hS, hZ, hR⟩ := h3 hI
      exact ⟨R₁, Z, (FRes_congr hs).2 hF, fun h' => BlkDb_mono hs hb (hS (hD.1 h')),
        fun h' => hZ (fun h'' => h' (hD.2 h'')), hR⟩
    · exact Or.inr ⟨fun ⟨a1, _⟩ => h1 ⟨hV.1 a1, hiw⟩, h2⟩

/-- (U3, fix b) A debit not initialising its unit carries no `wd`. -/
theorem DbRes_wd_nInit {E : TEnv} {mem : Memory} {m : Msg} {tw : Ts} {R : Res} (h : DbRes E mem m tw R)
    (hi : ¬ InitAt mem m.loc tw) (n : Nat) : R (.wd n) = 0 := by
  rcases (DbRes_nInit hi).1 h with ⟨-, -, ⟨n', P, -, -, rfl⟩ | ⟨-, rfl⟩⟩ | ⟨-, rfl⟩ <;> simp

/-- (U3, fix b) No outstanding own promise at the protocol word unit `a`
initialises it: what a plain store (not a `bufInit`) may fulfil. (Off protocol
words a debit is nothing, `DbRes_noword`.) -/
def NoInitF (E : TEnv) (s : St) (a : Address) : Prop :=
  ∀ t m, t ∈ s.promises → s.mem[t]? = some m → m.loc = a → ((∃ n P, WordAt E a n P) ∨ (PredU E a ∧ DStart E a)) →
    ¬ InitAt s.mem a t

/-- (P4, S4f) Each own outstanding promise `tw` carries a credit `cr tw` (what its
predecessor holds: a fulfilling RMW hands it to the thread) and a debit
`db tw` (what the promised message holds: the fulfilling store takes it from
the thread). Off protocol words both are `.zero`, and (S4f) so they are at
the thread's own cells, where memory's reading skips own promises (`VRes`). -/
def PromCr (E : TEnv) (s : St) (cr db : Ts → Res) : Prop :=
  ∀ tw, tw ∈ s.promises → ∃ m, s.mem[tw]? = some m ∧ DbRes E s.mem m tw (db tw) ∧
    ((∃ w, PredAt s.mem m.loc tw w ∧ VRes E m.loc w (cr tw)) ∨
      ((∀ w, ¬ PredAt s.mem m.loc tw w) ∧ cr tw = .zero))

/-- The total over the thread's promises. -/
def pSum (s : St) (f : Ts → Res) : Res := Res.sum (s.promises.map f)

theorem sum_map_erase {f : Ts → Res} : ∀ {L : List Ts} {t : Ts}, t ∈ L →
    Res.sum (L.map f) = f t + Res.sum ((L.erase t).map f)
  | [], _, h => by simp at h
  | x :: xs, t, h => by
      by_cases hx : x = t
      · subst hx; simp
      · have ht : t ∈ xs := by
          rcases List.mem_cons.mp h with h | h
          · exact absurd h.symm hx
          · exact h
        rw [List.erase_cons_tail (by simpa using hx)]
        simp only [List.map_cons, Res.sum_cons]
        rw [sum_map_erase ht]
        exact Res.ext fun k => by simp only [Res.add_apply]; omega

/-- Promises unchanged, memory extended past them, Σ unchanged at their
labels: the credits and debits are kept. -/
theorem PromCr_keep {E E' : TEnv} {s s' : St} {cr db : Ts → Res} (h : PromCr E s cr db)
    (hp : s'.promises = s.promises) (hlt : ∀ t, t ∈ s.promises → t < s.mem.size)
    (hm : ∀ t, t < s.mem.size → s'.mem[t]? = s.mem[t]?)
    (hs : ∀ t m, t ∈ s.promises → s.mem[t]? = some m → E'.sto m.loc.label = E.sto m.loc.label)
    (htid : E'.tid = E.tid := by first | rfl | assumption)
    (hpf : ∀ l, E'.pfr l = E.pfr l := by first | exact fun _ => rfl | assumption)
    (hini : ∀ l, E'.ini l = E.ini l := by first | exact fun _ => rfl | assumption)
    (hb : ∀ l B, E.box l = some B → E'.box l = some B := by first | exact fun _ _ h => h | assumption)
    (hrc : ∀ l, E'.rc l = E.rc l := by first | exact fun _ => rfl | assumption) :
    PromCr E' s' cr db := by
  intro tw htw
  rw [hp] at htw
  obtain ⟨m, hm1, hd, hc⟩ := h tw htw
  have hlt' := hlt tw htw
  refine ⟨m, by rw [hm tw hlt']; exact hm1, DbRes_mem hm hlt'
    (DbRes_congr (hs tw m htw hm1) htid (hpf _) (hini _) hb hd (hrc _)), ?_⟩
  rcases hc with ⟨w, hw, hcw⟩ | ⟨hnw, hcz⟩
  · exact Or.inl ⟨w, (PredAt_prefix hm (Nat.le_of_lt hlt')).1 hw,
      (VRes_congr (hs tw m htw hm1) htid (hpf _) (hini _)).2 hcw⟩
  · exact Or.inr ⟨fun w hw => hnw w ((PredAt_prefix hm (Nat.le_of_lt hlt')).2 hw), hcz⟩

/-- A fulfilment removes one promise; memory below it unchanged. -/
theorem PromCr_erase {E E' : TEnv} {s s' : St} {cr db : Ts → Res} {tw : Ts} (h : PromCr E s cr db)
    (hp : s'.promises = s.promises.erase tw) (hlt : ∀ t, t ∈ s.promises → t < s.mem.size)
    (hm : ∀ t, t < s.mem.size → s'.mem[t]? = s.mem[t]?)
    (hs : ∀ t m, t ∈ s.promises → s.mem[t]? = some m → E'.sto m.loc.label = E.sto m.loc.label)
    (htid : E'.tid = E.tid := by first | rfl | assumption)
    (hpf : ∀ l, E'.pfr l = E.pfr l := by first | exact fun _ => rfl | assumption)
    (hini : ∀ l, E'.ini l = E.ini l := by first | exact fun _ => rfl | assumption)
    (hb : ∀ l B, E.box l = some B → E'.box l = some B := by first | exact fun _ _ h => h | assumption)
    (hrc : ∀ l, E'.rc l = E.rc l := by first | exact fun _ => rfl | assumption) :
    PromCr E' s' cr db := by
  intro t ht
  rw [hp] at ht
  have ht0 : t ∈ s.promises := List.mem_of_mem_erase ht
  obtain ⟨m, hm1, hd, hc⟩ := h t ht0
  have hlt' := hlt t ht0
  refine ⟨m, by rw [hm t hlt']; exact hm1, DbRes_mem hm hlt'
    (DbRes_congr (hs t m ht0 hm1) htid (hpf _) (hini _) hb hd (hrc _)), ?_⟩
  rcases hc with ⟨w, hw, hcw⟩ | ⟨hnw, hcz⟩
  · exact Or.inl ⟨w, (PredAt_prefix hm (Nat.le_of_lt hlt')).1 hw,
      (VRes_congr (hs t m ht0 hm1) htid (hpf _) (hini _)).2 hcw⟩
  · exact Or.inr ⟨fun w hw => hnw w ((PredAt_prefix hm (Nat.le_of_lt hlt')).2 hw), hcz⟩

theorem pSum_erase {s s' : St} {f : Ts → Res} {tw : Ts} (hp : s'.promises = s.promises.erase tw)
    (ht : tw ∈ s.promises) : pSum s f = f tw + pSum s' f := by
  unfold pSum; rw [hp]; exact sum_map_erase ht

/-- (P4) Address `a` starts a protocol pair of `P` naming region `n`. -/
def Word2At (E : TEnv) (a : Address) (n : Nat) (P : Proto2) : Prop :=
  ∃ c, E.sto a.label = some c ∧ AtOff c.ty a.offset (.word2 (.lit n) P)

/-- **(P4) What a step from `s` to `s'` may create**:
nothing; the fresh region `region`/`openPub` name (P3); the epoch token
`ep n j` of an epoch counter written at `tw` with `j`, its predecessor (the
message an RMW reads) below `j`; a share `sh n` of a lending word written at
`tw` by a share move up by one from its predecessor's state; the epoch token
`ep n j` of an epoch pair's counter word (`epoch2`: the pair's first word, at
`a`, written by a `casp` bump with `j`, its predecessor below `j`).  Local facts:
once-only is stage B's, from the counters' monotonicity over all messages.
`MintStep g η s s' C F`: the step consumes `C` and creates `F`; only `claim`
(stage A keeps it an exchange) consumes: an epoch token for the region
token. -/
inductive MintStep (g : G) (η : TEnv) (s s' : St) : Res → Res → Prop
  | none : MintStep g η s s' .zero .zero
  | fresh : MintStep g η s s' .zero (Res.one (.rg (ridNext η)) + Res.one (.wd (ridNext η)))
  /-- (F2′) An allocation mints the fresh cell's own-handle key. -/
  | alloc {l : AllocLabel} : FreshIn g s.nalloc s'.nalloc l → η.sto l = none →
      MintStep g η s s' .zero (Res.one (.own l))
  /-- (F2′) A step that spends an own handle (`publish`) consumes its key
  exactly: the key leaves the bound and nothing is minted. -/
  | consume (μ : Mode) (ws : List Word) : MintStep g η s s' (ownW μ ws) .zero
  | epoch {a : Address} {n j v : Nat} {P : Proto} {tw : Ts} {w : Word} {m : Msg} :
      WordAt (CE η) a n P → P.epoch = true → PredAt s'.mem a tw w → w.val = .num v → v < j →
      s'.mem[tw]? = some m → m.loc = a → m.val = .num j → tw ∉ s'.promises →
      MintStep g η s s' .zero (Res.one (.ep n j))
  | share {a : Address} {n c k c' k' v v' : Nat} {P : Proto} {tw : Ts} {w : Word} {m : Msg} :
      WordAt (CE η) a n P → ShareMove P c (.lit k) c' (.lit k') 1 → PredAt s'.mem a tw w →
      w.val = .num v → Enc P c k v → s'.mem[tw]? = some m → m.loc = a → m.val = .num v' →
      Enc P c' k' v' → tw ∉ s'.promises → MintStep g η s s' .zero (Res.one (.sh n))
  | claim (n j : Nat) : MintStep g η s s' (Res.one (.ep n j)) (Res.one (.rg n))
  | epoch2 {a : Address} {n j v : Nat} {P : Proto2} {tw : Ts} {w : Word} {m : Msg} :
      Word2At (CE η) a n P → P.epoch = true → PredAt s'.mem a tw w → w.val = .num v → v < j →
      s'.mem[tw]? = some m → m.loc = a → m.val = .num j → tw ∉ s'.promises →
      MintStep g η s s' .zero (Res.one (.ep n j))

/-- (F2′) A label the thread has yet to allocate is not in Σ. -/
theorem FreshIn_sto {g : G} {E : TEnv} {s : St} {n' : Nat} {l : AllocLabel} (hf : FreshLP g E s)
    (h : FreshIn g s.nalloc n' l) : E.sto l = none := by
  obtain ⟨j, hj, -, rfl⟩ := h
  exact (hf.1 j hj).1

/-- (claim export) `MintStep` without `claim`: the exchange of every step
lemma but the frame steps (`TotStep`) and `claim`. -/
inductive MintStepN (g : G) (η : TEnv) (s s' : St) : Res → Res → Prop
  | none : MintStepN g η s s' .zero .zero
  | fresh : MintStepN g η s s' .zero (Res.one (.rg (ridNext η)) + Res.one (.wd (ridNext η)))
  | alloc {l : AllocLabel} : FreshIn g s.nalloc s'.nalloc l → η.sto l = none →
      MintStepN g η s s' .zero (Res.one (.own l))
  | consume (μ : Mode) (ws : List Word) : MintStepN g η s s' (ownW μ ws) .zero
  | epoch {a : Address} {n j v : Nat} {P : Proto} {tw : Ts} {w : Word} {m : Msg} :
      WordAt (CE η) a n P → P.epoch = true → PredAt s'.mem a tw w → w.val = .num v → v < j →
      s'.mem[tw]? = some m → m.loc = a → m.val = .num j → tw ∉ s'.promises →
      MintStepN g η s s' .zero (Res.one (.ep n j))
  | share {a : Address} {n c k c' k' v v' : Nat} {P : Proto} {tw : Ts} {w : Word} {m : Msg} :
      WordAt (CE η) a n P → ShareMove P c (.lit k) c' (.lit k') 1 → PredAt s'.mem a tw w →
      w.val = .num v → Enc P c k v → s'.mem[tw]? = some m → m.loc = a → m.val = .num v' →
      Enc P c' k' v' → tw ∉ s'.promises → MintStepN g η s s' .zero (Res.one (.sh n))
  | epoch2 {a : Address} {n j v : Nat} {P : Proto2} {tw : Ts} {w : Word} {m : Msg} :
      Word2At (CE η) a n P → P.epoch = true → PredAt s'.mem a tw w → w.val = .num v → v < j →
      s'.mem[tw]? = some m → m.loc = a → m.val = .num j → tw ∉ s'.promises →
      MintStepN g η s s' .zero (Res.one (.ep n j))

theorem MintStepN.toM {g : G} {η : TEnv} {s s' : St} {C F : Res} : MintStepN g η s s' C F → MintStep g η s s' C F
  | .none => .none
  | .fresh => .fresh
  | .alloc h1 h2 => .alloc h1 h2
  | .consume μ ws => .consume μ ws
  | .epoch h1 h2 h3 h4 h5 h6 h7 h8 h9 => .epoch h1 h2 h3 h4 h5 h6 h7 h8 h9
  | .share h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 => .share h1 h2 h3 h4 h5 h6 h7 h8 h9 h10
  | .epoch2 h1 h2 h3 h4 h5 h6 h7 h8 h9 => .epoch2 h1 h2 h3 h4 h5 h6 h7 h8 h9

/-- **(claim export) A claim-shaped exchange happens only at a `claim` term**
(the K-net: no `rg n` is minted elsewhere). -/
def ClaimAt (t : Expr) (C F : Res) : Prop :=
  ∀ n j, C = Res.one (.ep n j) → F = Res.one (.rg n) → ∃ x w tk e, t = .let_ x (.claim w tk) e

theorem ownW_cases (μ : Mode) (ws : List Word) : ownW μ ws = .zero ∨ ∃ l, ownW μ ws = .one (.own l) := by
  unfold ownW
  split
  · exact Or.inr ⟨_, rfl⟩
  · exact Or.inl rfl

theorem ClaimAt_zero (t : Expr) (F : Res) : ClaimAt t .zero F :=
  fun _ _ hC _ => absurd hC.symm (Res.one_ne_zero _)

theorem MintStepN.claimAt {g : G} {η : TEnv} {s s' : St} {C F : Res} (h : MintStepN g η s s' C F) (t : Expr) :
    ClaimAt t C F := by
  intro n j hC _hF
  exfalso
  have hk : C (.ep n j) = 0 := by
    cases h <;> first | rfl | (rename_i a b; first | rcases ownW_cases a b with e | ⟨l, e⟩ <;> rw [e] <;> simp | rcases ownW_cases b a with e | ⟨l, e⟩ <;> rw [e] <;> simp)
  rw [hC] at hk
  simp at hk

/-- (route B) The step at a `publish` consumes the published cell's own key. -/
def PubCons (th : TTh) (C : Res) : Prop :=
  ∀ y a e rt ws ad, th.term = .let_ y (.publish a) e → evalAt th.env a = some (rt, ws) →
    ws.map (·.val) = [.loc ad 0] → 1 ≤ C (.own ad.label)

/-- (route B) `ClaimAt` together with `PubCons`. -/
def ClaimAtP (th : TTh) (C F : Res) : Prop := ClaimAt th.term C F ∧ PubCons th C

theorem PubCons_of_not {th : TTh} {C : Res} (h : ∀ x a e, th.term ≠ .let_ x (.publish a) e) : PubCons th C :=
  fun y a e _ _ _ ht _ _ => absurd ht (h y a e)

theorem ClaimAtP.of_not {th : TTh} {C F : Res} (hc : ClaimAt th.term C F)
    (h : ∀ x a e, th.term ≠ .let_ x (.publish a) e) : ClaimAtP th C F :=
  ⟨hc, PubCons_of_not h⟩

theorem OwnOpT_npub {cx : Cx} {t : Expr} (h : OwnOpT cx t) : ∀ x a e, t ≠ .let_ x (.publish a) e := by
  intro x a e ht
  subst ht
  unfold OwnOpT OwnRMWT at h
  simp at h

theorem claimP_map6 {α : Type} {L : List α} {th : TTh} {A : α → Prop}
    {I : α → Res → Res → Res → Res → (Ts → Res) → (Ts → Res) → Prop} {M : α → Res → Res → Prop}
    {R : α → Res → Res → Res → Res → (Ts → Res) → (Ts → Res) → Prop}
    (hnp : ∀ x a e, th.term ≠ .let_ x (.publish a) e)
    (h : L ≠ [] ∧ ∀ r ∈ L, A r → ∃ Tot H' C F cr' db',
      I r Tot H' C F cr' db' ∧ M r C F ∧ ClaimAt th.term C F ∧ R r Tot H' C F cr' db') :
    L ≠ [] ∧ ∀ r ∈ L, A r → ∃ Tot H' C F cr' db',
      I r Tot H' C F cr' db' ∧ M r C F ∧ ClaimAtP th C F ∧ R r Tot H' C F cr' db' :=
  ⟨h.1, fun r hr ha => let ⟨Tot, H', C, F, cr', db', h1, h2, h3, h4⟩ := h.2 r hr ha
    ⟨Tot, H', C, F, cr', db', h1, h2, ClaimAtP.of_not h3 hnp, h4⟩⟩

theorem claimP_mapQ7 {α γ : Type} {L : List α} {th : TTh} {A B : α → Prop}
    {I : α → Res → Res → Res → Res → (Ts → Res) → (Ts → Res) → γ → Prop} {M : α → Res → Res → Prop}
    {R : α → Res → Res → Res → Res → (Ts → Res) → (Ts → Res) → γ → Prop}
    (hnp : ∀ x a e, th.term ≠ .let_ x (.publish a) e)
    (h : L ≠ [] ∧ ∀ r ∈ L, A r → B r → ∃ Tot H' C F cr' db' Gd,
      I r Tot H' C F cr' db' Gd ∧ M r C F ∧ ClaimAt th.term C F ∧ R r Tot H' C F cr' db' Gd) :
    L ≠ [] ∧ ∀ r ∈ L, A r → B r → ∃ Tot H' C F cr' db' Gd,
      I r Tot H' C F cr' db' Gd ∧ M r C F ∧ ClaimAtP th C F ∧ R r Tot H' C F cr' db' Gd :=
  ⟨h.1, fun r hr ha hb => let ⟨Tot, H', C, F, cr', db', Gd, h1, h2, h3, h4⟩ := h.2 r hr ha hb
    ⟨Tot, H', C, F, cr', db', Gd, h1, h2, ClaimAtP.of_not h3 hnp, h4⟩⟩

/-- (F2′) A step mints an own-handle key only at a label not yet in Σ. -/
theorem MintStep_own_sto {g : G} {η : TEnv} {s s' : St} {C F : Res} (h : MintStep g η s s' C F) {l : AllocLabel}
    (hl : F (.own l) ≠ 0) : η.sto l = none := by
  cases h with
  | alloc hf hs =>
      rename_i l'
      by_cases e : l' = l
      · subst e; exact hs
      · exact absurd (by simp [Ne.symm e]) hl
  | _ => exact absurd (by simp) hl

/-- (P4, stage B) An epoch counter's message values grow with their
timestamps (not preservable per thread, since other
threads may write above an own promise; stage B states it over all messages). -/
def EpochMono (E : TEnv) (s : St) : Prop :=
  ∀ (a : Address) (n : Nat) (P : Proto) (t t' : Ts) (m m' : Msg) (v v' : Nat), WordAt E a n P → P.epoch = true → t < t' → t ∉ s.promises →
    t' ∉ s.promises → s.mem[t]? = some m → s.mem[t']? = some m' → m.loc = a → m'.loc = a →
    m.val = .num v → m'.val = .num v' → v ≤ v'

theorem sum_map_zero {α : Type} : ∀ L : List α, Res.sum (L.map fun _ => Res.zero) = Res.zero
  | [] => rfl
  | _ :: xs => by simp only [List.map_cons, Res.sum_cons, Res.zero_add]; exact sum_map_zero xs

/-- (P4) Memory holding nothing: Σ's cells all hold `.zero`. -/
theorem MemHeld_zero_of {E : TEnv} {s : St} (L : List AllocLabel) (hnd : L.Nodup)
    (hc : ∀ l c, E.sto l = some c → l ∈ L)
    (hv : ∀ l c, E.sto l = some c → ∃ vals, (∀ o w, vals[o]? = some w → LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w) ∧
      CellOKR E (E.ini l) (E.rc l) c.ty vals .zero) : MemHeld E s .zero := by
  refine ⟨L, fun _ => .zero, hnd, hc, (sum_map_zero L).symm, fun l _ => ⟨fun _ => rfl, fun c h => hv l c h⟩⟩

/-! ### (P4 step 2) Memory holdings: infrastructure -/

/-- (P4) Label `l`'s entry in memory's holding: `R`, the resources of the
cell's latest words (none for a label outside Σ). -/
def HeldEntry (E : TEnv) (s : St) (l : AllocLabel) (R : Res) : Prop :=
  (E.sto l = none → R = .zero) ∧
    ∀ c, E.sto l = some c → ∃ vals, (∀ o w, vals[o]? = some w → LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w) ∧
      CellOKR E (E.ini l) (E.rc l) c.ty vals R

/-- (P4) `MemHeld` without label `l`. -/
def MemHeldX (E : TEnv) (s : St) (l : AllocLabel) (H : Res) : Prop :=
  ∃ (L : List AllocLabel) (Rl : AllocLabel → Res), L.Nodup ∧ l ∉ L ∧
    (∀ l' c, l' ≠ l → E.sto l' = some c → l' ∈ L) ∧ H = Res.sum (L.map Rl) ∧
    ∀ l', l' ∈ L → HeldEntry E s l' (Rl l')

theorem Res.sum_map_cons_mid {α : Type} (f : α → Res) (x : α) :
    ∀ L1 L2 : List α, Res.sum ((L1 ++ x :: L2).map f) = f x + Res.sum ((L1 ++ L2).map f)
  | [], L2 => by simp
  | y :: L1, L2 => by
      simp only [List.cons_append, List.map_cons, Res.sum_cons]
      rw [Res.sum_map_cons_mid f x L1 L2, ← Res.add_assoc, ← Res.add_assoc, Res.add_comm (f y) (f x)]

/-- (P4) Focus on label `l`: memory's holding is `l`'s entry plus the rest. -/
theorem MemHeld_focus {E : TEnv} {s : St} {H : Res} (h : MemHeld E s H) (l : AllocLabel) :
    ∃ R0 H0, H = R0 + H0 ∧ HeldEntry E s l R0 ∧ MemHeldX E s l H0 := by
  obtain ⟨L, Rl, hnd, hcov, rfl, hent⟩ := h
  by_cases hl : l ∈ L
  · obtain ⟨L1, L2, rfl⟩ := List.append_of_mem hl
    have hnd' : (L1 ++ L2).Nodup := List.Nodup.sublist (by simp) hnd
    have hnl : l ∉ L1 ++ L2 := by
      intro hm
      rw [List.nodup_append] at hnd
      rcases List.mem_append.1 hm with h1 | h2
      · exact hnd.2.2 l h1 l (by simp) rfl
      · exact (List.nodup_cons.1 hnd.2.1).1 h2
    refine ⟨Rl l, Res.sum ((L1 ++ L2).map Rl), Res.sum_map_cons_mid Rl l L1 L2, hent l hl,
      L1 ++ L2, Rl, hnd', hnl, fun l' c hne hc => ?_, rfl, fun l' hl' => hent l' ?_⟩
    · have := hcov l' c hc
      simp only [List.mem_append, List.mem_cons] at this ⊢
      rcases this with h | h | h
      · exact Or.inl h
      · exact absurd h hne
      · exact Or.inr h
    · simp only [List.mem_append, List.mem_cons] at hl' ⊢
      rcases hl' with h | h
      · exact Or.inl h
      · exact Or.inr (Or.inr h)
  · have hnone : E.sto l = none := by
      cases hc : E.sto l with
      | none => rfl
      | some c => exact absurd (hcov l c hc) hl
    refine ⟨.zero, Res.sum (L.map Rl), (Res.zero_add _).symm, ⟨fun _ => rfl, fun c hc => ?_⟩,
      L, Rl, hnd, hl, fun l' c hne hc => hcov l' c hc, rfl, hent⟩
    rw [hnone] at hc; cases hc

/-- (P4) Put label `l`'s entry back. -/
theorem MemHeld_unfocus {E : TEnv} {s : St} {l : AllocLabel} {R H0 : Res} (hX : MemHeldX E s l H0)
    (he : HeldEntry E s l R) : MemHeld E s (R + H0) := by
  obtain ⟨L, Rl, hnd, hnl, hcov, rfl, hent⟩ := hX
  classical
  refine ⟨l :: L, fun l' => if l' = l then R else Rl l', List.nodup_cons.2 ⟨hnl, hnd⟩, fun l' c hc => ?_, ?_,
    fun l' hl' => ?_⟩
  · by_cases h : l' = l
    · exact h ▸ List.mem_cons_self
    · exact List.mem_cons_of_mem _ (hcov l' c h hc)
  · simp only [List.map_cons, Res.sum_cons, ite_true]
    congr 1
    refine congrArg Res.sum (List.map_congr_left fun l' hl' => ?_)
    have : l' ≠ l := fun e => hnl (e ▸ hl')
    simp [this]
  · by_cases h : l' = l
    · show HeldEntry E s l' (if l' = l then R else Rl l')
      rw [ite_eq_left_iff.mpr (fun hn => absurd h hn)]; subst h; exact he
    · have : l' ∈ L := by simpa [h] using hl'
      show HeldEntry E s l' (if l' = l then R else Rl l')
      rw [ite_eq_right_iff.mpr (fun hn => absurd hn h)]; exact hent l' this


/-! ## (H, pins) Memory's holding with its slot lists exposed

`MemHeldL E s H S` is `MemHeld` whose buffer entries are counted slot by slot along the
explicit lists `S l` (a non-buffer cell: a one-element list). A pin (`PinOK`) fixes chosen
slots' shares; `MemHeld ↔ ∃ S, MemHeldL`. -/

/-- (H, pins) `BufOKR` with its slot list `Rs` as a parameter. -/
def BufR (η : TEnv) (n nr : Nat) (T : Ty) (vals : List Word) (Rs : List Res) : Prop :=
  ∃ N e us, T = .array (.lit N) e ∧ accs e = some us ∧ n ≤ N ∧ vals.length = N * nWords us ∧
    Rs.length = n ∧
    ∀ j Rj, j < n → Rs[j]? = some Rj →
      (nr ≤ j → nWords us = 0 → Rj = .zero) ∧
      (j < nr ∨ 0 < nWords us → ValOfR η e ((vals.drop (j * nWords us)).take (nWords us)) Rj)

theorem BufOKR_iff {η : TEnv} {n nr : Nat} {T : Ty} {vals : List Word} {R : Res} :
    BufOKR η n nr T vals R ↔ ∃ Rs, BufR η n nr T vals Rs ∧ R = Res.sum Rs := by
  constructor
  · rintro ⟨N, e, us, Rs, h1, h2, h3, h4, h5, h6, h7⟩
    exact ⟨Rs, ⟨N, e, us, h1, h2, h3, h4, h5, h7⟩, h6⟩
  · rintro ⟨Rs, ⟨N, e, us, h1, h2, h3, h4, h5, h7⟩, h6⟩
    exact ⟨N, e, us, Rs, h1, h2, h3, h4, h5, h6, h7⟩
#print axioms BufOKR_iff

/-- (H, pins) `CellOKR` with its slot list: a whole value (one share) or a buffer. -/
def CellR (η : TEnv) (n nr : Nat) (T : Ty) (vals : List Word) (Rs : List Res) : Prop :=
  (wc T = some vals.length ∧ ∃ R, ValOfR η T vals R ∧ Rs = [R]) ∨ BufR η n nr T vals Rs

theorem CellOKR_iff {η : TEnv} {n nr : Nat} {T : Ty} {vals : List Word} {R : Res} :
    CellOKR η n nr T vals R ↔ ∃ Rs, CellR η n nr T vals Rs ∧ R = Res.sum Rs := by
  constructor
  · rintro (⟨h1, h2⟩ | h)
    · exact ⟨[R], Or.inl ⟨h1, R, h2, rfl⟩, by simp⟩
    · obtain ⟨Rs, h, e⟩ := BufOKR_iff.1 h
      exact ⟨Rs, Or.inr h, e⟩
  · rintro ⟨Rs, ⟨h1, R', h2, rfl⟩ | h, e⟩
    · simp only [Res.sum_cons, Res.sum_nil, Res.add_zero] at e
      subst e; exact Or.inl ⟨h1, h2⟩
    · exact Or.inr (BufOKR_iff.2 ⟨Rs, h, e⟩)
#print axioms CellOKR_iff

/-- (H, pins) Label `l`'s entry, slot by slot. -/
def HeldEntryL (E : TEnv) (s : St) (l : AllocLabel) (Rs : List Res) : Prop :=
  (E.sto l = none → Rs = []) ∧
    ∀ c, E.sto l = some c → ∃ vals, (∀ o w, vals[o]? = some w → LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w) ∧
      CellR E (E.ini l) (E.rc l) c.ty vals Rs

theorem HeldEntryL.entry {E : TEnv} {s : St} {l : AllocLabel} {Rs : List Res} (h : HeldEntryL E s l Rs) :
    HeldEntry E s l (Res.sum Rs) := by
  refine ⟨fun hn => by rw [h.1 hn]; rfl, fun c hc => ?_⟩
  obtain ⟨vals, hL, hC⟩ := h.2 c hc
  exact ⟨vals, hL, CellOKR_iff.2 ⟨Rs, hC, rfl⟩⟩
#print axioms HeldEntryL.entry

theorem HeldEntry.toS {E : TEnv} {s : St} {l : AllocLabel} {R : Res} (h : HeldEntry E s l R) :
    ∃ Rs, HeldEntryL E s l Rs ∧ R = Res.sum Rs := by
  cases hc : E.sto l with
  | none => exact ⟨[], ⟨fun _ => rfl, fun c h' => by rw [hc] at h'; cases h'⟩, h.1 hc⟩
  | some c =>
    obtain ⟨vals, hL, hC⟩ := h.2 c hc
    obtain ⟨Rs, hR, e⟩ := CellOKR_iff.1 hC
    refine ⟨Rs, ⟨fun h' => (by rw [hc] at h'; cases h'), fun c' hc' => ?_⟩, e⟩
    rw [hc] at hc'; cases hc'
    exact ⟨vals, hL, hR⟩
#print axioms HeldEntry.toS

/-- (H, pins) **Memory's holding, slot lists `S`**: the labels `L` cover the store, each
holds its entry along `S l`, and labels off `L` have empty lists. -/
def MemHeldL (E : TEnv) (s : St) (H : Res) (S : AllocLabel → List Res) : Prop :=
  ∃ L : List AllocLabel, L.Nodup ∧ (∀ l c, E.sto l = some c → l ∈ L) ∧ (∀ l, l ∉ L → S l = []) ∧
    H = Res.sum (L.map fun l => Res.sum (S l)) ∧ ∀ l, l ∈ L → HeldEntryL E s l (S l)

/-- (H, pins) `MemHeldL` without label `l` (whose list is not constrained). -/
def MemHeldXL (E : TEnv) (s : St) (l : AllocLabel) (H : Res) (S : AllocLabel → List Res) : Prop :=
  ∃ L : List AllocLabel, L.Nodup ∧ l ∉ L ∧ (∀ l' c, l' ≠ l → E.sto l' = some c → l' ∈ L) ∧
    (∀ l', l' ≠ l → l' ∉ L → S l' = []) ∧
    H = Res.sum (L.map fun l' => Res.sum (S l')) ∧ ∀ l', l' ∈ L → HeldEntryL E s l' (S l')

/-- (H, pins) Replace label `l`'s slot list. -/
def updS (S : AllocLabel → List Res) (l : AllocLabel) (Rs : List Res) : AllocLabel → List Res :=
  fun l' => if l' = l then Rs else S l'

@[simp] theorem updS_self (S : AllocLabel → List Res) (l : AllocLabel) (Rs : List Res) : updS S l Rs l = Rs := by
  simp [updS]

theorem updS_other (S : AllocLabel → List Res) {l l' : AllocLabel} (Rs : List Res) (h : l' ≠ l) :
    updS S l Rs l' = S l' := by
  simp [updS, h]

theorem MemHeldL.memHeld {E : TEnv} {s : St} {H : Res} {S : AllocLabel → List Res} (h : MemHeldL E s H S) :
    MemHeld E s H := by
  obtain ⟨L, hnd, hcov, -, rfl, hent⟩ := h
  refine ⟨L, fun l => Res.sum (S l), hnd, hcov, rfl, fun l hl => ⟨(hent l hl).entry.1, (hent l hl).entry.2⟩⟩
#print axioms MemHeldL.memHeld

theorem MemHeld.toS {E : TEnv} {s : St} {H : Res} (h : MemHeld E s H) : ∃ S, MemHeldL E s H S := by
  classical
  obtain ⟨L, Rl, hnd, hcov, rfl, hent⟩ := h
  have hx : ∀ l, ∃ Rs : List Res, (l ∈ L → HeldEntryL E s l Rs ∧ Rl l = Res.sum Rs) ∧ (l ∉ L → Rs = []) :=
    fun l => by
      by_cases hl : l ∈ L
      · obtain ⟨Rs, h1, h2⟩ := HeldEntry.toS ⟨(hent l hl).1, (hent l hl).2⟩
        exact ⟨Rs, fun _ => ⟨h1, h2⟩, fun h' => absurd hl h'⟩
      · exact ⟨[], fun h' => absurd h' hl, fun _ => rfl⟩
  let S : AllocLabel → List Res := fun l => Classical.choose (hx l)
  have hS : ∀ l, l ∈ L → HeldEntryL E s l (S l) ∧ Rl l = Res.sum (S l) := fun l hl =>
    (Classical.choose_spec (hx l)).1 hl
  refine ⟨S, L, hnd, hcov, fun l hl => (Classical.choose_spec (hx l)).2 hl, ?_, fun l hl => (hS l hl).1⟩
  exact congrArg Res.sum (List.map_congr_left fun l hl => (hS l hl).2)
#print axioms MemHeld.toS

theorem MemHeld_iffS {E : TEnv} {s : St} {H : Res} : MemHeld E s H ↔ ∃ S, MemHeldL E s H S :=
  ⟨MemHeld.toS, fun ⟨_, h⟩ => h.memHeld⟩
#print axioms MemHeld_iffS

/-- (H, pins) Focus on label `l`: its entry along `S l`, plus the rest. -/
theorem MemHeldL_focus {E : TEnv} {s : St} {H : Res} {S : AllocLabel → List Res} (h : MemHeldL E s H S)
    (l : AllocLabel) :
    ∃ H0, H = Res.sum (S l) + H0 ∧ HeldEntryL E s l (S l) ∧ MemHeldXL E s l H0 S := by
  obtain ⟨L, hnd, hcov, hoff, rfl, hent⟩ := h
  by_cases hl : l ∈ L
  · obtain ⟨L1, L2, rfl⟩ := List.append_of_mem hl
    have hnd' : (L1 ++ L2).Nodup := List.Nodup.sublist (by simp) hnd
    have hnl : l ∉ L1 ++ L2 := by
      intro hm
      rw [List.nodup_append] at hnd
      rcases List.mem_append.1 hm with h1 | h2
      · exact hnd.2.2 l h1 l (by simp) rfl
      · exact (List.nodup_cons.1 hnd.2.1).1 h2
    refine ⟨Res.sum ((L1 ++ L2).map fun l' => Res.sum (S l')),
      Res.sum_map_cons_mid (fun l' => Res.sum (S l')) l L1 L2, hent l hl,
      L1 ++ L2, hnd', hnl, fun l' c hne hc => ?_, fun l' hne hn => hoff l' ?_, rfl, fun l' hl' => hent l' ?_⟩
    · have := hcov l' c hc
      simp only [List.mem_append, List.mem_cons] at this ⊢
      rcases this with h | h | h
      · exact Or.inl h
      · exact absurd h hne
      · exact Or.inr h
    · simp only [List.mem_append, List.mem_cons, not_or] at hn ⊢
      exact ⟨hn.1, hne, hn.2⟩
    · simp only [List.mem_append, List.mem_cons] at hl' ⊢
      rcases hl' with h | h
      · exact Or.inl h
      · exact Or.inr (Or.inr h)
  · have hnone : E.sto l = none := by
      cases hc : E.sto l with
      | none => rfl
      | some c => exact absurd (hcov l c hc) hl
    refine ⟨Res.sum (L.map fun l' => Res.sum (S l')), by rw [hoff l hl]; simp,
      ⟨fun _ => hoff l hl, fun c hc => ?_⟩,
      L, hnd, hl, fun l' c _ hc => hcov l' c hc, fun l' _ hn => hoff l' hn, rfl, hent⟩
    rw [hnone] at hc; cases hc
#print axioms MemHeldL_focus

/-- (H, pins) Put label `l`'s entry back, along a new list `Rs`. -/
theorem MemHeldL_unfocus {E : TEnv} {s : St} {l : AllocLabel} {H0 : Res} {S : AllocLabel → List Res}
    {Rs : List Res} (hX : MemHeldXL E s l H0 S) (he : HeldEntryL E s l Rs) :
    MemHeldL E s (Res.sum Rs + H0) (updS S l Rs) := by
  obtain ⟨L, hnd, hnl, hcov, hoff, rfl, hent⟩ := hX
  have hne : ∀ l', l' ∈ L → l' ≠ l := fun l' h e => hnl (e ▸ h)
  refine ⟨l :: L, List.nodup_cons.2 ⟨hnl, hnd⟩, fun l' c hc => ?_, fun l' hn => ?_, ?_, fun l' hl' => ?_⟩
  · by_cases h : l' = l
    · exact h ▸ List.mem_cons_self
    · exact List.mem_cons_of_mem _ (hcov l' c h hc)
  · simp only [List.mem_cons, not_or] at hn
    rw [updS_other S Rs hn.1]; exact hoff l' hn.1 hn.2
  · simp only [List.map_cons, Res.sum_cons, updS_self]
    congr 1
    exact congrArg Res.sum (List.map_congr_left fun l' hl' => by rw [updS_other S Rs (hne l' hl')])
  · rcases List.mem_cons.1 hl' with rfl | h
    · rw [updS_self]; exact he
    · rw [updS_other S Rs (hne l' h)]; exact hent l' h
#print axioms MemHeldL_unfocus

/-- (H, pins) The cover sum: memory's holding is the sum of the covered labels' lists. -/
theorem MemHeldL.cover {E : TEnv} {s : St} {H : Res} {S : AllocLabel → List Res} (h : MemHeldL E s H S) :
    ∃ L : List AllocLabel, L.Nodup ∧ (∀ l c, E.sto l = some c → l ∈ L) ∧ (∀ l, l ∉ L → S l = []) ∧
      (∀ l, l ∈ L → HeldEntryL E s l (S l)) ∧ H = Res.sum (L.map fun l => Res.sum (S l)) :=
  let ⟨L, h1, h2, h3, h4, h5⟩ := h
  ⟨L, h1, h2, h3, h5, h4⟩
#print axioms MemHeldL.cover

/-- (H, pins) **Pins**: the pinned slots' shares in the lists `S`. -/
def PinOK (S : AllocLabel → List Res) (pin : AllocLabel → Nat → Option Res) : Prop :=
  ∀ l j R, pin l j = some R → (S l)[j]? = some R

/-- (H, pins) Memory's holding with every pin respected. -/
def MemHeldPin (E : TEnv) (s : St) (H : Res) (pin : AllocLabel → Nat → Option Res) : Prop :=
  ∃ S, MemHeldL E s H S ∧ PinOK S pin

/-- (H, pins) A step's lists agree off its touched slots `T`. -/
def SFrame (S S' : AllocLabel → List Res) (T : AllocLabel → Nat → Prop) : Prop :=
  ∀ l j, ¬ T l j → (S' l)[j]? = (S l)[j]?

theorem PinOK_frame {S S' : AllocLabel → List Res} {pin : AllocLabel → Nat → Option Res}
    {T : AllocLabel → Nat → Prop} (hp : PinOK S pin) (hf : SFrame S S' T)
    (hT : ∀ l j R, pin l j = some R → ¬ T l j) : PinOK S' pin :=
  fun l j R h => by rw [hf l j (hT l j R h)]; exact hp l j R h
#print axioms PinOK_frame

theorem SFrame_updS {S : AllocLabel → List Res} {l : AllocLabel} {Rs : List Res} {T : AllocLabel → Nat → Prop}
    (h : ∀ j, ¬ T l j → Rs[j]? = (S l)[j]?) : SFrame S (updS S l Rs) T := fun l' j hj => by
  by_cases e : l' = l
  · subst e; rw [updS_self]; exact h j hj
  · rw [updS_other S Rs e]
#print axioms SFrame_updS

/-- (P4) Moving the rest of memory's holding to a new view and state that
agree with the old ones away from `l`. -/
theorem MemHeldX_tr {E E' : TEnv} {s s' : St} {l : AllocLabel} {H : Res} (h : MemHeldX E s l H)
    (hsto : ∀ l', l' ≠ l → E'.sto l' = E.sto l') (hini : ∀ l', l' ≠ l → E'.ini l' = E.ini l')
    (hlat : ∀ l', l' ≠ l → ∀ o w, LatestNP s.mem (PromAt E s ⟨l', o⟩) ⟨l', o⟩ w →
      LatestNP s'.mem (PromAt E s' ⟨l', o⟩) ⟨l', o⟩ w)
    (hv : ∀ {T : Ty} {vs : List Word} {R : Res}, ValOfR E T vs R → ValOfR E' T vs R)
    (htid : E'.tid = E.tid := by first | rfl | assumption)
    (hpf : ∀ l', l' ≠ l → E'.pfr l' = E.pfr l' := by first | exact fun _ _ => rfl | assumption)
    (hfp : E'.fp = E.fp := by first | rfl | assumption)
    (hri : ∀ l', l' ≠ l → E'.rini l' = E.rini l' := by
      first | exact fun _ _ => rfl | assumption | exact fun l' h => bumpIni_other _ _ _ l' h) :
    MemHeldX E' s' l H := by
  obtain ⟨L, Rl, hnd, hnl, hcov, rfl, hent⟩ := h
  have hne : ∀ l', l' ∈ L → l' ≠ l := fun l' hl' e => hnl (e ▸ hl')
  refine ⟨L, Rl, hnd, hnl, fun l' c hn hc => hcov l' c hn (by rw [← hsto l' hn]; exact hc), rfl,
    fun l' hl' => ?_⟩
  obtain ⟨h0, h1⟩ := hent l' hl'
  refine ⟨fun hn => h0 (by rw [← hsto l' (hne l' hl')]; exact hn), fun c hc => ?_⟩
  obtain ⟨vals, hL, hC⟩ := h1 c (by rw [← hsto l' (hne l' hl')]; exact hc)
  refine ⟨vals, fun o w hw => by
    rw [PromAt_congr (a := ⟨l', o⟩) (hsto l' (hne l' hl')) htid (hpf l' (hne l' hl')) hfp
      (hini l' (hne l' hl')) (TEnv.rc_congr (hini l' (hne l' hl')) (hri l' (hne l' hl')))]
    exact hlat l' (hne l' hl') o w (hL o w hw), ?_⟩
  rw [hini l' (hne l' hl')]
  rcases hC with ⟨h1, h2⟩ | ⟨N, e, us, Rs, hT, hu, hn, hl, hRs, hR, hj⟩
  · exact Or.inl ⟨h1, hv h2⟩
  · exact Or.inr ⟨N, e, us, Rs, hT, hu, hn, hl, hRs, hR, fun j Rj h1 h2 =>
      slotR_imp (hj j Rj h1 h2) (TEnv.rc_congr (hini l' (hne l' hl')) (hri l' (hne l' hl'))) hv⟩

/-- (P4) Moving memory's holding to a new view and state that agree on Σ,
`ini` and every cell's latest words. -/
theorem MemHeld_tr {E E' : TEnv} {s s' : St} {H : Res} (h : MemHeld E s H)
    (hsto : ∀ l, E'.sto l = E.sto l) (hini : ∀ l, E'.ini l = E.ini l)
    (hlat : ∀ l o w, LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w → LatestNP s'.mem (PromAt E s' ⟨l, o⟩) ⟨l, o⟩ w)
    (hv : ∀ {T : Ty} {vs : List Word} {R : Res}, ValOfR E T vs R → ValOfR E' T vs R)
    (htid : E'.tid = E.tid := by first | rfl | assumption)
    (hpf : ∀ l, E'.pfr l = E.pfr l := by first | exact fun _ => rfl | assumption)
    (hfp : E'.fp = E.fp := by first | rfl | assumption)
    (hri : ∀ l, E'.rini l = E.rini l := by first | exact fun _ => rfl | assumption) :
    MemHeld E' s' H := by
  obtain ⟨L, Rl, hnd, hcov, rfl, hent⟩ := h
  refine ⟨L, Rl, hnd, fun l c hc => hcov l c (by rw [← hsto l]; exact hc), rfl, fun l hl => ?_⟩
  obtain ⟨h0, h1⟩ := hent l hl
  refine ⟨fun hn => h0 (by rw [← hsto l]; exact hn), fun c hc => ?_⟩
  obtain ⟨vals, hL, hC⟩ := h1 c (by rw [← hsto l]; exact hc)
  refine ⟨vals, fun o w hw => by
    rw [PromAt_congr (a := ⟨l, o⟩) (hsto l) htid (hpf l) hfp (hini l) (TEnv.rc_congr (hini l) (hri l))]
    exact hlat l o w (hL o w hw), ?_⟩
  rw [hini l]
  rcases hC with ⟨h1, h2⟩ | ⟨N, e, us, Rs, hT, hu, hn, hl, hRs, hR, hj⟩
  · exact Or.inl ⟨h1, hv h2⟩
  · exact Or.inr ⟨N, e, us, Rs, hT, hu, hn, hl, hRs, hR, fun j Rj h1 h2 =>
      slotR_imp (hj j Rj h1 h2) (TEnv.rc_congr (hini l) (hri l)) hv⟩

/-- (P4) Memory's holding reads only memory and the promises. -/
theorem MemHeld_eqs {E : TEnv} {s s' : St} {H : Res} (h : MemHeld E s H) (e1 : s'.mem = s.mem)
    (e2 : s'.promises = s.promises) : MemHeld E s' H :=
  MemHeld_tr h (fun _ => rfl) (fun _ => rfl) (fun _ _ _ hl => by rw [e1, PromAt_eqp e2]; exact hl) id


/-! ### (H, pins) Keeping the pinned region across an own step

A pin sits at a predicted slot of a buffer (a designated slot is predicted, `PredU`: so
not below the real count, `PredU_slot_ge`).  An own step keeps every such slot's share (`SKeep`): its
component writes go below `rc`, whole-cell writes go to non-buffer cells. -/

/-- (H, pins) Every predicted slot (its start a predicted unit, `PredU`) keeps its share. -/
def SKeep (E : TEnv) (S S' : AllocLabel → List Res) : Prop :=
  ∀ l c N e us j R, E.sto l = some c → c.ty = .array (.lit N) e → accs e = some us →
    PredU E ⟨l, j * nWords us⟩ → (S l)[j]? = some R → (S' l)[j]? = some R

theorem SKeep_refl (E : TEnv) (S : AllocLabel → List Res) : SKeep E S S :=
  fun _ _ _ _ _ _ _ _ _ _ _ h => h
#print axioms SKeep_refl

theorem SKeep_of_eq {E : TEnv} {S S' : AllocLabel → List Res} (h : ∀ l, S' l = S l) : SKeep E S S' :=
  fun l _ _ _ _ _ _ _ _ _ _ hR => by rw [h l]; exact hR
#print axioms SKeep_of_eq

theorem SKeep_trans {E E' : TEnv} {S S' S'' : AllocLabel → List Res} (h1 : SKeep E S S') (h2 : SKeep E' S' S'')
    (hs : ∀ l c, E.sto l = some c → E'.sto l = some c) (hp : ∀ a, PredU E a → PredU E' a) : SKeep E S S'' :=
  fun l c N e us j R hc hT hu hj hR =>
    h2 l c N e us j R (hs l c hc) hT hu (hp _ hj) (h1 l c N e us j R hc hT hu hj hR)
#print axioms SKeep_trans

/-- (H, pins) A predicted slot lies at or above the real count. -/
theorem PredU_slot_ge {E : TEnv} {l : AllocLabel} {c : Cell} {N : Nat} {e : Ty} {us : List Acc} {j : Nat}
    (hc : E.sto l = some c) (hT : c.ty = .array (.lit N) e) (hu : accs e = some us)
    (h : PredU E ⟨l, j * nWords us⟩) : E.rc l ≤ j := by
  have hnr := h.2.2
  apply Nat.le_of_not_lt; intro hlt
  apply hnr; intro c' N' e' us' hc' hT' hu'
  rw [hc] at hc'; cases hc'
  rw [hT] at hT'; simp only [Ty.array.injEq, Idx.lit.injEq] at hT'
  obtain ⟨-, rfl⟩ := hT'; rw [hu] at hu'; cases hu'
  show j * nWords us < E.rc l * nWords us
  have hw : 0 < nWords us := by
    have := h.2.1 c N e us hc hT hu
    show 0 < nWords us
    cases h0 : nWords us with
    | zero => rw [h0, Nat.mul_zero] at this; exact absurd this (Nat.lt_irrefl _)
    | succ _ => exact Nat.succ_pos _
  exact Nat.mul_lt_mul_of_pos_right hlt hw
#print axioms PredU_slot_ge

/-- (H, pins) Replacing label `l`'s list keeps the region when the new list agrees at the
predicted slots. -/
theorem SKeep_updS {E : TEnv} {S : AllocLabel → List Res} {l : AllocLabel} {Rs : List Res}
    (h : ∀ c N e us j R, E.sto l = some c → c.ty = .array (.lit N) e → accs e = some us →
      PredU E ⟨l, j * nWords us⟩ → (S l)[j]? = some R → Rs[j]? = some R) : SKeep E S (updS S l Rs) :=
  fun l' c N e us j R hc hT hu hj hR => by
    by_cases e' : l' = l
    · subst e'; rw [updS_self]; exact h c N e us j R hc hT hu hj hR
    · rw [updS_other S Rs e']; exact hR
#print axioms SKeep_updS

/-- (H, pins) Setting one slot below the real count (or of a non-buffer cell). -/
theorem SKeep_set {E : TEnv} {S : AllocLabel → List Res} {l : AllocLabel} {k : Nat} {R' : Res}
    (hk : ∀ c N e, E.sto l = some c → c.ty = .array (.lit N) e → k < E.rc l) :
    SKeep E S (updS S l ((S l).set k R')) :=
  SKeep_updS fun c N e us j R hc hT hu hj hR => by
    have hkj : k ≠ j := fun h => absurd (h ▸ hk c N e hc hT) (Nat.not_lt.2 (PredU_slot_ge hc hT hu hj))
    rw [List.getElem?_set_ne hkj]; exact hR
#print axioms SKeep_set

/-- (H, pins) A label with no predicted unit: its list may change freely. -/
theorem SKeep_noPred {E : TEnv} {S : AllocLabel → List Res} {l : AllocLabel} {Rs : List Res}
    (h : ∀ o, ¬ PredU E ⟨l, o⟩) : SKeep E S (updS S l Rs) :=
  SKeep_updS fun _ _ _ _ _ _ _ _ _ hj _ => absurd hj (h _)
#print axioms SKeep_noPred

/-- (H, pins) Pins sit at predicted slots. -/
def PinWF (E : TEnv) (pin : AllocLabel → Nat → Option Res) : Prop :=
  ∀ l j R, pin l j = some R → ∃ c N e us, E.sto l = some c ∧ c.ty = .array (.lit N) e ∧ accs e = some us ∧
    PredU E ⟨l, j * nWords us⟩

theorem PinOK_keep {E : TEnv} {S S' : AllocLabel → List Res} {pin : AllocLabel → Nat → Option Res}
    (hp : PinOK S pin) (hk : SKeep E S S') (hw : PinWF E pin) : PinOK S' pin := fun l j R h => by
  obtain ⟨c, N, e, us, hc, hT, hu, hj⟩ := hw l j R h
  exact hk l c N e us j R hc hT hu hj (hp l j R h)
#print axioms PinOK_keep

/-- (H, pins) The step `s → s'` touches units `[lo, hi)` of `l`: it has a message there past the old
memory or the old coherence (a write: append or fulfilment), or an own promise there is no longer
outstanding. -/
def TouchS (s s' : St) (l : AllocLabel) (lo hi : Nat) : Prop :=
  ∃ (t : Ts) (m : Msg), s'.mem[t]? = some m ∧ m.loc.label = l ∧ lo ≤ m.loc.offset ∧ m.loc.offset < hi ∧
    (s.mem.size ≤ t ∨ s.vs.coh m.loc < t ∨ (t ∈ s.promises ∧ t ∉ s'.promises))

/-- (H, pins) Every predicted slot the step `s → s'` does not touch keeps its share. -/
def SKeepT (E : TEnv) (s s' : St) (S S' : AllocLabel → List Res) : Prop :=
  ∀ l c N e us j R, E.sto l = some c → c.ty = .array (.lit N) e → accs e = some us →
    PredU E ⟨l, j * nWords us⟩ → ¬ TouchS s s' l (j * nWords us) ((j + 1) * nWords us) →
    (S l)[j]? = some R → (S' l)[j]? = some R

theorem SKeep.toT {E : TEnv} {S S' : AllocLabel → List Res} (h : SKeep E S S') (s s' : St) : SKeepT E s s' S S' :=
  fun l c N e us j R hc hT hu hj _ hR => h l c N e us j R hc hT hu hj hR
#print axioms SKeep.toT

/-- (H, pins) Memory holds `H` along lists keeping `S0`'s untouched region (relative to `E0`, the
step from `s0`). -/
def MemHeldK (E0 : TEnv) (s0 : St) (S0 : AllocLabel → List Res) (E : TEnv) (s : St) (H : Res) : Prop :=
  ∃ S, MemHeldL E s H S ∧ SKeepT E0 s0 s S0 S

theorem MemHeldK.memHeld {E0 E : TEnv} {s0 : St} {S0 : AllocLabel → List Res} {s : St} {H : Res}
    (h : MemHeldK E0 s0 S0 E s H) : MemHeld E s H :=
  let ⟨_, h1, _⟩ := h
  h1.memHeld
#print axioms MemHeldK.memHeld

/-- (H, pins) `HeldEntryL` under a transport that keeps the cell, `ini`, `rc`, and the
latest words. -/
theorem HeldEntryL_tr {E E' : TEnv} {s s' : St} {l : AllocLabel} {Rs : List Res} (h : HeldEntryL E s l Rs)
    (hsto : E'.sto l = E.sto l) (hini : E'.ini l = E.ini l) (hri : E'.rini l = E.rini l)
    (hlat : ∀ o w, LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w → LatestNP s'.mem (PromAt E' s' ⟨l, o⟩) ⟨l, o⟩ w)
    (hv : ∀ {T : Ty} {vs : List Word} {R : Res}, ValOfR E T vs R → ValOfR E' T vs R) :
    HeldEntryL E' s' l Rs := by
  obtain ⟨h0, h1⟩ := h
  refine ⟨fun hn => h0 (by rw [← hsto]; exact hn), fun c hc => ?_⟩
  obtain ⟨vals, hL, hC⟩ := h1 c (by rw [← hsto]; exact hc)
  refine ⟨vals, fun o w hw => hlat o w (hL o w hw), ?_⟩
  rw [hini, TEnv.rc_congr hini hri]
  rcases hC with ⟨hw, R, hR, rfl⟩ | ⟨N, e, us, hT, hu, hn, hl, hRs, hj⟩
  · exact Or.inl ⟨hw, R, hv hR, rfl⟩
  · exact Or.inr ⟨N, e, us, hT, hu, hn, hl, hRs, fun j Rj q1 q2 => slotR_imp (hj j Rj q1 q2) rfl hv⟩
#print axioms HeldEntryL_tr

/-- (H, pins) `MemHeldX_tr` along the lists (they are kept). -/
theorem MemHeldXL_tr {E E' : TEnv} {s s' : St} {l : AllocLabel} {H : Res} {S : AllocLabel → List Res}
    (h : MemHeldXL E s l H S)
    (hsto : ∀ l', l' ≠ l → E'.sto l' = E.sto l') (hini : ∀ l', l' ≠ l → E'.ini l' = E.ini l')
    (hlat : ∀ l', l' ≠ l → ∀ o w, LatestNP s.mem (PromAt E s ⟨l', o⟩) ⟨l', o⟩ w →
      LatestNP s'.mem (PromAt E s' ⟨l', o⟩) ⟨l', o⟩ w)
    (hv : ∀ {T : Ty} {vs : List Word} {R : Res}, ValOfR E T vs R → ValOfR E' T vs R)
    (htid : E'.tid = E.tid := by first | rfl | assumption)
    (hpf : ∀ l', l' ≠ l → E'.pfr l' = E.pfr l' := by first | exact fun _ _ => rfl | assumption)
    (hfp : E'.fp = E.fp := by first | rfl | assumption)
    (hri : ∀ l', l' ≠ l → E'.rini l' = E.rini l' := by
      first | exact fun _ _ => rfl | assumption | exact fun l' h => bumpIni_other _ _ _ l' h) :
    MemHeldXL E' s' l H S := by
  obtain ⟨L, hnd, hnl, hcov, hoff, rfl, hent⟩ := h
  have hne : ∀ l', l' ∈ L → l' ≠ l := fun l' hl' e => hnl (e ▸ hl')
  refine ⟨L, hnd, hnl, fun l' c hn hc => hcov l' c hn (by rw [← hsto l' hn]; exact hc), hoff, rfl,
    fun l' hl' => HeldEntryL_tr (hent l' hl') (hsto l' (hne l' hl')) (hini l' (hne l' hl'))
      (hri l' (hne l' hl')) (fun o w hw => ?_) hv⟩
  rw [PromAt_congr (a := ⟨l', o⟩) (hsto l' (hne l' hl')) htid (hpf l' (hne l' hl')) hfp
    (hini l' (hne l' hl')) (TEnv.rc_congr (hini l' (hne l' hl')) (hri l' (hne l' hl')))]
  exact hlat l' (hne l' hl') o w hw
#print axioms MemHeldXL_tr

/-- (H, pins) `MemHeld_tr` along the lists (they are kept). -/
theorem MemHeldL_tr {E E' : TEnv} {s s' : St} {H : Res} {S : AllocLabel → List Res} (h : MemHeldL E s H S)
    (hsto : ∀ l, E'.sto l = E.sto l) (hini : ∀ l, E'.ini l = E.ini l)
    (hlat : ∀ l o w, LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w → LatestNP s'.mem (PromAt E s' ⟨l, o⟩) ⟨l, o⟩ w)
    (hv : ∀ {T : Ty} {vs : List Word} {R : Res}, ValOfR E T vs R → ValOfR E' T vs R)
    (htid : E'.tid = E.tid := by first | rfl | assumption)
    (hpf : ∀ l, E'.pfr l = E.pfr l := by first | exact fun _ => rfl | assumption)
    (hfp : E'.fp = E.fp := by first | rfl | assumption)
    (hri : ∀ l, E'.rini l = E.rini l := by first | exact fun _ => rfl | assumption) :
    MemHeldL E' s' H S := by
  obtain ⟨L, hnd, hcov, hoff, rfl, hent⟩ := h
  refine ⟨L, hnd, fun l c hc => hcov l c (by rw [← hsto l]; exact hc), hoff, rfl,
    fun l hl => HeldEntryL_tr (hent l hl) (hsto l) (hini l) (hri l) (fun o w hw => ?_) hv⟩
  rw [PromAt_congr (a := ⟨l, o⟩) (hsto l) htid (hpf l) hfp (hini l) (TEnv.rc_congr (hini l) (hri l))]
  exact hlat l o w hw
#print axioms MemHeldL_tr

theorem MemHeldL_eqs {E : TEnv} {s s' : St} {H : Res} {S : AllocLabel → List Res} (h : MemHeldL E s H S)
    (e1 : s'.mem = s.mem) (e2 : s'.promises = s.promises) : MemHeldL E s' H S :=
  MemHeldL_tr h (fun _ => rfl) (fun _ => rfl) (fun _ _ _ hl => by rw [e1, PromAt_eqp e2]; exact hl) id
#print axioms MemHeldL_eqs

/-- (H, pins) Put label `l`'s entry back, along some list for it (the others kept). -/
theorem MemHeldL_unfocusAny {E : TEnv} {s : St} {l : AllocLabel} {R H0 : Res} {S : AllocLabel → List Res}
    (hX : MemHeldXL E s l H0 S) (he : HeldEntry E s l R) :
    ∃ S', MemHeldL E s (R + H0) S' ∧ ∀ l', l' ≠ l → S' l' = S l' := by
  obtain ⟨Rs, hL, rfl⟩ := he.toS
  exact ⟨_, MemHeldL_unfocus hX hL, fun l' hl' => updS_other S Rs hl'⟩
#print axioms MemHeldL_unfocusAny

/-- (H, pins) Only label `l`'s list changed, and `l` has no predicted unit. -/
theorem SKeep_of_other {E : TEnv} {S S' : AllocLabel → List Res} {l : AllocLabel}
    (h : ∀ l', l' ≠ l → S' l' = S l') (hnp : ∀ o, ¬ PredU E ⟨l, o⟩) : SKeep E S S' :=
  fun l' _ _ _ _ _ _ _ _ _ hj hR => by
    by_cases e' : l' = l
    · subst e'; exact absurd hj (hnp _)
    · rw [h l' e']; exact hR
#print axioms SKeep_of_other

/-- (H, pins) `MemHeldL_focus` with the label's entry as a sum (the old shape). -/
theorem MemHeldL_focusE {E : TEnv} {s : St} {H : Res} {S : AllocLabel → List Res} (h : MemHeldL E s H S)
    (l : AllocLabel) :
    ∃ R0 H0, H = R0 + H0 ∧ HeldEntry E s l R0 ∧ MemHeldXL E s l H0 S := by
  obtain ⟨H0, rfl, he, hX⟩ := MemHeldL_focus h l
  exact ⟨_, H0, rfl, he.entry, hX⟩
#print axioms MemHeldL_focusE

/-! ### (H, pins) `MemHeldK` forms of the frame helpers (pin phase 2) -/

theorem MemHeldK_of {E0 E : TEnv} {s0 s : St} {H : Res} {S : AllocLabel → List Res} (h : MemHeldL E s H S) :
    MemHeldK E0 s0 S E s H :=
  ⟨S, h, (SKeep_refl E0 S).toT s0 s⟩
#print axioms MemHeldK_of

theorem MemHeldK_eqs {E : TEnv} {s0 s s' : St} {H : Res} {S : AllocLabel → List Res} (h : MemHeldL E s H S)
    (e1 : s'.mem = s.mem) (e2 : s'.promises = s.promises) : MemHeldK E s0 S E s' H :=
  MemHeldK_of (MemHeldL_eqs h e1 e2)
#print axioms MemHeldK_eqs

theorem MemHeldK_tr {E E' : TEnv} {s0 s s' : St} {H : Res} {S : AllocLabel → List Res} (h : MemHeldL E s H S)
    (hsto : ∀ l, E'.sto l = E.sto l) (hini : ∀ l, E'.ini l = E.ini l)
    (hlat : ∀ l o w, LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w → LatestNP s'.mem (PromAt E s' ⟨l, o⟩) ⟨l, o⟩ w)
    (hv : ∀ {T : Ty} {vs : List Word} {R : Res}, ValOfR E T vs R → ValOfR E' T vs R)
    (htid : E'.tid = E.tid := by first | rfl | assumption)
    (hpf : ∀ l, E'.pfr l = E.pfr l := by first | exact fun _ => rfl | assumption)
    (hfp : E'.fp = E.fp := by first | rfl | assumption)
    (hri : ∀ l, E'.rini l = E.rini l := by first | exact fun _ => rfl | assumption) :
    MemHeldK E s0 S E' s' H :=
  ⟨S, MemHeldL_tr h hsto hini hlat hv htid hpf hfp hri, (SKeep_refl E S).toT s0 s'⟩
#print axioms MemHeldK_tr

/-- (H, pins) Put back the entry of a label with no predicted unit (at `E0`): the region is kept. -/
theorem MemHeldK_unfocus {E0 E : TEnv} {s0 s : St} {l : AllocLabel} {R H0 : Res} {S : AllocLabel → List Res}
    (hX : MemHeldXL E s l H0 S) (he : HeldEntry E s l R) (hnp : ∀ o, ¬ PredU E0 ⟨l, o⟩) :
    MemHeldK E0 s0 S E s (R + H0) := by
  obtain ⟨S', h1, h2⟩ := MemHeldL_unfocusAny hX he
  exact ⟨S', h1, (SKeep_of_other h2 hnp).toT s0 s⟩
#print axioms MemHeldK_unfocus

/-- (H, pins) Put back the entry of a label whose cell (at `E0`) is no buffer: nothing to keep. -/
theorem MemHeldK_unfocusNA {E0 E : TEnv} {s0 s : St} {l : AllocLabel} {R H0 : Res} {S : AllocLabel → List Res}
    (hX : MemHeldXL E s l H0 S) (he : HeldEntry E s l R)
    (hna : ∀ c N e, E0.sto l = some c → c.ty ≠ .array (.lit N) e) :
    MemHeldK E0 s0 S E s (R + H0) := by
  obtain ⟨S', h1, h2⟩ := MemHeldL_unfocusAny hX he
  refine ⟨S', h1, fun l' c N e us j R hc hT hu _ _ hR => ?_⟩
  by_cases e' : l' = l
  · subst e'; exact absurd hT (hna c N e hc)
  · rw [h2 l' e']; exact hR
#print axioms MemHeldK_unfocusNA

theorem MemHeldK_ofKeep {E0 E : TEnv} {s0 s : St} {H : Res} {S : AllocLabel → List Res}
    (h : ∃ S', MemHeldL E s H S' ∧ SKeep E0 S S') : MemHeldK E0 s0 S E s H :=
  let ⟨S', h1, h2⟩ := h
  ⟨S', h1, h2.toT s0 s⟩
#print axioms MemHeldK_ofKeep

theorem MemHeldK_mono {E0 E : TEnv} {s0 : St} {S0 : AllocLabel → List Res} {s : St} {H : Res} (h : MemHeldK E0 s0 S0 E s H)
    {E1 : TEnv} {H1 : Res} (f : ∀ {S}, MemHeldL E s H S → MemHeldL E1 s H1 S) : MemHeldK E0 s0 S0 E1 s H1 :=
  let ⟨S, h1, h2⟩ := h
  ⟨S, f h1, h2⟩
#print axioms MemHeldK_mono

/-- (H, pins) A store from `s1` (same memory as `s0`, coherence above it) touches the slot holding
its first word. -/
theorem TouchS_store {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} {us : List Acc}
    {ws : List Word} {s0 s1 s' : St} (hs : s' ∈ storeUnits k arch pw a rel us ws 0 s1) (h0 : 0 < nWords us)
    (hsz : s1.mem.size = s0.mem.size) (hcoh : ∀ b, s0.vs.coh b ≤ s1.vs.coh b) {lo hi : Nat}
    (hlo : lo ≤ a.offset) (hhi : a.offset < hi) : TouchS s0 s' a.label lo hi := by
  obtain ⟨t, m, h1, -, h3, h4⟩ := storeUnits_wrP us ws 0 s1 s' hs 0 h0
  have ea : offs a (0 + 0) = a := by simp [offs]
  rw [ea] at h4
  refine ⟨t, m, h3, by rw [h4], by rw [h4]; exact hlo, by rw [h4]; exact hhi, ?_⟩
  rcases h1 with h | h
  · exact Or.inl (hsz ▸ h)
  · rw [ea] at h; exact Or.inr (Or.inl (by rw [h4]; exact Nat.lt_of_le_of_lt (hcoh a) h))
#print axioms TouchS_store

/-- (H, pins) Put back label `l`'s entry along its old list with slot `k` reset, `k` touched by the
step from `s0`: the untouched region is kept. -/
theorem MemHeldK_slotSet {E0 E : TEnv} {s0 s : St} {l : AllocLabel} {k : Nat} {R' H0 : Res}
    {S : AllocLabel → List Res} (hX : MemHeldXL E s l H0 S) (he : HeldEntryL E s l ((S l).set k R'))
    (ht : ∀ c N e us, E0.sto l = some c → c.ty = .array (.lit N) e → accs e = some us →
      TouchS s0 s l (k * nWords us) ((k + 1) * nWords us)) :
    MemHeldK E0 s0 S E s (Res.sum ((S l).set k R') + H0) := by
  refine ⟨updS S l ((S l).set k R'), MemHeldL_unfocus hX he, fun l' c N e us j R hc hT hu _ hnt hR => ?_⟩
  by_cases e' : l' = l
  · subst e'
    rw [updS_self]
    by_cases hjk : k = j
    · subst hjk; exact absurd (ht c N e us hc hT hu) hnt
    · rw [List.getElem?_set_ne hjk]; exact hR
  · rw [updS_other _ _ e']; exact hR
#print axioms MemHeldK_slotSet

theorem ValOfR_mono {η₁ η₂ : TEnv} (hp : η₁.prog = η₂.prog) (ht : η₁.tid = η₂.tid)
    (hs : ∀ l c, η₁.sto l = some c → η₂.sto l = some c) (hi : ∀ l, η₁.ini l ≤ η₂.ini l)
    {T : Ty} {vs : List Word} {R : Res} (h : ValOfR η₁ T vs R)
    (hP : ∀ l f, η₁.pfr l = some f → η₂.pfr l = some f := by first | exact fun _ _ h => h | simp_all)
    (hB : ∀ l B, η₁.box l = some B → η₂.box l = some B := by first | exact fun _ _ h => h | simp_all)
    (hri : ∀ l, η₁.rini l ≤ η₂.rini l := by rini_le) :
    ValOfR η₂ T vs R := by
  obtain ⟨hv, hV⟩ := h
  exact ⟨VRR_mono T (CE η₁.unsee) (CE η₂.unsee) _ _ _ _ (fun _ _ _ _ h => h) (fun _ _ _ _ h => h) rfl hp ht hs hi
    hP (fun _ h => h) hB hv, hV⟩

/-- (P4) Raising a cell's words' views keeps its resources. -/
theorem ValOfR_up {η : TEnv} {T : Ty} {vs vs' : List Word} {R : Res} (hw : WLe vs vs')
    (h : ValOfR η T vs R) : ValOfR η T vs' R :=
  ⟨VRR_up T _ vs vs' R hw h.1, Valid_vals T vs vs' hw.vals h.2⟩

theorem WLe.length : ∀ {ws ws' : List Word}, WLe ws ws' → ws.length = ws'.length
  | [], [], _ => rfl
  | _ :: _, _ :: _, h => by simp [WLe.length h.2]
  | [], _ :: _, h => (h : False).elim
  | _ :: _, [], h => (h : False).elim

theorem CellOKR_up {η : TEnv} {n nr : Nat} {T : Ty} {vals vals' : List Word} {R : Res} (hw : WLe vals vals')
    (h : CellOKR η n nr T vals R) : CellOKR η n nr T vals' R := by
  rcases h with ⟨h1, h2⟩ | ⟨N, e, us, Rs, hT, hu, hn, hl, hRs, hR, hj⟩
  · exact Or.inl ⟨by rw [← hw.length]; exact h1, ValOfR_up hw h2⟩
  · exact Or.inr ⟨N, e, us, Rs, hT, hu, hn, by rw [← hw.length]; exact hl, hRs, hR,
      fun j Rj h1 h2 => slotR_imp (hj j Rj h1 h2) rfl (ValOfR_up (WLe.take _ (WLe.drop _ hw)))⟩



/-- (S4f) An own cell's word as its owner reads it (`LatestP`) is below the
word memory's reading takes there (own promises skipped where the reading is
not a visible word unit; S7c: so at private cells, and at word-free cells). -/
theorem LatestP_NP {E : TEnv} {s : St} {l : AllocLabel} {o : Nat} {v : Word}
    (hown : PromAt E s ⟨l, o⟩ = s.promises)
    (h : LatestP s.mem s.promises s.vs.coh ⟨l, o⟩ v) :
    ∃ w, WLe1 v w ∧ LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w := by
  obtain ⟨⟨m, hm, hloc, hval, hview⟩, hn, hlast⟩ := h
  rw [hown]
  exact ⟨mw m, ⟨hval.symm, fun a g hv => hview a g hv⟩, s.vs.coh ⟨l, o⟩, m, hn, hm, hloc, rfl, hlast⟩

theorem exists_WLe_pick {P : Nat → Word → Prop} :
    ∀ (vals : List Word), (∀ o v, vals[o]? = some v → ∃ w, WLe1 v w ∧ P o w) →
      ∃ vals', WLe vals vals' ∧ ∀ o w, vals'[o]? = some w → P o w
  | [], _ => ⟨[], trivial, fun o w h => by simp at h⟩
  | v :: vs, h => by
      obtain ⟨w, hw, hp⟩ := h 0 v rfl
      obtain ⟨vs', hws, hps⟩ := exists_WLe_pick (P := fun o w => P (o + 1) w) vs
        (fun o v' hv => h (o + 1) v' (by simpa using hv))
      refine ⟨w :: vs', ⟨hw, hws⟩, fun o w' hw' => ?_⟩
      cases o with
      | zero => simp at hw'; subst hw'; exact hp
      | succ o => exact hps o w' (by simpa using hw')


/-- (S7c) A private cell has no visible word unit. -/
theorem nvis_priv {E : TEnv} {l : AllocLabel} {c : Cell} (hsto : E.sto l = some c) (hown : c.owner = some E.tid)
    (hp : E.pfr l = none) : ∀ o, ¬ VisU E ⟨l, o⟩ :=
  fun _ => VisU_own (Priv_of hsto hown hp)

/-- (S7i) At a private cell memory's reading skips the own promises only. -/
theorem PromAt_privL {E : TEnv} {s : St} {l : AllocLabel} (h : Priv E l) :
    ∀ o, PromAt E s ⟨l, o⟩ = s.promises :=
  fun _ => PromAt_own h

/-- (S7i) A foreign promise list with no message at `a` changes no reading there. -/
theorem LatestNP_appNo {M : Memory} {P F : List Ts} {a : Address} {w : Word}
    (hF : ∀ t m, t ∈ F → M[t]? = some m → m.loc ≠ a) (h : LatestNP M P a w) : LatestNP M (P ++ F) a w := by
  obtain ⟨t, m, ht, hm, hl, hw, hlast⟩ := h
  refine ⟨t, m, fun h => ?_, hm, hl, hw, fun t' m' hlt hm' hl' =>
    List.mem_append.2 (Or.inl (hlast t' m' hlt hm' hl'))⟩
  rcases List.mem_append.1 h with h | h
  · exact ht h
  · exact hF t m h hm hl

/-- (S4f) An own cell's entry, from its words as its owner reads them (S7c:
the cell has no visible word unit, `hnv`: it is private, `nvis_priv`, or
word-free). -/
theorem HeldEntry_ownP {E : TEnv} {s : St} {l : AllocLabel} {c : Cell} {vals : List Word} {R : Res}
    (hsto : E.sto l = some c) (hnv : ∀ o, PromAt E s ⟨l, o⟩ = s.promises)
    (hlat : ∀ o v, vals[o]? = some v → LatestP s.mem s.promises s.vs.coh ⟨l, o⟩ v)
    (hc : CellOKR E (E.ini l) (E.rc l) c.ty vals R) : HeldEntry E s l R := by
  unfold HeldEntry
  refine ⟨fun h => (by rw [hsto] at h; cases h), fun c' hc' => ?_⟩
  rw [hsto] at hc'; cases hc'
  obtain ⟨vals', hw, hp⟩ := exists_WLe_pick (P := fun o w => LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w) vals
    (fun o v hv => LatestP_NP (hnv o) (hlat o v hv))
  exact ⟨vals', hp, CellOKR_up hw hc⟩

/-- (S8-pre) **No own promise at a visible word unit of label `l`.**  Trivial
at a private cell or a word-free one (no visible word unit, `NVP_of_nvis`); at
a shared-own cell (own, with a frontier: published or planted) it says the
owner has no outstanding promise at the cell's protocol words, so memory's
reading there (promises included, `PromAt`) is the owner's (own promises
skipped), `LatestP_NPN`, and a store there fulfils no promise carrying a
credit, `CrKeep_storeN`. -/
def NVP (E : TEnv) (s : St) (l : AllocLabel) : Prop :=
  (∀ o t m, VisU E ⟨l, o⟩ → t ∈ s.promises → s.mem[t]? = some m → m.loc ≠ ⟨l, o⟩) ∧
    (Vis E l → ∀ t, t ∈ E.fp → t < s.mem.size ∧ ∀ m, s.mem[t]? = some m → m.loc.label ≠ l) ∧
    ∀ o, ¬ PredU E ⟨l, o⟩

/-- (S8-pre) **The own-path stores' side condition**, replacing S7c's
`OwnPrivC` (own references name private cells, false after a plant): every own
cell satisfies `NVP`.  Private and word-free cells satisfy it outright
(`OwnNVP_cell`); the residual is an own promise at a protocol word of a
shared-own cell, whose fulfilment by a multi-unit own store needs the
shared-own store accounting (credits at visible word units). -/
def OwnNVP (E : TEnv) (s : St) : Prop :=
  ∀ l c, E.sto l = some c → c.owner = some E.tid → NVP E s l

theorem NVP_of_nvis {E : TEnv} {s : St} {l : AllocLabel} (h : ∀ o, ¬ VisU E ⟨l, o⟩)
    (hf : Vis E l → ∀ t, t ∈ E.fp → t < s.mem.size ∧ ∀ m, s.mem[t]? = some m → m.loc.label ≠ l)
    (hq : ∀ o, ¬ PredU E ⟨l, o⟩) :
    NVP E s l :=
  ⟨fun o _ _ hv => absurd hv (h o), hf, hq⟩

/-- (S8-pre) A private cell satisfies `NVP`. -/
theorem NVP_priv {E : TEnv} {s : St} {l : AllocLabel} (h : Priv E l) : NVP E s l :=
  NVP_of_nvis (fun _ => VisU_own h) (fun hv => absurd h hv) (fun _ => PredU_own h)

/-- (S8-pre) `OwnNVP` holds when every own cell is private, or has no visible
word unit and (S7i) no foreign promise there. -/
theorem OwnNVP_cell {E : TEnv} {s : St}
    (h : ∀ l c, E.sto l = some c → c.owner = some E.tid → E.pfr l = none ∨ ((∀ o, ¬ VisU E ⟨l, o⟩) ∧
      (Vis E l → ∀ t, t ∈ E.fp → t < s.mem.size ∧ ∀ m, s.mem[t]? = some m → m.loc.label ≠ l) ∧
      ∀ o, ¬ PredU E ⟨l, o⟩)) :
    OwnNVP E s := fun l c hs ho => by
  rcases h l c hs ho with hp | ⟨hv, hf, hq⟩
  · exact NVP_priv (Priv_of hs ho hp)
  · exact NVP_of_nvis hv hf hq

/-- (S8-own A1) **The narrowed `OwnNVP` residual**: `NVP` at the own cells with
a frontier (a private cell satisfies it outright, `NVP_priv`). -/
def OwnNVPF (E : TEnv) (s : St) : Prop :=
  ∀ l c f, E.sto l = some c → c.owner = some E.tid → E.pfr l = some f → NVP E s l

theorem OwnNVP_of_F {E : TEnv} {s : St} (h : OwnNVPF E s) : OwnNVP E s := fun l c hs ho => by
  rcases hpf : E.pfr l with _ | f
  · exact NVP_priv (Priv_of hs ho hpf)
  · exact h l c f hs ho hpf

theorem OwnNVPF_of {E : TEnv} {s : St} (h : OwnNVP E s) : OwnNVPF E s :=
  fun l c _ hs ho _ => h l c hs ho

/-- (S8-pre) `NVP` survives a step that keeps memory below its old size and
only drops promises. -/
theorem NVP_mono {E : TEnv} {s s' : St} {l : AllocLabel} (h : NVP E s l)
    (hsub : ∀ t, t ∈ s'.promises → t ∈ s.promises) (hlt : ∀ t, t ∈ s.promises → t < s.mem.size)
    (hpre : ∀ t, t < s.mem.size → s'.mem[t]? = s.mem[t]?) : NVP E s' l := by
  refine ⟨fun o t m hvu ht hm => ?_, fun hv t ht => ?_, h.2.2⟩
  · have ht0 := hsub t ht
    exact h.1 o t m hvu ht0 (by rw [← hpre t (hlt t ht0)]; exact hm)
  · obtain ⟨hlt', hno⟩ := h.2.1 hv t ht
    have e := hpre t hlt'
    refine ⟨?_, fun m hm => hno m (by rw [← e]; exact hm)⟩
    have h0 : s.mem[t]? = some s.mem[t] := Array.getElem?_eq_getElem hlt'
    exact lt_of_get (by rw [e]; exact h0)

theorem NVP_eqs {E : TEnv} {s s' : St} {l : AllocLabel} (h : NVP E s l) (e1 : s'.mem = s.mem)
    (e2 : s'.promises = s.promises) : NVP E s' l :=
  ⟨fun o t m hv ht hm => h.1 o t m hv (by rw [← e2]; exact ht) (by rw [← e1]; exact hm),
    fun hv t ht => by rw [e1]; exact h.2.1 hv t ht, h.2.2⟩

/-- (S8-pre) `NVP` at another view with no more visible word units (S7i: no
more visibility, the same foreign promises). -/
theorem NVP_env {E E' : TEnv} {s : St} {l : AllocLabel} (h : NVP E s l)
    (hv : ∀ o, VisU E' ⟨l, o⟩ → VisU E ⟨l, o⟩) (hvis : Vis E' l → Vis E l) (hf : E'.fp = E.fp)
    (hq : ∀ o, ¬ PredU E' ⟨l, o⟩) :
    NVP E' s l :=
  ⟨fun o t m hvu ht hm => h.1 o t m (hv o hvu) ht hm, fun hv' t ht => h.2.1 (hvis hv') t (hf ▸ ht), hq⟩

/-- (S8-pre) A store keeps `NVP`. -/
theorem NVP_store {E : TEnv} {s s' : St} {l : AllocLabel} {k : Promises.Knobs} {arch : Arch} {pw : Word}
    {a : Address} {rel : Bool} {us : List Acc} {ws : List Word} (h : NVP E s l) (hpl : PromLt s)
    (hs : s' ∈ storeUnits k arch pw a rel us ws 0 s) : NVP E s' l := by
  obtain ⟨hg, hsub, -⟩ := storeUnits_growsF us ws 0 s s' hs
  exact NVP_mono h hsub hpl hg.2.1

/-- (S8-pre) `LatestP_NP` under `NVP`: at a visible word unit without own
promises, memory's reading skips nothing, as the owner's. -/
theorem LatestP_NPN {E : TEnv} {s : St} {l : AllocLabel} {o : Nat} {v : Word} (hn : NVP E s l)
    (h : LatestP s.mem s.promises s.vs.coh ⟨l, o⟩ v) :
    ∃ w, WLe1 v w ∧ LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w := by
  by_cases hv : VisU E ⟨l, o⟩
  · obtain ⟨⟨m, hm, hloc, hval, hview⟩, hnp, hlast⟩ := h
    rw [PromAt_word hv]
    exact ⟨mw m, ⟨hval.symm, fun a g hv' => hview a g hv'⟩,
      (LatestNP_noProm (fun t m' ht hm' => hn.1 o t m' hv ht hm')).1 ⟨s.vs.coh ⟨l, o⟩, m, hnp, hm, hloc, rfl, hlast⟩⟩
  · by_cases hvis : Vis E l
    · obtain ⟨⟨m, hm, hloc, hval, hview⟩, hnp, hlast⟩ := h
      rw [PromAt_nword hv (hn.2.2 o), FpAt_vis (a := ⟨l, o⟩) hvis]
      exact ⟨mw m, ⟨hval.symm, fun a g hv' => hview a g hv'⟩,
        LatestNP_appNo (fun t m' ht hm' hl => (hn.2.1 hvis t ht).2 m' hm' (by rw [hl]))
          ⟨s.vs.coh ⟨l, o⟩, m, hnp, hm, hloc, rfl, hlast⟩⟩
    · exact LatestP_NP (PromAt_nwordP hv (hn.2.2 o) (FpAt_priv (a := ⟨l, o⟩) hvis)) h

/-- (S8-pre) `HeldEntry_ownP` under `NVP`. -/
theorem HeldEntry_ownN {E : TEnv} {s : St} {l : AllocLabel} {c : Cell} {vals : List Word} {R : Res}
    (hsto : E.sto l = some c) (hn : NVP E s l)
    (hlat : ∀ o v, vals[o]? = some v → LatestP s.mem s.promises s.vs.coh ⟨l, o⟩ v)
    (hc : CellOKR E (E.ini l) (E.rc l) c.ty vals R) : HeldEntry E s l R := by
  unfold HeldEntry
  refine ⟨fun h => (by rw [hsto] at h; cases h), fun c' hc' => ?_⟩
  rw [hsto] at hc'; cases hc'
  obtain ⟨vals', hw, hp⟩ := exists_WLe_pick (P := fun o w => LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w) vals
    (fun o v hv => LatestP_NPN hn (hlat o v hv))
  exact ⟨vals', hp, CellOKR_up hw hc⟩

/-- (P4) Latest non-promise words away from the label a step writes are kept. -/
theorem LatestNP_growsAt {M M' : Memory} {P : List Ts} {l l' : AllocLabel} {o : Nat} {w : Word}
    (hg : GrowsAt M M' l) (hne : l' ≠ l) (h : LatestNP M P ⟨l', o⟩ w) : LatestNP M' P ⟨l', o⟩ w := by
  obtain ⟨t, m, ht, hm, hloc, hw, hlast⟩ := h
  refine ⟨t, m, ht, by rw [hg.2.1 t (lt_of_get hm)]; exact hm, hloc, hw, fun t' m' hlt hm' hl' => ?_⟩
  by_cases hs : t' < M.size
  · exact hlast t' m' hlt (by rw [← hg.2.1 t' hs]; exact hm') hl'
  · have := hg.2.2 t' m' (Nat.le_of_not_lt hs) hm'
    rw [hl'] at this; exact absurd this hne

/-- (P4) `LatestNP_growsAt` at the per-address reading, promises unchanged. -/
theorem LatestNP_growsAtA {E : TEnv} {s s' : St} {l l' : AllocLabel} {o : Nat} {w : Word}
    (hg : GrowsAt s.mem s'.mem l) (hpr : s'.promises = s.promises) (hne : l' ≠ l)
    (h : LatestNP s.mem (PromAt E s ⟨l', o⟩) ⟨l', o⟩ w) : LatestNP s'.mem (PromAt E s' ⟨l', o⟩) ⟨l', o⟩ w := by
  exact PromAt_atSame (AtSame_growsL hg.2.1 hg.2.2 hne (fun t _ _ _ => by rw [hpr])) h

/-- **(P4) A thread against memory, with resources**: `ThInvM` whose frame
holds at most `Tot`, and memory holds `H`, at the same view. -/
def ThInvMR (p : Prog) (g : G) (mem : Memory) (pairs : List Ts) (th : TTh) (Tot H : Res) : Prop :=
  ∃ E, ThInvRE p E th Tot ∧ MemInv g E (stOf mem pairs th) ∧ MemHeld E (stOf mem pairs th) H

/-- (P4 step 3) `ThInvMR` with the promise credits and debits. -/
def ThInvMC (p : Prog) (g : G) (mem : Memory) (pairs : List Ts) (th : TTh) (Tot H : Res)
    (cr db : Ts → Res) : Prop :=
  ∃ E, ThInvRE p E th Tot ∧ MemInv g E (stOf mem pairs th) ∧ MemHeld E (stOf mem pairs th) H ∧
    PromCr E (stOf mem pairs th) cr db

/-- (S6) `ThInvMC` with its witness an exact footprint (`EFoot`) of `E` at `s`. -/
def ThInvMCF (p : Prog) (g : G) (E : TEnv) (s : St) (mem : Memory) (pairs : List Ts) (th : TTh) (Tot H : Res)
    (cr db : Ts → Res) : Prop :=
  ∃ E', EFoot g E E' s (stOf mem pairs th) ∧ SeenOK E E' Tot H ∧ BoxNewV E E' s th ∧ ThInvRE p E' th Tot ∧ MemInv g E' (stOf mem pairs th) ∧
    MemHeld E' (stOf mem pairs th) H ∧ PromCr E' (stOf mem pairs th) cr db

theorem ThInvMCF.toMC {p : Prog} {g : G} {E : TEnv} {s : St} {mem : Memory} {pairs : List Ts} {th : TTh}
    {Tot H : Res} {cr db : Ts → Res} (h : ThInvMCF p g E s mem pairs th Tot H cr db) :
    ThInvMC p g mem pairs th Tot H cr db :=
  let ⟨E', _, hSK, hBV, h1, h2, h3, h4⟩ := h
  ⟨E', h1, h2, h3, h4⟩

/-- (H, pins) `ThInvMCF` whose witness's slot lists keep the region of `S0` (at `E`). -/
def ThInvMCFS (p : Prog) (g : G) (E : TEnv) (s : St) (S0 : AllocLabel → List Res) (mem : Memory) (pairs : List Ts)
    (th : TTh) (Tot H : Res) (cr db : Ts → Res) : Prop :=
  ∃ E', EFoot g E E' s (stOf mem pairs th) ∧ SeenOK E E' Tot H ∧ BoxNewV E E' s th ∧ ThInvRE p E' th Tot ∧ MemInv g E' (stOf mem pairs th) ∧
    MemHeldK E s S0 E' (stOf mem pairs th) H ∧ PromCr E' (stOf mem pairs th) cr db

theorem ThInvMCFS.toF {p : Prog} {g : G} {E : TEnv} {s : St} {S0 : AllocLabel → List Res} {mem : Memory}
    {pairs : List Ts} {th : TTh} {Tot H : Res} {cr db : Ts → Res} (h : ThInvMCFS p g E s S0 mem pairs th Tot H cr db) :
    ThInvMCF p g E s mem pairs th Tot H cr db :=
  let ⟨E', h0, hSK, hBV, h1, h2, h3, h4⟩ := h
  ⟨E', h0, (by seenT), (by boxT), h1, h2, h3.memHeld, h4⟩
#print axioms ThInvMCFS.toF

/-! ### (P4 step 5a) Keeping the promise credits across a step-2 memory step -/

/-- (S7f α) Off the visible word units nothing is read, whatever `ini`. -/
theorem VRes_nvisU {E : TEnv} {a : Address} {w : Word} {R : Res} (h : ¬ VisU E a) : VRes E a w R ↔ R = .zero := by
  constructor
  · rintro (⟨hV, -, ⟨n, P, ⟨c, hc, hat, hg⟩, -, -⟩ | ⟨-, h0⟩⟩ | ⟨-, h0⟩)
    · exact absurd ⟨⟨c, hc, Or.inl ⟨_, P, hg, hat⟩⟩, hV⟩ h
    · exact h0
    · exact h0
  · rintro rfl
    by_cases hV : Vis E a.label ∧ IniW E a
    · exact Or.inl ⟨hV.1, hV.2, Or.inr ⟨fun n P ⟨c, hc, hat, hg⟩ _ =>
        h ⟨⟨c, hc, Or.inl ⟨_, P, hg, hat⟩⟩, hV.1⟩, rfl⟩⟩
    · exact Or.inr ⟨hV, rfl⟩

/-- (U3, fix b) Two environments agree at address `a` on what a promise there
reads: visibility of the word unit, `VRes`, and the debit `DbRes`. -/
def ResEqv (E E' : TEnv) (a : Address) : Prop :=
  (VisD E' a ↔ VisD E a) ∧ (∀ w R, VRes E' a w R ↔ VRes E a w R) ∧
    ∀ (mem : Memory) (m : Msg) (tw : Ts) (R : Res), m.loc = a → DbRes E mem m tw R → DbRes E' mem m tw R

theorem ResEqv_refl {E : TEnv} {a : Address} : ResEqv E E a :=
  ⟨Iff.rfl, fun _ _ => Iff.rfl, fun _ _ _ _ _ => id⟩

theorem ResEqv_congr {E E' : TEnv} {a : Address} (hs : E'.sto a.label = E.sto a.label) (ht : E'.tid = E.tid)
    (hp : E'.pfr a.label = E.pfr a.label) (hi : E'.ini a.label = E.ini a.label)
    (hb : ∀ l B, E.box l = some B → E'.box l = some B := by first | exact fun _ _ h => h | assumption)
    (hr : E'.rc a.label = E.rc a.label := by first | rfl | assumption) :
    ResEqv E E' a :=
  ⟨VisD_congr hs ht hp hi hr, fun _ _ => VRes_congr hs ht hp hi, fun _ m _ _ e h => by
    subst e; exact DbRes_congr hs ht hp hi hb h hr⟩

theorem ResEqv_nvis {E E' : TEnv} {a : Address} (h : ¬ VisD E a) (h' : ¬ VisD E' a) : ResEqv E E' a :=
  ⟨⟨fun x => absurd x h', fun x => absurd x h⟩,
    fun _ _ => by rw [VRes_nvisU fun x => h (Or.inl x), VRes_nvisU fun x => h' (Or.inl x)],
    fun _ m _ _ e => by subst e; rw [DbRes_nvisU h, DbRes_nvisU h']; exact id⟩

theorem ResEqv_trans {E E1 E2 : TEnv} {a : Address} (h1 : ResEqv E E1 a) (h2 : ResEqv E1 E2 a) :
    ResEqv E E2 a :=
  ⟨h2.1.trans h1.1, fun w R => (h2.2.1 w R).trans (h1.2.1 w R),
    fun mem m tw R e h => h2.2.2 mem m tw R e (h1.2.2 mem m tw R e h)⟩

theorem not_VisU_none {E : TEnv} {a : Address} (h : E.sto a.label = none) : ¬ VisU E a := by
  rintro ⟨⟨c, hc, -⟩, -⟩
  rw [h] at hc; cases hc

theorem not_VisD_none {E : TEnv} {a : Address} (h : E.sto a.label = none) : ¬ VisD E a := by
  rintro (h' | ⟨-, ⟨c, hc, -⟩, -⟩)
  · exact not_VisU_none h h'
  · rw [h] at hc; cases hc
#print axioms not_VisD_none



/-- (P4 step 5a, S4f) What a step keeps for the promise credits: memory below
its old size; the promises, but for some it fulfils, which lie off the visible
word units (credits and debits nothing: at own cells, or off Σ); and every
remaining promise's readings (`ResEqv`, U3 fix b). -/
def CrKeep (E E' : TEnv) (s s' : St) : Prop :=
  s'.promises.Sublist s.promises ∧ s.mem.size ≤ s'.mem.size ∧ (∀ t, t < s.mem.size → s'.mem[t]? = s.mem[t]?) ∧
    (∀ t m, t ∈ s'.promises → s.mem[t]? = some m → ResEqv E E' m.loc) ∧
    ∀ t m, t ∈ s.promises → t ∉ s'.promises → s.mem[t]? = some m → ¬ VisD E m.loc

/-- (P4 step 5a) The credits and their totals carry over from `E`, `s` to
`E'`, `s'`. -/
def CrPack (E E' : TEnv) (s s' : St) : Prop :=
  ∀ cr db, PromCr E s cr db → PromCr E' s' cr db ∧ pSum s' cr = pSum s cr ∧ pSum s' db = pSum s db

/-- (P4 step 5a) `ThInvMR` whose witness keeps the credits of `E0`, `s`. -/
def ThInvMK (p : Prog) (g : G) (E0 : TEnv) (s : St) (S0 : AllocLabel → List Res) (mem : Memory) (pairs : List Ts) (th : TTh)
    (Tot H : Res) : Prop :=
  ∃ E, EFoot g E0 E s (stOf mem pairs th) ∧ SeenKeep E0 E ∧ BoxNewV E0 E s th ∧ ThInvRE p E th Tot ∧ MemInv g E (stOf mem pairs th) ∧ MemHeldK E0 s S0 E (stOf mem pairs th) H ∧
    CrKeep E0 E s (stOf mem pairs th)

/-- (P4 step 5a) `ThInvMR` whose witness carries the credits of `E0`, `s`. -/
def ThInvMP (p : Prog) (g : G) (E0 : TEnv) (s : St) (S0 : AllocLabel → List Res) (mem : Memory) (pairs : List Ts) (th : TTh)
    (Tot H : Res) : Prop :=
  ∃ E, EFoot g E0 E s (stOf mem pairs th) ∧ SeenKeep E0 E ∧ BoxNewV E0 E s th ∧ ThInvRE p E th Tot ∧ MemInv g E (stOf mem pairs th) ∧ MemHeldK E0 s S0 E (stOf mem pairs th) H ∧
    CrPack E0 E s (stOf mem pairs th)

theorem CrKeep_eqs {E : TEnv} {s s' : St} (e1 : s'.mem = s.mem) (e2 : s'.promises = s.promises) :
    CrKeep E E s s' :=
  ⟨by rw [e2]; exact List.Sublist.refl _, by rw [e1]; exact Nat.le_refl _, fun _ _ => by rw [e1],
    fun _ _ _ _ => ResEqv_refl, fun t _ ht hn => absurd (by rw [e2]; exact ht) hn⟩

theorem CrKeep_grows {E : TEnv} {s s' : St} {l : AllocLabel} (hg : GrowsAt s.mem s'.mem l)
    (hp : s'.promises = s.promises) : CrKeep E E s s' :=
  ⟨by rw [hp]; exact List.Sublist.refl _, hg.1, hg.2.1, fun _ _ _ _ => ResEqv_refl,
    fun t _ ht hn => absurd (by rw [hp]; exact ht) hn⟩

/-- (S7f α) `ini` may change at labels without visible word units (`bufInit`
at a private cell). -/
theorem CrKeep_sto {E E' : TEnv} {s s' : St} (h : CrKeep E E s s') (hs : ∀ l, E'.sto l = E.sto l)
    (htid : E'.tid = E.tid := by first | rfl | assumption)
    (hpf : ∀ l, E'.pfr l = E.pfr l := by first | exact fun _ => rfl | assumption)
    (hini : ∀ l, (E'.ini l = E.ini l ∧ E'.rc l = E.rc l) ∨ ((∀ o, ¬ VisD E ⟨l, o⟩) ∧ ∀ o, ¬ PredU E' ⟨l, o⟩) :=
      by first | exact fun _ => Or.inl ⟨rfl, rfl⟩ | assumption)
    (hb : ∀ l B, E.box l = some B → E'.box l = some B := by first | exact fun _ _ h => h | assumption) :
    CrKeep E E' s s' := by
  refine ⟨h.1, h.2.1, h.2.2.1, fun t m _ _ => ?_, h.2.2.2.2⟩
  rcases hini m.loc.label with ⟨hi, hr⟩ | ⟨hi, hq⟩
  · exact ResEqv_congr (hs _) htid (hpf _) hi hb hr
  · have h1 : ¬ VisD E m.loc := hi m.loc.offset
    have h2 : ¬ VisD E' m.loc := fun h' => h'.elim (fun h' => h1 (Or.inl ((VisU_congr (hs _) htid (hpf _)).1 h')))
      (fun h' => hq m.loc.offset h'.1)
    exact ResEqv_nvis h1 h2

theorem CrKeep_trans {E E1 E2 : TEnv} {s s1 s2 : St} (h1 : CrKeep E E1 s s1) (h2 : CrKeep E1 E2 s1 s2) :
    CrKeep E E2 s s2 := by
  refine ⟨h2.1.trans h1.1, Nat.le_trans h1.2.1 h2.2.1, fun t ht => ?_, fun t m ht hm => ?_,
    fun t m ht hn hm hv => ?_⟩
  · rw [h2.2.2.1 t (Nat.lt_of_lt_of_le ht h1.2.1), h1.2.2.1 t ht]
  · have hlt := lt_of_get hm
    have ht1 : t ∈ s1.promises := h2.1.subset ht
    exact ResEqv_trans (h1.2.2.2.1 t m ht1 hm) (h2.2.2.2.1 t m ht (by rw [h1.2.2.1 t hlt]; exact hm))
  · have hlt := lt_of_get hm
    by_cases ht1 : t ∈ s1.promises
    · exact h2.2.2.2.2 t m ht1 hn (by rw [h1.2.2.1 t hlt]; exact hm) ((h1.2.2.2.1 t m ht1 hm).1.mpr hv)
    · exact h1.2.2.2.2 t m ht ht1 hm hv

/-- (S4f) Nothing is read for a promise at a private cell. -/
theorem VRes_ownz {E : TEnv} {a : Address} (h : Priv E a.label) : ∀ w R, VRes E a w R → R = .zero :=
  fun _ _ hR => (VRes_own h).1 hR

/-- (S7c) Nothing is read for a promise off the visible word units. -/
theorem VRes_nvis {E : TEnv} {a : Address} (h : ¬ VisU E a) : ∀ w R, VRes E a w R → R = .zero := by
  rintro w R (⟨hV, -, ⟨n, P, ⟨c, hc, hat, hg⟩, -, -⟩ | ⟨-, h0⟩⟩ | ⟨-, h0⟩)
  · exact absurd ⟨⟨c, hc, Or.inl ⟨_, P, hg, hat⟩⟩, hV⟩ h
  · exact h0
  · exact h0

/-- (S4f) Nothing is read for a promise off Σ. -/
theorem VRes_none {E : TEnv} {a : Address} (h : E.sto a.label = none) {w : Word} {R : Res} :
    VRes E a w R ↔ R = .zero := by
  rw [VRes_vis (Vis_none h) (IniW_none h)]
  constructor
  · rintro (⟨n, P, ⟨c, hc, -⟩, -, -⟩ | ⟨-, h0⟩)
    · rw [h] at hc; cases hc
    · exact h0
  · intro h0
    exact Or.inr ⟨fun n P hw => (by obtain ⟨c, hc, -⟩ := hw; rw [h] at hc; cases hc), h0⟩

/-- A store to an own cell keeps the credits (S4f: a fulfilled promise there
carried none). -/
theorem CrKeep_store {g : G} {E : TEnv} {s s' : St} {k : Promises.Knobs} {arch : Arch} {pw : Word}
    {a : Address} {rel : Bool} {us : List Acc} {ws : List Word}
    (hm : MemInv g E s) (hs : s' ∈ storeUnits k arch pw a rel us ws 0 s)
    (hnv : ∀ o, ¬ VisD E ⟨a.label, o⟩) : CrKeep E E s s' := by
  obtain ⟨hg, -, -⟩ := storeUnits_growsF us ws 0 s s' hs
  obtain ⟨-, hsub, hful⟩ := storeUnits_promF us ws 0 s s' hm.2.2.1 hs
  refine ⟨hsub, hg.1, hg.2.1, fun _ _ _ _ => ResEqv_refl, fun t m ht hn hm' => ?_⟩
  obtain ⟨m1, j, w, hm1, -, -, hl, -⟩ := hful t ht hn
  rw [hm'] at hm1; cases hm1
  have hl' : m.loc.label = a.label := by rw [hl]; rfl
  have hn' := hnv m.loc.offset
  rw [← hl'] at hn'
  exact hn'

/-- (S8-pre) `CrKeep_store` under `NVP`: a fulfilled promise of the stored
cell lies off its visible word units, so it carried no credit. -/
theorem CrKeep_storeN {g : G} {E : TEnv} {s s' : St} {k : Promises.Knobs} {arch : Arch} {pw : Word}
    {a : Address} {rel : Bool} {us : List Acc} {ws : List Word}
    (hm : MemInv g E s) (hs : s' ∈ storeUnits k arch pw a rel us ws 0 s)
    (hn : NVP E s a.label) : CrKeep E E s s' := by
  obtain ⟨hg, -, -⟩ := storeUnits_growsF us ws 0 s s' hs
  obtain ⟨-, hsub, hful⟩ := storeUnits_promF us ws 0 s s' hm.2.2.1 hs
  refine ⟨hsub, hg.1, hg.2.1, fun _ _ _ _ => ResEqv_refl, fun t m ht hn' hm' => ?_⟩
  obtain ⟨m1, j, w, hm1, -, -, hl, -⟩ := hful t ht hn'
  rw [hm'] at hm1; cases hm1
  have hl' : m.loc.label = a.label := by rw [hl]; rfl
  have e : m.loc = ⟨a.label, m.loc.offset⟩ := by rw [← hl']
  rintro (hv | ⟨hq, -⟩)
  · rw [e] at hv
    exact hn.1 m.loc.offset t m hv ht hm' e
  · rw [e] at hq
    exact hn.2.2 m.loc.offset hq

/-- (S8-pre) `CrKeep_sto` with `ini` changing at labels satisfying `NVP`. -/
theorem CrKeep_stoN {E E' : TEnv} {s s' : St} (h : CrKeep E E s s') (hs : ∀ l, E'.sto l = E.sto l)
    (htid : E'.tid = E.tid := by first | rfl | assumption)
    (hpf : ∀ l, E'.pfr l = E.pfr l := by first | exact fun _ => rfl | assumption)
    (hini : ∀ l, (E'.ini l = E.ini l ∧ E'.rc l = E.rc l) ∨ (NVP E s l ∧ ∀ o, ¬ PredU E' ⟨l, o⟩))
    (hb : ∀ l B, E.box l = some B → E'.box l = some B := by first | exact fun _ _ h => h | assumption) :
    CrKeep E E' s s' := by
  refine ⟨h.1, h.2.1, h.2.2.1, fun t m ht hm => ?_, h.2.2.2.2⟩
  rcases hini m.loc.label with ⟨hi, hr⟩ | ⟨hi, hq⟩
  · exact ResEqv_congr (hs _) htid (hpf _) hi hb hr
  · have h1 : ¬ VisD E m.loc := fun hv => hv.elim (fun hv => hi.1 m.loc.offset t m hv (h.1.subset ht) hm rfl)
      (fun hv => hi.2.2 m.loc.offset hv.1)
    have h2 : ¬ VisD E' m.loc := fun h' => h'.elim (fun h' => h1 (Or.inl ((VisU_congr (hs _) htid (hpf _)).1 h')))
      (fun h' => hq m.loc.offset h'.1)
    exact ResEqv_nvis h1 h2

/-- (S4f) An allocation at a label off Σ that becomes own (or stays off Σ)
keeps the credits: before and after, nothing is read for a promise there. -/
theorem CrKeep_alloc {E E' : TEnv} {s s' : St} {lbl : AllocLabel} (hg : GrowsAt s.mem s'.mem lbl)
    (hsub : s'.promises.Sublist s.promises)
    (hful : ∀ t, t ∈ s.promises → t ∉ s'.promises → ∃ m, s.mem[t]? = some m ∧ m.loc.label = lbl)
    (hst : ∀ l, l ≠ lbl → E'.sto l = E.sto l) (h0 : E.sto lbl = none) (h1 : E'.sto lbl = none ∨ Priv E' lbl)
    (htid : E'.tid = E.tid := by first | rfl | assumption)
    (hpf : ∀ l, l ≠ lbl → E'.pfr l = E.pfr l := by first | exact fun _ _ => rfl | assumption)
    (hini : ∀ l, l ≠ lbl → E'.ini l = E.ini l := by first | exact fun _ _ => rfl | assumption)
    (hb : ∀ l B, E.box l = some B → E'.box l = some B := by first | exact fun _ _ h => h | assumption)
    (hrc : ∀ l, l ≠ lbl → E'.rc l = E.rc l := by first | exact fun _ _ => rfl | assumption) :
    CrKeep E E' s s' := by
  refine ⟨hsub, hg.1, hg.2.1, fun t m _ _ => ?_, fun t m ht hn hm => ?_⟩
  · by_cases hl : m.loc.label = lbl
    · refine ResEqv_nvis (not_VisD_none (by rw [hl]; exact h0)) ?_
      rcases h1 with h1 | h1
      · exact not_VisD_none (by rw [hl]; exact h1)
      · exact not_VisD_priv (by rw [hl]; exact h1)
    · exact ResEqv_congr (hst _ hl) htid (hpf _ hl) (hini _ hl) hb (hrc _ hl)
  · obtain ⟨m1, hm1, hl⟩ := hful t ht hn
    rw [hm] at hm1; cases hm1
    exact not_VisD_none (by rw [hl]; exact h0)

/-- A box allocation keeps the credits. -/
theorem CrKeep_box {g : G} {E : TEnv} {s : St} {us : List Acc} {ws : List Word} {r : St × Word}
    (hm : MemInv g E s) (hr : r ∈ alloc g.k g.arch (freshLabel g.lbase g.n g.i s.nalloc) us ws s) (B : Box) :
    CrKeep E (boxE E (freshLabel g.lbase g.n g.i s.nalloc) B) s
      (if g.boxFence then fenceS r.1 .st else r.1) := by
  obtain ⟨hg, hsub, -, -, hful⟩ := alloc_growsP hm.2.2.1 r hr
  have h0 : E.sto (freshLabel g.lbase g.n g.i s.nalloc) = none := (hm.2.2.2.1.1 s.nalloc (Nat.le_refl _)).1
  have key : CrKeep E (boxE E (freshLabel g.lbase g.n g.i s.nalloc) B) s r.1 :=
    CrKeep_alloc hg hsub hful (fun _ _ => rfl) h0 (Or.inl h0) (hb := fun l B' h => by
      have hne : l ≠ freshLabel g.lbase g.n g.i s.nalloc := fun e => by
        rw [e, hm.2.2.2.2.2.2.2.2.2.1.1 s.nalloc (Nat.le_refl _)] at h; cases h
      simp only [boxE, hne, ↓reduceIte]; exact h)
  split
  · exact key
  · exact key

/-- (S8b) The credit side condition survives seeing a label outside Σ. -/
theorem CrKeep_seeE {E E1 : TEnv} {s s' : St} {lbl : AllocLabel} {F : Ts} (h : CrKeep E E1 s s')
    (hsto : E1.sto lbl = none) : CrKeep E (seeE E1 lbl F) s s' := by
  refine ⟨h.1, h.2.1, h.2.2.1, fun t m ht hm => ResEqv_trans (h.2.2.2.1 t m ht hm) ?_, h.2.2.2.2⟩
  by_cases e : m.loc.label = lbl
  · exact ResEqv_nvis (not_VisD_none (by rw [e]; exact hsto))
      (not_VisD_none (E := seeE E1 lbl F) (by rw [e]; exact hsto))
  · exact ResEqv_congr (E := E1) (E' := seeE E1 lbl F) rfl rfl (by simp [seeE, e]) rfl

theorem MemInv_promLt {g : G} {E : TEnv} {s : St} (hm : MemInv g E s) :
    ∀ t, t ∈ s.promises → t < s.mem.size :=
  hm.2.2.1

theorem pSum_prom {s s' : St} (f : Ts → Res) (e : s'.promises = s.promises) : pSum s' f = pSum s f := by
  unfold pSum; rw [e]

/-- (S4f) Summing over a sublist of a duplicate-free list loses only zeros. -/
theorem sum_sublist_zero {f : Ts → Res} {L' L : List Ts} (hs : L'.Sublist L) :
    L.Nodup → (∀ t, t ∈ L → t ∉ L' → f t = .zero) → Res.sum (L'.map f) = Res.sum (L.map f) := by
  induction hs with
  | slnil => intro _ _; rfl
  | cons a h ih =>
      intro hnd hz
      have ha' : a ∉ _ := fun hm => (List.nodup_cons.1 hnd).1 (h.subset hm)
      rw [ih (List.nodup_cons.1 hnd).2 (fun t ht hn => hz t (List.mem_cons_of_mem _ ht) hn)]
      simp only [List.map_cons, Res.sum_cons, hz a List.mem_cons_self ha', Res.zero_add]
  | cons_cons a h ih =>
      intro hnd hz
      rw [List.map_cons, List.map_cons, Res.sum_cons, Res.sum_cons,
        ih (List.nodup_cons.1 hnd).2 (fun t ht hn => hz t (List.mem_cons_of_mem _ ht) (fun hm => ?_))]
      rcases List.mem_cons.1 hm with e | e
      · subst e; exact (List.nodup_cons.1 hnd).1 ht
      · exact hn e

theorem CrKeep_pack {E E' : TEnv} {s s' : St} (hlt : ∀ t, t ∈ s.promises → t < s.mem.size)
    (hnd : s.promises.Nodup) (h : CrKeep E E' s s') : CrPack E E' s s' := by
  intro cr db hC
  obtain ⟨hsub, -, hm, hv, hz⟩ := h
  have hzero : ∀ t, t ∈ s.promises → t ∉ s'.promises → cr t = .zero ∧ db t = .zero := by
    intro t ht hn
    obtain ⟨m, hm1, hd, hc⟩ := hC t ht
    refine ⟨?_, (DbRes_nvisU (hz t m ht hn hm1)).1 hd⟩
    rcases hc with ⟨w, -, hcw⟩ | ⟨-, hcz⟩
    · exact VRes_nvis (fun x => hz t m ht hn hm1 (Or.inl x)) _ _ hcw
    · exact hcz
  refine ⟨fun tw htw => ?_, sum_sublist_zero hsub hnd (fun t ht hn => (hzero t ht hn).1),
    sum_sublist_zero hsub hnd (fun t ht hn => (hzero t ht hn).2)⟩
  have ht0 := hsub.subset htw
  obtain ⟨m, hm1, hd, hc⟩ := hC tw ht0
  have hlt' := hlt tw ht0
  refine ⟨m, by rw [hm tw hlt']; exact hm1, DbRes_mem hm hlt'
    ((hv tw m htw hm1).2.2 _ m tw _ rfl hd), ?_⟩
  rcases hc with ⟨w, hw, hcw⟩ | ⟨hnw, hcz⟩
  · exact Or.inl ⟨w, (PredAt_prefix hm (Nat.le_of_lt hlt')).1 hw, ((hv tw m htw hm1).2.1 _ _).2 hcw⟩
  · exact Or.inr ⟨fun w hw => hnw w ((PredAt_prefix hm (Nat.le_of_lt hlt')).2 hw), hcz⟩

/-- (P4 step 5a) A step that carries the credits (`CrPack`) and mints nothing
meets the step-3 statement. -/
theorem mc_ofP {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem mem' : Memory} {pairs pairs' : List Ts} {th th' : TTh}
    {η : TEnv} {Tot H' Rf Rs H : Res} {cr db : Ts → Res}
    (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hK : ThInvMP p g (CE η) (stOf mem pairs th) Sp mem' pairs' th' Tot H') (hle : Tot + H' ≤ Rf + Rs + H) :
    ∃ Tot H' C F, ThInvMCFS p g (CE η) (stOf mem pairs th) Sp mem' pairs' th' Tot H' cr db ∧
      MintStepN g η (stOf mem pairs th) (stOf mem' pairs' th') C F ∧
      Tot + H' + pSum (stOf mem' pairs' th') cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf mem' pairs' th') db + F := by
  obtain ⟨E, hF, hSK, hBV, hT, hm', hH', hP⟩ := hK
  obtain ⟨hC', e1, e2⟩ := hP cr db hC
  refine ⟨Tot, H', .zero, .zero, ⟨E, hF, (by seenT), (by boxT), hT, hm', hH', hC'⟩, .none, ?_⟩
  rw [e1, e2]
  intro k
  have h1 := hle k
  simp only [Res.add_apply, Res.zero_apply] at h1 ⊢
  omega

theorem mc_ofK {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem mem' : Memory} {pairs pairs' : List Ts} {th th' : TTh}
    {η : TEnv} {Tot H' Rf Rs H : Res} {cr db : Ts → Res}
    (hm : MemInv g (CE η) (stOf mem pairs th)) (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hK : ThInvMK p g (CE η) (stOf mem pairs th) Sp mem' pairs' th' Tot H') (hle : Tot + H' ≤ Rf + Rs + H) :
    ∃ Tot H' C F, ThInvMCFS p g (CE η) (stOf mem pairs th) Sp mem' pairs' th' Tot H' cr db ∧
      MintStepN g η (stOf mem pairs th) (stOf mem' pairs' th') C F ∧
      Tot + H' + pSum (stOf mem' pairs' th') cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf mem' pairs' th') db + F := by
  obtain ⟨E, hF, hSK, hBV, hT, hm', hH', hk⟩ := hK
  exact mc_ofP hC ⟨E, hF, (by seenT), (by boxT), hT, hm', hH', CrKeep_pack (MemInv_promLt hm) (MemInv_nodup hm) hk⟩ hle

/-- (F2′) `mc_ofK` with a mint `F` (an allocation's own-handle key). -/
theorem mc_ofKF {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem mem' : Memory} {pairs pairs' : List Ts} {th th' : TTh}
    {η : TEnv} {Tot H' Rf Rs H F : Res} {cr db : Ts → Res}
    (hm : MemInv g (CE η) (stOf mem pairs th)) (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hK : ThInvMK p g (CE η) (stOf mem pairs th) Sp mem' pairs' th' Tot H')
    (hms : MintStepN g η (stOf mem pairs th) (stOf mem' pairs' th') .zero F) (hle : Tot + H' ≤ Rf + Rs + H + F) :
    ∃ Tot H' C F, ThInvMCFS p g (CE η) (stOf mem pairs th) Sp mem' pairs' th' Tot H' cr db ∧
      MintStepN g η (stOf mem pairs th) (stOf mem' pairs' th') C F ∧
      Tot + H' + pSum (stOf mem' pairs' th') cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf mem' pairs' th') db + F := by
  obtain ⟨E, hF, hSK, hBV, hT, hm', hH', hk⟩ := hK
  obtain ⟨hC', e1, e2⟩ := CrKeep_pack (MemInv_promLt hm) (MemInv_nodup hm) hk cr db hC
  refine ⟨Tot, H', .zero, F, ⟨E, hF, (by seenT), (by boxT), hT, hm', hH', hC'⟩, hms, ?_⟩
  rw [e1, e2]
  intro k
  have h1 := hle k
  simp only [Res.add_apply, Res.zero_apply] at h1 ⊢
  omega

/-- (F2′) Lifting an allocating step-2 lemma: the fresh label's own-handle key is minted. -/
theorem mc_liftF {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {η : TEnv}
    {Rf Rs H : Res} {cr db : Ts → Res} {l : AllocLabel}
    (hm : MemInv g (CE η) (stOf mem pairs th)) (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (h : tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th,
      ∃ Tot H', ThInvMK p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧
        FreshIn g (stOf mem pairs th).nalloc (stOf r.1 r.2.1 r.2.2).nalloc l ∧
        Tot + H' ≤ Rf + Rs + H + Res.one (.own l)) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F :=
  ⟨h.1, fun r hr => by
    obtain ⟨Tot, H', hK, hf, hle⟩ := h.2 r hr
    exact mc_ofKF hm hC hK (.alloc hf (FreshIn_sto hm.2.2.2.1 hf)) hle⟩

/-- (P4 step 5a) Lifting a step-2 lemma (`ThInvMP` form) to the step-3 statement. -/
theorem mc_liftP {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {η : TEnv}
    {Rf Rs H : Res} {cr db : Ts → Res} (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (h : tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th,
      ∃ Tot H', ThInvMP p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F :=
  ⟨h.1, fun r hr => by
    obtain ⟨Tot, H', hK, hle⟩ := h.2 r hr
    exact mc_ofP hC hK hle⟩

/-- (P4 step 5a) Lifting a step-2 lemma (`ThInvMK` form) to the step-3 statement. -/
theorem mc_lift {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {η : TEnv}
    {Rf Rs H : Res} {cr db : Ts → Res}
    (hm : MemInv g (CE η) (stOf mem pairs th)) (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (h : tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th,
      ∃ Tot H', ThInvMK p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F :=
  ⟨h.1, fun r hr => by
    obtain ⟨Tot, H', hK, hle⟩ := h.2 r hr
    exact mc_ofK hm hC hK hle⟩


/-- (HPA) `mc_lift`, per result with its `PromAbove`. -/
theorem mc_liftA {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {η : TEnv}
    {Rf Rs H : Res} {cr db : Ts → Res}
    (hm : MemInv g (CE η) (stOf mem pairs th)) (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (h : tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      ∃ Tot H', ThInvMK p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F :=
  ⟨h.1, fun r hr hp => by
    obtain ⟨Tot, H', hK, hle⟩ := h.2 r hr hp
    exact mc_ofK hm hC hK hle⟩
/-- **(P4) `load` at an own pointer, with resources**: memory and its holding
are unchanged; the loaded value is copyable, so it binds carrying nothing. -/
theorem tstepMR_loadOwn {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {acq : Bool} {a : At} {u : Ty} {e : Expr}
    {Rf Rs H : Res}
    (hterm : th.term = .let_ x (.load acq a) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.ptr .own u)) (hnw : wordOf (Ty.ptr .own u) = none)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      ∃ Tot H', ThInvMK p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | loadWord hp hw _ _ => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | loadPub hp _ hc _ _ _ => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | loadRgn hp _ hc _ _ _ => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | loadCap hp _ hc _ _ _ _ => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | loadTorn hp _ hc _ _ _ => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | loadOwn hp _ hc haf hb =>
  obtain ⟨t, u', hp, hc, haf, hb⟩ : ∃ t u', cx.peek a = .ok t ∧ cellOf t = some (.own, u') ∧
      affine cx.ke u' = false ∧ cx.bind x u' = .ok c' := ⟨_, _, hp, hc, haf, hb⟩
  rw [hpk] at hp; cases hp
  simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc; subst hc
  have hi0 := hi.1
  have hnwc : wordOf (close th.σs (.ptr .own u)) = none := by
    rw [close_ptr]; exact wordOf_ptr_of_wordFree (wordFree_close hi0.2.2.2.2.2.1 u (wordFreeIn_of_affine u haf))
  obtain ⟨lab, c, pw, ru, hea, hpw, hsto, hcty, hacc, hown, hsku, hsig⟩ := ownPtr_view hi0 hpk htv (bind_opaqueOK hb)
  have hwr : wordOf (Ty.ptr .own ru) = none := by
    cases ru with
    | word r P =>
        obtain ⟨r', hX⟩ := eskel_word (show etok (skel (close th.σs u)) = .word (.lit 0) P by rw [← hsku]; rfl)
        rw [close_ptr, hX] at hnwc; simp [wordOf] at hnwc
    | _ => rfl
  have hna : ∀ N e', c.ty ≠ .array (.lit N) e' := fun N e' h =>
    hacc (by rw [h]; simp [accs])
  obtain ⟨us, hus, ⟨r0, hr0⟩, hld, hstw⟩ := ownLoad (arch := g.arch) (pw := pw) (acq := acq) (s := stOf mem pairs th)
    hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hsto hown (Fd_lay hcty).1 (Fd_lay hcty).2.1
    (fun ws => ((Fd_lay hcty).2.2.2 ws).1) (fun R ws => (Fd_VR η hcty).1) hna hsku (peek_cell_lyt hi0.2.1 hpk hea rfl rfl).2 hsig
    (by rw [(Fd_lay hcty).2.2.1]; exact pub_accs hi0.2.2.2.1 hi0.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi0.2.1 htv hpk rfl (bind_opaqueOK hb) hea rfl)
  have key : tstep g mem pairs th =
      (loadUnits g.arch pw ⟨lab, 0⟩ acq us 0 (stOf mem pairs th)).map fun (s', ws) =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, ru, ws) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, cellOf, addrOf, hpw, hwr, Option.isSome_none,
      Bool.false_eq_true, ↓reduceIte, hus, List.map_map]; rfl
  rw [key] at ⊢
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hr0), fun r hr hpr0 => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨⟨s', wsr⟩, hl, rfl⟩ := hr
  obtain ⟨hvr, hlay, f1, f2, f3, f4, f5⟩ := hld (s', wsr) hl (hpr0)
  have htb : tb cx.ke.length u = true := tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.ptr .own u) = some (.own, u))
  have hvz : VRR ρ η u (shp ru) wsr .zero := VR_VRR_copy_finv hi0 hE haf htb hvr
  have hfr := bindR hb hi (RLink_of hE.2.1 hE.2.2) hvz hlay
  rw [Res.add_zero] at hfr
  refine ⟨Rf + Rs, H, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Rf, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
    MemInv_load hm f1 f2 f3 f4 f5 (loadUnits_relSt _ _ _ _ hl) (loadUnits_vWr _ _ _ _ hl),
    MemHeldK_eqs hH f1 f4, CrKeep_eqs f1 f4⟩, Res.le_refl _⟩

/-- (P4) `VRR` at `μ` is `VRR` at its unfolding, for a guarded body. -/
theorem VRR_unfold {η : TEnv} {ρ : Nat → Nat} {b : Ty} (hg : b.unguarded 0 = false) (rt : Shp)
    (ws : List Word) (X : Res) : VRR ρ η (unfold1 (.mu b)) rt ws X ↔ VRR ρ η (.mu b) rt ws X := by
  have e1 : unfold1 (.mu b) = substTs [.mu b] 0 0 b := substT_eq (.mu b) b 0 0
  rw [e1]
  refine (VRR_substTs [.mu b] η ρ b [] 0 ρ rt ws X (fun _ => rfl)).trans ?_
  have hr1 : ∀ k, k ≠ 0 →
      (TEnv.pre [] (subE ρ η [.mu b])).rrs k = (η.push0 (cl ρ η.wit 0 0 (.mu b))).rrs k := by
    intro k hk
    cases k with
    | zero => exact absurd rfl hk
    | succ k => simp [TEnv.pre, subE, TEnv.push0, TEnv.ins, TEnv.insR]
  have hu1 : ∀ k, k ≠ 0 →
      (TEnv.pre [] (subE ρ η [.mu b])).urrs k = (η.push0 (cl ρ η.wit 0 0 (.mu b))).urrs k := by
    intro k hk
    cases k with
    | zero => exact absurd rfl hk
    | succ k => simp [TEnv.pre, subE, TEnv.push0, TEnv.ins, TEnv.insR]
  have hw1 : (TEnv.pre [] (subE ρ η [.mu b])).wit = (η.push0 (cl ρ η.wit 0 0 (.mu b))).wit := by
    funext k; cases k <;> simp [TEnv.pre, subE, TEnv.push0, TEnv.ins, TEnv.insR]
  simp only [VRR]
  exact VRR_relsG b 0 _ _ ρ rt ws X hg hr1 hu1 hw1 rfl

/-- (P4) `VRR_unfold` on closures, at closed witnesses. -/
theorem VRR_cl_unfold (E : TEnv) {ρ ρ₀ : Nat → Nat} {W : Nat → Ty} (hW : ∀ k, Clo (W k)) {s : Ty}
    (hg : s.unguarded 0 = false) {R : Shp} {ws : List Word} {X : Res} :
    VRR ρ₀ (CE E) (cl ρ W 0 0 (unfold1 (.mu s))) R ws X ↔ VRR ρ₀ (CE E) (cl ρ W 0 0 (.mu s)) R ws X := by
  have hc := Coh_envW E hW
  have hr := CohR_envW E hW
  have key : ∀ t, VRR ρ (TEnv.pre [] (envW E W)) t R ws X ↔
      VRR ρ₀ (TEnv.pre [] (CE (envW E W))) (cl ρ (envW E W).wit ([] : List Ty).length 0 t) R ws X :=
    fun t => VRR_close hc hr ρ t [] 0 ρ ρ₀ R ws X (fun _ => rfl) (fun _ hk => absurd hk (Nat.not_lt_zero _))
  exact (key _).symm.trans ((VRR_unfold hg R ws X).trans (key _))

/-- (P4) `Fd` keeps the values with their resources. -/
theorem Fd_VRR (E : TEnv) {ρ₀ : Nat → Nat} {T U : Ty} (h : Fd T U) {R : Shp} {ws : List Word} {X : Res} :
    VRR ρ₀ (CE E) T R ws X ↔ VRR ρ₀ (CE E) U R ws X := by
  induction h with
  | refl => exact Iff.rfl
  | fold hW hg _ _ ih => exact ih.trans (VRR_cl_unfold E hW hg)


/-- (P4) A non-buffer cell's entry holds its resources at any words that are
its latest non-promise words. -/
theorem HeldEntry_vals {E : TEnv} {s : St} {l : AllocLabel} {c : Cell} {R : Res} {vals : List Word}
    (he : HeldEntry E s l R) (hsto : E.sto l = some c) (hna : ∀ N e, c.ty ≠ .array (.lit N) e)
    (hwc : wc c.ty = some vals.length)
    (hv : ∀ o w, vals[o]? = some w → LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w) : ValOfR E c.ty vals R := by
  obtain ⟨vals0, hL, hC⟩ := he.2 c hsto
  rcases hC with ⟨h1, h2⟩ | ⟨N, e, _, _, hT, _⟩
  · have hl : vals0.length = vals.length := by
      rw [hwc] at h1; exact (Option.some.inj h1).symm
    have e0 : vals0 = vals := List.ext_getElem? fun o => by
      cases h0 : vals0[o]? with
      | none =>
          have : vals.length ≤ o := by rw [← hl]; exact List.getElem?_eq_none_iff.1 h0
          exact (List.getElem?_eq_none_iff.2 this).symm
      | some w0 =>
          obtain ⟨hlt, -⟩ := List.getElem?_eq_some_iff.1 h0
          have hlt' : o < vals.length := hl ▸ hlt
          rw [List.getElem?_eq_getElem hlt']
          exact congrArg some (LatestNP_uniq (hL o w0 h0) (hv o _ (List.getElem?_eq_getElem hlt')))
    subst e0; exact h2
  · exact absurd hT (hna N e)

/-- (P4) The words a whole-value own store leaves in the cell are its latest. -/
theorem storeOwn_latest {s' : St} {lab : AllocLabel} {us : List Acc} {ws : List Word} {V : Ts}
    (hlen : ws.length = nWords us)
    (g2 : ∀ (j : Nat) w, j < nWords us → ws[j]? = some w →
      Latest s'.mem s'.vs.coh (offs ⟨lab, 0⟩ (0 + j)) (bumpW V w)) :
    ∀ o v, (ws.map (bumpW V))[o]? = some v → Latest s'.mem s'.vs.coh ⟨lab, o⟩ v := by
  intro o w' hw'
  obtain ⟨w, hw, rfl⟩ : ∃ w, ws[o]? = some w ∧ bumpW V w = w' := by
    rw [List.getElem?_map] at hw'
    cases h : ws[o]? with
    | none => simp [h] at hw'
    | some w => simp only [h, Option.map_some, Option.some.injEq] at hw'; exact ⟨w, rfl, hw'⟩
  have hlt : o < nWords us := by
    rw [← hlen]; exact (List.getElem?_eq_some_iff.1 hw).1
  simpa [offs] using g2 o w hlt hw

/-- (S4f) `LatestNP_growsAtA` with own promises at `l` fulfilled. -/
theorem LatestNP_growsAtF {E : TEnv} {s s' : St} {l l' : AllocLabel} {o : Nat} {w : Word}
    (hg : GrowsAt s.mem s'.mem l) (hsub : ∀ t, t ∈ s'.promises → t ∈ s.promises)
    (hful : ∀ t, t ∈ s.promises → t ∉ s'.promises → ∃ m, s.mem[t]? = some m ∧ m.loc.label = l)
    (hne : l' ≠ l) (h : LatestNP s.mem (PromAt E s ⟨l', o⟩) ⟨l', o⟩ w) :
    LatestNP s'.mem (PromAt E s' ⟨l', o⟩) ⟨l', o⟩ w := by
  refine PromAt_atSame (AtSame_growsL hg.2.1 hg.2.2 hne (fun t m hm hl => ⟨fun h => ?_, hsub t⟩)) h
  exact Classical.byContradiction fun hn => by
    obtain ⟨m2, hm2, hl2⟩ := hful t h hn
    rw [hm] at hm2; cases hm2
    rw [hl] at hl2; exact hne hl2

/-- (S4f) The promises a store fulfils are at its address's label. -/
theorem storeUnits_fulL {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool}
    {us : List Acc} {ws : List Word} {s s' : St} (hpl : PromLt s)
    (hs : s' ∈ storeUnits k arch pw a rel us ws 0 s) :
    ∀ t, t ∈ s.promises → t ∉ s'.promises → ∃ m, s.mem[t]? = some m ∧ m.loc.label = a.label := by
  intro t h1 h2
  obtain ⟨m, j, w, hm, -, -, hl, -⟩ := (storeUnits_promF us ws 0 s s' hpl hs).2.2 t h1 h2
  exact ⟨m, hm, by rw [hl]; rfl⟩

/-- (S4f) A store keeps memory's holding at every other label. -/
theorem MemHeldX_store {E : TEnv} {s s' : St} {H : Res} {k : Promises.Knobs} {arch : Arch} {pw : Word}
    {a : Address} {rel : Bool} {us : List Acc} {ws : List Word} (hX : MemHeldX E s a.label H) (hpl : PromLt s)
    (hs : s' ∈ storeUnits k arch pw a rel us ws 0 s) : MemHeldX E s' a.label H :=
  MemHeldX_tr hX (fun _ _ => rfl) (fun _ _ => rfl)
    (fun _ hne _ _ hl => LatestNP_growsAtF (storeUnits_growsF us ws 0 s s' hs).1
      (storeUnits_growsF us ws 0 s s' hs).2.1 (storeUnits_fulL hpl hs) hne hl) id


theorem CellR_up {η : TEnv} {n nr : Nat} {T : Ty} {vals vals' : List Word} {Rs : List Res} (hw : WLe vals vals')
    (h : CellR η n nr T vals Rs) : CellR η n nr T vals' Rs := by
  rcases h with ⟨h1, R, h2, rfl⟩ | ⟨N, e, us, hT, hu, hn, hl, hRs, hj⟩
  · exact Or.inl ⟨by rw [← hw.length]; exact h1, R, ValOfR_up hw h2, rfl⟩
  · exact Or.inr ⟨N, e, us, hT, hu, hn, by rw [← hw.length]; exact hl, hRs,
      fun j Rj q1 q2 => slotR_imp (hj j Rj q1 q2) rfl (ValOfR_up (WLe.take _ (WLe.drop _ hw)))⟩
#print axioms CellR_up

/-- (H, pins) `HeldEntry_ownP` along the list. -/
theorem HeldEntryL_ownP {E : TEnv} {s : St} {l : AllocLabel} {c : Cell} {vals : List Word} {Rs : List Res}
    (hsto : E.sto l = some c) (hnv : ∀ o, PromAt E s ⟨l, o⟩ = s.promises)
    (hlat : ∀ o v, vals[o]? = some v → LatestP s.mem s.promises s.vs.coh ⟨l, o⟩ v)
    (hc : CellR E (E.ini l) (E.rc l) c.ty vals Rs) : HeldEntryL E s l Rs := by
  refine ⟨fun h => (by rw [hsto] at h; cases h), fun c' hc' => ?_⟩
  rw [hsto] at hc'; cases hc'
  obtain ⟨vals', hw, hp⟩ := exists_WLe_pick (P := fun o w => LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w) vals
    (fun o v hv => LatestP_NP (hnv o) (hlat o v hv))
  exact ⟨vals', hp, CellR_up hw hc⟩
#print axioms HeldEntryL_ownP

/-- (H, pins) `HeldEntry_ownN` along the list. -/
theorem HeldEntryL_ownN {E : TEnv} {s : St} {l : AllocLabel} {c : Cell} {vals : List Word} {Rs : List Res}
    (hsto : E.sto l = some c) (hn : NVP E s l)
    (hlat : ∀ o v, vals[o]? = some v → LatestP s.mem s.promises s.vs.coh ⟨l, o⟩ v)
    (hc : CellR E (E.ini l) (E.rc l) c.ty vals Rs) : HeldEntryL E s l Rs := by
  refine ⟨fun h => (by rw [hsto] at h; cases h), fun c' hc' => ?_⟩
  rw [hsto] at hc'; cases hc'
  obtain ⟨vals', hw, hp⟩ := exists_WLe_pick (P := fun o w => LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w) vals
    (fun o v hv => LatestP_NPN hn (hlat o v hv))
  exact ⟨vals', hp, CellR_up hw hc⟩
#print axioms HeldEntryL_ownN

theorem MemHeldXL_store {E : TEnv} {s s' : St} {H : Res} {S : AllocLabel → List Res} {k : Promises.Knobs}
    {arch : Arch} {pw : Word}
    {a : Address} {rel : Bool} {us : List Acc} {ws : List Word} (hX : MemHeldXL E s a.label H S) (hpl : PromLt s)
    (hs : s' ∈ storeUnits k arch pw a rel us ws 0 s) : MemHeldXL E s' a.label H S :=
  MemHeldXL_tr hX (fun _ _ => rfl) (fun _ _ => rfl)
    (fun _ hne _ _ hl => LatestNP_growsAtF (storeUnits_growsF us ws 0 s s' hs).1
      (storeUnits_growsF us ws 0 s s' hs).2.1 (storeUnits_fulL hpl hs) hne hl) id
#print axioms MemHeldXL_store

/-- (H, pins) A step's lists: label `l`'s list kept or one slot `k` set, `k` below the count
`nI` the write was typed against (or below the real count); other labels' lists kept. -/
def SSet (E : TEnv) (nI : AllocLabel → Nat) (S S' : AllocLabel → List Res) (l : AllocLabel) : Prop :=
  (∀ l', l' ≠ l → S' l' = S l') ∧
    (S' l = S l ∨ ∃ k R', S' l = (S l).set k R' ∧
      ∀ c N e, E.sto l = some c → c.ty = .array (.lit N) e → k < nI l ∨ k < E.rc l)

theorem SSet_refl (E : TEnv) (nI : AllocLabel → Nat) (S : AllocLabel → List Res) (l : AllocLabel) :
    SSet E nI S S l :=
  ⟨fun _ _ => rfl, Or.inl rfl⟩
#print axioms SSet_refl

/-- (H, pins) `SSet` keeps the region when the write is typed below the real count, or the
cell is no buffer. -/
theorem SSet.keep {E : TEnv} {nI : AllocLabel → Nat} {S S' : AllocLabel → List Res} {l : AllocLabel}
    (h : SSet E nI S S' l)
    (hn : nI l ≤ E.rc l ∨ (∀ o, ¬ PredU E ⟨l, o⟩)) : SKeep E S S' := by
  intro l' c N e us j R hc hT hu hj hR
  by_cases e' : l' = l
  · subst e'
    rcases h.2 with h2 | ⟨k, R', h2, hk⟩
    · rw [h2]; exact hR
    · rw [h2]
      have hkr : k < E.rc l' := by
        rcases hk c N e hc hT with h3 | h3
        · rcases hn with h4 | h4
          · exact Nat.lt_of_lt_of_le h3 h4
          · exact absurd hj (h4 _)
        · exact h3
      have hkj : k ≠ j := fun h => absurd (h ▸ hkr) (Nat.not_lt.2 (PredU_slot_ge hc hT hu hj))
      rw [List.getElem?_set_ne hkj]; exact hR
  · rw [h.1 l' e']; exact hR
#print axioms SSet.keep

theorem MemHeldK_ofSSet {E : TEnv} {s0 s : St} {H : Res} {nI : AllocLabel → Nat} {S S' : AllocLabel → List Res}
    {l : AllocLabel} (h : MemHeldL E s H S') (hs : SSet E nI S S' l)
    (hn : nI l ≤ E.rc l ∨ (∀ o, ¬ PredU E ⟨l, o⟩)) : MemHeldK E s0 S E s H :=
  ⟨S', h, (hs.keep hn).toT s0 s⟩
#print axioms MemHeldK_ofSSet

theorem MemHeldK_ofSSetE {E : TEnv} {s0 s : St} {H : Res} {S : AllocLabel → List Res} {l : AllocLabel}
    (h : ∃ S', MemHeldL E s H S' ∧ SSet E E.rc S S' l) : MemHeldK E s0 S E s H :=
  let ⟨_, h1, h2⟩ := h
  MemHeldK_ofSSet h1 h2 (Or.inl (Nat.le_refl _))
#print axioms MemHeldK_ofSSetE

/-- (S4f) `storeOwn_latest` with own promises (`LatestP`). -/
theorem storeOwn_latestP {s' : St} {lab : AllocLabel} {us : List Acc} {ws : List Word} {V : Ts}
    (hlen : ws.length = nWords us)
    (g2 : ∀ (j : Nat) w, j < nWords us → ws[j]? = some w →
      LatestP s'.mem s'.promises s'.vs.coh (offs ⟨lab, 0⟩ (0 + j)) (bumpW V w)) :
    ∀ o v, (ws.map (bumpW V))[o]? = some v → LatestP s'.mem s'.promises s'.vs.coh ⟨lab, o⟩ v := by
  intro o w' hw'
  obtain ⟨w, hw, rfl⟩ : ∃ w, ws[o]? = some w ∧ bumpW V w = w' := by
    rw [List.getElem?_map] at hw'
    cases h : ws[o]? with
    | none => simp [h] at hw'
    | some w => simp only [h, Option.map_some, Option.some.injEq] at hw'; exact ⟨w, rfl, hw'⟩
  have hlt : o < nWords us := by
    rw [← hlen]; exact (List.getElem?_eq_some_iff.1 hw).1
  simpa [offs] using g2 o w hlt hw

/-- (S4f) An own cell's latest words, own promises skipped: a word that is
the latest (own promises skipped) message's value at each address. -/
theorem LatestP_NPmsg {E : TEnv} {s : St} {l : AllocLabel} {o : Nat} {v : Word}
    (hown : PromAt E s ⟨l, o⟩ = s.promises)
    (h : LatestP s.mem s.promises s.vs.coh ⟨l, o⟩ v) :
    ∃ w, WLe1 v w ∧ (LatestP s.mem s.promises s.vs.coh ⟨l, o⟩ w ∧
      LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w) := by
  obtain ⟨⟨m, hm, hloc, hval, hview⟩, hn, hlast⟩ := h
  rw [hown]
  exact ⟨mw m, ⟨hval.symm, fun a g hv => hview a g hv⟩,
    ⟨⟨m, hm, hloc, rfl, fun _ _ _ => Nat.le_refl _⟩, hn, hlast⟩, s.vs.coh ⟨l, o⟩, m, hn, hm, hloc, rfl, hlast⟩

/-- (S4f) `own_msgWords` with own promises: no `NoProm` needed. -/
theorem own_msgWordsP {E : TEnv} {s : St} {l : AllocLabel} (hown : ∀ o, PromAt E s ⟨l, o⟩ = s.promises)
    (vals : List Word)
    (hlat : ∀ o v, vals[o]? = some v → LatestP s.mem s.promises s.vs.coh ⟨l, o⟩ v) :
    ∃ vals', WLe vals vals' ∧ ∀ o w, vals'[o]? = some w →
      LatestP s.mem s.promises s.vs.coh ⟨l, o⟩ w ∧ LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w :=
  exists_WLe_pick (P := fun o w => LatestP s.mem s.promises s.vs.coh ⟨l, o⟩ w ∧
    LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w) vals
    (fun o v hv => LatestP_NPmsg (hown o) (hlat o v hv))

/-- (S8-pre) `LatestP_NPmsg` under `NVP`. -/
theorem LatestP_NPmsgN {E : TEnv} {s : St} {l : AllocLabel} {o : Nat} {v : Word} (hn : NVP E s l)
    (h : LatestP s.mem s.promises s.vs.coh ⟨l, o⟩ v) :
    ∃ w, WLe1 v w ∧ (LatestP s.mem s.promises s.vs.coh ⟨l, o⟩ w ∧
      LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w) := by
  by_cases hv : VisU E ⟨l, o⟩
  · obtain ⟨⟨m, hm, hloc, hval, hview⟩, hnp, hlast⟩ := h
    rw [PromAt_word hv]
    exact ⟨mw m, ⟨hval.symm, fun a g hv' => hview a g hv'⟩,
      ⟨⟨m, hm, hloc, rfl, fun _ _ _ => Nat.le_refl _⟩, hnp, hlast⟩,
      (LatestNP_noProm (fun t m' ht hm' => hn.1 o t m' hv ht hm')).1 ⟨s.vs.coh ⟨l, o⟩, m, hnp, hm, hloc, rfl, hlast⟩⟩
  · by_cases hvis : Vis E l
    · obtain ⟨⟨m, hm, hloc, hval, hview⟩, hnp, hlast⟩ := h
      rw [PromAt_nword hv (hn.2.2 o), FpAt_vis (a := ⟨l, o⟩) hvis]
      exact ⟨mw m, ⟨hval.symm, fun a g hv' => hview a g hv'⟩,
        ⟨⟨m, hm, hloc, rfl, fun _ _ _ => Nat.le_refl _⟩, hnp, hlast⟩,
        LatestNP_appNo (fun t m' ht hm' hl => (hn.2.1 hvis t ht).2 m' hm' (by rw [hl]))
          ⟨s.vs.coh ⟨l, o⟩, m, hnp, hm, hloc, rfl, hlast⟩⟩
    · exact LatestP_NPmsg (PromAt_nwordP hv (hn.2.2 o) (FpAt_priv (a := ⟨l, o⟩) hvis)) h

/-- (S8-pre) `own_msgWordsP` under `NVP`. -/
theorem own_msgWordsN {E : TEnv} {s : St} {l : AllocLabel} (hn : NVP E s l) (vals : List Word)
    (hlat : ∀ o v, vals[o]? = some v → LatestP s.mem s.promises s.vs.coh ⟨l, o⟩ v) :
    ∃ vals', WLe vals vals' ∧ ∀ o w, vals'[o]? = some w →
      LatestP s.mem s.promises s.vs.coh ⟨l, o⟩ w ∧ LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w :=
  exists_WLe_pick (P := fun o w => LatestP s.mem s.promises s.vs.coh ⟨l, o⟩ w ∧
    LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w) vals
    (fun o v hv => LatestP_NPmsgN hn (hlat o v hv))

/-- **(P4) `xchg` at an own pointer, with resources**: the old value comes out
to the frame with the cell's resources; the new value's go to the cell. -/
theorem tstepMR_xchgOwn {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {a v : At} {u : Ty} {e : Expr} {Rf Rs H : Res}
    (hterm : th.term = .let_ x (.xchg a v) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.ptr .own u))
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hnvp : OwnNVP (CE η) (stOf mem pairs th))
    (hRF : OwnFrontierRMW (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      ∃ Tot H', ThInvMK p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | xchg hp hx hu hsub hb =>
  obtain ⟨t, u', o, tv, c₁, hp, hx, hu, hsub, hb⟩ : ∃ t u' o tv c₁, cx.peek a = .ok t ∧
      XchgCell cx t u' o ∧ cx.use v = .ok (tv, c₁) ∧ (SubS c₁ tv u' ∨ SubS c₁ tv o) ∧
      c₁.bind x o = .ok c' := ⟨_, _, _, _, _, hp, hx, hu, hsub, hb⟩
  rw [hpk] at hp; cases hp
  cases hx with
  | rgn _ hc _ _ _ => simp [cellOf] at hc
  | own _ hc _ =>
  simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc; subst hc
  have hi0 := hi.1
  have hsub : SubS c₁ tv u := hsub.elim id id
  have hotv : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have ho : cx.opaqueOK u = true := sub_opaqueOK hsub hotv
  have htb : tb cx.ke.length u = true := tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.ptr .own u) = some (.own, u))
  obtain ⟨lab, c, pw, ru, hea, hpw, hsto, hcty, hacc, hown, hsku, hsig⟩ := ownPtr_view hi0 hpk htv ho
  have hnv := hnvp _ _ hsto hown
  obtain ⟨rv, wsv, Rv, Rr, hev, hvv, hlv, hvrv, hi1, hle⟩ := useR hu hi hE.2.2
  have hsat : Sat c₁.facts ρ := hi1.1.1
  have hna : ∀ N e', c.ty ≠ .array (.lit N) e' := fun N e' h =>
    hacc (by rw [h]; simp [accs])
  obtain ⟨us, hus, ⟨r0, hr0⟩, hld, hstw⟩ := ownLoad (arch := g.arch) (pw := pw) (acq := false) (s := stOf mem pairs th)
    hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hsto hown (Fd_lay hcty).1 (Fd_lay hcty).2.1
    (fun ws => ((Fd_lay hcty).2.2.2 ws).1) (fun R ws => (Fd_VR η hcty).1) hna hsku (peek_cell_lyt hi0.2.1 hpk hea rfl rfl).2 hsig
    (by rw [(Fd_lay hcty).2.2.1]; exact pub_accs hi0.2.2.2.1 hi0.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi0.2.1 htv hpk rfl ho hea rfl)
  obtain ⟨hval, hlen⟩ := ownStoreVal hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 hsat hsub ho htb hvv hlv hsig hus
  have husA : accs c.ty = some us := ((Fd_lay hcty).2.2.1.trans (pub_accs hi0.2.2.2.1 hi0.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi0.2.1 htv hpk rfl ho hea rfl).symm).trans hus
  have hus' : wc c.ty = some (nWords us) := by rw [(Fd_lay hcty).2.1, ← wc_of_sig hsig]; simp [wc, hus]
  replace hval := (Fd_EnvVal (CE η) hcty).2 hval
  have hsigu : sig (close th.σs u) = sig (cl ρ η.wit 0 0 u) :=
    sig_WitL hi0.2.2.2.1 ρ ho (lt_of_guardT htb hi0.2.2.2.2.1)
  have hvalR : EnvValR (CE η) c.ty wsv Rv := by
    obtain ⟨hs, -⟩ := Lay_canon hsub hlv
    have hvu : VRR ρ η u (shp (close th.σs u)) wsv Rv := by rw [← hs]; exact VRR_sub hsat hsub _ _ _ hvrv
    have hvc : VRR (fun _ => 0) (CE η) (cl ρ η.wit 0 0 u) (shp (cl ρ η.wit 0 0 u)) wsv Rv := by
      rw [← shp_of_sig hsigu]
      exact (VRR_close hE.2.1 hE.2.2 ρ u [] 0 ρ (fun _ => 0) (shp (close th.σs u)) wsv Rv (fun k => rfl)
        (fun k hk => absurd hk (Nat.not_lt_zero _))).1 hvu
    refine ⟨?_, hval.2⟩
    rw [(Fd_lay hcty).1]
    exact (Fd_VRR η hcty).2 hvc
  -- the cell's words at their messages, and what memory holds for them
  obtain ⟨vals, hcell, hlat⟩ := own_cellP hm.2.1 hRF hsto hown
  have hwc := (hcell.plain (notArr_of_wc hus')).1
  obtain ⟨vals', hWv, hP'⟩ := own_msgWordsN (E := CE η) hnv vals hlat
  have hl' : vals'.length = nWords us := by
    rw [← hWv.length]; rw [hus'] at hwc; exact (Option.some.inj hwc).symm
  obtain ⟨R0, H0, rfl, hent0, hX⟩ := MemHeldL_focusE hH lab
  have hvR0 : ValOfR (CE η) c.ty vals' R0 :=
    HeldEntry_vals hent0 hsto hna (by rw [hus', hl']) (fun o w h => (hP' o w h).2)
  have key : tstep g mem pairs th =
      ((loadUnits g.arch pw ⟨lab, 0⟩ false us 0 (stOf mem pairs th)).flatMap fun (s1, old) =>
        (storeUnits g.k g.arch pw ⟨lab, 0⟩ false us wsv 0 s1).map fun s2 => (s2, ru, old)).map
        fun (s', t, ws) => (s'.mem, s'.pairs, withS { th with term := e, env := (x, t, ws) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hev, cellOf, addrOf, hpw, hus]
  rw [key] at ⊢
  have hm1 : ∀ r1, r1 ∈ loadUnits g.arch pw ⟨lab, 0⟩ false us 0 (stOf mem pairs th) → PromAbove r1.1 → MemInv g (CE η) r1.1 :=
    fun r1 h hp => by
      obtain ⟨_, _, f1, f2, f3, f4, f5⟩ := hld r1 h hp
      exact MemInv_load hm f1 f2 f3 f4 f5 (loadUnits_relSt _ _ _ _ h) (loadUnits_vWr _ _ _ _ h)
  obtain ⟨s2, hs2⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := pw) (a := ⟨lab, 0⟩) (rel := false)
    us wsv 0 r0.1 hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem (List.mem_flatMap.2 ⟨r0, hr0, List.mem_map_of_mem hs2⟩)),
    fun r hr hpr0 => ?_⟩
  have hpr := hpr0
  rw [List.mem_map] at hr
  obtain ⟨⟨s', t', ws'⟩, hr, rfl⟩ := hr
  rw [List.mem_flatMap] at hr
  obtain ⟨⟨s1, old⟩, h1, h2⟩ := hr
  rw [List.mem_map] at h2
  obtain ⟨s2, hs2, he2⟩ := h2
  simp only [Prod.mk.injEq] at he2
  obtain ⟨rfl, rfl, rfl⟩ := he2
  have hp1 : PromAbove s1 := storeUnits_promAbove hs2 (fun t ht m hm => hpr t ht m hm)
  obtain ⟨-, hlay, f1, -, fc, f3, -⟩ := hld (s1, old) h1 hp1
  -- the old value, with the cell's resources, at the static type
  have hWold : WLe vals' old := (loadUnits_latestPA hl'
    (fun j w hj => by simpa [offs] using (hP' j w hj).1) h1 hp1).1
  have hvold : VRR ρ η u (shp ru) old R0 := by
    have h1 := VRR_up _ _ _ _ _ hWold hvR0.1
    have h2 : VRR (fun _ => 0) (CE η) c.ty (shp c.ty) old R0 :=
      VRR_mono c.ty (CE (CE η).unsee) (CE η) _ _ _ _ (fun _ _ _ _ h => h) (fun _ _ _ _ h => h) rfl rfl rfl (fun _ _ h => h)
        (fun _ => Nat.le_refl _) (fun _ _ h => h) (fun _ h => h.elim) (fun _ _ h => h) h1
    have h3 := (Fd_VRR η hcty).1 h2
    rw [(Fd_lay hcty).1, ← shp_of_sig hsig] at h3
    exact (VRR_close hE.2.1 hE.2.2 ρ u [] 0 ρ (fun _ => 0) (shp ru) old R0 (fun k => rfl)
      (fun k hk => absurd hk (Nat.not_lt_zero _))).2 h3
  -- the store, from the loaded state
  have hm1' := hm1 (s1, old) h1 hp1
  obtain ⟨g2, -⟩ := storeUnits_latP (a := ⟨lab, 0⟩) us wsv 0 s1 s1.vs.vRelSt hm1'.2.2.1
    hm1'.2.2.2.2.2.2.2.2.2.2.1 (Nat.le_refl _) s2 hs2
  have htail : ∀ j : Nat, j < nWords us → TailP s1 (offs ⟨lab, 0⟩ (0 + j)) := fun j hj => by
    have := cellP_tailLoad (own_cellP hm.2.1 hRF hsto hown) fc (loadUnits_cohMono us 0 _ _ h1) f1 f3
      hsto hown hus' j hj
    simpa [offs] using this
  have hX1 : MemHeldXL (CE η) s1 lab H0 Sp := MemHeldXL_tr hX (fun _ _ => rfl) (fun _ _ => rfl)
    (fun l' hne o w hl => by rw [← f1] at hl; rw [PromAt_eqp f3]; exact hl) id
  have hX' : MemHeldXL (CE η) s2 lab H0 Sp := MemHeldXL_store (a := ⟨lab, 0⟩) hX1 hm1'.2.2.1 hs2
  have hent : HeldEntry (CE η) s2 lab Rv := HeldEntry_ownN hsto (NVP_store (NVP_eqs hnv f1 f3) hm1'.2.2.1 hs2)
    (storeOwn_latestP hlen (g2 htail))
    (Or.inl ⟨by rw [hus', List.length_map, hlen], hvalR.store hm1'.2.2.2.2.1⟩)
  have hfr := bindR hb hi1 (RLink_of hE.2.1 hE.2.2) hvold hlay
  refine ⟨Rr + R0 + Rs, Rv + H0, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Rr + R0, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
    MemInv_store hm1' hsto hown husA hval hlen s2 hs2, MemHeldK_unfocus hX' hent hnv.2.2,
    CrKeep_trans (CrKeep_eqs f1 f3) (CrKeep_storeN hm1' hs2 (NVP_eqs hnv f1 f3))⟩, Res.le_def.2 fun k => ?_⟩
  have h1 := hle k
  simp only [Res.add_apply] at h1 ⊢
  omega

/-! ### (P4) Components of a cell, with resources -/

theorem VRR_prod_mk {ρ : Nat → Nat} {η : TEnv} {a b : Ty} {A B : List Word} {na : Nat} {Ra Rb : Res}
    (hA : VRR ρ η a (shp a) A Ra) (hB : VRR ρ η b (shp b) B Rb) (hl : A.length = na) (hw : wc a = some na) :
    VRR ρ η (.prod a b) (shp (.prod a b)) (A ++ B) (Ra + Rb) := by
  subst hl
  simp only [VRR]
  refine ⟨shp a, shp b, rfl, Ra, Rb, rfl, fun h => ?_, fun m hm => ?_⟩
  · rw [shp_wc, hw] at h; cases h
  · rw [shp_wc, hw] at hm
    obtain rfl := Option.some.inj hm
    exact ⟨by simp, by simpa using hA, by simpa using hB⟩

/-- **(P4) A component, with resources**: a value of a laid-out type holding
`R`, at offset `o` along an `AtOff` path, splits into the component's words
holding `Rq` and the rest `Rr`; replacing the component by any value of its
type holding `Rq'` gives a value holding `Rq' + Rr`. -/
theorem VRR_at (E : TEnv) {ρ₀ : Nat → Nat} {T U : Ty} {o : Nat} (h : AtOff T o U) :
    ∀ {ws : List Word} {R : Res}, VRR ρ₀ (CE E) T (shp T) ws R → wc T = some ws.length →
      ∃ n Rq Rr, wc U = some n ∧ o + n ≤ ws.length ∧ R = Rq + Rr ∧
        VRR ρ₀ (CE E) U (shp U) ((ws.drop o).take n) Rq ∧
        ∀ q Rq', VRR ρ₀ (CE E) U (shp U) q Rq' → q.length = n →
          VRR ρ₀ (CE E) T (shp T) (ws.take o ++ q ++ ws.drop (o + n)) (Rq' + Rr) := by
  induction h with
  | here _ =>
      intro ws R hv hwc
      refine ⟨ws.length, R, .zero, hwc, by omega, (Res.add_zero _).symm, by simpa using hv, fun q Rq' hq hql => ?_⟩
      have e : ws.take 0 ++ q ++ ws.drop (0 + ws.length) = q := by simp
      rw [e, Res.add_zero]; exact hq
  | @fst a b u o _ ih =>
      intro ws R hv hwc
      simp only [VRR] at hv
      obtain ⟨ra, rb, e, Ra, Rb, hR, -, hsplit⟩ := hv
      simp only [shp, Shp.prod.injEq] at e
      obtain ⟨rfl, rfl⟩ := e
      cases ha : accs a with
      | none => simp [wc, accs, ha] at hwc
      | some ua =>
      cases hb : accs b with
      | none => simp [wc, accs, ha, hb] at hwc
      | some ub =>
      have hwa : wc a = some (nWords ua) := by simp [wc, ha]
      have hlen : ws.length = nWords ua + nWords ub := by
        simp [wc, accs, ha, hb, nWords_append] at hwc; omega
      obtain ⟨_, hva, hvb⟩ := hsplit _ (by rw [shp_wc]; exact hwa)
      have hla : (ws.take (nWords ua)).length = nWords ua := by simp; omega
      obtain ⟨n, Rq, Rr, hwu, hle, hRa, hvq, hput⟩ := ih hva (by rw [hla]; exact hwa)
      rw [hla] at hle
      rw [take_drop_take hle] at hvq
      refine ⟨n, Rq, Rr + Rb, hwu, by omega, by rw [hR, hRa, Res.add_assoc], hvq, fun q Rq' hq hql => ?_⟩
      subst hql
      have hp := hput q Rq' hq rfl
      have hsp : ws.take o ++ q ++ ws.drop (o + q.length) =
          (ws.take (nWords ua)).take o ++ q ++ (ws.take (nWords ua)).drop (o + q.length) ++
            ws.drop (nWords ua) := by
        conv => lhs; rw [← List.take_append_drop (nWords ua) ws]
        exact splice_split _ _ q o (by rw [hla]; exact hle)
      have hlA : ((ws.take (nWords ua)).take o ++ q ++ (ws.take (nWords ua)).drop (o + q.length)).length =
          nWords ua := by simp; omega
      rw [hsp, ← Res.add_assoc]
      exact VRR_prod_mk hp hvb hlA hwa
  | @snd a b u o ua0 hua _ ih =>
      intro ws R hv hwc
      simp only [VRR] at hv
      obtain ⟨ra, rb, e, Ra, Rb, hR, -, hsplit⟩ := hv
      simp only [shp, Shp.prod.injEq] at e
      obtain ⟨rfl, rfl⟩ := e
      cases hb : accs b with
      | none => simp [wc, accs, hua, hb] at hwc
      | some ub =>
      have hwa : wc a = some (nWords ua0) := by simp [wc, hua]
      have hwb : wc b = some (nWords ub) := by simp [wc, hb]
      have hlen : ws.length = nWords ua0 + nWords ub := by
        simp [wc, accs, hua, hb, nWords_append] at hwc; omega
      obtain ⟨_, hva, hvb⟩ := hsplit _ (by rw [shp_wc]; exact hwa)
      have hla : (ws.take (nWords ua0)).length = nWords ua0 := by simp; omega
      have hlb : (ws.drop (nWords ua0)).length = nWords ub := by simp; omega
      obtain ⟨n, Rq, Rr, hwu, hle, hRb, hvq, hput⟩ := ih hvb (by rw [hlb]; exact hwb)
      rw [hlb] at hle
      rw [drop_drop'] at hvq
      refine ⟨n, Rq, Ra + Rr, hwu, by omega, ?_, hvq, fun q Rq' hq hql => ?_⟩
      · subst hR; subst hRb; exact Res.ext fun k => by simp only [Res.add_apply]; omega
      subst hql
      have hp := hput q Rq' hq rfl
      have hsp : ws.take (nWords ua0 + o) ++ q ++ ws.drop (nWords ua0 + o + q.length) =
          ws.take (nWords ua0) ++ ((ws.drop (nWords ua0)).take o ++ q ++ (ws.drop (nWords ua0)).drop (o + q.length)) := by
        conv => lhs; rw [← List.take_append_drop (nWords ua0) ws]
        have := splice_snd (ws.take (nWords ua0)) (ws.drop (nWords ua0)) q o
        rwa [hla] at this
      have e2 : Rq' + (Ra + Rr) = Ra + (Rq' + Rr) := Res.ext fun k => by simp only [Res.add_apply]; omega
      rw [hsp, e2]
      exact VRR_prod_mk hva hp hla hwa
  | elem _ _ _ _ => intro ws R _ hwc; simp [wc, accs] at hwc
  | @mu ρ W s u o hW hg _ ih =>
      intro ws R hv hwc
      have hsig := sig_cl_unfold (ρ := ρ) (W := W) hg
      have e1 : cl ρ W 0 0 (.mu s) = .mu (cl ρ W 1 0 s) := rfl
      have hshp : shp (cl ρ W 0 0 (unfold1 (.mu s))) = shp (cl ρ W 0 0 (.mu s)) := by
        rw [shp_of_sig hsig, e1]; rfl
      have hv' := (VRR_cl_unfold E hW hg).2 hv
      rw [← hshp] at hv'
      have hwc' : wc (cl ρ W 0 0 (unfold1 (.mu s))) = some ws.length := by
        rw [wc_of_sig hsig, ← hwc, e1]; rfl
      obtain ⟨n, Rq, Rr, hwu, hle, hR, hvq, hput⟩ := ih hv' hwc'
      refine ⟨n, Rq, Rr, hwu, hle, hR, hvq, fun q Rq' hq hql => ?_⟩
      have hp := hput q Rq' hq hql
      rw [hshp] at hp
      exact (VRR_cl_unfold E hW hg).1 hp
  | @fold ρ W s T o hW hg ha _ ih =>
      intro ws R hv hwc
      obtain ⟨n, Rq, Rr, hn, hle, hR, hvq, hput⟩ := ih hv hwc
      have hsig := sig_cl_unfold (ρ := ρ) (W := W) hg
      have e1 : cl ρ W 0 0 (.mu s) = .mu (cl ρ W 1 0 s) := rfl
      have hshp : shp (cl ρ W 0 0 (unfold1 (.mu s))) = shp (cl ρ W 0 0 (.mu s)) := by
        rw [shp_of_sig hsig, e1]; rfl
      refine ⟨n, Rq, Rr, ?_, hle, hR, ?_, fun q Rq' hq hql => ?_⟩
      · rw [← hn, wc_of_sig hsig, e1]; rfl
      · rw [hshp] at hvq; exact (VRR_cl_unfold E hW hg).1 hvq
      · have hq' := (VRR_cl_unfold E hW hg).2 hq
        rw [← hshp] at hq'
        exact hput q Rq' hq' hql

theorem Res.sum_set_zero : ∀ (L : List Res) (j : Nat) (h : j < L.length),
    Res.sum L = L[j] + Res.sum (L.set j .zero)
  | [], _, h => absurd h (Nat.not_lt_zero _)
  | x :: L, 0, _ => by simp
  | x :: L, j + 1, h => by
      simp only [List.set_cons_succ, Res.sum_cons, List.getElem_cons_succ]
      rw [Res.sum_set_zero L j (by simpa using h)]
      exact Res.ext fun k => by simp only [Res.add_apply]; omega

theorem Res.sum_set : ∀ (L : List Res) (j : Nat) (x : Res), j < L.length →
    Res.sum (L.set j x) = x + Res.sum (L.set j .zero)
  | [], _, _, h => absurd h (Nat.not_lt_zero _)
  | y :: L, 0, x, _ => by simp
  | y :: L, j + 1, x, h => by
      simp only [List.set_cons_succ, Res.sum_cons]
      rw [Res.sum_set L j x (by simpa using h)]
      exact Res.ext fun k => by simp only [Res.add_apply]; omega

theorem nWords_zero_nil {us : List Acc} (h : nWords us = 0) : us = [] := by
  cases us with
  | nil => rfl
  | cons u us => cases u <;> simp [nWords, Acc.size] at h
#print axioms nWords_zero_nil

/-- **(P4) The target's segment, with resources** (`own_seg`): the segment's
words hold `Rs` of the cell's `R = Rs + Rr`, and putting a new segment value
holding `RQ` back gives a cell holding `RQ + Rr`. -/
theorem own_segR {E : TEnv} {a : Address} {c : Cell} {U : Ty} {vals : List Word} {R : Res}
    (hcell : CellOKR E (E.ini a.label) (E.rc a.label) c.ty vals R) (hat : AtOff c.ty a.offset U) (hini : IniAt E.ini c a U)
    (hU : ∀ N e, U ≠ .array (.lit N) e) :
    (∃ b o S wS Rs Rr, SegOf c.ty b S ∧ b + o = a.offset ∧ AtOff S o U ∧ wc S = some wS ∧ b + wS ≤ vals.length ∧
      R = Rs + Rr ∧ ValOfR E S ((vals.drop b).take wS) Rs ∧
      ∀ Q RQ, ValOfR E S Q RQ → Q.length = wS →
        CellOKR E (E.ini a.label) (E.rc a.label) c.ty (vals.take b ++ Q ++ vals.drop (b + wS)) (RQ + Rr)) ∨
    ∃ N e us, c.ty = .array (.lit N) e ∧ accs e = some us ∧ nWords us = 0 ∧ E.rc a.label = 0 ∧
      ∀ uU, accs U = some uU → nWords uU = 0 := by
  rcases hcell with ⟨hwc, hv⟩ | ⟨N, e, us, Rl, hT, hus, hn, hlen, hRl, hR, hslots⟩
  · refine Or.inl ⟨0, a.offset, c.ty, vals.length, R, .zero,
      Or.inl ⟨rfl, rfl, by obtain ⟨_, h, -⟩ := wc_some hwc; simp [h]⟩, Nat.zero_add _, hat, hwc, by simp,
      (Res.add_zero _).symm, by simpa using hv, fun Q RQ hQ hQl => ?_⟩
    have e : vals.take 0 ++ Q ++ vals.drop (0 + vals.length) = Q := by simp
    rw [e, Res.add_zero]; exact Or.inl ⟨by rw [hwc, hQl], hQ⟩
  · rcases hini N e hT with ⟨hUc, _⟩ | ⟨us', j, o, hus', hj, hjo, hato⟩
    · exact absurd (hUc.trans hT) (hU N e)
    · rw [hus] at hus'; cases hus'
      by_cases hz : nWords us = 0 ∧ E.rc a.label = 0
      · refine Or.inr ⟨N, e, us, hT, hus, hz.1, hz.2, fun uU hu => ?_⟩
        obtain ⟨pre, post, e1, -⟩ := AtOff_embed hato hus hu
        have h1 := congrArg nWords e1
        simp only [TermSound.nWords_append] at h1
        omega
      refine Or.inl ?_
      have hpick : ∃ j', j' < E.ini a.label ∧ j' * nWords us + o = a.offset ∧ (j' < E.rc a.label ∨ 0 < nWords us) := by
        by_cases hw : 0 < nWords us
        · exact ⟨j, hj, hjo, Or.inr hw⟩
        · have hw0 : nWords us = 0 := by omega
          have hr : 0 < E.rc a.label := by omega
          refine ⟨0, Nat.lt_of_lt_of_le hr (E.rc_le_ini _), ?_, Or.inl hr⟩
          rw [hw0, Nat.mul_zero] at hjo ⊢; exact hjo
      clear hj hjo
      obtain ⟨j, hj, hjo, hjr⟩ := hpick
      have hj' : j < E.ini a.label := hj
      have hjN : j + 1 ≤ N := by omega
      have hm := Nat.mul_le_mul_right (nWords us) hjN
      rw [Nat.succ_mul] at hm
      have hjl : j < Rl.length := by omega
      have hbw : j * nWords us + nWords us ≤ vals.length := by omega
      refine ⟨j * nWords us, o, e, nWords us, Rl[j], Res.sum (Rl.set j .zero),
        Or.inr ⟨N, us, j, hT, hus, by omega, rfl⟩, hjo, hato, wc_of_accs hus, hbw,
        by rw [hR]; exact Res.sum_set_zero Rl j hjl, (hslots j Rl[j] hj' (List.getElem?_eq_getElem hjl)).2 hjr,
        fun Q RQ hQ hQl => ?_⟩
      refine Or.inr ⟨N, e, us, Rl.set j RQ, hT, hus, hn, ?_, by simp [hRl], (Res.sum_set Rl j RQ hjl).symm,
        fun j' Rj hj'n hRj => ?_⟩
      · simp only [List.length_append, List.length_take, List.length_drop, hQl]; omega
      · have hsl := fun (i : Nat) => slice_get (vals.take (j * nWords us) ++ Q ++ vals.drop (j * nWords us + nWords us))
          (j' * nWords us) (nWords us) i
        by_cases hjj : j' = j
        · subst hjj
          rw [List.getElem?_set_self hjl] at hRj
          cases hRj
          have e : ((vals.take (j' * nWords us) ++ Q ++ vals.drop (j' * nWords us + nWords us)).drop
              (j' * nWords us)).take (nWords us) = Q := by
            apply List.ext_getElem?; intro i
            rw [hsl i, splice_get vals Q _ _ _ hQl hbw]
            by_cases hi : i < nWords us
            · rw [iteT hi, iteT ⟨Nat.le_add_right _ _, by omega⟩, Nat.add_sub_cancel_left]
            · rw [iteF hi, List.getElem?_eq_none (by omega)]
          rw [e]; exact ⟨fun h1 h2 => absurd hjr (by omega), fun _ => hQ⟩
        · rw [List.getElem?_set_ne (Ne.symm hjj)] at hRj
          have e : ((vals.take (j * nWords us) ++ Q ++ vals.drop (j * nWords us + nWords us)).drop
              (j' * nWords us)).take (nWords us) = (vals.drop (j' * nWords us)).take (nWords us) := by
            apply List.ext_getElem?; intro i
            rw [hsl i, slice_get vals]
            by_cases hi : i < nWords us
            · rw [iteT hi, iteT hi, splice_get vals Q _ _ _ hQl hbw, iteF ?_]
              intro hr; obtain ⟨hr1, hr2⟩ := hr
              rcases Nat.lt_or_gt_of_ne hjj with h | h
              · have hm := Nat.mul_le_mul_right (nWords us) (show j' + 1 ≤ j by omega)
                rw [Nat.succ_mul] at hm; omega
              · have hm := Nat.mul_le_mul_right (nWords us) (show j + 1 ≤ j' by omega)
                rw [Nat.succ_mul] at hm; omega
            · rw [iteF hi, iteF hi]
          rw [e]; exact hslots j' Rj hj'n hRj


/-- (H, pins) **`own_segR` along the slot list**: the segment is slot `k` of the cell's list
`Rl` (a non-buffer cell: its one share, `k = 0`), at word offset `b` (in a buffer,
`b = k * nWords us`); the put-back replaces exactly that slot. -/
theorem own_segL {E : TEnv} {a : Address} {c : Cell} {U : Ty} {vals : List Word} {Rl : List Res}
    {nI : AllocLabel → Nat} (hnI : nI a.label ≤ E.ini a.label)
    (hcell : CellR E (E.ini a.label) (E.rc a.label) c.ty vals Rl) (hat : AtOff c.ty a.offset U) (hini : IniAt nI c a U)
    (hU : ∀ N e, U ≠ .array (.lit N) e) :
    (∃ b o S wS k Rs, SegOf c.ty b S ∧ b + o = a.offset ∧ AtOff S o U ∧ wc S = some wS ∧ b + wS ≤ vals.length ∧
      Rl[k]? = some Rs ∧ ValOfR E S ((vals.drop b).take wS) Rs ∧
      (∀ N e us, c.ty = .array (.lit N) e → accs e = some us →
        b = k * nWords us ∧ (k < nI a.label ∨ k < E.rc a.label)) ∧
      ∀ Q RQ, ValOfR E S Q RQ → Q.length = wS →
        CellR E (E.ini a.label) (E.rc a.label) c.ty (vals.take b ++ Q ++ vals.drop (b + wS)) (Rl.set k RQ)) ∨
    ∃ N e us, c.ty = .array (.lit N) e ∧ accs e = some us ∧ nWords us = 0 ∧ E.rc a.label = 0 ∧
      ∀ uU, accs U = some uU → nWords uU = 0 := by
  rcases hcell with ⟨hwc, R, hv, rfl⟩ | ⟨N, e, us, hT, hus, hn, hlen, hRl, hslots⟩
  · refine Or.inl ⟨0, a.offset, c.ty, vals.length, 0, R,
      Or.inl ⟨rfl, rfl, by obtain ⟨_, h, -⟩ := wc_some hwc; simp [h]⟩, Nat.zero_add _, hat, hwc, by simp,
      rfl, by simpa using hv, fun N e us hT _ => by rw [hT] at hwc; simp [wc, accs] at hwc,
      fun Q RQ hQ hQl => ?_⟩
    have e : vals.take 0 ++ Q ++ vals.drop (0 + vals.length) = Q := by simp
    rw [e]; exact Or.inl ⟨by rw [hwc, hQl], RQ, hQ, rfl⟩
  · rcases hini N e hT with ⟨hUc, _⟩ | ⟨us', j, o, hus', hj, hjo, hato⟩
    · exact absurd (hUc.trans hT) (hU N e)
    · rw [hus] at hus'; cases hus'
      by_cases hz : nWords us = 0 ∧ E.rc a.label = 0
      · refine Or.inr ⟨N, e, us, hT, hus, hz.1, hz.2, fun uU hu => ?_⟩
        obtain ⟨pre, post, e1, -⟩ := AtOff_embed hato hus hu
        have h1 := congrArg nWords e1
        simp only [TermSound.nWords_append] at h1
        omega
      refine Or.inl ?_
      have hpick : ∃ j', j' < E.ini a.label ∧ j' * nWords us + o = a.offset ∧ (j' < E.rc a.label ∨ 0 < nWords us) ∧
          (j' < nI a.label ∨ j' < E.rc a.label) := by
        by_cases hw : 0 < nWords us
        · exact ⟨j, Nat.lt_of_lt_of_le hj hnI, hjo, Or.inr hw, Or.inl hj⟩
        · have hw0 : nWords us = 0 := by omega
          have hr : 0 < E.rc a.label := by omega
          refine ⟨0, Nat.lt_of_lt_of_le hr (E.rc_le_ini _), ?_, Or.inl hr, Or.inr hr⟩
          rw [hw0, Nat.mul_zero] at hjo ⊢; exact hjo
      clear hj hjo
      obtain ⟨j, hj, hjo, hjr, hjk⟩ := hpick
      have hj' : j < E.ini a.label := hj
      have hjN : j + 1 ≤ N := by omega
      have hm := Nat.mul_le_mul_right (nWords us) hjN
      rw [Nat.succ_mul] at hm
      have hjl : j < Rl.length := by omega
      have hbw : j * nWords us + nWords us ≤ vals.length := by omega
      refine ⟨j * nWords us, o, e, nWords us, j, Rl[j],
        Or.inr ⟨N, us, j, hT, hus, by omega, rfl⟩, hjo, hato, wc_of_accs hus, hbw,
        List.getElem?_eq_getElem hjl, (hslots j Rl[j] hj' (List.getElem?_eq_getElem hjl)).2 hjr,
        fun N' e' us' hT' hu' => by
          rw [hT] at hT'; simp only [Ty.array.injEq, Idx.lit.injEq] at hT'
          obtain ⟨-, rfl⟩ := hT'; rw [hus] at hu'; cases hu'; exact ⟨rfl, hjk⟩,
        fun Q RQ hQ hQl => ?_⟩
      refine Or.inr ⟨N, e, us, hT, hus, hn, ?_, by simp [hRl], fun j' Rj hj'n hRj => ?_⟩
      · simp only [List.length_append, List.length_take, List.length_drop, hQl]; omega
      · have hsl := fun (i : Nat) => slice_get (vals.take (j * nWords us) ++ Q ++ vals.drop (j * nWords us + nWords us))
          (j' * nWords us) (nWords us) i
        by_cases hjj : j' = j
        · subst hjj
          rw [List.getElem?_set_self hjl] at hRj
          cases hRj
          have e : ((vals.take (j' * nWords us) ++ Q ++ vals.drop (j' * nWords us + nWords us)).drop
              (j' * nWords us)).take (nWords us) = Q := by
            apply List.ext_getElem?; intro i
            rw [hsl i, splice_get vals Q _ _ _ hQl hbw]
            by_cases hi : i < nWords us
            · rw [iteT hi, iteT ⟨Nat.le_add_right _ _, by omega⟩, Nat.add_sub_cancel_left]
            · rw [iteF hi, List.getElem?_eq_none (by omega)]
          rw [e]; exact ⟨fun h1 h2 => absurd hjr (by omega), fun _ => hQ⟩
        · rw [List.getElem?_set_ne (Ne.symm hjj)] at hRj
          have e : ((vals.take (j * nWords us) ++ Q ++ vals.drop (j * nWords us + nWords us)).drop
              (j' * nWords us)).take (nWords us) = (vals.drop (j' * nWords us)).take (nWords us) := by
            apply List.ext_getElem?; intro i
            rw [hsl i, slice_get vals]
            by_cases hi : i < nWords us
            · rw [iteT hi, iteT hi, splice_get vals Q _ _ _ hQl hbw, iteF ?_]
              intro hr; obtain ⟨hr1, hr2⟩ := hr
              rcases Nat.lt_or_gt_of_ne hjj with h | h
              · have hm := Nat.mul_le_mul_right (nWords us) (show j' + 1 ≤ j by omega)
                rw [Nat.succ_mul] at hm; omega
              · have hm := Nat.mul_le_mul_right (nWords us) (show j + 1 ≤ j' by omega)
                rw [Nat.succ_mul] at hm; omega
            · rw [iteF hi, iteF hi]
          rw [e]; exact hslots j' Rj hj'n hRj
#print axioms own_segL

theorem CellOKR_len {E E' : TEnv} {n n' nr : Nat} {T : Ty} {v0 v1 : List Word} {R : Res}
    (h0 : CellOKR E n nr T v0 R) (h1 : CellOK E' n' T v1) : v0.length = v1.length := by
  rcases h0 with ⟨hw0, -⟩ | ⟨N, e, us, -, hT, hus, -, hl0, -⟩
  · rcases h1 with ⟨hw1, -⟩ | ⟨N, e, us, hT, -⟩
    · rw [hw0] at hw1; exact Option.some.inj hw1
    · rw [hT] at hw0; simp [wc, accs] at hw0
  · rcases h1 with ⟨hw1, -⟩ | ⟨N', e', us', hT', hus', -, hl1, -⟩
    · rw [hT] at hw1; simp [wc, accs] at hw1
    · rw [hT] at hT'
      simp only [Ty.array.injEq, Idx.lit.injEq] at hT'
      obtain ⟨rfl, rfl⟩ := hT'
      rw [hus] at hus'; cases hus'
      rw [hl0, hl1]

/-- (P4) A cell's entry holds its resources at any words that are its latest
non-promise words (of the cell's length). -/
theorem HeldEntry_cell {E E' : TEnv} {s : St} {l : AllocLabel} {c : Cell} {R : Res} {n' : Nat}
    {vals vals1 : List Word} (he : HeldEntry E s l R) (hsto : E.sto l = some c)
    (hc : CellOK E' n' c.ty vals1) (hl : vals.length = vals1.length)
    (hv : ∀ o w, vals[o]? = some w → LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w) : CellOKR E (E.ini l) (E.rc l) c.ty vals R := by
  obtain ⟨vals0, hL, hC⟩ := he.2 c hsto
  have hl0 : vals0.length = vals.length := by rw [CellOKR_len hC hc, hl]
  have e0 : vals0 = vals := List.ext_getElem? fun o => by
    cases h0 : vals0[o]? with
    | none =>
        have : vals.length ≤ o := by rw [← hl0]; exact List.getElem?_eq_none_iff.1 h0
        exact (List.getElem?_eq_none_iff.2 this).symm
    | some w0 =>
        obtain ⟨hlt, -⟩ := List.getElem?_eq_some_iff.1 h0
        have hlt' : o < vals.length := hl0 ▸ hlt
        rw [List.getElem?_eq_getElem hlt']
        exact congrArg some (LatestNP_uniq (hL o w0 h0) (hv o _ (List.getElem?_eq_getElem hlt')))
  subst e0; exact hC

/-! ### (P4) Latest non-promise words across a store that may fulfil promises -/

/-- (P4) A one-word store's two outcomes, with the promise set exactly. -/
theorem stepStore_casesE {k : Promises.Knobs} {arch : Arch} {mem mem' : Memory} {th th' : Promises.Thread}
    {a : Address} {e : WeakMem.Expr} {deps : List WeakMem.Reg} {rel : Bool}
    (h : (mem', th') ∈ Promises.stepStore k arch mem th a e deps rel) :
    (mem' = mem.push ⟨a, exprVal th e, Promises.storeMview th e deps rel⟩ ∧ th'.promises = th.promises) ∨
    (∃ (t : Ts) (m : Msg), mem' = mem ∧ t ∈ th.promises ∧ th'.promises = th.promises.erase t ∧
      mem[t]? = some m ∧ m.loc = a ∧ m.val = exprVal th e ∧ Promises.storeMview th e deps rel ≤ m.view) := by
  cases e <;>
  · simp only [Promises.stepStore, List.mem_append, List.mem_singleton, List.mem_filterMap] at h
    rcases h with h | ⟨t, htp, hf⟩
    · simp only [Prod.mk.injEq] at h
      obtain ⟨rfl, rfl⟩ := h
      exact Or.inl ⟨rfl, rfl⟩
    · cases hm : mem[t]? with
      | none => simp [hm] at hf
      | some m =>
          simp only [hm] at hf
          split at hf
          · rename_i hcond
            simp only [Option.some.injEq, Prod.mk.injEq] at hf
            obtain ⟨rfl, rfl⟩ := hf
            simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hcond
            exact Or.inr ⟨t, m, rfl, htp, rfl, hm, hcond.1.1.1, hcond.1.1.2, hcond.1.2⟩
          · simp at hf

/-- (P4) Appending a message elsewhere keeps a latest non-promise word. -/
theorem LatestNP_push_other {M : Memory} {P : List Ts} {B : Address} {x : Word} {m : Msg}
    (h : LatestNP M P B x) (hm : m.loc ≠ B) : LatestNP (M.push m) P B x := by
  obtain ⟨t, m0, ht, hm0, hl, hw, hlast⟩ := h
  refine ⟨t, m0, ht, by rw [push_lt (lt_of_get hm0)]; exact hm0, hl, hw, fun t' m' hlt hm' hl' => ?_⟩
  rw [Array.getElem?_push] at hm'
  by_cases e : t' = M.size
  · rw [ite_eq_left e, Option.some.injEq] at hm'; subst hm'; exact absurd hl' hm
  · rw [ite_eq_right e] at hm'; exact hlast t' m' hlt hm' hl'

/-- (P4) Discharging a promise elsewhere keeps a latest non-promise word. -/
theorem LatestNP_erase_other {M : Memory} {P : List Ts} {B : Address} {x : Word} {t : Ts}
    (h : LatestNP M P B x) (hm : ∀ m, M[t]? = some m → m.loc ≠ B) : LatestNP M (P.erase t) B x := by
  obtain ⟨t0, m0, ht, hm0, hl, hw, hlast⟩ := h
  refine ⟨t0, m0, fun h => ht (List.mem_of_mem_erase h), hm0, hl, hw, fun t' m' hlt hm' hl' => ?_⟩
  have hne : t' ≠ t := fun e => by subst e; exact hm m' hm' hl'
  exact (List.mem_erase_of_ne hne).2 (hlast t' m' hlt hm' hl')

/-- (S7i) `LatestNP_erase_other` with a foreign promise list `F` also skipped. -/
theorem LatestNP_erase_otherF {M : Memory} {P F : List Ts} {B : Address} {x : Word} {t : Ts}
    (h : LatestNP M (P ++ F) B x) (hm : ∀ m, M[t]? = some m → m.loc ≠ B) : LatestNP M (P.erase t ++ F) B x := by
  obtain ⟨t0, m0, ht, hm0, hl, hw, hlast⟩ := h
  refine ⟨t0, m0, fun h => ht ?_, hm0, hl, hw, fun t' m' hlt hm' hl' => ?_⟩
  · rcases List.mem_append.1 h with h | h
    · exact List.mem_append.2 (Or.inl (List.mem_of_mem_erase h))
    · exact List.mem_append.2 (Or.inr h)
  · have hne : t' ≠ t := fun e => by subst e; exact hm m' hm' hl'
    rcases List.mem_append.1 (hlast t' m' hlt hm' hl') with h | h
    · exact List.mem_append.2 (Or.inl ((List.mem_erase_of_ne hne).2 h))
    · exact List.mem_append.2 (Or.inr h)

/-- (P4) A message appended above every promise is its address's latest
non-promise word. -/
theorem LatestNP_push_top {M : Memory} {P : List Ts} (m : Msg) (hP : ∀ t, t ∈ P → t < M.size) :
    LatestNP (M.push m) P m.loc (mw m) :=
  ⟨M.size, m, fun h => Nat.lt_irrefl _ (hP _ h), by simp, rfl, rfl,
    fun t' m' hlt hm' _ => by have h2 := lt_of_get hm'; rw [Array.size_push] at h2; exact absurd h2 (Nat.not_lt.2 hlt)⟩

/-- (P4) Discharging a promise at `A` leaves `A`'s latest non-promise word
either the old one or the discharged message's. -/
theorem LatestNP_erase_same {M : Memory} {P : List Ts} {A : Address} {x : Word} {t : Ts} {m : Msg}
    (h : LatestNP M P A x) (hmt : M[t]? = some m) (hloc : m.loc = A) :
    LatestNP M (P.erase t) A x ∨ LatestNP M (P.erase t) A (mw m) := by
  obtain ⟨t0, m0, ht0, hm0, hl0, hw0, hlast⟩ := h
  by_cases hc : t0 < t ∧ t ∉ P.erase t
  · refine Or.inr ⟨t, m, hc.2, hmt, hloc, rfl, fun t' m' hlt hm' hl' => ?_⟩
    have hne : t' ≠ t := Nat.ne_of_gt hlt
    exact (List.mem_erase_of_ne hne).2 (hlast t' m' (Nat.lt_trans hc.1 hlt) hm' hl')
  · refine Or.inl ⟨t0, m0, fun h => ht0 (List.mem_of_mem_erase h), hm0, hl0, hw0, fun t' m' hlt hm' hl' => ?_⟩
    by_cases hne : t' = t
    · subst hne
      by_cases hin : t' ∈ P.erase t'
      · exact hin
      · exact absurd ⟨hlt, hin⟩ hc
    · exact (List.mem_erase_of_ne hne).2 (hlast t' m' hlt hm' hl')

/-- (P4) A one-word store keeps the latest non-promise word of every other
address. -/
theorem stepStore_NPkeep {k : Promises.Knobs} {arch : Arch} {mem mem' : Memory} {th th' : Promises.Thread}
    {A : Address} {e : WeakMem.Expr} {deps : List WeakMem.Reg} {rel : Bool}
    (h : (mem', th') ∈ Promises.stepStore k arch mem th A e deps rel) {B : Address} (hB : B ≠ A) {x : Word}
    (hx : LatestNP mem th.promises B x) : LatestNP mem' th'.promises B x := by
  rcases stepStore_casesE h with ⟨hmem, hpr⟩ | ⟨t, m, hmem, -, hpr, hm, hloc, -, -⟩
  · rw [hmem, hpr]; exact LatestNP_push_other hx (fun e => hB e.symm)
  · rw [hmem, hpr]
    exact LatestNP_erase_other hx (fun m' hm' => by
      rw [hm] at hm'; cases hm'; rw [hloc]; exact fun e => hB e.symm)

/-- (S7i) `stepStore_NPkeep` with a foreign promise list `F` also skipped. -/
theorem stepStore_NPkeepF {k : Promises.Knobs} {arch : Arch} {mem mem' : Memory} {th th' : Promises.Thread}
    {A : Address} {e : WeakMem.Expr} {deps : List WeakMem.Reg} {rel : Bool} {F : List Ts}
    (h : (mem', th') ∈ Promises.stepStore k arch mem th A e deps rel) {B : Address} (hB : B ≠ A) {x : Word}
    (hx : LatestNP mem (th.promises ++ F) B x) : LatestNP mem' (th'.promises ++ F) B x := by
  rcases stepStore_casesE h with ⟨hmem, hpr⟩ | ⟨t, m, hmem, htp, hpr, hm, hloc, -, -⟩
  · rw [hmem, hpr]; exact LatestNP_push_other hx (fun e => hB e.symm)
  · rw [hmem, hpr, ← List.erase_append_left (l₂ := F) htp]
    exact LatestNP_erase_other hx (fun m' hm' => by
      rw [hm] at hm'; cases hm'; rw [hloc]; exact fun e => hB e.symm)

/-- (P4) A one-word store keeps the latest word (promises included) of every
other address. -/
theorem stepStore_NPkeep0 {k : Promises.Knobs} {arch : Arch} {mem mem' : Memory} {th th' : Promises.Thread}
    {A : Address} {e : WeakMem.Expr} {deps : List WeakMem.Reg} {rel : Bool}
    (h : (mem', th') ∈ Promises.stepStore k arch mem th A e deps rel) {B : Address} (hB : B ≠ A) {x : Word}
    (hx : LatestNP mem [] B x) : LatestNP mem' [] B x := by
  rcases stepStore_casesE h with ⟨hmem, -⟩ | ⟨t, m, hmem, -⟩
  · rw [hmem]; exact LatestNP_push_other hx (fun e => hB e.symm)
  · rw [hmem]; exact hx

/-- (U3) A one-word store changes nothing at another address. -/
theorem stepStore_AtSame {k : Promises.Knobs} {arch : Arch} {mem mem' : Memory} {th th' : Promises.Thread}
    {A : Address} {e : WeakMem.Expr} {deps : List WeakMem.Reg} {rel : Bool}
    (h : (mem', th') ∈ Promises.stepStore k arch mem th A e deps rel) {B : Address} (hB : B ≠ A) :
    AtSame mem th.promises mem' th'.promises B := by
  rcases stepStore_casesE h with ⟨hmem, hpr⟩ | ⟨t, m, hmem, -, hpr, hm, hloc, -, -⟩
  · rw [hmem, hpr]; exact AtSame_push (fun e => hB e.symm)
  · rw [hmem, hpr]
    exact AtSame_erase (fun m' hm' => by rw [hm] at hm'; cases hm'; rw [hloc]; exact fun e => hB e.symm)

/-- (P4) A store keeps the latest word (at the per-address reading `PromAt`) of
every address it does not write, whether or not its units fulfil promises. -/
theorem storeUnits_NPkeep {E : TEnv} {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s s' : St), s' ∈ storeUnits k arch pw a rel us ws i s →
      ∀ (B : Address) (x : Word), (∀ j : Nat, j < nWords us → B ≠ offs a (i + j)) →
        LatestNP s.mem (PromAt E s B) B x → LatestNP s'.mem (PromAt E s' B) B x
  | [], _, _, s, s', hs => by
      simp only [storeUnits, List.mem_singleton] at hs; subst hs; exact fun _ _ _ h => h
  | .one :: us, w :: ws, i, s, s', hs => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      intro B x hB hx
      have hB0 : B ≠ offs a i := by have := hB 0 (by rw [TermMem.nWords_one]; omega); simpa using this
      refine storeUnits_NPkeep us ws (i + 1) _ s' hs B x (fun j hj => by
        have := hB (j + 1) (by rw [TermMem.nWords_one]; omega)
        rwa [show i + (j + 1) = i + 1 + j by omega] at this) (PromAt_lat (s := s) (fun F hx => ?_) (fun hx => ?_)
          (fun _ => stepStore_AtSame hst hB0) hx)
      · show LatestNP mem' (th.promises ++ F) B x
        exact stepStore_NPkeepF hst hB0 hx
      · show LatestNP mem' [] B x
        exact stepStore_NPkeep0 hst hB0 hx
  | .two :: us, w0 :: w1 :: ws, i, s, s', hs => by
      simp only [storeUnits] at hs
      obtain ⟨q1, _, _, q4, -⟩ := stepStorePair_eq s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel
      generalize Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel = R at q1 q4 hs
      obtain ⟨mem', pairs', th⟩ := R
      simp only at q1 q4 hs
      intro B x hB hx
      have hB0 : B ≠ offs a i := by have := hB 0 (by rw [TermMem.nWords_two]; omega); simpa using this
      have hB1 : B ≠ (offs a i).next := by
        have := hB 1 (by rw [TermMem.nWords_two]; omega)
        intro e; apply this; rw [e]; rfl
      refine storeUnits_NPkeep us ws (i + 2) _ s' hs B x (fun j hj => by
        have := hB (j + 2) (by rw [TermMem.nWords_two]; omega)
        rwa [show i + (j + 2) = i + 2 + j by omega] at this) (PromAt_lat (s := s) (fun F hx => ?_) (fun hx => ?_)
          (fun _ => by
            show AtSame _ _ mem' th.promises _
            rw [q1, q4]
            exact AtSame_trans (AtSame_push fun e => hB0 e.symm) (AtSame_push fun e => hB1 e.symm)) hx)
      · show LatestNP mem' (th.promises ++ F) B x
        rw [q1, q4]
        exact LatestNP_push_other (LatestNP_push_other hx (fun e => hB0 e.symm)) (fun e => hB1 e.symm)
      · show LatestNP mem' [] B x
        rw [q1]
        exact LatestNP_push_other (LatestNP_push_other hx (fun e => hB0 e.symm)) (fun e => hB1 e.symm)
  | .one :: _, [], _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [], _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, s', hs => by simp [storeUnits] at hs

/-- (P4) After a one-word store of `w` at `A`, `A`'s latest non-promise word is
(above) the stored word or is the old one. -/
theorem stepStore_NPsame {k : Promises.Knobs} {arch : Arch} {mem mem' : Memory} {th th' : Promises.Thread}
    {A : Address} {w : Word} {deps : List WeakMem.Reg} {rel : Bool} {V : Ts} {x : Word}
    (h : (mem', th') ∈ Promises.stepStore k arch mem th A (dataE 1 w) deps rel) (hr : th.regs 1 = w)
    (hV : V ≤ th.vs.vRelSt) (hP : ∀ t, t ∈ th.promises → t < mem.size)
    (hx : LatestNP mem th.promises A x) :
    ∃ (b : Bool) (x0 : Word), WLe1 (if b then bumpW V w else x) x0 ∧ LatestNP mem' th'.promises A x0 := by
  have hw : WLe1 (bumpW V w) ⟨w.val, Promises.storeMview th (dataE 1 w) deps rel, 0⟩ :=
    WLe1_msgB (WLe1_refl _) (storeMview_dataE th 1 w hr deps rel)
      (Nat.le_trans hV (storeMview_relSt th _ deps rel))
  rcases stepStore_casesE h with ⟨hmem, hpr⟩ | ⟨t, m, hmem, -, hpr, hm, hloc, hval, hmv⟩
  · refine ⟨true, _, ?_, by rw [hmem, hpr]; exact LatestNP_push_top _ hP⟩
    show WLe1 (bumpW V w) ⟨exprVal th (dataE 1 w), Promises.storeMview th (dataE 1 w) deps rel, 0⟩
    rw [exprVal_dataE th 1 w hr]; exact hw
  · rw [hmem, hpr]
    rcases LatestNP_erase_same hx hm hloc with h1 | h1
    · exact ⟨false, x, WLe1_refl _, h1⟩
    · refine ⟨true, mw m, WLe1_trans hw ⟨?_, fun _ _ _ => hmv⟩, h1⟩
      show w.val = m.val
      rw [hval, exprVal_dataE th 1 w hr]

/-- (S7i) `stepStore_NPsame` with a foreign promise list `F` also skipped. -/
theorem stepStore_NPsameF {k : Promises.Knobs} {arch : Arch} {mem mem' : Memory} {th th' : Promises.Thread}
    {A : Address} {w : Word} {deps : List WeakMem.Reg} {rel : Bool} {V : Ts} {x : Word} {F : List Ts}
    (h : (mem', th') ∈ Promises.stepStore k arch mem th A (dataE 1 w) deps rel) (hr : th.regs 1 = w)
    (hV : V ≤ th.vs.vRelSt) (hP : ∀ t, t ∈ th.promises ++ F → t < mem.size)
    (hx : LatestNP mem (th.promises ++ F) A x) :
    ∃ (b : Bool) (x0 : Word), WLe1 (if b then bumpW V w else x) x0 ∧ LatestNP mem' (th'.promises ++ F) A x0 := by
  have hw : WLe1 (bumpW V w) ⟨w.val, Promises.storeMview th (dataE 1 w) deps rel, 0⟩ :=
    WLe1_msgB (WLe1_refl _) (storeMview_dataE th 1 w hr deps rel)
      (Nat.le_trans hV (storeMview_relSt th _ deps rel))
  rcases stepStore_casesE h with ⟨hmem, hpr⟩ | ⟨t, m, hmem, htp, hpr, hm, hloc, hval, hmv⟩
  · refine ⟨true, _, ?_, by rw [hmem, hpr]; exact LatestNP_push_top _ hP⟩
    show WLe1 (bumpW V w) ⟨exprVal th (dataE 1 w), Promises.storeMview th (dataE 1 w) deps rel, 0⟩
    rw [exprVal_dataE th 1 w hr]; exact hw
  · rw [hmem, hpr, ← List.erase_append_left (l₂ := F) htp]
    rcases LatestNP_erase_same hx hm hloc with h1 | h1
    · exact ⟨false, x, WLe1_refl _, h1⟩
    · refine ⟨true, mw m, WLe1_trans hw ⟨?_, fun _ _ _ => hmv⟩, h1⟩
      show w.val = m.val
      rw [hval, exprVal_dataE th 1 w hr]

open Classical in
/-- (U3) `stepStore_NPsameF` at a predicted unit (promises above the first
write skipped). -/
theorem stepStore_NPsameP {k : Promises.Knobs} {arch : Arch} {mem mem' : Memory} {th th' : Promises.Thread}
    {A : Address} {w : Word} {deps : List WeakMem.Reg} {rel : Bool} {V : Ts} {x : Word} {F : List Ts}
    (h : (mem', th') ∈ Promises.stepStore k arch mem th A (dataE 1 w) deps rel) (hr : th.regs 1 = w)
    (hV : V ≤ th.vs.vRelSt) (hP : ∀ t, t ∈ th.promises ++ F → t < mem.size)
    (hx : LatestNP mem ((th.promises ++ F).filter fun t => decide (AboveFW mem A t)) A x) :
    ∃ (b : Bool) (x0 : Word), WLe1 (if b then bumpW V w else x) x0 ∧
      LatestNP mem' ((th'.promises ++ F).filter fun t => decide (AboveFW mem' A t)) A x0 := by
  have hw : WLe1 (bumpW V w) ⟨w.val, Promises.storeMview th (dataE 1 w) deps rel, 0⟩ :=
    WLe1_msgB (WLe1_refl _) (storeMview_dataE th 1 w hr deps rel)
      (Nat.le_trans hV (storeMview_relSt th _ deps rel))
  rcases stepStore_casesE h with ⟨hmem, hpr⟩ | ⟨t, m, hmem, htp, hpr, hm, hloc, hval, hmv⟩
  · refine ⟨true, _, ?_, by
      rw [hmem, hpr]; exact LatestNP_push_top _ (fun t ht => hP t (List.mem_filter.1 ht).1)⟩
    show WLe1 (bumpW V w) ⟨exprVal th (dataE 1 w), Promises.storeMview th (dataE 1 w) deps rel, 0⟩
    rw [exprVal_dataE th 1 w hr]; exact hw
  · rw [hmem, hpr]
    have hsub : ∀ u, u ∈ (th.promises.erase t ++ F).filter (fun t => decide (AboveFW mem A t)) →
        u ∈ (th.promises ++ F).filter (fun t => decide (AboveFW mem A t)) := fun u hu => by
      rw [List.mem_filter] at hu ⊢
      refine ⟨?_, hu.2⟩
      rcases List.mem_append.1 hu.1 with h | h
      · exact List.mem_append.2 (Or.inl (List.mem_of_mem_erase h))
      · exact List.mem_append.2 (Or.inr h)
    have hd : ∀ u, u ∈ (th.promises ++ F).filter (fun t => decide (AboveFW mem A t)) →
        u ∉ (th.promises.erase t ++ F).filter (fun t => decide (AboveFW mem A t)) → u = t := fun u hu hn =>
      Classical.byContradiction fun hne => hn (by
        rw [List.mem_filter] at hu ⊢
        refine ⟨?_, hu.2⟩
        rcases List.mem_append.1 hu.1 with h | h
        · exact List.mem_append.2 (Or.inl ((List.mem_erase_of_ne hne).2 h))
        · exact List.mem_append.2 (Or.inr h))
    rcases LatestNP_subErase hx hm hloc hsub hd with h1 | h1
    · exact ⟨false, x, WLe1_refl _, h1⟩
    · refine ⟨true, mw m, WLe1_trans hw ⟨?_, fun _ _ _ => hmv⟩, h1⟩
      show w.val = m.val
      rw [hval, exprVal_dataE th 1 w hr]

theorem push_get {α : Type} {a : Array α} {x : α} {t : Nat} (h : t < a.size) : (a.push x)[t]? = a[t]? := by
  rw [Array.getElem?_push_lt h, Array.getElem?_eq_getElem h]

/-- `stepStore_NPsame0`, with: a fulfilment keeps the old word (`b = false`). -/
theorem stepStore_NPsame0F {k : Promises.Knobs} {arch : Arch} {mem mem' : Memory} {th th' : Promises.Thread}
    {A : Address} {w : Word} {deps : List WeakMem.Reg} {rel : Bool} {V : Ts} {x : Word}
    (h : (mem', th') ∈ Promises.stepStore k arch mem th A (dataE 1 w) deps rel) (hr : th.regs 1 = w)
    (hV : V ≤ th.vs.vRelSt) (hx : LatestNP mem [] A x) :
    ∃ (b : Bool) (x0 : Word), WLe1 (if b then bumpW V w else x) x0 ∧ LatestNP mem' [] A x0 ∧
      (th'.promises ≠ th.promises → b = false) := by
  have hw : WLe1 (bumpW V w) ⟨w.val, Promises.storeMview th (dataE 1 w) deps rel, 0⟩ :=
    WLe1_msgB (WLe1_refl _) (storeMview_dataE th 1 w hr deps rel)
      (Nat.le_trans hV (storeMview_relSt th _ deps rel))
  rcases stepStore_casesE h with ⟨hmem, hpr⟩ | ⟨t, m, hmem, -⟩
  · refine ⟨true, _, ?_, by rw [hmem]; exact LatestNP_push_top _ (fun t ht => by cases ht),
      fun hne => absurd hpr hne⟩
    show WLe1 (bumpW V w) ⟨exprVal th (dataE 1 w), Promises.storeMview th (dataE 1 w) deps rel, 0⟩
    rw [exprVal_dataE th 1 w hr]; exact hw
  · exact ⟨false, x, WLe1_refl _, by rw [hmem]; exact hx, fun _ => rfl⟩

/-- (§11) Word `o` lies in access unit `i` of the layout `us`. -/
def InAcc (us : List Acc) (i o : Nat) : Prop := nWords (us.take i) ≤ o ∧ o < nWords (us.take (i + 1))

