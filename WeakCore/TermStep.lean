/-! ### (P4 step 5a) Step-2 memory steps with promise credits -/

theorem WRes_noword {E : TEnv} {a : Address} {w : Word} {R : Res} (h : WRes E a w R)
    (hn : ∀ n P, ¬ WordAt E a n P) : R = .zero := by
  rcases h with ⟨n, P, hw, -, -⟩ | ⟨-, rfl⟩
  · exact absurd hw (hn n P)
  · rfl

theorem VRes_noword {E : TEnv} {a : Address} {w : Word} {R : Res} (h : VRes E a w R)
    (hn : ∀ n P, ¬ WordAt E a n P) : R = .zero := by
  rcases h with ⟨-, -, h⟩ | ⟨-, h⟩
  · exact WRes_noword h hn
  · exact h

/-- A promise off every protocol word carries no credit and no debit. -/
theorem PromCr_zero {E : TEnv} {s : St} {cr db : Ts → Res} {t : Ts} {m : Msg} (h : PromCr E s cr db)
    (ht : t ∈ s.promises) (hm : s.mem[t]? = some m) (hn : ∀ n P, ¬ WordAt E m.loc n P)
    (hq : ¬ (PredU E m.loc ∧ DStart E m.loc)) :
    cr t = .zero ∧ db t = .zero := by
  obtain ⟨m', hm', hd, hc⟩ := h t ht
  rw [hm] at hm'
  cases hm'
  refine ⟨?_, DbRes_noword hd hn fun hD => hq ⟨hD.1, hD.2.1⟩⟩
  rcases hc with ⟨w, -, hw⟩ | ⟨-, hz⟩
  · exact VRes_noword hw hn
  · exact hz

/-- (P4 step 5a) A store whose fulfilled promises lie off protocol words keeps
the credits and their totals: each fulfilled promise carries `.zero`. -/
theorem storeUnits_crZ {E : TEnv} {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool}
    {cr db : Ts → Res} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s s' : St), s' ∈ storeUnits k arch pw a rel us ws i s →
      PromCr E s cr db → (∀ t, t ∈ s.promises → t < s.mem.size) →
      (∀ t m, t ∈ s.promises → s.mem[t]? = some m → ∀ j, j < nWords us → m.loc = offs a (i + j) →
        (∀ n P, ¬ WordAt E m.loc n P) ∧ ¬ (PredU E m.loc ∧ DStart E m.loc)) →
      PromCr E s' cr db ∧ pSum s' cr = pSum s cr ∧ pSum s' db = pSum s db
  | [], _, _, s, s', hs => by
      simp only [storeUnits, List.mem_singleton] at hs; subst hs; exact fun h _ _ => ⟨h, rfl, rfl⟩
  | .one :: us, w :: ws, i, s, s', hs => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      intro hC hlt hz
      have hstep : PromCr E { s with mem := mem', vs := th.vs, promises := th.promises } cr db ∧
          pSum { s with mem := mem', vs := th.vs, promises := th.promises } cr = pSum s cr ∧
          pSum { s with mem := mem', vs := th.vs, promises := th.promises } db = pSum s db ∧
          (∀ t, t ∈ th.promises → t ∈ s.promises) ∧ s.mem.size ≤ mem'.size ∧
          (∀ t, t < s.mem.size → mem'[t]? = s.mem[t]?) := by
        rcases stepStore_casesE hst with ⟨hmem, hpr⟩ | ⟨t, m, hmem, htp, hpr, hm, hloc, -, -⟩
        · have hpre : ∀ t, t < s.mem.size → mem'[t]? = s.mem[t]? := fun t ht => by
            rw [hmem]; exact push_lt ht
          exact ⟨PromCr_keep hC hpr hlt hpre (fun _ _ _ _ => rfl), pSum_prom cr hpr,
            pSum_prom db hpr, fun t ht => by rw [hpr] at ht; exact ht,
            by rw [hmem]; simp, hpre⟩
        · have hpre : ∀ t, t < s.mem.size → mem'[t]? = s.mem[t]? := fun t _ => by rw [hmem]
          obtain ⟨hc0, hd0⟩ := PromCr_zero hC htp hm
            (hz t m htp hm 0 (by rw [TermMem.nWords_one]; omega) (by rw [hloc, Nat.add_zero])).1
            (hz t m htp hm 0 (by rw [TermMem.nWords_one]; omega) (by rw [hloc, Nat.add_zero])).2
          have e1 := pSum_erase (s := s) (s' := { s with mem := mem', vs := th.vs, promises := th.promises })
            (f := cr) hpr htp
          have e2 := pSum_erase (s := s) (s' := { s with mem := mem', vs := th.vs, promises := th.promises })
            (f := db) hpr htp
          rw [hc0] at e1
          rw [hd0] at e2
          exact ⟨PromCr_erase hC hpr hlt hpre (fun _ _ _ _ => rfl), by rw [e1, Res.zero_add],
            by rw [e2, Res.zero_add], fun t' ht' => List.mem_of_mem_erase (by rw [hpr] at ht'; exact ht'),
            by rw [hmem]; exact Nat.le_refl _, hpre⟩
      obtain ⟨hC1, e1, e2, hsub, hsz, hpre⟩ := hstep
      have hlt1 : ∀ t, t ∈ th.promises → t < mem'.size := fun t ht =>
        Nat.lt_of_lt_of_le (hlt t (hsub t ht)) hsz
      have hz1 : ∀ t m, t ∈ th.promises → mem'[t]? = some m → ∀ j, j < nWords us →
          m.loc = offs a (i + 1 + j) → (∀ n P, ¬ WordAt E m.loc n P) ∧ ¬ (PredU E m.loc ∧ DStart E m.loc) :=
          fun t m ht hm j hj hl => by
        have hts := hsub t ht
        exact hz t m hts (by rw [← hpre t (hlt t hts)]; exact hm) (j + 1) (by rw [TermMem.nWords_one]; omega)
          (by rw [hl, show i + 1 + j = i + (j + 1) by omega])
      obtain ⟨hC2, f1, f2⟩ := storeUnits_crZ us ws (i + 1) _ s' hs hC1 hlt1 hz1
      exact ⟨hC2, f1.trans e1, f2.trans e2⟩
  | .two :: us, w0 :: w1 :: ws, i, s, s', hs => by
      simp only [storeUnits] at hs
      obtain ⟨q1, -, -, q4, -⟩ :=
        stepStorePair_eq s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel
      generalize Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1)
        [0] rel = R at q1 q4 hs
      obtain ⟨mem', pairs', th⟩ := R
      simp only at q1 q4 hs
      intro hC hlt hz
      have hpre : ∀ t, t < s.mem.size → mem'[t]? = s.mem[t]? := fun t ht => by
        rw [q1, push_lt, push_lt ht]
        rw [Array.size_push]; omega
      have hsz : s.mem.size ≤ mem'.size := by rw [q1, Array.size_push, Array.size_push]; omega
      have hC1 : PromCr E { s with mem := mem', pairs := pairs', vs := th.vs, promises := th.promises } cr db :=
        PromCr_keep hC q4 hlt hpre (fun _ _ _ _ => rfl)
      have hlt1 : ∀ t, t ∈ th.promises → t < mem'.size := fun t ht =>
        Nat.lt_of_lt_of_le (hlt t (by rw [q4] at ht; exact ht)) hsz
      have hz1 : ∀ t m, t ∈ th.promises → mem'[t]? = some m → ∀ j, j < nWords us →
          m.loc = offs a (i + 2 + j) → (∀ n P, ¬ WordAt E m.loc n P) ∧ ¬ (PredU E m.loc ∧ DStart E m.loc) :=
          fun t m ht hm j hj hl => by
        have hts : t ∈ s.promises := by rw [q4] at ht; exact ht
        exact hz t m hts (by rw [← hpre t (hlt t hts)]; exact hm) (j + 2) (by rw [TermMem.nWords_two]; omega)
          (by rw [hl, show i + 2 + j = i + (j + 2) by omega])
      obtain ⟨hC2, f1, f2⟩ := storeUnits_crZ us ws (i + 2) _ s' hs hC1 hlt1 hz1
      exact ⟨hC2, f1.trans (pSum_prom cr q4), f2.trans (pSum_prom db q4)⟩
  | .one :: _, [], _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [], _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, s', hs => by simp [storeUnits] at hs

/-- Folding keeps deep word-freeness (the unfolded cell type of a deep
word-free folded type is deep word-free). -/
theorem dwf_Fd {T U : Ty} (h : Fd T U) (hU : dwf U = true) : dwf T = true := by
  induction h with
  | refl => exact hU
  | fold hW _ _ _ ih => exact ih (dwf_unfold hW hU)

/-- (S7c) A deep word-free cell has no word unit, so none visible: its
accounting is the owner's reading whatever its frontier. -/
theorem nvis_dwf {E : TEnv} {l : AllocLabel} {c : Cell} (hsto : E.sto l = some c) (hd : dwf c.ty = true) :
    ∀ o, ¬ VisU E ⟨l, o⟩ := by
  rintro o ⟨⟨c', hc', h⟩, -⟩
  simp only at hc'
  rw [hsto] at hc'; cases hc'
  rcases h with ⟨r, P, -, hat⟩ | ⟨r, P, hat⟩ | ⟨r, P, -, hat⟩
  · rw [AtOff_dwf (by simp [dwf]) (fun t h => by cases h) hat] at hd; cases hd
  · rw [AtOff_dwf (by simp [dwf]) (fun t h => by cases h) hat] at hd; cases hd
  · rw [AtOff_dwf (by simp [dwf]) (fun t h => by cases h) hat] at hd; cases hd

/-! ### (T3 hdw′) `StoreCrZ`: a plain `pub` store's fulfilled promises carry no net credit -/

/-- (T3, the hdw′) **`StoreCrZ`**: every own
outstanding promise inside the units a plain `pub` store writes either carries
nothing (`VRes` zero), or sits at an epoch counter's word unit and has a
numeric predecessor (its credit and debit are then both the counter's region,
`PromCr_dbLe`). Replaces `StoreDwf` as the `dwf` side condition. -/
def StoreCrZ0 (η : TEnv) (cx : Cx) (s : St) (th : TTh) : Prop :=
  ∀ x rel a v tok e u, th.term = .let_ x (.store rel a v tok) e →
    ((cx.peek a = .ok (.ptr .pub u) ∧ wordOf (.ptr .pub u) = none) ∨
      (cx.peek a = .ok (.loc .pub u) ∧ wordOf (.loc .pub u) = none)) →
    ∀ rt pw ad μ ru us j, evalAt th.env a = some (rt, [pw]) → addrOf pw = some ad →
      cellOf rt = some (μ, ru) → accs ru = some us → j < nWords us →
    ∀ t m, t ∈ s.promises → s.mem[t]? = some m → m.loc = offs ad j →
      (∀ w R, VRes (CE η) m.loc w R → R = .zero) ∨
      ((∃ n P, WordAt (CE η) m.loc n P ∧ P.epoch = true) ∧
        ∃ w, PredAt s.mem m.loc t w ∧ ∃ k, w.val = .num k)

/-- (option 3) **What the stepper asks of a stored component `U`** (discharged at the TermPiece level by
`gd_fundX` with no drop list): any value of `U` pays, unit by unit, what its words hold at any
set of word units `Lx`. -/
def StoreLeafPay (E : TEnv) (a : Address) (U : Ty) (us : List Acc) : Prop :=
  ∀ (comp : List Word) (Rb : Res) (Lx : List Nat), Lx.Nodup → (∀ j ∈ Lx, j < nWords us) →
    comp.length = nWords us → VRR (fun _ => 0) E U (shp U) comp Rb →
    ∃ Gx : Nat → Res, Res.sum (Lx.map Gx) ≤ Rb ∧
      ∀ j ∈ Lx, ∀ n P x, WordAt E (offs a j) n P → comp[j]? = some x → wr P n x.val ≤ Gx j

/-- (option 3) `StoreLeafPay` at every laid-out component of every cell: what a store's
fulfilled promises need from the stored component (`storeUnits_fwrPay`).  True for any `η`
(TermPiece `storeLeafPay_of`, via `gd_fundX` with no drop list). -/
def StoreLeafPayAll (E : TEnv) : Prop :=
  ∀ (ad : Address) (c : Cell) (U : Ty) (us : List Acc), E.sto ad.label = some c → AtOff c.ty ad.offset U →
    accs U = some us → StoreLeafPay E ad U us

/-- (U3, fix b; PIN option 3) A plain `pub` store's fulfilled promises initialise no unit (`StoreNI`),
and what they hold is paid from the stored component, read in memory's view (`StoreLeafPayAll` at
`CE (CE η).unsee`, where `ValOfR` and `EnvValR.store` read values). -/
def StoreCrZ (η : TEnv) (_cx : Cx) (s : St) (th : TTh) : Prop :=
  StoreNI (CE η) s th ∧ StoreLeafPayAll (CE (CE η).unsee)

theorem wr_le_rg (P : Proto) (n : Nat) (v : WeakMem.Val) : wr P n v ≤ Res.one (.rg n) := by
  by_cases h : WordHolds P [v]
  · rw [wr_holds h]; exact fun k => Nat.le_refl _
  · rw [wr_nholds h]; exact Res.zero_le _

/-- (T3 hdw′) A promise as `StoreCrZ` describes it has its debit at most its
credit. -/
theorem PromCr_dbLe {E : TEnv} {s : St} {cr db : Ts → Res} {t : Ts} {m : Msg} (h : PromCr E s cr db)
    (ht : t ∈ s.promises) (hm : s.mem[t]? = some m)
    (hnI : ((∃ n P, WordAt E m.loc n P) ∨ (PredU E m.loc ∧ DStart E m.loc)) → ¬ InitAt s.mem m.loc t)
    (hpw : ∀ n P, WordAt E m.loc n P → IniW E m.loc → pwf P = true)
    (hz : (∀ w R, VRes E m.loc w R → R = .zero) ∨
      ((∃ n P, WordAt E m.loc n P ∧ P.epoch = true) ∧ ∃ w, PredAt s.mem m.loc t w ∧ ∃ k, w.val = .num k)) :
    db t ≤ cr t := by
  obtain ⟨m', hm', hd, hc⟩ := h t ht
  rw [hm] at hm'; cases hm'
  rcases (show db t = .zero ∨ VRes E m.loc (mw m) (db t) from by
    by_cases hwx : ∃ n P, WordAt E m.loc n P
    · exact Or.inr ((DbRes_nInit (hnI (Or.inl hwx))).1 hd)
    · exact Or.inl (DbRes_noword hd (fun n P h => hwx ⟨n, P, h⟩) fun hD =>
        hnI (Or.inr ⟨hD.1, hD.2.1⟩) (FirstW_initAt hD.2.2))) with hd0 | hd
  · rw [hd0]; exact Res.zero_le _
  rcases hz with hz | ⟨⟨n, P, hw, he⟩, w, hpr, k, hk⟩
  · rw [hz _ _ hd]; exact Res.zero_le _
  · rcases hc with ⟨w', hpr', hcw⟩ | ⟨hnw, -⟩
    · obtain rfl := PredAt_uniq hpr hpr'
      by_cases hV : Vis E m.loc.label ∧ IniW E m.loc
      · have e1 := WRes_eq_wr hw ((VRes_vis hV.1 hV.2).1 hd)
        have e2 := WRes_eq_wr hw ((VRes_vis hV.1 hV.2).1 hcw)
        rw [e1, e2, hk, wr_holds (WordHolds_epoch (hpw n P hw hV.2) he k)]
        exact wr_le_rg P n _
      · have z1 : db t = .zero := by
          rcases hd with h1 | h1
          · exact absurd ⟨h1.1, h1.2.1⟩ hV
          · exact h1.2
        rw [z1]; exact Res.zero_le _
    · exact absurd hpr (hnw w)

theorem sum_map_le {f g : Ts → Res} : ∀ (L : List Ts), (∀ t, t ∈ L → f t ≤ g t) →
    Res.sum (L.map f) ≤ Res.sum (L.map g)
  | [], _ => fun k => by simp
  | x :: xs, h => by
      simp only [List.map_cons, Res.sum_cons]
      have h1 := h x List.mem_cons_self
      have h2 := sum_map_le xs (fun t ht => h t (List.mem_cons_of_mem _ ht))
      exact fun k => by have := h1 k; have := h2 k; simp only [Res.add_apply]; omega

/-- (L3) `CrKeep` without its last clause: fulfilled promises may carry
credits and debits. -/
def CrMov (E E' : TEnv) (s s' : St) : Prop :=
  s'.promises.Sublist s.promises ∧ s.mem.size ≤ s'.mem.size ∧ (∀ t, t < s.mem.size → s'.mem[t]? = s.mem[t]?) ∧
    (∀ t m, t ∈ s'.promises → s.mem[t]? = some m → ResEqv E E' m.loc)

/-- What a step's fulfilled promises total. -/
def Dsum (s s' : St) (f : Ts → Res) : Res := Res.sum ((s.promises.filter (fun t => decide (t ∉ s'.promises))).map f)

theorem sum_sublist_split {f : Ts → Res} {L' L : List Ts} (hs : L'.Sublist L) :
    L.Nodup → Res.sum (L.map f) = Res.sum (L'.map f) + Res.sum ((L.filter (fun t => decide (t ∉ L'))).map f) := by
  induction hs with
  | slnil => intro _; exact Res.ext fun k => by simp
  | @cons l1 l2 a h ih =>
      intro hnd
      have ha' : a ∉ l1 := fun hm => (List.nodup_cons.1 hnd).1 (h.subset hm)
      rw [List.filter_cons_of_pos (by simpa using ha'), List.map_cons, List.map_cons, Res.sum_cons,
        Res.sum_cons, ih (List.nodup_cons.1 hnd).2]
      exact Res.ext fun k => by simp only [Res.add_apply]; omega
  | @cons_cons l1 l2 a h ih =>
      intro hnd
      have hfe : (l2.filter (fun t => decide (t ∉ a :: l1))) = l2.filter (fun t => decide (t ∉ l1)) := by
        apply List.filter_congr
        intro t ht
        have hta : t ≠ a := fun e => (List.nodup_cons.1 hnd).1 (e ▸ ht)
        simp [hta]
      rw [List.filter_cons_of_neg (by simp), hfe, List.map_cons, List.map_cons, Res.sum_cons, Res.sum_cons,
        ih (List.nodup_cons.1 hnd).2]
      exact Res.ext fun k => by simp only [Res.add_apply]; omega

/-- (L3) **`CrMove`**: the remaining credits carry over, and the totals drop
by the fulfilled promises' credits and debits. -/
theorem CrMov_pack {E E' : TEnv} {s s' : St} (hlt : ∀ t, t ∈ s.promises → t < s.mem.size)
    (hnd : s.promises.Nodup) (h : CrMov E E' s s') {cr db : Ts → Res} (hC : PromCr E s cr db) :
    PromCr E' s' cr db ∧ pSum s cr = pSum s' cr + Dsum s s' cr ∧ pSum s db = pSum s' db + Dsum s s' db := by
  obtain ⟨hsub, -, hm, hv⟩ := h
  refine ⟨fun tw htw => ?_, sum_sublist_split hsub hnd, sum_sublist_split hsub hnd⟩
  have ht0 := hsub.subset htw
  obtain ⟨m, hm1, hd, hc⟩ := hC tw ht0
  have hlt' := hlt tw ht0
  refine ⟨m, by rw [hm tw hlt']; exact hm1, DbRes_mem hm hlt'
    ((hv tw m htw hm1).2.2 _ m tw _ rfl hd), ?_⟩
  rcases hc with ⟨w, hw, hcw⟩ | ⟨hnw, hcz⟩
  · exact Or.inl ⟨w, (PredAt_prefix hm (Nat.le_of_lt hlt')).1 hw, ((hv tw m htw hm1).2.1 _ _).2 hcw⟩
  · exact Or.inr ⟨fun w hw => hnw w ((PredAt_prefix hm (Nat.le_of_lt hlt')).2 hw), hcz⟩

/-- (T3 hdw′) `CrPack` up to fulfilled promises whose debit is at most their
credit. -/
def CrPackLe (E E' : TEnv) (s s' : St) : Prop :=
  ∀ cr db, PromCr E s cr db → PromCr E' s' cr db ∧ pSum s' cr + pSum s db ≤ pSum s cr + pSum s' db

theorem CrPack_le {E E' : TEnv} {s s' : St} (h : CrPack E E' s s') : CrPackLe E E' s s' := fun cr db hC =>
  let ⟨h1, e1, e2⟩ := h cr db hC
  ⟨h1, by rw [e1, e2]; exact fun k => by simp only [Res.add_apply]; omega⟩

theorem CrMov_packLe {E E' : TEnv} {s s' : St} (hlt : ∀ t, t ∈ s.promises → t < s.mem.size)
    (hnd : s.promises.Nodup) (h : CrMov E E' s s')
    (hle : ∀ cr db, PromCr E s cr db → ∀ t, t ∈ s.promises → t ∉ s'.promises → db t ≤ cr t) :
    CrPackLe E E' s s' := by
  intro cr db hC
  obtain ⟨hC', e1, e2⟩ := CrMov_pack hlt hnd h hC
  refine ⟨hC', ?_⟩
  have hD : Dsum s s' db ≤ Dsum s s' cr := sum_map_le _ (fun t ht => by
    rw [List.mem_filter] at ht
    exact hle cr db hC t ht.1 (by simpa using ht.2))
  rw [e1, e2]
  exact fun k => by have := hD k; simp only [Res.add_apply]; omega

/-- (T3 hdw′) A plain store's `CrPackLe` from `StoreCrZ`-shaped facts about
the promises inside its units. -/
theorem storeUnits_packLe {g : G} {η : TEnv} {s s' : St} {H : Res} {k : Promises.Knobs} {arch : Arch}
    {pw : Word} {a : Address} {rel : Bool} {us : List Acc} {ws : List Word}
    (hm : MemInv g (CE η) s) (hH : MemHeld (CE η) s H) (hs : s' ∈ storeUnits k arch pw a rel us ws 0 s)
    (hz : ∀ j, j < nWords us → ∀ t m, t ∈ s.promises → s.mem[t]? = some m → m.loc = offs a j →
      (∀ w R, VRes (CE η) m.loc w R → R = .zero) ∨
      ((∃ n P, WordAt (CE η) m.loc n P ∧ P.epoch = true) ∧
        ∃ w, PredAt s.mem m.loc t w ∧ ∃ k, w.val = .num k))
    (hnI : ∀ j, j < nWords us → NoInitF (CE η) s (offs a j)) :
    CrPackLe (CE η) (CE η) s s' := by
  obtain ⟨hg, -, -⟩ := storeUnits_growsF us ws 0 s s' hs
  obtain ⟨-, hsub, hful⟩ := storeUnits_promF us ws 0 s s' hm.2.2.1 hs
  refine CrMov_packLe (MemInv_promLt hm) hm.2.2.2.2.2.2.2.2.2.2.1 ⟨hsub, hg.1, hg.2.1, fun _ _ _ _ => ResEqv_refl⟩
    (fun cr db hC t ht hn => ?_)
  obtain ⟨m1, j, w, hm1, hj, -, hl, -⟩ := hful t ht hn
  refine PromCr_dbLe hC ht hm1 (by rw [hl, Nat.zero_add]; exact hnI j hj t m1 ht hm1 (by rw [hl, Nat.zero_add]))
    (fun n P hw hiw => ?_) (hz j hj t m1 ht hm1 (by rw [hl, Nat.zero_add]))
  obtain ⟨c2, hc2, hat2, hg2⟩ := hw
  exact pwf_of_held hH hc2 hat2 (IniAt_of_IniW hc2 hat2 hiw) hg2

/-! ## `CrPackLe` up to a surplus -/

/-- (option 3) `CrPackLe` up to a surplus `X` the step pays from elsewhere. -/
def CrPackLeX (E E' : TEnv) (s s' : St) (X : Res) : Prop :=
  ∀ cr db, PromCr E s cr db → PromCr E' s' cr db ∧ pSum s' cr + pSum s db ≤ pSum s cr + pSum s' db + X

theorem CrPackLe_X {E E' : TEnv} {s s' : St} (h : CrPackLe E E' s s') : CrPackLeX E E' s s' .zero :=
  fun cr db hC => let ⟨h1, h2⟩ := h cr db hC; ⟨h1, by rw [Res.add_zero]; exact h2⟩

theorem CrMov_packLeX {E E' : TEnv} {s s' : St} {X : Res} (hlt : ∀ t, t ∈ s.promises → t < s.mem.size)
    (hnd : s.promises.Nodup) (h : CrMov E E' s s')
    (hle : ∀ cr db, PromCr E s cr db → Dsum s s' db ≤ Dsum s s' cr + X) :
    CrPackLeX E E' s s' X := by
  intro cr db hC
  obtain ⟨hC', e1, e2⟩ := CrMov_pack hlt hnd h hC
  refine ⟨hC', ?_⟩
  have hD := hle cr db hC
  rw [e1, e2]
  exact fun k => by have := hD k; simp only [Res.add_apply] at this ⊢; omega

/-! ## What a fulfilled promise's word holds -/

open Classical in
/-- What message `m`'s word holds at a non-ghost protocol word unit, else nothing. -/
noncomputable def wAt (E : TEnv) (m : Msg) : Res :=
  if h : ∃ q : Nat × Proto, WordAt E m.loc q.1 q.2 then wr h.choose.2 h.choose.1 m.val else .zero

theorem wAt_eq {E : TEnv} {m : Msg} {n : Nat} {P : Proto} (hw : WordAt E m.loc n P) : wAt E m = wr P n m.val := by
  have hex : ∃ q : Nat × Proto, WordAt E m.loc q.1 q.2 := ⟨(n, P), hw⟩
  unfold wAt
  simp only [hex, ↓reduceDIte]
  obtain ⟨e1, e2⟩ := WordAt_uniq hex.choose_spec hw
  rw [e1, e2]

open Classical in
/-- (option 3) What promise `t`'s word holds where memory reads it (a visible label). -/
noncomputable def fwr (E : TEnv) (s : St) (t : Ts) : Res :=
  match s.mem[t]? with
  | some m => if Vis E m.loc.label then wAt E m else .zero
  | none => .zero

/-- A non-initialising own promise's debit is at most what its word holds where memory reads it. -/
theorem PromCr_dbFwr {E : TEnv} {s : St} {cr db : Ts → Res} {t : Ts} {m : Msg} (h : PromCr E s cr db)
    (ht : t ∈ s.promises) (hm : s.mem[t]? = some m)
    (hnI : ((∃ n P, WordAt E m.loc n P) ∨ (PredU E m.loc ∧ DStart E m.loc)) → ¬ InitAt s.mem m.loc t) :
    db t ≤ fwr E s t := by
  obtain ⟨m', hm', hd, -⟩ := h t ht
  rw [hm] at hm'; cases hm'
  unfold fwr; rw [hm]
  by_cases hwx : ∃ n P, WordAt E m.loc n P
  · obtain ⟨n, P, hw⟩ := hwx
    rcases (DbRes_nInit (hnI (Or.inl ⟨n, P, hw⟩))).1 hd with ⟨hV, -, hW⟩ | ⟨-, h0⟩
    · simp only [hV, ↓reduceIte]
      rw [wAt_eq hw, WRes_eq_wr hw hW]
      exact Res.le_refl _
    · rw [h0]; exact Res.zero_le _
  · rw [DbRes_noword hd (fun n P h => hwx ⟨n, P, h⟩) fun hD =>
      hnI (Or.inr ⟨hD.1, hD.2.1⟩) (FirstW_initAt hD.2.2)]
    exact Res.zero_le _

/-- **(option 3) A plain store's `CrPackLeX`**: from `NoInitF` alone (no `StoreCrZ0`), the
fulfilled promises' debits are at most what their words hold where memory reads them. -/
theorem storeUnits_packLeX {g : G} {E : TEnv} {s s' : St} {k : Promises.Knobs} {arch : Arch}
    {pw : Word} {a : Address} {rel : Bool} {us : List Acc} {ws : List Word}
    (hm : MemInv g E s) (hs : s' ∈ storeUnits k arch pw a rel us ws 0 s)
    (hnI : ∀ j, j < nWords us → NoInitF E s (offs a j)) :
    CrPackLeX E E s s' (Dsum s s' (fwr E s)) := by
  obtain ⟨hg, -, -⟩ := storeUnits_growsF us ws 0 s s' hs
  obtain ⟨-, hsub, hful⟩ := storeUnits_promF us ws 0 s s' hm.2.2.1 hs
  refine CrMov_packLeX (MemInv_promLt hm) hm.2.2.2.2.2.2.2.2.2.2.1 ⟨hsub, hg.1, hg.2.1, fun _ _ _ _ => ResEqv_refl⟩
    (fun cr db hC => ?_)
  have hD : Dsum s s' db ≤ Dsum s s' (fwr E s) := sum_map_le _ (fun t ht => by
    rw [List.mem_filter] at ht
    have hn : t ∉ s'.promises := by simpa using ht.2
    obtain ⟨m1, j, w, hm1, hj, -, hl, -⟩ := hful t ht.1 hn
    exact PromCr_dbFwr hC ht.1 hm1 (by
      rw [hl, Nat.zero_add]; exact hnI j hj t m1 ht.1 hm1 (by rw [hl, Nat.zero_add])))
  exact fun k => by have := hD k; simp only [Res.add_apply]; omega

#print axioms storeUnits_packLeX

/-- (option 3) A store's fulfilled promises sit at pairwise distinct locations (one per unit). -/
theorem storeUnits_fulInj {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s s' : St), s' ∈ storeUnits k arch pw a rel us ws i s →
      PromLt s → ∀ t t' m m', t ∈ s.promises → t ∉ s'.promises → t' ∈ s.promises → t' ∉ s'.promises →
      s.mem[t]? = some m → s.mem[t']? = some m' → m.loc = m'.loc → t = t'
  | [], _, _, s, s', hs, _ => by
      simp only [storeUnits, List.mem_singleton] at hs; subst hs
      intro t _ _ _ ht hn; exact absurd ht hn
  | .one :: us, w :: ws, i, s, s', hs, hP => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      have hpsub := stepStore_promSub hst
      have hsz : s.mem.size ≤ mem'.size := by
        rcases stepStore_casesE hst with ⟨hmem, -⟩ | ⟨_, _, hmem, -⟩
        · rw [hmem, Array.size_push]; exact Nat.le_succ _
        · rw [hmem]; exact Nat.le_refl _
      have hP1 : PromLt { s with mem := mem', vs := th.vs, promises := th.promises } :=
        fun t ht => Nat.lt_of_lt_of_le (hP t (hpsub t ht)) hsz
      have hmt : ∀ t, t < s.mem.size → mem'[t]? = s.mem[t]? := fun t h => by
        rcases stepStore_casesE hst with ⟨hmem, -⟩ | ⟨_, _, hmem, -⟩
        · rw [hmem]; exact push_get h
        · rw [hmem]
      have IH := storeUnits_fulInj us ws (i + 1) _ s' hs hP1
      obtain ⟨-, -, hful⟩ := storeUnits_promF us ws (i + 1) _ s' hP1 hs
      have hcl : ∀ t m, t ∈ s.promises → t ∉ s'.promises → s.mem[t]? = some m →
          (t ∈ th.promises ∧ ∃ j, m.loc = offs a (i + 1 + j)) ∨ (t ∉ th.promises ∧ m.loc = offs a i) := by
        intro t m ht hn hm
        by_cases htp : t ∈ th.promises
        · obtain ⟨m1, j1, w1, hm1, -, -, hl1, -⟩ := hful t htp hn
          have h1 : mem'[t]? = some m := by rw [hmt t (hP t ht)]; exact hm
          have h2 : mem'[t]? = some m1 := hm1
          rw [h1] at h2; cases h2
          exact Or.inl ⟨htp, j1, hl1⟩
        · rcases stepStore_casesE hst with ⟨-, hpr⟩ | ⟨t0, m0, -, -, hpr, hm0, hl0, -⟩
          · exact absurd (by rw [hpr]; exact ht) htp
          · have e : t = t0 := Classical.byContradiction fun hne =>
              htp (by rw [hpr]; exact (List.mem_erase_of_ne hne).2 ht)
            subst e
            rw [hm0] at hm; cases hm
            exact Or.inr ⟨htp, hl0⟩
      intro t t' m m' ht hn ht' hn' hm hm' he
      rcases hcl t m ht hn hm with ⟨htp, j, hl⟩ | ⟨htp, hl⟩ <;>
        rcases hcl t' m' ht' hn' hm' with ⟨htp', j', hl'⟩ | ⟨htp', hl'⟩
      · exact IH t t' m m' htp hn htp' hn' (by rw [hmt t (hP t ht)]; exact hm)
          (by rw [hmt t' (hP t' ht')]; exact hm') he
      · exfalso; rw [hl, hl'] at he; have := congrArg WeakMem.Address.offset he; simp [offs] at this; omega
      · exfalso; rw [hl, hl'] at he; have := congrArg WeakMem.Address.offset he; simp [offs] at this; omega
      · rcases stepStore_casesE hst with ⟨-, hpr⟩ | ⟨t0, -, -, -, hpr, -⟩
        · exact absurd (by rw [hpr]; exact ht) htp
        · have e1 : t = t0 := Classical.byContradiction fun hne =>
            htp (by rw [hpr]; exact (List.mem_erase_of_ne hne).2 ht)
          have e2 : t' = t0 := Classical.byContradiction fun hne =>
            htp' (by rw [hpr]; exact (List.mem_erase_of_ne hne).2 ht')
          rw [e1, e2]
  | .two :: us, w0 :: w1 :: ws, i, s, s', hs, hP => by
      simp only [storeUnits] at hs
      obtain ⟨q1, _, _, q4, -⟩ := stepStorePair_eq s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel
      generalize Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel = R at q1 q4 hs
      obtain ⟨mem', pairs', th⟩ := R
      simp only at q1 q4 hs
      have hsz : s.mem.size ≤ mem'.size := by rw [q1, Array.size_push, Array.size_push]; omega
      have hP2 : PromLt { s with mem := mem', pairs := pairs', vs := th.vs, promises := th.promises } :=
        fun t ht => by
          have ht' : t ∈ s.promises := by have := ht; simp only at this; rw [q4] at this; exact this
          exact Nat.lt_of_lt_of_le (hP t ht') hsz
      have hmt : ∀ t, t < s.mem.size → mem'[t]? = s.mem[t]? := fun t h => by
        rw [q1, push_get (by rw [Array.size_push]; exact Nat.lt_succ_of_lt h), push_get h]
      intro t t' m m' ht hn ht' hn' hm hm' he
      exact storeUnits_fulInj us ws (i + 2) _ s' hs hP2 t t' m m' (by rw [q4]; exact ht) hn
        (by rw [q4]; exact ht') hn' (by rw [hmt t (hP t ht)]; exact hm) (by rw [hmt t' (hP t' ht')]; exact hm') he
  | .one :: _, [], _, _, s', hs, _ => by simp [storeUnits] at hs
  | .two :: _, [], _, _, s', hs, _ => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, s', hs, _ => by simp [storeUnits] at hs

#print axioms storeUnits_fulInj


/-! ## The fulfilled promises' words are paid by per-unit shares -/

/-- Sums over a list are bounded by sums over the targets of a map injective on the nonzero terms. -/
theorem sum_le_inj {f : Ts → Res} {g : Nat → Res} {φ : Ts → Nat} :
    ∀ (L : List Ts) (Lx : List Nat), L.Nodup →
      (∀ t ∈ L, ∀ t' ∈ L, f t ≠ .zero → f t' ≠ .zero → φ t = φ t' → t = t') →
      (∀ t ∈ L, f t ≠ .zero → φ t ∈ Lx ∧ f t ≤ g (φ t)) → Res.sum (L.map f) ≤ Res.sum (Lx.map g)
  | [], _, _, _, _ => fun kk => by simp
  | t :: L, Lx, hnd, hinj, hle => by
    rw [List.nodup_cons] at hnd
    by_cases h0 : f t = .zero
    · have ih := sum_le_inj L Lx hnd.2 (fun a ha b hb => hinj a (List.mem_cons_of_mem _ ha) b (List.mem_cons_of_mem _ hb))
        (fun a ha => hle a (List.mem_cons_of_mem _ ha))
      intro kk
      have := ih kk
      simp only [List.map_cons, Res.sum_cons, Res.add_apply, h0, Res.zero_apply]
      omega
    · obtain ⟨hmem, hft⟩ := hle t List.mem_cons_self h0
      have ih := sum_le_inj L (Lx.erase (φ t)) hnd.2
        (fun a ha b hb => hinj a (List.mem_cons_of_mem _ ha) b (List.mem_cons_of_mem _ hb))
        (fun a ha ha0 => by
          obtain ⟨h1, h2⟩ := hle a (List.mem_cons_of_mem _ ha) ha0
          refine ⟨(List.mem_erase_of_ne fun e => ?_).2 h1, h2⟩
          have := hinj a (List.mem_cons_of_mem _ ha) t List.mem_cons_self ha0 h0 e
          subst this; exact hnd.1 ha)
      rw [sum_map_erase hmem]
      intro kk
      have := ih kk
      have := hft kk
      simp only [List.map_cons, Res.sum_cons, Res.add_apply]
      omega

/-- The unit offset of promise `t`'s message relative to `a`. -/
def offOf (s : St) (a : Address) (t : Ts) : Nat :=
  match s.mem[t]? with
  | some m => m.loc.offset - a.offset
  | none => 0

/-- **(option 3) The fulfilled promises' words are paid by per-unit shares**: if every fulfilled
promise at a visible protocol word unit `j` has `j ∈ Lx`, and the share `Gx j` of each unit in `Lx`
covers what the complement's word holds there, the fulfilled promises' `fwr` total at most the
shares. (The complement holds the stored word at those units, `storeUnits_NPmixF`.) -/
theorem fwr_le_shares {E : TEnv} {s s' : St} {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address}
    {rel : Bool} {us : List Acc} {ws : List Word} {V : Ts} {comp : List Word} {Lx : List Nat} {Gx : Nat → Res}
    (hP : PromLt s) (hnd : s.promises.Nodup) (hs : s' ∈ storeUnits k arch pw a rel us ws 0 s)
    (hcomp : ∀ t m j, t ∈ s.promises → t ∉ s'.promises → s.mem[t]? = some m → m.loc = offs a j →
      VisU E m.loc → comp[j]? = (ws.map (bumpW V))[j]?)
    (hLx : ∀ t m j n P, t ∈ s.promises → t ∉ s'.promises → s.mem[t]? = some m → m.loc = offs a j →
      Vis E m.loc.label → WordAt E m.loc n P → j ∈ Lx)
    (hGx : ∀ j ∈ Lx, ∀ n P x, WordAt E (offs a j) n P → comp[j]? = some x → wr P n x.val ≤ Gx j) :
    Dsum s s' (fwr E s) ≤ Res.sum (Lx.map Gx) := by
  obtain ⟨-, -, hful⟩ := storeUnits_promF us ws 0 s s' hP hs
  have hF : ∀ t ∈ s.promises.filter (fun t => decide (t ∉ s'.promises)), t ∈ s.promises ∧ t ∉ s'.promises :=
    fun t ht => by rw [List.mem_filter] at ht; exact ⟨ht.1, by simpa using ht.2⟩
  -- a fulfilled promise with a nonzero `fwr`: its unit, a visible protocol word
  have hpos : ∀ t, t ∈ s.promises → t ∉ s'.promises → fwr E s t ≠ .zero →
      ∃ m j w n P, s.mem[t]? = some m ∧ m.loc = offs a j ∧ ws[j]? = some w ∧ m.val = w.val ∧
        Vis E m.loc.label ∧ WordAt E m.loc n P ∧ fwr E s t = wr P n m.val ∧ offOf s a t = j := by
    intro t ht hn h0
    obtain ⟨m, j, w, hm, -, hw, hl, hval, -⟩ := hful t ht hn
    rw [Nat.zero_add] at hl
    have hoff : offOf s a t = j := by
      simp [offOf, hm, hl, offs]
    unfold fwr at h0; rw [hm] at h0
    by_cases hV : Vis E m.loc.label
    · simp only [hV, ↓reduceIte] at h0
      by_cases hx : ∃ q : Nat × Proto, WordAt E m.loc q.1 q.2
      · obtain ⟨⟨n, P⟩, hwa⟩ := hx
        refine ⟨m, j, w, n, P, hm, hl, hw, hval, hV, hwa, ?_, hoff⟩
        unfold fwr; rw [hm]; simp only [hV, ↓reduceIte]; exact wAt_eq hwa
      · exfalso; apply h0; unfold wAt; simp only [hx, ↓reduceDIte]
    · simp only [hV, ↓reduceIte] at h0; exact absurd rfl h0
  refine sum_le_inj (φ := offOf s a) _ Lx (hnd.sublist List.filter_sublist) (fun t ht t' ht' h0 h0' he => ?_)
    (fun t ht h0 => ?_)
  · obtain ⟨m, j, -, -, -, hm, hl, -, -, -, -, -, hoff⟩ := hpos t (hF t ht).1 (hF t ht).2 h0
    obtain ⟨m', j', -, -, -, hm', hl', -, -, -, -, -, hoff'⟩ := hpos t' (hF t' ht').1 (hF t' ht').2 h0'
    rw [hoff, hoff'] at he; subst he
    exact storeUnits_fulInj us ws 0 s s' hs hP t t' m m' (hF t ht).1 (hF t ht).2 (hF t' ht').1 (hF t' ht').2
      hm hm' (by rw [hl, hl'])
  · obtain ⟨m, j, w, n, P, hm, hl, hw, hval, hV, hwa, hft, hoff⟩ := hpos t (hF t ht).1 (hF t ht).2 h0
    rw [hoff]
    refine ⟨hLx t m j n P (hF t ht).1 (hF t ht).2 hm hl hV hwa, ?_⟩
    have hcj := hcomp t m j (hF t ht).1 (hF t ht).2 hm hl ⟨WordAt_unit hwa, hV⟩
    rw [List.getElem?_map, hw] at hcj
    have := hGx j (hLx t m j n P (hF t ht).1 (hF t ht).2 hm hl hV hwa) n P (bumpW V w) (by rw [← hl]; exact hwa) hcj
    rw [hft, hval]; exact this

#print axioms fwr_le_shares

/-- (option 3) A fulfilled promise sits at a unit `j` of the store and carries the stored word's value. -/
theorem storeUnits_fulVal {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool}
    {us : List Acc} {ws : List Word} {s s' : St} (hP : PromLt s) (hs : s' ∈ storeUnits k arch pw a rel us ws 0 s)
    {t : Ts} (ht : t ∈ s.promises) (hn : t ∉ s'.promises) :
    ∃ m j w, s.mem[t]? = some m ∧ j < nWords us ∧ ws[j]? = some w ∧ m.loc = offs a j ∧ m.val = w.val := by
  obtain ⟨-, -, hful⟩ := storeUnits_promF us ws 0 s s' hP hs
  obtain ⟨m, j, w, hm, hj, hw, hl, hval, -⟩ := hful t ht hn
  exact ⟨m, j, w, hm, hj, hw, by rw [hl, Nat.zero_add], hval⟩

open Classical in
/-- The units where the store fulfils an own promise at a visible protocol word. -/
noncomputable def fulUnits (E : TEnv) (s s' : St) (a : Address) (us : List Acc) : List Nat :=
  (List.range (nWords us)).filter fun j => decide (∃ t m n P, t ∈ s.promises ∧ t ∉ s'.promises ∧
    s.mem[t]? = some m ∧ m.loc = offs a j ∧ Vis E m.loc.label ∧ WordAt E m.loc n P)

open Classical in
/-- **(option 3) The stepper's payment**: the fulfilled promises' `fwr` total at most the resources
`Rb` of the unit mix's complement `comp` (`storeUnits_NPmixF`), given `StoreLeafPay`. -/
theorem storeUnits_fwrPay {E : TEnv} {s s' : St} {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address}
    {rel : Bool} {us : List Acc} {ws : List Word} {U : Ty} {V : Ts} {comp : List Word} {Rb : Res}
    (hP : PromLt s) (hnd : s.promises.Nodup) (hs : s' ∈ storeUnits k arch pw a rel us ws 0 s)
    (hcomp : ∀ t m j, t ∈ s.promises → t ∉ s'.promises → s.mem[t]? = some m → m.loc = offs a j →
      VisU E m.loc → comp[j]? = (ws.map (bumpW V))[j]?)
    (hcl : comp.length = nWords us) (hv : VRR (fun _ => 0) E U (shp U) comp Rb)
    (hpay : StoreLeafPay E a U us) :
    Dsum s s' (fwr E s) ≤ Rb := by
  obtain ⟨Gx, hsum, hGx⟩ := hpay comp Rb (fulUnits E s s' a us) (List.nodup_range.sublist List.filter_sublist)
    (fun j hj => List.mem_range.1 (List.mem_filter.1 hj).1) hcl hv
  refine Res.le_trans (fwr_le_shares (Gx := Gx) hP hnd hs hcomp (fun t m j n P ht hn hm hl hV hwa => ?_) hGx) hsum
  obtain ⟨m1, j1, -, hm1, hj1, -, hl1, -⟩ := storeUnits_fulVal hP hs ht hn
  rw [hm] at hm1; cases hm1
  have e : j = j1 := by
    rw [hl1] at hl; have := congrArg WeakMem.Address.offset hl; simp [offs] at this; omega
  subst e
  exact List.mem_filter.2 ⟨List.mem_range.2 hj1, by rw [decide_eq_true_iff]; exact ⟨t, _, n, P, ht, hn, hm, hl, hV, hwa⟩⟩

#print axioms storeUnits_fwrPay

theorem Dsum_self (s : St) (f : Ts → Res) : Dsum s s f = .zero := by
  have : s.promises.filter (fun t => decide (t ∉ s.promises)) = [] :=
    List.filter_eq_nil_iff.2 fun t ht => by simp [ht]
  simp only [Dsum, this, List.map_nil, Res.sum]

/-- (T3 hdw′) `ThInvMP` with `CrPackLe`. -/
def ThInvMPL (p : Prog) (g : G) (E0 : TEnv) (s : St) (S0 : AllocLabel → List Res) (mem : Memory) (pairs : List Ts) (th : TTh)
    (Tot H : Res) : Prop :=
  ∃ E, EFoot g E0 E s (stOf mem pairs th) ∧ SeenKeep E0 E ∧ BoxNewV E0 E s th ∧ ThInvRE p E th Tot ∧ MemInv g E (stOf mem pairs th) ∧
    MemHeldK E0 s S0 E (stOf mem pairs th) H ∧ CrPackLe E0 E s (stOf mem pairs th)

/-! ## The store steppers' invariant with a surplus -/

/-- (option 3) `ThInvMPL` with `CrPackLeX`: the step's credits pack up to `X`, which the stepper's
resource bound pays (`Tot + H' + X ≤ …`, `X` charged against the mix's complement). -/
def ThInvMPLX (p : Prog) (g : G) (E0 : TEnv) (s : St) (S0 : AllocLabel → List Res) (mem : Memory) (pairs : List Ts)
    (th : TTh) (Tot H X : Res) : Prop :=
  ∃ E, EFoot g E0 E s (stOf mem pairs th) ∧ SeenKeep E0 E ∧ BoxNewV E0 E s th ∧ ThInvRE p E th Tot ∧
    MemInv g E (stOf mem pairs th) ∧ MemHeldK E0 s S0 E (stOf mem pairs th) H ∧ CrPackLeX E0 E s (stOf mem pairs th) X

theorem mc_ofPLX {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem mem' : Memory} {pairs pairs' : List Ts}
    {th th' : TTh} {η : TEnv} {Tot H' X Rf Rs H : Res} {cr db : Ts → Res}
    (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hK : ThInvMPLX p g (CE η) (stOf mem pairs th) Sp mem' pairs' th' Tot H' X) (hle : Tot + H' + X ≤ Rf + Rs + H) :
    ∃ Tot H' C F, ThInvMCFS p g (CE η) (stOf mem pairs th) Sp mem' pairs' th' Tot H' cr db ∧
      MintStepN g η (stOf mem pairs th) (stOf mem' pairs' th') C F ∧
      Tot + H' + pSum (stOf mem' pairs' th') cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf mem' pairs' th') db + F := by
  obtain ⟨E, hF, hSK, hBV, hT, hm', hH', hP⟩ := hK
  obtain ⟨hC', e⟩ := hP cr db hC
  refine ⟨Tot, H', .zero, .zero, ⟨E, hF, (by seenT), (by boxT), hT, hm', hH', hC'⟩, .none, ?_⟩
  intro k
  have h1 := hle k
  have h2 := e k
  simp only [Res.add_apply, Res.zero_apply] at h1 h2 ⊢
  omega

theorem mc_ofPL {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem mem' : Memory} {pairs pairs' : List Ts} {th th' : TTh}
    {η : TEnv} {Tot H' Rf Rs H : Res} {cr db : Ts → Res}
    (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hK : ThInvMPL p g (CE η) (stOf mem pairs th) Sp mem' pairs' th' Tot H') (hle : Tot + H' ≤ Rf + Rs + H) :
    ∃ Tot H' C F, ThInvMCFS p g (CE η) (stOf mem pairs th) Sp mem' pairs' th' Tot H' cr db ∧
      MintStepN g η (stOf mem pairs th) (stOf mem' pairs' th') C F ∧
      Tot + H' + pSum (stOf mem' pairs' th') cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf mem' pairs' th') db + F := by
  obtain ⟨E, a1, a2, a3, a4, a5, a6, a7⟩ := hK
  exact mc_ofPLX (X := .zero) hC ⟨E, a1, a2, a3, a4, a5, a6, CrPackLe_X a7⟩
    (Res.le_def.2 fun k => by have e := hle k; simp only [Res.add_apply, Res.zero_apply] at e ⊢; omega)

theorem mc_liftPL {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {η : TEnv}
    {Rf Rs H : Res} {cr db : Ts → Res} (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (h : tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th,
      ∃ Tot H', ThInvMPL p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F :=
  ⟨h.1, fun r hr => by
    obtain ⟨Tot, H', hK, hle⟩ := h.2 r hr
    exact mc_ofPL hC hK hle⟩

theorem mc_liftPLX {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {η : TEnv} {Rf Rs H : Res} {cr db : Ts → Res} (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (h : tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th,
      ∃ Tot H' X, ThInvMPLX p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' X ∧ Tot + H' + X ≤ Rf + Rs + H) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧
      MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F :=
  ⟨h.1, fun r hr => by
    obtain ⟨Tot, H', X, hK, hle⟩ := h.2 r hr
    exact mc_ofPLX hC hK hle⟩

#print axioms mc_liftPLX

/-- (c1) `tstepMR_storePub`'s step at any mode whose clause gives a `pub`-like frontier (`hV`). -/
theorem tstepMR_storeCell {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx c' : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v : At} {tok : Option At}
    {μ : Mode} {u : Ty} {tv : Ty} {c₁ : Cx} {e : Expr} {Rf Rs H : Res}
    (hterm : th.term = .let_ x (.store rel a v tok) e)
    (hpk : cx.peek a = .ok (.ptr μ u)) (hnw : wordOf (Ty.ptr μ u) = none)
    (hu : cx.use v = .ok (tv, c₁)) (hsub : SubS c₁ tv u) (hb : c₁.bind x .unit = .ok c')
    (he : Typed p c' e) (hck : TermA4.CkW p η.wit c' e) (htv' : TvOK c') (hRk : skel c'.ret = skel cx.ret) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hia : StoreIall ρ η cx th)
    (hdw : StoreCrZ η cx (stOf mem pairs th) th)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel)
    (hV : ∀ rt pw ad c, evalAt th.env a = some (rt, [pw]) → pw.val = .loc ad 0 → η.sto ad.label = some c →
      ModeOK η.tid η.pfr η.seen μ ad.label c [pw] → ModeOK η.tid η.pfr η.seen .pub ad.label c [pw]) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th,
      ∃ Tot H' X, ThInvMPLX p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' X ∧ Tot + H' + X ≤ Rf + Rs + H := by
  have hi0 := hi.1
  have hotv : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have ho : cx.opaqueOK u = true := sub_opaqueOK hsub hotv
  have htb : tb cx.ke.length u = true := tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.ptr μ u) = some (μ, u))
  obtain ⟨lab, c, pw, μr, ru, hea, hpw, hsto, hcty, hmode, hacc, -, hsku, hsig⟩ := ptr_view hi0 hpk htv ho
  obtain ⟨f, hf, -⟩ := pubFr hea hpw hsto (hV _ pw ⟨lab, 0⟩ c hea hpw hsto hmode)
  obtain ⟨rv, wsv, Rv, Rr, hev, hvv, hlv, hvrv, hi1, hle⟩ := useR hu hi hE.2.2
  have hsat : Sat c₁.facts ρ := hi1.1.1
  have hlr : accs ru = accs c.ty := by
    rw [(Fd_lay hcty).2.2.1]
    exact pub_accs hi0.2.2.2.1 hi0.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi0.2.1 htv hpk rfl ho hea rfl
  obtain ⟨us, hus⟩ : ∃ us, accs ru = some us := by
    cases h : accs ru with
    | none => rw [h] at hlr; exact absurd hlr.symm hacc
    | some us => exact ⟨us, rfl⟩
  have husc : accs c.ty = some us := by rw [← hlr, hus]
  have hus' : wc c.ty = some (nWords us) := by simp [wc, husc]
  have hna : ∀ N e, c.ty ≠ .array (.lit N) e := fun N e he => by rw [he] at husc; simp [accs] at husc
  obtain ⟨hval, hlen⟩ := ownStoreVal hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 hsat hsub ho htb hvv hlv hsig hus
  replace hval := (Fd_EnvVal (CE η) hcty).2 hval
  have hsigu : sig (close th.σs u) = sig (cl ρ η.wit 0 0 u) :=
    sig_WitL hi0.2.2.2.1 ρ ho (lt_of_guardT htb hi0.2.2.2.2.1)
  have hvalR : EnvValR (CE η) c.ty wsv Rv := by
    obtain ⟨hs, -⟩ := Lay_canon hsub hlv
    have hvu : VRR ρ η u (shp (close th.σs u)) wsv Rv := by rw [← hs]; exact VRR_sub hsat hsub _ _ _ hvrv
    have hvc : VRR (fun _ => 0) (CE η) (cl ρ η.wit 0 0 u) (shp (cl ρ η.wit 0 0 u)) wsv Rv := by
      rw [← shp_of_sig hsigu]
      exact (VRR_close hE.2.1 hE.2.2 ρ u [] 0 ρ (fun _ => 0) (shp (close th.σs u)) wsv Rv (fun k => rfl)
        (fun k hk => absurd hk (Nat.not_lt_zero _))).1 hvu
    refine ⟨?_, hval.2⟩
    rw [(Fd_lay hcty).1]
    exact (Fd_VRR η hcty).2 hvc
  have key : tstep g mem pairs th =
      (storeUnits g.k g.arch pw ⟨lab, 0⟩ rel us wsv 0 (stOf mem pairs th)).map fun s' =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, .unit, []) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hev, cellOf, addrOf, hpw, hus, List.map_map]; rfl
  rw [key]
  obtain ⟨s0, hs0⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := pw) (a := ⟨lab, 0⟩) (rel := rel)
    us wsv 0 (stOf mem pairs th) hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hs0), fun r hr => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨s', hs', rfl⟩ := hr
  have hsn := hm.2.2.2.2.1
  have hfr := bindR hb hi1 (RLink_of hE.2.1 hE.2.2) (show VRR ρ η .unit (shp .unit) [] .zero from rfl) (unit_Lay _)
  rw [Res.add_zero] at hfr
  have hpkX : CrPackLeX (CE η) (CE η) (stOf mem pairs th) s' (Dsum (stOf mem pairs th) s' (fwr (CE η) (stOf mem pairs th))) :=
    storeUnits_packLeX hm hs'
      (fun j hj => hdw.1 x rel a v tok e hterm _ pw ⟨lab, 0⟩ μr ru us j hea (by simp [addrOf, hpw]) rfl hus hj)
  have hpay := hdw.2 ⟨lab, 0⟩ c c.ty us hsto (.here (Or.inl (by rw [husc]; simp))) husc
  obtain ⟨R0, H0, rfl, hent0, hX⟩ := MemHeldL_focusE hH lab
  by_cases hown : c.owner = some η.tid
  · -- the thread's own cell: as an own store
    rcases hpfl : (CE η).pfr lab with _ | f
    · obtain ⟨g2, -⟩ := storeUnits_latP (a := ⟨lab, 0⟩) us wsv 0 (stOf mem pairs th)
        (stOf mem pairs th).vs.vRelSt hm.2.2.1 (MemInv_nodup hm) (Nat.le_refl _) s' hs'
      have htail : ∀ j : Nat, j < nWords us → TailP (stOf mem pairs th) (offs ⟨lab, 0⟩ (0 + j)) := fun j hj => by
        have := OwnOKPF_tail hm.2.1 hsto hown hpfl hus' j hj
        simpa [offs] using this
      have hX' : MemHeldXL (CE η) s' lab H0 Sp := MemHeldXL_store (a := ⟨lab, 0⟩) hX hm.2.2.1 hs'
      have hnv : ∀ o, ¬ VisU (CE η) ⟨lab, o⟩ := fun o hv => hv.2 (Priv_of hsto hown hpfl)
      have hent : HeldEntry (CE η) s' lab Rv :=
        HeldEntry_ownN hsto (NVP_store (NVP_priv (Priv_of hsto hown hpfl)) hm.2.2.1 hs') (storeOwn_latestP hlen (g2 htail))
        (Or.inl ⟨by rw [hus', List.length_map, hlen], hvalR.store hsn⟩)
      refine ⟨Rr + Rs, Rv + H0, .zero, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Rr, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
        MemInv_storeF hm hsto hown husc hval hlen s' hs', MemHeldK_unfocus hX' hent (fun _ h => h.1 hpfl),
        CrPackLe_X (CrPack_le (CrKeep_pack (MemInv_promLt hm) (MemInv_nodup hm) (CrKeep_store hm hs' (fun o => not_VisD_priv (Priv_of hsto hown hpfl)))))⟩,
        Res.le_def.2 fun k => ?_⟩
      have h1 := hle k
      simp only [Res.add_apply, Res.zero_apply] at h1 ⊢
      omega
    · -- (F2) an own cell with a frontier: memory's holding by the mix (`heldMixAt`)
      have hatC : AtOff c.ty (⟨lab, 0⟩ : Address).offset c.ty := .here (Or.inl (by rw [husc]; simp))
      obtain ⟨H2, Sl2, Rb, comp, hH2, hHs0, hss, hcl, hvb, hcomp⟩ := heldMixAtLC (E := CE η) (nI := (CE η).rc) (TEnv.rc_le_ini (CE η) _) (a := ⟨lab, 0⟩) hm hH hsto hpfl hatC
        (IniAt_of_ne fun N e he => hna N e he) hna
        ((hia x rel a v tok e _ hterm hpk hnw _ pw ⟨lab, 0⟩ hea (by simp [addrOf, hpw]) c hsto).1 _ _ rfl 0 c.ty hatC) hfo.1 hvalR husc hlen hs'
      have hXb : Dsum (stOf mem pairs th) s' (fwr (CE η) (stOf mem pairs th)) ≤ Rb :=
        storeUnits_fwrPay (E := CE (CE η).unsee) (MemInv_promLt hm) (MemInv_nodup hm) hs' hcomp hcl hvb hpay
      have hHs := MemHeldK_ofSSet (s0 := stOf mem pairs th) hHs0 hss (Or.inl (Nat.le_refl _))
      refine ⟨Rr + Rs, H2, Dsum (stOf mem pairs th) s' (fwr (CE η) (stOf mem pairs th)), ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Rr, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
        MemInv_storeF hm hsto hown husc hval hlen s' hs', hHs, hpkX⟩, Res.le_def.2 fun k => ?_⟩
      have h1 := hle k
      have h2 := hH2 k
      have h3 := hXb k
      simp only [Res.add_apply] at h1 h2 h3 ⊢
      omega
  · -- another thread's published cell: a mix of the stored value and the old words
    obtain ⟨vals0, hL0, hC0⟩ := hent0.2 c hsto
    obtain ⟨hw0, hv0⟩ : wc c.ty = some vals0.length ∧ ValOfR (CE η) c.ty vals0 R0 := by
      rcases hC0 with h | ⟨N, e', _, _, hT, _⟩
      · exact h
      · exact absurd hT (hna N e')
    have hl0 : vals0.length = nWords us := by rw [hus'] at hw0; exact (Option.some.inj hw0).symm
    have hPb : ∀ t, t ∈ (stOf mem pairs th).promises → t < (stOf mem pairs th).mem.size :=
      fun t ht => hm.2.2.1 t ht
    obtain ⟨sel, vals', hWv, hLv, hcomp⟩ := storeUnits_NPmixF (E := CE η) us wsv 0 (stOf mem pairs th) s'
      (stOf mem pairs th).vs.vRelSt vals0 hs' (Nat.le_refl _) hPb hfo.1 hl0
      (fun j w hj => by simpa [offs] using hL0 j w hj)
    obtain ⟨hvn, hVn⟩ := hvalR.store hsn
    have hln : (wsv.map (bumpW (stOf mem pairs th).vs.vRelSt)).length = nWords us := by
      rw [List.length_map, hlen]
    obtain ⟨R', Rb, hvR', hvb, hR'⟩ := TermTear.VRR_mix2 (sel := sel) (MemInv_cplT hm hsto hf)
      ((hia x rel a v tok e _ hterm hpk hnw _ pw ⟨lab, 0⟩ hea (by simp [addrOf, hpw]) c hsto).1 _ _ rfl 0 c.ty (.here (Or.inl (by rw [husc]; simp)))) husc
      hvn hv0.1 hln hl0
    have hXb : Dsum (stOf mem pairs th) s' (fwr (CE η) (stOf mem pairs th)) ≤ Rb :=
      storeUnits_fwrPay (E := CE (CE η).unsee) (MemInv_promLt hm) (MemInv_nodup hm) hs'
        (fun t m j ht hn hm1 hl hV => hcomp t m j ht hn hm1 (by rw [hl, Nat.zero_add]) hV)
        (TermTear.length_mixU us sel _ _ hl0 hln) hvb hpay
    have hVm := TermTear.Valid_mix (sel := sel) husc hVn hv0.2 hln hl0
    have hlm := TermTear.length_mixU us sel _ _ hln hl0
    have hent : HeldEntry (CE η) s' lab R' := by
      refine ⟨fun h => (by rw [show (CE η).sto lab = η.sto lab from rfl, hsto] at h; cases h), fun c2 hc2 => ?_⟩
      rw [show (CE η).sto lab = η.sto lab from rfl, hsto] at hc2; cases hc2
      refine ⟨vals', fun o w hw => by simpa [offs] using hLv o w hw, Or.inl ⟨?_, ValOfR_up hWv ⟨hvR', hVm⟩⟩⟩
      rw [hus', ← WLe.length hWv, hlm]
    have hX' : MemHeldXL (CE η) s' lab H0 Sp := MemHeldXL_tr hX (fun _ _ => rfl) (fun _ _ => rfl)
      (fun l' hne o w hl => storeUnits_NPkeep us wsv 0 _ s' hs' ⟨l', o⟩ w
        (fun j _ he => hne (by have := congrArg WeakMem.Address.label he; simpa [offs] using this)) hl) id
    refine ⟨Rr + Rs, R' + H0, Dsum (stOf mem pairs th) s' (fwr (CE η) (stOf mem pairs th)), ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Rr, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
      MemInv_storePubAt (a := ⟨lab, 0⟩) hm hsto hown hf (.here (Or.inl (by rw [husc]; simp)))
        (IniAt_of_ne fun N e he => hna N e he) hna hval husc hlen s' hs',
      MemHeldK_unfocusNA hX' hent (fun c' N e hc' hT => by
        rw [show (CE η).sto lab = η.sto lab from rfl, hsto] at hc'; cases hc'; exact hna N e hT), hpkX⟩, Res.le_def.2 fun k => ?_⟩
    have h1 := hle k
    have h2 := hR' k
    have h3 := hXb k
    simp only [Res.add_apply] at h1 h2 h3 ⊢
    omega

/-- **(P4) `store` through a `pub` reference, with resources.** At the
thread's own cell as `tstepMR_storeOwn` (no promise there). At another
thread's published cell each unit may fulfil one of the thread's outstanding
promises, so the cell's new latest non-promise words are (above) a
unit-selection mix of the stored value and the old words (`storeUnits_NPmix`),
a value holding at most both values' resources (`VRR_mix`, with the stage-A
coupledness of published cells recorded in `PubCpl`, `MemInv_cplT`, and the
side condition `hia` on their components). The
stored value's resources leave the frame; the cell's entry moves from `R0`
to at most `Rv + R0`. Credits (P4 step 5a): a fulfilled promise lies in the
stored cell, off protocol words (`hdw`), so it carries `.zero` (`storeUnits_crZ`). -/
theorem tstepMR_storePub {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v : At} {tok : Option At}
    {u : Ty} {e : Expr} {Rf Rs H : Res}
    (hterm : th.term = .let_ x (.store rel a v tok) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.ptr .pub u)) (hnw : wordOf (Ty.ptr .pub u) = none)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hia : StoreIall ρ η cx th)
    (hdw : StoreCrZ η cx (stOf mem pairs th) th)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th,
      ∃ Tot H' X, ThInvMPLX p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' X ∧ Tot + H' + X ≤ Rf + Rs + H := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | storeWordGive hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storeWordKeep hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storeWordHand hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storeOwn hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeRgn hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeCap hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storePub hp _ hc hwf hu hsub _ hb =>
  obtain ⟨t, u', tv, c₁, hp, hc, hwf, hu, hsub, hb⟩ : ∃ t u' tv c₁, cx.peek a = .ok t ∧
      cellOf t = some (.pub, u') ∧ Ty.wordFreeIn cx.ke u' = true ∧ cx.use v = .ok (tv, c₁) ∧
      SubS c₁ tv u' ∧ c₁.bind x .unit = .ok c' :=
    ⟨_, _, _, _, hp, hc, hwf, hu, hsub, hb⟩
  rw [hpk] at hp; cases hp
  simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc; subst hc
  exact tstepMR_storeCell (hterm := hterm) (hpk := hpk) (hnw := hnw) (hu := hu) (hsub := hsub) (hb := hb) (he := he) (hck := hck) (htv' := htv') (hRk := hRk) (hi := hi) (hE := hE) (htv := htv) (hm := hm) (hH := hH) (hia := hia) (hdw := hdw) (hfo := hfo) (hRP := hRP) (hPS := hPS) (hV := fun _ _ _ _ _ _ _ h => h)

/-- (c1) `tstepMR_storePubLoc`'s step at any mode whose clause gives a `pub`-like frontier (`hV`). -/
theorem tstepMR_storeCellLoc {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx c' : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v : At} {tok : Option At}
    {μ : Mode} {u : Ty} {tv : Ty} {c₁ : Cx} {e : Expr} {Rf Rs H : Res}
    (hterm : th.term = .let_ x (.store rel a v tok) e)
    (hpk : cx.peek a = .ok (.loc μ u)) (hnw : wordOf (Ty.loc μ u) = none)
    (hu : cx.use v = .ok (tv, c₁)) (hsub : SubS c₁ tv u) (hb : c₁.bind x .unit = .ok c')
    (he : Typed p c' e) (hck : TermA4.CkW p η.wit c' e) (htv' : TvOK c') (hRk : skel c'.ret = skel cx.ret) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hia : StoreIall ρ η cx th)
    (hdw : StoreCrZ η cx (stOf mem pairs th) th)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hμ : μ ≠ .own)
    (hV : ∀ rt pw ad c, evalAt th.env a = some (rt, [pw]) → pw.val = .loc ad 0 → η.sto ad.label = some c →
      ModeOK η.tid η.pfr η.seen μ ad.label c [pw] → ModeOK η.tid η.pfr η.seen .pub ad.label c [pw]) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th,
      ∃ Tot H' X, ThInvMPLX p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' X ∧ Tot + H' + X ≤ Rf + Rs + H := by
  have hi0 := hi.1
  have hotv : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have ho : cx.opaqueOK u = true := sub_opaqueOK hsub hotv
  have htb : tb cx.ke.length u = true :=
    tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.loc μ u) = some (μ, u))
  obtain ⟨rv, wsv, Rv, Rr, hev, hvv, hlv, hvrv, hi1, hle⟩ := useR hu hi hE.2.2
  have hsat : Sat c₁.facts ρ := hi1.1.1
  have hsigu : sig (close th.σs u) = sig (cl ρ η.wit 0 0 u) :=
    sig_WitL hi0.2.2.2.1 ρ ho (lt_of_guardT htb hi0.2.2.2.2.1)
  have hwcu : wc (cl ρ η.wit 0 0 u) ≠ none := by
    rw [← wc_of_sig hsigu]; exact (Lay_canon hsub hlv).2.2.2.1
