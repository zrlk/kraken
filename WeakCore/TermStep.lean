/-! ### Wrappers: memory values (read at `CE η.unsee`, so no `seen` hypothesis) -/

/-- The environment relation the transfer needs: same program, and `η₂`
contains `η₁`'s store typing, initialised counts, frontiers and boxes.
`tid` and `seen` are free. -/
structure Incl (η₁ η₂ : TEnv) : Prop where
  prog : η₁.prog = η₂.prog
  sto : ∀ l c, η₁.sto l = some c → η₂.sto l = some c
  ini : ∀ l, η₁.ini l ≤ η₂.ini l
  pfr : ∀ l f, η₁.pfr l = some f → η₂.pfr l = some f
  box : ∀ l B, η₁.box l = some B → η₂.box l = some B
  rini : ∀ l, η₁.rini l ≤ η₂.rini l

theorem Incl.refl (η : TEnv) : Incl η η :=
  ⟨rfl, fun _ _ h => h, fun _ => Nat.le_refl _, fun _ _ h => h, fun _ _ h => h, fun _ => Nat.le_refl _⟩

theorem Incl.trans {η₁ η₂ η₃ : TEnv} (h1 : Incl η₁ η₂) (h2 : Incl η₂ η₃) : Incl η₁ η₃ :=
  ⟨h1.prog.trans h2.prog, fun l c h => h2.sto l c (h1.sto l c h), fun l => Nat.le_trans (h1.ini l) (h2.ini l),
    fun l f h => h2.pfr l f (h1.pfr l f h), fun l B h => h2.box l B (h1.box l B h),
    fun l => Nat.le_trans (h1.rini l) (h2.rini l)⟩

theorem noOwn_array {N : Idx} {e : Ty} (h : Ty.noOwnIn [] (.array N e) = true) : Ty.noOwnIn [] e = true := by
  simpa [Ty.noOwnIn] using h

theorem noOwn_seg {T S : Ty} {b : Nat} (hs : SegOf T b S) (h : Ty.noOwnIn [] T = true) :
    Ty.noOwnIn [] S = true := by
  rcases hs with ⟨-, rfl, -⟩ | ⟨N, us, j, rfl, -⟩
  · exact h
  · exact noOwn_array h

theorem ValOf_transfer {η₁ η₂ : TEnv} (hE : Incl η₁ η₂) {T : Ty} (hT : Ty.noOwnIn [] T = true)
    {ws : List Word} (h : ValOf η₁ T ws) : ValOf η₂ T ws :=
  ⟨VR_transfer T [] (CE η₁.unsee) (CE η₂.unsee) _ _ _ hT (fun _ _ _ h => h) (fun _ _ _ h => h) rfl hE.prog
    hE.sto hE.ini hE.pfr (fun _ h => h) hE.box h.1 hE.rini, h.2⟩

theorem ValOfS_transfer {η₁ η₂ : TEnv} (hE : Incl η₁ η₂) {T : Ty} (hT : Ty.noOwnIn [] T = true)
    {ws : List Word} (h : ValOfS η₁ T ws) : ValOfS η₂ T ws :=
  ⟨ValOf_transfer hE hT h.1, h.2⟩

theorem WordOK_transfer {η₁ η₂ : TEnv} (hE : Incl η₁ η₂) {T : Ty} (hT : Ty.noOwnIn [] T = true)
    {o : Nat} {w : Word} (h : WordOK η₁ T o w) : WordOK η₂ T o w := by
  obtain ⟨b, S, ws, o', w0, h1, h2, h3, h4, h5⟩ := h
  exact ⟨b, S, ws, o', w0, h1, ValOfS_transfer hE (noOwn_seg h1 hT) h2, h3, h4, h5⟩

theorem PairOK_transfer {η₁ η₂ : TEnv} (hE : Incl η₁ η₂) {T : Ty} (hT : Ty.noOwnIn [] T = true)
    {o : Nat} {w0 w1 : Word} (h : PairOK η₁ T o w0 w1) : PairOK η₂ T o w0 w1 := by
  obtain ⟨b, S, ws, o', x0, x1, h1, h2, h3, h4, h5, h6, h7⟩ := h
  exact ⟨b, S, ws, o', x0, x1, h1, ValOfS_transfer hE (noOwn_seg h1 hT) h2, h3, h4, h5, h6, h7⟩

theorem BufOK_transfer {η₁ η₂ : TEnv} (hE : Incl η₁ η₂) {T : Ty} (hT : Ty.noOwnIn [] T = true)
    {n : Nat} {vals : List Word} (h : BufOK η₁ n T vals) : BufOK η₂ n T vals := by
  obtain ⟨N, e, us, hTe, hu, hn, hl, hj⟩ := h
  subst hTe
  exact ⟨N, e, us, rfl, hu, hn, hl, fun j hjn => ValOf_transfer hE (noOwn_array hT) (hj j hjn)⟩

theorem CellOK_transfer {η₁ η₂ : TEnv} (hE : Incl η₁ η₂) {T : Ty} (hT : Ty.noOwnIn [] T = true)
    {n : Nat} {vals : List Word} (h : CellOK η₁ n T vals) : CellOK η₂ n T vals := by
  rcases h with ⟨h1, h2⟩ | h
  · exact Or.inl ⟨h1, ValOf_transfer hE hT h2⟩
  · exact Or.inr (BufOK_transfer hE hT h)

theorem ValOfR_transfer {η₁ η₂ : TEnv} (hE : Incl η₁ η₂) {T : Ty} (hT : Ty.noOwnIn [] T = true)
    {ws : List Word} {R : Res} (h : ValOfR η₁ T ws R) : ValOfR η₂ T ws R :=
  ⟨VRR_transfer T [] (CE η₁.unsee) (CE η₂.unsee) _ _ _ _ hT (fun _ _ _ _ h => h) (fun _ _ _ _ h => h) rfl
    hE.prog hE.sto hE.ini hE.pfr (fun _ h => h) hE.box h.1 hE.rini, h.2⟩

theorem BufOKR_transfer {η₁ η₂ : TEnv} (hE : Incl η₁ η₂) {T : Ty} (hT : Ty.noOwnIn [] T = true)
    {n nr : Nat} {vals : List Word} {R : Res} (h : BufOKR η₁ n nr T vals R) : BufOKR η₂ n nr T vals R := by
  obtain ⟨N, e, us, Rs, hTe, hu, hn, hl, hRs, hR, hj⟩ := h
  subst hTe
  exact ⟨N, e, us, Rs, rfl, hu, hn, hl, hRs, hR,
    fun j Rj h1 h2 => slotR_imp (hj j Rj h1 h2) rfl (ValOfR_transfer hE (noOwn_array hT))⟩

theorem CellOKR_transfer {η₁ η₂ : TEnv} (hE : Incl η₁ η₂) {T : Ty} (hT : Ty.noOwnIn [] T = true)
    {n nr : Nat} {vals : List Word} {R : Res} (h : CellOKR η₁ n nr T vals R) : CellOKR η₂ n nr T vals R := by
  rcases h with ⟨h1, h2⟩ | h
  · exact Or.inl ⟨h1, ValOfR_transfer hE hT h2⟩
  · exact Or.inr (BufOKR_transfer hE hT h)

/-! ### Values in a thread's own view (`seen` read) -/

/-- A value held in the thread's view (`EnvVal`, at `CE η`) moves when `seen`
grows. -/
theorem EnvVal_transfer {η₁ η₂ : TEnv} (hE : Incl η₁ η₂) (hS : ∀ l, η₁.seen l → η₂.seen l) {T : Ty}
    (hT : Ty.noOwnIn [] T = true) {ws : List Word} (h : EnvVal η₁ T ws) : EnvVal η₂ T ws :=
  ⟨VR_transfer T [] (CE η₁) (CE η₂) _ _ _ hT (fun _ _ _ h => h) (fun _ _ _ h => h) rfl hE.prog
    hE.sto hE.ini hE.pfr hS hE.box h.1 hE.rini, h.2⟩

/-- `VR_transfer` where `seen` may shrink: labels `η₁` has seen but `η₂` has
not must be published at a frontier at most `V`, and every pointer word of
`ws` carries a view at least `V` (`VR_unsee`, then `VR_transfer`). -/
theorem VR_transferU (V : Ts) (t : Ty) (ke : KEnv) (η₁ η₂ : TEnv) (ρ : Nat → Nat) (rt : Shp) (ws : List Word)
    (hn : Ty.noOwnIn ke t = true)
    (hr : ∀ k S vs, η₁.rels k S vs → η₂.rels k S vs) (hur : ∀ k S vs, η₁.urels k S vs → η₂.urels k S vs)
    (hw : η₁.wit = η₂.wit) (hE : Incl η₁ η₂)
    (hS : ∀ l, η₁.seen l → η₂.seen l ∨ ∃ f, η₁.pfr l = some f ∧ f ≤ V) (hL : LocAbove V ws)
    (hv : VR ρ η₁ t rt ws) : VR ρ η₂ t rt ws :=
  VR_transfer t ke { η₁ with seen := η₂.seen } η₂ ρ rt ws hn hr hur hw hE.prog hE.sto hE.ini hE.pfr
    (fun _ h => h) hE.box
    (VR_unsee V t η₁ { η₁ with seen := η₂.seen } ρ rt ws (fun _ _ _ h => h) (fun _ _ _ h => h) rfl rfl rfl
      (fun _ _ h => h) (fun _ => Nat.le_refl _) (fun _ _ h => h) hS (fun _ _ h => h) hL hv) hE.rini

/-! ### Published cells: their messages transfer (needs `PubCpl`'s noOwn clause) -/

/-- A message word of a published cell, typed at one thread's environment, is
typed at any environment containing it. -/
theorem WordOK_transfer_pub {g : G} {E₁ E₂ : TEnv} {s : St} {l : AllocLabel} {c : Cell} {f : Ts}
    (hm : MemInv g E₁ s) (hsto : E₁.sto l = some c) (hf : E₁.pfr l = some f) (hE : Incl E₁ E₂)
    {o : Nat} {w : Word} (h : WordOK E₁ c.ty o w) : WordOK E₂ c.ty o w :=
  WordOK_transfer hE (MemInv_noOwnT hm hsto hf) h

theorem PairOK_transfer_pub {g : G} {E₁ E₂ : TEnv} {s : St} {l : AllocLabel} {c : Cell} {f : Ts}
    (hm : MemInv g E₁ s) (hsto : E₁.sto l = some c) (hf : E₁.pfr l = some f) (hE : Incl E₁ E₂)
    {o : Nat} {w0 w1 : Word} (h : PairOK E₁ c.ty o w0 w1) : PairOK E₂ c.ty o w0 w1 :=
  PairOK_transfer hE (MemInv_noOwnT hm hsto hf) h

theorem CellOKR_transfer_pub {g : G} {E₁ E₂ : TEnv} {s : St} {l : AllocLabel} {c : Cell} {f : Ts}
    (hm : MemInv g E₁ s) (hsto : E₁.sto l = some c) (hf : E₁.pfr l = some f) (hE : Incl E₁ E₂)
    {n nr : Nat} {vals : List Word} {R : Res} (h : CellOKR E₁ n nr c.ty vals R) : CellOKR E₂ n nr c.ty vals R :=
  CellOKR_transfer hE (MemInv_noOwnT hm hsto hf) h

/-! ## B.2 (1) Runs of the machine -/

/-- Runs of the machine: the reflexive-transitive closure of `Step`. -/
inductive Steps (p : Prog) (k : Promises.Knobs) (arch : Arch) : Cfg → Cfg → Prop
  | refl (c : Cfg) : Steps p k arch c c
  | step {c c' c'' : Cfg} : Step p k arch c c' → Steps p k arch c' c'' → Steps p k arch c c''

namespace Steps

theorem single {p : Prog} {k : Promises.Knobs} {arch : Arch} {c c' : Cfg}
    (h : Step p k arch c c') : Steps p k arch c c' :=
  .step h (.refl _)

theorem trans {p : Prog} {k : Promises.Knobs} {arch : Arch} {c c' c'' : Cfg}
    (h1 : Steps p k arch c c') (h2 : Steps p k arch c' c'') : Steps p k arch c c'' := by
  induction h1 with
  | refl => exact h2
  | step hs _ ih => exact .step hs (ih h2)

theorem tail {p : Prog} {k : Promises.Knobs} {arch : Arch} {c c' c'' : Cfg}
    (h1 : Steps p k arch c c') (h2 : Step p k arch c' c'') : Steps p k arch c c'' :=
  h1.trans (single h2)

/-- Induction along a run: an invariant kept by every machine step holds at
every reachable configuration. -/
theorem inv {p : Prog} {k : Promises.Knobs} {arch : Arch} {P : Cfg → Prop}
    (hstep : ∀ c c', P c → Step p k arch c c' → P c') {c c' : Cfg}
    (h : Steps p k arch c c') (h0 : P c) : P c' := by
  induction h with
  | refl => exact h0
  | step hs _ ih => exact ih (hstep _ _ h0 hs)

end Steps

end TermStep

namespace TermSpawnStep
open CoreLang CoreTerm CoreTyping TermRun
open WeakMem (Arch)

/-! ### `StepsG` against `Steps` (downstream of TermSpawnStep, so here; kept on every base) -/
/-- A spawn-free run is a run with any extra relation. -/
theorem StepsG.ofSteps {p : Prog} {k : Promises.Knobs} {arch : Arch} {Sp : Cfg → Cfg → Prop} {c c' : Cfg}
    (h : TermStep.Steps p k arch c c') : StepsG p k arch Sp c c' := by
  induction h with
  | refl => exact .refl _
  | step hs _ ih => exact .step (.inl hs) ih

/-- A run with the empty extra relation `⊥` is a `Steps` run. -/
theorem StepsG.toSteps_bot {p : Prog} {k : Promises.Knobs} {arch : Arch} {c c' : Cfg}
    (h : StepsG p k arch (fun _ _ => False) c c') : TermStep.Steps p k arch c c' := by
  induction h with
  | refl => exact .refl _
  | step hs _ ih => exact .step (hs.elim id False.elim) ih

/-- **`StepsG ⊥` is `Steps`.** -/
theorem stepsG_bot_iff {p : Prog} {k : Promises.Knobs} {arch : Arch} {c c' : Cfg} :
    StepsG p k arch (fun _ _ => False) c c' ↔ TermStep.Steps p k arch c c' :=
  ⟨StepsG.toSteps_bot, StepsG.ofSteps⟩

#print axioms stepsG_bot_iff
#print axioms StepsG.ofSteps
#print axioms StepsG.toSteps_bot

end TermSpawnStep

namespace TermStep
open CoreLang CoreTerm CoreTyping TermRun TermClose TermTv TermSound TermMem
open WeakMem (Val Msg Memory Address VState Ts Arch AllocLabel)

theorem arr_get_set_ne {α : Type} (xs : Array α) {i j : Nat} (y : α) (h : i ≠ j) :
    (xs.set! i y)[j]? = xs[j]? := by
  simp only [Array.set!, Array.setIfInBounds]
  split
  · rw [Array.getElem?_set]; simp [h]
  · rfl

theorem arr_get_set_eq {α : Type} {xs : Array α} {i : Nat} {x : α} (y : α) (h : xs[i]? = some x) :
    (xs.set! i y)[i]? = some y := by
  have hi : i < xs.size := by
    rcases Nat.lt_or_ge i xs.size with h' | h'
    · exact h'
    · simp [h'] at h
  simp [hi]

/-- **A machine thread step, unfolded.** -/
theorem step_thread_inv {p : Prog} {k : Promises.Knobs} {arch : Arch} {c c' : Cfg} {i : Nat}
    (h : c' ∈ threadSteps p k arch c i) :
    ∃ th mem' pairs' th', c.ths[i]? = some th ∧
      (mem', pairs', th') ∈ tstep (gOf p k arch c i) c.mem c.pairs th ∧
      c' = { c with mem := mem', pairs := pairs', ths := c.ths.set! i th' } := by
  unfold threadSteps at h
  cases hth : c.ths[i]? with
  | none => rw [hth] at h; cases h
  | some th =>
      rw [hth] at h
      obtain ⟨⟨mem', pairs', th'⟩, hr, rfl⟩ := List.mem_map.1 h
      exact ⟨th, mem', pairs', th', rfl, hr, rfl⟩

theorem threadSteps_size {p : Prog} {k : Promises.Knobs} {arch : Arch} {c c' : Cfg} {i : Nat}
    (h : c' ∈ threadSteps p k arch c i) : c'.ths.size = c.ths.size := by
  obtain ⟨_, _, _, _, _, _, rfl⟩ := step_thread_inv h
  simp

theorem threadSteps_other {p : Prog} {k : Promises.Knobs} {arch : Arch} {c c' : Cfg} {i j : Nat}
    (h : c' ∈ threadSteps p k arch c i) (hj : j ≠ i) : c'.ths[j]? = c.ths[j]? := by
  obtain ⟨_, _, _, _, _, _, rfl⟩ := step_thread_inv h
  exact arr_get_set_ne _ _ (Ne.symm hj)

theorem threadSteps_lbase {p : Prog} {k : Promises.Knobs} {arch : Arch} {c c' : Cfg} {i : Nat}
    (h : c' ∈ threadSteps p k arch c i) : c'.lbase = c.lbase ∧ c'.boxFence = c.boxFence := by
  obtain ⟨_, _, _, _, _, _, rfl⟩ := step_thread_inv h
  exact ⟨rfl, rfl⟩

/-- The promise step, unfolded: thread `i`'s state is `promSt` of its old one. -/
theorem promise_inv {c : Cfg} {i : Nat} {a : Address} {v : WeakMem.Val} {w : Ts} {th : TTh}
    (hth : c.ths[i]? = some th) :
    promise c i a v w = { c with mem := (c.mem.push ⟨a, v, w⟩)
                                 ths := c.ths.set! i { th with promises := th.promises ++ [c.mem.size] } } ∧
      (promise c i a v w).ths[i]? = some { th with promises := th.promises ++ [c.mem.size] } ∧
      stOf (promise c i a v w).mem (promise c i a v w).pairs
          { th with promises := th.promises ++ [c.mem.size] } =
        promSt (stOf c.mem c.pairs th) a v w := by
  have e : promise c i a v w = { c with mem := (c.mem.push ⟨a, v, w⟩)
                                        ths := c.ths.set! i { th with promises := th.promises ++ [c.mem.size] } } := by
    simp only [promise, hth]
  refine ⟨e, ?_, ?_⟩
  · rw [e]; exact arr_get_set_eq _ hth
  · rw [e]; rfl

theorem promise_size (c : Cfg) (i : Nat) (a : Address) (v : WeakMem.Val) (w : Ts) :
    (promise c i a v w).ths.size = c.ths.size := by
  unfold promise; split <;> simp

theorem promise_other {c : Cfg} {i j : Nat} {a : Address} {v : WeakMem.Val} {w : Ts} (hj : j ≠ i) :
    (promise c i a v w).ths[j]? = c.ths[j]? := by
  unfold promise; split
  · rfl
  · exact arr_get_set_ne _ _ (Ne.symm hj)

/-- **A machine step, unfolded**: a thread step of some thread `i` (its `tstep`
at `gOf … c i`, the other threads untouched) or a promise step of `i` (its
state becomes `promSt`), and `i` certified afterwards. -/
theorem step_inv {p : Prog} {k : Promises.Knobs} {arch : Arch} {c c' : Cfg}
    (h : Step p k arch c c') :
    ∃ i, i < c.ths.size ∧ c'.ths.size = c.ths.size ∧ (∀ j, j ≠ i → c'.ths[j]? = c.ths[j]?) ∧
      Certified p k arch c' i ∧ c'.lbase = c.lbase ∧ c'.boxFence = c.boxFence ∧
      ∃ th, c.ths[i]? = some th ∧
      ((∃ mem' pairs' th', (mem', pairs', th') ∈ tstep (gOf p k arch c i) c.mem c.pairs th ∧
          c' = { c with mem := mem', pairs := pairs', ths := c.ths.set! i th' } ∧
          c'.ths[i]? = some th') ∨
       (∃ a v w, w < c.mem.size ∧ c' = promise c i a v w ∧
          c'.ths[i]? = some { th with promises := th.promises ++ [c.mem.size] } ∧
          c'.mem = c.mem.push ⟨a, v, w⟩ ∧ c'.pairs = c.pairs ∧
          stOf c'.mem c'.pairs { th with promises := th.promises ++ [c.mem.size] } =
            promSt (stOf c.mem c.pairs th) a v w)) := by
  cases h with
  | thread i hs hc =>
      obtain ⟨th, mem', pairs', th', hth, hr, e⟩ := step_thread_inv hs
      have hi : i < c.ths.size := by
        rcases Nat.lt_or_ge i c.ths.size with h' | h'
        · exact h'
        · simp [h'] at hth
      refine ⟨i, hi, threadSteps_size hs, fun j hj => threadSteps_other hs hj, hc,
        (threadSteps_lbase hs).1, (threadSteps_lbase hs).2, th, hth,
        .inl ⟨mem', pairs', th', hr, e, ?_⟩⟩
      rw [e]; exact arr_get_set_eq _ hth
  | prom i a v w hi hw hc =>
      have hth : c.ths[i]? = some c.ths[i] := by simp [hi]
      obtain ⟨e, h2, h3⟩ := promise_inv (a := a) (v := v) (w := w) hth
      refine ⟨i, hi, promise_size _ _ _ _ _, fun j hj => promise_other hj, hc, ?_, ?_, _, hth,
        .inr ⟨a, v, w, hw, rfl, h2, ?_, ?_, h3⟩⟩
      · rw [e]
      · rw [e]
      · rw [e]
      · rw [e]

theorem steps_size {p : Prog} {k : Promises.Knobs} {arch : Arch} {c c' : Cfg}
    (h : Steps p k arch c c') : c'.ths.size = c.ths.size := by
  induction h with
  | refl => rfl
  | step hs _ ih =>
      obtain ⟨_, _, hsz, _⟩ := step_inv hs
      rw [ih, hsz]

theorem steps_lbase {p : Prog} {k : Promises.Knobs} {arch : Arch} {c c' : Cfg}
    (h : Steps p k arch c c') : c'.lbase = c.lbase ∧ c'.boxFence = c.boxFence := by
  induction h with
  | refl => exact ⟨rfl, rfl⟩
  | step hs _ ih =>
      obtain ⟨_, _, _, _, _, h1, h2, _⟩ := step_inv hs
      exact ⟨ih.1.trans h1, ih.2.trans h2⟩

/-- (M0) No machine step changes the thread capacity. -/
theorem step_cap {p : Prog} {k : Promises.Knobs} {arch : Arch} {c c' : Cfg}
    (h : Step p k arch c c') : c'.cap = c.cap := by
  cases h with
  | thread i hs _ =>
      obtain ⟨_, _, _, _, _, _, rfl⟩ := step_thread_inv hs
      rfl
  | prom i a v w _ _ _ =>
      unfold promise; split <;> rfl

/-- (M0) No machine step changes the label stripe width `Cfg.n`. -/
theorem step_n {p : Prog} {k : Promises.Knobs} {arch : Arch} {c c' : Cfg}
    (h : Step p k arch c c') : c'.n = c.n := by
  obtain ⟨_, _, hsz, _⟩ := step_inv h
  simp only [Cfg.n, step_cap h, hsz]

theorem steps_cap {p : Prog} {k : Promises.Knobs} {arch : Arch} {c c' : Cfg}
    (h : Steps p k arch c c') : c'.cap = c.cap ∧ c'.n = c.n := by
  induction h with
  | refl => exact ⟨rfl, rfl⟩
  | step hs _ ih => exact ⟨ih.1.trans (step_cap hs), ih.2.trans (step_n hs)⟩

/-- (M0) A thread step keeps the stripe width. -/
theorem threadSteps_n {p : Prog} {k : Promises.Knobs} {arch : Arch} {c c' : Cfg} {i : Nat}
    (h : c' ∈ threadSteps p k arch c i) : c'.n = c.n := by
  obtain ⟨_, _, _, _, _, _, rfl⟩ := step_thread_inv h
  simp [Cfg.n]

/-- (M0) A promise keeps the stripe width. -/
theorem promise_n (c : Cfg) (i : Nat) (a : Address) (v : WeakMem.Val) (w : Ts) :
    (promise c i a v w).n = c.n := by
  simp only [Cfg.n, promise_size]
  unfold promise; split <;> rfl

/-! ### (S6) The exact footprint of a thread step (A-strict)

Every stage-A step lemma's witness is now an exact footprint of the old `CE η`
(`EFoot`, carried by `ThInvMF`/`ThInvMK`/`ThInvMP`/`ThInvMCF`): `tstepMF_step`,
`tstepMCF_step`.  Here the fresh labels are also blank in the old environment
(from `FreshLP`/`BoxInv`), and the promise step keeps the environment. -/

/-- (S6) A step's fresh labels are blank in the old environment. -/
theorem fresh_blank {g : G} {E : TEnv} {s : St} {n' : Nat} {l : AllocLabel} (hm : MemInv g E s)
    (hl : FreshIn g s.nalloc n' l) : E.sto l = none ∧ E.box l = none ∧ E.ini l = 0 ∧ E.pfr l = none := by
  obtain ⟨j, hj, -, rfl⟩ := hl
  obtain ⟨h1, -, h3, h4⟩ := hm.2.2.2.1.1 j hj
  exact ⟨h1, hm.2.2.2.2.2.2.2.2.2.1.1 j hj, h3, h4⟩

/-- (S6) **The footprint of a thread step**: `EFoot`, with the fresh labels
blank before the step. -/
def Foot (g : G) (E E' : TEnv) (s s' : St) : Prop :=
  EFootP g E E' s s' ∧ ∀ l, FreshIn g s.nalloc s'.nalloc l →
    E.sto l = none ∧ E.box l = none ∧ E.ini l = 0 ∧ E.pfr l = none

/-- (S6) A footprint between code-value views is an extension (`Ext`): Σ,
the boxes, the frontiers and `seen` only grow (fresh labels were blank). -/
theorem Foot_ext {g : G} {η η' : TEnv} {s s' : St} (hf : Foot g (CE η) (CE η') s s') : Ext (CE η) (CE η') := by
  obtain ⟨⟨hp, ht, hst, hbx, hin, hpf, hse, -, -, hri, -⟩, hbl⟩ := hf
  refine ⟨Coh_CE η', rfl, hp, ht, fun l c hc => ?_, fun l => (hin l).1, fun l f hfl => ?_, hse,
    fun l B hB => ?_, Nat.le_refl _, CohR_CE η', hri⟩
  · rcases hst l with h | ⟨hl, -⟩
    · rw [h]; exact hc
    · rw [(hbl l hl).1] at hc; cases hc
  · rcases hpf l with h | ⟨h0, -⟩ | ⟨-, h0, -⟩
    · rw [h]; exact hfl
    · rw [h0] at hfl; cases hfl
    · rw [h0] at hfl; cases hfl
  · rcases hbx l with h | ⟨hl, -⟩
    · rw [h]; exact hB
    · rw [(hbl l hl).2.1] at hB; cases hB

/-- (S6) **`tstepM_step` with the exact footprint**: every result meeting
`PromAbove` keeps the invariant at an environment `E'` that is an exact
footprint (`Foot`) of `CE η`. -/
theorem tstep_footprint {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv}
    [ProgRetIall p] (hP : ProgT p) (hp : g.p = p) (hn : 0 < g.n) (hnd : isDone th = false)
    (hsc : ScopeD th.σs cx th.term)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hbf : g.boxFence = true)
    (hpx : PAx g mem pairs th) (hwin : PubWinT (CE η) (stOf mem pairs th) th)
    (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hSub : PwSubS) (hSig : PwSig) (hZ : ZOK g (CE η) th := by exact fun _ _ h => False.elim h)
    (hPb : ∀ y a e rt ws ad, th.term = .let_ y (.publish a) e → evalAt th.env a = some (rt, ws) →
      ws.map (·.val) = [.loc ad 0] → g.pf ad.label := by exact fun _ _ _ _ _ _ _ _ _ => trivial) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      ∃ E', Foot g (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) ∧ Ext (CE η) E' ∧
        ThInvE p E' r.2.2 ∧ MemInv g E' (stOf r.1 r.2.1 r.2.2) := by
  rcases hsc with hsc | ⟨-, hc⟩
  case inr =>
    have k := tstep_cap (g := g) (mem := mem) (pairs := pairs) hP hc hT hi hE htv hRP hPS
    refine ⟨k.1, fun r hr _ => ?_⟩
    have hF : Foot g (CE η) (CE η) (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) :=
      ⟨EFoot_refl, fun l hl => fresh_blank hm hl⟩
    exact ⟨CE η, hF, Foot_ext hF, (k.2 r hr).1, MemInv_same hm (k.2 r hr).2⟩
  have h := tstepMF_step (hZ := hZ) (hPb := hPb) (hbf := hbf) hP hp hn hnd hsc hT hi hE htv hm hpx hwin hRP hPS hSub hSig
  refine ⟨h.1, fun r hr hpa => ?_⟩
  obtain ⟨E', hF, h1, h2⟩ := h.2 r hr hpa
  have hF' : Foot g (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) := ⟨hF.toP, fun l hl => fresh_blank hm hl⟩
  have hx : Ext (CE η) E' := by
    obtain ⟨_, η', _, hce, _⟩ := h1
    subst hce; exact Foot_ext hF'
  exact ⟨E', hF', hx, h1, h2⟩

/-- (S1b) **`tstep_footprint` at a `publish`**: the footprint's environment also gives the
published label a frontier (`ThInvMFP`), so a step at a `publish` of an `Σ` cell sets its `pfr`. -/
theorem tstep_footprintP {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv}
    [ProgRetIall p] (hP : ProgT p) (hsc : ScopeD th.σs cx th.term)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hwin : PubWinT (CE η) (stOf mem pairs th) th)
    (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hPb : ∀ y a e rt ws ad, th.term = .let_ y (.publish a) e → evalAt th.env a = some (rt, ws) →
      ws.map (·.val) = [.loc ad 0] → g.pf ad.label := by exact fun _ _ _ _ _ _ _ _ _ => trivial)
    {x : String} {a : At} {e : Expr} (hterm : th.term = .let_ x (.publish a) e) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th,
      ∃ E', Foot g (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) ∧ Ext (CE η) E' ∧
        ThInvE p E' r.2.2 ∧ MemInv g E' (stOf r.1 r.2.1 r.2.2) ∧
        ∀ y a e rt ws ad, th.term = .let_ y (.publish a) e → evalAt th.env a = some (rt, ws) →
          ws.map (·.val) = [.loc ad 0] → E'.pfr ad.label ≠ none := by
  have hsc' : StepScope cx th.term := by
    rcases hsc with hsc | ⟨-, x', e', ⟨a1, b1, h1⟩ | ⟨a1, h1⟩ | ⟨a1, h1⟩⟩
    · exact hsc
    all_goals (rw [hterm] at h1; cases h1)
  rw [hterm] at hsc'
  have h := tstepM_publish (hPb := hPb) hterm hP hT hi hE htv hm hsc' (fun rt ws ad => hwin _ _ _ rt ws ad hterm) hRP hPS
  refine ⟨h.1, fun r hr => ?_⟩
  obtain ⟨E', hF, h1, h2, hD⟩ := h.2 r hr
  have hF' : Foot g (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) := ⟨hF.toP, fun l hl => fresh_blank hm hl⟩
  have hx : Ext (CE η) E' := by
    obtain ⟨_, η', _, hce, _⟩ := h1
    subst hce; exact Foot_ext hF'
  exact ⟨E', hF', hx, h1, h2, hD⟩

/-- (S6) **`tstepMC_step` with the exact footprint** (resources and credits). -/
theorem tstep_footprintMC {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {Rf Rs H : Res} {cr db : Ts → Res}
    [ProgRetIall p] [TermA4.ProgCkWC p] (hP : ProgT p) (hp : g.p = p) (hn : 0 < g.n) (hnd : isDone th = false)
    (hsc : StepScope cx th.term ∨ StepScopeR th.σs cx th.term)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeld (CE η) (stOf mem pairs th) H)
    (hpx : PAx g mem pairs th) (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hia : StoreIall ρ η cx th)
    (hdw : StoreCrZ η cx (stOf mem pairs th) th) (hnvp : OwnOpT cx th.term → OwnNVPF (CE η) (stOf mem pairs th))
    (hwp : ∀ x a e rt ws ad, th.term = .let_ x (.publish a) e → evalAt th.env a = some (rt, ws) →
      ws.map (·.val) = [.loc ad 0] → FlipOK (CE η) (stOf mem pairs th) ad.label)
    (hwin : PubWinT (CE η) (stOf mem pairs th) th)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRF : OwnFrontierRMWT (CE η) (stOf mem pairs th) th.term) (hrmw : NoPlantRMW (CE η) th) (hbf : g.boxFence = true) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hSub : PwSubS) (hSig : PwSig) (hown1 : PubLe1 th Rf Rs H := by assumption)
    (hZ : ZOK g (CE η) th := by exact fun _ _ h => False.elim h)
    (hPb : ∀ y a e rt ws ad, th.term = .let_ y (.publish a) e → evalAt th.env a = some (rt, ws) →
      ws.map (·.val) = [.loc ad 0] → g.pf ad.label := by exact fun _ _ _ _ _ _ _ _ _ => trivial) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F cr' db',
      (∃ E', Foot g (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) ∧ Ext (CE η) E' ∧
        ThInvRE p E' r.2.2 Tot ∧
        MemInv g E' (stOf r.1 r.2.1 r.2.2) ∧ MemHeld E' (stOf r.1 r.2.1 r.2.2) H' ∧
        PromCr E' (stOf r.1 r.2.1 r.2.2) cr' db') ∧
      MintStep g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr' + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db' + F := by
  have h := tstepMCF_step (hZ := hZ) (hPb := hPb) hP hp hn hnd hsc hT hCk hi hE htv hm hH hpx hC hia hdw hnvp hwp hwin hfo hRF hrmw hbf hRP hPS hSub hSig
  refine ⟨h.1, fun r hr hpa => ?_⟩
  obtain ⟨Tot, H', C, F, cr', db', ⟨E', hF, -, -, h1, h2, h3, h4⟩, h5, -, h6⟩ := h.2 r hr hpa
  have hF' : Foot g (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) := ⟨hF.toP, fun l hl => fresh_blank hm hl⟩
  have hx : Ext (CE η) E' := by
    obtain ⟨_, η', _, _, _, hce, _⟩ := h1
    subst hce; exact Foot_ext hF'
  exact ⟨Tot, H', C, F, cr', db', ⟨E', hF', hx, h1, h2, h3, h4⟩, h5, h6⟩

/-- (S6) **The promise step's footprint**: memory gains one message, the
promises gain its timestamp, and the environment is unchanged. -/
theorem tstepMC_promE {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {Tot H : Res}
    {cr db : Ts → Res} {a : Address} {v : WeakMem.Val} {w : Ts} {E : TEnv}
    (hT : ThInvRE p E th Tot) (hm : MemInv g E (stOf mem pairs th)) (hH : MemHeld E (stOf mem pairs th) H)
    (hC : PromCr E (stOf mem pairs th) cr db)
    (hwu : ∀ η : TEnv, ThInvRE p (CE η) th Tot → MemInv g (CE η) (stOf mem pairs th) → VisU (CE η) a →
      ∃ c n P, η.sto a.label = some c ∧ AtOff c.ty a.offset (.word (.lit n) P) ∧
        P.ghost = false ∧ IniAt η.ini c a (.word (.lit n) P) ∧
        ∃ Rn, VRR (fun _ => 0) (CE (CE η).unsee) (.word (.lit n) P) (shp (.word (.lit n) P)) [mw ⟨a, v, w⟩] Rn)
    (hfw : ∀ η : TEnv, ThInvRE p (CE η) th Tot → MemInv g (CE η) (stOf mem pairs th) → PredU (CE η) a →
      ∃ h, FirstW mem a h) :
    ∃ H' cr' db', (∀ t, t < mem.size → cr' t = cr t ∧ db' t = db t) ∧
      ThInvRE p E { th with promises := th.promises ++ [mem.size] } Tot ∧
      MemInv g E (stOf (mem.push ⟨a, v, w⟩) pairs { th with promises := th.promises ++ [mem.size] }) ∧
      MemHeld E (stOf (mem.push ⟨a, v, w⟩) pairs { th with promises := th.promises ++ [mem.size] }) H' ∧
      PromCr E (stOf (mem.push ⟨a, v, w⟩) pairs { th with promises := th.promises ++ [mem.size] }) cr' db' ∧
      H' + pSum (promSt (stOf mem pairs th) a v w) cr' + pSum (stOf mem pairs th) db =
        H + pSum (stOf mem pairs th) cr + pSum (promSt (stOf mem pairs th) a v w) db' := by
  obtain ⟨ρ, η, cx, Rf, Rs, hE, hrest⟩ := hT
  subst hE
  have hT : ThInvRE p (CE η) th Tot := ⟨ρ, η, cx, Rf, Rs, rfl, hrest⟩
  obtain ⟨H', cr', db', hag, hH', hC', heq⟩ := promise_acct hH hC (MemInv_promLt hm) (hwu η hT hm) (hfw η hT hm)
  refine ⟨H', cr', db', hag, ⟨ρ, η, cx, Rf, Rs, rfl, hrest⟩, ?_, ?_, ?_, heq⟩
  · rw [stOf_promise]; exact MemInv_promSt hm
  · rw [stOf_promise]; exact hH'
  · rw [stOf_promise]; exact hC'

