/-- **(P4) A successful RMW at a plain one-word component, memory and
credits**: the RMW's store (`storeUnits`, from the post-load state) makes the
component's reading a mix of the stored value (holding `Rv`) and the old word
(`storeUnits_NPmix`), so memory holds at most `H + Rv` (`heldOne`); a
fulfilled promise there is not at a word position (`dwf`), so its debit is
zero and its credit is dropped. -/
theorem rmwPlainAcc {E : TEnv} {k : Promises.Knobs} {arch : Arch} {pw nw : Word} {rel : Bool}
    {s s1 s2 s' : St} {H Rv : Res} {cr db : Ts → Res} {a : Address} {c : Cell} {U : Ty}
    (hP : ∀ t, t ∈ s.promises → t < s.mem.size) (hFb : ∀ t, t ∈ E.fp → t < s.mem.size)
    (hH : MemHeld E s H) (hC : PromCr E s cr db)
    (hsto : E.sto a.label = some c) (hat : AtOff c.ty a.offset U) (hini : IniAt E.ini c a U)
    (hus : accs U = some [.one]) (hdw : dwf U = true)
    (hval : EnvValR E U [nw] Rv) (hS : SeenLE E s1.vs.vRelSt)
    (e1 : s1.mem = s.mem) (e2 : s1.promises = s.promises)
    (hs2 : s2 ∈ storeUnits k arch pw a rel [.one] [nw] 0 s1)
    (e3 : s'.mem = s2.mem) (e4 : s'.promises = s2.promises)
    (hcase : (∃ m, s'.mem = s.mem.push m ∧ s'.promises = s.promises) ∨
      (∃ tw pm, tw ∈ s.promises ∧ s'.mem = s.mem ∧ s'.promises = s.promises.erase tw ∧
        s.mem[tw]? = some pm ∧ pm.loc = a ∧
        ∃ tr mr, tr < tw ∧ s.mem[tr]? = some mr ∧ mr.loc = a ∧ mr.val ≠ .undef)) :
    ∃ H', MemHeld E s' H' ∧ PromCr E s' cr db ∧
      H' + pSum s' cr + pSum s db ≤ H + pSum s cr + pSum s' db + Rv := by
  have hna : ∀ N e, U ≠ .array (.lit N) e := fun N e h => by rw [h] at hus; simp [accs] at hus
  have hwc : wc U = some 1 := by simp [wc, hus, nWords, Acc.size]
  have ha0 : offs a (0 + 0) = a := by simp [offs]
  have hP1 : ∀ t, t ∈ s1.promises → t < s1.mem.size := by rw [e1, e2]; exact hP
  have hto : ∀ b w, LatestNP s2.mem (PromAt E s2 b) b w → LatestNP s'.mem (PromAt E s' b) b w :=
    fun b w h => by rw [PromAt_eqp e4, e3]; exact h
  obtain ⟨H', hH', hle⟩ : ∃ H', MemHeld E s' H' ∧ H' ≤ H + Rv := by
    refine heldOne (s' := s') hH hsto hat hini hna hwc (fun w0 Rq hl0 hv0 hV0 => ?_) (fun b w hb hl => ?_)
    · have hl0' : LatestNP s1.mem (PromAt E s1 a) a w0 := by rw [PromAt_eqp e2, e1]; exact hl0
      obtain ⟨sel, vals, hW, hL⟩ := storeUnits_NPmix (E := E) [.one] [nw] 0 s1 s2 s1.vs.vRelSt [w0] hs2
        (Nat.le_refl _) hP1 (fun t ht => by rw [e1]; exact hFb t ht) rfl (fun j x hj => by
          match j, hj with
          | 0, hj =>
            simp only [List.getElem?_cons_zero, Option.some.injEq] at hj
            subst hj; rw [ha0]; exact hl0')
      rw [TermTear.mixU_small (by simp) rfl rfl] at hW
      have hst := hval.store hS
      by_cases hs0 : sel 0 = true
      · simp only [hs0, ↓reduceIte] at hW
        obtain ⟨w1, rfl⟩ : ∃ w1, vals = [w1] := by
          match vals, hW with
          | [w1], _ => exact ⟨w1, rfl⟩
          | [], h => exact (h : False).elim
          | _ :: _ :: _, h => exact (h.2 : False).elim
        have hl1 := hL 0 w1 rfl
        rw [ha0] at hl1
        exact ⟨w1, Rv, hto _ _ hl1, VRR_up _ _ _ _ _ hW hst.1, Valid_vals _ _ _ hW.vals hst.2,
          Res.le_def.2 fun k => by simp only [Res.add_apply]; omega⟩
      · simp only [hs0] at hW
        obtain ⟨w1, rfl⟩ : ∃ w1, vals = [w1] := by
          match vals, hW with
          | [w1], _ => exact ⟨w1, rfl⟩
          | [], h => exact (h : False).elim
          | _ :: _ :: _, h => exact (h.2 : False).elim
        have hl1 := hL 0 w1 rfl
        rw [ha0] at hl1
        exact ⟨w1, Rq, hto _ _ hl1, VRR_up _ _ _ _ _ hW hv0, Valid_vals _ _ _ hW.vals hV0,
          Res.le_def.2 fun k => by simp only [Res.add_apply]; omega⟩
    · have hl' : LatestNP s1.mem (PromAt E s1 b) b w := by rw [PromAt_eqp e2, e1]; exact hl
      refine hto _ _ (storeUnits_NPkeep [.one] [nw] 0 s1 s2 hs2 b w (fun j hj => ?_) hl')
      have : j = 0 := by simp [nWords, Acc.size] at hj; omega
      subst this; rw [ha0]; exact hb
  rcases hcase with ⟨m, hmem, hpr⟩ | ⟨tw, pm, htw, hmem, hpr, hpm, hpl, tr, mr, htr, hmr, hmrl, hmrv⟩
  · refine ⟨H', hH', PromCr_keep hC hpr hP (fun t ht => by rw [hmem]; exact push_lt ht) (fun _ _ _ _ => rfl), ?_⟩
    have hpS : ∀ f, pSum s' f = pSum s f := fun f => by unfold pSum; rw [hpr]
    rw [hpS, hpS]
    exact Res.le_def.2 fun k => by have := hle k; simp only [Res.add_apply] at this ⊢; omega
  · have hdb0 : db tw = .zero := by
      obtain ⟨m0, hm0, hdb, -⟩ := hC tw htw
      rw [hpm] at hm0; cases hm0
      have hnD : ¬ DesigAt E s.mem pm.loc tw := by
        rintro ⟨-, -, -, hfw⟩
        rw [hpl] at hfw
        exact hmrv (hfw tr mr htr hmr hmrl)
      refine DbRes_noword hdb (fun n P ⟨c', hc', hat', hg'⟩ => ?_) hnD
      rw [hpl] at hc' hat'
      rw [hsto] at hc'; cases hc'
      have := AtOff_wordFree_disj hg' hat hdw hus hat'
      rw [show nWords [Acc.one] = 1 from rfl] at this; omega
    have e5 := pSum_erase (f := cr) hpr htw
    have e6 := pSum_erase (f := db) hpr htw
    refine ⟨H', hH', PromCr_erase hC hpr hP (fun t _ => by rw [hmem]) (fun _ _ _ _ => rfl), ?_⟩
    rw [e5, e6, hdb0]
    exact Res.le_def.2 fun k => by
      have := hle k; simp only [Res.add_apply, Res.zero_apply] at this ⊢; omega


