/-
T3c-4d: a thread's step against memory ("T3c-4d: the plan").

`ThInvE p E th` (TermSound) is the frame invariant with the thread-wide part
`E = CE η` named; `MemOK`/`OwnOK` (TermMem) read only `E`.  Here the two meet:

* `MemInv g E s`: memory is OK for Σ (`MemOKP`), the thread's own cells are at
  their latest values (`OwnOKP`), its promises are messages (`PromLt`), and
  every label it has yet to allocate is untouched — absent from Σ and from
  memory (`FreshLP`).  (S4) Throughout, the thread's own outstanding promises
  are skipped: they are invisible to it until fulfilled.
* `ThInvM p g mem pairs th`: `ThInvE` and `MemInv` at one `E`.  (S8b) Boxes
  may be any thread's: a box is read through `BoxTopP` (a reference whose view
  reaches the box's frontier) or, once seen, at the thread's coherence.

The control steps of TermSound keep `E` and touch no memory (`lift`, 4d-3);
`new`, and `load`/`store`/`xchg` at `own` references, grow Σ or memory and keep
both (4d-4 … 4d-6).

What is not here: promise steps and other threads' steps (T3c-6/7) — in
particular nothing yet excludes a promise at an own cell or at a label still
to be allocated (S4f: memory's readings skip own promises); `FreshL` records
what T3c-7 must establish.

Build: LEAN_PATH=build lean TermStep.lean
-/
import WeakCore.TermSpawnStep
import WeakCore.TermMem
import WeakCore.KindSound
import WeakCore.TermLiveProps
import WeakCore.TermViewInvC

namespace TermStep
open CoreLang CoreTerm CoreTyping TermRun TermClose TermTv TermSound TermMem
open WeakMem (Val Msg Memory Address VState Ts Arch AllocLabel)

/-! ## §1 The invariant -/

/-- (S4) `a`'s coherence view is at a message holding `w` that is not skipped
(`S`), and every later message to `a` is skipped.  With `S` the thread's own
outstanding promises, an own word is at its latest message other than them. -/
def LatestS (mem : Memory) (S : Ts → Prop) (coh : Address → Ts) (a : Address) (w : Word) : Prop :=
  (∃ m, mem[coh a]? = some m ∧ m.loc = a ∧ m.val = w.val ∧ ∀ x g, w.val = .loc x g → w.view ≤ m.view) ∧
    ¬ S (coh a) ∧ ∀ (t : Ts) (m : Msg), coh a < t → mem[t]? = some m → m.loc = a → S t

/-- (S4) `LatestS` skipping the timestamps of `P`. -/
abbrev LatestP (mem : Memory) (P : List Ts) (coh : Address → Ts) (a : Address) (w : Word) : Prop :=
  LatestS mem (· ∈ P) coh a w

/-- (S4) **The memory invariant, own promises skipped**: `MemOK` for every
message that is not one of the promises `P`. -/
def MemOKP (η : TEnv) (mem : Memory) (pairs P : List Ts) : Prop :=
  (∀ (t : Ts) (m : Msg) (c : Cell), t ∉ P → mem[t]? = some m → η.sto m.loc.label = some c →
     m.val = .undef ∨ WordOK η c.ty m.loc.offset (mw m)) ∧
  (∀ (t : Ts) (m0 m1 : Msg) (c : Cell), t ∈ pairs → mem[t]? = some m0 → mem[t + 1]? = some m1 →
     η.sto m0.loc.label = some c → PairOK η c.ty m0.loc.offset (mw m0) (mw m1)) ∧
  (∀ t, t ∈ pairs → t + 1 < mem.size)

/-- (F2′ (a′)) **The real count** of buffer `l`: the slots its owner has
initialised, `min ini rini` (what an `own` locative reads, `modeIni_own_rc`).
`ini` is the reader-visible count, which a planted frontier raises past it. -/
def _root_.TermSound.TEnv.rc (η : TEnv) (l : AllocLabel) : Nat := min (η.ini l) (η.rini l)

theorem _root_.TermSound.TEnv.rc_le_ini (η : TEnv) (l : AllocLabel) : η.rc l ≤ η.ini l := Nat.min_le_left _ _

theorem _root_.TermSound.TEnv.rc_mono {η η' : TEnv} (hi : ∀ l, η.ini l ≤ η'.ini l) (hri : ∀ l, η.rini l ≤ η'.rini l)
    (l : AllocLabel) : η.rc l ≤ η'.rc l := by
  have := hi l; have := hri l; unfold TEnv.rc; omega

theorem _root_.TermSound.TEnv.rc_congr {η η' : TEnv} {l : AllocLabel} (hi : η'.ini l = η.ini l) (hri : η'.rini l = η.rini l) :
    η'.rc l = η.rc l := by
  unfold TEnv.rc; rw [hi, hri]

theorem _root_.TermSound.TEnv.rc_max {η η' : TEnv} {l : AllocLabel} {k : Nat} (hi : η'.ini l = max (η.ini l) k)
    (hri : η'.rini l = max (η.rini l) k) : η'.rc l = max (η.rc l) k := by
  unfold TEnv.rc; rw [hi, hri]; omega

theorem modeIni_own_rc (η : TEnv) : modeIni .own η.ini η.rini = η.rc := rfl

/-- `IniAt_mono` at the address's label only. -/
theorem IniAt_monoAt {i₁ i₂ : AllocLabel → Nat} {c : Cell} {a : Address} {U : Ty}
    (h : i₁ a.label ≤ i₂ a.label) (hv : IniAt i₁ c a U) : IniAt i₂ c a U := by
  intro N e hc
  rcases hv N e hc with h1 | ⟨us, j, o, h1, h2, h3, h4⟩
  · exact Or.inl h1
  · exact Or.inr ⟨us, j, o, h1, Nat.lt_of_lt_of_le h2 h, h3, h4⟩

/-- (F2′ (a′)) `InitR` at the real count. -/
def InitRr (η : TEnv) (c : Cell) (l : AllocLabel) (o : Nat) : Prop :=
  ∀ N e us, c.ty = .array (.lit N) e → accs e = some us → o < η.rc l * nWords us

theorem InitRr.initR {η : TEnv} {c : Cell} {l : AllocLabel} {o : Nat} (h : InitRr η c l o) : InitR η c l o :=
  fun N e us h1 h2 => Nat.lt_of_lt_of_le (h N e us h1 h2) (Nat.mul_le_mul_right _ (η.rc_le_ini l))

/-- (S4) **The owner's invariant, skipped messages invisible**: `OwnOK` with
`LatestS`.  (F2′ (a′)) A buffer's initialised slots are its real count. -/
def OwnOKS (η : TEnv) (mem : Memory) (vs : VState) (S : Ts → Prop) : Prop :=
  ∀ l c, η.sto l = some c → c.owner = some η.tid →
    ∃ vals, CellOK η (η.rc l) c.ty vals ∧
      ∀ o v, vals[o]? = some v → LatestS mem S vs.coh ⟨l, o⟩ v

/-- (S4) `OwnOKS` skipping the timestamps of `P`. -/
abbrev OwnOKP (η : TEnv) (mem : Memory) (vs : VState) (P : List Ts) : Prop := OwnOKS η mem vs (· ∈ P)

/-- (S4) The thread's outstanding promises are messages. -/
def PromLt (s : St) : Prop := ∀ t, t ∈ s.promises → t < s.mem.size

/-- (privSlot) `a` is a word unit of an own buffer without a frontier past its
real count (`rc`): not yet initialised by the owner. -/
def PrivU (E : TEnv) (a : Address) : Prop :=
  ∃ c N e us, E.sto a.label = some c ∧ c.owner = some E.tid ∧ E.pfr a.label = none ∧
    c.ty = .array (.lit N) e ∧ accs e = some us ∧ E.rc a.label * nWords us ≤ a.offset ∧
    a.offset < N * nWords us

/-- (privSlot) **At an own private buffer's uninitialised unit the only
message besides the owner's promises is the allocation placeholder**: an
`.undef` at the thread's coherence there. -/
def PrivCoh (E : TEnv) (s : St) : Prop :=
  ∀ (t : Nat) (m : Msg), t ∉ s.promises → s.mem[t]? = some m → PrivU E m.loc →
    t = s.vs.coh m.loc ∧ m.val = .undef

/-- (privSlot) `PrivCoh` across a step: the new uninitialised private units were
such before, coherence there is unmoved, and every non-promise message at one is
an old non-promise message. -/
theorem PrivCoh_of {E E' : TEnv} {s s' : St} (h : PrivCoh E s) (hU : ∀ a, PrivU E' a → PrivU E a)
    (hcoh : ∀ a, PrivU E' a → s'.vs.coh a = s.vs.coh a)
    (hm : ∀ (t : Nat) (m : Msg), t ∉ s'.promises → s'.mem[t]? = some m → PrivU E' m.loc →
      t ∉ s.promises ∧ s.mem[t]? = some m) : PrivCoh E' s' := by
  intro t m ht hm' hu
  obtain ⟨h1, h2⟩ := hm t m ht hm' hu
  rw [hcoh _ hu]
  exact h t m h1 h2 (hU _ hu)
#print axioms PrivCoh_of

/-- (privSlot) A unit of a cell with a frontier is not an uninitialised private unit. -/
theorem notPrivU_pfr {E : TEnv} {a : Address} (h : E.pfr a.label ≠ none) : ¬ PrivU E a :=
  fun ⟨_, _, _, _, _, _, hp, _⟩ => h hp
#print axioms notPrivU_pfr

/-- (privSlot) A unit of another thread's cell is not an uninitialised private unit. -/
theorem notPrivU_own {E : TEnv} {a : Address} {c : Cell} (hsto : E.sto a.label = some c)
    (h : c.owner ≠ some E.tid) : ¬ PrivU E a :=
  fun ⟨_, _, _, _, hc, ho, _⟩ => by rw [hsto] at hc; cases hc; exact h ho
#print axioms notPrivU_own

/-- (privSlot) A unit of a cell that is not a buffer is not an uninitialised private unit. -/
theorem notPrivU_arr {E : TEnv} {a : Address} {c : Cell} (hsto : E.sto a.label = some c)
    (h : ∀ N e, c.ty ≠ .array (.lit N) e) : ¬ PrivU E a :=
  fun ⟨_, N, e, _, hc, _, _, hT, _⟩ => by rw [hsto] at hc; cases hc; exact h N e hT
#print axioms notPrivU_arr

theorem notPrivU_none {E : TEnv} {a : Address} (h : E.sto a.label = none) : ¬ PrivU E a :=
  fun ⟨_, _, _, _, hc, _⟩ => by rw [h] at hc; cases hc
#print axioms notPrivU_none

theorem PrivU_env {E E' : TEnv} {a : Address} (hs : E'.sto = E.sto) (ht : E.tid = E'.tid)
    (hPm : ∀ l f, E.pfr l = some f → E'.pfr l = some f) (hrc : ∀ l, E.rc l ≤ E'.rc l) :
    PrivU E' a → PrivU E a := fun ⟨c, N, e, us, h1, h2, h3, h4, h5, h6, h7⟩ => by
  refine ⟨c, N, e, us, by rw [← hs]; exact h1, by rw [ht]; exact h2, ?_, h4, h5,
    Nat.le_trans (Nat.mul_le_mul_right _ (hrc _)) h6, h7⟩
  cases hq : E.pfr a.label with
  | none => rfl
  | some f => rw [hPm _ f hq] at h3; cases h3
#print axioms PrivU_env

theorem PrivCoh_env {E E' : TEnv} {s : St} (h : PrivCoh E s) (hs : E'.sto = E.sto) (ht : E.tid = E'.tid)
    (hPm : ∀ l f, E.pfr l = some f → E'.pfr l = some f) (hrc : ∀ l, E.rc l ≤ E'.rc l) : PrivCoh E' s :=
  PrivCoh_of h (fun _ => PrivU_env hs ht hPm hrc) (fun _ _ => rfl) (fun _ _ h1 h2 _ => ⟨h1, h2⟩)
#print axioms PrivCoh_env


/-- Every label the thread has yet to allocate is untouched: not in Σ, (S4)
with no message in memory other than the thread's own promises, (T3c-5b) with
no slot counted initialised, and (M3) with no frontier.  (privSlot) Memory the
owner has not initialised: `PrivCoh`. -/
def FreshLP (g : G) (E : TEnv) (s : St) : Prop :=
  (∀ j, s.nalloc ≤ j →
    E.sto (freshLabel g.lbase g.n g.i j) = none ∧
    (∀ (t : Nat) (m : Msg), s.mem[t]? = some m → m.loc.label = freshLabel g.lbase g.n g.i j → t ∈ s.promises) ∧
    E.ini (freshLabel g.lbase g.n g.i j) = 0 ∧ E.pfr (freshLabel g.lbase g.n g.i j) = none) ∧
  PrivCoh E s

/-- (S4) `Hidden` for the messages that are not promises of `P`. -/
def HiddenP (η : TEnv) (T : Ty) (mem : Memory) (P : List Ts) (l : AllocLabel) (o : Nat) (V : Ts) : Prop :=
  ∀ (t : Nat) (m : Msg), t ∉ P → mem[t]? = some m → m.loc = ⟨l, o⟩ → ¬ WordOK η T o (mw m) →
    ∃ (t' : Nat) (m' : Msg), t < t' ∧ t' ≤ V ∧ mem[t']? = some m' ∧ m'.loc = ⟨l, o⟩

/-- (Z1a′) A buffer of zero-width elements: it has no word units, so nothing in memory is at it. -/
def ZW (E : TEnv) (l : AllocLabel) : Prop :=
  ∃ c N e us, E.sto l = some c ∧ c.ty = .array (.lit N) e ∧ accs e = some us ∧ nWords us = 0

/-- (S4) `OwnHid` with `HiddenP`.  (F2′ (a′)) Two parts: the slots of the real
count are hidden below `vWr` (what the owner's `own` reads need); and a cell
whose reader-visible count is past its real one (a planted cell) has a
frontier, is not seen (Z1a′: unless it is zero-width, `ZW`), and its reader-visible slots are hidden below the
frontier (what the owner's `pub` reads of it need). -/
def OwnHidP (η : TEnv) (mem : Memory) (vs : VState) (P : List Ts) : Prop :=
  (∀ l c, η.sto l = some c → c.owner = some η.tid → ∀ o, InitRr η c l o → HiddenP η c.ty mem P l o vs.vWr) ∧
  (∀ l c, η.sto l = some c → c.owner = some η.tid → η.rc l < η.ini l →
    ∃ f, η.pfr l = some f ∧ (¬ ZW η l → ¬ η.seen l) ∧ ∀ o, InitR η c l o → HiddenP η c.ty mem P l o f)

/-- (Z1a′) `ZW` reads only the cell at `l`. -/
theorem ZW.stoAt {E E' : TEnv} {l : AllocLabel} (h : E'.sto l = E.sto l) : ZW E' l ↔ ZW E l := by
  unfold ZW; rw [h]

/-- (Z1a′) A zero-width buffer has no initialised unit. -/
theorem ZW.not_of_initR {E : TEnv} {l : AllocLabel} {c : Cell} {o : Nat} (hc : E.sto l = some c)
    (h : InitR E c l o) : ¬ ZW E l := by
  rintro ⟨c', N, e, us, h1, h2, h3, h4⟩
  rw [hc] at h1; cases h1
  have := h N e us h2 h3
  rw [h4, Nat.mul_zero] at this
  exact Nat.not_lt_zero _ this

/-- (S4) `PubDef` with `HiddenP`. -/
def PubDefP (η : TEnv) (mem : Memory) (P : List Ts) : Prop :=
  ∀ l c f, η.sto l = some c → c.owner ≠ some η.tid → η.pfr l = some f → ∀ o, InitR η c l o →
    HiddenP η c.ty mem P l o f

/-- (S4, L1) Every own outstanding promise is above coherence at its address:
what certification gives (`certified_promAbove`).  Not an invariant clause (an
own append above a promise breaks it): a post-state hypothesis of the steps
that read memory. -/
def PromAbove (s : St) : Prop := ∀ t, t ∈ s.promises → ∀ m, s.mem[t]? = some m → s.vs.coh m.loc < t

/-- (S4) **Some thread step keeps every promise above coherence**, or there is
no outstanding promise: what certification gives for the thread's next step.
A hypothesis of the steps whose progress needs a read of the latest value
(an outstanding promise may hide it). -/
def PAx (g : G) (mem : Memory) (pairs : List Ts) (th : TTh) : Prop :=
  th.promises = [] ∨ ∃ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2)

/-- (HPA) A conclusion about every result gives one about every result
meeting a premise. -/
theorem paW {α : Type _} {L : List α} {P Q : α → Prop} (h : L ≠ [] ∧ ∀ r ∈ L, Q r) :
    L ≠ [] ∧ ∀ r ∈ L, P r → Q r :=
  ⟨h.1, fun r hr _ => h.2 r hr⟩

/-- (HPA) The per-result form, with the premise for every result: the
all-results form. -/
theorem paA {α : Type _} {L : List α} {P Q : α → Prop} (h : L ≠ [] ∧ ∀ r ∈ L, P r → Q r)
    (hp : ∀ r ∈ L, P r) : L ≠ [] ∧ ∀ r ∈ L, Q r :=
  ⟨h.1, fun r hr => h.2 r hr (hp r hr)⟩

/-- (HPA) The taken result's `PromAbove` gives `PAx`. -/
theorem PAx_of_mem {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {r : Memory × List Ts × TTh}
    (hr : r ∈ tstep g mem pairs th) (hp : PromAbove (stOf r.1 r.2.1 r.2.2)) : PAx g mem pairs th :=
  Or.inr ⟨r, hr, hp⟩


/-! ### (S4) Memory facts with the thread's own promises skipped -/

theorem LatestS_of_latest {mem : Memory} {S : Ts → Prop} {coh : Address → Ts} {a : Address} {w : Word}
    (h : Latest mem coh a w) (hs : ¬ S (coh a)) : LatestS mem S coh a w :=
  ⟨h.1, hs, fun t m ht hm hl => absurd hl (h.2 t m ht hm)⟩

theorem LatestS_latest {mem : Memory} {S : Ts → Prop} {coh : Address → Ts} {a : Address} {w : Word}
    (h : LatestS mem S coh a w) (hn : ∀ t, ¬ S t) : Latest mem coh a w :=
  ⟨h.1, fun t m ht hm hl => hn t (h.2.2 t m ht hm hl)⟩

/-- (S4) `Latest` is `LatestP` skipping nothing. -/
theorem latest_iff_nil {mem : Memory} {coh : Address → Ts} {a : Address} {w : Word} :
    Latest mem coh a w ↔ LatestP mem [] coh a w :=
  ⟨fun h => LatestS_of_latest h (by simp), fun h => LatestS_latest h fun _ => by simp⟩

theorem LatestS_congr {mem : Memory} {S S' : Ts → Prop} {coh coh' : Address → Ts} {a : Address} {w : Word}
    (h : LatestS mem S coh a w) (hc : coh' a = coh a) (hS : ∀ t, S t → S' t) (hS' : ∀ t, S' t → S t) :
    LatestS mem S' coh' a w := by
  obtain ⟨h1, h2, h3⟩ := h
  refine ⟨by rw [hc]; exact h1, fun hs => h2 (hS' _ (by rw [hc] at hs; exact hs)), fun t m ht hm hl =>
    hS t (h3 t m (by rw [← hc]; exact ht) hm hl)⟩

theorem MemOKP_of {η : TEnv} {mem : Memory} {pairs : List Ts} (P : List Ts) (h : MemOK η mem pairs) :
    MemOKP η mem pairs P :=
  ⟨fun t m c _ hm hc => h.1 t m c hm hc, h.2.1, h.2.2⟩

theorem HiddenP_of {η : TEnv} {T : Ty} {mem : Memory} {l : AllocLabel} {o : Nat} {V : Ts} (P : List Ts)
    (h : Hidden η T mem l o V) : HiddenP η T mem P l o V :=
  fun t m _ hm hl hn => h t m hm hl hn

theorem PromAbove_low {s : St} (h : PromAbove s) {t : Ts} {m : Msg} (ht : t ∈ s.promises)
    (hm : s.mem[t]? = some m) (hle : t ≤ s.vs.coh m.loc) : False :=
  absurd (h t ht m hm) (Nat.not_lt.2 hle)

/-- (S4) The coherence tail of `b`: every message to `b` after coherence is a promise. -/
def TailP (s : St) (b : Address) : Prop :=
  ∀ (t : Ts) (m : Msg), s.vs.coh b < t → s.mem[t]? = some m → m.loc = b → t ∈ s.promises

/-- (S4) A message appended at `a`, coherence moved to it, past every skipped
timestamp, is `a`'s latest. -/
theorem LatestP_push_top {mem : Memory} {P : List Ts} {coh : Address → Ts} {a : Address} {v : Word} {mv : Ts}
    (hc : coh a = mem.size) (hP : ∀ t, t ∈ P → t < mem.size) (hv : ∀ x g, v.val = .loc x g → v.view ≤ mv) :
    LatestP (mem.push ⟨a, v.val, mv⟩) P coh a v :=
  LatestS_of_latest (Latest_push_top hc hv) (fun h => by rw [hc] at h; exact Nat.lt_irrefl _ (hP _ h))

theorem LatestS_push_other {mem : Memory} {S : Ts → Prop} {coh coh' : Address → Ts} {a b : Address} {v : Word}
    {v' : WeakMem.Val} {mv : Ts} (hl : LatestS mem S coh b v) (hb : b ≠ a) (hc : coh' b = coh b) :
    LatestS (mem.push ⟨a, v', mv⟩) S coh' b v := by
  obtain ⟨⟨m, hm, hma, hmv, hmw⟩, hn, hl⟩ := hl
  refine ⟨⟨m, by rw [hc, push_lt (lt_of_get hm)]; exact hm, hma, hmv, hmw⟩, by rw [hc]; exact hn,
    fun t m' ht hm' hl' => ?_⟩
  rw [hc] at ht
  rw [Array.getElem?_push] at hm'
  split at hm'
  · simp only [Option.some.injEq] at hm'; subst hm'; exact absurd hl' (Ne.symm hb)
  · exact hl t m' ht hm' hl'

theorem TailP_push_other {s s1 : St} {a b : Address} {v' : WeakMem.Val} {mv : Ts} (h : TailP s b) (hb : b ≠ a)
    (hm : s1.mem = s.mem.push ⟨a, v', mv⟩) (hc : s1.vs.coh b = s.vs.coh b) (hp : s1.promises = s.promises) :
    TailP s1 b := by
  intro t m ht hm' hl
  rw [hm, Array.getElem?_push] at hm'
  rw [hc] at ht
  rw [hp]
  split at hm'
  · simp only [Option.some.injEq] at hm'; subst hm'; exact absurd hl (Ne.symm hb)
  · exact h t m ht hm' hl

/-- (S4) The promise `t0` at `a` discharged, coherence elsewhere unmoved: `b`'s
latest stays. -/
theorem LatestP_erase_other {mem : Memory} {P : List Ts} {coh coh' : Address → Ts} {a b : Address} {v : Word}
    {t0 : Ts} {m0 : Msg} (hl : LatestP mem P coh b v) (hm0 : mem[t0]? = some m0) (ha : m0.loc = a) (hb : b ≠ a)
    (hc : coh' b = coh b) : LatestP mem (P.erase t0) coh' b v := by
  obtain ⟨h1, h2, h3⟩ := hl
  refine ⟨by rw [hc]; exact h1, fun h => h2 (by rw [hc] at h; exact List.mem_of_mem_erase h), fun t m ht hm hl' => ?_⟩
  rw [hc] at ht
  have hne : t ≠ t0 := by
    intro e; subst e; rw [hm0] at hm; cases hm; exact hb (hl'.symm.trans ha)
  exact (List.mem_erase_of_ne hne).2 (h3 t m ht hm hl')

theorem TailP_erase_other {s s1 : St} {a b : Address} {t0 : Ts} {m0 : Msg} (h : TailP s b)
    (hm0 : s.mem[t0]? = some m0) (ha : m0.loc = a) (hb : b ≠ a)
    (hm : s1.mem = s.mem) (hc : s1.vs.coh b = s.vs.coh b) (hp : s1.promises = s.promises.erase t0) :
    TailP s1 b := by
  intro t m ht hm' hl
  rw [hm] at hm'
  rw [hc] at ht
  rw [hp]
  have hne : t ≠ t0 := by
    intro e; subst e; rw [hm0] at hm'; cases hm'; exact hb (hl.symm.trans ha)
  exact (List.mem_erase_of_ne hne).2 (h t m ht hm' hl)

/-- (S4) A store's ordering bound is at least coherence at the stored address. -/
theorem storeOb_coh (k : Promises.Knobs) (arch : Arch) (th : Promises.Thread) (a : Address) (e : WeakMem.Expr)
    (deps : List WeakMem.Reg) : th.vs.coh a ≤ Promises.storeOb k arch th a e deps := by
  unfold Promises.storeOb
  cases e <;> dsimp only <;> split <;>
    first
      | exact Nat.le_trans (Nat.le_max_right _ _) (Nat.le_max_right _ _)
      | exact Nat.le_trans (Nat.le_trans (Nat.le_max_right _ _) (Nat.le_max_right _ _)) (Nat.le_max_left _ _)

/-- (S4) **A one-word store**, in full: it appends at the top, or fulfils one
of the thread's promises above coherence at `a` (with the stored value and a
view covering the store's), discharging it; coherence at `a` moves to it and
`vWr` covers it. -/
theorem stepStore_casesC {k : Promises.Knobs} {arch : Arch} {mem mem' : Memory} {th th' : Promises.Thread}
    {a : Address} {e : WeakMem.Expr} {deps : List WeakMem.Reg} {rel : Bool}
    (h : (mem', th') ∈ Promises.stepStore k arch mem th a e deps rel) :
    ∃ t, ((mem' = mem.push ⟨a, exprVal th e, Promises.storeMview th e deps rel⟩ ∧ t = mem.size ∧
            th'.promises = th.promises) ∨
          (mem' = mem ∧ t ∈ th.promises ∧ th'.promises = th.promises.erase t ∧ th.vs.coh a < t ∧
            ∃ m, mem[t]? = some m ∧ m.loc = a ∧ m.val = exprVal th e ∧
              Promises.storeMview th e deps rel ≤ m.view)) ∧
      th'.vs.coh = (fun b => if b = a then t else th.vs.coh b) ∧ th'.vs.vRelSt = th.vs.vRelSt ∧
      th'.vs.vWr = max th.vs.vWr t := by
  cases e with
  | const c =>
      simp only [Promises.stepStore, List.mem_append, List.mem_singleton, List.mem_filterMap] at h
      rcases h with h | ⟨t, htp, hf⟩
      · simp only [Prod.mk.injEq] at h
        obtain ⟨rfl, rfl⟩ := h
        exact ⟨mem.size, Or.inl ⟨rfl, rfl, rfl⟩, rfl, rfl, rfl⟩
      · cases hm : mem[t]? with
        | none => simp [hm] at hf
        | some m =>
            simp only [hm] at hf
            split at hf
            · rename_i hcond
              simp only [Option.some.injEq, Prod.mk.injEq] at hf
              obtain ⟨rfl, rfl⟩ := hf
              simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hcond
              exact ⟨t, Or.inr ⟨rfl, htp, rfl, Nat.lt_of_le_of_lt (storeOb_coh _ _ _ _ _ _) hcond.2,
                m, hm, hcond.1.1.1, hcond.1.1.2, hcond.1.2⟩, rfl, rfl, rfl⟩
            · simp at hf
  | reg r =>
      simp only [Promises.stepStore, List.mem_append, List.mem_singleton, List.mem_filterMap] at h
      rcases h with h | ⟨t, htp, hf⟩
      · simp only [Prod.mk.injEq] at h
        obtain ⟨rfl, rfl⟩ := h
        exact ⟨mem.size, Or.inl ⟨rfl, rfl, rfl⟩, rfl, rfl, rfl⟩
      · cases hm : mem[t]? with
        | none => simp [hm] at hf
        | some m =>
            simp only [hm] at hf
            split at hf
            · rename_i hcond
              simp only [Option.some.injEq, Prod.mk.injEq] at hf
              obtain ⟨rfl, rfl⟩ := hf
              simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hcond
              exact ⟨t, Or.inr ⟨rfl, htp, rfl, Nat.lt_of_le_of_lt (storeOb_coh _ _ _ _ _ _) hcond.2,
                m, hm, hcond.1.1.1, hcond.1.1.2, hcond.1.2⟩, rfl, rfl, rfl⟩
            · simp at hf


theorem push2_lt {M : Memory} {x y : Msg} {t : Nat} (h : t < M.size) : ((M.push x).push y)[t]? = M[t]? := by
  rw [push_lt (show t < (M.push x).size by rw [Array.size_push]; omega), push_lt h]

/-- (S4) **A store's promises**: kept or discharged; each discharged promise is
a message at one of the stored words, holding that word's value, with a view
covering the release view and the word's pointer view. -/
theorem storeUnits_promF {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s s' : St), PromLt s →
      s' ∈ storeUnits k arch pw a rel us ws i s →
      PromLt s' ∧ s'.promises.Sublist s.promises ∧
      ∀ t, t ∈ s.promises → t ∉ s'.promises → ∃ (m : Msg) (j : Nat) (w : Word), s.mem[t]? = some m ∧
        j < nWords us ∧ ws[j]? = some w ∧ m.loc = offs a (i + j) ∧ m.val = w.val ∧ s.vs.vRelSt ≤ m.view ∧
        ∀ x g, w.val = .loc x g → w.view ≤ m.view
  | [], _, _, s, s', hpl, hs => by
      simp only [storeUnits, List.mem_singleton] at hs; subst hs
      exact ⟨hpl, List.Sublist.refl _, fun t h1 h2 => absurd h1 h2⟩
  | .one :: us, w :: ws, i, s, s', hpl, hs => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      obtain ⟨t0, hcase, -, hrs, -⟩ := stepStore_casesC hst
      have hmw : ∀ x g, w.val = .loc x g → w.view ≤ Promises.storeMview (mth s pw w w) (dataE 1 w) [0] rel :=
        storeMview_dataE _ 1 w (by simp [mth, regsOf]) [0] rel
      have hmr : s.vs.vRelSt ≤ Promises.storeMview (mth s pw w w) (dataE 1 w) [0] rel :=
        storeMview_relSt (mth s pw w w) _ [0] rel
      have ev : exprVal (mth s pw w w) (dataE 1 w) = w.val := exprVal_dataE _ 1 w (by simp [mth, regsOf])
      have hpl1 : PromLt { s with mem := mem', vs := th.vs, promises := th.promises } := by
        rcases hcase with ⟨hmem, -, hprom⟩ | ⟨hmem, -, hprom, -⟩
        · intro t ht
          have ht' : t ∈ s.promises := by have : t ∈ th.promises := ht; rw [hprom] at this; exact this
          show t < mem'.size
          rw [hmem, Array.size_push]; exact Nat.lt_succ_of_lt (hpl t ht')
        · intro t ht
          have ht' : t ∈ s.promises := by
            have : t ∈ th.promises := ht; rw [hprom] at this; exact List.mem_of_mem_erase this
          show t < mem'.size
          rw [hmem]; exact hpl t ht'
      obtain ⟨g0, g1, g2⟩ := storeUnits_promF us ws (i + 1) _ s' hpl1 hs
      have hold : ∀ t m, t < s.mem.size → mem'[t]? = some m → s.mem[t]? = some m := by
        intro t m ht hm
        rcases hcase with ⟨hmem, -⟩ | ⟨hmem, -⟩
        · rw [hmem, push_lt ht] at hm; exact hm
        · rw [hmem] at hm; exact hm
      refine ⟨g0, g1.trans ?_, fun t ht hn => ?_⟩
      · rcases hcase with ⟨-, -, hprom⟩ | ⟨-, -, hprom, -⟩
        · show th.promises.Sublist s.promises; rw [hprom]; exact List.Sublist.refl _
        · show th.promises.Sublist s.promises; rw [hprom]; exact List.erase_sublist ..
      · by_cases h1 : t ∈ th.promises
        · obtain ⟨m, j, w', hm, hj, hw, hl, hv, hr, hx⟩ := g2 t h1 hn
          refine ⟨m, j + 1, w', hold t m (hpl t ht) hm, by rw [nWords_one]; omega, by simpa using hw,
            by rw [hl, show i + 1 + j = i + (j + 1) by omega], hv, Nat.le_trans (Nat.le_of_eq hrs.symm) hr, hx⟩
        · rcases hcase with ⟨-, -, hprom⟩ | ⟨hmem, htp, hprom, hlt, m, hm, hma, hmv, hmv'⟩
          · exact absurd (by rw [hprom]; exact ht) h1
          · have e : t = t0 := Classical.byContradiction fun hne =>
              h1 (by rw [hprom]; exact (List.mem_erase_of_ne hne).2 ht)
            subst e
            refine ⟨m, 0, w, hm, by rw [nWords_one]; omega, rfl, by rw [hma]; rfl, by rw [hmv, ev],
              Nat.le_trans hmr hmv', fun x g hx => Nat.le_trans (hmw x g hx) hmv'⟩
  | .two :: us, w0 :: w1 :: ws, i, s, s', hpl, hs => by
      simp only [storeUnits] at hs
      obtain ⟨q1, _, _, q4, q5⟩ := stepStorePair_eq s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel
      generalize Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel = R at q1 q4 q5 hs
      obtain ⟨mem', pairs', th⟩ := R
      simp only at q1 q4 q5 hs
      have hpl1 : PromLt { s with mem := mem', pairs := pairs', vs := th.vs, promises := th.promises } := by
        intro t ht
        have ht' : t ∈ s.promises := by have : t ∈ th.promises := ht; rw [q4] at this; exact this
        show t < mem'.size
        rw [q1, Array.size_push, Array.size_push]; exact Nat.lt_succ_of_lt (Nat.lt_succ_of_lt (hpl t ht'))
      obtain ⟨g0, g1, g2⟩ := storeUnits_promF us ws (i + 2) _ s' hpl1 hs
      refine ⟨g0, g1.trans (show th.promises.Sublist s.promises by rw [q4]; exact List.Sublist.refl _),
        fun t ht hn => ?_⟩
      obtain ⟨m, j, w', hm, hj, hw, hl, hv, hr, hx⟩ := g2 t (by show t ∈ th.promises; rw [q4]; exact ht) hn
      have hlt := hpl t ht
      refine ⟨m, j + 2, w', ?_, by rw [nWords_two]; omega, by simpa using hw,
        by rw [hl, show i + 2 + j = i + (j + 2) by omega], hv, Nat.le_trans (Nat.le_of_eq q5.symm) hr, hx⟩
      have : mem'[t]? = some m := hm
      rw [q1, push2_lt hlt] at this; exact this
  | .one :: _, [], _, _, _, _, hs => by simp [storeUnits] at hs
  | .two :: _, [], _, _, _, _, hs => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, _, _, hs => by simp [storeUnits] at hs

/-- (S4) **A store's words, as their owner sees it, own promises skipped**: each
stored word whose address had only promises past coherence becomes its
address's latest; every other address keeps its latest. -/
theorem storeUnits_latP {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s : St) (V : Ts), PromLt s → s.promises.Nodup →
      V ≤ s.vs.vRelSt → ∀ s', s' ∈ storeUnits k arch pw a rel us ws i s →
        ((∀ j : Nat, j < nWords us → TailP s (offs a (i + j))) →
          ∀ (j : Nat) w, j < nWords us → ws[j]? = some w →
            LatestP s'.mem s'.promises s'.vs.coh (offs a (i + j)) (bumpW V w)) ∧
        (∀ (b : Address) (v : Word), (∀ j : Nat, j < nWords us → b ≠ offs a (i + j)) →
          LatestP s.mem s.promises s.vs.coh b v → LatestP s'.mem s'.promises s'.vs.coh b v)
  | [], _, _, s, _, _, _, _, s', hs => by
      simp only [storeUnits, List.mem_singleton] at hs; subst hs
      exact ⟨fun _ j _ hj => absurd hj (by simp [nWords]), fun _ _ _ h => h⟩
  | .one :: us, w :: ws, i, s, V, hpl, hnd, hV, s', hs => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      obtain ⟨t0, hcase, hcoh, hrs, -⟩ := stepStore_casesC hst
      have hmw : ∀ x g, (bumpW V w).val = .loc x g →
          (bumpW V w).view ≤ Promises.storeMview (mth s pw w w) (dataE 1 w) [0] rel := fun x g hx =>
        Nat.max_le.2 ⟨storeMview_dataE _ 1 w (by simp [mth, regsOf]) [0] rel x g hx,
          Nat.le_trans hV (storeMview_relSt (mth s pw w w) _ [0] rel)⟩
      have ev : exprVal (mth s pw w w) (dataE 1 w) = w.val := exprVal_dataE _ 1 w (by simp [mth, regsOf])
      let s1 : St := { s with mem := mem', vs := th.vs, promises := th.promises }
      have hc1 : ∀ b, b ≠ offs a i → s1.vs.coh b = s.vs.coh b := fun b hb => by
        show th.vs.coh b = s.vs.coh b; rw [hcoh]; simp [hb, mth]
      have hc0 : s1.vs.coh (offs a i) = t0 := by show th.vs.coh (offs a i) = t0; rw [hcoh]; simp
      have hpl1 : PromLt s1 := by
        rcases hcase with ⟨hmem, -, hprom⟩ | ⟨hmem, -, hprom, -⟩
        · intro t ht
          have ht' : t ∈ s.promises := by have : t ∈ th.promises := ht; rw [hprom] at this; exact this
          show t < mem'.size
          rw [hmem, Array.size_push]; exact Nat.lt_succ_of_lt (hpl t ht')
        · intro t ht
          have ht' : t ∈ s.promises := by
            have : t ∈ th.promises := ht; rw [hprom] at this; exact List.mem_of_mem_erase this
          show t < mem'.size
          rw [hmem]; exact hpl t ht'
      have hnd1 : s1.promises.Nodup := by
        rcases hcase with ⟨-, -, hprom⟩ | ⟨-, -, hprom, -⟩
        · show th.promises.Nodup; rw [hprom]; exact hnd
        · show th.promises.Nodup; rw [hprom]; exact hnd.erase _
      obtain ⟨g2, g3⟩ := storeUnits_latP us ws (i + 1) s1 V hpl1 hnd1
        (by show V ≤ th.vs.vRelSt; rw [hrs]; exact hV) s' hs
      -- one unit: the stored word, the other addresses, their tails
      have hl1 : TailP s (offs a i) → LatestP s1.mem s1.promises s1.vs.coh (offs a i) (bumpW V w) := by
        intro htl
        rcases hcase with ⟨hmem, rfl, hprom⟩ | ⟨hmem, htp, hprom, hlt, m, hm, hma, hmv, hmv'⟩
        · rw [ev] at hmem
          show LatestP mem' th.promises th.vs.coh (offs a i) (bumpW V w)
          rw [hmem, hprom]
          exact LatestP_push_top (v := bumpW V w) (by rw [hcoh]; simp) hpl hmw
        · show LatestP mem' th.promises th.vs.coh (offs a i) (bumpW V w)
          rw [hmem, hprom]
          refine ⟨⟨m, by rw [hcoh]; simpa using hm, hma, by rw [hmv, ev]; rfl,
            fun x g hx => Nat.le_trans (hmw x g hx) hmv'⟩, fun h => hnd.not_mem_erase (by rw [hcoh] at h; simpa [mth] using h),
            fun t m' ht hm' hl' => ?_⟩
          have ht' : t0 < t := by rw [hcoh] at ht; simpa using ht
          exact (List.mem_erase_of_ne (Nat.ne_of_gt ht')).2 (htl t m' (Nat.lt_trans hlt ht') hm' hl')
      have hO : ∀ (b : Address) (v : Word), b ≠ offs a i → LatestP s.mem s.promises s.vs.coh b v →
          LatestP s1.mem s1.promises s1.vs.coh b v := by
        intro b v hb hl
        rcases hcase with ⟨hmem, -, hprom⟩ | ⟨hmem, -, hprom, -, m, hm, hma, -⟩
        · show LatestP mem' th.promises th.vs.coh b v
          rw [hmem, hprom]
          exact LatestS_push_other hl hb (hc1 b hb)
        · show LatestP mem' th.promises th.vs.coh b v
          rw [hmem, hprom]
          exact LatestP_erase_other hl hm hma hb (hc1 b hb)
      have hT : ∀ b, b ≠ offs a i → TailP s b → TailP s1 b := by
        intro b hb htl
        rcases hcase with ⟨hmem, -, hprom⟩ | ⟨hmem, -, hprom, -, m, hm, hma, -⟩
        · exact TailP_push_other htl hb hmem (hc1 b hb) hprom
        · exact TailP_erase_other htl hm hma hb hmem (hc1 b hb) hprom
      refine ⟨fun htl j w' hj hw => ?_, fun b v hb hl => ?_⟩
      · cases j with
        | zero =>
            simp only [List.getElem?_cons_zero, Option.some.injEq] at hw; subst hw
            have := g3 _ _ (fun j _ => offs_ne a (by omega)) (hl1 (by simpa using htl 0 (by rw [nWords_one]; omega)))
            simpa using this
        | succ j =>
            have := g2 (fun j' hj' => by
                have e := hT _ (offs_ne a (by omega)) (htl (j' + 1) (by rw [nWords_one]; omega))
                rw [show i + (j' + 1) = i + 1 + j' by omega] at e; exact e)
              j w' (by rw [nWords_one] at hj; omega) (by simpa using hw)
            rw [show i + 1 + j = i + (j + 1) by omega] at this; exact this
      · have hb0 : b ≠ offs a i := by have := hb 0 (by rw [nWords_one]; omega); simpa using this
        exact g3 b v (fun j hj => by
          have := hb (j + 1) (by rw [nWords_one]; omega)
          rw [show i + (j + 1) = i + 1 + j by omega] at this; exact this) (hO b v hb0 hl)
  | .two :: us, w0 :: w1 :: ws, i, s, V, hpl, hnd, hV, s', hs => by
      simp only [storeUnits] at hs
      obtain ⟨q1, _, q3, q4, q5⟩ := stepStorePair_eq s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel
      have hV0 : V ≤ max (Promises.storeMview (mth s pw w0 w1) (dataE 1 w0) [0] rel)
          (Promises.storeMview (mth s pw w0 w1) (dataE 2 w1) [0] rel) :=
        Nat.le_trans hV (Nat.le_trans (storeMview_relSt (mth s pw w0 w1) _ [0] rel) (Nat.le_max_left _ _))
      have e0 : exprVal (mth s pw w0 w1) (dataE 1 w0) = w0.val :=
        exprVal_dataE _ 1 w0 (by simp [mth, regsOf])
      have e1 : exprVal (mth s pw w0 w1) (dataE 2 w1) = w1.val :=
        exprVal_dataE _ 2 w1 (by simp [mth, regsOf])
      rw [e0, e1] at q1
      generalize Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel = R at q1 q3 q4 q5 hs
      obtain ⟨mem', pairs', th⟩ := R
      simp only at q1 q3 q4 q5 hs
      let s1 : St := { s with mem := mem', pairs := pairs', vs := th.vs, promises := th.promises }
      have a01 : offs a i ≠ offs a (i + 1) := offs_ne a (by omega)
      have hp1 : s1.promises = s.promises := q4
      have hpl1 : PromLt s1 := by
        intro t ht
        rw [hp1] at ht
        show t < mem'.size
        rw [q1, Array.size_push, Array.size_push]; exact Nat.lt_succ_of_lt (Nat.lt_succ_of_lt (hpl t ht))
      obtain ⟨g2, g3⟩ := storeUnits_latP us ws (i + 2) s1 V hpl1 (by rw [hp1]; exact hnd)
        (by show V ≤ th.vs.vRelSt; rw [q5]; exact hV) s' hs
      have hc : s1.vs.coh = fun b => if b = offs a i then s.mem.size
          else if b = offs a (i + 1) then s.mem.size + 1 else s.vs.coh b := by
        show th.vs.coh = _; rw [q3, offs_next]; rfl
      have hM : s1.mem = (s.mem.push ⟨offs a i, w0.val,
          max (Promises.storeMview (mth s pw w0 w1) (dataE 1 w0) [0] rel)
            (Promises.storeMview (mth s pw w0 w1) (dataE 2 w1) [0] rel)⟩).push ⟨offs a (i + 1), w1.val,
          max (Promises.storeMview (mth s pw w0 w1) (dataE 1 w0) [0] rel)
            (Promises.storeMview (mth s pw w0 w1) (dataE 2 w1) [0] rel)⟩ := by
        show mem' = _; rw [q1, offs_next]
      have hl0 : LatestP s1.mem s1.promises s1.vs.coh (offs a i) (bumpW V w0) := by
        rw [hM, hp1]
        exact LatestS_push_other (LatestP_push_top (v := bumpW V w0) (by rw [hc]; simp) hpl fun x g hx =>
          Nat.max_le.2 ⟨Nat.le_trans (storeMview_dataE _ 1 w0 (by simp [mth, regsOf]) [0] rel x g hx)
            (Nat.le_max_left _ _), hV0⟩) a01 rfl
      have hl1 : LatestP s1.mem s1.promises s1.vs.coh (offs a (i + 1)) (bumpW V w1) := by
        rw [hM, hp1]
        exact LatestP_push_top (v := bumpW V w1) (by rw [hc]; simp [Ne.symm a01])
          (fun t ht => by rw [Array.size_push]; exact Nat.lt_succ_of_lt (hpl t ht)) fun x g hx =>
          Nat.max_le.2 ⟨Nat.le_trans (storeMview_dataE _ 2 w1 (by simp [mth, regsOf]) [0] rel x g hx)
            (Nat.le_max_right _ _), hV0⟩
      have hT : ∀ b, b ≠ offs a i → b ≠ offs a (i + 1) → TailP s b → TailP s1 b := by
        intro b hb0 hb1 htl t m ht hm hl
        rw [hp1]
        rw [hM, Array.getElem?_push] at hm
        have hcb : s1.vs.coh b = s.vs.coh b := by rw [hc]; simp [hb0, hb1]
        rw [hcb] at ht
        split at hm
        · simp only [Option.some.injEq] at hm; subst hm; exact absurd hl (Ne.symm hb1)
        · rw [Array.getElem?_push] at hm
          split at hm
          · simp only [Option.some.injEq] at hm; subst hm; exact absurd hl (Ne.symm hb0)
          · exact htl t m ht hm hl
      refine ⟨fun htl j w' hj hw => ?_, fun b v hb hl => ?_⟩
      · match j, hj, hw with
        | 0, _, hw =>
            simp only [List.getElem?_cons_zero, Option.some.injEq] at hw; subst hw
            simpa using g3 _ _ (fun j _ => offs_ne a (by omega)) hl0
        | 1, _, hw =>
            simp only [List.getElem?_cons_succ, List.getElem?_cons_zero, Option.some.injEq] at hw; subst hw
            exact g3 _ _ (fun j _ => offs_ne a (by omega)) hl1
        | j + 2, hj, hw =>
            have := g2 (fun j' hj' => by
                have e := hT _ (offs_ne a (by omega)) (offs_ne a (by omega)) (htl (j' + 2) (by rw [nWords_two]; omega))
                rw [show i + (j' + 2) = i + 2 + j' by omega] at e; exact e)
              j w' (by rw [nWords_two] at hj; omega) (by simpa using hw)
            rw [show i + 2 + j = i + (j + 2) by omega] at this; exact this
      · have hb0 : b ≠ offs a i := by have := hb 0 (by rw [nWords_two]; omega); simpa using this
        have hb1 : b ≠ offs a (i + 1) := hb 1 (by rw [nWords_two]; omega)
        have hl' : LatestP s1.mem s1.promises s1.vs.coh b v := by
          rw [hM, hp1]
          exact LatestS_push_other (LatestS_push_other (coh' := s1.vs.coh) hl hb0 (by rw [hc]; simp [hb0, hb1])) hb1
            rfl
        exact g3 b v (fun j hj => by
          have := hb (j + 2) (by rw [nWords_two]; omega)
          rw [show i + (j + 2) = i + 2 + j by omega] at this; exact this) hl'
  | .one :: _, [], _, _, _, _, _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [], _, _, _, _, _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, _, _, _, _, s', hs => by simp [storeUnits] at hs

/-- (S4) A promise at or below coherence at its address (one a load has read)
stays an outstanding promise at or below coherence across a store. -/
theorem storeUnits_lowP {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s s' : St), s' ∈ storeUnits k arch pw a rel us ws i s →
      ∀ (t : Ts) (m : Msg), t ∈ s.promises → s.mem[t]? = some m → t ≤ s.vs.coh m.loc →
        t ∈ s'.promises ∧ s'.mem[t]? = some m ∧ t ≤ s'.vs.coh m.loc
  | [], _, _, s, s', hs => by
      simp only [storeUnits, List.mem_singleton] at hs; subst hs
      exact fun _ _ h1 h2 h3 => ⟨h1, h2, h3⟩
  | .one :: us, w :: ws, i, s, s', hs => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      obtain ⟨t0, hcase, hcoh, -, -⟩ := stepStore_casesC hst
      intro t m ht hm hle
      have htl := lt_of_get hm
      apply storeUnits_lowP us ws (i + 1) _ s' hs t m
      · rcases hcase with ⟨-, -, hprom⟩ | ⟨-, -, hprom, hlt, m0, hm0, hma, -⟩
        · show t ∈ th.promises; rw [hprom]; exact ht
        · show t ∈ th.promises; rw [hprom]
          refine (List.mem_erase_of_ne fun e => ?_).2 ht
          subst e; rw [hm0] at hm; cases hm; rw [hma] at hle
          exact absurd hlt (Nat.not_lt.2 hle)
      · rcases hcase with ⟨hmem, -⟩ | ⟨hmem, -⟩
        · show mem'[t]? = some m; rw [hmem, push_lt htl]; exact hm
        · show mem'[t]? = some m; rw [hmem]; exact hm
      · show t ≤ th.vs.coh m.loc
        rw [hcoh]
        by_cases hb : m.loc = offs a i
        · simp only [hb, ↓reduceIte]
          rcases hcase with ⟨-, rfl, -⟩ | ⟨-, -, -, hlt, -⟩
          · exact Nat.le_of_lt htl
          · rw [hb] at hle; exact Nat.le_trans hle (Nat.le_of_lt hlt)
        · simp only [hb, ↓reduceIte]; exact hle
  | .two :: us, w0 :: w1 :: ws, i, s, s', hs => by
      simp only [storeUnits] at hs
      obtain ⟨q1, _, q3, q4, _⟩ := stepStorePair_eq s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel
      generalize Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel = R at q1 q3 q4 hs
      obtain ⟨mem', pairs', th⟩ := R
      simp only at q1 q3 q4 hs
      intro t m ht hm hle
      have htl := lt_of_get hm
      apply storeUnits_lowP us ws (i + 2) _ s' hs t m
      · show t ∈ th.promises; rw [q4]; exact ht
      · show mem'[t]? = some m; rw [q1, push2_lt htl]; exact hm
      · show t ≤ th.vs.coh m.loc
        rw [q3]
        dsimp only
        split
        · exact Nat.le_of_lt htl
        · split
          · exact Nat.le_succ_of_le (Nat.le_of_lt htl)
          · exact hle
  | .one :: _, [], _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [], _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, s', hs => by simp [storeUnits] at hs

/-- (S4) Every own promise is above coherence before a store if it is after. -/
theorem storeUnits_promAbove {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool}
    {us : List Acc} {ws : List Word} {i : Nat} {s s' : St} (hs : s' ∈ storeUnits k arch pw a rel us ws i s)
    (h : PromAbove s') : PromAbove s := fun t ht m hm =>
  Nat.not_le.1 fun hle => by
    obtain ⟨a1, a2, a3⟩ := storeUnits_lowP us ws i s s' hs t m ht hm hle
    exact PromAbove_low h a1 a2 a3

/-- (S4) **A store writes every word** at a timestamp past the old memory or
past coherence at that word, covered by the new `vWr`. -/
theorem storeUnits_wrP {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s s' : St), s' ∈ storeUnits k arch pw a rel us ws i s →
      ∀ j, j < nWords us → ∃ (t : Nat) (m : Msg), (s.mem.size ≤ t ∨ s.vs.coh (offs a (i + j)) < t) ∧
        t ≤ s'.vs.vWr ∧ s'.mem[t]? = some m ∧ m.loc = offs a (i + j)
  | [], _, _, s, s', hs => by
      simp only [storeUnits, List.mem_singleton] at hs; subst hs
      exact fun j hj => absurd hj (by simp [nWords])
  | .one :: us, w :: ws, i, s, s', hs => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      obtain ⟨t0, hcase, hcoh, -, hwr⟩ := stepStore_casesC hst
      have g1 := storeUnits_wrF us ws (i + 1) _ s' hs
      obtain ⟨gg, -, -⟩ := storeUnits_growsF us ws (i + 1) _ s' hs
      have hsz : s.mem.size ≤ mem'.size := by
        rcases hcase with ⟨hmem, -⟩ | ⟨hmem, -⟩
        · rw [hmem, Array.size_push]; omega
        · rw [hmem]; exact Nat.le_refl _
      intro j hj
      rcases j with _ | j
      · have hw0 : t0 ≤ s'.vs.vWr := Nat.le_trans (by show t0 ≤ th.vs.vWr; rw [hwr]; exact Nat.le_max_right _ _) g1
        rcases hcase with ⟨hmem, rfl, -⟩ | ⟨hmem, -, -, hlt, m, hm, hma, -⟩
        · have e3 : s'.mem[s.mem.size]? = mem'[s.mem.size]? :=
            gg.2.1 _ (by show s.mem.size < mem'.size; rw [hmem, Array.size_push]; omega)
          rw [hmem, Array.getElem?_push_size] at e3
          exact ⟨_, _, Or.inl (Nat.le_refl _), hw0, e3, by simp [offs]⟩
        · have e3 : s'.mem[t0]? = mem'[t0]? := gg.2.1 _ (by show t0 < mem'.size; rw [hmem]; exact lt_of_get hm)
          rw [hmem, hm] at e3
          exact ⟨_, _, Or.inr (by simpa [mth] using hlt), hw0, e3, by rw [hma]; rfl⟩
      · obtain ⟨t, m, h1, h2, h3, h4⟩ := storeUnits_wrP us ws (i + 1) _ s' hs j (by rw [nWords_one] at hj; omega)
        have hne : offs a (i + 1 + j) ≠ offs a i := offs_ne a (by omega)
        refine ⟨t, m, ?_, h2, h3, by rw [h4, show i + 1 + j = i + (j + 1) by omega]⟩
        rcases h1 with h1 | h1
        · exact Or.inl (Nat.le_trans hsz h1)
        · right
          have e : th.vs.coh (offs a (i + 1 + j)) = s.vs.coh (offs a (i + 1 + j)) := by
            rw [hcoh]; simp [hne, mth]
          rw [show i + (j + 1) = i + 1 + j by omega, ← e]; exact h1
  | .two :: us, w0 :: w1 :: ws, i, s, s', hs => by
      simp only [storeUnits] at hs
      obtain ⟨q1, _, q3, _, _⟩ := stepStorePair_eq s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel
      have q6 := stepStorePair_vWr s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel
      generalize Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel = R at q1 q3 q6 hs
      obtain ⟨mem', pairs', th⟩ := R
      simp only at q1 q3 q6 hs
      have g1 := storeUnits_wrF us ws (i + 2) _ s' hs
      obtain ⟨gg, -, -⟩ := storeUnits_growsF us ws (i + 2) _ s' hs
      have hw1 : s.mem.size + 1 ≤ s'.vs.vWr :=
        Nat.le_trans (by show s.mem.size + 1 ≤ th.vs.vWr; rw [q6]; exact Nat.le_max_right _ _) g1
      have hsz : mem'.size = s.mem.size + 2 := by rw [q1]; simp
      intro j hj
      rcases j with _ | _ | j
      · have e3 : s'.mem[s.mem.size]? = mem'[s.mem.size]? :=
          gg.2.1 _ (by show s.mem.size < mem'.size; omega)
        rw [q1] at e3
        simp only [Array.getElem?_push, Array.size_push] at e3
        simp only [show ¬ (s.mem.size = s.mem.size + 1) by omega, ite_false, ite_true] at e3
        exact ⟨_, _, Or.inl (Nat.le_refl _), Nat.le_trans (Nat.le_succ _) hw1, e3, by simp [offs]⟩
      · have e3 : s'.mem[s.mem.size + 1]? = mem'[s.mem.size + 1]? :=
          gg.2.1 _ (by show s.mem.size + 1 < mem'.size; omega)
        rw [q1] at e3
        simp only [Array.getElem?_push, Array.size_push, ite_true] at e3
        exact ⟨_, _, Or.inl (Nat.le_succ _), hw1, e3, by simp [offs, WeakMem.Address.next, Nat.add_assoc]⟩
      · obtain ⟨t, m, h1, h2, h3, h4⟩ := storeUnits_wrP us ws (i + 2) _ s' hs j (by rw [nWords_two] at hj; omega)
        have hne0 : offs a (i + 2 + j) ≠ offs a i := offs_ne a (by omega)
        have hne1 : offs a (i + 2 + j) ≠ (offs a i).next := by rw [offs_next]; exact offs_ne a (by omega)
        refine ⟨t, m, ?_, h2, h3, by rw [h4, show i + 2 + j = i + (j + 1 + 1) by omega]⟩
        rcases h1 with h1 | h1
        · exact Or.inl (by have : mem'.size ≤ t := h1; omega)
        · right
          have e : th.vs.coh (offs a (i + 2 + j)) = s.vs.coh (offs a (i + 2 + j)) := by
            rw [q3]; simp [hne0, hne1, mth]
          rw [show i + (j + 1 + 1) = i + 2 + j by omega, ← e]; exact h1
  | .one :: _, [], _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [], _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, s', hs => by simp [storeUnits] at hs


theorem MemOKP_push {η : TEnv} {mem : Memory} {pairs P : List Ts} (h : MemOKP η mem pairs P) (m : Msg)
    (hm : ∀ c, η.sto m.loc.label = some c → m.val = .undef ∨ WordOK η c.ty m.loc.offset (mw m)) :
    MemOKP η (mem.push m) pairs P := by
  obtain ⟨h1, h2, h3⟩ := h
  refine ⟨fun t m' c hP ht hc => ?_, fun t m0 m1 c hp h0 h1' hc => ?_, fun t hp => ?_⟩
  · rw [Array.getElem?_push] at ht
    split at ht
    · simp only [Option.some.injEq] at ht; subst ht; exact hm c hc
    · exact h1 t m' c hP ht hc
  · have hl := h3 t hp
    rw [push_lt (Nat.lt_of_succ_lt hl)] at h0
    rw [push_lt hl] at h1'
    exact h2 t m0 m1 c hp h0 h1' hc
  · simp only [Array.size_push]; exact Nat.lt_succ_of_lt (h3 t hp)

theorem MemOKP_pushPair {η : TEnv} {mem : Memory} {pairs P : List Ts} (h : MemOKP η mem pairs P)
    (a : Address) (v0 v1 : WeakMem.Val) (mv : Ts)
    (hok : ∀ c, η.sto a.label = some c → PairOK η c.ty a.offset ⟨v0, mv, 0⟩ ⟨v1, mv, 0⟩) :
    MemOKP η ((mem.push ⟨a, v0, mv⟩).push ⟨a.next, v1, mv⟩) (pairs ++ [mem.size]) P := by
  have hA := MemOKP_push (MemOKP_push h ⟨a, v0, mv⟩ fun c hc => by
      obtain ⟨b, S, vs, o', x0, _, hs, hv, h0, _, l0, _, he⟩ := hok c hc
      exact Or.inr ⟨b, S, vs, o', x0, hs, hv, h0, l0, he⟩)
    ⟨a.next, v1, mv⟩ fun c hc => by
      obtain ⟨b, S, vs, o', _, x1, hs, hv, _, h1, _, l1, he⟩ := hok c hc
      exact Or.inr ⟨b, S, vs, o' + 1, x1, hs, hv, h1, l1,
        by show b + (o' + 1) = a.offset + 1; rw [← he]; rfl⟩
  obtain ⟨f1, f2, f3⟩ := hA
  refine ⟨f1, fun t n0 n1 c hp hn0 hn1 hc => ?_, fun t hp => ?_⟩
  · rcases List.mem_append.1 hp with hp | hp
    · exact f2 t n0 n1 c hp hn0 hn1 hc
    · simp only [List.mem_singleton] at hp
      subst hp
      rw [push_lt (by simp), Array.getElem?_push_size] at hn0
      rw [show mem.size + 1 = (mem.push ⟨a, v0, mv⟩).size from (Array.size_push _).symm,
        Array.getElem?_push_size] at hn1
      simp only [Option.some.injEq] at hn0 hn1
      subst hn0 hn1
      exact hok c hc
  · rcases List.mem_append.1 hp with hp | hp
    · exact f3 t hp
    · simp only [List.mem_singleton] at hp; subst hp; simp

/-- (S4) **Storing a slice of one value, own promises skipped**: every stored
word is that value's word at its offset, whether appended or fulfilling a
promise (which then stops being skipped). -/
theorem storeUnits_memOKP {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool}
    {η : TEnv} {c : Cell} {b o0 : Nat} {S : Ty} {vals : List Word} {V : Ts} (hc : η.sto a.label = some c)
    (hseg : SegOf c.ty b S) (hbo : a.offset = b + o0) (hv : ValOfS η S vals) :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s : St),
      (∀ (j : Nat) w, ws[j]? = some w → ∃ w0, vals[o0 + i + j]? = some w0 ∧ WLe1 w0 (bumpW V w)) →
      V ≤ s.vs.vRelSt →
      MemOKP η s.mem s.pairs s.promises → ∀ s', s' ∈ storeUnits k arch pw a rel us ws i s →
        MemOKP η s'.mem s'.pairs s'.promises
  | [], _, _, s, _, _, hm, s', hs => by
      simp only [storeUnits, List.mem_singleton] at hs; subst hs; exact hm
  | .one :: us, w :: ws, i, s, hw, hV, hm, s', hs => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      obtain ⟨t, hcase, _, hrs, -⟩ := stepStore_casesC hst
      obtain ⟨w0, hw0, hle⟩ := hw 0 w rfl
      have ev : exprVal (mth s pw w w) (dataE 1 w) = w.val := exprVal_dataE _ 1 w (by simp [mth, regsOf])
      have hwk : ∀ mv, (∀ x g, w.val = .loc x g → w.view ≤ mv) → V ≤ mv →
          WordOK η c.ty (offs a i).offset ⟨w.val, mv, 0⟩ := fun mv h1 h2 =>
        ⟨b, S, vals, o0 + i, w0, hseg, hv, by simpa using hw0, WLe1_msgB hle h1 h2,
          by simp only [offs]; rw [hbo, Nat.add_assoc]⟩
      have hmw := storeMview_dataE (mth s pw w w) 1 w (by simp [mth, regsOf]) [0] rel
      have hmr := Nat.le_trans hV (storeMview_relSt (mth s pw w w) (dataE 1 w) [0] rel)
      have hm' : MemOKP η mem' s.pairs th.promises := by
        rcases hcase with ⟨rfl, _, hprom⟩ | ⟨rfl, _, hprom, _, m, hmt, hma, hmv, hmv'⟩
        · rw [hprom]
          refine MemOKP_push hm _ fun c' hc' => Or.inr ?_
          simp only [offs] at hc' ⊢
          rw [hc] at hc'; cases hc'
          show WordOK η c.ty (offs a i).offset ⟨exprVal _ (dataE 1 w), Promises.storeMview _ (dataE 1 w) [0] rel, 0⟩
          rw [ev]; exact hwk _ hmw hmr
        · rw [hprom]
          obtain ⟨h1, h2, h3⟩ := hm
          refine ⟨fun t' m' c' hP ht hc' => ?_, h2, h3⟩
          by_cases e : t' = t
          · subst e
            rw [hmt] at ht; cases ht
            right
            have hc2 : η.sto a.label = some c' := by rw [hma] at hc'; exact hc'
            rw [hc] at hc2; cases hc2
            show WordOK η c.ty m.loc.offset ⟨m.val, m.view, 0⟩
            rw [hma, hmv, ev]
            exact hwk _ (fun x g hx => Nat.le_trans (hmw x g hx) hmv') (Nat.le_trans hmr hmv')
          · exact h1 t' m' c' (fun h => hP ((List.mem_erase_of_ne e).2 h)) ht hc'
      exact storeUnits_memOKP hc hseg hbo hv us ws (i + 1) _
        (fun j w' hj => by
          have := hw (j + 1) w' (by simpa using hj)
          rw [add_shift1]; exact this)
        (by show V ≤ th.vs.vRelSt; rw [hrs]; exact hV)
        hm' s' hs
  | .two :: us, w0 :: w1 :: ws, i, s, hw, hV, hm, s', hs => by
      simp only [storeUnits] at hs
      obtain ⟨x0, h0, l0⟩ := hw 0 w0 rfl
      obtain ⟨x1, h1, l1⟩ := hw 1 w1 rfl
      simp only [Nat.add_zero] at h0
      have e0 : exprVal (mth s pw w0 w1) (dataE 1 w0) = w0.val :=
        exprVal_dataE _ 1 w0 (by simp [mth, regsOf])
      have e1 : exprVal (mth s pw w0 w1) (dataE 2 w1) = w1.val :=
        exprVal_dataE _ 2 w1 (by simp [mth, regsOf])
      obtain ⟨q1, q2, -, q4, q5⟩ := stepStorePair_eq s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel
      refine storeUnits_memOKP hc hseg hbo hv us ws (i + 2) _
        (fun j w' hj => by
          have := hw (j + 2) w' (by simpa using hj)
          rw [add_shift2]; exact this)
        (by rw [q5]; exact hV) ?_ s' hs
      show MemOKP η (Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel).1
        (Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel).2.1
        (Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel).2.2.promises
      rw [q1, q2, q4, e0, e1]
      refine MemOKP_pushPair hm (offs a i) w0.val w1.val _ fun c' hc' => ?_
      simp only [offs] at hc' ⊢
      rw [hc] at hc'; cases hc'
      have hV0 : V ≤ max (Promises.storeMview (mth s pw w0 w1) (dataE 1 w0) [0] rel)
          (Promises.storeMview (mth s pw w0 w1) (dataE 2 w1) [0] rel) :=
        Nat.le_trans hV (Nat.le_trans (storeMview_relSt (mth s pw w0 w1) _ [0] rel) (Nat.le_max_left _ _))
      refine ⟨b, S, vals, o0 + i, x0, x1, hseg, hv, h0, h1, WLe1_msgB l0 (fun x g hx => ?_) hV0,
        WLe1_msgB l1 (fun x g hx => ?_) hV0, by rw [hbo, Nat.add_assoc]⟩
      · exact Nat.le_trans (storeMview_dataE _ 1 w0 (by simp [mth, regsOf]) [0] rel x g hx) (Nat.le_max_left _ _)
      · exact Nat.le_trans (storeMview_dataE _ 2 w1 (by simp [mth, regsOf]) [0] rel x g hx) (Nat.le_max_right _ _)
  | .one :: _, [], _, _, _, _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [], _, _, _, _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, _, _, _, s', hs => by simp [storeUnits] at hs

/-- (S4) **Every promise a store discharges is a word of the stored value**, at
the store's cell. -/
theorem storeUnits_fulOK {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool}
    {η : TEnv} {c : Cell} {b o0 : Nat} {S : Ty} {vals : List Word} {V : Ts}
    (hseg : SegOf c.ty b S) (hbo : a.offset = b + o0) (hv : ValOfS η S vals) {us : List Acc} {ws : List Word}
    {s s' : St} (hw : ∀ (j : Nat) w, ws[j]? = some w → ∃ w0, vals[o0 + j]? = some w0 ∧ WLe1 w0 (bumpW V w))
    (hV : V ≤ s.vs.vRelSt) (hpl : PromLt s) (hs : s' ∈ storeUnits k arch pw a rel us ws 0 s) :
    ∀ t, t ∈ s.promises → t ∉ s'.promises → ∃ m, s.mem[t]? = some m ∧ m.loc.label = a.label ∧
      WordOK η c.ty m.loc.offset (mw m) := by
  intro t ht hn
  obtain ⟨-, -, g⟩ := storeUnits_promF us ws 0 s s' hpl hs
  obtain ⟨m, j, w, hm, -, hwj, hl, hmv, hr, hx⟩ := g t ht hn
  obtain ⟨w0, hw0, hle⟩ := hw j w hwj
  refine ⟨m, hm, by rw [hl]; rfl, ?_⟩
  show WordOK η c.ty m.loc.offset ⟨m.val, m.view, 0⟩
  rw [hmv, hl]
  exact ⟨b, S, vals, o0 + j, w0, hseg, hv, hw0, WLe1_msgB hle hx (Nat.le_trans hV hr),
    by simp only [offs]; rw [hbo, Nat.zero_add, Nat.add_assoc]⟩

/-- (S4) `HiddenP` survives growth of the environment, the bound and memory,
and the discharge of promises, when every message appended or discharged at
`⟨l, o⟩` is a word of a value. -/
theorem HiddenP_grow {η η' : TEnv} {T : Ty} {mem mem' : Memory} {P P' : List Ts} {l : AllocLabel} {o : Nat}
    {V V' : Ts} (h : HiddenP η T mem P l o V) (hw : ∀ w, WordOK η T o w → WordOK η' T o w) (hV : V ≤ V')
    (hold : ∀ t, t < mem.size → mem'[t]? = mem[t]?)
    (hnew : ∀ (t : Nat) (m : Msg), mem.size ≤ t → mem'[t]? = some m → m.loc = ⟨l, o⟩ → WordOK η' T o (mw m))
    (hful : ∀ (t : Nat) (m : Msg), t ∈ P → t ∉ P' → mem[t]? = some m → m.loc = ⟨l, o⟩ → WordOK η' T o (mw m)) :
    HiddenP η' T mem' P' l o V' := by
  intro t m hP ht hl hn
  by_cases hlt : t < mem.size
  · rw [hold t hlt] at ht
    by_cases hp : t ∈ P
    · exact absurd (hful t m hp hP ht hl) hn
    · obtain ⟨t', m', h1, h2, h3, h4⟩ := h t m hp ht hl (fun hw' => hn (hw _ hw'))
      exact ⟨t', m', h1, Nat.le_trans h2 hV, by rw [hold t' (lt_of_get h3)]; exact h3, h4⟩
  · exact absurd (hnew t m (by omega) ht hl) hn

/-! ### (S4) Loads, own promises skipped -/

/-- (S4) **Readable at a latest address, promises skipped**: the latest
message, or a skipped one past coherence. -/
theorem readable_latestS {mem : Memory} {S : Ts → Prop} {coh : Address → Ts} {a : Address} {v : Word}
    {t bound : Ts} (hl : LatestS mem S coh a v) (hb : coh a ≤ bound)
    (hr : WeakMem.readable mem a t bound = true) :
    t = coh a ∨ (coh a < t ∧ S t ∧ ∃ m, mem[t]? = some m ∧ m.loc = a) := by
  obtain ⟨⟨m, hm, hma, _⟩, _, hnone⟩ := hl
  rcases Nat.lt_trichotomy t (coh a) with h | h | h
  · exfalso
    have hh : WeakMem.hiddenFrom mem a t bound = true := by
      unfold WeakMem.hiddenFrom
      rw [List.any_eq_true]
      exact ⟨coh a, List.mem_range.2 (Nat.lt_succ_of_le hb), by simp [h, hm, hma]⟩
    simp [WeakMem.readable, hh] at hr
  · exact Or.inl h
  · right
    unfold WeakMem.readable at hr
    cases ht : mem[t]? with
    | none => simp [ht] at hr
    | some m' =>
        simp [ht] at hr
        exact ⟨h, hnone t m' h ht hr.1, m', rfl, hr.1⟩

/-- (S4) **A one-word load at a latest address, promises skipped**: its value
with coherence unmoved, or a skipped message, at or below the new coherence. -/
theorem stepLoad_latestS {arch : Arch} {mem : Memory} {pairs : List Ts} {th th' : Promises.Thread}
    {dst : WeakMem.Reg} {a : Address} {deps : List WeakMem.Reg} {acq : Bool} {v : Word} {S : Ts → Prop}
    (hl : LatestS mem S th.vs.coh a v) (h : th' ∈ Promises.stepLoad arch mem pairs th dst a deps acq) :
    (∀ b, th.vs.coh b ≤ th'.vs.coh b) ∧
    ((WLe1 v (th'.regs dst) ∧ th'.vs.coh = th.vs.coh) ∨
      ∃ t m, S t ∧ mem[t]? = some m ∧ m.loc = a ∧ t ≤ th'.vs.coh a) := by
  simp only [Promises.stepLoad, List.mem_map, List.mem_filter, List.mem_range] at h
  obtain ⟨t, ⟨_, hr⟩, rfl⟩ := h
  refine ⟨fun b => ?_, ?_⟩
  · by_cases hb : b = a
    · subst hb; simpa using Nat.le_max_left (th.vs.coh b) t
    · simp [hb]
  rcases readable_latestS hl (coh_le_readBound arch th.vs _ a) hr with e | ⟨hlt, hS, m, hm, hma⟩
  · left
    subst e
    obtain ⟨⟨m, hm, _, hv, hvw⟩, _⟩ := hl
    refine ⟨⟨?_, fun x g hx => ?_⟩, ?_⟩
    · simp [getElem!_def, hm, hv]
    · simpa [getElem!_def, hm] using hvw x g hx
    · funext b
      by_cases hb : b = a
      · subst hb; simp
      · simp [hb]
  · right
    exact ⟨t, m, hS, hm, hma, by simpa using Nat.le_max_right (th.vs.coh a) t⟩

/-- (S4) The same, for a two-word load. -/
theorem stepLoadPair_latestS {arch : Arch} {mem : Memory} {pairs : List Ts} {th th' : Promises.Thread}
    {dst0 dst1 : WeakMem.Reg} {a : Address} {deps : List WeakMem.Reg} {acq : Bool} {v0 v1 : Word} {S : Ts → Prop}
    (hd : dst0 ≠ dst1) (hl0 : LatestS mem S th.vs.coh a v0) (hl1 : LatestS mem S th.vs.coh a.next v1)
    (h : th' ∈ Promises.stepLoadPair arch mem pairs th dst0 dst1 a deps acq) :
    (∀ b, th.vs.coh b ≤ th'.vs.coh b) ∧
    ((WLe1 v0 (th'.regs dst0) ∧ WLe1 v1 (th'.regs dst1) ∧ th'.vs.coh = th.vs.coh) ∨
      ∃ t m, S t ∧ mem[t]? = some m ∧ t ≤ th'.vs.coh m.loc) := by
  simp only [Promises.stepLoadPair, List.mem_flatMap, List.mem_filterMap, List.mem_filter,
    List.mem_range] at h
  obtain ⟨t0, ⟨_, hr0⟩, t1, ⟨_, hr1⟩, hs⟩ := h
  have ha : a ≠ a.next := by
    intro e; have := congrArg WeakMem.Address.offset e; simp [WeakMem.Address.next] at this
  split at hs
  · exact absurd hs (by simp)
  · simp only [Option.some.injEq] at hs
    subst hs
    refine ⟨fun b => ?_, ?_⟩
    · dsimp only
      split
      · rename_i hb; subst hb; exact Nat.le_max_left _ _
      · split
        · rename_i _ hb; subst hb; exact Nat.le_max_left _ _
        · exact Nat.le_refl _
    rcases readable_latestS hl0 (coh_le_readBound arch th.vs _ a) hr0 with e0 | ⟨hlt, hS, m, hm, hma⟩
    · rcases readable_latestS hl1 (coh_le_readBound arch th.vs _ a.next) hr1 with e1 | ⟨hlt, hS, m, hm, hma⟩
      · left
        subst e0 e1
        obtain ⟨⟨m0, hm0, _, hv0, hw0⟩, _⟩ := hl0
        obtain ⟨⟨m1, hm1, _, hv1, hw1⟩, _⟩ := hl1
        refine ⟨⟨?_, fun x g hx => ?_⟩, ⟨?_, fun x g hx => ?_⟩, ?_⟩
        · simp [getElem!_def, hm0, hv0]
        · simpa [getElem!_def, hm0] using hw0 x g hx
        · simp [getElem!_def, hm1, hv1, Ne.symm hd]
        · simpa [getElem!_def, hm1, Ne.symm hd] using hw1 x g hx
        · funext b
          by_cases hb : b = a
          · subst hb; simp
          · by_cases hb' : b = a.next
            · subst hb'; simp [hb]
            · simp [hb, hb']
      · right
        refine ⟨t1, m, hS, hm, ?_⟩
        rw [hma]; dsimp only; simpa [Ne.symm ha] using Nat.le_max_right (th.vs.coh a.next) t1
    · right
      refine ⟨t0, m, hS, hm, ?_⟩
      rw [hma]; dsimp only; simpa using Nat.le_max_right (th.vs.coh a) t0

/-- (S4) A load only raises coherence. -/
theorem loadUnits_cohMono {arch : Arch} {pw : Word} {a : Address} {acq : Bool} :
    ∀ (us : List Acc) (k : Nat) (s : St) (r : St × List Word), r ∈ loadUnits arch pw a acq us k s →
      ∀ b, s.vs.coh b ≤ r.1.vs.coh b
  | [], _, s, r, hr => by
      simp only [loadUnits, List.mem_singleton] at hr; subst hr; exact fun _ => Nat.le_refl _
  | .one :: us, k, s, r, hr => by
      simp only [loadUnits, List.mem_flatMap, List.mem_map] at hr
      obtain ⟨th, hth, ⟨s', ws⟩, hmem, rfl⟩ := hr
      have g := loadUnits_cohMono us (k + 1) { s with vs := th.vs, undefs := s.undefs + countUndef [th.regs 1] }
        (s', ws) hmem
      simp only [Promises.stepLoad, List.mem_map, List.mem_filter, List.mem_range] at hth
      obtain ⟨t, -, rfl⟩ := hth
      intro b
      refine Nat.le_trans ?_ (g b)
      show s.vs.coh b ≤ (if b = offs a k then max (s.vs.coh (offs a k)) t else s.vs.coh b)
      split
      · rename_i hb; subst hb; exact Nat.le_max_left _ _
      · exact Nat.le_refl _
  | .two :: us, k, s, r, hr => by
      simp only [loadUnits, List.mem_flatMap, List.mem_map] at hr
      obtain ⟨th, hth, ⟨s', ws⟩, hmem, rfl⟩ := hr
      have g := loadUnits_cohMono us (k + 2)
        { s with vs := th.vs, undefs := s.undefs + countUndef [th.regs 1, th.regs 2] } (s', ws) hmem
      simp only [Promises.stepLoadPair, List.mem_flatMap, List.mem_filterMap, List.mem_filter,
        List.mem_range] at hth
      obtain ⟨t0, -, t1, -, hs⟩ := hth
      split at hs
      · exact absurd hs (by simp)
      · simp only [Option.some.injEq] at hs
        subst hs
        intro b
        refine Nat.le_trans ?_ (g b)
        show s.vs.coh b ≤ (if b = offs a k then max (s.vs.coh (offs a k)) t0
          else if b = (offs a k).next then max (s.vs.coh (offs a k).next) t1 else s.vs.coh b)
        split
        · rename_i hb; subst hb; exact Nat.le_max_left _ _
        · split
          · rename_i _ hb; subst hb; exact Nat.le_max_left _ _
          · exact Nat.le_refl _

/-- (S4) **Loading latest words, promises skipped**: `loadUnits` returns the
latest values with coherence unmoved, or has read an own promise, which is
then at or below coherence (excluded by `PromAbove`). -/
theorem loadUnits_latestP {arch : Arch} {pw : Word} {a : Address} {acq : Bool} :
    ∀ (us : List Acc) (k : Nat) (s : St) (vals : List Word), vals.length = nWords us →
      (∀ j v, vals[j]? = some v → LatestP s.mem s.promises s.vs.coh (offs a (k + j)) v) →
      ∀ r, r ∈ loadUnits arch pw a acq us k s →
        r.1.mem = s.mem ∧ r.1.promises = s.promises ∧
        ((WLe vals r.2 ∧ r.1.vs.coh = s.vs.coh) ∨
          ∃ t m, t ∈ s.promises ∧ s.mem[t]? = some m ∧ t ≤ r.1.vs.coh m.loc)
  | [], k, s, vals, hn, _, r, hr => by
      have : vals = [] := List.eq_nil_of_length_eq_zero (by simpa [nWords] using hn)
      subst this
      simp only [loadUnits, List.mem_singleton] at hr
      subst hr; exact ⟨rfl, rfl, Or.inl ⟨WLe_refl [], rfl⟩⟩
  | .one :: us, k, s, vals, hn, hl, r, hr => by
      obtain ⟨f1, -, f3, -⟩ := loadUnits_frame (.one :: us) k s r hr
      refine ⟨f1, f3, ?_⟩
      cases vals with
      | nil => simp [nWords, Acc.size] at hn; omega
      | cons v rest =>
          simp only [loadUnits, List.mem_flatMap, List.mem_map] at hr
          obtain ⟨th, hth, ⟨s', ws⟩, hmem, rfl⟩ := hr
          have hl0 : LatestP s.mem s.promises s.vs.coh (offs a k) v := by
            have := hl 0 v rfl; simpa using this
          let s1 : St := { s with vs := th.vs, undefs := s.undefs + countUndef [th.regs 1] }
          have hmono := loadUnits_cohMono us (k + 1) s1 (s', ws) hmem
          obtain ⟨hcm, hcase⟩ := stepLoad_latestS (th := mth s pw pw pw) hl0 hth
          rcases hcase with ⟨hv, hc⟩ | ⟨t, m, hS, hm, hma, hle⟩
          · have hn' : rest.length = nWords us := by
              simp [nWords, Acc.size] at hn ⊢; omega
            obtain ⟨-, -, ih⟩ := loadUnits_latestP us (k + 1) s1 rest hn'
              (fun j v' hj => by
                have := hl (j + 1) v' (by simpa using hj)
                show LatestP s.mem s.promises th.vs.coh _ v'
                rw [hc, show k + 1 + j = k + (j + 1) by omega]
                exact this) (s', ws) hmem
            rcases ih with ⟨h1, h2⟩ | ⟨t, m, ht, hm, hle⟩
            · exact Or.inl ⟨⟨hv, h1⟩, by rw [h2]; exact hc⟩
            · exact Or.inr ⟨t, m, ht, hm, hle⟩
          · right
            refine ⟨t, m, hS, hm, Nat.le_trans ?_ (hmono m.loc)⟩
            rw [hma]; exact hle
  | .two :: us, k, s, vals, hn, hl, r, hr => by
      obtain ⟨f1, -, f3, -⟩ := loadUnits_frame (.two :: us) k s r hr
      refine ⟨f1, f3, ?_⟩
      match vals, hn, hl with
      | [], hn, _ => simp [nWords, Acc.size] at hn; omega
      | [_], hn, _ => simp [nWords, Acc.size] at hn; omega
      | v0 :: v1 :: rest, hn, hl =>
          simp only [loadUnits, List.mem_flatMap, List.mem_map] at hr
          obtain ⟨th, hth, ⟨s', ws⟩, hmem, rfl⟩ := hr
          have hl0 : LatestP s.mem s.promises s.vs.coh (offs a k) v0 := by
            have := hl 0 v0 rfl; simpa using this
          have hl1 : LatestP s.mem s.promises s.vs.coh (offs a k).next v1 := by
            have := hl 1 v1 rfl
            have e : (offs a k).next = offs a (k + 1) := by simp [offs, WeakMem.Address.next, Nat.add_assoc]
            rw [e]; simpa using this
          let s1 : St := { s with vs := th.vs, undefs := s.undefs + countUndef [th.regs 1, th.regs 2] }
          have hmono := loadUnits_cohMono us (k + 2) s1 (s', ws) hmem
          obtain ⟨hcm, hcase⟩ := stepLoadPair_latestS (th := mth s pw pw pw) (by decide) hl0 hl1 hth
          rcases hcase with ⟨hv0, hv1, hc⟩ | ⟨t, m, hS, hm, hle⟩
          · have hn' : rest.length = nWords us := by
              simp only [List.length_cons, nWords, List.map_cons, List.sum_cons, Acc.size] at hn ⊢; omega
            obtain ⟨-, -, ih⟩ := loadUnits_latestP us (k + 2) s1 rest hn'
              (fun j v' hj => by
                have := hl (j + 2) v' (by simpa using hj)
                show LatestP s.mem s.promises th.vs.coh _ v'
                rw [hc, show k + 2 + j = k + (j + 2) by omega]
                exact this) (s', ws) hmem
            rcases ih with ⟨h1, h2⟩ | ⟨t, m, ht, hm, hle⟩
            · exact Or.inl ⟨⟨hv0, hv1, h1⟩, by rw [h2]; exact hc⟩
            · exact Or.inr ⟨t, m, ht, hm, hle⟩
          · exact Or.inr ⟨t, m, hS, hm, Nat.le_trans hle (hmono m.loc)⟩


/-- (S8b) The view of the reference register (reg 0) bounds a box load's read
bound: `projM` passes the reference as the dependency. -/
theorem view_le_readBound (arch : Arch) (s : St) (pw : Word) (b : Address) :
    pw.view ≤ Promises.readBoundOf arch s.vs (Promises.depBound (mth s pw pw pw).regs [0]) b := by
  simp only [Promises.readBoundOf, Promises.depBound, Promises.depView, Promises.depRts, mth, regsOf,
    List.foldl, ite_true]
  apply Nat.le_trans _ (Nat.le_max_left _ _)
  omega

/-- (S8b) **A one-word load of a word latest at a constant coherence `t`** that
the reference's view reaches: its value, or a skipped message at or below the
new coherence. -/
theorem stepLoad_topS {arch : Arch} {mem : Memory} {pairs : List Ts} {s : St} {pw : Word}
    {th' : Promises.Thread} {dst : WeakMem.Reg} {a : Address} {acq : Bool} {v : Word} {S : Ts → Prop} {t : Ts}
    (hl : LatestS mem S (fun _ => t) a v) (ht : t ≤ pw.view)
    (h : th' ∈ Promises.stepLoad arch mem pairs (mth s pw pw pw) dst a [0] acq) :
    WLe1 v (th'.regs dst) ∨ ∃ t' m, S t' ∧ mem[t']? = some m ∧ m.loc = a ∧ t' ≤ th'.vs.coh a := by
  simp only [Promises.stepLoad, List.mem_map, List.mem_filter, List.mem_range] at h
  obtain ⟨t', ⟨_, hr⟩, rfl⟩ := h
  rcases readable_latestS hl (Nat.le_trans ht (view_le_readBound arch s pw a)) hr with e | ⟨hlt, hS, m, hm, hma⟩
  · left
    have e' : t' = t := e
    subst e'
    obtain ⟨⟨m, hm, _, hv, hvw⟩, _⟩ := hl
    refine ⟨?_, fun x g hx => ?_⟩
    · simp [getElem!_def, hm, hv]
    · simpa [getElem!_def, hm] using hvw x g hx
  · right
    exact ⟨t', m, hS, hm, hma, by simpa using Nat.le_max_right ((mth s pw pw pw).vs.coh a) t'⟩

/-- (S8b) The same, for a two-word load. -/
theorem stepLoadPair_topS {arch : Arch} {mem : Memory} {pairs : List Ts} {s : St} {pw : Word}
    {th' : Promises.Thread} {dst0 dst1 : WeakMem.Reg} {a : Address} {acq : Bool} {v0 v1 : Word}
    {S : Ts → Prop} {t0 t1 : Ts} (hd : dst0 ≠ dst1)
    (hl0 : LatestS mem S (fun _ => t0) a v0) (ht0 : t0 ≤ pw.view)
    (hl1 : LatestS mem S (fun _ => t1) a.next v1) (ht1 : t1 ≤ pw.view)
    (h : th' ∈ Promises.stepLoadPair arch mem pairs (mth s pw pw pw) dst0 dst1 a [0] acq) :
    (WLe1 v0 (th'.regs dst0) ∧ WLe1 v1 (th'.regs dst1)) ∨
      ∃ t m, S t ∧ mem[t]? = some m ∧ t ≤ th'.vs.coh m.loc := by
  simp only [Promises.stepLoadPair, List.mem_flatMap, List.mem_filterMap, List.mem_filter,
    List.mem_range] at h
  obtain ⟨u0, ⟨_, hr0⟩, u1, ⟨_, hr1⟩, hs⟩ := h
  have ha : a ≠ a.next := by
    intro e; have := congrArg WeakMem.Address.offset e; simp [WeakMem.Address.next] at this
  split at hs
  · exact absurd hs (by simp)
  · simp only [Option.some.injEq] at hs
    subst hs
    rcases readable_latestS hl0 (Nat.le_trans ht0 (view_le_readBound arch s pw a)) hr0 with
      e0 | ⟨hlt, hS, m, hm, hma⟩
    · rcases readable_latestS hl1 (Nat.le_trans ht1 (view_le_readBound arch s pw a.next)) hr1 with
        e1 | ⟨hlt, hS, m, hm, hma⟩
      · left
        have e0' : u0 = t0 := e0
        have e1' : u1 = t1 := e1
        subst e0' e1'
        obtain ⟨⟨m0, hm0, _, hv0, hw0⟩, _⟩ := hl0
        obtain ⟨⟨m1, hm1, _, hv1, hw1⟩, _⟩ := hl1
        refine ⟨⟨?_, fun x g hx => ?_⟩, ⟨?_, fun x g hx => ?_⟩⟩
        · simp [getElem!_def, hm0, hv0]
        · simpa [getElem!_def, hm0] using hw0 x g hx
        · simp [getElem!_def, hm1, hv1, Ne.symm hd]
        · simpa [getElem!_def, hm1, Ne.symm hd] using hw1 x g hx
      · right
        refine ⟨u1, m, hS, hm, ?_⟩
        rw [hma]; dsimp only; simpa [Ne.symm ha] using Nat.le_max_right ((mth s pw pw pw).vs.coh a.next) u1
    · right
      refine ⟨u0, m, hS, hm, ?_⟩
      rw [hma]; dsimp only; simpa using Nat.le_max_right ((mth s pw pw pw).vs.coh a) u0

/-- (S8b) **Loading box words**: each word latest at a constant coherence the
reference's view reaches; `loadUnits` returns them, or has read an own promise,
which is then at or below coherence (excluded by `PromAbove`). -/
theorem loadUnits_topP {arch : Arch} {pw : Word} {a : Address} {acq : Bool} :
    ∀ (us : List Acc) (k : Nat) (s : St) (vals : List Word), vals.length = nWords us →
      (∀ j v, vals[j]? = some v → ∃ t, t ≤ pw.view ∧ LatestP s.mem s.promises (fun _ => t) (offs a (k + j)) v) →
      ∀ r, r ∈ loadUnits arch pw a acq us k s →
        WLe vals r.2 ∨ ∃ t m, t ∈ s.promises ∧ s.mem[t]? = some m ∧ t ≤ r.1.vs.coh m.loc
  | [], k, s, vals, hn, _, r, hr => by
      have : vals = [] := List.eq_nil_of_length_eq_zero (by simpa [nWords] using hn)
      subst this
      simp only [loadUnits, List.mem_singleton] at hr
      subst hr; exact Or.inl (WLe_refl [])
  | .one :: us, k, s, vals, hn, hl, r, hr => by
      cases vals with
      | nil => simp [nWords, Acc.size] at hn; omega
      | cons v rest =>
          simp only [loadUnits, List.mem_flatMap, List.mem_map] at hr
          obtain ⟨th, hth, ⟨s', ws⟩, hmem, rfl⟩ := hr
          obtain ⟨t0, ht0, hl0⟩ : ∃ t, t ≤ pw.view ∧ LatestP s.mem s.promises (fun _ => t) (offs a k) v := by
            have := hl 0 v rfl; simpa using this
          let s1 : St := { s with vs := th.vs, undefs := s.undefs + countUndef [th.regs 1] }
          have hmono := loadUnits_cohMono us (k + 1) s1 (s', ws) hmem
          rcases stepLoad_topS (s := s) hl0 ht0 hth with hv | ⟨t, m, hS, hm, hma, hle⟩
          · have hn' : rest.length = nWords us := by
              simp [nWords, Acc.size] at hn ⊢; omega
            rcases loadUnits_topP us (k + 1) s1 rest hn'
              (fun j v' hj => by
                have := hl (j + 1) v' (by simpa using hj)
                rw [show k + 1 + j = k + (j + 1) by omega]
                exact this) (s', ws) hmem with h1 | ⟨t, m, ht, hm, hle⟩
            · exact Or.inl ⟨hv, h1⟩
            · exact Or.inr ⟨t, m, ht, hm, hle⟩
          · right
            refine ⟨t, m, hS, hm, Nat.le_trans ?_ (hmono m.loc)⟩
            rw [hma]; exact hle
  | .two :: us, k, s, vals, hn, hl, r, hr => by
      match vals, hn, hl with
      | [], hn, _ => simp [nWords, Acc.size] at hn; omega
      | [_], hn, _ => simp [nWords, Acc.size] at hn; omega
      | v0 :: v1 :: rest, hn, hl =>
          simp only [loadUnits, List.mem_flatMap, List.mem_map] at hr
          obtain ⟨th, hth, ⟨s', ws⟩, hmem, rfl⟩ := hr
          obtain ⟨t0, ht0, hl0⟩ : ∃ t, t ≤ pw.view ∧ LatestP s.mem s.promises (fun _ => t) (offs a k) v0 := by
            have := hl 0 v0 rfl; simpa using this
          obtain ⟨t1, ht1, hl1⟩ : ∃ t, t ≤ pw.view ∧ LatestP s.mem s.promises (fun _ => t) (offs a k).next v1 := by
            have := hl 1 v1 rfl
            have e : (offs a k).next = offs a (k + 1) := by simp [offs, WeakMem.Address.next, Nat.add_assoc]
            rw [e]; simpa using this
          let s1 : St := { s with vs := th.vs, undefs := s.undefs + countUndef [th.regs 1, th.regs 2] }
          have hmono := loadUnits_cohMono us (k + 2) s1 (s', ws) hmem
          rcases stepLoadPair_topS (s := s) (by decide) hl0 ht0 hl1 ht1 hth with ⟨hv0, hv1⟩ | ⟨t, m, hS, hm, hle⟩
          · have hn' : rest.length = nWords us := by
              simp only [List.length_cons, nWords, List.map_cons, List.sum_cons, Acc.size] at hn ⊢; omega
            rcases loadUnits_topP us (k + 2) s1 rest hn'
              (fun j v' hj => by
                have := hl (j + 2) v' (by simpa using hj)
                rw [show k + 2 + j = k + (j + 2) by omega]
                exact this) (s', ws) hmem with h1 | ⟨t, m, ht, hm, hle⟩
            · exact Or.inl ⟨hv0, hv1, h1⟩
            · exact Or.inr ⟨t, m, ht, hm, hle⟩
          · exact Or.inr ⟨t, m, hS, hm, Nat.le_trans hle (hmono m.loc)⟩

/-- (S8b) `loadUnits_topP` under `PromAbove` after the load: the values read
are the box's words. -/
theorem loadUnits_topPA {arch : Arch} {pw : Word} {a : Address} {acq : Bool} {us : List Acc} {k : Nat}
    {s : St} {vals : List Word} (hn : vals.length = nWords us)
    (hl : ∀ j v, vals[j]? = some v → ∃ t, t ≤ pw.view ∧ LatestP s.mem s.promises (fun _ => t) (offs a (k + j)) v)
    {r : St × List Word} (hr : r ∈ loadUnits arch pw a acq us k s) (hpa : PromAbove r.1) : WLe vals r.2 := by
  obtain ⟨e1, -, e2, -⟩ := loadUnits_frame us k s r hr
  rcases loadUnits_topP us k s vals hn hl r hr with h | ⟨t, m, ht, hm, hle⟩
  · exact h
  · exact (PromAbove_low hpa (by rw [e2]; exact ht) (by rw [e1]; exact hm) hle).elim

/-! ### (S4) Allocation, own promises skipped -/

/-- (S4) **An allocation, unfolded**: the placeholders, then a store from the
state after them. -/
theorem alloc_unf {k : Promises.Knobs} {arch : Arch} {lbl : AllocLabel} {us : List Acc} {ws : List Word}
    {s : St} {r : St × Word} (hr : r ∈ alloc k arch lbl us ws s) :
    ∃ s1, r.1 ∈ storeUnits k arch (cst (.loc ⟨lbl, 0⟩ 0)) ⟨lbl, 0⟩ false us ws 0 s1 ∧
      r.2 = cst (.loc ⟨lbl, 0⟩ 0) ∧
      s1.promises = s.promises ∧ s1.pairs = s.pairs ∧ s1.nalloc = s.nalloc + 1 ∧ s1.vs.vRelSt = s.vs.vRelSt ∧
      s1.vs.vWr = max s.vs.vWr (s.mem.size + nWords us - 1) ∧
      (∀ b, b.label ≠ lbl → s1.vs.coh b = s.vs.coh b) ∧
      (∀ o, o < nWords us → s1.vs.coh ⟨lbl, o⟩ = s.mem.size + o) ∧ s1.mem.size = s.mem.size + nWords us ∧
      ∀ t, s1.mem[t]? = if t < s.mem.size then s.mem[t]? else
        if t < s.mem.size + nWords us then some ⟨⟨lbl, t - s.mem.size⟩, .undef, 0⟩ else none := by
  simp only [alloc, List.mem_map] at hr
  obtain ⟨s', hs, rfl⟩ := hr
  refine ⟨_, hs, rfl, rfl, rfl, rfl, rfl, rfl, fun b hb => ?_, fun o ho => ?_, fold_size _ _ _, fun t => ?_⟩
  · simp [hb]
  · simp [ho]
  · rw [fold_get]; simp [offs]

/-- (S4) **An allocation, as its owner sees it, promises skipped**: each stored
word is its address's latest, and every address at another label keeps its
latest. -/
theorem alloc_latP {k : Promises.Knobs} {arch : Arch} {lbl : AllocLabel} {us : List Acc} {ws : List Word}
    {s : St} (hpl : PromLt s) (hnd : s.promises.Nodup) :
    ∀ r, r ∈ alloc k arch lbl us ws s →
      (∀ (j : Nat) w, j < nWords us → ws[j]? = some w →
        LatestP r.1.mem r.1.promises r.1.vs.coh ⟨lbl, j⟩ (bumpW s.vs.vRelSt w)) ∧
      (∀ (b : Address) (v : Word), b.label ≠ lbl → LatestP s.mem s.promises s.vs.coh b v →
        LatestP r.1.mem r.1.promises r.1.vs.coh b v) := by
  intro r hr
  obtain ⟨s1, hs, -, e4, -, -, e6, -, ec, ec0, esz, eget⟩ := alloc_unf hr
  have hold : ∀ t, t < s.mem.size → s1.mem[t]? = s.mem[t]? := fun t ht => by rw [eget t]; simp [ht]
  have hpl1 : PromLt s1 := fun t ht => by
    rw [e4] at ht; rw [esz]; exact Nat.lt_of_lt_of_le (hpl t ht) (Nat.le_add_right _ _)
  obtain ⟨g2, g3⟩ := storeUnits_latP (a := ⟨lbl, 0⟩) us ws 0 s1 s.vs.vRelSt hpl1 (by rw [e4]; exact hnd)
    (Nat.le_of_eq e6.symm) r.1 hs
  refine ⟨fun j w hj hw => ?_, fun b v hb hl => g3 b v (fun j _ e => hb (by rw [e]; rfl)) ?_⟩
  · have := g2 (fun j' hj' t m ht hm hl => ?_) j w hj hw
    · simpa [offs] using this
    · exfalso
      have hc := ec0 j' hj'
      simp only [offs, Nat.zero_add] at ht hl hc
      rw [hc] at ht
      have ht' : s.mem.size + j' < t := ht
      rw [eget t] at hm
      by_cases h0 : t < s.mem.size
      · exact absurd (Nat.lt_trans (Nat.lt_of_le_of_lt (Nat.le_add_right _ _) ht') h0) (Nat.lt_irrefl _)
      · simp only [h0, ite_false] at hm
        split at hm
        · simp only [Option.some.injEq] at hm; subst hm
          have h2 : t - s.mem.size = j' := congrArg WeakMem.Address.offset hl
          have h3 := Nat.add_sub_of_le (Nat.le_of_not_lt h0)
          rw [h2] at h3; rw [h3] at ht'; exact Nat.lt_irrefl _ ht'
        · cases hm
  · obtain ⟨⟨m, hm0, hma, hmv, hmw⟩, hn, hab⟩ := hl
    refine ⟨⟨m, by rw [ec b hb, hold _ (lt_of_get hm0)]; exact hm0, hma, hmv, hmw⟩,
      by rw [ec b hb, e4]; exact hn, fun t m' ht hm' hl' => ?_⟩
    rw [ec b hb] at ht
    rw [e4]
    rw [eget t] at hm'
    split at hm'
    · exact hab t m' ht hm' hl'
    · split at hm'
      · simp only [Option.some.injEq] at hm'; subst hm'
        exact absurd (by rw [← hl']) hb
      · cases hm'

/-- (S4) **An allocation** only appends at its label, only discharges
promises (at its label), keeps them below the memory's size, and counts one
more allocation. -/
theorem alloc_growsP {k : Promises.Knobs} {arch : Arch} {lbl : AllocLabel} {us : List Acc} {ws : List Word}
    {s : St} (hpl : PromLt s) :
    ∀ r, r ∈ alloc k arch lbl us ws s →
      GrowsAt s.mem r.1.mem lbl ∧ r.1.promises.Sublist s.promises ∧ r.1.nalloc = s.nalloc + 1 ∧ PromLt r.1 ∧
      ∀ t, t ∈ s.promises → t ∉ r.1.promises → ∃ m, s.mem[t]? = some m ∧ m.loc.label = lbl := by
  intro r hr
  obtain ⟨s1, hs, -, e4, -, e5, -, -, -, -, esz, eget⟩ := alloc_unf hr
  have hold : ∀ t, t < s.mem.size → s1.mem[t]? = s.mem[t]? := fun t ht => by rw [eget t]; simp [ht]
  have hpl1 : PromLt s1 := fun t ht => by
    rw [e4] at ht; rw [esz]; exact Nat.lt_of_lt_of_le (hpl t ht) (Nat.le_add_right _ _)
  have hg1 : GrowsAt s.mem s1.mem lbl := by
    refine ⟨by rw [esz]; omega, hold, fun t m ht hm => ?_⟩
    rw [eget t] at hm
    simp only [show ¬ t < s.mem.size by omega, ite_false] at hm
    split at hm
    · simp only [Option.some.injEq] at hm; subst hm; rfl
    · cases hm
  obtain ⟨gg, -, gn⟩ := storeUnits_growsF (a := ⟨lbl, 0⟩) us ws 0 s1 r.1 hs
  obtain ⟨gp, gs, gf⟩ := storeUnits_promF (a := ⟨lbl, 0⟩) us ws 0 s1 r.1 hpl1 hs
  refine ⟨GrowsAt_trans hg1 gg, by rw [← e4]; exact gs, by rw [gn, e5], gp, fun t ht hn => ?_⟩
  obtain ⟨m, j, w, hm, -, -, hl, -⟩ := gf t (by rw [e4]; exact ht) hn
  refine ⟨m, by rw [← hold t (hpl t ht)]; exact hm, by rw [hl]; rfl⟩

/-- (S4) **A new cell's placeholders are hidden**, own promises skipped, below
the `vWr` after its initialising stores; `vWr` only grows. -/
theorem alloc_hidP {k : Promises.Knobs} {arch : Arch} {lbl : AllocLabel} {us : List Acc} {ws : List Word}
    {s : St} {η : TEnv} {T : Ty}
    (hv : ValOf (allocE η lbl T) T (ws.map (bumpW s.vs.vRelSt))) (hsh : ShapeC T (ws.map (bumpW s.vs.vRelSt)))
    (hacc : accs T ≠ none) (hfresh : ∀ (t : Nat) (m : Msg), s.mem[t]? = some m → m.loc.label = lbl → t ∈ s.promises)
    (hpl : PromLt s) :
    ∀ r, r ∈ alloc k arch lbl us ws s →
      s.vs.vWr ≤ r.1.vs.vWr ∧ ∀ o, HiddenP (allocE η lbl T) T r.1.mem r.1.promises lbl o r.1.vs.vWr := by
  intro r hr
  obtain ⟨s1, hs, -, e4, -, -, e6, e7, -, ec0, esz, eget⟩ := alloc_unf hr
  have hold : ∀ t, t < s.mem.size → s1.mem[t]? = s.mem[t]? := fun t ht => by rw [eget t]; simp [ht]
  have hpl1 : PromLt s1 := fun t ht => by
    rw [e4] at ht; rw [esz]; exact Nat.lt_of_lt_of_le (hpl t ht) (Nat.le_add_right _ _)
  have g1 := storeUnits_wrF us ws 0 s1 r.1 hs
  have g2 := storeUnits_wrP (a := ⟨lbl, 0⟩) us ws 0 s1 r.1 hs
  obtain ⟨gg, -, -⟩ := storeUnits_growsF (a := ⟨lbl, 0⟩) us ws 0 s1 r.1 hs
  have hw : ∀ (j : Nat) w, ws[j]? = some w → ∃ w0, (ws.map (bumpW s.vs.vRelSt))[0 + j]? = some w0 ∧
      WLe1 w0 (bumpW s.vs.vRelSt w) := fun j w hw => ⟨bumpW s.vs.vRelSt w, by simp [hw], WLe1_refl _⟩
  have nk := storeUnits_newOKF (a := ⟨lbl, 0⟩) (b := 0) (o0 := 0) (allocE_eq (η := η) (T := T))
    (Or.inl ⟨rfl, rfl, hacc⟩) rfl ⟨hv, hsh⟩ us ws 0 s1 (fun j w h => by simpa using hw j w h) (Nat.le_of_eq e6.symm) r.1 hs
  have fk := storeUnits_fulOK (a := ⟨lbl, 0⟩) (b := 0) (o0 := 0) (c := ⟨T, some η.tid⟩) (η := allocE η lbl T)
    (Or.inl ⟨rfl, rfl, hacc⟩) rfl ⟨hv, hsh⟩ (fun j w h => by simpa using hw j w h) (Nat.le_of_eq e6.symm) hpl1 hs
  refine ⟨by rw [e7] at g1; exact Nat.le_trans (Nat.le_max_left _ _) g1, fun o t m hP ht hl hnw => ?_⟩
  by_cases hlt : s1.mem.size ≤ t
  · obtain ⟨-, hok⟩ := nk t m hlt ht
    rw [hl] at hok; exact absurd hok hnw
  · have ht1 : s1.mem[t]? = some m := by rw [← gg.2.1 t (by omega)]; exact ht
    have ht2 := ht1
    rw [eget t] at ht2
    by_cases hlt0 : t < s.mem.size
    · simp only [hlt0, ite_true] at ht2
      have hP0 : t ∈ s1.promises := by rw [e4]; exact hfresh t m ht2 (by rw [hl])
      obtain ⟨m', hm', -, hok⟩ := fk t hP0 hP
      rw [ht1] at hm'; cases hm'
      rw [hl] at hok; exact absurd hok hnw
    · simp only [hlt0, ite_false] at ht2
      split at ht2
      · rename_i hlt2
        simp only [Option.some.injEq] at ht2; subst ht2
        have ho : o = t - s.mem.size := by
          have := congrArg WeakMem.Address.offset hl; simpa using this.symm
        obtain ⟨t', m', h1, h2, h3, h4⟩ := g2 o (by omega)
        have hc := ec0 o (by omega)
        simp only [offs, Nat.zero_add] at h1 h4 hc
        refine ⟨t', m', ?_, h2, h3, h4⟩
        rcases h1 with h1 | h1
        · omega
        · rw [hc] at h1; exact Nat.lt_of_le_of_lt (by omega : t ≤ s.mem.size + o) h1
      · cases ht2

/-- (M3) A frontier the thread holds for one of its own cells comes from its
own `publish`, which also marked the cell seen. -/
def OwnPub (E : TEnv) : Prop :=
  ∀ l c f, E.sto l = some c → c.owner = some E.tid → E.pfr l = some f → E.seen l

/-- (S7f α) Address `a` lies in an initialised slot of its cell, if the cell is
a buffer (`.array (.lit N) e`): below `ini` slots (vacuous off buffers and off
Σ).  For a word unit it is `IniAt` (`IniW_word`, `IniAt_of_IniW`). -/
def IniW (E : TEnv) (a : Address) : Prop :=
  ∀ c N e us, E.sto a.label = some c → c.ty = .array (.lit N) e → accs e = some us →
    a.offset < E.ini a.label * nWords us

/-- (F2′ (a′)) `IniW` at the real count (`TEnv.rc`). -/
def IniWr (E : TEnv) (a : Address) : Prop :=
  ∀ c N e us, E.sto a.label = some c → c.ty = .array (.lit N) e → accs e = some us →
    a.offset < E.rc a.label * nWords us

/-- (T8, slot form) A unit initialised below `ini` whose slot lies below the real count
is initialised below the real count. -/
theorem iniAt_rc_of_iniWr {E : TEnv} {c : Cell} {a : Address} {U : Ty} (hsto : E.sto a.label = some c)
    (hw : IniWr E a) (hv : IniAt E.ini c a U) : IniAt E.rc c a U := by
  intro N e hc
  rcases hv N e hc with h1 | ⟨us, j, o, h1, h2, h3, h4⟩
  · exact Or.inl h1
  · refine Or.inr ⟨us, j, o, h1, Nat.lt_of_not_le fun hge => ?_, h3, h4⟩
    have hlt := hw c N e us hsto hc h1
    rw [← h3] at hlt
    exact Nat.lt_irrefl _ (Nat.lt_of_lt_of_le hlt
      (Nat.le_trans (Nat.mul_le_mul_right _ hge) (Nat.le_add_right _ _)))

/-- (S7b′) The thread holds an outstanding promise at or above `f` at an
uninitialised slot of cell `l`, the lowest of its outstanding promises to that
address. -/
def HoldW (E : TEnv) (s : St) (l : AllocLabel) (f : Nat) : Prop :=
  ∃ t ∈ s.promises, ∃ m, s.mem[t]? = some m ∧ m.loc.label = l ∧ f ≤ t ∧
    (∀ u ∈ s.promises, ∀ m', s.mem[u]? = some m' → m'.loc = m.loc → t ≤ u) ∧ ¬ IniWr E m.loc

theorem HoldW.congrE {E E' : TEnv} {s : St} {l : AllocLabel} {f : Nat} (h : HoldW E s l f)
    (hi : ∀ a : Address, a.label = l → IniWr E' a → IniWr E a) : HoldW E' s l f := by
  obtain ⟨t, ht, m, hm, hl, hf, hmin, hni⟩ := h
  exact ⟨t, ht, m, hm, hl, hf, hmin, fun h => hni (hi _ hl h)⟩

/-- (S7b) `MemInv`'s form of `OwnPub`: a frontier of one of the thread's own
cells was either set by its own `publish` (which marked the cell seen), or is at
most the thread's `vWr` (a frontier planted at a promise step, `MemInv_plant`;
`vWr` only grows), or is at most an outstanding promise of the thread at an
uninitialised slot of the cell (`HoldW`: its fulfilment raises `vWr` past it). -/
def OwnPubV (E : TEnv) (s : St) : Prop :=
  ∀ l c f, E.sto l = some c → c.owner = some E.tid → E.pfr l = some f →
    E.seen l ∨ f ≤ s.vs.vWr ∨ HoldW E s l f

theorem OwnPubV.of {E : TEnv} {s : St} (h : OwnPub E) : OwnPubV E s :=
  fun l c f h1 h2 h3 => Or.inl (h l c f h1 h2 h3)

/-- `OwnPubV` across a step that grows `vWr` past every promise it removes,
adds promises only past the old memory, and keeps the old memory. -/
theorem OwnPubV.mono {E : TEnv} {s s' : St} (h : OwnPubV E s) (hv : s.vs.vWr ≤ s'.vs.vWr)
    (hlt : PromLt s) (hful : ∀ t ∈ s.promises, t ∉ s'.promises → t ≤ s'.vs.vWr)
    (hP : ∀ u ∈ s'.promises, u ∈ s.promises ∨ s.mem.size ≤ u)
    (hmem : ∀ t, t < s.mem.size → s'.mem[t]? = s.mem[t]?) : OwnPubV E s' := by
  intro l c f h1 h2 h3
  rcases h l c f h1 h2 h3 with h | h | ⟨t, ht, m, hm, hl, hf, hmin, hni⟩
  · exact .inl h
  · exact .inr (.inl (Nat.le_trans h hv))
  · by_cases ht' : t ∈ s'.promises
    · refine .inr (.inr ⟨t, ht', m, by rw [hmem t (hlt t ht)]; exact hm, hl, hf,
        fun u hu m' hm' he => ?_, hni⟩)
      rcases hP u hu with hu0 | hu0
      · exact hmin u hu0 m' (by rw [← hmem u (hlt u hu0)]; exact hm') he
      · exact Nat.le_trans (Nat.le_of_lt (hlt t ht)) hu0
    · exact .inr (.inl (Nat.le_trans hf (hful t ht ht')))

/-- `OwnPubV` across a step that grows `vWr` and keeps memory and promises. -/
theorem OwnPubV.eqv {E : TEnv} {s s' : St} (h : OwnPubV E s) (hv : s.vs.vWr ≤ s'.vs.vWr)
    (e1 : s'.mem = s.mem) (e4 : s'.promises = s.promises) : OwnPubV E s' := by
  intro l c f h1 h2 h3
  rcases h l c f h1 h2 h3 with h | h | h
  · exact .inl h
  · exact .inr (.inl (Nat.le_trans h hv))
  · exact .inr (.inr (by unfold HoldW; rw [e1, e4]; exact h))

theorem IniW.ofEq {E E' : TEnv} (hs : E'.sto = E.sto) (hi : E'.ini = E.ini) {a : Address}
    (h : IniW E' a) : IniW E a := by
  unfold IniW at h ⊢; rw [hs, hi] at h; exact h

theorem IniWr.ofEq {E E' : TEnv} (hs : E'.sto = E.sto) (hi : E'.ini = E.ini) (hR : E'.rini = E.rini)
    {a : Address} (h : IniWr E' a) : IniWr E a := by
  unfold IniWr TEnv.rc at h ⊢; rw [hs, hi, hR] at h; exact h

/-- (S7b′) The premise of a `publish` of cell `l`: an unseen frontier of `l` is
at most `vWr` (no outstanding own promise still covers it); (F2′ (a′), P3) the
cell's reader-visible count is its real one (`ini ≤ rini`, or (Z1a′) the cell is zero-width, `ZW`: every planted slot is
initialised by the publish). -/
def PubWin (E : TEnv) (s : St) (l : AllocLabel) : Prop :=
  (∀ f, E.pfr l = some f → ¬ E.seen l → f ≤ s.vs.vWr) ∧ (ZW E l ∨ E.ini l ≤ E.rini l)

/-- (F2′ step 2 part 3) **The run-level premise of a `publish` of cell `l`**
(stageB `NoHoldPub`): (a) no outstanding own promise holds an unseen frontier
of `l` (`¬ HoldW`, a memory/promise fact; `PubWin.1` then follows from
`OwnPubV`, `PubWin_of_NoHold`); (b) the reader-visible count is the real one.
(b) is the ghost fact of `PubWin.2` unchanged: believed true on legitimate runs
also once step 3 raises `ini` at the plant (probes C6Pst, C6Ppost); its
discharge is open. -/
def NoHold (E : TEnv) (s : St) (l : AllocLabel) : Prop :=
  (∀ f, E.pfr l = some f → ¬ E.seen l → ¬ HoldW E s l f) ∧ (ZW E l ∨ E.ini l ≤ E.rini l) ∧
    (E.pfr l = none → ∀ u, ¬ HoldW E s l u)

/-! ### (M4b) What a reader of a published cell relies on -/

/-- Offset `o` starts a two-word unit of access list `us`. -/
def TwoAt (us : List Acc) (o : Nat) : Prop :=
  ∃ i, us[i]? = some .two ∧ o = nWords (us.take i)

/-- (M5a) Offset `o` of a cell of type `T` starts a two-word unit of one of its
segments (the whole cell, or a buffer slot). -/
def TwoAtT (T : Ty) (o : Nat) : Prop :=
  ∃ b S us o', SegOf T b S ∧ accs S = some us ∧ TwoAt us o' ∧ o = b + o'

/-- The thread has seen only its own cells (until other threads publish to it,
T3c-6), and (S8b) boxes, which are outside Σ: the box it creates is seen at its
frontier. -/
def SeenOwn (E : TEnv) : Prop :=
  ∀ l, E.seen l → (∃ c, E.sto l = some c ∧ c.owner = some E.tid) ∨ (E.sto l = none ∧ E.box l ≠ none)

/-- (F2′ (a′)) Segment `b` of cell `c` is below count `n`: any segment of a
value cell; of a buffer, a slot below `n`. -/
def IniSegN (n : Nat) (c : Cell) (b : Nat) : Prop :=
  ∀ N e, c.ty = .array (.lit N) e → ∃ us j, accs e = some us ∧ j < n ∧ b = j * nWords us

theorem IniSegN.mono {n n' : Nat} {c : Cell} {b : Nat} (hn : n ≤ n') (h : IniSegN n c b) : IniSegN n' c b :=
  fun N e hT => by obtain ⟨us, j, h1, h2, h3⟩ := h N e hT; exact ⟨us, j, h1, by omega, h3⟩

/-- (M5a) Segment `b` of cell `c` (at `l`) is initialised: any segment of a
value cell; of a buffer, a slot below `E.ini l` (by index, so that a zero-width
slot counts). -/
def IniSeg (E : TEnv) (c : Cell) (l : AllocLabel) (b : Nat) : Prop :=
  IniSegN (E.ini l) c b

/-- Every initialised segment type with an access list has a value of that many
words: what a torn read is assembled over.  (M5a) Segments: a buffer slot is
initialised only once a value of its type has been stored. -/
def Inh (E : TEnv) : Prop :=
  ∀ l c b S us, E.sto l = some c → SegOf c.ty b S → accs S = some us → IniSeg E c l b →
    ∃ ws, ValOf E S ws ∧ ws.length = nWords us

/-- (T3c-5h) Splicing two values of `S` at a unit boundary gives a value: what
`TermTear.VR_tearIn` gives a `coupledOK` type (`TearOK_of_cpl`), kept by folding
(`TearOK_Fd`). -/
def TearOK (S : Ty) : Prop :=
  ∀ (E : TEnv) (us : List Acc) (k : Nat) (ws1 ws2 : List Word), accs S = some us → TermTear.Bnd us k →
    VR (fun _ => 0) (CE E) S (shp S) ws1 → VR (fun _ => 0) (CE E) S (shp S) ws2 →
    ws1.length = nWords us → ws2.length = nWords us →
    VR (fun _ => 0) (CE E) S (shp S) (TermTear.splice k ws1 ws2)

theorem TearOK_of_cpl {S : Ty} (h : Ty.coupledOK S = true) : TearOK S :=
  fun _ _ _ _ _ hu hb h1 h2 l1 l2 => TermTear.VR_tearIn (ke := []) h hu hb h1 h2 l1 l2

/-- (M5b) A published cell's type has a layout (a value, or a buffer of laid-out
slots); each laid-out segment's type is coupled: a value
torn at a unit boundary is a value (`TermTear.VR_tearIn`).  (P7) The cell's
type is syntactically coupled (`publish` checks `sharedOK`), so is every
component (`coupledOK_AtOff`): what the resourceful mix needs.  (S7) It is
region-free (`rgnFree`, a scope fact until R2). -/
def PubCpl (E : TEnv) : Prop :=
  ∀ l c f, E.sto l = some c → E.pfr l = some f →
    LayT c.ty ∧ (∀ b S, SegOf c.ty b S → accs S ≠ none → TearOK S) ∧ Ty.coupledOKIn [] c.ty = true ∧
      Ty.noOwnIn [] c.ty = true ∧ rgnFree c.ty = true

/-- At a two-word unit of another thread's published cell, two messages a
reader with bound past the frontier may pair (neither hidden, no pair store
straddling them) are two words of one value.  (F2′) Also at a unit of the
thread's own planted cell (`rc < ini`) lying in a slot at or past the real
count (`¬ IniSegN rc`) and below the reader-visible one (`IniSegN ini`, F2′
step 3): what a planted load reads. -/
def PubPair (E : TEnv) (mem : Memory) (pairs P : List Ts) : Prop :=
  ∀ l c f o, E.sto l = some c →
    ((c.owner ≠ some E.tid ∧ ∃ b S us o', SegOf c.ty b S ∧ accs S = some us ∧
      TwoAt us o' ∧ o = b + o' ∧ IniSegN (E.ini l) c b) ∨
      (E.rc l < E.ini l ∧ ∃ b S us o', SegOf c.ty b S ∧ accs S = some us ∧
      TwoAt us o' ∧ o = b + o' ∧ ¬ IniSegN (E.rc l) c b ∧ IniSegN (E.ini l) c b)) → E.pfr l = some f →
    TwoAtT c.ty o → ∀ (t0 t1 : Nat) (m0 m1 : Msg), t0 ∉ P → t1 ∉ P → mem[t0]? = some m0 → mem[t1]? = some m1 →
    m0.loc = ⟨l, o⟩ → m1.loc = ⟨l, o + 1⟩ → WeakMem.hiddenFrom mem ⟨l, o⟩ t0 f = false →
    WeakMem.hiddenFrom mem ⟨l, o + 1⟩ t1 f = false →
    WeakMem.pairStraddles mem pairs ⟨l, o⟩ t0 t1 = false → PairOK E c.ty o (mw m0) (mw m1)

/-- Every word of another thread's published cell has a message: what a load
of it reads (allocation writes every word). -/
def PubLive (E : TEnv) (mem : Memory) : Prop :=
  ∀ l c f b S us o, E.sto l = some c → c.owner ≠ some E.tid → E.pfr l = some f → SegOf c.ty b S →
    accs S = some us → o < nWords us → ∃ (t : Nat) (m : Msg), mem[t]? = some m ∧ m.loc = ⟨l, b + o⟩

/-- The memory side of `PubInv`. -/
def PubMem (E : TEnv) (mem : Memory) (pairs P : List Ts) : Prop := PubPair E mem pairs P ∧ PubLive E mem

/-- (F2′) `PubPair`'s guard back along an environment step that keeps the
thread, does not lower the real count, creates no planted count, and does not
raise the reader-visible count of a planted cell. -/
theorem PubG_tr {E E' : TEnv} {l : AllocLabel} {c : Cell} {o : Nat} (ht : E.tid = E'.tid)
    (hrc : E.rc l ≤ E'.rc l) (hrcg : E'.rc l < E'.ini l → E.rc l < E.ini l ∧ E'.ini l ≤ E.ini l)
    (hif : c.owner ≠ some E'.tid → E'.ini l ≤ E.ini l)
    (h : (c.owner ≠ some E'.tid ∧ ∃ b S us o', SegOf c.ty b S ∧ accs S = some us ∧
      TwoAt us o' ∧ o = b + o' ∧ IniSegN (E'.ini l) c b) ∨
      (E'.rc l < E'.ini l ∧ ∃ b S us o', SegOf c.ty b S ∧ accs S = some us ∧
      TwoAt us o' ∧ o = b + o' ∧ ¬ IniSegN (E'.rc l) c b ∧ IniSegN (E'.ini l) c b)) :
    (c.owner ≠ some E.tid ∧ ∃ b S us o', SegOf c.ty b S ∧ accs S = some us ∧
      TwoAt us o' ∧ o = b + o' ∧ IniSegN (E.ini l) c b) ∨
      (E.rc l < E.ini l ∧ ∃ b S us o', SegOf c.ty b S ∧ accs S = some us ∧
      TwoAt us o' ∧ o = b + o' ∧ ¬ IniSegN (E.rc l) c b ∧ IniSegN (E.ini l) c b) := by
  rcases h with ⟨h, b, S, us, o', h2, h3, h4, h5, h7⟩ | ⟨h1, b, S, us, o', h2, h3, h4, h5, h6, h7⟩
  · exact .inl ⟨by rw [ht]; exact h, b, S, us, o', h2, h3, h4, h5, h7.mono (hif h)⟩
  · exact .inr ⟨(hrcg h1).1, b, S, us, o', h2, h3, h4, h5, fun h8 => h6 (h8.mono hrc), h7.mono (hrcg h1).2⟩

/-- (M4b) **The published-cell invariant.** -/
def PubInv (E : TEnv) (s : St) : Prop :=
  SeenOwn E ∧ Inh E ∧ PubCpl E ∧ PubMem E s.mem s.pairs s.promises

/-! ### (T3c-5d) Boxes -/

/-- (S8b) A property `Q` of every word of box `B`, by offset: its tag (offset
0), then its payload. -/
def BoxWords (B : Box) (Q : Nat → Word → Prop) : Prop :=
  Q 0 (cst (.num B.tag)) ∧ ∀ o w, B.pay[o]? = some w → Q (o + 1) w

theorem BoxWords.imp {B : Box} {Q Q' : Nat → Word → Prop} (h : BoxWords B Q) (f : ∀ o w, Q o w → Q' o w) :
    BoxWords B Q' :=
  ⟨f _ _ h.1, fun o w hw => f _ _ (h.2 o w hw)⟩

/-- (S8b) **The thread-independent box clause**: every word of every box is
latest at some timestamp at most the box's frontier `B.fr` (the creator's `vWr`
after its init stores), at the constant coherence `fun _ => t`, the
promises `P` skipped.  A reader whose bound reaches `B.fr` reads it. -/
def BoxTopP (E : TEnv) (mem : Memory) (P : List Ts) : Prop :=
  ∀ l B, E.box l = some B → BoxWords B fun o w => ∃ t, t ≤ B.fr ∧ LatestP mem P (fun _ => t) ⟨l, o⟩ w

/-- **The box invariant** (T3c-5d).  A box is never a Σ cell and never
initialised; no fresh label has one; (S8b) its words are latest below its
frontier (`BoxTopP`); and a box the thread has seen (the one it created) is at
its latest words at the thread's coherence, (S4) its own promises skipped. -/
def BoxInv (g : G) (E : TEnv) (s : St) : Prop :=
  (∀ j, s.nalloc ≤ j → E.box (freshLabel g.lbase g.n g.i j) = none) ∧ BoxTopP E s.mem s.promises ∧
  ∀ l B, E.box l = some B → E.sto l = none ∧ E.ini l = 0 ∧
    (E.seen l → BoxWords B fun o w => LatestP s.mem s.promises s.vs.coh ⟨l, o⟩ w)

/-- Memory grown at another label, coherence unmoved: the latest stays. -/
theorem Latest_growsAt {M M' : Memory} {coh coh' : Address → Ts} {b : Address} {v : Word} {l : AllocLabel}
    (h : Latest M coh b v) (hg : GrowsAt M M' l) (hb : b.label ≠ l) (hc : coh' b = coh b) :
    Latest M' coh' b v := by
  obtain ⟨⟨m, hm, hma, hmv, hmw⟩, hn⟩ := h
  refine ⟨⟨m, by rw [hc, hg.2.1 _ (lt_of_get hm)]; exact hm, hma, hmv, hmw⟩, fun t m' ht hm' => ?_⟩
  rw [hc] at ht
  by_cases hlt : t < M.size
  · rw [hg.2.1 t hlt] at hm'; exact hn t m' ht hm'
  · intro e; apply hb; rw [← e]; exact hg.2.2 t m' (Nat.le_of_not_lt hlt) hm'

/-- (S4) `Latest_growsAt` with a skip set. -/
theorem LatestS_growsAt {M M' : Memory} {S : Ts → Prop} {coh coh' : Address → Ts} {b : Address} {v : Word}
    {l : AllocLabel} (h : LatestS M S coh b v) (hg : GrowsAt M M' l) (hb : b.label ≠ l) (hc : coh' b = coh b) :
    LatestS M' S coh' b v := by
  obtain ⟨⟨m, hm, hma, hmv, hmw⟩, hs, hn⟩ := h
  refine ⟨⟨m, by rw [hc, hg.2.1 _ (lt_of_get hm)]; exact hm, hma, hmv, hmw⟩, by rw [hc]; exact hs,
    fun t m' ht hm' hl => ?_⟩
  rw [hc] at ht
  by_cases hlt : t < M.size
  · rw [hg.2.1 t hlt] at hm'; exact hn t m' ht hm' hl
  · exact absurd (by rw [← hl]; exact hg.2.2 t m' (Nat.le_of_not_lt hlt) hm') hb

/-- (S8b) `LatestP` across memory grown at another label whose discharged
promises are at that label, at any coherence (in particular a constant one). -/
theorem LatestP_growsAt {M M' : Memory} {P P' : List Ts} {coh : Address → Ts} {b : Address} {v : Word}
    {l : AllocLabel} (h : LatestP M P coh b v) (hg : GrowsAt M M' l) (hb : b.label ≠ l)
    (hsub : ∀ t, t ∈ P' → t ∈ P) (hful : ∀ t, t ∈ P → t ∉ P' → ∃ m, M[t]? = some m ∧ m.loc.label = l) :
    LatestP M' P' coh b v := by
  obtain ⟨⟨m, hm, hma, hmv, hmw⟩, hs, hn⟩ := h
  refine ⟨⟨m, by rw [hg.2.1 _ (lt_of_get hm)]; exact hm, hma, hmv, hmw⟩, fun h' => hs (hsub _ h'),
    fun t m' ht hm' hl => ?_⟩
  by_cases hlt : t < M.size
  · rw [hg.2.1 t hlt] at hm'
    have hp := hn t m' ht hm' hl
    refine Classical.byContradiction fun hn' => ?_
    obtain ⟨m0, hm0, e⟩ := hful t hp hn'
    rw [hm'] at hm0; cases hm0
    exact hb (by rw [← hl]; exact e)
  · exact absurd (by rw [← hl]; exact hg.2.2 t m' (Nat.le_of_not_lt hlt) hm') hb

/-- (S8b) `BoxTopP` across memory grown at a label that is no box. -/
theorem BoxTopP_growsAt {E : TEnv} {M M' : Memory} {P P' : List Ts} {l : AllocLabel}
    (h : BoxTopP E M P) (hg : GrowsAt M M' l) (hne : ∀ l' B, E.box l' = some B → l' ≠ l)
    (hsub : ∀ t, t ∈ P' → t ∈ P) (hful : ∀ t, t ∈ P → t ∉ P' → ∃ m, M[t]? = some m ∧ m.loc.label = l) :
    BoxTopP E M' P' :=
  fun l' B hB => (h l' B hB).imp fun _ _ ⟨t, ht, hw⟩ => ⟨t, ht, LatestP_growsAt hw hg (hne l' B hB) hsub hful⟩

/-- `BoxInv` across a step that keeps the boxes and their memory: (S8b) the
words latest at a constant coherence (`hT`), and at a box the thread has seen,
at its coherence (`hL`). -/
theorem BoxInv_tr {g : G} {E E' : TEnv} {s s' : St} (h : BoxInv g E s) (hb : E'.box = E.box)
    (hse : ∀ l B, E.box l = some B → E'.seen l → E.seen l) (hs : ∀ l B, E.box l = some B → E'.sto l = E.sto l)
    (hi : ∀ l B, E.box l = some B → E'.ini l = E.ini l) (hna : s.nalloc ≤ s'.nalloc)
    (hT : ∀ l B, E.box l = some B → ∀ o v (t : Ts), LatestP s.mem s.promises (fun _ => t) ⟨l, o⟩ v →
      LatestP s'.mem s'.promises (fun _ => t) ⟨l, o⟩ v)
    (hL : ∀ l B, E.box l = some B → E.seen l → ∀ o v, LatestP s.mem s.promises s.vs.coh ⟨l, o⟩ v →
      LatestP s'.mem s'.promises s'.vs.coh ⟨l, o⟩ v) :
    BoxInv g E' s' := by
  obtain ⟨hf, hT0, hB⟩ := h
  refine ⟨fun j hj => by rw [hb]; exact hf j (Nat.le_trans hna hj), fun l B hl => ?_, fun l B hl => ?_⟩
  · rw [hb] at hl
    exact (hT0 l B hl).imp fun o w ⟨t, ht, hw⟩ => ⟨t, ht, hT l B hl o w t hw⟩
  · rw [hb] at hl
    obtain ⟨h1, h2, h3⟩ := hB l B hl
    exact ⟨by rw [hs l B hl]; exact h1, by rw [hi l B hl]; exact h2, fun hsn =>
      (h3 (hse l B hl hsn)).imp fun o w hw => hL l B hl (hse l B hl hsn) o w hw⟩

theorem BoxInv_eqs {g : G} {E : TEnv} {s s' : St} (h : BoxInv g E s) (e1 : s'.mem = s.mem)
    (e3 : s'.vs.coh = s.vs.coh) (e4 : s'.promises = s.promises) (e5 : s'.nalloc = s.nalloc) : BoxInv g E s' :=
  BoxInv_tr h rfl (fun _ _ _ h => h) (fun _ _ _ => rfl) (fun _ _ _ => rfl) (by rw [e5]; exact Nat.le_refl _)
    (fun _ _ _ _ _ _ hv => by rw [e1, e4]; exact hv) (fun _ _ _ _ _ _ hv => by rw [e1, e3, e4]; exact hv)

/-- A store to a Σ cell keeps `BoxInv`, (T3c-7) whether or not it fulfils
promises. -/
theorem BoxInv_store {g : G} {E : TEnv} {s : St} {a : Address} {c : Cell} {us : List Acc} {ws : List Word}
    {pw : Word} {rel : Bool} (h : BoxInv g E s) (hsto : E.sto a.label = some c) (hpl : PromLt s)
    (hnd : s.promises.Nodup) :
    ∀ s', s' ∈ storeUnits g.k g.arch pw a rel us ws 0 s → BoxInv g E s' := by
  intro s' hs'
  obtain ⟨hg, hsub, hna⟩ := storeUnits_growsF us ws 0 s s' hs'
  obtain ⟨-, -, hful⟩ := storeUnits_promF us ws 0 s s' hpl hs'
  obtain ⟨_, g3⟩ := storeUnits_latP us ws 0 s 0 hpl hnd (Nat.zero_le _) s' hs'
  have hne : ∀ l B, E.box l = some B → l ≠ a.label := fun l B hl he => by
    have h0 := (h.2.2 l B hl).1
    rw [he, hsto] at h0; cases h0
  refine BoxInv_tr h rfl (fun _ _ _ h => h) (fun _ _ _ => rfl) (fun _ _ _ => rfl) (by rw [hna]; exact Nat.le_refl _)
    (fun l B hl o v t hv => LatestP_growsAt hv hg (hne l B hl) hsub (fun t h1 h2 => ?_))
    (fun l B hl _ o v hv => g3 _ v (fun j _ he => ?_) hv)
  · obtain ⟨m, j, w, hm, -, -, hl, -⟩ := hful t h1 h2
    exact ⟨m, hm, by rw [hl]; rfl⟩
  · exact hne l B hl (by have := congrArg Address.label he; simpa [offs] using this)

/-- An allocation at the next fresh label keeps `BoxInv`. -/
theorem BoxInv_alloc {g : G} {E E' : TEnv} {s : St} {r : St × Word} {lbl : AllocLabel} {us : List Acc}
    {ws : List Word} (h : BoxInv g E s) (hlbl : lbl = freshLabel g.lbase g.n g.i s.nalloc)
    (hpl : PromLt s) (hnd : s.promises.Nodup) (hr : r ∈ alloc g.k g.arch lbl us ws s) (hb : E'.box = E.box)
    (hse : E'.seen = E.seen)
    (hs : ∀ l, l ≠ lbl → E'.sto l = E.sto l) (hi : ∀ l, l ≠ lbl → E'.ini l = E.ini l) : BoxInv g E' r.1 := by
  obtain ⟨hg, hsl, hna, _, hful⟩ := alloc_growsP hpl r hr
  obtain ⟨_, l2⟩ := alloc_latP hpl hnd r hr
  have hne : ∀ l B, E.box l = some B → l ≠ lbl := fun l B hl he => by
    rw [he, hlbl, h.1 s.nalloc (Nat.le_refl _)] at hl; cases hl
  exact BoxInv_tr h hb (fun _ _ _ h => by rw [hse] at h; exact h) (fun l B hl => hs l (hne l B hl))
    (fun l B hl => hi l (hne l B hl)) (by rw [hna]; omega)
    (fun l B hl o v t hv => LatestP_growsAt hv hg (hne l B hl) (fun t ht => hsl.subset ht) hful)
    (fun l B hl _ o v hv => l2 ⟨l, o⟩ v (hne l B hl) hv)

/-! ### (P6) Promise bookkeeping -/

/-- (P6) The thread's outstanding promises are distinct and none is a pair
start: what an `rmw` that may fulfil a promise needs. -/
def PromOK (s : St) : Prop :=
  s.promises.Nodup ∧ (∀ t, t ∈ s.promises → t ∉ s.pairs) ∧
    ∀ t, t ∈ s.promises → ∀ p, p ∈ s.pairs → t ≠ p + 1

/-- (S4) No promise is either word of a pair store: what a pair load at an
own cell needs to have an outcome. -/
theorem PromOK_pp {s : St} (h : PromOK s) : ∀ t, t ∈ s.promises → ∀ p, p ∈ s.pairs → t ≠ p ∧ t ≠ p + 1 :=
  fun t ht p hp => ⟨fun e => h.2.1 t ht (by rw [e]; exact hp), h.2.2 t ht p hp⟩

theorem PromOK_eq {s s' : St} (h : PromOK s) (e2 : s'.pairs = s.pairs) (e4 : s'.promises = s.promises) :
    PromOK s' := by
  unfold PromOK at h ⊢; rw [e2, e4]; exact h

/-- `PromOK` across a step that only discharges promises and adds pair starts
past the old memory, hence past every promise. -/
theorem PromOK_tr {s s' : St} (h : PromOK s) (hlt : ∀ t, t ∈ s.promises → t < s.mem.size)
    (hp : s'.promises.Sublist s.promises) (hq : ∀ t, t ∈ s'.pairs → t ∈ s.pairs ∨ s.mem.size ≤ t) :
    PromOK s' := by
  refine ⟨h.1.sublist hp, fun t ht hq' => ?_, fun t ht p hp' e => ?_⟩
  · have ht0 := hp.subset ht
    rcases hq t hq' with h1 | h1
    · exact h.2.1 t ht0 h1
    · exact absurd (hlt t ht0) (Nat.not_lt.2 h1)
  · have ht0 := hp.subset ht
    rcases hq p hp' with h1 | h1
    · exact h.2.2 t ht0 p h1 e
    · have h2 : (t : Nat) < s.mem.size := hlt t ht0
      have h3 : s.mem.size ≤ (p : Nat) := h1
      have h5 : p + 1 < s.mem.size := by rw [← e]; exact h2
      exact Nat.lt_irrefl _ (Nat.lt_of_lt_of_le h5 (Nat.le_trans h3 (Nat.le_succ p)))

/-- (P6) A one-word store keeps its promises or erases one. -/
theorem stepStore_promSubl {k : Promises.Knobs} {arch : Arch} {mem mem' : Memory} {th th' : Promises.Thread}
    {a : Address} {e : WeakMem.Expr} {deps : List WeakMem.Reg} {rel : Bool}
    (h : (mem', th') ∈ Promises.stepStore k arch mem th a e deps rel) :
    th'.promises.Sublist th.promises ∧ mem.size ≤ mem'.size := by
  cases e <;>
  · simp only [Promises.stepStore, List.mem_append, List.mem_singleton, List.mem_filterMap] at h
    rcases h with h | ⟨t, htp, hf⟩
    · simp only [Prod.mk.injEq] at h
      obtain ⟨rfl, rfl⟩ := h
      exact ⟨List.Sublist.refl _, by simp⟩
    · cases hm : mem[t]? with
      | none => simp [hm] at hf
      | some m =>
          simp only [hm] at hf
          split at hf
          · simp only [Option.some.injEq, Prod.mk.injEq] at hf
            obtain ⟨rfl, rfl⟩ := hf
            exact ⟨List.erase_sublist .., Nat.le_refl _⟩
          · simp at hf

/-- (P6) A store only discharges promises and adds pair starts past the old
memory. -/
theorem storeUnits_promOK {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s s' : St), s' ∈ storeUnits k arch pw a rel us ws i s →
      s'.promises.Sublist s.promises ∧ ∀ t, t ∈ s'.pairs → t ∈ s.pairs ∨ s.mem.size ≤ t
  | [], _, _, s, s', hs => by
      simp only [storeUnits, List.mem_singleton] at hs; subst hs
      exact ⟨List.Sublist.refl _, fun _ h => Or.inl h⟩
  | .one :: us, w :: ws, i, s, s', hs => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      obtain ⟨hps, hsz⟩ := stepStore_promSubl hst
      obtain ⟨g1, g2⟩ := storeUnits_promOK us ws (i + 1) _ s' hs
      exact ⟨g1.trans hps, fun t ht => (g2 t ht).elim Or.inl fun h => Or.inr (Nat.le_trans hsz h)⟩
  | .two :: us, w0 :: w1 :: ws, i, s, s', hs => by
      simp only [storeUnits] at hs
      obtain ⟨q1, q2, _, q4, -⟩ := stepStorePair_eq s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel
      generalize Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel = R at q1 q2 q4 hs
      obtain ⟨mem', pairs', th⟩ := R
      simp only at q1 q2 q4 hs
      obtain ⟨g1, g2⟩ := storeUnits_promOK us ws (i + 2) _ s' hs
      have hsz : s.mem.size ≤ mem'.size := by rw [q1, Array.size_push, Array.size_push]; omega
      refine ⟨by have := g1; rw [q4] at this; exact this, fun t ht => ?_⟩
      rcases g2 t ht with h | h
      · have h' : t ∈ s.pairs ++ [s.mem.size] := by rw [← q2]; exact h
        rcases List.mem_append.1 h' with h1 | h1
        · exact Or.inl h1
        · rw [List.mem_singleton] at h1; exact Or.inr (Nat.le_of_eq h1.symm)
      · exact Or.inr (Nat.le_trans hsz h)
  | .one :: _, [], _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [], _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, s', hs => by simp [storeUnits] at hs

/-- (F2′) `vWr` grows, and a promise a step removes lies at or below the new
`vWr` (a fulfil raises `vWr` to its index). -/
def FulW (vs : VState) (P : List Ts) (vs' : VState) (P' : List Ts) : Prop :=
  vs.vWr ≤ vs'.vWr ∧ ∀ t ∈ P, t ∉ P' → t ≤ vs'.vWr

theorem FulW.trans {v1 v2 v3 : VState} {P1 P2 P3 : List Ts} (a : FulW v1 P1 v2 P2)
    (b : FulW v2 P2 v3 P3) : FulW v1 P1 v3 P3 := by
  refine ⟨Nat.le_trans a.1 b.1, fun t h1 h3 => ?_⟩
  by_cases h2 : t ∈ P2
  · exact b.2 t h2 h3
  · exact Nat.le_trans (a.2 t h1 h2) b.1

/-- (F2′) A one-word store: `FulW`. -/
theorem stepStore_fulW {k : Promises.Knobs} {arch : Arch} {mem mem' : Memory} {th th' : Promises.Thread}
    {a : Address} {e : WeakMem.Expr} {deps : List WeakMem.Reg} {rel : Bool}
    (h : (mem', th') ∈ Promises.stepStore k arch mem th a e deps rel) :
    FulW th.vs th.promises th'.vs th'.promises := by
  cases e <;>
  · simp only [Promises.stepStore, List.mem_append, List.mem_singleton, List.mem_filterMap] at h
    rcases h with h | ⟨tw, _, hf⟩
    · simp only [Prod.mk.injEq] at h
      obtain ⟨rfl, rfl⟩ := h
      exact ⟨Nat.le_max_left _ _, fun _ h h' => absurd h h'⟩
    · cases hm : mem[tw]? with
      | none => simp [hm] at hf
      | some pm =>
          simp only [hm] at hf
          split at hf
          · simp only [Option.some.injEq, Prod.mk.injEq] at hf
            obtain ⟨rfl, rfl⟩ := hf
            refine ⟨Nat.le_max_left _ _, fun u hu hu' => ?_⟩
            by_cases e : u = tw
            · subst e; exact Nat.le_max_right _ _
            · exact absurd ((List.mem_erase_of_ne e).2 hu) hu'
          · simp at hf

/-- (F2′) A store: `FulW`. -/
theorem storeUnits_fulW {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s s' : St), s' ∈ storeUnits k arch pw a rel us ws i s →
      FulW s.vs s.promises s'.vs s'.promises
  | [], _, _, s, s', hs => by
      simp only [storeUnits, List.mem_singleton] at hs; subst hs
      exact ⟨Nat.le_refl _, fun _ h h' => absurd h h'⟩
  | .one :: us, w :: ws, i, s, s', hs => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      exact FulW.trans (stepStore_fulW (th := mth s pw w w) hst)
        (storeUnits_fulW us ws (i + 1) _ s' hs)
  | .two :: us, w0 :: w1 :: ws, i, s, s', hs => by
      simp only [storeUnits] at hs
      have h2 : FulW s.vs s.promises
          (Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0)
            (dataE 2 w1) [0] rel).2.2.vs
          (Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0)
            (dataE 2 w1) [0] rel).2.2.promises := by
        simp only [Promises.stepStorePair]
        exact ⟨Nat.le_max_left _ _, fun _ h h' => absurd h h'⟩
      generalize Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0)
        (dataE 2 w1) [0] rel = R at h2 hs
      obtain ⟨mem', pairs', th⟩ := R
      exact FulW.trans h2 (storeUnits_fulW us ws (i + 2) _ s' hs)
  | .one :: _, [], _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [], _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, s', hs => by simp [storeUnits] at hs

/-- (S7b′) A store keeps `OwnPubV`. -/
theorem OwnPubV.store {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool}
    {us : List Acc} {ws : List Word} {i : Nat} {E : TEnv} {s s' : St} (h : OwnPubV E s) (hpl : PromLt s)
    (hs : s' ∈ storeUnits k arch pw a rel us ws i s) : OwnPubV E s' := by
  obtain ⟨hg, hP, -⟩ := storeUnits_growsF us ws i s s' hs
  have hf := storeUnits_fulW us ws i s s' hs
  exact h.mono hf.1 hpl hf.2 (fun u hu => .inl (hP u hu)) hg.2.1

/-- (F2′) An allocation: `FulW`. -/
theorem alloc_fulW {k : Promises.Knobs} {arch : Arch} {lbl : AllocLabel} {us : List Acc} {ws : List Word}
    {s : St} {r : St × Word} (hr : r ∈ alloc k arch lbl us ws s) :
    FulW s.vs s.promises r.1.vs r.1.promises := by
  obtain ⟨s1, hs, -, e4, -, -, -, e7, -⟩ := alloc_unf hr
  exact FulW.trans ⟨by rw [e7]; exact Nat.le_max_left _ _, fun t h h' => absurd (by rw [e4]; exact h) h'⟩
    (storeUnits_fulW us ws 0 s1 r.1 hs)

/-- (S7b′) An allocation keeps `OwnPubV` (at the same environment). -/
theorem OwnPubV.alloc {k : Promises.Knobs} {arch : Arch} {lbl : AllocLabel} {us : List Acc} {ws : List Word}
    {E : TEnv} {s : St} {r : St × Word} (h : OwnPubV E s) (hpl : PromLt s)
    (hr : r ∈ alloc k arch lbl us ws s) : OwnPubV E r.1 := by
  obtain ⟨hg, hsub, -⟩ := alloc_growsP hpl r hr
  have hf := alloc_fulW hr
  exact h.mono hf.1 hpl hf.2 (fun u hu => .inl (hsub.subset hu)) hg.2.1

theorem offs_neW {a : Address} {i j : Nat} (h : i ≠ j) : offs a i ≠ offs a j := by
  intro e
  have := congrArg Address.offset e
  simp [offs] at this
  exact h this

/-- (F2′) `storeUnits` leaves coherence alone off the words it writes. -/
theorem storeUnits_cohOff {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s s' : St), s' ∈ storeUnits k arch pw a rel us ws i s →
      ∀ b, (∀ j, b ≠ offs a (i + j)) → s'.vs.coh b = s.vs.coh b
  | [], _, _, s, s', hs => by
      simp only [storeUnits, List.mem_singleton] at hs; subst hs; intros; rfl
  | .one :: us, w :: ws, i, s, s', hs => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      intro b hb
      rw [storeUnits_cohOff us ws (i + 1) _ s' hs b
        (fun j => by rw [show i + 1 + j = i + (1 + j) by omega]; exact hb _)]
      obtain ⟨t0, -, hc, -, -⟩ := stepStore_casesC hst
      show th.vs.coh b = s.vs.coh b
      rw [hc]
      have h0 : b ≠ offs a i := by simpa using hb 0
      simp [h0, mth]
  | .two :: us, w0 :: w1 :: ws, i, s, s', hs => by
      simp only [storeUnits] at hs
      obtain ⟨-, -, q3, -, -⟩ := TermMem.stepStorePair_eq s.mem s.pairs (mth s pw w0 w1) (offs a i)
        (dataE 1 w0) (dataE 2 w1) [0] rel
      generalize Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0)
        (dataE 2 w1) [0] rel = R at q3 hs
      obtain ⟨mem', pairs', th⟩ := R
      simp only at q3
      intro b hb
      rw [storeUnits_cohOff us ws (i + 2) _ s' hs b
        (fun j => by rw [show i + 2 + j = i + (2 + j) by omega]; exact hb _)]
      show th.vs.coh b = s.vs.coh b
      have h0 : b ≠ offs a i := by simpa using hb 0
      have h1 : b ≠ (offs a i).next := by
        have := hb 1
        have e : (offs a i).next = offs a (i + 1) := by
          simp only [offs, Address.next, Nat.add_assoc]
        rw [e]; exact this
      rw [q3]; simp [h0, h1, mth]
  | .one :: _, [], _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [], _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, s', hs => by simp [storeUnits] at hs

/-- (F2′) **Each word a store writes ends at the index written there**: a new
message (at or above the old size), or one of the thread's promises at it. -/
theorem storeUnits_cohW {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s s' : St), s' ∈ storeUnits k arch pw a rel us ws i s →
      PromLt s → ∀ j, j < nWords us → s.mem.size ≤ s'.vs.coh (offs a (i + j)) ∨
        ∃ u ∈ s.promises, ∃ m, s.mem[u]? = some m ∧ m.loc = offs a (i + j) ∧ s'.vs.coh (offs a (i + j)) = u
  | [], _, _, s, s', hs, _ => by
      intro j hj; simp [nWords] at hj
  | .one :: us, w :: ws, i, s, s', hs, hpl => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      obtain ⟨t0, hcase, hc, -, -⟩ := stepStore_casesC hst
      intro j hj
      rcases j with _ | j
      · rw [storeUnits_cohOff us ws (i + 1) _ s' hs (offs a (i + 0))
          (fun j => offs_neW (by omega))]
        show s.mem.size ≤ th.vs.coh (offs a (i + 0)) ∨ _
        rw [hc]
        simp only [Nat.add_zero, ite_true]
        rcases hcase with ⟨-, rfl, -⟩ | ⟨-, ht, -, -, m, hm, hl, -⟩
        · exact Or.inl (Nat.le_refl _)
        · exact Or.inr ⟨t0, ht, m, hm, hl, rfl⟩
      · have hsz : s.mem.size ≤ mem'.size := by
          rcases hcase with ⟨rfl, -⟩ | ⟨rfl, -⟩
          · simp
          · exact Nat.le_refl _
        have hsub : ∀ u, u ∈ th.promises → u ∈ s.promises := by
          rcases hcase with ⟨-, -, e⟩ | ⟨-, -, e, -⟩
          · intro u hu; rw [e] at hu; exact hu
          · intro u hu; rw [e] at hu; exact List.mem_of_mem_erase hu
        have hold : ∀ u, u < s.mem.size → mem'[u]? = s.mem[u]? := by
          rcases hcase with ⟨rfl, -⟩ | ⟨rfl, -⟩
          · intro u hu; exact push_lt hu
          · intro u _; rfl
        have hpl1 : PromLt { s with mem := mem', vs := th.vs, promises := th.promises } := fun u hu =>
          Nat.lt_of_lt_of_le (hpl u (hsub u hu)) hsz
        have hj' : j < nWords us := by simp [nWords, Acc.size] at hj ⊢; omega
        rcases storeUnits_cohW us ws (i + 1) _ s' hs hpl1 j hj' with h | ⟨u, hu, m, hm, hl, hc'⟩
        · left; rw [show i + (j + 1) = i + 1 + j by omega]; exact Nat.le_trans hsz h
        · right
          refine ⟨u, hsub u hu, m, ?_, by rw [hl, show i + (j + 1) = i + 1 + j by omega],
            by rw [show i + (j + 1) = i + 1 + j by omega]; exact hc'⟩
          have hu0 := hpl u (hsub u hu)
          rw [← hold u hu0]; exact hm
  | .two :: us, w0 :: w1 :: ws, i, s, s', hs, hpl => by
      simp only [storeUnits] at hs
      obtain ⟨q1, -, q3, q4, -⟩ := TermMem.stepStorePair_eq s.mem s.pairs (mth s pw w0 w1) (offs a i)
        (dataE 1 w0) (dataE 2 w1) [0] rel
      generalize Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0)
        (dataE 2 w1) [0] rel = R at q1 q3 q4 hs
      obtain ⟨mem', pairs', th⟩ := R
      simp only at q1 q3 q4
      have hsz : s.mem.size + 2 = mem'.size := by rw [q1]; simp
      have hcoh2 : ∀ j, j < nWords us → ∀ b, b = offs a (i + 2 + j) → b ≠ offs a i ∧ b ≠ offs a (i + 1) :=
        fun j _ b hb => ⟨by rw [hb]; exact offs_neW (by omega), by rw [hb]; exact offs_neW (by omega)⟩
      have hnx : (offs a i).next = offs a (i + 1) := by simp only [offs, Address.next, Nat.add_assoc]
      have hpl1 : PromLt { s with mem := mem', pairs := pairs', vs := th.vs, promises := th.promises } :=
        fun u hu => by
          have hu' : u ∈ s.promises := by have h := hu; rw [q4] at h; exact h
          show u < mem'.size
          exact Nat.lt_of_lt_of_le (hpl u hu') (by rw [← hsz]; exact Nat.le_add_right _ _)
      intro j hj
      by_cases hj2 : j < 2
      · left
        rw [storeUnits_cohOff us ws (i + 2) _ s' hs (offs a (i + j))
          (fun j' => offs_neW (by omega))]
        show s.mem.size ≤ th.vs.coh (offs a (i + j))
        rw [q3]
        rcases (show j = 0 ∨ j = 1 by omega) with rfl | rfl
        · simp
        · simp only [← hnx]
          split
          · exact Nat.le_refl _
          · simp
      · have hj' : j - 2 < nWords us := by simp [nWords, Acc.size] at hj ⊢; omega
        have e : i + j = i + 2 + (j - 2) := by omega
        rcases storeUnits_cohW us ws (i + 2) _ s' hs hpl1 (j - 2) hj' with h | ⟨u, hu, m, hm, hl, hc'⟩
        · left; rw [e]; exact Nat.le_trans (show s.mem.size ≤ mem'.size by omega) h
        · right
          have hu' : u ∈ s.promises := by have h := hu; rw [q4] at h; exact h
          have hu0 := hpl u hu'
          refine ⟨u, hu', m, ?_, by rw [hl, e], by rw [e]; exact hc'⟩
          have hm' : mem'[u]? = some m := hm
          rw [q1, push_lt (Nat.lt_of_lt_of_le hu0 (by rw [Array.size_push]; exact Nat.le_succ _)), push_lt hu0] at hm'
          exact hm'
  | .one :: _, [], _, _, s', hs, _ => by simp [storeUnits] at hs
  | .two :: _, [], _, _, s', hs, _ => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, s', hs, _ => by simp [storeUnits] at hs

/-- (S8b) A store keeps an address's coherence at most `vWr`: each stored
word's coherence is its timestamp, which `vWr` covers. -/
theorem storeUnits_cohWr {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} (b : Address) :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s s' : St), s' ∈ storeUnits k arch pw a rel us ws i s →
      s.vs.coh b ≤ s.vs.vWr → s'.vs.coh b ≤ s'.vs.vWr
  | [], _, _, s, s', hs, h => by
      simp only [storeUnits, List.mem_singleton] at hs; subst hs; exact h
  | .one :: us, w :: ws, i, s, s', hs, h => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      obtain ⟨t, -, hc, -, hwr⟩ := stepStore_casesC hst
      refine storeUnits_cohWr b us ws (i + 1) _ s' hs ?_
      show th.vs.coh b ≤ th.vs.vWr
      rw [hc, hwr]
      dsimp only
      split
      · exact Nat.le_max_right _ _
      · exact Nat.le_trans h (Nat.le_max_left _ _)
  | .two :: us, w0 :: w1 :: ws, i, s, s', hs, h => by
      simp only [storeUnits] at hs
      obtain ⟨-, -, q3, -, -⟩ := stepStorePair_eq s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel
      have q6 := stepStorePair_vWr s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel
      generalize Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel = R at q3 q6 hs
      obtain ⟨mem', pairs', th⟩ := R
      simp only at q3 q6 hs
      refine storeUnits_cohWr b us ws (i + 2) _ s' hs ?_
      show th.vs.coh b ≤ th.vs.vWr
      rw [q3, q6]
      dsimp only
      split
      · exact Nat.le_trans (Nat.le_succ _) (Nat.le_max_right _ _)
      · split
        · exact Nat.le_max_right _ _
        · exact Nat.le_trans h (Nat.le_max_left _ _)
  | .one :: _, [], _, _, _, hs, _ => by simp [storeUnits] at hs
  | .two :: _, [], _, _, _, hs, _ => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, _, hs, _ => by simp [storeUnits] at hs

/-- (F2′ b″) Each word a store writes ends with its coherence at most `vWr`. -/
theorem storeUnits_cohLe {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s s' : St), s' ∈ storeUnits k arch pw a rel us ws i s →
      ∀ j, j < nWords us → s'.vs.coh (offs a (i + j)) ≤ s'.vs.vWr
  | [], _, _, s, s', hs => by
      intro j hj; simp [nWords] at hj
  | .one :: us, w :: ws, i, s, s', hs => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      obtain ⟨t0, -, hc, -, hwr⟩ := stepStore_casesC hst
      intro j hj
      rcases j with _ | j
      · refine storeUnits_cohWr _ us ws (i + 1) _ s' hs ?_
        show th.vs.coh (offs a (i + 0)) ≤ th.vs.vWr
        rw [hc, hwr]
        simp only [Nat.add_zero, ite_true]
        exact Nat.le_max_right _ _
      · have hj' : j < nWords us := by simp [nWords, Acc.size] at hj ⊢; omega
        rw [show i + (j + 1) = i + 1 + j by omega]
        exact storeUnits_cohLe us ws (i + 1) _ s' hs j hj'
  | .two :: us, w0 :: w1 :: ws, i, s, s', hs => by
      simp only [storeUnits] at hs
      obtain ⟨-, -, q3, -, -⟩ := TermMem.stepStorePair_eq s.mem s.pairs (mth s pw w0 w1) (offs a i)
        (dataE 1 w0) (dataE 2 w1) [0] rel
      have q6 := TermMem.stepStorePair_vWr s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0)
        (dataE 2 w1) [0] rel
      generalize Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0)
        (dataE 2 w1) [0] rel = R at q3 q6 hs
      obtain ⟨mem', pairs', th⟩ := R
      simp only at q3 q6
      have hnx : (offs a i).next = offs a (i + 1) := by simp only [offs, Address.next, Nat.add_assoc]
      intro j hj
      by_cases hj2 : j < 2
      · refine storeUnits_cohWr _ us ws (i + 2) _ s' hs ?_
        show th.vs.coh (offs a (i + j)) ≤ th.vs.vWr
        rw [q3, q6]
        rcases (show j = 0 ∨ j = 1 by omega) with rfl | rfl
        · simp only [Nat.add_zero, ite_true]
          exact Nat.le_trans (Nat.le_succ _) (Nat.le_max_right _ _)
        · simp only [← hnx]
          split
          · exact Nat.le_trans (Nat.le_succ _) (Nat.le_max_right _ _)
          · simp; exact Nat.le_max_right _ _
      · have hj' : j - 2 < nWords us := by simp [nWords, Acc.size] at hj ⊢; omega
        rw [show i + j = i + 2 + (j - 2) by omega]
        exact storeUnits_cohLe us ws (i + 2) _ s' hs (j - 2) hj'
  | .one :: _, [], _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [], _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, s', hs => by simp [storeUnits] at hs

theorem PromOK_store {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool}
    {us : List Acc} {ws : List Word} {i : Nat} {s s' : St} (h : PromOK s)
    (hlt : ∀ t, t ∈ s.promises → t < s.mem.size) (hs : s' ∈ storeUnits k arch pw a rel us ws i s) :
    PromOK s' :=
  have hq := storeUnits_promOK us ws i s s' hs
  PromOK_tr h hlt hq.1 hq.2

theorem foldl_push_size {α : Type} (f : Nat → α) :
    ∀ (L : List Nat) (M : Array α), M.size ≤ (L.foldl (fun m j => m.push (f j)) M).size
  | [], M => Nat.le_refl _
  | j :: L, M => by
      simp only [List.foldl]
      exact Nat.le_trans (by simp) (foldl_push_size f L (M.push (f j)))

theorem PromOK_alloc {k : Promises.Knobs} {arch : Arch} {lbl : AllocLabel} {us : List Acc}
    {ws : List Word} {s : St} {r : St × Word} (h : PromOK s)
    (hlt : ∀ t, t ∈ s.promises → t < s.mem.size) (hr : r ∈ alloc k arch lbl us ws s) : PromOK r.1 := by
  simp only [alloc, List.mem_map] at hr
  obtain ⟨s', hs, rfl⟩ := hr
  refine PromOK_store ?_ ?_ hs
  · exact h
  · exact fun t ht => Nat.lt_of_lt_of_le (hlt t ht) (foldl_push_size _ _ _)

/-! ### (F2) Moved up for the frontier form of the owner's invariant -/

theorem readable_get {mem : Memory} {a : Address} {t b : Ts} (h : WeakMem.readable mem a t b = true) :
    ∃ m, mem[t]? = some m ∧ m.loc = a ∧ WeakMem.hiddenFrom mem a t b = false := by
  unfold WeakMem.readable at h
  cases hm : mem[t]? with
  | none => simp [hm] at h
  | some m =>
    simp [hm] at h
    exact ⟨m, rfl, h.1, by simpa using h.2⟩

theorem nWords_take_succ {us : List Acc} {i : Nat} {u : Acc} (h : us[i]? = some u) :
    nWords (us.take (i + 1)) = nWords (us.take i) + u.size := by
  rw [List.take_add_one, h]; simp [nWords]

theorem nWords_take_le (l : List Acc) (k : Nat) : nWords (l.take k) ≤ nWords l := by
  have := congrArg nWords (List.take_append_drop k l)
  rw [nWords_append] at this; omega

theorem TwoAt_lt {us : List Acc} {o : Nat} (h : TwoAt us o) : o + 2 ≤ nWords us := by
  obtain ⟨i, h1, rfl⟩ := h
  have e := nWords_take_succ h1
  have := nWords_take_le us (i + 1)
  simp only [Acc.size] at e; omega

/-- Inside an initialised segment, an offset is initialised. -/
theorem InitR_of_IniSeg {E : TEnv} {c : Cell} {l : AllocLabel} {b o : Nat} {S : Ty} {L : List Acc}
    (hi : IniSeg E c l b) (hseg : SegOf c.ty b S) (hL : accs S = some L) (ho : o < nWords L) :
    InitR E c l (b + o) := by
  intro N e us hT hus
  obtain ⟨us', j, hus', hj, rfl⟩ := hi N e hT
  obtain rfl : us = us' := by rw [hus] at hus'; exact Option.some.inj hus'
  rcases hseg with ⟨-, rfl, -⟩ | ⟨N', us2, j', hT', hus2, -, -⟩
  · rw [hT] at hL; simp [accs] at hL
  · rw [hT] at hT'; simp only [Ty.array.injEq, Idx.lit.injEq] at hT'
    obtain ⟨-, rfl⟩ := hT'
    obtain rfl : us = L := by rw [hus] at hL; exact Option.some.inj hL
    have hm := Nat.mul_le_mul_right (nWords us) (show j + 1 ≤ E.ini l by omega)
    rw [Nat.succ_mul] at hm; omega

/-- (F2′ (a′)) `InitR_of_IniSeg` at the real count. -/
theorem InitRr_of_IniSegN {E : TEnv} {c : Cell} {l : AllocLabel} {b o : Nat} {S : Ty} {L : List Acc}
    (hi : IniSegN (E.rc l) c b) (hseg : SegOf c.ty b S) (hL : accs S = some L) (ho : o < nWords L) :
    InitRr E c l (b + o) := by
  intro N e us hT hus
  obtain ⟨us', j, hus', hj, rfl⟩ := hi N e hT
  obtain rfl : us = us' := by rw [hus] at hus'; exact Option.some.inj hus'
  rcases hseg with ⟨-, rfl, -⟩ | ⟨N', us2, j', hT', hus2, -, -⟩
  · rw [hT] at hL; simp [accs] at hL
  · rw [hT] at hT'; simp only [Ty.array.injEq, Idx.lit.injEq] at hT'
    obtain ⟨-, rfl⟩ := hT'
    obtain rfl : us = L := by rw [hus] at hL; exact Option.some.inj hL
    have hm := Nat.mul_le_mul_right (nWords us) (show j + 1 ≤ E.rc l by omega)
    rw [Nat.succ_mul] at hm; omega

/-! ## (F2, S8a stage 1) The owner's invariant at its cells with a frontier

At an own cell with a frontier (published or planted), another thread may write.
`OwnOKSF` is `OwnOKS` where a message after the coherence point may also be a
*typed* message (`TypedAt`), and where, at a two-word unit, two unhidden
unstraddled messages are the coherence pair or a pair of one value
(`OwnPairF`).  At a private cell (`pfr = none`) it is `OwnOKS` (`OwnOKS_priv`). -/

/-- (F2) A message the owner tolerates past coherence at a cell with a frontier:
a word of the cell. -/
def TypedAt (η : TEnv) (c : Cell) (m : Msg) : Prop := WordOK η c.ty m.loc.offset (mw m)

/-- (F2) `LatestS` where, at a cell with a frontier `fr`, the coherence message and
the later ones may also be typed.  The cell's word `w` is then a ghost: a load
that moves coherence to a typed message keeps the clause. -/
def LatestSF (η : TEnv) (c : Cell) (fr : Option Ts) (mem : Memory) (S : Ts → Prop) (coh : Address → Ts)
    (a : Address) (w : Word) : Prop :=
  (∃ m, mem[coh a]? = some m ∧ m.loc = a ∧
      ((m.val = w.val ∧ ∀ x g, w.val = .loc x g → w.view ≤ m.view) ∨ (fr ≠ none ∧ TypedAt η c m))) ∧
    ¬ S (coh a) ∧ ∀ (t : Ts) (m : Msg), coh a < t → mem[t]? = some m → m.loc = a →
      S t ∨ (fr ≠ none ∧ TypedAt η c m)

/-- (F2) At a two-word unit of own cell `c` (at `l`, words `vals`) with a frontier,
two messages a read at or past coherence may pair (not skipped, no pair store
straddling them) are the coherence pair holding the cell's words, or two words
of one value. -/
def OwnPairF (η : TEnv) (c : Cell) (l : AllocLabel) (vals : List Word) (mem : Memory) (pairs : List Ts)
    (S : Ts → Prop) (coh : Address → Ts) : Prop :=
  ∀ o, TwoAtT c.ty o → InitRr η c l o → ∀ (t0 t1 : Nat) (m0 m1 : Msg), ¬ S t0 → ¬ S t1 →
    mem[t0]? = some m0 → mem[t1]? = some m1 → m0.loc = ⟨l, o⟩ → m1.loc = ⟨l, o + 1⟩ →
    coh ⟨l, o⟩ ≤ t0 → coh ⟨l, o + 1⟩ ≤ t1 → WeakMem.pairStraddles mem pairs ⟨l, o⟩ t0 t1 = false →
    (t0 = coh ⟨l, o⟩ ∧ t1 = coh ⟨l, o + 1⟩ ∧ (∀ v, vals[o]? = some v → WLe1 v (mw m0)) ∧
      (∀ v, vals[o + 1]? = some v → WLe1 v (mw m1))) ∨ PairOK η c.ty o (mw m0) (mw m1)

/-- (F2) **The owner's invariant, frontier form** (R1): `OwnOKS` with `LatestSF`, and
`OwnPairF` at cells with a frontier. -/
def OwnOKSF (η : TEnv) (mem : Memory) (pairs : List Ts) (vs : VState) (S : Ts → Prop) : Prop :=
  ∀ l c, η.sto l = some c → c.owner = some η.tid →
    ∃ vals, CellOK η (η.rc l) c.ty vals ∧
      (∀ o v, vals[o]? = some v → LatestSF η c (η.pfr l) mem S vs.coh ⟨l, o⟩ v) ∧
      (η.pfr l ≠ none → OwnPairF η c l vals mem pairs S vs.coh)

/-- (F2) `OwnOKSF` skipping the timestamps of `P`. -/
abbrev OwnOKPF (η : TEnv) (mem : Memory) (pairs : List Ts) (vs : VState) (P : List Ts) : Prop :=
  OwnOKSF η mem pairs vs (· ∈ P)

/-- (privSlot) **`PrivCoh` from the owner's invariant afterwards**: off the
labels `L`, if every non-promise message at a new uninitialised private unit is
an old non-promise message, the coherence there (a non-promise message,
`LatestSF` at a cell without a frontier) is the old placeholder; at `L` the
clause is given. -/
theorem PrivCoh_postL {E E' : TEnv} {s s' : St} (L : AllocLabel → Prop) (h : PrivCoh E s)
    (hU : ∀ a, PrivU E' a → ¬ L a.label → PrivU E a)
    (hO : OwnOKPF E' s'.mem s'.pairs s'.vs s'.promises)
    (hm : ∀ (t : Nat) (m : Msg), t ∉ s'.promises → s'.mem[t]? = some m → PrivU E' m.loc → ¬ L m.loc.label →
      t ∉ s.promises ∧ s.mem[t]? = some m)
    (hL : ∀ (t : Nat) (m : Msg), t ∉ s'.promises → s'.mem[t]? = some m → PrivU E' m.loc → L m.loc.label →
      t = s'.vs.coh m.loc ∧ m.val = .undef) : PrivCoh E' s' := by
  intro t m ht hmt hu
  by_cases hl : L m.loc.label
  · exact hL t m ht hmt hu hl
  obtain ⟨h1, h2⟩ := hm t m ht hmt hu hl
  obtain ⟨e0, hv⟩ := h t m h1 h2 (hU _ hu hl)
  refine ⟨?_, hv⟩
  have hu0 := hu
  obtain ⟨c, N, e, us, hc, ho, -, hT, hus, -, hlt⟩ := hu0
  obtain ⟨vals, hcell, hlat, -⟩ := hO _ c hc ho
  have hlen : vals.length = N * nWords us := by
    rcases hcell with ⟨hwc, -⟩ | ⟨N', e', us', hT', hus', -, hl, -⟩
    · rw [hT] at hwc; simp [wc, accs] at hwc
    · rw [hT] at hT'; simp only [Ty.array.injEq, Idx.lit.injEq] at hT'; obtain ⟨rfl, rfl⟩ := hT'
      rw [hus] at hus'; cases hus'; exact hl
  obtain ⟨v, hv'⟩ : ∃ v, vals[m.loc.offset]? = some v :=
    ⟨_, List.getElem?_eq_getElem (by rw [hlen]; exact hlt)⟩
  obtain ⟨⟨m0, hm0, hl0, -⟩, hn0, -⟩ := hlat m.loc.offset v hv'
  have hu' : PrivU E' m0.loc := by rw [hl0]; exact hu
  have hl' : ¬ L m0.loc.label := by rw [hl0]; exact hl
  obtain ⟨g1, g2⟩ := hm _ m0 hn0 hm0 hu' hl'
  have e1 := (h _ m0 g1 g2 (hU _ hu' hl')).1
  rw [hl0] at e1
  rw [e0]; exact e1.symm
#print axioms PrivCoh_postL

/-- (privSlot) `PrivCoh_postL` with no exceptional label. -/
theorem PrivCoh_post {E E' : TEnv} {s s' : St} (h : PrivCoh E s) (hU : ∀ a, PrivU E' a → PrivU E a)
    (hO : OwnOKPF E' s'.mem s'.pairs s'.vs s'.promises)
    (hm : ∀ (t : Nat) (m : Msg), t ∉ s'.promises → s'.mem[t]? = some m → PrivU E' m.loc →
      t ∉ s.promises ∧ s.mem[t]? = some m) : PrivCoh E' s' :=
  PrivCoh_postL (fun _ => False) h (fun a h _ => hU a h) hO (fun t m h1 h2 h3 _ => hm t m h1 h2 h3)
    (fun _ _ _ _ _ h => h.elim)
#print axioms PrivCoh_post

/-- (privSlot) `PrivCoh` across a step that grows memory only at `lbl` and
fulfils promises only there; at `lbl` the clause is given. -/
theorem PrivCoh_growsAt {E E' : TEnv} {s s' : St} {lbl : AllocLabel} (h : PrivCoh E s)
    (hU : ∀ a, PrivU E' a → a.label ≠ lbl → PrivU E a)
    (hO : OwnOKPF E' s'.mem s'.pairs s'.vs s'.promises) (hg : GrowsAt s.mem s'.mem lbl)
    (hful : ∀ t, t ∈ s.promises → t ∉ s'.promises → ∃ m, s.mem[t]? = some m ∧ m.loc.label = lbl)
    (hL : ∀ (t : Nat) (m : Msg), t ∉ s'.promises → s'.mem[t]? = some m → PrivU E' m.loc → m.loc.label = lbl →
      t = s'.vs.coh m.loc ∧ m.val = .undef) : PrivCoh E' s' := by
  refine PrivCoh_postL (· = lbl) h hU hO (fun t m ht hm _ hl => ?_) hL
  by_cases hlt : t < s.mem.size
  · rw [hg.2.1 t hlt] at hm
    refine ⟨fun hp => ?_, hm⟩
    obtain ⟨m', hm', e⟩ := hful t hp ht
    rw [hm] at hm'; cases hm'; exact hl e
  · exact absurd (hg.2.2 t m (by omega) hm) hl
#print axioms PrivCoh_growsAt

theorem LatestSF_of_LatestS {η : TEnv} {c : Cell} {fr : Option Ts} {mem : Memory} {S : Ts → Prop}
    {coh : Address → Ts} {a : Address} {w : Word} (h : LatestS mem S coh a w) : LatestSF η c fr mem S coh a w :=
  ⟨h.1.elim fun m hm => ⟨m, hm.1, hm.2.1, Or.inl hm.2.2⟩, h.2.1, fun t m ht hm hl => Or.inl (h.2.2 t m ht hm hl)⟩

theorem LatestSF_none {η : TEnv} {c : Cell} {mem : Memory} {S : Ts → Prop}
    {coh : Address → Ts} {a : Address} {w : Word} (h : LatestSF η c none mem S coh a w) : LatestS mem S coh a w :=
  ⟨h.1.elim fun m hm => ⟨m, hm.1, hm.2.1, hm.2.2.resolve_right (fun h' => h'.1 rfl)⟩, h.2.1,
    fun t m ht hm hl => (h.2.2 t m ht hm hl).resolve_right (fun h' => h'.1 rfl)⟩

/-- An offset of a segment of a cell is a word of the cell's words. -/
theorem CellOK_cover {η : TEnv} {n : Nat} {T S : Ty} {vals : List Word} {b j : Nat} {L : List Acc}
    (hc : CellOK η n T vals) (hseg : SegOf T b S) (hL : accs S = some L) (hj : j < nWords L) :
    b + j < vals.length := by
  rcases hc with ⟨hwc, -⟩ | ⟨N, e, us, hT, hus, -, hlen, -⟩
  · rcases hseg with ⟨rfl, rfl, -⟩ | ⟨N', us', j', hT', -, -, -⟩
    · rw [wc_of_accs hL] at hwc; have := Option.some.inj hwc; omega
    · rw [hT'] at hwc; simp [wc, accs] at hwc
  · rcases hseg with ⟨-, rfl, hA⟩ | ⟨N', us', j', hT', hus', hj', rfl⟩
    · rw [hT] at hA; simp [accs] at hA
    · rw [hT] at hT'; simp only [Ty.array.injEq, Idx.lit.injEq] at hT'
      obtain ⟨rfl, rfl⟩ := hT'
      obtain rfl : us = us' := by rw [hus] at hus'; exact Option.some.inj hus'
      obtain rfl : us = L := by rw [hus] at hL; exact Option.some.inj hL
      have hm := Nat.mul_le_mul_right (nWords us) (show j' + 1 ≤ N by omega)
      rw [Nat.succ_mul] at hm; omega

/-- An initialised segment of a cell's words is a value of the segment's type. -/
theorem CellOK_seg {η : TEnv} {n : Nat} {T S : Ty} {vals : List Word} {b : Nat} {L : List Acc}
    (hc : CellOK η n T vals) (hseg : SegOf T b S) (hL : accs S = some L)
    (hi : ∀ N e, T = .array (.lit N) e → ∃ us j, accs e = some us ∧ j < n ∧ b = j * nWords us) :
    ValOfS η S ((vals.drop b).take (nWords L)) ∧ b + nWords L ≤ vals.length := by
  rcases hc with ⟨hwc, hval⟩ | ⟨N, e, us, hT, hus, hn, hlen, hsl⟩
  · rcases hseg with ⟨rfl, rfl, -⟩ | ⟨N', us', j', hT', -, -, -⟩
    · rw [wc_of_accs hL] at hwc
      have hl := Option.some.inj hwc
      have e : (vals.drop 0).take (nWords L) = vals := by rw [List.drop_zero, hl, List.take_length]
      rw [e]
      exact ⟨⟨hval, fun us h => by rw [hL] at h; cases h; exact hl.symm⟩, by omega⟩
    · rw [hT'] at hwc; simp [wc, accs] at hwc
  · rcases hseg with ⟨-, rfl, hA⟩ | ⟨N', us', j', hT', hus', hj', rfl⟩
    · rw [hT] at hA; simp [accs] at hA
    · rw [hT] at hT'; simp only [Ty.array.injEq, Idx.lit.injEq] at hT'
      obtain ⟨rfl, rfl⟩ := hT'
      obtain rfl : us = us' := by rw [hus] at hus'; exact Option.some.inj hus'
      obtain rfl : us = L := by rw [hus] at hL; exact Option.some.inj hL
      obtain ⟨us2, j, hus2, hj, hb⟩ := hi N e hT
      obtain rfl : us = us2 := by rw [hus] at hus2; exact Option.some.inj hus2
      have hm := Nat.mul_le_mul_right (nWords us) (show j + 1 ≤ N by omega)
      rw [Nat.succ_mul] at hm
      have hle : j' * nWords us + nWords us ≤ vals.length := by rw [hb, hlen]; omega
      refine ⟨⟨by rw [hb]; exact hsl j hj, fun us' h => ?_⟩, hle⟩
      rw [hus] at h; cases h
      simp only [List.length_take, List.length_drop]; omega

/-- A message not hidden below `V`, with a message at `tc ≤ V` to its address, is at or past `tc`. -/
theorem le_of_unhidden {mem : Memory} {a : Address} {t V tc : Ts} {mc : Msg}
    (hh : WeakMem.hiddenFrom mem a t V = false) (hV : tc ≤ V) (hm : mem[tc]? = some mc) (hl : mc.loc = a) :
    tc ≤ t := by
  refine Nat.le_of_not_lt fun hlt => ?_
  have hT : WeakMem.hiddenFrom mem a t V = true := by
    unfold WeakMem.hiddenFrom; rw [List.any_eq_true]
    exact ⟨tc, List.mem_range.2 (Nat.lt_succ_of_le hV), by simp [hlt, hm, hl]⟩
  rw [hh] at hT; cases hT

/-- (F2) **What the owner reads at an own word**, frontier form: a message not
skipped, not hidden below a bound past coherence, is the coherence message
(holding the cell's word) or, at a cell with a frontier, a typed message past it. -/
theorem OwnOKSF_read1 {η : TEnv} {mem : Memory} {vs : VState} {S : Ts → Prop}
    {l : AllocLabel} {c : Cell} {o t V : Ts} {v : Word} {m : Msg}
    (hlat : LatestSF η c (η.pfr l) mem S vs.coh ⟨l, o⟩ v) (hnS : ¬ S t) (hm : mem[t]? = some m)
    (hloc : m.loc = ⟨l, o⟩) (hh : WeakMem.hiddenFrom mem ⟨l, o⟩ t V = false) (hV : vs.coh ⟨l, o⟩ ≤ V) :
    (t = vs.coh ⟨l, o⟩ ∧ WLe1 v (mw m)) ∨ (η.pfr l ≠ none ∧ WordOK η c.ty o (mw m)) := by
  obtain ⟨⟨mc, hmc, hmcl, hmcw⟩, -, hlater⟩ := hlat
  have hge := le_of_unhidden hh hV hmc hmcl
  rcases Nat.lt_or_eq_of_le hge with hlt | heq
  · rcases hlater t m hlt hm hloc with hs | ⟨hf, hty⟩
    · exact absurd hs hnS
    · unfold TypedAt at hty; rw [hloc] at hty; exact Or.inr ⟨hf, hty⟩
  · subst heq
    rw [hm] at hmc; cases hmc
    rcases hmcw with ⟨hmcv, hmcw⟩ | ⟨hf, hty⟩
    · exact Or.inl ⟨rfl, hmcv.symm, fun x g hx => hmcw x g hx⟩
    · unfold TypedAt at hty; rw [hloc] at hty; exact Or.inr ⟨hf, hty⟩

/-- (F2) **An own word read past coherence is a word of the cell**: the
coherence message is the cell's word (`CellOK`), a later one is typed. -/
theorem OwnOKSF_word {η : TEnv} {mem : Memory} {pairs : List Ts} {vs : VState} {S : Ts → Prop}
    {l : AllocLabel} {c : Cell} {b j t V : Nat} {S' : Ty} {L : List Acc} {m : Msg}
    (h : OwnOKSF η mem pairs vs S) (hsto : η.sto l = some c) (hown : c.owner = some η.tid)
    (hseg : SegOf c.ty b S') (hL : accs S' = some L) (hi : IniSegN (η.rc l) c b) (hj : j < nWords L)
    (hnS : ¬ S t) (hm : mem[t]? = some m) (hloc : m.loc = ⟨l, b + j⟩)
    (hh : WeakMem.hiddenFrom mem ⟨l, b + j⟩ t V = false) (hV : vs.coh ⟨l, b + j⟩ ≤ V) :
    WordOK η c.ty (b + j) (mw m) := by
  obtain ⟨vals, hc, hlat, -⟩ := h l c hsto hown
  obtain ⟨hvs, hle⟩ := CellOK_seg hc hseg hL hi
  have hjv : b + j < vals.length := by omega
  rcases OwnOKSF_read1 (hlat (b + j) _ (List.getElem?_eq_getElem hjv)) hnS hm hloc hh hV with
    ⟨-, hw⟩ | ⟨-, hw⟩
  · refine ⟨b, S', (vals.drop b).take (nWords L), j, vals[b + j], hseg, hvs, ?_, hw, rfl⟩
    rw [List.getElem?_take_of_lt hj, List.getElem?_drop, List.getElem?_eq_getElem hjv]
  · exact hw

/-- (F2) **Two own words read past coherence, not straddled, are a pair of the
cell** (the coherence pair is a pair of the cell's words). -/
theorem OwnOKSF_pair {η : TEnv} {mem : Memory} {pairs : List Ts} {vs : VState} {S : Ts → Prop}
    {l : AllocLabel} {c : Cell} {b j t0 t1 V0 V1 : Nat} {S' : Ty} {L : List Acc} {m0 m1 : Msg}
    (h : OwnOKSF η mem pairs vs S) (hsto : η.sto l = some c) (hown : c.owner = some η.tid)
    (hf : η.pfr l ≠ none)
    (hseg : SegOf c.ty b S') (hL : accs S' = some L) (hi : IniSegN (η.rc l) c b) (htw : TwoAt L j)
    (hnS0 : ¬ S t0) (hnS1 : ¬ S t1) (hm0 : mem[t0]? = some m0) (hm1 : mem[t1]? = some m1)
    (hl0 : m0.loc = ⟨l, b + j⟩) (hl1 : m1.loc = ⟨l, b + j + 1⟩)
    (hh0 : WeakMem.hiddenFrom mem ⟨l, b + j⟩ t0 V0 = false) (hV0 : vs.coh ⟨l, b + j⟩ ≤ V0)
    (hh1 : WeakMem.hiddenFrom mem ⟨l, b + j + 1⟩ t1 V1 = false) (hV1 : vs.coh ⟨l, b + j + 1⟩ ≤ V1)
    (hst : WeakMem.pairStraddles mem pairs ⟨l, b + j⟩ t0 t1 = false) :
    PairOK η c.ty (b + j) (mw m0) (mw m1) := by
  obtain ⟨vals, hc, hlat, hpf⟩ := h l c hsto hown
  obtain ⟨hvs, hle⟩ := CellOK_seg hc hseg hL hi
  have h2 := TwoAt_lt htw
  have hjv : b + j + 1 < vals.length := by omega
  obtain ⟨⟨mc0, hmc0, hmcl0, -⟩, -, -⟩ := hlat (b + j) _ (List.getElem?_eq_getElem (by omega : b + j < vals.length))
  obtain ⟨⟨mc1, hmc1, hmcl1, -⟩, -, -⟩ := hlat (b + j + 1) _ (List.getElem?_eq_getElem hjv)
  rcases hpf hf (b + j) ⟨b, S', L, j, hseg, hL, htw, rfl⟩ (InitRr_of_IniSegN hi hseg hL (by omega))
      t0 t1 m0 m1 hnS0 hnS1 hm0 hm1 hl0 hl1 (le_of_unhidden hh0 hV0 hmc0 hmcl0)
      (le_of_unhidden hh1 hV1 hmc1 hmcl1) hst with ⟨-, -, hw0, hw1⟩ | hp
  · refine ⟨b, S', (vals.drop b).take (nWords L), j, vals[b + j], vals[b + j + 1], hseg, hvs, ?_, ?_,
      hw0 _ (List.getElem?_eq_getElem _), hw1 _ (List.getElem?_eq_getElem hjv), rfl⟩
    · rw [List.getElem?_take_of_lt (by omega), List.getElem?_drop, List.getElem?_eq_getElem]
    · rw [List.getElem?_take_of_lt (by omega), List.getElem?_drop, ← Nat.add_assoc,
        List.getElem?_eq_getElem hjv]
  · exact hp

/-- (F2) A private cell keeps the old form. -/
theorem OwnOKS_priv {η : TEnv} {mem : Memory} {pairs : List Ts} {vs : VState} {S : Ts → Prop}
    {l : AllocLabel} {c : Cell} (h : OwnOKSF η mem pairs vs S) (hc : η.sto l = some c)
    (ho : c.owner = some η.tid) (hp : η.pfr l = none) :
    ∃ vals, CellOK η (η.rc l) c.ty vals ∧ ∀ o v, vals[o]? = some v → LatestS mem S vs.coh ⟨l, o⟩ v := by
  obtain ⟨vals, h1, h2, -⟩ := h l c hc ho
  exact ⟨vals, h1, fun o v hv => LatestSF_none (by have := h2 o v hv; rw [hp] at this; exact this)⟩

/-- (F2) `OwnOKS` gives `OwnOKSF`: past coherence only skipped messages, so a
pair read past coherence is the coherence pair. -/
theorem OwnOKSF_of_OwnOKS {η : TEnv} {mem : Memory} {pairs : List Ts} {vs : VState} {S : Ts → Prop}
    (h : OwnOKS η mem vs S) : OwnOKSF η mem pairs vs S := by
  intro l c hc ho
  obtain ⟨vals, h1, h2⟩ := h l c hc ho
  refine ⟨vals, h1, fun o v hv => LatestSF_of_LatestS (h2 o v hv), fun _ o htw _ t0 t1 m0 m1 hs0 hs1 hm0 hm1
    hl0 hl1 hc0 hc1 _ => Or.inl ?_⟩
  obtain ⟨b, S', L, o', hseg, hL, htw', rfl⟩ := htw
  have hlt := TwoAt_lt htw'
  have hv0 := CellOK_cover h1 hseg hL (show o' < nWords L by omega)
  have hv1 : b + o' + 1 < vals.length := by
    have := CellOK_cover h1 hseg hL (show o' + 1 < nWords L by omega); omega
  have k0 := h2 _ _ (List.getElem?_eq_getElem hv0)
  have k1 := h2 _ _ (List.getElem?_eq_getElem hv1)
  have e0 : t0 = vs.coh ⟨l, b + o'⟩ := by
    rcases Nat.lt_or_eq_of_le hc0 with hlt' | he
    · exact absurd (k0.2.2 t0 m0 hlt' hm0 hl0) hs0
    · exact he.symm
  have e1 : t1 = vs.coh ⟨l, b + o' + 1⟩ := by
    rcases Nat.lt_or_eq_of_le hc1 with hlt' | he
    · exact absurd (k1.2.2 t1 m1 hlt' hm1 hl1) hs1
    · exact he.symm
  obtain ⟨mc0, hmc0, -, hv0', hw0'⟩ := k0.1
  obtain ⟨mc1, hmc1, -, hv1', hw1'⟩ := k1.1
  rw [← e0, hm0] at hmc0; cases hmc0
  rw [← e1, hm1] at hmc1; cases hmc1
  refine ⟨e0, e1, fun v hv => ?_, fun v hv => ?_⟩
  · rw [List.getElem?_eq_getElem hv0] at hv; cases hv; exact ⟨hv0'.symm, hw0'⟩
  · rw [List.getElem?_eq_getElem hv1] at hv; cases hv; exact ⟨hv1'.symm, hw1'⟩

/-! ### (F2) Coherence moves at the owner's cells -/

/-- (F2) **`OwnOKSF` survives raising coherence to a message not skipped**: past the
old coherence point it was skipped or typed, so it is typed (at a private cell,
where it would be skipped, coherence cannot move).  The cell's words stay. -/
theorem OwnOKSF_coh {η : TEnv} {mem : Memory} {pairs : List Ts} {vs vs' : VState} {S : Ts → Prop}
    (h : OwnOKSF η mem pairs vs S) (hmono : ∀ b, vs.coh b ≤ vs'.coh b)
    (hmsg : ∀ b, vs.coh b < vs'.coh b → ∃ m, mem[vs'.coh b]? = some m ∧ m.loc = b)
    (hS : ∀ b, vs.coh b < vs'.coh b → ¬ S (vs'.coh b)) : OwnOKSF η mem pairs vs' S := by
  intro l c hc ho
  obtain ⟨vals, h1, h2, h3⟩ := h l c hc ho
  refine ⟨vals, h1, fun o v hv => ?_, fun hf o htw hin t0 t1 m0 m1 hs0 hs1 hm0 hm1 hl0 hl1 hc0 hc1 hst => ?_⟩
  · have old := h2 o v hv
    by_cases he : vs'.coh ⟨l, o⟩ = vs.coh ⟨l, o⟩
    · unfold LatestSF at old ⊢; rw [he]; exact old
    · have hlt : vs.coh ⟨l, o⟩ < vs'.coh ⟨l, o⟩ := Nat.lt_of_le_of_ne (hmono _) (Ne.symm he)
      obtain ⟨m', hm', hl'⟩ := hmsg _ hlt
      have hns := hS _ hlt
      refine ⟨⟨m', hm', hl', Or.inr ?_⟩, hns, fun t m ht hm hl => old.2.2 t m (Nat.lt_trans hlt ht) hm hl⟩
      rcases old.2.2 _ m' hlt hm' hl' with hs | hty
      · exact absurd hs hns
      · exact hty
  · rcases h3 hf o htw hin t0 t1 m0 m1 hs0 hs1 hm0 hm1 hl0 hl1 (Nat.le_trans (hmono _) hc0)
        (Nat.le_trans (hmono _) hc1) hst with ⟨e0, e1, w0, w1⟩ | hp
    · have k0 := hmono ⟨l, o⟩
      have k1 := hmono ⟨l, o + 1⟩
      exact Or.inl ⟨Nat.le_antisymm (by rw [e0]; exact k0) hc0, Nat.le_antisymm (by rw [e1]; exact k1) hc1,
        w0, w1⟩
    · exact Or.inr hp

/-- (F2) A load raises coherence only to messages at the address. -/
theorem loadUnits_cohMsg {arch : Arch} {pw : Word} {a : Address} {acq : Bool} :
    ∀ (us : List Acc) (k : Nat) (s : St) (r : St × List Word), r ∈ loadUnits arch pw a acq us k s →
      ∀ b, r.1.vs.coh b = s.vs.coh b ∨ ∃ m, s.mem[r.1.vs.coh b]? = some m ∧ m.loc = b
  | [], _, s, r, hr => by
      simp only [loadUnits, List.mem_singleton] at hr; subst hr; exact fun _ => Or.inl rfl
  | .one :: us, k, s, r, hr => by
      simp only [loadUnits, List.mem_flatMap, List.mem_map] at hr
      obtain ⟨th, hth, ⟨s', ws⟩, hmem, rfl⟩ := hr
      have ih := loadUnits_cohMsg us (k + 1) _ (s', ws) hmem
      simp only [Promises.stepLoad, List.mem_map, List.mem_filter, List.mem_range] at hth
      obtain ⟨t, ⟨_, hrd⟩, rfl⟩ := hth
      obtain ⟨m, hm, hloc, -⟩ := readable_get hrd
      intro b
      simp only at ih ⊢
      rcases ih b with h | h
      · rw [h]
        split
        · rename_i hb; subst hb
          show max (s.vs.coh (offs a k)) t = s.vs.coh (offs a k) ∨
            ∃ m, s.mem[max (s.vs.coh (offs a k)) t]? = some m ∧ m.loc = offs a k
          by_cases hle : t ≤ s.vs.coh (offs a k)
          · exact Or.inl (Nat.max_eq_left hle)
          · exact Or.inr ⟨m, by rw [Nat.max_eq_right (Nat.le_of_lt (Nat.lt_of_not_le hle))]; exact hm, hloc⟩
        · exact Or.inl rfl
      · exact Or.inr h
  | .two :: us, k, s, r, hr => by
      simp only [loadUnits, List.mem_flatMap, List.mem_map] at hr
      obtain ⟨th, hth, ⟨s', ws⟩, hmem, rfl⟩ := hr
      have ih := loadUnits_cohMsg us (k + 2) _ (s', ws) hmem
      simp only [Promises.stepLoadPair, List.mem_flatMap, List.mem_filterMap, List.mem_filter,
        List.mem_range] at hth
      obtain ⟨t0, ⟨_, hr0⟩, t1, ⟨_, hr1⟩, hs⟩ := hth
      split at hs
      · exact absurd hs (by simp)
      · simp only [Option.some.injEq] at hs
        subst hs
        obtain ⟨m0, hm0, hl0, -⟩ := readable_get hr0
        obtain ⟨m1, hm1, hl1, -⟩ := readable_get hr1
        intro b
        simp only at ih ⊢
        rcases ih b with h | h
        · rw [h]
          split
          · rename_i hb; subst hb
            show max (s.vs.coh (offs a k)) t0 = s.vs.coh (offs a k) ∨
              ∃ m, s.mem[max (s.vs.coh (offs a k)) t0]? = some m ∧ m.loc = offs a k
            by_cases hle : t0 ≤ s.vs.coh (offs a k)
            · exact Or.inl (Nat.max_eq_left hle)
            · exact Or.inr ⟨m0, by rw [Nat.max_eq_right (Nat.le_of_lt (Nat.lt_of_not_le hle))]; exact hm0, hl0⟩
          · split
            · rename_i _ hb; subst hb
              show max (s.vs.coh (offs a k).next) t1 = s.vs.coh (offs a k).next ∨
                ∃ m, s.mem[max (s.vs.coh (offs a k).next) t1]? = some m ∧ m.loc = (offs a k).next
              by_cases hle : t1 ≤ s.vs.coh (offs a k).next
              · exact Or.inl (Nat.max_eq_left hle)
              · exact Or.inr ⟨m1, by rw [Nat.max_eq_right (Nat.le_of_lt (Nat.lt_of_not_le hle))]; exact hm1, hl1⟩
            · exact Or.inl rfl
        · exact Or.inr h

/-- (F2) **A load keeps `OwnOKPF`** (with `PromAbove` after it): coherence rises to
messages that are not own promises.  At a private cell this is `ownLoad`'s
"coherence unmoved"; at a cell with a frontier it may move to a typed message. -/
theorem OwnOKPF_load {arch : Arch} {pw : Word} {a : Address} {acq : Bool} {us : List Acc} {η : TEnv}
    {s : St} {r : St × List Word} (hr : r ∈ loadUnits arch pw a acq us 0 s) (hpa : PromAbove r.1)
    (h : OwnOKPF η s.mem s.pairs s.vs s.promises) : OwnOKPF η s.mem s.pairs r.1.vs s.promises := by
  obtain ⟨f1, -, f3, -⟩ := loadUnits_frame us 0 s r hr
  have hmono := loadUnits_cohMono us 0 s r hr
  have hmsg : ∀ b, s.vs.coh b < r.1.vs.coh b → ∃ m, s.mem[r.1.vs.coh b]? = some m ∧ m.loc = b := fun b hb =>
    (loadUnits_cohMsg us 0 s r hr b).resolve_left (Nat.ne_of_gt hb)
  refine OwnOKSF_coh h hmono hmsg fun b hb hp => ?_
  obtain ⟨m, hm, hl⟩ := hmsg b hb
  have := hpa _ (by rw [f3]; exact hp) m (by rw [f1]; exact hm)
  rw [hl] at this; exact Nat.lt_irrefl _ this

/-- A load moves coherence only at its own label. -/
theorem loadUnits_cohF {arch : Arch} {pw : Word} {a : Address} {acq : Bool} :
    ∀ (us : List Acc) (k : Nat) (s : St) (r : St × List Word), r ∈ loadUnits arch pw a acq us k s →
      ∀ b, b.label ≠ a.label → r.1.vs.coh b = s.vs.coh b
  | [], _, s, r, hr, b, _ => by
      simp only [loadUnits, List.mem_singleton] at hr; subst hr; rfl
  | .one :: us, k, s, r, hr, b, hb => by
      simp only [loadUnits, List.mem_flatMap, List.mem_map] at hr
      obtain ⟨th, hth, ⟨s', ws⟩, hmem, rfl⟩ := hr
      rw [loadUnits_cohF us (k + 1) _ (s', ws) hmem b hb]
      simp only [Promises.stepLoad, List.mem_map, List.mem_filter, List.mem_range] at hth
      obtain ⟨t, _, rfl⟩ := hth
      have hne : b ≠ offs a k := fun h => hb (by subst h; rfl)
      simp [hne, mth]
  | .two :: us, k, s, r, hr, b, hb => by
      simp only [loadUnits, List.mem_flatMap, List.mem_map] at hr
      obtain ⟨th, hth, ⟨s', ws⟩, hmem, rfl⟩ := hr
      rw [loadUnits_cohF us (k + 2) _ (s', ws) hmem b hb]
      simp only [Promises.stepLoadPair, List.mem_flatMap, List.mem_filterMap, List.mem_filter,
        List.mem_range] at hth
      obtain ⟨t0, _, t1, _, hs⟩ := hth
      split at hs
      · exact absurd hs (by simp)
      · simp only [Option.some.injEq] at hs
        subst hs
        have hne : b ≠ offs a k := fun h => hb (by subst h; rfl)
        have hne' : b ≠ (offs a k).next := fun h => hb (by subst h; rfl)
        simp [hne, hne', mth]

/-- (F2) `OwnOKSF` reads coherence only at the owner's cells. -/
theorem OwnOKSF_congr {η : TEnv} {mem : Memory} {pairs : List Ts} {vs vs' : VState} {S : Ts → Prop}
    (h : OwnOKSF η mem pairs vs S)
    (he : ∀ l c, η.sto l = some c → c.owner = some η.tid → ∀ o, vs'.coh ⟨l, o⟩ = vs.coh ⟨l, o⟩) :
    OwnOKSF η mem pairs vs' S := by
  intro l c hc ho
  obtain ⟨vals, h1, h2, h3⟩ := h l c hc ho
  refine ⟨vals, h1, fun o v hv => ?_, fun hf => ?_⟩
  · unfold LatestSF; rw [he l c hc ho o]; exact h2 o v hv
  · unfold OwnPairF; simp only [he l c hc ho]; exact h3 hf

/-- (F2) **What a load does to coherence**, as `MemInv` needs it: the owner's
invariant holds at the new coherence (`OwnOKPF_load`), and coherence is unmoved
off Σ, (S8b) except at a box the thread has not seen (a reader's coherence there
may rise to the box's words), and only rises. -/
def LoadCoh (E : TEnv) (s s' : St) : Prop :=
  OwnOKPF E s.mem s.pairs s'.vs s.promises ∧
    (∀ b : Address, E.sto b.label = none → (E.box b.label = none ∨ E.seen b.label) → s'.vs.coh b = s.vs.coh b) ∧
    ∀ b, s.vs.coh b ≤ s'.vs.coh b

theorem LoadCoh_of_eq {E : TEnv} {s s' : St} (h : OwnOKPF E s.mem s.pairs s.vs s.promises)
    (e : s'.vs.coh = s.vs.coh) : LoadCoh E s s' :=
  ⟨OwnOKSF_congr h (fun _ _ _ _ o => by rw [e]), fun b _ _ => by rw [e], fun b => by rw [e]; exact Nat.le_refl _⟩

theorem LoadCoh_load {arch : Arch} {pw : Word} {a : Address} {acq : Bool} {us : List Acc} {E : TEnv}
    {s : St} {r : St × List Word} (hr : r ∈ loadUnits arch pw a acq us 0 s) (hpa : PromAbove r.1)
    (h : OwnOKPF E s.mem s.pairs s.vs s.promises) (hl : ∃ c, E.sto a.label = some c) : LoadCoh E s r.1 :=
  ⟨OwnOKPF_load hr hpa h, fun b hb _ => loadUnits_cohF us 0 s r hr b (fun e => by
    obtain ⟨c, hc⟩ := hl; rw [e] at hb; rw [hb] at hc; cases hc), loadUnits_cohMono us 0 s r hr⟩

/-- (S8b) **What a read of the box at `l` does to coherence**: unmoved if the
thread has seen the box, unmoved off `l`, and only raised. -/
def CohRd (E : TEnv) (l : AllocLabel) (s s' : St) : Prop :=
  (E.seen l → s'.vs.coh = s.vs.coh) ∧ (∀ b : Address, b.label ≠ l → s'.vs.coh b = s.vs.coh b) ∧
    ∀ b, s.vs.coh b ≤ s'.vs.coh b

theorem CohRd_of_eq {E : TEnv} {l : AllocLabel} {s s' : St} (e : s'.vs.coh = s.vs.coh) : CohRd E l s s' :=
  ⟨fun _ => e, fun b _ => by rw [e], fun b => by rw [e]; exact Nat.le_refl _⟩

/-- (S8b) A read of a box (outside Σ) gives `LoadCoh`. -/
theorem LoadCoh_rd {E : TEnv} {s s' : St} {l : AllocLabel} {B : Box} (h : OwnOKPF E s.mem s.pairs s.vs s.promises)
    (hsto : E.sto l = none) (hB : E.box l = some B) (hc : CohRd E l s s') : LoadCoh E s s' := by
  refine ⟨OwnOKSF_congr h (fun l' c hc' _ o => hc.2.1 ⟨l', o⟩ (fun e => by
    rw [show l' = l from e, hsto] at hc'; cases hc')), fun b _ hbx => ?_, hc.2.2⟩
  by_cases e : b.label = l
  · rcases hbx with hn | hsn
    · rw [e, hB] at hn; cases hn
    · rw [hc.1 (by rw [← e]; exact hsn)]
  · exact hc.2.1 b e

/-- **The memory side of a thread's invariant.** -/
def MemInv (g : G) (E : TEnv) (s : St) : Prop :=
  MemOKP E s.mem s.pairs s.promises ∧ OwnOKPF E s.mem s.pairs s.vs s.promises ∧ PromLt s ∧ FreshLP g E s ∧
    SeenLE E s.vs.vRelSt ∧ OwnHidP E s.mem s.vs s.promises ∧ PubDefP E s.mem s.promises ∧ OwnPubV E s ∧
    PubInv E s ∧ BoxInv g E s ∧ PromOK s


/-- **A thread's invariant against memory.** -/
def ThInvM (p : Prog) (g : G) (mem : Memory) (pairs : List Ts) (th : TTh) : Prop :=
  ∃ E, ThInvE p E th ∧ MemInv g E (stOf mem pairs th) ∧ g.boxFence = true

/-- (S6) The labels a step from `n` allocations to `n'` takes: the thread's
fresh labels `freshLabel … j`, `n ≤ j < n'`. -/
def FreshIn (g : G) (n n' : Nat) (l : AllocLabel) : Prop :=
  ∃ j, n ≤ j ∧ j < n' ∧ l = freshLabel g.lbase g.n g.i j

/-- (S6) `l` is one of the thread's own cells in `E`. -/
def OwnAt (E : TEnv) (l : AllocLabel) : Prop :=
  ∃ c, E.sto l = some c ∧ c.owner = some E.tid

/-- (F2′ step 3, RiniLe) A max-raise at one label keeps `rini ≤ ini`. -/
theorem rini_ite_max {ri i : AllocLabel → Nat} {l0 : AllocLabel} {m : Nat} (h : ∀ l, ri l ≤ i l)
    (l : AllocLabel) : (if l = l0 then max (ri l) m else ri l) ≤ (if l = l0 then max (i l) m else i l) := by
  split
  · exact Nat.max_le.2 ⟨Nat.le_trans (h l) (Nat.le_max_left _ _), Nat.le_max_right _ _⟩
  · exact h l

/-- The autoParam of the footprints' `rini ≤ ini` transport. -/
macro "rini_ini" : tactic =>
  `(tactic| first
    | exact fun h => h
    | exact fun h => rini_ite_max h
    | (intro h l; exact h l))

set_option hygiene false in
/-- (A1, rini) The autoParam of the footprints' `rini` locality. -/
macro "rini_eq" : tactic =>
  `(tactic| first
    | exact fun _ => .inl rfl
    | assumption
    | exact fun l => if h : l = _ then .inr h else .inl (bumpIni_other _ _ _ _ h))

/-- (F2′ b″) **Where a raised real count's new units were written**: every unit
`o` of buffer `l` that `rini` newly counts (from `E` to `E'`) carries, at state
`s'`, a write at an index `τ ≤ v` that is a new message (at or above `s`'s size)
or one of the thread's promises at `s` at that unit. -/
def RiniW (E E' : TEnv) (s : St) (v : Nat) : Prop :=
  ∀ l c, E.sto l = some c → ∀ N e us, c.ty = .array (.lit N) e → accs e = some us →
    ∀ o, E.rini l * nWords us ≤ o → o < E'.rini l * nWords us →
      ∃ τ, τ ≤ v ∧ (s.mem.size ≤ τ ∨ (τ ∈ s.promises ∧ ∃ m, s.mem[τ]? = some m ∧ m.loc = ⟨l, o⟩))

theorem RiniW_of_ne {E E' : TEnv} {s : St} {v : Nat}
    (h : ∀ l c, E.sto l = some c → E'.rini l = E.rini l) : RiniW E E' s v := by
  intro l c hc N e us _ _ o h1 h2
  rw [h l c hc] at h2
  exact absurd (Nat.lt_of_le_of_lt h1 h2) (Nat.lt_irrefl _)

theorem RiniW_of_eq {E E' : TEnv} {s : St} {v : Nat} (h : E'.rini = E.rini) : RiniW E E' s v :=
  RiniW_of_ne fun l _ _ => by rw [h]

/-- The autoParam of the footprints' `RiniW` (the real count unchanged). -/
macro "riniW_tac" : tactic =>
  `(tactic| first
    | exact RiniW_of_eq rfl
    | exact RiniW_of_ne (fun _ _ _ => rfl))

/-- (UndefNew) An `undef` message at address `a`. -/
def UndefU (mem : Memory) (a : Address) : Prop :=
  ∃ (t : Nat) (m : Msg), mem[t]? = some m ∧ m.loc = a ∧ m.val = .undef

/-- (UndefNew) A new cell's placeholders: unless its type is zeroable, every unit of the cell (a
laid-out type, or an array of literal length of one) has an `undef` message in `mem`. -/
def UndefAtT (mem : Memory) (l : AllocLabel) (T : Ty) : Prop :=
  zeroableIn [] [] T = false →
    (∃ L, accs T = some L ∧ ∀ o, o < nWords L → UndefU mem ⟨l, o⟩) ∨
    (∃ K e L, T = .array (.lit K) e ∧ accs e = some L ∧ ∀ o, o < K * nWords L → UndefU mem ⟨l, o⟩)

/-- (msgWords) Offset `o` lies within the words of a cell of type `T` (a laid-out type, or an
array of literal length of one). -/
def InWords (T : Ty) (o : Nat) : Prop :=
  (∀ L, accs T = some L → o < nWords L) ∧
    ∀ N e us, T = .array (.lit N) e → accs e = some us → o < N * nWords us

/-- (NewAt) A message at address `a` at a timestamp at least `n0`. -/
def NewU (n0 : Nat) (mem : Memory) (a : Address) : Prop :=
  ∃ (t : Nat) (m : Msg), n0 ≤ t ∧ mem[t]? = some m ∧ m.loc = a

/-- (NewAt) A new cell's messages: every unit of the cell (a laid-out type, or an array of
literal length of one) has a message in `mem` at a timestamp at least `n0`, the memory size before
the allocation (zeroable or not: `allocBuf` writes zeros or `undef`s, `alloc` `undef`s). -/
def NewAtT (n0 : Nat) (mem : Memory) (l : AllocLabel) (T : Ty) : Prop :=
  ((∃ L, accs T = some L ∧ ∀ o, o < nWords L → NewU n0 mem ⟨l, o⟩) ∨
    (∃ K e L, T = .array (.lit K) e ∧ accs e = some L ∧ ∀ o, o < K * nWords L → NewU n0 mem ⟨l, o⟩)) ∧
  ∀ (t : Nat) (m : Msg), n0 ≤ t → mem[t]? = some m → m.loc.label = l → InWords T m.loc.offset

/-- (iniop) `g` with no ghost labels: the step is `g`'s (`tstep`, `MemInv`, `ThInvM` read no `zf`). -/
abbrev gZ0 (g : G) : G := { g with zf := fun _ => False, pf := fun _ => True }

/-- (iniop) **The counts at the ghost labels `g.zf` are kept**: at a `g.zf` label that is not one of
the step's fresh labels and is a cell with a frontier, `ini` and `rini` are unchanged.  Every
footprint but `bufInit`'s keeps them outright; `bufInit` at a `g.zf` label is excluded by its
caller (`BufInitOn`). -/
def IniFixZ (g : G) (E E' : TEnv) (s s' : St) : Prop :=
  ∀ l c f, g.zf l → ¬ FreshIn g s.nalloc s'.nalloc l → E.sto l = some c → E.pfr l = some f →
    E'.ini l = E.ini l ∧ E'.rini l = E.rini l

/-- (iniop) `IniFixZ` from the counts' locality: they change only at labels `P`, none of which is a
non-fresh `g.zf` cell with a frontier. -/
theorem IniFixZ_of {g : G} {E E' : TEnv} {s s' : St} {P : AllocLabel → Prop}
    (hi : ∀ l, E'.ini l = E.ini l ∨ P l) (hr : ∀ l, E'.rini l = E.rini l ∨ P l)
    (hP : ∀ l c f, P l → g.zf l → ¬ FreshIn g s.nalloc s'.nalloc l → E.sto l = some c → E.pfr l = some f → False) :
    IniFixZ g E E' s s' := by
  intro l c f hz hnf hc hf
  rcases hi l with h1 | h1
  · rcases hr l with h2 | h2
    · exact ⟨h1, h2⟩
    · exact (hP l c f h2 hz hnf hc hf).elim
  · exact (hP l c f h1 hz hnf hc hf).elim

/-- (EFoot tags, RiniArr) Cell `l` of `E` is a buffer: an array of literal length of a laid-out
element type. -/
def ArrAt (E : TEnv) (l : AllocLabel) : Prop :=
  ∃ c N e us, E.sto l = some c ∧ c.ty = .array (.lit N) e ∧ accs e = some us

/-- (EFoot tags, RiniArr) **The real count rises only at buffers**: at a cell of `E` whose real
count `rini` the step raises, the label is one of the step's fresh labels or the cell is a buffer. -/
def RiniArr (g : G) (E E' : TEnv) (s s' : St) : Prop :=
  ∀ l c, E.sto l = some c → E.rini l < E'.rini l →
    FreshIn g s.nalloc s'.nalloc l ∨ ∃ N e us, c.ty = .array (.lit N) e ∧ accs e = some us

/-- (EFoot tags, RiniArr) `RiniArr` from the real count's locality: it changes only at labels `P`,
each fresh, unchanged after all, or a buffer. -/
theorem RiniArr_of {g : G} {E E' : TEnv} {s s' : St} {P : AllocLabel → Prop}
    (hr : ∀ l, E'.rini l = E.rini l ∨ P l)
    (hP : ∀ l, P l → FreshIn g s.nalloc s'.nalloc l ∨ E'.rini l = E.rini l ∨ ArrAt E l) :
    RiniArr g E E' s s' := by
  intro l c hc hlt
  have hne : E'.rini l ≠ E.rini l := fun e => by rw [e] at hlt; exact Nat.lt_irrefl _ hlt
  rcases hr l with e | hp
  · exact absurd e hne
  · rcases hP l hp with h | e | ⟨c', N, e, us, hc', hT, hus⟩
    · exact .inl h
    · exact absurd e hne
    · rw [hc] at hc'; cases hc'; exact .inr ⟨N, e, us, hT, hus⟩

theorem RiniArr_refl {g : G} {E : TEnv} {s s' : St} : RiniArr g E E s s' :=
  fun _ _ _ h => absurd h (Nat.lt_irrefl _)

/-- (EFoot tags, PfrTag) **A frontier of an existing cell changes only at a ghost label**
(`G.pf`): every footprint but `publish`'s keeps the frontiers of `E`'s cells. -/
def PfrG (g : G) (E E' : TEnv) : Prop :=
  ∀ l, E.sto l ≠ none → E'.pfr l ≠ E.pfr l → g.pf l

theorem PfrG_of {g : G} {E E' : TEnv} (h : ∀ l, E.sto l ≠ none → E'.pfr l = E.pfr l) : PfrG g E E' :=
  fun l hs hne => absurd (h l hs) hne

theorem PfrG_refl {g : G} {E : TEnv} : PfrG g E E := fun _ _ h => absurd rfl h

/-- (iniop) The thread is at a `bufInit` whose buffer handle names `l`. -/
def BufInitOn (th : TTh) (l : AllocLabel) : Prop :=
  ∃ (y : String) (bb ib v : At) (e : Expr) (rt : Ty) (w : Word) (ad : Address) (g : Nat),
    th.term = .let_ y (.bufInit bb ib v) e ∧ evalAt th.env bb = some (rt, [w]) ∧ w.val = .loc ad g ∧
      ad.label = l

/-- (plantFrozen) The slot of a `bufInit` on `l` at a frontier buffer is low: from `rc ≤ n`, both
counts exceed it (so the bump keeps them).  Binder order as BH1 (`TermPlantWin.bh1_of`). -/
def BufLow (E : TEnv) (th : TTh) (l : AllocLabel) : Prop :=
  ∀ x b i v e, th.term = .let_ x (.bufInit b i v) e →
    ∀ rt w ad rti wi n, evalAt th.env b = some (rt, [w]) → w.val = .loc ad 0 →
      evalAt th.env i = some (rti, [wi]) → numOf [wi] = some n → ad.label = l → E.pfr ad.label ≠ none →
      E.rc ad.label ≤ n → n < E.ini ad.label ∧ n < E.rini ad.label

/-- (plantFrozen) The iniop guard: a `bufInit` label that is a ghost label (`g.zf`) has a low slot.
At `zf = fun _ => False` (every `gOf`) it holds outright (`ZOK_false`). -/
abbrev ZOK (g : G) (E : TEnv) (th : TTh) : Prop := ∀ l, BufInitOn th l → g.zf l → BufLow E th l

theorem ZOK_of_not {g : G} {E : TEnv} {th : TTh} (h : ∀ l, BufInitOn th l → ¬ g.zf l) : ZOK g E th :=
  fun l hb hz => (h l hb hz).elim

/-- (S6) **The exact footprint of a thread step on its environment** (for
the A-strict global environment).  From `E` at state `s`
to `E'` at `s'`: same program and thread; Σ and the boxes change only at the
step's fresh labels, each becoming a new cell or box of the thread; the
initialised counts grow, and change only at fresh labels or own cells
(`bufInit`), (IniLe) there only up to the real count, (IniFrzW) at a cell with a frontier only
from `ini ≤ rini`; frontiers change only from none: to the old `vWr`, at an
own cell (`publish`), or (S8b) from none at a fresh box label; `seen` grows,
and only at own cells or (S8b) fresh (box) labels; (S7i) the foreign
promises (`fp`, ghost) are unchanged.  (B4) A new box's frontier `B.fr` is at
least the old memory size less one (its words lie at the old size and above).
(F2′ step 3) A frontier may also be planted, from none to some `F` with
`vWr ≤ F ≤ max vWr size`, at an own cell; (RiniLe) `rini ≤ ini` is kept; (F2′ b″) the units a
raised real count newly covers were written in the step (`RiniW`). -/
def EFootB (W : Ty → Prop) (g : G) (E E' : TEnv) (s s' : St) : Prop :=
  E'.prog = E.prog ∧ E'.tid = E.tid ∧
  (∀ l, E'.sto l = E.sto l ∨
    (FreshIn g s.nalloc s'.nalloc l ∧ ∃ T, E'.sto l = some ⟨T, some E.tid⟩ ∧ (Clo T ∧ mg T = true ∧ noIallV T = true ∧ W T) ∧ UndefAtT s'.mem l T ∧
      NewAtT s.mem.size s'.mem l T)) ∧
  (∀ l, E'.box l = E.box l ∨
    (FreshIn g s.nalloc s'.nalloc l ∧ ∃ B, E'.box l = some B ∧ B.own = E.tid ∧ s.mem.size ≤ B.fr + 1 ∧
      B.fr ≤ s'.vs.vWr ∧ s.mem.size + B.pay.length ≤ B.fr)) ∧
  (∀ l, E.ini l ≤ E'.ini l ∧ (E'.ini l = E.ini l ∨ FreshIn g s.nalloc s'.nalloc l ∨
    (OwnAt E l ∧ E'.ini l ≤ max (E.ini l) (E'.rini l) ∧
      (E.pfr l ≠ none → E'.ini l = E.ini l ∨ E.ini l ≤ E.rini l)))) ∧
  (∀ l, E'.pfr l = E.pfr l ∨
    (E.pfr l = none ∧ ∃ F, E'.pfr l = some F ∧ s.vs.vWr ≤ F ∧ F ≤ max s.vs.vWr s.mem.size ∧ OwnAt E l ∧
      s'.vs.vWr ≤ F ∧ (∀ u, HoldW E s l u → u ≤ F) ∧
      (¬ E'.seen l → ∀ cl N e us, E'.sto l = some cl → cl.ty = .array (.lit N) e → accs e = some us →
        nWords us = 0 → (∃ ws, ValOf ({ prog := E.prog } : TEnv) e ws ∧ ws.length = 0) → N ≤ E'.ini l) ∧
      (F ≤ s.vs.vWr ∨ F < s.mem.size)) ∨
    (FreshIn g s.nalloc s'.nalloc l ∧ E.pfr l = none ∧ E'.sto l = none)) ∧
  (∀ l, E.seen l → E'.seen l) ∧ (∀ l, E'.seen l → E.seen l ∨ OwnAt E l ∨ FreshIn g s.nalloc s'.nalloc l) ∧
  E'.fp = E.fp ∧ (∀ l, E.rini l ≤ E'.rini l) ∧
  ((∀ l, E.rini l ≤ E.ini l) → ∀ l, E'.rini l ≤ E'.ini l) ∧ RiniW E E' s s'.vs.vWr ∧
  (∀ l, E'.rini l = E.rini l ∨ FreshIn g s.nalloc s'.nalloc l ∨ OwnAt E l) ∧
  IniFixZ g E E' s s' ∧ RiniArr g E E' s s' ∧ PfrG g E E'

/-- (A1 stoW) **The footprint of a `CkW` thread**: a new cell's type is `wrapTop`. -/
abbrev EFoot (g : G) (E E' : TEnv) (s s' : St) : Prop :=
  EFootB (fun T => TermA4.wrapTop T = true) g E E' s s'

/-- (A1 stoW) The footprint of a `Typed`-only thread: no promise on a new cell's type beyond
`EFootB`'s triple. -/
abbrev EFootP (g : G) (E E' : TEnv) (s s' : St) : Prop :=
  EFootB (fun _ => True) g E E' s s'

/-- (A1 stoW) Weakening the new-cell promise. -/
theorem EFootB.mono {W W' : Ty → Prop} {g : G} {E E' : TEnv} {s s' : St} (h : EFootB W g E E' s s')
    (hW : ∀ T, W T → W' T) : EFootB W' g E E' s s' := by
  obtain ⟨h1, h2, h3, hr⟩ := h
  refine ⟨h1, h2, fun l => ?_, hr⟩
  rcases h3 l with e | ⟨hf, T, e, ⟨a1, a2, a3, a4⟩, a5, a6⟩
  · exact .inl e
  · exact .inr ⟨hf, T, e, ⟨a1, a2, a3, hW T a4⟩, a5, a6⟩

/-- (A1 stoW) The plain footprint of any footprint. -/
theorem EFootB.toP {W : Ty → Prop} {g : G} {E E' : TEnv} {s s' : St} (h : EFootB W g E E' s s') :
    EFootP g E E' s s' :=
  h.mono fun _ _ => trivial

/-- (F2′ b″) The footprint's `RiniW`. -/
theorem EFootB.riniW {W : Ty → Prop} {g : G} {E E' : TEnv} {s s' : St} (h : EFootB W g E E' s s') : RiniW E E' s s'.vs.vWr :=
  h.2.2.2.2.2.2.2.2.2.2.2.1

/-- (A1, rini) The footprint's `rini` locality: `rini` changes only at fresh
labels and own cells. -/
theorem EFootB.rinieq {W : Ty → Prop} {g : G} {E E' : TEnv} {s s' : St} (h : EFootB W g E E' s s') :
    ∀ l, E'.rini l = E.rini l ∨ FreshIn g s.nalloc s'.nalloc l ∨ OwnAt E l :=
  h.2.2.2.2.2.2.2.2.2.2.2.2.1

/-- (iniop) The footprint's `IniFixZ`. -/
theorem EFootB.iniFixZ {W : Ty → Prop} {g : G} {E E' : TEnv} {s s' : St} (h : EFootB W g E E' s s') : IniFixZ g E E' s s' :=
  h.2.2.2.2.2.2.2.2.2.2.2.2.2.1

/-- (EFoot tags) The footprint's `RiniArr`. -/
theorem EFootB.riniArr {W : Ty → Prop} {g : G} {E E' : TEnv} {s s' : St} (h : EFootB W g E E' s s') : RiniArr g E E' s s' :=
  h.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1

/-- (EFoot tags) The footprint's `PfrG`. -/
theorem EFootB.pfrG {W : Ty → Prop} {g : G} {E E' : TEnv} {s s' : St} (h : EFootB W g E E' s s') : PfrG g E E' :=
  h.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2

/-- Aliases of the generic projections. -/
theorem EFoot.riniW {g : G} {E E' : TEnv} {s s' : St} (h : EFoot g E E' s s') :
    RiniW E E' s s'.vs.vWr :=
  EFootB.riniW h

theorem EFoot.rinieq {g : G} {E E' : TEnv} {s s' : St} (h : EFoot g E E' s s') :
    ∀ l, E'.rini l = E.rini l ∨ FreshIn g s.nalloc s'.nalloc l ∨ OwnAt E l :=
  EFootB.rinieq h

theorem EFoot.iniFixZ {g : G} {E E' : TEnv} {s s' : St} (h : EFoot g E E' s s') :
    IniFixZ g E E' s s' :=
  EFootB.iniFixZ h

theorem EFoot.riniArr {g : G} {E E' : TEnv} {s s' : St} (h : EFoot g E E' s s') :
    RiniArr g E E' s s' :=
  EFootB.riniArr h

theorem EFoot.pfrG {g : G} {E E' : TEnv} {s s' : St} (h : EFoot g E E' s s') :
    PfrG g E E' :=
  EFootB.pfrG h

theorem EFoot_refl {W : Ty → Prop} {g : G} {E : TEnv} {s s' : St} : EFootB W g E E s s' :=
  ⟨rfl, rfl, fun _ => .inl rfl, fun _ => .inl rfl, fun _ => ⟨Nat.le_refl _, .inl rfl⟩, fun _ => .inl rfl,
    fun _ h => h, fun _ h => .inl h, rfl, fun _ => Nat.le_refl _, fun h => h, RiniW_of_eq rfl,
    fun _ => .inl rfl, fun _ _ _ _ _ _ _ => ⟨rfl, rfl⟩, RiniArr_refl, PfrG_refl⟩

/-- (B2, ownPub) **No own cell becomes seen**: every label `E'` sees that is an own cell of `E` was
seen in `E` (every footprint but `publish`'s). -/
def SeenKeep (E E' : TEnv) : Prop := ∀ l, E'.seen l → OwnAt E l → E.seen l

/-- (B2, ownPub) **A newly seen own cell's key is gone**: at an own cell of `E` that `E'` newly sees
(`publish`), neither the frame `Tot` nor memory `H` carries its own key. -/
def SeenOK (E E' : TEnv) (Tot H : Res) : Prop :=
  ∀ l, E'.seen l → ¬ E.seen l → OwnAt E l → Tot (.own l) = 0 ∧ H (.own l) = 0

theorem SeenKeep_refl {E : TEnv} : SeenKeep E E := fun _ h _ => h

theorem SeenKeep_of_eq {E E' : TEnv} (h : E'.seen = E.seen) : SeenKeep E E' :=
  fun l hl _ => by rw [h] at hl; exact hl

theorem SeenKeep.ok {E E' : TEnv} {Tot H : Res} (h : SeenKeep E E') : SeenOK E E' Tot H :=
  fun l hl hn ho => absurd (h l hl ho) hn

theorem SeenOK_refl {E : TEnv} {Tot H : Res} : SeenOK E E Tot H := SeenKeep_refl.ok

/-- A footprint that newly sees only a label outside Σ (a box) keeps every own cell's `seen`. -/
theorem SeenKeep_box {E E' : TEnv} {lbl : AllocLabel} (hse : ∀ l, E'.seen l → l = lbl ∨ E.seen l)
    (hsto : E.sto lbl = none) : SeenKeep E E' := fun l hl ho =>
  (hse l hl).elim (fun e => by subst e; obtain ⟨c, hc, -⟩ := ho; rw [hsto] at hc; cases hc) id

/-- `seenT`: discharge `SeenKeep`/`SeenOK` for the non-`publish` footprints. -/
macro "seenT" : tactic => `(tactic| first
  | exact SeenKeep_refl | exact SeenOK_refl
  | exact SeenKeep_of_eq rfl | exact (SeenKeep_of_eq rfl).ok
  | exact SeenKeep_of_eq (by assumption) | exact (SeenKeep_of_eq (by assumption)).ok
  | assumption | exact SeenKeep.ok (by assumption)
  | exact SeenKeep_box (fun _ h => h) (by assumption)
  | exact (SeenKeep_box (fun _ h => h) (by assumption)).ok)

/-- (box L1) **A new box's payload views lie below its frontier**, under the view invariant at
the step's start (`TermViewInv.StV s`, and `EnvV` of the environment the step extends: `th`'s tail).
`TermBoxPV` discharges the premises from `TermViewInv.viewInv_run`. -/
def BoxNewV (E E' : TEnv) (s : St) (th : TTh) : Prop :=
  ∀ l B, E.box l = none → E'.box l = some B → ∀ e env0, th.env = e :: env0 →
    TermViewInv.StV s → TermViewInv.EnvV s.mem.size env0 →
    ∀ w ∈ B.pay, ∀ (a : Address) (g : Nat), w.val = .loc a g → w.view < B.fr

/-- (box L1) A step that keeps every box meets `BoxNewV`. -/
theorem BoxNewV_of_box {E E' : TEnv} {s : St} {th : TTh} (h : ∀ l, E'.box l = E.box l) :
    BoxNewV E E' s th := fun l B h0 h1 => by rw [h l, h0] at h1; cases h1

/-- (box L1) A step that keeps the boxes meets `BoxNewV`. -/
theorem BoxNewV_refl {E : TEnv} {s : St} {th : TTh} : BoxNewV E E s th := BoxNewV_of_box fun _ => rfl

macro "boxT" : tactic => `(tactic| first
  | exact BoxNewV_refl
  | exact BoxNewV_of_box (fun _ => rfl)
  | assumption
  | exact BoxNewV_of_box (by assumption)
  | exact BoxNewV_of_box (fun _ => by simp_all))

/-- (S6) `ThInvM` with its witness an exact footprint of `E` at `s`. -/
def ThInvMF (p : Prog) (g : G) (E : TEnv) (s : St) (mem : Memory) (pairs : List Ts) (th : TTh) : Prop :=
  ∃ E', EFootP g E E' s (stOf mem pairs th) ∧ ThInvE p E' th ∧ MemInv g E' (stOf mem pairs th)

/-- (S1b) `ThInvMF` that also records the publish: when the old thread `th0` is at a `publish`
of `ad`, the new environment has a frontier at `ad.label`. -/
def ThInvMFP (p : Prog) (g : G) (E : TEnv) (s : St) (th0 : TTh) (mem : Memory) (pairs : List Ts) (th : TTh) :
    Prop :=
  ∃ E', EFootP g E E' s (stOf mem pairs th) ∧ ThInvE p E' th ∧ MemInv g E' (stOf mem pairs th) ∧
    ∀ y a e rt ws ad, th0.term = .let_ y (.publish a) e → evalAt th0.env a = some (rt, ws) →
      ws.map (·.val) = [.loc ad 0] → E'.pfr ad.label ≠ none

theorem ThInvMFP.toF {p : Prog} {g : G} {E : TEnv} {s : St} {th0 : TTh} {mem : Memory} {pairs : List Ts}
    {th : TTh} (h : ThInvMFP p g E s th0 mem pairs th) : ThInvMF p g E s mem pairs th :=
  let ⟨E', h1, h2, h3, _⟩ := h
  ⟨E', h1, h2, h3⟩

theorem ThInvMF.toM {p : Prog} {g : G} {E : TEnv} {s : St} {mem : Memory} {pairs : List Ts} {th : TTh}
    (h : ThInvMF p g E s mem pairs th) (hbf : g.boxFence = true) : ThInvM p g mem pairs th :=
  let ⟨E', _, h1, h2⟩ := h
  ⟨E', h1, h2, hbf⟩

/-- (S6) The footprint reads only the old state's allocation count and `vWr`
(and, B4, its memory size). -/
theorem EFoot_congr {W : Ty → Prop} {g : G} {E E' : TEnv} {s1 s s' : St} (h : EFootB W g E E' s1 s')
    (hn : s1.nalloc = s.nalloc) (hv : s1.vs.vWr = s.vs.vWr) (hz : s1.mem.size = s.mem.size)
    (hpr : s1.promises = s.promises) (hme : s1.mem = s.mem) :
    EFootB W g E E' s s' := by
  unfold EFootB IniFixZ RiniArr at h ⊢; rw [hn, hv, hz] at h; unfold RiniW HoldW at h ⊢; rw [hpr, hme] at h; exact h

theorem ThInvMF_congr {p : Prog} {g : G} {E : TEnv} {s1 s : St} {mem : Memory} {pairs : List Ts} {th : TTh}
    (h : ThInvMF p g E s1 mem pairs th) (hn : s1.nalloc = s.nalloc) (hv : s1.vs.vWr = s.vs.vWr)
    (hz : s1.mem.size = s.mem.size) (hpr : s1.promises = s.promises) (hme : s1.mem = s.mem) :
    ThInvMF p g E s mem pairs th :=
  let ⟨E', hf, h1, h2⟩ := h
  ⟨E', EFoot_congr hf hn hv hz hpr hme, h1, h2⟩

/-- (G1) A step's fresh array cells come from `newBuf`, with the element type closed at the
step's witness: every cell of `E'` at one of the step's fresh labels whose type is an array has
the element type `cl ρ η.wit 0 0 τ` of the `newBuf` the old thread `th` is at. -/
def FreshArr (g : G) (ρ : Nat → Nat) (η : TEnv) (th : TTh) (E' : TEnv) (r : Memory × List Ts × TTh) : Prop :=
  ∀ l c N u, FreshIn g th.nalloc r.2.2.nalloc l → E'.sto l = some c → c.ty = .array (.lit N) u →
    ∃ x n τ e, th.term = .let_ x (.newBuf n τ) e ∧ u = cl ρ η.wit 0 0 τ

/-- (G1) `ThInvMF` with `FreshArr` of its witness, for the old thread `th0`. -/
def ThInvMFA (p : Prog) (g : G) (ρ : Nat → Nat) (η : TEnv) (th0 : TTh) (E : TEnv) (s : St) (mem : Memory)
    (pairs : List Ts) (th : TTh) : Prop :=
  ∃ E', FreshArr g ρ η th0 E' (mem, pairs, th) ∧ EFootP g E E' s (stOf mem pairs th) ∧ ThInvE p E' th ∧
    MemInv g E' (stOf mem pairs th)

theorem ThInvMFA.toF {p : Prog} {g : G} {ρ : Nat → Nat} {η : TEnv} {th0 : TTh} {E : TEnv} {s : St}
    {mem : Memory} {pairs : List Ts} {th : TTh} (h : ThInvMFA p g ρ η th0 E s mem pairs th) :
    ThInvMF p g E s mem pairs th :=
  let ⟨E', _, h1, h2, h3⟩ := h
  ⟨E', h1, h2, h3⟩

/-- (G1) `ThInvMF` whose witness keeps `sto`. -/
def ThInvMFS (p : Prog) (g : G) (E : TEnv) (s : St) (mem : Memory) (pairs : List Ts) (th : TTh) : Prop :=
  ∃ E', (∀ l, E'.sto l = E.sto l) ∧ EFootP g E E' s (stOf mem pairs th) ∧ ThInvE p E' th ∧
    MemInv g E' (stOf mem pairs th)

theorem ThInvMFS.toF {p : Prog} {g : G} {E : TEnv} {s : St} {mem : Memory} {pairs : List Ts} {th : TTh}
    (h : ThInvMFS p g E s mem pairs th) : ThInvMF p g E s mem pairs th :=
  let ⟨E', _, h1, h2, h3⟩ := h
  ⟨E', h1, h2, h3⟩

theorem ThInvMFS_congr {p : Prog} {g : G} {E : TEnv} {s1 s : St} {mem : Memory} {pairs : List Ts} {th : TTh}
    (h : ThInvMFS p g E s1 mem pairs th) (hn : s1.nalloc = s.nalloc) (hv : s1.vs.vWr = s.vs.vWr)
    (hz : s1.mem.size = s.mem.size) (hpr : s1.promises = s.promises) (hme : s1.mem = s.mem) :
    ThInvMFS p g E s mem pairs th :=
  let ⟨E', hs, hf, h1, h2⟩ := h
  ⟨E', hs, EFoot_congr hf hn hv hz hpr hme, h1, h2⟩

/-- (G1) A witness that keeps `sto` at the fresh labels has no fresh cell. -/
theorem FreshArr_eq {g : G} {ρ : Nat → Nat} {η : TEnv} {th0 : TTh} {E0 E' : TEnv} {mem0 : Memory}
    {pairs0 : List Ts} {r : Memory × List Ts × TTh} (hm : MemInv g E0 (stOf mem0 pairs0 th0))
    (hs : ∀ l, E'.sto l = E0.sto l) : FreshArr g ρ η th0 E' r := by
  intro l c N u hf hc _
  obtain ⟨j, hj, -, rfl⟩ := hf
  have h0 : E0.sto (freshLabel g.lbase g.n g.i j) = none := (hm.2.2.2.1.1 j hj).1
  rw [hs, h0] at hc
  cases hc

theorem ThInvMFS.toA {p : Prog} {g : G} {ρ : Nat → Nat} {η : TEnv} {th0 : TTh} {E : TEnv} {s : St}
    {mem0 : Memory} {pairs0 : List Ts} {mem : Memory} {pairs : List Ts} {th : TTh}
    (hm : MemInv g E (stOf mem0 pairs0 th0)) (h : ThInvMFS p g E s mem pairs th) :
    ThInvMFA p g ρ η th0 E s mem pairs th :=
  let ⟨E', hs, h1, h2, h3⟩ := h
  ⟨E', FreshArr_eq hm hs, h1, h2, h3⟩

/-- (S6) An allocation's footprint: a new cell or box, and a raised count, at
the next fresh label only. -/
theorem EFoot_fresh {W : Ty → Prop} {g : G} {E E' : TEnv} {s s' : St}
    (hp : E'.prog = E.prog) (ht : E'.tid = E.tid) (hpf : E'.pfr = E.pfr) (hse : E'.seen = E.seen)
    (hlt : s.nalloc < s'.nalloc)
    (hsto : ∀ l, E'.sto l = E.sto l ∨
      (l = freshLabel g.lbase g.n g.i s.nalloc ∧ ∃ T, E'.sto l = some ⟨T, some E.tid⟩ ∧ (Clo T ∧ mg T = true ∧ noIallV T = true ∧ W T) ∧ UndefAtT s'.mem l T ∧
      NewAtT s.mem.size s'.mem l T))
    (hbox : ∀ l, E'.box l = E.box l ∨
      (l = freshLabel g.lbase g.n g.i s.nalloc ∧ ∃ B, E'.box l = some B ∧ B.own = E.tid ∧ s.mem.size ≤ B.fr + 1 ∧
      B.fr ≤ s'.vs.vWr ∧ s.mem.size + B.pay.length ≤ B.fr))
    (hini : ∀ l, E.ini l ≤ E'.ini l ∧ (E'.ini l = E.ini l ∨ l = freshLabel g.lbase g.n g.i s.nalloc))
    (hfp : E'.fp = E.fp := by first | rfl | assumption)
    (hri : ∀ l, E.rini l ≤ E'.rini l := by rini_le)
    (hrl : (∀ l, E.rini l ≤ E.ini l) → ∀ l, E'.rini l ≤ E'.ini l := by rini_ini)
    (hrw : RiniW E E' s s'.vs.vWr := by riniW_tac)
    (hrq : ∀ l, E'.rini l = E.rini l ∨ l = freshLabel g.lbase g.n g.i s.nalloc := by rini_eq) :
    EFootB W g E E' s s' := by
  have hf : ∀ l, l = freshLabel g.lbase g.n g.i s.nalloc → FreshIn g s.nalloc s'.nalloc l :=
    fun l h => ⟨s.nalloc, Nat.le_refl _, hlt, h⟩
  refine ⟨hp, ht, fun l => ?_, fun l => ?_, fun l => ?_, fun l => .inl (by rw [hpf]),
    fun l h => by rw [hse]; exact h, fun l h => .inl (by rw [hse] at h; exact h), hfp, hri, hrl, hrw,
    fun l => (hrq l).imp id fun h => .inl (hf l h),
    IniFixZ_of (fun l => (hini l).2) hrq (fun l _ _ h _ hnf _ _ => hnf (hf l h)),
    RiniArr_of hrq (fun l h => .inl (hf l h)), PfrG_of fun l _ => by rw [hpf]⟩
  · rcases hsto l with h | ⟨h1, h2⟩
    · exact .inl h
    · exact .inr ⟨hf l h1, h2⟩
  · rcases hbox l with h | ⟨h1, h2⟩
    · exact .inl h
    · exact .inr ⟨hf l h1, h2⟩
  · obtain ⟨h1, h2⟩ := hini l
    refine ⟨h1, ?_⟩
    rcases h2 with h | h
    · exact .inl h
    · exact .inr (.inl (hf l h))

set_option hygiene false in
/-- (IniLe) The autoParam of `EFoot_ini`'s `hil`: the count unchanged, or both counts bumped. -/
macro "iniIL_tac" : tactic =>
  `(tactic| first
    | exact Nat.le_max_left _ _
    | exact bumpIni_le_max _ _ _ _
    | (simp only [bumpIni, ite_true]; omega))

/-- (S6) `bufInit`'s footprint: a raised count at one own cell. -/
theorem EFoot_ini {W : Ty → Prop} {g : G} {E E' : TEnv} {s s' : St} {l0 : AllocLabel}
    (hp : E'.prog = E.prog) (ht : E'.tid = E.tid) (hs : E'.sto = E.sto) (hbx : E'.box = E.box)
    (hpf : E'.pfr = E.pfr) (hse : E'.seen = E.seen) (hown : OwnAt E l0)
    (hini : ∀ l, E.ini l ≤ E'.ini l ∧ (E'.ini l = E.ini l ∨ l = l0)) (hrw : RiniW E E' s s'.vs.vWr)
    (hfp : E'.fp = E.fp := by first | rfl | assumption)
    (hri : ∀ l, E.rini l ≤ E'.rini l := by rini_le)
    (hrl : (∀ l, E.rini l ≤ E.ini l) → ∀ l, E'.rini l ≤ E'.ini l := by rini_ini)
    (hrq : ∀ l, E'.rini l = E.rini l ∨ l = l0 := by rini_eq)
    (hil : E'.ini l0 ≤ max (E.ini l0) (E'.rini l0) := by iniIL_tac)
    (hfz : E.pfr l0 ≠ none → E'.ini l0 = E.ini l0 ∨ E.ini l0 ≤ E.rini l0 := by exact fun _ => .inl rfl)
    (hz : ¬ g.zf l0 ∨ E.pfr l0 = none ∨ (E'.ini l0 = E.ini l0 ∧ E'.rini l0 = E.rini l0) := by
      first | exact .inr (.inr ⟨rfl, rfl⟩) | assumption)
    (harr : E'.rini l0 = E.rini l0 ∨ ArrAt E l0 := by first | exact .inl rfl | assumption) :
    EFootB W g E E' s s' := by
  have hIF : IniFixZ g E E' s s' := by
    intro l _ _ hzl _ _ hf
    by_cases hl : l = l0
    · subst hl
      rcases hz with hz | hz | hz
      · exact absurd hzl hz
      · rw [hz] at hf; cases hf
      · exact hz
    · exact ⟨(hini l).2.resolve_right hl, (hrq l).resolve_right hl⟩
  refine ⟨hp, ht, fun l => .inl (by rw [hs]), fun l => .inl (by rw [hbx]), fun l => ?_, fun l => .inl (by rw [hpf]),
    fun l h => by rw [hse]; exact h, fun l h => .inl (by rw [hse] at h; exact h), hfp, hri, hrl, hrw,
    fun l => (hrq l).imp id fun h => .inr (by subst h; exact hown), hIF,
    RiniArr_of hrq (fun l h => by subst h; exact .inr harr), PfrG_of fun l _ => by rw [hpf]⟩
  obtain ⟨h1, h2⟩ := hini l
  refine ⟨h1, ?_⟩
  rcases h2 with h | h
  · exact .inl h
  · subst h; exact .inr (.inr ⟨hown, hil, hfz⟩)

/-- (S6) `publish`'s footprint: the frontier of one own cell is set (if it was
not), and the cell is seen. -/
theorem EFoot_pub {W : Ty → Prop} {g : G} {E E' : TEnv} {s s' : St} {l0 : AllocLabel}
    (hp : E'.prog = E.prog) (ht : E'.tid = E.tid) (hs : E'.sto = E.sto) (hbx : E'.box = E.box)
    (hini : E'.ini = E.ini) (hown : OwnAt E l0)
    (hpf : ∀ l, E'.pfr l = if l = l0 then some ((E.pfr l0).getD s.vs.vWr) else E.pfr l)
    (hse : ∀ l, E'.seen l ↔ (l = l0 ∨ E.seen l))
    (hnh : E.pfr l0 = none → ∀ u, ¬ HoldW E s l0 u)
    (hfp : E'.fp = E.fp := by first | rfl | assumption)
    (hri : ∀ l, E.rini l ≤ E'.rini l := by rini_le)
    (hrl : (∀ l, E.rini l ≤ E.ini l) → ∀ l, E'.rini l ≤ E'.ini l := by rini_ini)
    (hrw : RiniW E E' s s'.vs.vWr := by riniW_tac)
    (hrq : ∀ l, E'.rini l = E.rini l ∨ l = l0 := by rini_eq)
    (hvw : s'.vs.vWr ≤ s.vs.vWr := by first | exact Nat.le_refl _ | assumption)
    (hriq : E'.rini = E.rini := by first | rfl | assumption)
    (hgp : g.pf l0 := by first | trivial | assumption) : EFootB W g E E' s s' := by
  have hother : ∀ l, l ≠ l0 → E'.pfr l = E.pfr l := fun l h => by rw [hpf l]; simp [h]
  refine ⟨hp, ht, fun l => .inl (by rw [hs]), fun l => .inl (by rw [hbx]),
    fun l => ⟨by rw [hini]; exact Nat.le_refl _, .inl (by rw [hini])⟩, fun l => ?_,
    fun l h => (hse l).2 (.inr h), fun l h => ?_, hfp, hri, hrl, hrw,
    fun l => (hrq l).imp id fun h => .inr (by subst h; exact hown),
    fun l _ _ _ _ _ _ => ⟨by rw [hini], by rw [hriq]⟩,
    RiniArr_of (P := fun _ => False) (fun l => .inl (by rw [hriq])) (fun _ h => h.elim),
    fun l _ hne => if h : l = l0 then (by subst h; exact hgp) else absurd (hother l h) hne⟩
  · by_cases hl : l = l0
    · subst hl
      cases hE : E.pfr l with
      | some f => exact .inl (by rw [hpf l]; simp [hE])
      | none =>
        exact .inr (.inl ⟨rfl, s.vs.vWr, by rw [hpf l]; simp [hE], Nat.le_refl _, Nat.le_max_left _ _, hown, hvw,
          fun u hu => absurd hu (hnh hE u), fun hns => absurd ((hse l).2 (.inl rfl)) hns, .inl (Nat.le_refl _)⟩)
    · exact .inl (hother l hl)
  · rcases (hse l).1 h with h | h
    · subst h; exact .inr (.inl hown)
    · exact .inl h

/-- (F2′ step 3, S3.7a) **The plant's footprint**: at one own cell with no
frontier, the frontier is set to `F` (between the old `vWr` and the old memory
size) and the count may be raised there; `seen` unchanged. -/
theorem EFoot_plant {W : Ty → Prop} {g : G} {E E' : TEnv} {s s' : St} {l0 : AllocLabel} {F : Ts}
    (hp : E'.prog = E.prog) (ht : E'.tid = E.tid) (hs : E'.sto = E.sto) (hbx : E'.box = E.box)
    (hown : OwnAt E l0) (hpf0 : E.pfr l0 = none)
    (hpf : ∀ l, E'.pfr l = if l = l0 then some F else E.pfr l)
    (hFlo : s.vs.vWr ≤ F) (hFhi : F ≤ s.mem.size) (hFv : s'.vs.vWr ≤ F) (hFlt : F ≤ s.vs.vWr ∨ F < s.mem.size)
    (hFh : ∀ u, HoldW E s l0 u → u ≤ F)
    (hZw : ¬ E'.seen l0 → ∀ cl N e us, E'.sto l0 = some cl → cl.ty = .array (.lit N) e → accs e = some us →
      nWords us = 0 → (∃ ws, ValOf ({ prog := E.prog } : TEnv) e ws ∧ ws.length = 0) → N ≤ E'.ini l0)
    (hini : ∀ l, E.ini l ≤ E'.ini l ∧ (E'.ini l = E.ini l ∨ l = l0))
    (hil : E'.ini l0 ≤ max (E.ini l0) (E'.rini l0)) (hse : E'.seen = E.seen)
    (hfp : E'.fp = E.fp := by first | rfl | assumption)
    (hri : ∀ l, E.rini l ≤ E'.rini l := by rini_le)
    (hrl : (∀ l, E.rini l ≤ E.ini l) → ∀ l, E'.rini l ≤ E'.ini l := by rini_ini)
    (hrw : RiniW E E' s s'.vs.vWr := by riniW_tac)
    (hrq : ∀ l, E'.rini l = E.rini l ∨ l = l0 := by rini_eq)
    (harr : E'.rini l0 = E.rini l0 ∨ ArrAt E l0 := by first | exact .inl rfl | assumption)
    (hgp : g.pf l0 := by first | trivial | assumption) : EFootB W g E E' s s' := by
  have hother : ∀ l, l ≠ l0 → E'.pfr l = E.pfr l := fun l h => by rw [hpf l]; simp [h]
  refine ⟨hp, ht, fun l => .inl (by rw [hs]), fun l => .inl (by rw [hbx]), fun l => ?_, fun l => ?_,
    fun l h => by rw [hse]; exact h, fun l h => .inl (by rw [hse] at h; exact h), hfp, hri, hrl, hrw,
    fun l => (hrq l).imp id fun h => .inr (by subst h; exact hown),
    IniFixZ_of (fun l => (hini l).2) hrq (fun l _ _ h _ _ _ hf => by subst h; rw [hpf0] at hf; cases hf),
    RiniArr_of hrq (fun l h => by subst h; exact .inr harr),
    fun l _ hne => if h : l = l0 then (by subst h; exact hgp) else absurd (hother l h) hne⟩
  · obtain ⟨h1, h2⟩ := hini l
    refine ⟨h1, ?_⟩
    rcases h2 with h | h
    · exact .inl h
    · subst h; exact .inr (.inr ⟨hown, hil, fun hp => absurd hpf0 hp⟩)
  · by_cases hl : l = l0
    · subst hl
      exact .inr (.inl ⟨hpf0, F, by rw [hpf l]; simp, hFlo, Nat.le_trans hFhi (Nat.le_max_right _ _), hown, hFv, hFh, hZw, hFlt⟩)
    · exact .inl (hother l hl)

/-- (U3, transitive) **The simultaneous plant's footprint**: at a set `Lp` of
own cells with no frontier, each frontier is set to `F l` (between the old
`vWr` and `max vWr size`) and the counts may be raised there; `seen`
unchanged. -/
theorem EFoot_plantSet {W : Ty → Prop} {g : G} {E E' : TEnv} {s s' : St} {Lp : AllocLabel → Prop} {F : AllocLabel → Ts}
    (hp : E'.prog = E.prog) (ht : E'.tid = E.tid) (hs : E'.sto = E.sto) (hbx : E'.box = E.box)
    (hown : ∀ l, Lp l → OwnAt E l) (hpf0 : ∀ l, Lp l → E.pfr l = none)
    (hPin : ∀ l, Lp l → E'.pfr l = some (F l)) (hPne : ∀ l, ¬ Lp l → E'.pfr l = E.pfr l)
    (hFlo : ∀ l, Lp l → s.vs.vWr ≤ F l) (hFhi : ∀ l, Lp l → F l ≤ max s.vs.vWr s.mem.size)
    (hFv : ∀ l, Lp l → s'.vs.vWr ≤ F l) (hFlt : ∀ l, Lp l → F l ≤ s.vs.vWr ∨ F l < s.mem.size) (hFh : ∀ l, Lp l → ∀ u, HoldW E s l u → u ≤ F l)
    (hZw : ∀ l, Lp l → ¬ E'.seen l → ∀ cl N e us, E'.sto l = some cl → cl.ty = .array (.lit N) e →
      accs e = some us → nWords us = 0 → (∃ ws, ValOf ({ prog := E.prog } : TEnv) e ws ∧ ws.length = 0) → N ≤ E'.ini l)
    (hini : ∀ l, E.ini l ≤ E'.ini l ∧ (E'.ini l = E.ini l ∨ Lp l))
    (hil : ∀ l, Lp l → E'.ini l ≤ max (E.ini l) (E'.rini l)) (hse : E'.seen = E.seen)
    (hfp : E'.fp = E.fp := by first | rfl | assumption)
    (hri : ∀ l, E.rini l ≤ E'.rini l := by rini_le)
    (hrl : (∀ l, E.rini l ≤ E.ini l) → ∀ l, E'.rini l ≤ E'.ini l := by rini_ini)
    (hrw : RiniW E E' s s'.vs.vWr := by riniW_tac)
    (hrq : ∀ l, E'.rini l = E.rini l ∨ Lp l := by first | exact fun _ => .inl rfl | assumption)
    (harr : ∀ l, Lp l → E'.rini l = E.rini l ∨ ArrAt E l := by
      first | exact fun _ _ => .inl rfl | assumption)
    (hgp : ∀ l, Lp l → g.pf l := by first | exact fun _ _ => trivial | assumption) :
    EFootB W g E E' s s' := by
  refine ⟨hp, ht, fun l => .inl (by rw [hs]), fun l => .inl (by rw [hbx]), fun l => ?_, fun l => ?_,
    fun l h => by rw [hse]; exact h, fun l h => .inl (by rw [hse] at h; exact h), hfp, hri, hrl, hrw,
    fun l => (hrq l).imp id fun h => .inr (hown l h),
    IniFixZ_of (fun l => (hini l).2) hrq (fun l _ _ h _ _ _ hf => by rw [hpf0 l h] at hf; cases hf),
    RiniArr_of hrq (fun l h => .inr (harr l h)),
    fun l _ hne => Classical.byContradiction fun hn => hne (hPne l fun h => hn (hgp l h))⟩
  · obtain ⟨h1, h2⟩ := hini l
    exact ⟨h1, h2.imp id fun h => .inr ⟨hown l h, hil l h, fun hp => absurd (hpf0 l h) hp⟩⟩
  · by_cases hl : Lp l
    · exact .inr (.inl ⟨hpf0 l hl, F l, hPin l hl, hFlo l hl, hFhi l hl, hown l hl, hFv l hl, hFh l hl, hZw l hl, hFlt l hl⟩)
    · exact .inl (hPne l hl)

/-- (S8b) `E` with a new box at `lbl`, seen at frontier `F`. -/
def seeBoxE (E : TEnv) (lbl : AllocLabel) (B : Box) (F : Ts) : TEnv :=
  { E with box := fun l => if l = lbl then some B else E.box l,
           pfr := fun l => if l = lbl then some F else E.pfr l,
           seen := fun l => l = lbl ∨ E.seen l }

/-- (S8b) A box creation's footprint: a new own box at the next fresh label,
seen there, with a frontier where there was none. -/
theorem EFoot_seeBox {W : Ty → Prop} {g : G} {E : TEnv} {s s' : St} {B : Box} {F : Ts} (hlt : s.nalloc < s'.nalloc)
    (hB : B.own = E.tid) (hpf0 : E.pfr (freshLabel g.lbase g.n g.i s.nalloc) = none)
    (hsto0 : E.sto (freshLabel g.lbase g.n g.i s.nalloc) = none) (hF : s.mem.size ≤ B.fr + 1)
    (hFw : B.fr ≤ s'.vs.vWr) (hFl : s.mem.size + B.pay.length ≤ B.fr) :
    EFootB W g E (seeBoxE E (freshLabel g.lbase g.n g.i s.nalloc) B F) s s' := by
  have hf : FreshIn g s.nalloc s'.nalloc (freshLabel g.lbase g.n g.i s.nalloc) :=
    ⟨s.nalloc, Nat.le_refl _, hlt, rfl⟩
  refine ⟨rfl, rfl, fun _ => .inl rfl, fun l => ?_, fun _ => ⟨Nat.le_refl _, .inl rfl⟩, fun l => ?_,
    fun l h => Or.inr h, fun l h => ?_, rfl, fun _ => Nat.le_refl _, fun h => h, RiniW_of_eq rfl,
    fun _ => .inl rfl, fun _ _ _ _ _ _ _ => ⟨rfl, rfl⟩, RiniArr_refl,
    PfrG_of fun l hs => by
      by_cases h : l = freshLabel g.lbase g.n g.i s.nalloc
      · subst h; exact absurd hsto0 hs
      · simp [seeBoxE, h]⟩
  · by_cases h : l = freshLabel g.lbase g.n g.i s.nalloc
    · exact .inr ⟨by rw [h]; exact hf, B, by simp [seeBoxE, h], hB, hF, hFw, hFl⟩
    · exact .inl (by simp [seeBoxE, h])
  · by_cases h : l = freshLabel g.lbase g.n g.i s.nalloc
    · subst h; exact .inr (.inr ⟨hf, hpf0, hsto0⟩)
    · exact .inl (by simp [seeBoxE, h])
  · rcases h with h | h
    · subst h; exact .inr (.inr hf)
    · exact .inl h

/-- (box L1) A box creation meets `BoxNewV` when its payload views do. -/
theorem BoxNewV_seeBox {E : TEnv} {lbl : AllocLabel} {B : Box} {F : Ts} {s : St} {th : TTh}
    (h0 : E.box lbl = none)
    (h : ∀ e env0, th.env = e :: env0 → TermViewInv.StV s → TermViewInv.EnvV s.mem.size env0 →
      ∀ w ∈ B.pay, ∀ (a : Address) (g : Nat), w.val = .loc a g → w.view < B.fr) :
    BoxNewV E (seeBoxE E lbl B F) s th := by
  intro l B' hl hB'
  by_cases e : l = lbl
  · subst e
    simp only [seeBoxE, ↓reduceIte, Option.some.injEq] at hB'
    subst hB'
    exact h
  · simp only [seeBoxE, e, ↓reduceIte] at hB'
    rw [hl] at hB'
    cases hB'

/-- (box L1) Bumped payload words with views below `n`, at most `V ≤ n`, lie below a frontier
`fr ≥ n + length` (the payload is nonempty once it has a word). -/
theorem payV_lt {V n fr : Nat} {p : List Word} (hp : TermViewInv.WsV n p) (hV : V ≤ n)
    (hfr : n + (p.map (bumpW V)).length ≤ fr) :
    ∀ w ∈ p.map (bumpW V), ∀ (a : Address) (g : Nat), w.val = .loc a g → w.view < fr := by
  intro w hw a g _
  obtain ⟨w0, h0, rfl⟩ := List.mem_map.1 hw
  have h1 := hp w0 h0
  have hl : 0 < (p.map (bumpW V)).length := List.length_pos_of_mem hw
  have h2 : max w0.view V ≤ n := Nat.max_le.2 ⟨Nat.le_trans h1.1 h1.2, hV⟩
  show max w0.view V < fr
  exact Nat.lt_of_le_of_lt h2 (by omega)

/-- (box L1) `EnvV` of an environment extended by one binding gives `EnvV` of its tail. -/
theorem envV_tail {n : Nat} {x : String} {t : Ty} {ws : List Word} {env env0 : Env}
    {e : String × Ty × List Word} (he : ((x, t, ws) :: env : Env) = e :: env0)
    (h : TermViewInv.EnvV n env0) : TermViewInv.EnvV n env := by
  injection he with _ h2
  subst h2
  exact h

/-- (box L1) A box's payload read by `projM`: views below the (unchanged) memory size. -/
theorem pV_of_proj {g : G} {s s1 : St} {t rt : Ty} {ws : List Word} {j : Nat} {p1 : List Word} {env : Env}
    {a : At} (h1 : (s1, j, p1) ∈ projM g s t ws) (hea : evalAt env a = some (rt, ws)) :
    TermViewInv.StV s → TermViewInv.EnvV s.mem.size env →
      TermViewInv.WsV s1.mem.size p1 ∧ s1.vs.vRelSt ≤ s1.mem.size := fun hs hev => by
  have h := TermViewInv.projM_V h1 hs (TermViewInv.evalAt_V hev hea)
  exact ⟨by rw [h.2.1]; exact h.2.2, h.1.2.2.2.2.2⟩

theorem allocE_sto_cases {W : Ty → Prop} {E : TEnv} {lbl : AllocLabel} {T : Ty} {mem : Memory} {n0 : Nat}
    (hT : Clo T ∧ mg T = true ∧ noIallV T = true ∧ W T) (hN : NewAtT n0 mem lbl T) (hU : UndefAtT mem lbl T) (l : AllocLabel) :
    (allocE E lbl T).sto l = E.sto l ∨
      (l = lbl ∧ ∃ T', (allocE E lbl T).sto l = some ⟨T', some E.tid⟩ ∧ (Clo T' ∧ mg T' = true ∧ noIallV T' = true ∧ W T') ∧ UndefAtT mem l T' ∧
        NewAtT n0 mem l T') := by
  by_cases h : l = lbl
  · subst h; exact .inr ⟨rfl, T, allocE_eq, hT, hU, hN⟩
  · exact .inl (allocE_ne h)

/-- (UndefNew) `alloc` (`new`) leaves an `undef` placeholder at every unit of the new label. -/
theorem alloc_undefT {k : Promises.Knobs} {arch : Arch} {lbl : AllocLabel} {us : List Acc}
    {ws : List Word} {s s' : St} {pw : Word} {T : Ty} (hr : (s', pw) ∈ alloc k arch lbl us ws s)
    (hw : wc T = some (nWords us)) : UndefAtT s'.mem lbl T := by
  intro _
  obtain ⟨L, hL, hn⟩ := wc_some hw
  refine .inl ⟨L, hL, fun o ho => ?_⟩
  rw [hn] at ho
  obtain ⟨s1, hst, -, -, -, -, -, -, -, -, -, hget⟩ := alloc_unf hr
  have h1 : s1.mem[s.mem.size + o]? = some ⟨⟨lbl, o⟩, .undef, 0⟩ := by
    rw [hget]
    have a1 : ¬ (s.mem.size + o < s.mem.size) := by omega
    have a2 : s.mem.size + o < s.mem.size + nWords us := by omega
    simp only [a1, a2, ite_false, ite_true, Nat.add_sub_cancel_left]
  have hx := (TermLiveProps.storeUnits_ext hst).mem
  have hlt : s.mem.size + o < s1.mem.size := by
    cases hq : s1.mem[s.mem.size + o]? with
    | none => rw [hq] at h1; cases h1
    | some _ => exact (Array.getElem?_eq_some_iff.1 hq).1
  refine ⟨s.mem.size + o, ⟨⟨lbl, o⟩, .undef, 0⟩, ?_, rfl, rfl⟩
  show (s', pw).1.mem[s.mem.size + o]? = _
  rw [hx.get _ hlt]; exact h1

theorem ite_box_cases {E : TEnv} {lbl : AllocLabel} {B : Box} (hB : B.own = E.tid) (l : AllocLabel) :
    (if l = lbl then some B else E.box l) = E.box l ∨
      (l = lbl ∧ ∃ B', (if l = lbl then some B else E.box l) = some B' ∧ B'.own = E.tid) := by
  by_cases h : l = lbl
  · exact .inr ⟨h, B, by simp [h], hB⟩
  · exact .inl (by simp [h])

theorem ite_ini_cases (ini : AllocLabel → Nat) (l0 : AllocLabel) (m : Nat) (l : AllocLabel) :
    ini l ≤ (if l = l0 then max (ini l) m else ini l) ∧
      ((if l = l0 then max (ini l) m else ini l) = ini l ∨ l = l0) := by
  by_cases h : l = l0
  · have e : (if l = l0 then max (ini l) m else ini l) = max (ini l) m := by simp [h]
    rw [e]; exact ⟨Nat.le_max_left _ _, .inr h⟩
  · have e : (if l = l0 then max (ini l) m else ini l) = ini l := by simp [h]
    rw [e]; exact ⟨Nat.le_refl _, .inl rfl⟩

theorem lt_of_eq_succ {a b : Nat} (h : b = a + 1) : a < b := by omega

/-- Two states agree on everything `MemInv` reads. -/
def Same (s s' : St) : Prop :=
  s'.mem = s.mem ∧ s'.pairs = s.pairs ∧ s'.vs = s.vs ∧ s'.promises = s.promises ∧ s'.nalloc = s.nalloc


theorem MemInv_same {g : G} {E : TEnv} {s s' : St} (h : MemInv g E s) (hs : Same s s') : MemInv g E s' := by
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11⟩ := h
  obtain ⟨e1, e2, e3, e4, e5⟩ := hs
  refine ⟨by rw [e1, e2, e4]; exact h1, by rw [e1, e2, e3, e4]; exact h2,
    by unfold PromLt at h3 ⊢; rw [e1, e4]; exact h3,
    ⟨fun j hj => ?_, by unfold PrivCoh; rw [e1, e3, e4]; exact h4.2⟩, by rw [e3]; exact h5,
    by rw [e1, e3, e4]; exact h6, by rw [e1, e4]; exact h7, h8.eqv (Nat.le_of_eq (by rw [e3])) e1 e4,
    ⟨h9.1, h9.2.1, h9.2.2.1, by unfold PubMem PubPair PubLive; rw [e1, e2, e4]; exact h9.2.2.2⟩, ?_,
    PromOK_eq h11 e2 e4⟩
  · obtain ⟨f1, f2, f4, f5⟩ := h4.1 j (by rw [← e5]; exact hj)

    exact ⟨f1, by rw [e1, e4]; exact f2, f4, f5⟩
  · exact BoxInv_eqs h10 e1 (by rw [e3]) e4 e5

/-- (P7) A published cell's type is coupled (`PubCpl`). -/
theorem MemInv_cplT {g : G} {E : TEnv} {s : St} {l : AllocLabel} {c : Cell} {f : Ts}
    (hm : MemInv g E s) (hsto : E.sto l = some c) (hf : E.pfr l = some f) : Ty.coupledOKIn [] c.ty = true :=
  (hm.2.2.2.2.2.2.2.2.1.2.2.1 l c f hsto hf).2.2.1

/-- (B.3) A published cell's type reaches no `own` reference (`PubCpl`): its
messages transfer between threads (`WordOK_transfer`). -/
theorem MemInv_noOwnT {g : G} {E : TEnv} {s : St} {l : AllocLabel} {c : Cell} {f : Ts}
    (hm : MemInv g E s) (hsto : E.sto l = some c) (hf : E.pfr l = some f) : Ty.noOwnIn [] c.ty = true :=
  (hm.2.2.2.2.2.2.2.2.1.2.2.1 l c f hsto hf).2.2.2.1

/-- (S7) A published cell's type is region-free (`PubCpl`). -/
theorem MemInv_rgnFreeT {g : G} {E : TEnv} {s : St} {l : AllocLabel} {c : Cell} {f : Ts}
    (hm : MemInv g E s) (hsto : E.sto l = some c) (hf : E.pfr l = some f) : rgnFree c.ty = true :=
  (hm.2.2.2.2.2.2.2.2.1.2.2.1 l c f hsto hf).2.2.2.2

/-- (P6) `MemInv`'s promise bookkeeping at a thread's state. -/
theorem MemInv_nodup {g : G} {E : TEnv} {mem : Memory} {pairs : List Ts} {th : TTh}
    (hm : MemInv g E (stOf mem pairs th)) : th.promises.Nodup :=
  hm.2.2.2.2.2.2.2.2.2.2.1

theorem MemInv_nopair {g : G} {E : TEnv} {mem : Memory} {pairs : List Ts} {th : TTh}
    (hm : MemInv g E (stOf mem pairs th)) : ∀ t, t ∈ th.promises → t ∉ pairs :=
  hm.2.2.2.2.2.2.2.2.2.2.2.1

/-! ### (M2b) Placeholder hiding across steps -/

theorem WordOK_mono {η₁ η₂ : TEnv} (hp : η₁.prog = η₂.prog) (ht : η₁.tid = η₂.tid)
    (hs : ∀ l c, η₁.sto l = some c → η₂.sto l = some c) (hi : ∀ l, η₁.ini l ≤ η₂.ini l)
    (hP : ∀ l f, η₁.pfr l = some f → η₂.pfr l = some f) (hS : ∀ l, η₁.seen l → η₂.seen l)
    {T : Ty} {o : Nat} {w : Word} (h : WordOK η₁ T o w)
    (hB : ∀ l B, η₁.box l = some B → η₂.box l = some B := by first | exact fun _ _ h => h | simp_all | (intro _ _ h; simpa [CE, TEnv.withSto] using h))
    (hri : ∀ l, η₁.rini l ≤ η₂.rini l := by rini_le) : WordOK η₂ T o w := by
  obtain ⟨b, S, ws, o', w0, h1, h2, h3, h4, h5⟩ := h
  exact ⟨b, S, ws, o', w0, h1, ⟨ValOf_mono hp ht hs hi h2.1 hP hS hB, h2.2⟩, h3, h4, h5⟩

/-- Every message appended past `M` is a word of its cell. -/
def NewOK (η : TEnv) (M M' : Memory) : Prop :=
  ∀ (t : Nat) (m : Msg) (c : Cell), M.size ≤ t → M'[t]? = some m → η.sto m.loc.label = some c →
    WordOK η c.ty m.loc.offset (mw m)


/-- (T3c-7) `NewOK_store`, whether or not the store fulfils promises. -/
theorem NewOK_storeF {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool}
    {η : TEnv} {c : Cell} {b o0 : Nat} {S : Ty} {vals : List Word} {V : Ts} (hc : η.sto a.label = some c)
    (hseg : SegOf c.ty b S) (hbo : a.offset = b + o0) (hv : ValOfS η S vals) {us : List Acc}
    {ws : List Word} {s : St}
    (hw : ∀ j w, ws[j]? = some w → vals[o0 + j]? = some (bumpW V w)) (hV : V ≤ s.vs.vRelSt) :
    ∀ s', s' ∈ storeUnits k arch pw a rel us ws 0 s → NewOK η s.mem s'.mem := by
  intro s' hs t m c' ht hm hc'
  obtain ⟨hl, hok⟩ := storeUnits_newOKF hc hseg hbo hv us ws 0 s
    (fun j w h => ⟨bumpW V w, by rw [Nat.add_zero]; exact hw j w h, WLe1_refl _⟩) hV s' hs t m ht hm
  rw [hl, hc] at hc'
  cases hc'
  exact hok

theorem OwnHid_grow {η : TEnv} {M M' : Memory} {vs vs' : VState} (h : OwnHid η M vs)
    (hV : vs.vWr ≤ vs'.vWr) (hold : ∀ t, t < M.size → M'[t]? = M[t]?) (hn : NewOK η M M') :
    OwnHid η M' vs' := fun l c hc ho o hi =>
  Hidden_grow (h l c hc ho o hi) (fun _ h => h) hV hold (fun t m ht hm hl => by
    have := hn t m c ht hm (by rw [hl]; exact hc); rw [hl] at this; exact this)

theorem PubDef_grow {η : TEnv} {M M' : Memory} (h : PubDef η M)
    (hold : ∀ t, t < M.size → M'[t]? = M[t]?) (hn : NewOK η M M') : PubDef η M' :=
  fun l c f hc hown hf o hi =>
  Hidden_grow (h l c f hc hown hf o hi) (fun _ h => h) (Nat.le_refl _) hold (fun t m ht hm hl => by
    have := hn t m c ht hm (by rw [hl]; exact hc); rw [hl] at this; exact this)

/-- Memory that grows only at another label keeps `⟨l, o⟩` hidden. -/
theorem Hidden_growsAt {η η' : TEnv} {T : Ty} {M M' : Memory} {l lbl : AllocLabel} {o : Nat} {V V' : Ts}
    (h : Hidden η T M l o V) (hw : ∀ w, WordOK η T o w → WordOK η' T o w) (hV : V ≤ V')
    (hg : GrowsAt M M' lbl) (hne : l ≠ lbl) : Hidden η' T M' l o V' :=
  Hidden_grow h hw hV hg.2.1 (fun t m ht hm hl =>
    absurd (by have e := hg.2.2 t m ht hm; rw [hl] at e; exact e) hne)

/-- (S4) `Hidden_growsAt` with promises skipped: the promises fulfilled are at
the growing label. -/
theorem HiddenP_growsAt {η η' : TEnv} {T : Ty} {M M' : Memory} {P P' : List Ts} {l lbl : AllocLabel} {o : Nat}
    {V V' : Ts} (h : HiddenP η T M P l o V) (hw : ∀ w, WordOK η T o w → WordOK η' T o w) (hV : V ≤ V')
    (hg : GrowsAt M M' lbl) (hne : l ≠ lbl)
    (hful : ∀ t, t ∈ P → t ∉ P' → ∃ m, M[t]? = some m ∧ m.loc.label = lbl) : HiddenP η' T M' P' l o V' :=
  HiddenP_grow h hw hV hg.2.1 (fun t m ht hm hl =>
    absurd (by have e := hg.2.2 t m ht hm; rw [hl] at e; exact e) hne)
    (fun t m ht ht' hm hl => absurd (by
      obtain ⟨m', hm', e⟩ := hful t ht ht'
      rw [hm] at hm'; cases hm'; rw [hl] at e; exact e) hne)

/-- (S4) `OwnHid_grow` with promises skipped. -/
theorem OwnHidP_grow {η : TEnv} {M M' : Memory} {vs vs' : VState} {P P' : List Ts} (h : OwnHidP η M vs P)
    (hV : vs.vWr ≤ vs'.vWr) (hold : ∀ t, t < M.size → M'[t]? = M[t]?) (hn : NewOK η M M')
    (hful : ∀ (t : Nat) (m : Msg) (c : Cell), t ∈ P → t ∉ P' → M[t]? = some m → η.sto m.loc.label = some c →
      WordOK η c.ty m.loc.offset (mw m)) :
    OwnHidP η M' vs' P' :=
  ⟨fun l c hc ho o hi =>
    HiddenP_grow (h.1 l c hc ho o hi) (fun _ h => h) hV hold (fun t m ht hm hl => by
      have := hn t m c ht hm (by rw [hl]; exact hc); rw [hl] at this; exact this)
      (fun t m ht ht' hm hl => by
      have := hful t m c ht ht' hm (by rw [hl]; exact hc); rw [hl] at this; exact this),
   fun l c hc ho hlt => by
    obtain ⟨f, hf, hs, hH⟩ := h.2 l c hc ho hlt
    exact ⟨f, hf, hs, fun o hi => HiddenP_grow (hH o hi) (fun _ h => h) (Nat.le_refl _) hold
      (fun t m ht hm hl => by
        have := hn t m c ht hm (by rw [hl]; exact hc); rw [hl] at this; exact this)
      (fun t m ht ht' hm hl => by
        have := hful t m c ht ht' hm (by rw [hl]; exact hc); rw [hl] at this; exact this)⟩⟩

/-- (S4) `HiddenP` at a later bound. -/
theorem HiddenP_le {η : TEnv} {T : Ty} {mem : Memory} {P : List Ts} {l : AllocLabel} {o : Nat} {V V' : Ts}
    (h : HiddenP η T mem P l o V) (hle : V ≤ V') : HiddenP η T mem P l o V' := fun t m h1 h2 h3 h4 => by
  obtain ⟨t', m', a1, a2, a3, a4⟩ := h t m h1 h2 h3 h4
  exact ⟨t', m', a1, Nat.le_trans a2 hle, a3, a4⟩

/-- (F2′ (a′)) **`OwnHidP` across a step that keeps each own cell** (its counts,
frontier, and not-seen-ness) and keeps hiding (bounds may grow). -/
theorem OwnHidP.imp {η η' : TEnv} {M M' : Memory} {vs vs' : VState} {P P' : List Ts} (h : OwnHidP η M vs P)
    (hc : ∀ l c, η'.sto l = some c → c.owner = some η'.tid →
      η.sto l = some c ∧ c.owner = some η.tid ∧ η'.ini l = η.ini l ∧ η'.rini l = η.rini l ∧
        η'.pfr l = η.pfr l ∧ (η'.seen l → η.seen l))
    (hH : ∀ l c o V V', η.sto l = some c → V ≤ V' → HiddenP η c.ty M P l o V → HiddenP η' c.ty M' P' l o V')
    (hV : vs.vWr ≤ vs'.vWr) : OwnHidP η' M' vs' P' :=
  ⟨fun l c hc' ho o hi => by
    obtain ⟨hs, ho', hi', hri, -, -⟩ := hc l c hc' ho
    exact hH l c o _ _ hs hV (h.1 l c hs ho' o (fun N e us h1 h2 => by
      rw [← TEnv.rc_congr hi' hri]; exact hi N e us h1 h2)),
   fun l c hc' ho hlt => by
    obtain ⟨hs, ho', hi', hri, hpf, hse⟩ := hc l c hc' ho
    obtain ⟨f, hf, hns, hH'⟩ := h.2 l c hs ho' (by rw [← TEnv.rc_congr hi' hri, ← hi']; exact hlt)
    exact ⟨f, by rw [hpf]; exact hf, fun hz h' => hns (fun hz0 => hz ((ZW.stoAt (hc'.trans hs.symm)).2 hz0)) (hse h'),
      fun o hi => hH l c o _ _ hs (Nat.le_refl _)
      (hH' o (fun N e us h1 h2 => by rw [← hi']; exact hi N e us h1 h2))⟩⟩

/-- (S4) `PubDef_grow` with promises skipped. -/
theorem PubDefP_grow {η : TEnv} {M M' : Memory} {P P' : List Ts} (h : PubDefP η M P)
    (hold : ∀ t, t < M.size → M'[t]? = M[t]?) (hn : NewOK η M M')
    (hful : ∀ (t : Nat) (m : Msg) (c : Cell), t ∈ P → t ∉ P' → M[t]? = some m → η.sto m.loc.label = some c →
      WordOK η c.ty m.loc.offset (mw m)) : PubDefP η M' P' :=
  fun l c f hc hown hf o hi =>
  HiddenP_grow (h l c f hc hown hf o hi) (fun _ h => h) (Nat.le_refl _) hold (fun t m ht hm hl => by
    have := hn t m c ht hm (by rw [hl]; exact hc); rw [hl] at this; exact this)
    (fun t m ht ht' hm hl => by
    have := hful t m c ht ht' hm (by rw [hl]; exact hc); rw [hl] at this; exact this)

/-! ### (M4b) `PubInv` across steps -/

theorem PairOK_mono {η₁ η₂ : TEnv} (hp : η₁.prog = η₂.prog) (ht : η₁.tid = η₂.tid)
    (hs : ∀ l c, η₁.sto l = some c → η₂.sto l = some c) (hi : ∀ l, η₁.ini l ≤ η₂.ini l)
    (hP : ∀ l f, η₁.pfr l = some f → η₂.pfr l = some f) (hS : ∀ l, η₁.seen l → η₂.seen l)
    {T : Ty} {o : Nat} {w0 w1 : Word} (h : PairOK η₁ T o w0 w1)
    (hB : ∀ l B, η₁.box l = some B → η₂.box l = some B := by first | exact fun _ _ h => h | simp_all | (intro _ _ h; simpa [CE, TEnv.withSto] using h))
    (hri : ∀ l, η₁.rini l ≤ η₂.rini l := by rini_le) : PairOK η₂ T o w0 w1 := by
  obtain ⟨b, S, ws, o', x0, x1, h1, h2, h3, h4, h5, h6, h7⟩ := h
  exact ⟨b, S, ws, o', x0, x1, h1, ⟨ValOf_mono hp ht hs hi h2.1 hP hS hB, h2.2⟩, h3, h4, h5, h6, h7⟩

/-- A message hidden in a memory stays hidden as the memory grows. -/
theorem hiddenFrom_back {M M' : Memory} (hold : ∀ t, t < M.size → M'[t]? = M[t]?) {a : Address}
    {t b : Ts} (h : WeakMem.hiddenFrom M' a t b = false) : WeakMem.hiddenFrom M a t b = false := by
  unfold WeakMem.hiddenFrom at h ⊢
  rw [List.any_eq_false] at h ⊢
  intro x hx hc
  apply h x hx
  cases e : M[x]? with
  | none => rw [e] at hc; simp at hc
  | some m => rw [hold x (lt_of_get e), e]; rw [e] at hc; exact hc

/-- A pair store straddling two reads still does as memory and pairs grow. -/
theorem pairStraddles_back {M M' : Memory} {P P' : List Ts} (hold : ∀ t, t < M.size → M'[t]? = M[t]?)
    (hP : ∀ p ∈ P, p ∈ P') (hP3 : ∀ p ∈ P, p + 1 < M.size) {a : Address} {t0 t1 : Ts}
    (h : WeakMem.pairStraddles M' P' a t0 t1 = false) : WeakMem.pairStraddles M P a t0 t1 = false := by
  unfold WeakMem.pairStraddles at h ⊢
  rw [List.any_eq_false] at h ⊢
  intro p hp hc
  have h1 := hP3 p hp
  apply h p (hP p hp)
  rw [hold p (Nat.lt_of_succ_lt h1), hold (p + 1) h1]; exact hc

/-- A laid-out cell type is its only segment. -/
theorem SegOf_lay {T S : Ty} {b : Nat} (h : accs T ≠ none) (hs : SegOf T b S) : b = 0 ∧ S = T := by
  rcases hs with ⟨h1, h2, -⟩ | ⟨N, us, j, hT, -, -, -⟩
  · exact ⟨h1, h2⟩
  · rw [hT] at h; simp [accs] at h

/-- An own cell's words say its type has a layout. -/
theorem LayT_of_CellOK {E : TEnv} {n : Nat} {T : Ty} {vals : List Word} (h : CellOK E n T vals) : LayT T := by
  rcases h with ⟨hwc, -⟩ | ⟨N, e, us, hT, hus, -⟩
  · left; intro h; simp [wc, h] at hwc
  · exact Or.inr ⟨N, e, hT, by rw [hus]; simp⟩

theorem TwoAtT_lay {T : Ty} {us : List Acc} {o : Nat} (hu : accs T = some us) (h : TwoAtT T o) :
    TwoAt us o := by
  obtain ⟨b, S, us', o', hseg, hu', htw, rfl⟩ := h
  obtain ⟨rfl, rfl⟩ := SegOf_lay (by rw [hu]; simp) hseg
  rw [hu] at hu'; cases hu'; simpa using htw

/-- **`PubInv` across own growth**: memory grows only at an own label `lab`,
pairs only grow, and `E'` extends `E` with own cells that have no frontier;
(M5a) a segment initialised in `E'` was initialised in `E` or is inhabited. -/
theorem PubInv_grow {E E' : TEnv} {s s' : St} {lab : AllocLabel} (h : PubInv E s)
    (hP3 : ∀ p ∈ s.pairs, p + 1 < s.mem.size) (hg : GrowsAt s.mem s'.mem lab)
    (hpp : ∀ p ∈ s.pairs, p ∈ s'.pairs)
    (hful : ∀ t, t ∈ s.promises → t ∉ s'.promises → ∃ m, s.mem[t]? = some m ∧ m.loc.label = lab)
    (hp : E.prog = E'.prog) (ht : E.tid = E'.tid) (hs : ∀ l c, E.sto l = some c → E'.sto l = some c)
    (hile : ∀ l, E.ini l ≤ E'.ini l) (hpf : E'.pfr = E.pfr) (hse : E'.seen = E.seen)
    (hlab : ∀ c, E'.sto lab = some c → c.owner = some E'.tid)
    (hsb : ∀ l c, E'.sto l = some c → E.sto l = some c ∨ E.pfr l = none)
    (hinh : ∀ l c b S us, E'.sto l = some c → SegOf c.ty b S → accs S = some us → IniSeg E' c l b →
      (E.sto l = some c ∧ IniSeg E c l b) ∨ ∃ ws, ValOf E' S ws ∧ ws.length = nWords us)
    (hbx : ∀ l B, E.box l = some B → E'.box l = some B := by first | exact fun _ _ h => h | simp_all | (intro _ _ h; simpa [CE, TEnv.withSto] using h))
    (hbs : ∀ l, E.box l ≠ none → E.sto l = none → E'.sto l = none := by
      first | exact fun _ _ h => h | (intro _ _ h; simpa [CE, TEnv.withSto] using h))
    (hri : ∀ l, E.rini l ≤ E'.rini l := by rini_le)
    (hpl : ∀ c, E'.sto lab = some c → E'.rc lab < E'.ini lab → ∀ (t : Nat) (m : Msg) (o : Nat),
      ((s.mem.size ≤ t ∧ s'.mem[t]? = some m) ∨ (t ∈ s.promises ∧ t ∉ s'.promises ∧ s.mem[t]? = some m)) →
      m.loc = ⟨lab, o⟩ → ∀ b S us, SegOf c.ty b S → accs S = some us → b ≤ o → o < b + nWords us →
      IniSegN (E'.rc lab) c b)
    (hrcg : ∀ l, E'.rc l < E'.ini l → E.rc l < E.ini l ∧ E'.ini l ≤ E.ini l)
    (hfi : ∀ l c, E'.sto l = some c → c.owner ≠ some E'.tid → E'.ini l ≤ E.ini l := by
      first | exact fun _ _ _ _ => Nat.le_refl _ | (intro _ _ _ _; exact Nat.le_refl _)) :
    PubInv E' s' := by
  obtain ⟨hS, hI, hC, hPP, hLV⟩ := h
  have hPm : ∀ l f, E.pfr l = some f → E'.pfr l = some f := fun l f h => by rw [hpf]; exact h
  have hSm : ∀ l, E.seen l → E'.seen l := fun l h => by rw [hse]; exact h
  have hc0 : ∀ l c f, E'.sto l = some c → E.pfr l = some f → E.sto l = some c := fun l c f hc hf => by
    rcases hsb l c hc with h0 | h0
    · exact h0
    · rw [h0] at hf; cases hf
  refine ⟨fun l hl => ?_, fun l c b S us hc hseg hu hini => ?_, fun l c f hc hf => ?_, ?_, ?_⟩
  · rcases hS l (by rw [← hse]; exact hl) with ⟨c, h1, h2⟩ | ⟨h1, h2⟩
    · exact .inl ⟨c, hs l c h1, by rw [← ht]; exact h2⟩
    · cases hB : E.box l with
      | none => exact absurd hB h2
      | some B => exact .inr ⟨hbs l h2 h1, by rw [hbx l B hB]; simp⟩
  · rcases hinh l c b S us hc hseg hu hini with ⟨h0, h1⟩ | h0
    · obtain ⟨ws, h2, h3⟩ := hI l c b S us h0 hseg hu h1
      exact ⟨ws, ValOf_mono hp ht hs hile h2 hPm hSm hbx, h3⟩
    · exact h0
  · rw [hpf] at hf
    exact hC l c f (hc0 l c f hc hf) hf
  · intro l c f o hc hown hf htw t0 t1 m0 m1 hn0 hn1 hm0 hm1 hl0 hl1 hh0 hh1 hst
    rw [hpf] at hf
    have hown0 : (c.owner ≠ some E.tid ∧ ∃ b S us o', SegOf c.ty b S ∧ accs S = some us ∧
        TwoAt us o' ∧ o = b + o' ∧ IniSegN (E.ini l) c b) ∨ (E.rc l < E.ini l ∧ ∃ b S us o', SegOf c.ty b S ∧
        accs S = some us ∧ TwoAt us o' ∧ o = b + o' ∧ ¬ IniSegN (E.rc l) c b ∧ IniSegN (E.ini l) c b) := by
      rcases hown with ⟨h, b, S, us, o', h2, h3, h4, h5, h7⟩ | ⟨h1, b, S, us, o', h2, h3, h4, h5, h6, h7⟩
      · exact .inl ⟨by rw [ht]; exact h, b, S, us, o', h2, h3, h4, h5, h7.mono (hfi l c hc h)⟩
      · exact .inr ⟨(hrcg l h1).1, b, S, us, o', h2, h3, h4, h5,
          fun h8 => h6 (h8.mono (TEnv.rc_mono hile hri l)), h7.mono (hrcg l h1).2⟩
    have hex : ∀ (t : Nat) (m : Msg) (k : Nat),
        ((s.mem.size ≤ t ∧ s'.mem[t]? = some m) ∨ (t ∈ s.promises ∧ t ∉ s'.promises ∧ s.mem[t]? = some m)) →
        m.loc.label = lab → m.loc = ⟨l, o + k⟩ → k < 2 → False := by
      intro t m k hcase hlab' hloc hk
      have hll : l = lab := by rw [hloc] at hlab'; exact hlab'
      subst hll
      rcases hown with ⟨h, -⟩ | ⟨h1, b, S, us, o', h2, h3, h4, h5, h6, -⟩
      · exact h (hlab c hc)
      · have := TwoAt_lt h4
        exact h6 (hpl c hc h1 t m (o + k) hcase hloc b S us h2 h3 (by omega) (by omega))
    have hold : ∀ (t : Nat) (m : Msg) (k : Nat), s'.mem[t]? = some m → m.loc = ⟨l, o + k⟩ → k < 2 →
        s.mem[t]? = some m := by
      intro t m k hm hloc hk
      by_cases hlt : t < s.mem.size
      · rw [← hg.2.1 t hlt]; exact hm
      · exact (hex t m k (.inl ⟨by omega, hm⟩) (hg.2.2 t m (by omega) hm) hloc hk).elim
    have hnp : ∀ (t : Nat) (m : Msg) (k : Nat), t ∉ s'.promises → s.mem[t]? = some m →
        m.loc = ⟨l, o + k⟩ → k < 2 → t ∉ s.promises := by
      intro t m k hn hm hloc hk ht'
      obtain ⟨m', hm', hl'⟩ := hful t ht' hn
      rw [hm] at hm'; cases hm'
      exact hex t m k (.inr ⟨ht', hn, hm⟩) hl' hloc hk
    have h0' := hold t0 m0 0 hm0 (by simp [hl0]) (by omega)
    have h1' := hold t1 m1 1 hm1 hl1 (by omega)
    have := hPP l c f o (hc0 l c f hc hf) hown0 hf htw t0 t1 m0 m1
      (hnp t0 m0 0 hn0 h0' (by simp [hl0]) (by omega)) (hnp t1 m1 1 hn1 h1' hl1 (by omega)) h0' h1' hl0 hl1
      (hiddenFrom_back hg.2.1 hh0) (hiddenFrom_back hg.2.1 hh1) (pairStraddles_back hg.2.1 hpp hP3 hst)
    exact PairOK_mono hp ht hs hile hPm hSm this hbx
  · intro l c f b S us o hc hown hf hseg hu ho
    rw [hpf] at hf
    obtain ⟨t, m, h1, h2⟩ := hLV l c f b S us o (hc0 l c f hc hf) (by rw [ht]; exact hown) hf hseg hu ho
    exact ⟨t, m, by rw [hg.2.1 t (lt_of_get h1)]; exact h1, h2⟩

/-- `PubInv` across a store to an own cell. -/
theorem PubInv_store {E : TEnv} {s s' : St} {lab : AllocLabel} {c : Cell} (h : PubInv E s)
    (hP3 : ∀ p ∈ s.pairs, p + 1 < s.mem.size) (hg : GrowsAt s.mem s'.mem lab)
    (hpp : ∀ p ∈ s.pairs, p ∈ s'.pairs)
    (hful : ∀ t, t ∈ s.promises → t ∉ s'.promises → ∃ m, s.mem[t]? = some m ∧ m.loc.label = lab)
    (hsto : E.sto lab = some c) (hown : c.owner = some E.tid) (hna : ∀ N e, c.ty ≠ .array (.lit N) e) :
    PubInv E s' :=
  PubInv_grow h hP3 hg hpp hful rfl rfl (fun _ _ h => h) (fun _ => Nat.le_refl _) rfl rfl
    (fun c' h => by rw [hsto] at h; rw [← Option.some.inj h]; exact hown) (fun _ _ h => Or.inl h)
    (fun _ _ _ _ _ h _ _ hi => Or.inl ⟨h, hi⟩)
    (hpl := fun c' h _ _ _ _ _ _ _ _ _ _ _ _ _ => by
      unfold IniSegN; intro N e hT
      rw [hsto] at h; rw [← Option.some.inj h] at hT; exact absurd hT (hna N e))
    (hrcg := fun _ h => ⟨h, Nat.le_refl _⟩)

/-- Stores only add pair starts. -/
theorem storeUnits_pairs {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s : St) (s' : St),
      s' ∈ storeUnits k arch pw a rel us ws i s → ∀ p ∈ s.pairs, p ∈ s'.pairs
  | [], _, _, s, s', hs => by
      simp only [storeUnits, List.mem_singleton] at hs; subst hs; exact fun p h => h
  | .one :: us, w :: ws, i, s, s', hs => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, -, hs⟩ := hs
      have := storeUnits_pairs us ws (i + 1) _ s' hs; exact this
  | .two :: us, w0 :: w1 :: ws, i, s, s', hs => by
      simp only [storeUnits] at hs
      obtain ⟨-, q2, -, -, -⟩ := stepStorePair_eq s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0)
        (dataE 2 w1) [0] rel
      intro p hp
      apply storeUnits_pairs us ws (i + 2) _ s' hs
      show p ∈ (Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1)
        [0] rel).2.1
      rw [q2]; exact List.mem_append_left _ hp
  | .one :: _, [], _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [], _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, s', hs => by simp [storeUnits] at hs

theorem alloc_pairs {k : Promises.Knobs} {arch : Arch} {lbl : AllocLabel} {us : List Acc} {ws : List Word}
    {s : St} : ∀ r, r ∈ alloc k arch lbl us ws s → ∀ p ∈ s.pairs, p ∈ r.1.pairs := by
  intro r hr
  simp only [alloc, List.mem_map] at hr
  obtain ⟨s', hs, rfl⟩ := hr
  have := storeUnits_pairs _ _ _ _ s' hs; exact this

/-! ### (F2) Stores at the owner's cells, frontier form -/

/-- Offset `o` starts a one-word unit of access list `us`. -/
def OneAt (us : List Acc) (o : Nat) : Prop :=
  ∃ i, us[i]? = some .one ∧ o = nWords (us.take i)

theorem acc_size_pos (u : Acc) : 0 < u.size := by cases u <;> simp [Acc.size]

theorem nWords_take_mono {us : List Acc} {i j : Nat} (h : i ≤ j) :
    nWords (us.take i) ≤ nWords (us.take j) := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le h
  rw [List.take_add]
  simp [nWords]

theorem start_lt {us : List Acc} {i i' : Nat} {u : Acc} (hu : us[i]? = some u) (h : i < i') :
    nWords (us.take i) + u.size ≤ nWords (us.take i') := by
  rw [← nWords_take_succ hu]; exact nWords_take_mono h

/-- Units of an access list start at distinct offsets, each past the last unit. -/
theorem starts_eq {us : List Acc} {i i' : Nat} {u u' : Acc} (hu : us[i]? = some u) (hu' : us[i']? = some u')
    (h1 : nWords (us.take i) ≤ nWords (us.take i'))
    (h2 : nWords (us.take i') < nWords (us.take i) + u.size) : i = i' := by
  rcases Nat.lt_trichotomy i i' with h | h | h
  · have := start_lt hu h; omega
  · exact h
  · have := start_lt hu' h; have := acc_size_pos u'; omega

theorem TwoAt_not_OneAt {us : List Acc} {o : Nat} (h : TwoAt us o) : ¬ OneAt us o := by
  rintro ⟨i', h1', h2'⟩
  obtain ⟨i, h1, rfl⟩ := h
  have e := starts_eq h1 h1' (by omega) (by simp only [Acc.size]; omega)
  subst e; rw [h1] at h1'; simp at h1'

theorem TwoAt_not_OneAt_succ {us : List Acc} {o : Nat} (h : TwoAt us o) : ¬ OneAt us (o + 1) := by
  rintro ⟨i', h1', h2'⟩
  obtain ⟨i, h1, rfl⟩ := h
  have e := starts_eq h1 h1' (by omega) (by simp only [Acc.size]; omega)
  subst e; omega

theorem TwoAt_not_TwoAt_succ {us : List Acc} {o : Nat} (h : TwoAt us o) : ¬ TwoAt us (o + 1) := by
  rintro ⟨i', h1', h2'⟩
  obtain ⟨i, h1, rfl⟩ := h
  have e := starts_eq h1 h1' (by omega) (by simp only [Acc.size]; omega)
  subst e; omega

theorem OneAt_cons {us : List Acc} {j : Nat} (u : Acc) (h : OneAt us j) : OneAt (u :: us) (j + u.size) := by
  obtain ⟨i, h1, rfl⟩ := h
  exact ⟨i + 1, by simpa using h1, by simp only [nWords, List.take_succ_cons, List.map_cons, List.sum_cons]; omega⟩

theorem TwoAt_cons {us : List Acc} {j : Nat} (u : Acc) (h : TwoAt us j) : TwoAt (u :: us) (j + u.size) := by
  obtain ⟨i, h1, rfl⟩ := h
  exact ⟨i + 1, by simpa using h1, by simp only [nWords, List.take_succ_cons, List.map_cons, List.sum_cons]; omega⟩

theorem OneAt_lt {us : List Acc} {o : Nat} (h : OneAt us o) : o + 1 ≤ nWords us := by
  obtain ⟨i, h1, rfl⟩ := h
  have e := nWords_take_succ h1
  have := nWords_take_le us (i + 1)
  simp only [Acc.size] at e; omega


theorem nWords_take_embed {pre us post : List Acc} {i : Nat} (hi : i ≤ us.length) :
    nWords ((pre ++ us ++ post).take (pre.length + i)) = nWords pre + nWords (us.take i) := by
  rw [List.append_assoc, List.take_append, List.take_of_length_le (by omega), nWords_append,
    Nat.add_sub_cancel_left, List.take_append, show i - us.length = 0 by omega, List.take_zero,
    List.append_nil]

theorem getElem_embed {pre us post : List Acc} {i : Nat} {u : Acc} (h : us[i]? = some u) :
    (pre ++ us ++ post)[pre.length + i]? = some u := by
  have hi : i < us.length := (List.getElem?_eq_some_iff.1 h).1
  rw [List.append_assoc, List.getElem?_append_right (by omega), Nat.add_sub_cancel_left,
    List.getElem?_append_left hi]; exact h

theorem TwoAt_embed {pre us post : List Acc} {j : Nat} (h : TwoAt us j) :
    TwoAt (pre ++ us ++ post) (nWords pre + j) := by
  obtain ⟨i, h1, rfl⟩ := h
  have hi : i ≤ us.length := Nat.le_of_lt (List.getElem?_eq_some_iff.1 h1).1
  exact ⟨pre.length + i, getElem_embed h1, (nWords_take_embed hi).symm⟩

theorem OneAt_embed {pre us post : List Acc} {j : Nat} (h : OneAt us j) :
    OneAt (pre ++ us ++ post) (nWords pre + j) := by
  obtain ⟨i, h1, rfl⟩ := h
  have hi : i ≤ us.length := Nat.le_of_lt (List.getElem?_eq_some_iff.1 h1).1
  exact ⟨pre.length + i, getElem_embed h1, (nWords_take_embed hi).symm⟩

/-- Two laid-out segments holding one offset are one segment. -/
theorem SegOf_unique2 {T S S' : Ty} {b b' o o' : Nat} {L L' : List Acc}
    (h1 : SegOf T b S) (hL : accs S = some L) (ho : o < nWords L)
    (h2 : SegOf T b' S') (hL' : accs S' = some L') (ho' : o' < nWords L') (he : b + o = b' + o') :
    b = b' ∧ S = S' := by
  rcases h1 with ⟨rfl, rfl, -⟩ | ⟨N, us, j, hT, hus, hj, rfl⟩
  · rcases h2 with ⟨rfl, rfl, -⟩ | ⟨N', us', j', hT', -, -, -⟩
    · exact ⟨rfl, rfl⟩
    · rw [hT'] at hL; simp [accs] at hL
  · rcases h2 with ⟨rfl, rfl, hA⟩ | ⟨N', us', j', hT', hus', hj', rfl⟩
    · exfalso; rw [hT] at hA; simp [accs] at hA
    · rw [hT] at hT'; simp only [Ty.array.injEq, Idx.lit.injEq] at hT'
      obtain ⟨rfl, rfl⟩ := hT'
      obtain rfl : us = us' := by rw [hus] at hus'; exact Option.some.inj hus'
      obtain rfl : us = L := by rw [hus] at hL; exact Option.some.inj hL
      obtain rfl : us = L' := by rw [hus] at hL'; exact Option.some.inj hL'
      have : j = j' := by
        rcases Nat.lt_trichotomy j j' with h | h | h
        · have hm := Nat.mul_le_mul_right (nWords us) (show j + 1 ≤ j' by omega)
          rw [Nat.succ_mul] at hm; omega
        · exact h
        · have hm := Nat.mul_le_mul_right (nWords us) (show j' + 1 ≤ j by omega)
          rw [Nat.succ_mul] at hm; omega
      subst this; exact ⟨rfl, rfl⟩

/-- (F2) **What a store leaves untouched**: old messages stay, new ones are at the
stored words, coherence moves only there, and a promise at another address stays. -/
theorem storeUnits_untouched {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s s' : St), s' ∈ storeUnits k arch pw a rel us ws i s →
      (∀ t, t < s.mem.size → s'.mem[t]? = s.mem[t]?) ∧
      (∀ (t : Nat) (m : Msg), s.mem.size ≤ t → s'.mem[t]? = some m → ∃ j, j < nWords us ∧ m.loc = offs a (i + j)) ∧
      (∀ b : Address, (∀ j, j < nWords us → b ≠ offs a (i + j)) → s'.vs.coh b = s.vs.coh b) ∧
      (∀ (t : Ts) (m : Msg), t ∈ s.promises → s.mem[t]? = some m → (∀ j, j < nWords us → m.loc ≠ offs a (i + j)) →
        t ∈ s'.promises)
  | [], _, _, s, s', hs => by
      simp only [storeUnits, List.mem_singleton] at hs; subst hs
      refine ⟨fun _ _ => rfl, fun t m ht hm => ?_, fun _ _ => rfl, fun _ _ h _ _ => h⟩
      rw [Array.getElem?_eq_none ht] at hm; cases hm
  | .one :: us, w :: ws, i, s, s', hs => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      obtain ⟨t0, hcase, hcoh, -, -⟩ := stepStore_casesC hst
      obtain ⟨g1, g2, g3, g4⟩ := storeUnits_untouched us ws (i + 1) _ s' hs
      simp only at g1 g2 g3 g4
      have hsz : s.mem.size ≤ mem'.size := by
        rcases hcase with ⟨hmem, -⟩ | ⟨hmem, -⟩
        · rw [hmem, Array.size_push]; omega
        · rw [hmem]; exact Nat.le_refl _
      have hold : ∀ t, t < s.mem.size → mem'[t]? = s.mem[t]? := fun t ht => by
        rcases hcase with ⟨hmem, -⟩ | ⟨hmem, -⟩
        · rw [hmem, push_lt ht]
        · rw [hmem]
      refine ⟨fun t ht => ?_, fun t m ht hm => ?_, fun b hb => ?_, fun t m ht hm hl => ?_⟩
      · rw [g1 t (Nat.lt_of_lt_of_le ht hsz)]; exact hold t ht
      · by_cases h1 : mem'.size ≤ t
        · obtain ⟨j, hj, hl⟩ := g2 t m h1 hm
          exact ⟨j + 1, by rw [TermMem.nWords_one]; omega, by rw [hl, show i + 1 + j = i + (j + 1) by omega]⟩
        · have h1' : t < mem'.size := Nat.lt_of_not_le h1
          have hm' : mem'[t]? = some m := by rw [← g1 t h1']; exact hm
          rcases hcase with ⟨hmem, -⟩ | ⟨hmem, -⟩
          · rw [hmem, Array.getElem?_push] at hm'
            split at hm'
            · simp only [Option.some.injEq] at hm'; subst hm'
              exact ⟨0, by rw [TermMem.nWords_one]; omega, by simp⟩
            · rename_i hne
              rw [hmem, Array.size_push] at h1'
              exact absurd (show t = s.mem.size by omega) hne
          · rw [hmem] at h1'; omega
      · have hb0 : b ≠ offs a i := by have := hb 0 (by rw [TermMem.nWords_one]; omega); simpa using this
        rw [g3 b (fun j hj => by
          have := hb (j + 1) (by rw [TermMem.nWords_one]; omega)
          rwa [show i + (j + 1) = i + 1 + j by omega] at this)]
        show th.vs.coh b = s.vs.coh b
        rw [hcoh]; simp [hb0, mth]
      · have hl0 : m.loc ≠ offs a i := by have := hl 0 (by rw [TermMem.nWords_one]; omega); simpa using this
        have ht1 : t ∈ th.promises := by
          rcases hcase with ⟨-, -, hprom⟩ | ⟨-, -, hprom, -, m0, hm0, hma0, -⟩
          · rw [hprom]; exact ht
          · rw [hprom]
            refine (List.mem_erase_of_ne fun e => ?_).2 ht
            subst e; rw [hm] at hm0; cases hm0; exact hl0 hma0
        exact g4 t m ht1 (by rw [hold t (lt_of_get hm)]; exact hm) (fun j hj => by
          have := hl (j + 1) (by rw [TermMem.nWords_one]; omega)
          rwa [show i + (j + 1) = i + 1 + j by omega] at this)
  | .two :: us, w0 :: w1 :: ws, i, s, s', hs => by
      simp only [storeUnits] at hs
      obtain ⟨q1, _, q3, q4, _⟩ := stepStorePair_eq s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel
      generalize Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel = R at q1 q3 q4 hs
      obtain ⟨mem', pairs', th⟩ := R
      simp only at q1 q3 q4 hs
      obtain ⟨g1, g2, g3, g4⟩ := storeUnits_untouched us ws (i + 2) _ s' hs
      simp only at g1 g2 g3 g4
      have hsz : mem'.size = s.mem.size + 2 := by rw [q1, Array.size_push, Array.size_push]
      have hold : ∀ t, t < s.mem.size → mem'[t]? = s.mem[t]? := fun t ht => by rw [q1, push2_lt ht]
      refine ⟨fun t ht => ?_, fun t m ht hm => ?_, fun b hb => ?_, fun t m ht hm hl => ?_⟩
      · rw [g1 t (by omega)]; exact hold t ht
      · by_cases h1 : mem'.size ≤ t
        · obtain ⟨j, hj, hl⟩ := g2 t m h1 hm
          exact ⟨j + 2, by rw [TermMem.nWords_two]; omega, by rw [hl, show i + 2 + j = i + (j + 2) by omega]⟩
        · have h1' : t < mem'.size := Nat.lt_of_not_le h1
          have hm' : mem'[t]? = some m := by rw [← g1 t h1']; exact hm
          rw [q1, Array.getElem?_push] at hm'
          split at hm'
          · simp only [Option.some.injEq] at hm'; subst hm'
            exact ⟨1, by rw [TermMem.nWords_two]; omega, by rw [offs_next]⟩
          · rw [Array.getElem?_push] at hm'
            split at hm'
            · simp only [Option.some.injEq] at hm'; subst hm'
              exact ⟨0, by rw [TermMem.nWords_two]; omega, by simp⟩
            · rename_i hne1 hne0
              simp only [Array.size_push] at hne1 hne0
              omega
      · have hb0 : b ≠ offs a i := by have := hb 0 (by rw [TermMem.nWords_two]; omega); simpa using this
        have hb1 : b ≠ offs a (i + 1) := hb 1 (by rw [TermMem.nWords_two]; omega)
        rw [g3 b (fun j hj => by
          have := hb (j + 2) (by rw [TermMem.nWords_two]; omega)
          rwa [show i + (j + 2) = i + 2 + j by omega] at this)]
        show th.vs.coh b = s.vs.coh b
        rw [q3, offs_next]; simp [hb0, hb1, mth]
      · exact g4 t m (by show t ∈ th.promises; rw [q4]; exact ht) (by rw [hold t (lt_of_get hm)]; exact hm)
          (fun j hj => by
            have := hl (j + 2) (by rw [TermMem.nWords_two]; omega)
            rwa [show i + (j + 2) = i + 2 + j by omega] at this)
  | .one :: _, [], _, _, _, hs => by simp [storeUnits] at hs
  | .two :: _, [], _, _, _, hs => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, _, hs => by simp [storeUnits] at hs

/-- (msgWords) `alloc` writes past the old memory only within the new cell's words. -/
theorem alloc_words {k : Promises.Knobs} {arch : Arch} {lbl : AllocLabel} {us : List Acc}
    {ws : List Word} {s s' : St} {pw : Word} {T : Ty} (hr : (s', pw) ∈ alloc k arch lbl us ws s)
    (hw : wc T = some (nWords us)) :
    ∀ (t : Nat) (m : Msg), s.mem.size ≤ t → s'.mem[t]? = some m → m.loc.label = lbl → InWords T m.loc.offset := by
  intro t m ht hm _
  obtain ⟨L, hL, hn⟩ := wc_some hw
  obtain ⟨s1, hst, -, -, -, -, -, -, -, -, hsz, hget⟩ := alloc_unf hr
  have hu := storeUnits_untouched us ws 0 s1 _ hst
  have hm' : (s', pw).1.mem[t]? = some m := hm
  refine ⟨fun L' hL' => ?_, fun N e us' hT _ => ?_⟩
  · rw [hL] at hL'
    cases hL'
    rw [hn]
    by_cases h1 : t < s1.mem.size
    · rw [hu.1 t h1, hget] at hm'
      have a1 : ¬ t < s.mem.size := by omega
      rw [hsz] at h1
      simp only [a1, h1, ↓reduceIte] at hm'
      cases hm'
      show t - s.mem.size < nWords us
      omega
    · obtain ⟨j, hj, he⟩ := hu.2.1 t m (by omega) hm'
      rw [he]
      simp only [offs, Nat.zero_add]
      exact hj
  · rw [hT] at hw
    simp [wc, accs] at hw

/-- (NewAt) `alloc` (`new`) writes a message past the old memory at every unit of the new label. -/
theorem alloc_newT {k : Promises.Knobs} {arch : Arch} {lbl : AllocLabel} {us : List Acc}
    {ws : List Word} {s s' : St} {pw : Word} {T : Ty} (hr : (s', pw) ∈ alloc k arch lbl us ws s)
    (hw : wc T = some (nWords us)) : NewAtT s.mem.size s'.mem lbl T := by
  refine ⟨?_, alloc_words hr hw⟩
  obtain ⟨L, hL, hn⟩ := wc_some hw
  refine .inl ⟨L, hL, fun o ho => ?_⟩
  rw [hn] at ho
  obtain ⟨s1, hst, -, -, -, -, -, -, -, -, -, hget⟩ := alloc_unf hr
  have h1 : s1.mem[s.mem.size + o]? = some ⟨⟨lbl, o⟩, .undef, 0⟩ := by
    rw [hget]
    have a1 : ¬ (s.mem.size + o < s.mem.size) := by omega
    have a2 : s.mem.size + o < s.mem.size + nWords us := by omega
    simp only [a1, a2, ite_false, ite_true, Nat.add_sub_cancel_left]
  have hx := (TermLiveProps.storeUnits_ext hst).mem
  have hlt : s.mem.size + o < s1.mem.size := by
    cases hq : s1.mem[s.mem.size + o]? with
    | none => rw [hq] at h1; cases h1
    | some _ => exact (Array.getElem?_eq_some_iff.1 hq).1
  refine ⟨s.mem.size + o, ⟨⟨lbl, o⟩, .undef, 0⟩, Nat.le_add_right _ _, ?_, rfl⟩
  show (s', pw).1.mem[s.mem.size + o]? = _
  rw [hx.get _ hlt]; exact h1

/-- (F2) **A stored word, as its owner sees it**: coherence at `b` is at a
message holding `v`, not an outstanding promise, and every later message to `b`
is an old one past the old coherence point (an old promise still outstanding). -/
def WrAt (s s' : St) (b : Address) (v : Word) : Prop :=
  (∃ m, s'.mem[s'.vs.coh b]? = some m ∧ m.loc = b ∧ m.val = v.val ∧ ∀ x g, v.val = .loc x g → v.view ≤ m.view) ∧
    s'.vs.coh b ∉ s'.promises ∧
    ∀ (t : Nat) (m : Msg), s'.vs.coh b < t → s'.mem[t]? = some m → m.loc = b →
      s.mem[t]? = some m ∧ s.vs.coh b < t ∧ (t ∈ s.promises → t ∈ s'.promises)

/-- `WrAt` across a later store that does not write `b`. -/
theorem WrAt_suf {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool}
    {us : List Acc} {ws : List Word} {i : Nat} {s s1 s' : St} {b : Address} {v : Word}
    (h : WrAt s s1 b v) (hpl : PromLt s1) (hs : s' ∈ storeUnits k arch pw a rel us ws i s1)
    (hb : ∀ j, j < nWords us → b ≠ offs a (i + j)) : WrAt s s' b v := by
  obtain ⟨g1, g2, g3, g4⟩ := storeUnits_untouched us ws i s1 s' hs
  obtain ⟨-, gs, -⟩ := storeUnits_promF us ws i s1 s' hpl hs
  obtain ⟨⟨m, hm, hml, hmv, hmw⟩, hn, hlat⟩ := h
  have hc := g3 b hb
  refine ⟨⟨m, by rw [hc, g1 _ (lt_of_get hm)]; exact hm, hml, hmv, hmw⟩, fun hp => hn (by rw [hc] at hp; exact gs.subset hp),
    fun t m' ht hm' hl' => ?_⟩
  rw [hc] at ht
  by_cases hlt : t < s1.mem.size
  · rw [g1 t hlt] at hm'
    obtain ⟨r1, r2, r3⟩ := hlat t m' ht hm' hl'
    exact ⟨r1, r2, fun hp => g4 t m' (r3 hp) hm' (fun j hj e => hb j hj (hl'.symm.trans e))⟩
  · obtain ⟨j, hj, e⟩ := g2 t m' (Nat.le_of_not_lt hlt) hm'
    exact absurd (hl'.symm.trans e) (hb j hj)

/-- `WrAt` from an earlier step that does not touch `b`. -/
theorem WrAt_pre {s s1 s' : St} {b : Address} {v : Word} (h : WrAt s1 s' b v)
    (hold : ∀ t, t < s.mem.size → s1.mem[t]? = s.mem[t]?)
    (hnew : ∀ (t : Nat) (m : Msg), s.mem.size ≤ t → s1.mem[t]? = some m → m.loc ≠ b)
    (hc : s1.vs.coh b = s.vs.coh b)
    (hp : ∀ (t : Ts) (m : Msg), t ∈ s.promises → s.mem[t]? = some m → m.loc = b → t ∈ s1.promises) :
    WrAt s s' b v := by
  obtain ⟨h1, h2, h3⟩ := h
  refine ⟨h1, h2, fun t m ht hm hl => ?_⟩
  obtain ⟨r1, r2, r3⟩ := h3 t m ht hm hl
  have hlt : t < s.mem.size := Nat.lt_of_not_le fun hge => hnew t m hge r1 hl
  rw [hold t hlt] at r1
  exact ⟨r1, by rw [← hc]; exact r2, fun hq => r3 (hp t m hq r1 hl)⟩

/-- (privSlot) `PrivCoh` across stores to units none of which is an
uninitialised private unit afterwards. -/
theorem PrivCoh_storeUnits {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool}
    {E E' : TEnv} {us : List Acc} {ws : List Word} {s s' : St} (h : PrivCoh E s)
    (hs : s' ∈ storeUnits k arch pw a rel us ws 0 s) (hU : ∀ b, PrivU E' b → PrivU E b)
    (hnp : ∀ j, j < nWords us → ¬ PrivU E' (offs a j)) : PrivCoh E' s' := by
  obtain ⟨u1, u2, u3, u4⟩ := storeUnits_untouched us ws 0 s s' hs
  have hnp' : ∀ b, PrivU E' b → ∀ j, j < nWords us → b ≠ offs a (0 + j) := fun b hb j hj e => by
    rw [Nat.zero_add] at e; exact hnp j hj (e ▸ hb)
  refine PrivCoh_of h hU (fun b hb => u3 b (hnp' b hb)) fun t m ht hm hu => ?_
  by_cases hlt : t < s.mem.size
  · rw [u1 t hlt] at hm
    exact ⟨fun hp => ht (u4 t m hp hm fun j hj e => hnp' _ hu j hj e), hm⟩
  · obtain ⟨j, hj, e⟩ := u2 t m (by omega) hm
    exact absurd e (hnp' _ hu j hj)
#print axioms PrivCoh_storeUnits

theorem storeUnits_one {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} {w : Word}
    {i : Nat} {s : St} {mem' : Memory} {th : Promises.Thread}
    (hst : (mem', th) ∈ Promises.stepStore k arch s.mem (mth s pw w w) (offs a i) (dataE 1 w) [0] rel) :
    { s with mem := mem', vs := th.vs, promises := th.promises } ∈ storeUnits k arch pw a rel [.one] [w] i s := by
  simp only [storeUnits, List.mem_flatMap, List.mem_singleton]
  exact ⟨_, hst, rfl⟩

/-- (F2) **What a store leaves at the stored words**: `WrAt`. -/
theorem storeUnits_written {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s : St) (V : Ts), PromLt s → s.promises.Nodup →
      V ≤ s.vs.vRelSt → ∀ s', s' ∈ storeUnits k arch pw a rel us ws i s →
        ∀ (j : Nat) w, j < nWords us → ws[j]? = some w → WrAt s s' (offs a (i + j)) (bumpW V w)
  | [], _, _, s, _, _, _, _, s', hs => by
      simp only [storeUnits, List.mem_singleton] at hs; subst hs
      exact fun j _ hj => absurd hj (by simp [nWords])
  | .one :: us, w :: ws, i, s, V, hpl, hnd, hV, s', hs => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      obtain ⟨t0, hcase, hcoh, hrs, -⟩ := stepStore_casesC hst
      have hmw : ∀ x g, (bumpW V w).val = .loc x g →
          (bumpW V w).view ≤ Promises.storeMview (mth s pw w w) (dataE 1 w) [0] rel := fun x g hx =>
        Nat.max_le.2 ⟨storeMview_dataE _ 1 w (by simp [mth, regsOf]) [0] rel x g hx,
          Nat.le_trans hV (storeMview_relSt (mth s pw w w) _ [0] rel)⟩
      have ev : exprVal (mth s pw w w) (dataE 1 w) = w.val := exprVal_dataE _ 1 w (by simp [mth, regsOf])
      let s1 : St := { s with mem := mem', vs := th.vs, promises := th.promises }
      have hs1 : s1 ∈ storeUnits k arch pw a rel [.one] [w] i s := storeUnits_one hst
      obtain ⟨u1, u2, u3, u4⟩ := storeUnits_untouched _ _ _ _ _ hs1
      have hc0 : s1.vs.coh (offs a i) = t0 := by show th.vs.coh (offs a i) = t0; rw [hcoh]; simp
      have hpl1 : PromLt s1 := (storeUnits_promF _ _ _ _ _ hpl hs1).1
      have hnd1 : s1.promises.Nodup := by
        rcases hcase with ⟨-, -, hprom⟩ | ⟨-, -, hprom, -⟩
        · show th.promises.Nodup; rw [hprom]; exact hnd
        · show th.promises.Nodup; rw [hprom]; exact hnd.erase _
      intro j w' hj hw
      cases j with
      | zero =>
          simp only [List.getElem?_cons_zero, Option.some.injEq] at hw; subst hw
          have hw1 : WrAt s s1 (offs a i) (bumpW V w) := by
            rw [WrAt, hc0]
            rcases hcase with ⟨hmem, rfl, hprom⟩ | ⟨hmem, htp, hprom, hlt, m, hm, hma, hmv, hmv'⟩
            · refine ⟨⟨⟨offs a i, exprVal (mth s pw w w) (dataE 1 w), Promises.storeMview (mth s pw w w) (dataE 1 w) [0] rel⟩,
                ?_, rfl, ?_, hmw⟩, fun h => ?_, fun t m ht hm hl => ?_⟩
              · show mem'[s.mem.size]? = _; rw [hmem]; simp
              · show exprVal (mth s pw w w) (dataE 1 w) = _; rw [ev]; rfl
              · have : s.mem.size ∈ s.promises := by have : s.mem.size ∈ th.promises := h; rwa [hprom] at this
                exact Nat.lt_irrefl _ (hpl _ this)
              · have ht' : s.mem.size < t := by first | exact ht | (rw [hc0] at ht; exact ht)
                have : t < mem'.size := lt_of_get hm
                rw [hmem, Array.size_push] at this
                exact absurd (Nat.lt_of_lt_of_le ht' (Nat.le_of_lt_succ this)) (Nat.lt_irrefl _)
            · refine ⟨⟨m, by show mem'[t0]? = _; rw [hmem]; exact hm, hma, by rw [hmv, ev]; rfl,
                fun x g hx => Nat.le_trans (hmw x g hx) hmv'⟩, fun h => ?_, fun t m' ht hm' hl' => ?_⟩
              · have : t0 ∈ th.promises := h
                rw [hprom] at this; exact hnd.not_mem_erase this
              · have hm'' : s.mem[t]? = some m' := by have : mem'[t]? = some m' := hm'; rwa [hmem] at this
                refine ⟨hm'', Nat.lt_trans hlt ht, fun hq => ?_⟩
                show t ∈ th.promises; rw [hprom]; exact (List.mem_erase_of_ne (Nat.ne_of_gt ht)).2 hq
          have := WrAt_suf hw1 hpl1 hs (fun j' _ => (offs_ne a (by omega)).symm)
          simpa using this
      | succ j =>
          have hIH := storeUnits_written us ws (i + 1) s1 V hpl1 hnd1 (by show V ≤ th.vs.vRelSt; rw [hrs]; exact hV)
            s' hs j w' (by rw [TermMem.nWords_one] at hj; omega) (by simpa using hw)
          have hb : offs a (i + 1 + j) ≠ offs a i := offs_ne a (by omega)
          rw [show i + (j + 1) = i + 1 + j by omega]
          refine WrAt_pre hIH u1 (fun t m ht hm e => ?_) (u3 _ fun j' hj' => ?_) (fun t m ht hm hl => u4 t m ht hm
            (fun j' hj' e => ?_))
          · obtain ⟨j', hj', e'⟩ := u2 t m ht hm
            simp only [nWords, List.map, List.sum_cons, List.sum_nil, Acc.size] at hj'
            obtain rfl : j' = 0 := by omega
            exact hb (e.symm.trans (by simpa using e'))
          · simp only [nWords, List.map, List.sum_cons, List.sum_nil, Acc.size] at hj'; obtain rfl : j' = 0 := by omega
            simpa using hb
          · simp only [nWords, List.map, List.sum_cons, List.sum_nil, Acc.size] at hj'; obtain rfl : j' = 0 := by omega
            exact hb (hl.symm.trans (by simpa using e))
  | .two :: us, w0 :: w1 :: ws, i, s, V, hpl, hnd, hV, s', hs => by
      simp only [storeUnits] at hs
      obtain ⟨q1, _, q3, q4, q5⟩ := stepStorePair_eq s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel
      have hV0 : V ≤ max (Promises.storeMview (mth s pw w0 w1) (dataE 1 w0) [0] rel)
          (Promises.storeMview (mth s pw w0 w1) (dataE 2 w1) [0] rel) :=
        Nat.le_trans hV (Nat.le_trans (storeMview_relSt (mth s pw w0 w1) _ [0] rel) (Nat.le_max_left _ _))
      have e0 : exprVal (mth s pw w0 w1) (dataE 1 w0) = w0.val :=
        exprVal_dataE _ 1 w0 (by simp [mth, regsOf])
      have e1 : exprVal (mth s pw w0 w1) (dataE 2 w1) = w1.val :=
        exprVal_dataE _ 2 w1 (by simp [mth, regsOf])
      rw [e0, e1] at q1
      generalize Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel = R at q1 q3 q4 q5 hs
      obtain ⟨mem', pairs', th⟩ := R
      simp only at q1 q3 q4 q5 hs
      let s1 : St := { s with mem := mem', pairs := pairs', vs := th.vs, promises := th.promises }
      have a01 : offs a i ≠ offs a (i + 1) := offs_ne a (by omega)
      have hp1 : s1.promises = s.promises := q4
      have hpl1 : PromLt s1 := by
        intro t ht
        rw [hp1] at ht
        show t < mem'.size
        rw [q1, Array.size_push, Array.size_push]; exact Nat.lt_succ_of_lt (Nat.lt_succ_of_lt (hpl t ht))
      have hc : s1.vs.coh = fun b => if b = offs a i then s.mem.size
          else if b = offs a (i + 1) then s.mem.size + 1 else s.vs.coh b := by
        show th.vs.coh = _; rw [q3, offs_next]; rfl
      have hM : s1.mem = (s.mem.push ⟨offs a i, w0.val,
          max (Promises.storeMview (mth s pw w0 w1) (dataE 1 w0) [0] rel)
            (Promises.storeMview (mth s pw w0 w1) (dataE 2 w1) [0] rel)⟩).push ⟨offs a (i + 1), w1.val,
          max (Promises.storeMview (mth s pw w0 w1) (dataE 1 w0) [0] rel)
            (Promises.storeMview (mth s pw w0 w1) (dataE 2 w1) [0] rel)⟩ := by
        show mem' = _; rw [q1, offs_next]
      have hsz1 : s1.mem.size = s.mem.size + 2 := by rw [hM, Array.size_push, Array.size_push]
      have hnp : ∀ t, s.mem.size ≤ t → t ∉ s1.promises := fun t ht hp => by
        rw [hp1] at hp; exact Nat.lt_irrefl _ (Nat.lt_of_le_of_lt ht (hpl t hp))
      intro j w' hj hw
      match j, hj, hw with
      | 0, _, hw =>
          simp only [List.getElem?_cons_zero, Option.some.injEq] at hw; subst hw
          have hw1 : WrAt s s1 (offs a i) (bumpW V w0) := by
            have hc0 : s1.vs.coh (offs a i) = s.mem.size := by rw [hc]; simp
            rw [WrAt, hc0]
            refine ⟨⟨_, by rw [hM, Array.getElem?_push, if_neg (by simp), Array.getElem?_push, if_pos rfl], rfl, rfl,
              fun x g hx => Nat.max_le.2 ⟨Nat.le_trans (storeMview_dataE (mth s pw w0 w1) 1 w0 (by simp [mth, regsOf]) [0] rel x g hx)
                (Nat.le_max_left _ _), hV0⟩⟩, hnp _ (Nat.le_refl _), fun t m ht hm hl => ?_⟩
            have hlt : t < s.mem.size + 2 := by rw [← hsz1]; exact lt_of_get hm
            have ht' : s.mem.size < t := ht
            obtain rfl : t = s.mem.size + 1 := by omega
            rw [hM, Array.getElem?_push, if_pos (by simp)] at hm
            cases hm; exact absurd hl (Ne.symm a01)
          simpa using WrAt_suf hw1 hpl1 hs (fun j _ => offs_ne a (by omega))
      | 1, _, hw =>
          simp only [List.getElem?_cons_succ, List.getElem?_cons_zero, Option.some.injEq] at hw; subst hw
          have hw1 : WrAt s s1 (offs a (i + 1)) (bumpW V w1) := by
            have hc0 : s1.vs.coh (offs a (i + 1)) = s.mem.size + 1 := by rw [hc]; simp [Ne.symm a01]
            rw [WrAt, hc0]
            refine ⟨⟨_, by rw [hM, Array.getElem?_push, if_pos (by simp)], rfl, rfl,
              fun x g hx => Nat.max_le.2 ⟨Nat.le_trans (storeMview_dataE (mth s pw w0 w1) 2 w1 (by simp [mth, regsOf]) [0] rel x g hx)
                (Nat.le_max_right _ _), hV0⟩⟩, hnp _ (by omega), fun t m ht hm hl => ?_⟩
            have hlt : t < s.mem.size + 2 := by rw [← hsz1]; exact lt_of_get hm
            exact absurd ht (by omega : ¬ s.mem.size + 1 < t)
          exact WrAt_suf hw1 hpl1 hs (fun j _ => offs_ne a (by omega))
      | j + 2, hj, hw =>
          have hIH := storeUnits_written us ws (i + 2) s1 V hpl1 (by rw [hp1]; exact hnd)
            (by show V ≤ th.vs.vRelSt; rw [q5]; exact hV) s' hs j w' (by rw [TermMem.nWords_two] at hj; omega)
            (by simpa using hw)
          have hb0 : offs a (i + 2 + j) ≠ offs a i := offs_ne a (by omega)
          have hb1 : offs a (i + 2 + j) ≠ offs a (i + 1) := offs_ne a (by omega)
          rw [show i + (j + 2) = i + 2 + j by omega]
          refine WrAt_pre hIH (fun t ht => by rw [hM, push2_lt ht]) (fun t m ht hm e => ?_)
            (by rw [hc]; simp [hb0, hb1]) (fun t m ht _ _ => by rw [hp1]; exact ht)
          have hlt : t < s.mem.size + 2 := by rw [← hsz1]; exact lt_of_get hm
          rw [hM, Array.getElem?_push] at hm
          split at hm
          · cases hm; exact hb1 e.symm
          · rw [Array.getElem?_push] at hm
            split at hm
            · cases hm; exact hb0 e.symm
            · rename_i h1 h2; simp only [Array.size_push] at h1 h2; omega
  | .one :: _, [], _, _, _, _, _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [], _, _, _, _, _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, _, _, _, _, s', hs => by simp [storeUnits] at hs

/-- (F2) **A pair store appends**: coherence at both words of a two-word unit
of the store is at or past the old memory's top. -/
theorem storeUnits_twoCoh {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s s' : St), s' ∈ storeUnits k arch pw a rel us ws i s →
      ∀ j, TwoAt us j → s.mem.size ≤ s'.vs.coh (offs a (i + j)) ∧ s.mem.size ≤ s'.vs.coh (offs a (i + j + 1))
  | [], _, _, s, s', hs => by
      intro j ⟨idx, h, _⟩; simp at h
  | .one :: us, w :: ws, i, s, s', hs => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      obtain ⟨t0, hcase, -, -, -⟩ := stepStore_casesC hst
      have hsz : s.mem.size ≤ mem'.size := by
        rcases hcase with ⟨hmem, -⟩ | ⟨hmem, -⟩
        · rw [hmem, Array.size_push]; omega
        · rw [hmem]; exact Nat.le_refl _
      intro j ⟨idx, h, hj⟩
      cases idx with
      | zero => simp at h
      | succ n =>
          have hj' : j = 1 + nWords (us.take n) := by rw [hj]; simp [nWords, Acc.size]
          obtain ⟨r0, r1⟩ := storeUnits_twoCoh us ws (i + 1) _ s' hs (nWords (us.take n)) ⟨n, by simpa using h, rfl⟩
          simp only at r0 r1
          rw [hj', show i + (1 + nWords (List.take n us)) = i + 1 + nWords (List.take n us) by omega]
          exact ⟨Nat.le_trans hsz r0, Nat.le_trans hsz r1⟩
  | .two :: us, w0 :: w1 :: ws, i, s, s', hs => by
      simp only [storeUnits] at hs
      obtain ⟨q1, _, q3, q4, q5⟩ := stepStorePair_eq s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel
      generalize Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel = R at q1 q3 q4 q5 hs
      obtain ⟨mem', pairs', th⟩ := R
      simp only at q1 q3 q4 q5 hs
      have hsz : s.mem.size + 2 = mem'.size := by rw [q1, Array.size_push, Array.size_push]
      intro j ⟨idx, h, hj⟩
      cases idx with
      | zero =>
          simp only [List.take_zero] at hj
          have hj0 : j = 0 := by rw [hj]; rfl
          subst hj0
          obtain ⟨-, -, g3, -⟩ := storeUnits_untouched us ws (i + 2) _ s' hs
          have a01 : offs a i ≠ offs a (i + 1) := offs_ne a (by omega)
          rw [g3 _ (fun j' _ => offs_ne a (by omega)), g3 _ (fun j' _ => offs_ne a (by omega))]
          show s.mem.size ≤ th.vs.coh (offs a (i + 0)) ∧ s.mem.size ≤ th.vs.coh (offs a (i + 0 + 1))
          rw [q3, offs_next]; simp [Ne.symm a01]
      | succ n =>
          have hj' : j = 2 + nWords (us.take n) := by rw [hj]; simp [nWords, Acc.size]
          obtain ⟨r0, r1⟩ := storeUnits_twoCoh us ws (i + 2) _ s' hs (nWords (us.take n)) ⟨n, by simpa using h, rfl⟩
          simp only at r0 r1
          rw [hj', show i + (2 + nWords (List.take n us)) = i + 2 + nWords (List.take n us) by omega]
          exact ⟨by omega, by omega⟩
  | .one :: _, [], _, _, _, hs => by simp [storeUnits] at hs
  | .two :: _, [], _, _, _, hs => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, _, hs => by simp [storeUnits] at hs

/-- (F2) A stored word is its address's `LatestSF`, given the old tail there. -/
theorem LatestSF_of_WrAt {η : TEnv} {c : Cell} {fr : Option Ts} {s s' : St} {b : Address} {v : Word}
    (h : WrAt s s' b v)
    (ht : ∀ (t : Ts) (m : Msg), s.vs.coh b < t → s.mem[t]? = some m → m.loc = b →
      t ∈ s.promises ∨ (fr ≠ none ∧ TypedAt η c m)) :
    LatestSF η c fr s'.mem (· ∈ s'.promises) s'.vs.coh b v := by
  obtain ⟨⟨m, hm, hl, hv, hw⟩, hn, hlat⟩ := h
  refine ⟨⟨m, hm, hl, Or.inl ⟨hv, hw⟩⟩, hn, fun t m' ht' hm' hl' => ?_⟩
  obtain ⟨r1, r2, r3⟩ := hlat t m' ht' hm' hl'
  exact (ht t m' r2 r1 hl').imp r3 id

/-- (F2) `LatestSF` at an address the step does not touch. -/
theorem LatestSF_frame {η : TEnv} {c : Cell} {fr : Option Ts} {mem mem' : Memory} {S S' : Ts → Prop}
    {coh coh' : Address → Ts} {a : Address} {w : Word} (h : LatestSF η c fr mem S coh a w)
    (hold : ∀ t, t < mem.size → mem'[t]? = mem[t]?)
    (hnew : ∀ (t : Nat) (m : Msg), mem.size ≤ t → mem'[t]? = some m → m.loc ≠ a)
    (hc : coh' a = coh a) (hS : ∀ t, S' t → S t)
    (hS' : ∀ (t : Ts) (m : Msg), S t → mem[t]? = some m → m.loc = a → S' t) :
    LatestSF η c fr mem' S' coh' a w := by
  obtain ⟨⟨m, hm, hl, hv⟩, hn, hlat⟩ := h
  refine ⟨⟨m, by rw [hc, hold _ (lt_of_get hm)]; exact hm, hl, hv⟩, fun h => hn (by rw [hc] at h; exact hS _ h),
    fun t m' ht hm' hl' => ?_⟩
  rw [hc] at ht
  by_cases hlt : t < mem.size
  · rw [hold t hlt] at hm'
    exact (hlat t m' ht hm' hl').imp (fun h => hS' t m' h hm' hl') id
  · exact absurd hl' (hnew t m' (Nat.le_of_not_lt hlt) hm')

/-- (F2) A pair store not straddling in a grown memory with more pair starts did
not straddle before. -/
theorem pairStraddles_mono {mem mem' : Memory} {pairs pairs' : List Ts} {a : Address} {t0 t1 : Ts}
    (hp : ∀ p, p ∈ pairs → p ∈ pairs') (hsz : ∀ p, p ∈ pairs → p + 1 < mem.size)
    (hold : ∀ t, t < mem.size → mem'[t]? = mem[t]?)
    (h : WeakMem.pairStraddles mem' pairs' a t0 t1 = false) : WeakMem.pairStraddles mem pairs a t0 t1 = false := by
  unfold WeakMem.pairStraddles at h ⊢
  rw [List.any_eq_false] at h ⊢
  intro p hp'
  have := h p (hp p hp')
  rwa [hold p (Nat.lt_of_succ_lt (hsz p hp')), hold (p + 1) (hsz p hp')] at this

/-- (F2) `OwnPairF` at one two-word unit. -/
def OwnPairAt (η : TEnv) (c : Cell) (l : AllocLabel) (vals : List Word) (mem : Memory) (pairs : List Ts)
    (S : Ts → Prop) (coh : Address → Ts) (o : Nat) : Prop :=
  ∀ (t0 t1 : Nat) (m0 m1 : Msg), ¬ S t0 → ¬ S t1 →
    mem[t0]? = some m0 → mem[t1]? = some m1 → m0.loc = ⟨l, o⟩ → m1.loc = ⟨l, o + 1⟩ →
    coh ⟨l, o⟩ ≤ t0 → coh ⟨l, o + 1⟩ ≤ t1 → WeakMem.pairStraddles mem pairs ⟨l, o⟩ t0 t1 = false →
    (t0 = coh ⟨l, o⟩ ∧ t1 = coh ⟨l, o + 1⟩ ∧ (∀ v, vals[o]? = some v → WLe1 v (mw m0)) ∧
      (∀ v, vals[o + 1]? = some v → WLe1 v (mw m1))) ∨ PairOK η c.ty o (mw m0) (mw m1)

theorem OwnPairF_iff {η : TEnv} {c : Cell} {l : AllocLabel} {vals : List Word} {mem : Memory} {pairs : List Ts}
    {S : Ts → Prop} {coh : Address → Ts} :
    OwnPairF η c l vals mem pairs S coh ↔ ∀ o, TwoAtT c.ty o → InitRr η c l o → OwnPairAt η c l vals mem pairs S coh o :=
  Iff.rfl

/-- (F2) `OwnPairAt` at a unit the step does not touch. -/
theorem OwnPairAt_frame {η : TEnv} {c : Cell} {l : AllocLabel} {vals vals' : List Word} {mem mem' : Memory}
    {pairs pairs' : List Ts} {S S' : Ts → Prop} {coh coh' : Address → Ts} {o : Nat}
    (h : OwnPairAt η c l vals mem pairs S coh o)
    (hold : ∀ t, t < mem.size → mem'[t]? = mem[t]?)
    (hnew : ∀ (t : Nat) (m : Msg), mem.size ≤ t → mem'[t]? = some m → m.loc ≠ ⟨l, o⟩ ∧ m.loc ≠ ⟨l, o + 1⟩)
    (hc0 : coh' ⟨l, o⟩ = coh ⟨l, o⟩) (hc1 : coh' ⟨l, o + 1⟩ = coh ⟨l, o + 1⟩)
    (hS' : ∀ (t : Ts) (m : Msg), S t → mem[t]? = some m → (m.loc = ⟨l, o⟩ ∨ m.loc = ⟨l, o + 1⟩) → S' t)
    (hv0 : vals'[o]? = vals[o]?) (hv1 : vals'[o + 1]? = vals[o + 1]?)
    (hp : ∀ p, p ∈ pairs → p ∈ pairs') (hsz : ∀ p, p ∈ pairs → p + 1 < mem.size) :
    OwnPairAt η c l vals' mem' pairs' S' coh' o := by
  intro t0 t1 m0 m1 hs0 hs1 hm0 hm1 hl0 hl1 hc0' hc1' hst
  have hlt0 : t0 < mem.size := Nat.lt_of_not_le fun hge => (hnew t0 m0 hge hm0).1 hl0
  have hlt1 : t1 < mem.size := Nat.lt_of_not_le fun hge => (hnew t1 m1 hge hm1).2 hl1
  rw [hold t0 hlt0] at hm0
  rw [hold t1 hlt1] at hm1
  rw [hc0] at hc0' ⊢
  rw [hc1] at hc1' ⊢
  rw [hv0, hv1]
  exact h t0 t1 m0 m1 (fun h => hs0 (hS' t0 m0 h hm0 (Or.inl hl0))) (fun h => hs1 (hS' t1 m1 h hm1 (Or.inr hl1)))
    hm0 hm1 hl0 hl1 hc0' hc1' (pairStraddles_mono hp hsz hold hst)

/-- (F2) **A two-word unit written by a pair store**: past the new coherence
pair there is nothing to read, so a read pair is the coherence pair. -/
theorem OwnPairAt_written {η : TEnv} {c : Cell} {l : AllocLabel} {vals : List Word} {s s' : St} {o : Nat}
    {v0 v1 : Word} (pairs : List Ts)
    (h0 : WrAt s s' ⟨l, o⟩ v0) (h1 : WrAt s s' ⟨l, o + 1⟩ v1)
    (hc0 : s.mem.size ≤ s'.vs.coh ⟨l, o⟩) (hc1 : s.mem.size ≤ s'.vs.coh ⟨l, o + 1⟩)
    (hv0 : vals[o]? = some v0) (hv1 : vals[o + 1]? = some v1) :
    OwnPairAt η c l vals s'.mem pairs (· ∈ s'.promises) s'.vs.coh o := by
  intro t0 t1 m0 m1 _ _ hm0 hm1 hl0 hl1 hc0' hc1' _
  have e0 : t0 = s'.vs.coh ⟨l, o⟩ := by
    rcases Nat.lt_or_eq_of_le hc0' with hlt | he
    · have := lt_of_get (h0.2.2 t0 m0 hlt hm0 hl0).1
      have hc0'' : s.mem.size ≤ (s'.vs.coh ⟨l, o⟩ : Nat) := hc0
      have hlt' : (s'.vs.coh ⟨l, o⟩ : Nat) < t0 := hlt
      omega
    · exact he.symm
  have e1 : t1 = s'.vs.coh ⟨l, o + 1⟩ := by
    rcases Nat.lt_or_eq_of_le hc1' with hlt | he
    · have := lt_of_get (h1.2.2 t1 m1 hlt hm1 hl1).1
      have hc1'' : s.mem.size ≤ (s'.vs.coh ⟨l, o + 1⟩ : Nat) := hc1
      have hlt' : (s'.vs.coh ⟨l, o + 1⟩ : Nat) < t1 := hlt
      omega
    · exact he.symm
  obtain ⟨⟨n0, hn0, -, hv0', hw0⟩, -, -⟩ := h0
  obtain ⟨⟨n1, hn1, -, hv1', hw1⟩, -, -⟩ := h1
  rw [← e0, hm0] at hn0; cases hn0
  rw [← e1, hm1] at hn1; cases hn1
  refine Or.inl ⟨e0, e1, fun v hv => ?_, fun v hv => ?_⟩
  · rw [hv0] at hv; cases hv; exact ⟨hv0'.symm, hw0⟩
  · rw [hv1] at hv; cases hv; exact ⟨hv1'.symm, hw1⟩

/-- (F2) `LatestSF` with Σ grown (more values). -/
theorem LatestSF_map {η η' : TEnv} {c : Cell} {fr : Option Ts} {mem : Memory} {S : Ts → Prop}
    {coh : Address → Ts} {a : Address} {w : Word} (hw : ∀ T o v, WordOK η T o v → WordOK η' T o v)
    (h : LatestSF η c fr mem S coh a w) : LatestSF η' c fr mem S coh a w := by
  obtain ⟨⟨m, hm, hl, hv⟩, hn, hlat⟩ := h
  exact ⟨⟨m, hm, hl, hv.imp id fun h => ⟨h.1, hw _ _ _ h.2⟩⟩, hn,
    fun t m' ht hm' hl' => (hlat t m' ht hm' hl').imp id fun h => ⟨h.1, hw _ _ _ h.2⟩⟩

/-- (F2) `OwnPairAt` with Σ grown. -/
theorem OwnPairAt_map {η η' : TEnv} {c : Cell} {l : AllocLabel} {vals : List Word} {mem : Memory}
    {pairs : List Ts} {S : Ts → Prop} {coh : Address → Ts} {o : Nat}
    (hp : ∀ T o v0 v1, PairOK η T o v0 v1 → PairOK η' T o v0 v1)
    (h : OwnPairAt η c l vals mem pairs S coh o) : OwnPairAt η' c l vals mem pairs S coh o :=
  fun t0 t1 m0 m1 a1 a2 a3 a4 a5 a6 a7 a8 a9 =>
    (h t0 t1 m0 m1 a1 a2 a3 a4 a5 a6 a7 a8 a9).imp id (hp _ _ _ _)

/-- (F2) One own cell's part of `OwnOKSF`. -/
def OwnCellF (η : TEnv) (mem : Memory) (pairs : List Ts) (vs : VState) (S : Ts → Prop) (l : AllocLabel)
    (c : Cell) : Prop :=
  ∃ vals, CellOK η (η.rc l) c.ty vals ∧
    (∀ o v, vals[o]? = some v → LatestSF η c (η.pfr l) mem S vs.coh ⟨l, o⟩ v) ∧
    (η.pfr l ≠ none → OwnPairF η c l vals mem pairs S vs.coh)

theorem OwnOKSF_iff {η : TEnv} {mem : Memory} {pairs : List Ts} {vs : VState} {S : Ts → Prop} :
    OwnOKSF η mem pairs vs S ↔ ∀ l c, η.sto l = some c → c.owner = some η.tid → OwnCellF η mem pairs vs S l c :=
  Iff.rfl

/-- (F2) **An own cell the step does not touch** keeps its part of `OwnOKSF`. -/
theorem OwnCellF_frame {η η' : TEnv} {mem mem' : Memory} {pairs pairs' : List Ts} {vs vs' : VState}
    {S S' : Ts → Prop} {l : AllocLabel} {c : Cell} (h : OwnCellF η mem pairs vs S l c)
    (f : ∀ {U : Ty} {vs : List Word}, ValOf η U vs → ValOf η' U vs)
    (hini : η'.ini l = η.ini l) (hpfr : η'.pfr l = η.pfr l)
    (hold : ∀ t, t < mem.size → mem'[t]? = mem[t]?)
    (hnew : ∀ (t : Nat) (m : Msg), mem.size ≤ t → mem'[t]? = some m → m.loc.label ≠ l)
    (hc : ∀ o, vs'.coh ⟨l, o⟩ = vs.coh ⟨l, o⟩) (hS : ∀ t, S' t → S t)
    (hS' : ∀ (t : Ts) (m : Msg), S t → mem[t]? = some m → m.loc.label = l → S' t)
    (hp : ∀ p, p ∈ pairs → p ∈ pairs') (hsz : ∀ p, p ∈ pairs → p + 1 < mem.size)
    (hri : η'.rini l = η.rini l := by first | rfl | assumption) :
    OwnCellF η' mem' pairs' vs' S' l c := by
  obtain ⟨vals, h1, h2, h3⟩ := h
  have hrc := TEnv.rc_congr hini hri
  refine ⟨vals, CellOK_map f (Nat.le_of_eq hrc) h1, fun o v hv => ?_, fun hf o htw hin => ?_⟩
  · rw [hpfr]
    exact LatestSF_map (fun _ _ _ h => WordOK_map f h) (LatestSF_frame (h2 o v hv) hold
      (fun t m ht hm e => hnew t m ht hm (by rw [e])) (hc o) hS (fun t m h hm e => hS' t m h hm (by rw [e])))
  · rw [hpfr] at hf
    have hin' : InitRr η c l o := fun N e us h1 h2 => by rw [← hrc]; exact hin N e us h1 h2
    exact OwnPairAt_map (fun _ _ _ _ h => PairOK_map f h) (OwnPairAt_frame (h3 hf o htw hin') hold
      (fun t m ht hm => ⟨fun e => hnew t m ht hm (by rw [e]), fun e => hnew t m ht hm (by rw [e])⟩) (hc o) (hc (o + 1))
      (fun t m h hm e => hS' t m h hm (by rcases e with e | e <;> rw [e])) rfl rfl hp hsz)

/-- (F2) An own cell's part of `OwnOKSF` under a grown Σ (same count, same frontier). -/
theorem OwnCellF_env {η η' : TEnv} {mem : Memory} {pairs : List Ts} {vs : VState} {S : Ts → Prop}
    {l : AllocLabel} {c : Cell} (h : OwnCellF η mem pairs vs S l c)
    (f : ∀ {U : Ty} {vs : List Word}, ValOf η U vs → ValOf η' U vs)
    (hini : η'.ini l = η.ini l) (hpfr : η'.pfr l = η.pfr l) (hsz : ∀ p, p ∈ pairs → p + 1 < mem.size)
    (hri : η'.rini l = η.rini l := by first | rfl | assumption) :
    OwnCellF η' mem pairs vs S l c :=
  OwnCellF_frame h f hini hpfr (fun _ _ => rfl) (fun t m ht hm => absurd (lt_of_get hm) (by omega))
    (fun _ => rfl) (fun _ h => h) (fun _ _ h _ _ => h) (fun _ h => h) hsz hri

/-- (F2) **A store to an own cell** (a component at `a`, the cell's words `vals`
becoming `vals'`): the stored words by `WrAt`; at a cell with a frontier, a
two-word unit the store touches is one of its pair units (`hal`), so a read pair
there is the coherence pair; the rest of the cell is untouched. -/
theorem OwnCellF_store {k : Promises.Knobs} {arch : Arch} {pw : Word} {rel : Bool} {E E' : TEnv} {s s' : St}
    {a : Address} {A : Nat} (hA : a.offset = A) {c : Cell} {us : List Acc} {ws : List Word} {V : Ts}
    {vals vals' : List Word}
    (hlat : ∀ o v, vals[o]? = some v → LatestSF E c (E.pfr a.label) s.mem (· ∈ s.promises) s.vs.coh ⟨a.label, o⟩ v)
    (hpf : E.pfr a.label ≠ none → OwnPairF E c a.label vals s.mem s.pairs (· ∈ s.promises) s.vs.coh)
    (f : ∀ {U : Ty} {vs : List Word}, ValOf E U vs → ValOf E' U vs) (hpfr : E'.pfr a.label = E.pfr a.label)
    (hinit : ∀ o, InitRr E' c a.label o → (o < A ∨ A + nWords us ≤ o) → (o + 1 < A ∨ A + nWords us ≤ o + 1) →
      InitRr E c a.label o)
    (hcell' : CellOK E' (E'.rc a.label) c.ty vals')
    (hin : ∀ j w, ws[j]? = some w → vals'[A + j]? = some (bumpW V w))
    (hout : ∀ o, (o < A ∨ A + nWords us ≤ o) → vals'[o]? = vals[o]?)
    (hcov : A + nWords us ≤ vals.length)
    (hal : E'.pfr a.label ≠ none → ∀ o, TwoAtT c.ty o → InitR E' c a.label o →
      (A ≤ o ∧ o < A + nWords us ∨ A ≤ o + 1 ∧ o + 1 < A + nWords us) →
      A ≤ o ∧ TwoAt us (o - A))
    (hlen : ws.length = nWords us) (hV : V ≤ s.vs.vRelSt) (hpl : PromLt s) (hnd : s.promises.Nodup)
    (hsz : ∀ p, p ∈ s.pairs → p + 1 < s.mem.size)
    (hs : s' ∈ storeUnits k arch pw a rel us ws 0 s) :
    OwnCellF E' s'.mem s'.pairs s'.vs (· ∈ s'.promises) a.label c := by
  obtain ⟨u1, u2, u3, u4⟩ := storeUnits_untouched us ws 0 s s' hs
  obtain ⟨-, gs, -⟩ := storeUnits_promF us ws 0 s s' hpl hs
  have hw := storeUnits_written us ws 0 s V hpl hnd hV s' hs
  have hpp := storeUnits_pairs us ws 0 s s' hs
  have hoffs : ∀ j, offs a (0 + j) = ⟨a.label, A + j⟩ := fun j => by simp [offs, hA]
  have hws : ∀ j, j < nWords us → ∃ w, ws[j]? = some w := fun j hj =>
    ⟨ws[j]'(by rw [hlen]; exact hj), List.getElem?_eq_getElem _⟩
  -- an address outside the stored range is untouched
  have hfar : ∀ o, (o < A ∨ A + nWords us ≤ o) → ∀ j, j < nWords us →
      (⟨a.label, o⟩ : Address) ≠ offs a (0 + j) := fun o ho j hj e => by
    rw [hoffs] at e
    have h' : (o : Nat) = A + j := congrArg WeakMem.Address.offset e
    omega
  refine ⟨vals', hcell', fun (o : Nat) v hv => ?_, fun hf (o : Nat) htw hin' => ?_⟩
  · by_cases hr : A ≤ o ∧ o < A + nWords us
    · obtain ⟨w, hw'⟩ := hws (o - A) (by omega)
      have h1 := hin _ _ hw'
      rw [show A + (o - A) = o by omega, hv] at h1
      obtain rfl := Option.some.inj h1
      have W := hw (o - A) w (by omega) hw'
      rw [hoffs, show A + (o - A) = o by omega] at W
      have hov : o < vals.length := by omega
      exact LatestSF_of_WrAt W (fun t m ht hm hl =>
        ((hlat o _ (List.getElem?_eq_getElem hov)).2.2 t m ht hm hl).imp id
          fun h => ⟨by rw [hpfr]; exact h.1, WordOK_map f h.2⟩)
    · have hr' : o < A ∨ A + nWords us ≤ o := by omega
      rw [hout o hr'] at hv
      rw [hpfr]
      refine LatestSF_map (fun _ _ _ h => WordOK_map f h) ?_
      exact LatestSF_frame (hlat o v hv) u1 (fun t m ht hm e => by
          obtain ⟨j, hj, e'⟩ := u2 t m ht hm; exact hfar o hr' j hj (e.symm.trans e'))
        (u3 _ (hfar o hr')) (fun t h => gs.subset h)
        (fun t m h hm e => u4 t m h hm (fun j hj e' => hfar o hr' j hj (e.symm.trans e')))
  · by_cases hr : A ≤ o ∧ o < A + nWords us ∨ A ≤ o + 1 ∧ o + 1 < A + nWords us
    · obtain ⟨hle, htw2⟩ := hal hf o htw hin'.initR hr
      have h2 := TwoAt_lt htw2
      obtain ⟨w0, hw0⟩ := hws (o - A) (by omega)
      obtain ⟨w1, hw1⟩ := hws (o - A + 1) (by omega)
      have W0 := hw _ w0 (by omega) hw0
      have W1 := hw _ w1 (by omega) hw1
      obtain ⟨c0, c1⟩ := storeUnits_twoCoh us ws 0 s s' hs _ htw2
      rw [hoffs, show A + (o - A) = o by omega] at W0 c0
      rw [hoffs, show A + (o - A + 1) = o + 1 by omega] at W1
      rw [show 0 + (o - A) + 1 = 0 + (o - A + 1) by omega, hoffs,
        show A + (o - A + 1) = o + 1 by omega] at c1
      have v0 := hin _ _ hw0
      have v1 := hin _ _ hw1
      rw [show A + (o - A) = o by omega] at v0
      rw [show A + (o - A + 1) = o + 1 by omega] at v1
      exact OwnPairAt_written s'.pairs W0 W1 c0 c1 v0 v1
    · have h0 : o < A ∨ A + nWords us ≤ o := by omega
      have h1 : o + 1 < A ∨ A + nWords us ≤ o + 1 := by omega
      refine OwnPairAt_map (fun _ _ _ _ h => PairOK_map f h) ?_
      exact OwnPairAt_frame (hpf (by rw [← hpfr]; exact hf) o htw (hinit o hin' h0 h1)) u1
        (fun t m ht hm => by
          obtain ⟨j, hj, e'⟩ := u2 t m ht hm
          exact ⟨fun e => hfar o h0 j hj (e.symm.trans e'), fun e => hfar (o + 1) h1 j hj (e.symm.trans e')⟩)
        (u3 _ (hfar o h0)) (u3 _ (hfar (o + 1) h1))
        (fun t m h hm e => u4 t m h hm (fun j hj e' => by
          rcases e with e | e
          · exact hfar o h0 j hj (e.symm.trans e')
          · exact hfar (o + 1) h1 j hj (e.symm.trans e')))
        (hout o h0) (hout (o + 1) h1) hpp hsz

/-- Every word of an access list is a one-word unit, the first word of a two-word
unit, or the second. -/
theorem unit_roles : ∀ (us : List Acc) (j : Nat), j < nWords us →
    OneAt us j ∨ TwoAt us j ∨ ∃ j', j = j' + 1 ∧ TwoAt us j'
  | [], j, h => by simp [nWords] at h
  | u :: us, j, h => by
      by_cases hj : j < u.size
      · cases u with
        | one =>
            simp only [Acc.size] at hj
            obtain rfl : j = 0 := by omega
            exact Or.inl ⟨0, rfl, by simp [nWords]⟩
        | two =>
            simp only [Acc.size] at hj
            rcases (show j = 0 ∨ j = 1 by omega) with rfl | rfl
            · exact Or.inr (Or.inl ⟨0, rfl, by simp [nWords]⟩)
            · exact Or.inr (Or.inr ⟨0, rfl, ⟨0, rfl, by simp [nWords]⟩⟩)
      · have h' : j - u.size < nWords us := by
          have : nWords (u :: us) = u.size + nWords us := by simp [nWords]
          omega
        have e : j = j - u.size + u.size := by omega
        rcases unit_roles us (j - u.size) h' with r | r | ⟨j', e', r⟩
        · rw [e]; exact Or.inl (OneAt_cons u r)
        · rw [e]; exact Or.inr (Or.inl (TwoAt_cons u r))
        · refine Or.inr (Or.inr ⟨j' + u.size, by omega, TwoAt_cons u r⟩)

/-- (F2) **A two-word unit of a list touching an embedded list is one of its units.** -/
theorem TwoAt_embed_inv {pre us post : List Acc} {o : Nat} (h : TwoAt (pre ++ us ++ post) o)
    (hr : nWords pre ≤ o ∧ o < nWords pre + nWords us ∨ nWords pre ≤ o + 1 ∧ o + 1 < nWords pre + nWords us) :
    nWords pre ≤ o ∧ TwoAt us (o - nWords pre) := by
  by_cases h0 : nWords pre ≤ o ∧ o < nWords pre + nWords us
  · refine ⟨h0.1, ?_⟩
    rcases unit_roles us (o - nWords pre) (by omega) with r | r | ⟨j', e', r⟩
    · have := OneAt_embed (pre := pre) (post := post) r
      rw [show nWords pre + (o - nWords pre) = o by omega] at this
      exact absurd this (TwoAt_not_OneAt h)
    · exact r
    · have := TwoAt_embed (pre := pre) (post := post) r
      have h' : TwoAt (pre ++ us ++ post) (nWords pre + j' + 1) := by
        rw [show nWords pre + j' + 1 = o by omega]; exact h
      exact absurd h' (TwoAt_not_TwoAt_succ this)
  · have e : o + 1 = nWords pre := by omega
    rcases unit_roles us 0 (by omega) with r | r | ⟨j', e', r⟩
    · have := OneAt_embed (pre := pre) (post := post) r
      rw [Nat.add_zero, ← e] at this
      exact absurd this (TwoAt_not_OneAt_succ h)
    · have := TwoAt_embed (pre := pre) (post := post) r
      rw [Nat.add_zero, ← e] at this
      exact absurd this (TwoAt_not_TwoAt_succ h)
    · omega

/-- (F2) The alignment `OwnCellF_store` needs, for a whole-cell store laid out
as the cell. -/
theorem TwoAtT_whole {T : Ty} {us : List Acc} {o : Nat} (hacc : accs T = some us) (h : TwoAtT T o) :
    TwoAt us o := by
  obtain ⟨b, S, L, o', hseg, hL, htw, rfl⟩ := h
  rcases hseg with ⟨rfl, rfl, -⟩ | ⟨N, us', j, hT, -, -, -⟩
  · rw [hacc] at hL; obtain rfl := Option.some.inj hL; simpa using htw
  · rw [hT] at hacc; simp [accs] at hacc

/-- (F2) The alignment `OwnCellF_store` needs, for a store at a component (offset
`oS`) of a laid-out segment `b` of the cell. -/
theorem TwoAtT_comp {T S : Ty} {b oS : Nat} {L pre us post : List Acc} {o : Nat}
    (hseg : SegOf T b S) (hL : accs S = some L) (hLe : L = pre ++ us ++ post) (hpre : nWords pre = oS)
    (h : TwoAtT T o)
    (hr : b + oS ≤ o ∧ o < b + oS + nWords us ∨ b + oS ≤ o + 1 ∧ o + 1 < b + oS + nWords us) :
    b + oS ≤ o ∧ TwoAt us (o - (b + oS)) := by
  obtain ⟨b', S', L', o', hseg', hL', htw, rfl⟩ := h
  have hnL : nWords L = nWords pre + nWords us + nWords post := by rw [hLe, nWords_append, nWords_append]
  have hlt := TwoAt_lt htw
  have hq : ∃ q, (q = b' + o' ∨ q = b' + o' + 1) ∧ b + oS ≤ q ∧ q < b + oS + nWords us := by
    rcases hr with hr | hr
    · exact ⟨_, Or.inl rfl, hr⟩
    · exact ⟨_, Or.inr rfl, hr⟩
  obtain ⟨q, hq1, hq2, hq3⟩ := hq
  obtain ⟨e1, e2⟩ := SegOf_unique2 hseg hL (show q - b < nWords L by omega) hseg' hL'
    (show q - b' < nWords L' by omega) (by omega)
  subst e1; subst e2
  rw [hL] at hL'; obtain rfl := Option.some.inj hL'
  rw [hLe] at htw
  obtain ⟨h1, h2⟩ := TwoAt_embed_inv htw (by omega)
  exact ⟨by omega, by rw [show b + o' - (b + oS) = o' - nWords pre by omega]; exact h2⟩

/-- (F2) **An own cell a store does not write** keeps its part of `OwnOKSF`. -/
theorem OwnCellF_storeOther {k : Promises.Knobs} {arch : Arch} {pw : Word} {rel : Bool} {E E' : TEnv}
    {s s' : St} {a : Address} {us : List Acc} {ws : List Word} {i : Nat} {l : AllocLabel} {c : Cell}
    (h : OwnCellF E s.mem s.pairs s.vs (· ∈ s.promises) l c) (hl : l ≠ a.label)
    (f : ∀ {U : Ty} {vs : List Word}, ValOf E U vs → ValOf E' U vs)
    (hini : E'.ini l = E.ini l) (hpfr : E'.pfr l = E.pfr l)
    (hpl : PromLt s) (hsz : ∀ p, p ∈ s.pairs → p + 1 < s.mem.size)
    (hs : s' ∈ storeUnits k arch pw a rel us ws i s)
    (hri : E'.rini l = E.rini l := by first | rfl | assumption) :
    OwnCellF E' s'.mem s'.pairs s'.vs (· ∈ s'.promises) l c := by
  obtain ⟨u1, u2, u3, u4⟩ := storeUnits_untouched us ws i s s' hs
  obtain ⟨-, gs, -⟩ := storeUnits_promF us ws i s s' hpl hs
  have hlab : ∀ (b : Address) j, b.label = l → b ≠ offs a (i + j) := fun b j hb e =>
    hl (by rw [← hb, e]; rfl)
  exact OwnCellF_frame h f hini hpfr u1
    (fun t m ht hm e => by obtain ⟨j, -, e'⟩ := u2 t m ht hm; exact hlab _ j e e')
    (fun o => u3 _ (fun j _ => hlab _ j rfl)) (fun t h => gs.subset h)
    (fun t m h hm e => u4 t m h hm (fun j _ => hlab _ j e)) (storeUnits_pairs us ws i s s' hs) hsz hri

/-- (F2) A cell at its latest words, past coherence only skipped messages, meets
`OwnPairF`: a pair read past coherence is the coherence pair. -/
theorem OwnPairF_of_LatestS {η : TEnv} {c : Cell} {l : AllocLabel} {vals : List Word} {mem : Memory}
    {pairs : List Ts} {S : Ts → Prop} {coh : Address → Ts} {n : Nat} (h1 : CellOK η n c.ty vals)
    (h2 : ∀ o v, vals[o]? = some v → LatestS mem S coh ⟨l, o⟩ v) : OwnPairF η c l vals mem pairs S coh := by
  intro o htw _ t0 t1 m0 m1 hs0 hs1 hm0 hm1 hl0 hl1 hc0 hc1 _
  refine Or.inl ?_
  obtain ⟨b, S', L, o', hseg, hL, htw', rfl⟩ := htw
  have hlt := TwoAt_lt htw'
  have hv0 := CellOK_cover h1 hseg hL (show o' < nWords L by omega)
  have hv1 : b + o' + 1 < vals.length := by
    have := CellOK_cover h1 hseg hL (show o' + 1 < nWords L by omega); omega
  have k0 := h2 _ _ (List.getElem?_eq_getElem hv0)
  have k1 := h2 _ _ (List.getElem?_eq_getElem hv1)
  have e0 : t0 = coh ⟨l, b + o'⟩ := by
    rcases Nat.lt_or_eq_of_le hc0 with hlt' | he
    · exact absurd (k0.2.2 t0 m0 hlt' hm0 hl0) hs0
    · exact he.symm
  have e1 : t1 = coh ⟨l, b + o' + 1⟩ := by
    rcases Nat.lt_or_eq_of_le hc1 with hlt' | he
    · exact absurd (k1.2.2 t1 m1 hlt' hm1 hl1) hs1
    · exact he.symm
  obtain ⟨mc0, hmc0, -, hv0', hw0'⟩ := k0.1
  obtain ⟨mc1, hmc1, -, hv1', hw1'⟩ := k1.1
  rw [← e0, hm0] at hmc0; cases hmc0
  rw [← e1, hm1] at hmc1; cases hmc1
  refine ⟨e0, e1, fun v hv => ?_, fun v hv => ?_⟩
  · rw [List.getElem?_eq_getElem hv0] at hv; cases hv; exact ⟨hv0'.symm, hw0'⟩
  · rw [List.getElem?_eq_getElem hv1] at hv; cases hv; exact ⟨hv1'.symm, hw1'⟩

/-- (F2) **An own cell under a publish-style env change**: a cell without a
frontier gains one (its words are then at `LatestS`, so `OwnPairF` holds), or
its frontier is kept (`OwnCellF_env`). -/
theorem OwnCellF_pub {η η' : TEnv} {mem : Memory} {pairs : List Ts} {vs : VState} {S : Ts → Prop}
    {l : AllocLabel} {c : Cell} (h : OwnCellF η mem pairs vs S l c)
    (f : ∀ {U : Ty} {vs : List Word}, ValOf η U vs → ValOf η' U vs)
    (hini : η'.ini l = η.ini l) (hpfr : η.pfr l = none ∨ η'.pfr l = η.pfr l)
    (hsz : ∀ p, p ∈ pairs → p + 1 < mem.size) (hri : η'.rini l = η.rini l := by first | rfl | assumption) :
    OwnCellF η' mem pairs vs S l c := by
  rcases hpfr with hn | he
  · obtain ⟨vals, h1, h2, -⟩ := h
    have h1' : CellOK η' (η'.rc l) c.ty vals := CellOK_map f (Nat.le_of_eq (TEnv.rc_congr hini hri)) h1
    have hS : ∀ o v, vals[o]? = some v → LatestS mem S vs.coh ⟨l, o⟩ v := fun o v hv => by
      have := h2 o v hv; rw [hn] at this; exact LatestSF_none this
    exact ⟨vals, h1', fun o v hv => LatestSF_of_LatestS (hS o v hv), fun _ => OwnPairF_of_LatestS h1' hS⟩
  · exact OwnCellF_env h f hini he hsz hri

/-- (F2) **An own cell at another label than an allocation's** keeps its part of
`OwnOKSF`. -/
theorem OwnCellF_alloc {k : Promises.Knobs} {arch : Arch} {lbl : AllocLabel} {us : List Acc} {ws : List Word}
    {s : St} {η η' : TEnv} {l : AllocLabel} {c : Cell}
    (h : OwnCellF η s.mem s.pairs s.vs (· ∈ s.promises) l c) (hl : l ≠ lbl)
    (f : ∀ {U : Ty} {vs : List Word}, ValOf η U vs → ValOf η' U vs)
    (hini : η'.ini l = η.ini l) (hpfr : η'.pfr l = η.pfr l)
    (hri : η'.rini l = η.rini l) (hpl : PromLt s) (hsz : ∀ p, p ∈ s.pairs → p + 1 < s.mem.size) :
    ∀ r, r ∈ alloc k arch lbl us ws s → OwnCellF η' r.1.mem r.1.pairs r.1.vs (· ∈ r.1.promises) l c := by
  intro r hr
  obtain ⟨s1, hs, -, -, -, -, -, -, ec, -, -, -⟩ := alloc_unf hr
  obtain ⟨gg, gs, -, -, gf⟩ := alloc_growsP hpl r hr
  obtain ⟨-, -, u3, -⟩ := storeUnits_untouched us ws 0 s1 r.1 hs
  exact OwnCellF_frame h f hini hpfr gg.2.1
    (fun t m ht hm e => hl (by rw [← e]; exact gg.2.2 t m ht hm))
    (fun o => by
      rw [u3 _ (fun j _ e => hl (congrArg WeakMem.Address.label e)), ec _ hl])
    (fun t h => gs.subset h)
    (fun t m h hm e => Classical.byContradiction fun hn => by
      obtain ⟨m', hm', e'⟩ := gf t h hn
      rw [hm] at hm'; cases hm'; exact hl (e.symm.trans e'))
    (alloc_pairs r hr) hsz hri

/-- (S4) **Allocation, promises skipped**: at a fresh label (whose messages
are all own promises), with the stored words a value of `T`, memory stays OK
and the new cell is the thread's own, at its latest words; the other own cells
are untouched. -/
theorem alloc_okP {k : Promises.Knobs} {arch : Arch} {lbl : AllocLabel} {us : List Acc} {ws : List Word}
    {s : St} {η : TEnv} {T : Ty} (hus : wc T = some (nWords us)) (hlen : ws.length = nWords us)
    (hv : ValOf (allocE η lbl T) T (ws.map (bumpW s.vs.vRelSt)))
    (hfresh : ∀ (t : Nat) (m : Msg), s.mem[t]? = some m → m.loc.label = lbl → t ∈ s.promises)
    (hnone : η.sto lbl = none) (hpl : PromLt s) (hnd : s.promises.Nodup)
    (hpp : ∀ t, t ∈ s.promises → t ∉ s.pairs) (hpf0 : η.pfr lbl = none)
    (hm : MemOKP η s.mem s.pairs s.promises) (ho : OwnOKPF η s.mem s.pairs s.vs s.promises) :
    ∀ r, r ∈ alloc k arch lbl us ws s →
      MemOKP (allocE η lbl T) r.1.mem r.1.pairs r.1.promises ∧
      OwnOKPF (allocE η lbl T) r.1.mem r.1.pairs r.1.vs r.1.promises ∧ r.2 = cst (.loc ⟨lbl, 0⟩ 0) := by
  intro r hr
  obtain ⟨l1, l2⟩ := alloc_latP hpl hnd r hr
  obtain ⟨s1, hs, hr2, e4, e2, -, e6, -, -, -, esz, eget⟩ := alloc_unf hr
  have hold : ∀ t, t < s.mem.size → s1.mem[t]? = s.mem[t]? := fun t ht => by rw [eget t]; simp [ht]
  have hmono : ∀ {U : Ty} {vs : List Word}, ValOf η U vs → ValOf (allocE η lbl T) U vs :=
    fun h => ValOf_mono (η₁ := η) (η₂ := allocE η lbl T) rfl rfl (fun _ _ h' => allocE_sub hnone h')
      (fun _ => Nat.le_refl _) h
  have hM1 : MemOKP (allocE η lbl T) s1.mem s1.pairs s1.promises := by
    obtain ⟨h1, h2, h3⟩ := hm
    rw [e2, e4]
    refine ⟨fun t m c hP ht hc => ?_, fun t m0 m1 c hp h0 h1' hc => ?_, fun t hp => ?_⟩
    · rw [eget t] at ht
      by_cases hlt : t < s.mem.size
      · simp only [hlt, ite_true] at ht
        have hne : m.loc.label ≠ lbl := fun e => hP (hfresh t m ht e)
        rw [allocE_ne hne] at hc
        rcases h1 t m c hP ht hc with hu | hw
        · exact Or.inl hu
        · exact Or.inr (WordOK_map hmono hw)
      · simp only [hlt, ite_false] at ht
        split at ht
        · simp only [Option.some.injEq] at ht; subst ht; exact Or.inl rfl
        · cases ht
    · have hl := h3 t hp
      rw [hold t (Nat.lt_of_succ_lt hl)] at h0
      rw [hold (t + 1) hl] at h1'
      have hne : m0.loc.label ≠ lbl := fun e => hpp t (hfresh t m0 h0 e) hp
      rw [allocE_ne hne] at hc
      exact PairOK_map hmono (h2 t m0 m1 c hp h0 h1' hc)
    · rw [esz]; exact Nat.lt_of_lt_of_le (h3 t hp) (Nat.le_add_right _ _)
  have hmem := storeUnits_memOKP (a := ⟨lbl, 0⟩) (b := 0) (o0 := 0) (allocE_eq (η := η) (T := T))
    (Or.inl ⟨rfl, rfl, by obtain ⟨_, h, -⟩ := wc_some hus; simp [h]⟩) rfl
    ⟨hv, ShapeC_of_wc hus (by rw [List.length_map]; exact hlen)⟩ us ws 0 s1
    (fun j w hw => ⟨bumpW s.vs.vRelSt w, by simp [hw], WLe1_refl _⟩) (Nat.le_of_eq e6.symm) hM1 r.1 hs
  refine ⟨hmem, fun l' c' hc' hown' => ?_, hr2⟩
  by_cases hl : l' = lbl
  · subst hl
    rw [allocE_eq] at hc'; cases hc'
    refine ⟨ws.map (bumpW s.vs.vRelSt), Or.inl ⟨by rw [hus, List.length_map, hlen], hv⟩, fun o w' hw' => ?_,
      fun h => absurd hpf0 h⟩
    refine LatestSF_of_LatestS ?_
    obtain ⟨w, hw, rfl⟩ : ∃ w, ws[o]? = some w ∧ bumpW s.vs.vRelSt w = w' := by
      rw [List.getElem?_map] at hw'
      cases h : ws[o]? with
      | none => simp [h] at hw'
      | some w => simp only [h, Option.map_some, Option.some.injEq] at hw'; exact ⟨w, rfl, hw'⟩
    have hlt : o < nWords us := by
      rw [← hlen]; exact (List.getElem?_eq_some_iff.1 hw).1
    exact l1 o w hlt hw
  · rw [allocE_ne hl] at hc'
    exact OwnCellF_alloc (ho l' c' hc' hown') hl hmono rfl rfl rfl hpl hm.2.2 r hr

/-- (S4) `OwnOK_plain` with promises skipped. -/
theorem OwnOKP_plain {η : TEnv} {mem : Memory} {vs : VState} {P : List Ts} {l : AllocLabel} {c : Cell}
    (ho : OwnOKP η mem vs P) (hc : η.sto l = some c) (hown : c.owner = some η.tid)
    (hT : ∀ N e, c.ty ≠ .array (.lit N) e) :
    ∃ vals, wc c.ty = some vals.length ∧ ValOf η c.ty vals ∧
      ∀ o v, vals[o]? = some v → LatestP mem P vs.coh ⟨l, o⟩ v := by
  obtain ⟨vals, h1, h2⟩ := ho l c hc hown
  obtain ⟨h3, h4⟩ := h1.plain hT
  exact ⟨vals, h3, h4, h2⟩

/-- (S4) The words of an own cell have only own promises past coherence. -/
theorem OwnOKP_tail {η : TEnv} {s : St} {l : AllocLabel} {c : Cell} {n : Nat}
    (ho : OwnOKP η s.mem s.vs s.promises) (hc : η.sto l = some c) (hown : c.owner = some η.tid)
    (hus : wc c.ty = some n) : ∀ j : Nat, j < n → TailP s ⟨l, j⟩ := by
  intro j hj
  obtain ⟨vals, h1, -, h4⟩ := OwnOKP_plain ho hc hown (notArr_of_wc hus)
  rw [hus, Option.some.injEq] at h1
  have hj' : j < vals.length := by rw [← h1]; exact hj
  exact fun t m ht hm hl => (h4 j (vals[j]'hj') (List.getElem?_eq_getElem hj')).2.2 t m ht hm hl

/-- (F2) Two coherence positions at which an address has a `LatestS` word agree. -/
theorem LatestS_coh_eq {mem : Memory} {S : Ts → Prop} {coh coh' : Address → Ts} {a : Address} {v v' : Word}
    (h : LatestS mem S coh a v) (h' : LatestS mem S coh' a v') : coh' a = coh a := by
  obtain ⟨⟨m, hm, hl, -⟩, hn, hab⟩ := h
  obtain ⟨⟨m', hm', hl', -⟩, hn', hab'⟩ := h'
  rcases Nat.lt_trichotomy (coh a) (coh' a) with hlt | he | hlt
  · exact absurd (hab _ m' hlt hm' hl') hn'
  · exact he.symm
  · exact absurd (hab' _ m hlt hm hl) hn

/-- (F2) `LatestS` only reads coherence at its address. -/
theorem LatestS_coh_congr {mem : Memory} {S : Ts → Prop} {coh coh' : Address → Ts} {a : Address} {v : Word}
    (hc : coh' a = coh a) (h : LatestS mem S coh a v) : LatestS mem S coh' a v :=
  ⟨by rw [hc]; exact h.1, by rw [hc]; exact h.2.1, by rw [hc]; exact h.2.2⟩

/-- (F2) An own cell without a frontier: `OwnOKPF` gives its words at `LatestP`. -/
theorem OwnOKPF_cellP {η : TEnv} {mem : Memory} {pairs : List Ts} {vs : VState} {P : List Ts}
    {l : AllocLabel} {c : Cell} (ho : OwnOKPF η mem pairs vs P) (hc : η.sto l = some c)
    (hown : c.owner = some η.tid) (hpf : η.pfr l = none) :
    ∃ vals, CellOK η (η.rc l) c.ty vals ∧ ∀ o v, vals[o]? = some v → LatestP mem P vs.coh ⟨l, o⟩ v := by
  obtain ⟨vals, h1, h2, -⟩ := ho l c hc hown
  exact ⟨vals, h1, fun o v hv => LatestSF_none (by have := h2 o v hv; rwa [hpf] at this)⟩

/-- (F2) `OwnOKP_tail` at an own cell without a frontier. -/
theorem OwnOKPF_tail {η : TEnv} {s : St} {l : AllocLabel} {c : Cell} {n : Nat}
    (ho : OwnOKPF η s.mem s.pairs s.vs s.promises) (hc : η.sto l = some c) (hown : c.owner = some η.tid)
    (hpf : η.pfr l = none) (hus : wc c.ty = some n) : ∀ j : Nat, j < n → TailP s ⟨l, j⟩ := by
  intro j hj
  obtain ⟨vals, h1, h4⟩ := OwnOKPF_cellP ho hc hown hpf
  obtain ⟨h3, -⟩ := h1.plain (notArr_of_wc hus)
  rw [hus, Option.some.injEq] at h3
  have hj' : j < vals.length := by rw [← h3]; exact hj
  exact fun t m ht hm hl => (h4 j (vals[j]'hj') (List.getElem?_eq_getElem hj')).2.2 t m ht hm hl

/-- (F2) **The frontier facts the read-modify-write and buffer-init steps need**:
at every own cell of the thread with a frontier, the cell's words are at `LatestP`
(the strict, frontier-free form `OwnOKPF` gives at cells without a frontier).
This is discharged in S8-own together with `OwnNVP`. -/
def OwnFrontierRMW (E : TEnv) (s : St) : Prop :=
  ∀ l c f, E.sto l = some c → c.owner = some E.tid → E.pfr l = some f →
    ∃ vals, CellOK E (E.rc l) c.ty vals ∧ ∀ o v, vals[o]? = some v → LatestP s.mem s.promises s.vs.coh ⟨l, o⟩ v

/-- (F2) `OwnFrontierRMW` holds when no own cell has a frontier. -/
theorem OwnFrontierRMW_priv {E : TEnv} {s : St}
    (h : ∀ l c, E.sto l = some c → c.owner = some E.tid → E.pfr l = none) : OwnFrontierRMW E s :=
  fun l c f hc hown hf => by rw [h l c hc hown] at hf; exact absurd hf (by simp)

/-- (S8-own A1) The own-path terms that still read an own cell's words at
`LatestP` when the cell has a frontier: `xchg`, `xchgAt`, `xchgAtF`, `stlw`,
`stl`, `bufInit`. (`cas`/`fetch` need `LatestP` only at private cells, from
`OwnOKPF`, `rmw_ownLatest`.) -/
def OwnRMWT (t : Expr) : Prop :=
  ∃ x e, (∃ a v, t = .let_ x (.xchg a v) e) ∨ (∃ b i v, t = .let_ x (.xchgAt b i v) e) ∨
    (∃ b i q v, t = .let_ x (.xchgAtF b i q v) e) ∨ (∃ b wi jl v, t = .let_ x (.stlw b wi jl v) e) ∨
    (∃ b i v, t = .let_ x (.stl b i v) e) ∨ (∃ b i v, t = .let_ x (.bufInit b i v) e)

/-- (S8-own A1) **The narrowed `OwnFrontierRMW` residual**: needed only when the
current term is an `OwnRMWT` term. -/
def OwnFrontierRMWT (E : TEnv) (s : St) (t : Expr) : Prop := OwnRMWT t → OwnFrontierRMW E s

/-- (switch) **The own-path ops**: the `OwnRMWT` terms and the non-word
`ptr own`/`loc own` stores, the terms whose step reads `NVP` at its cell. -/
def OwnOpT (cx : Cx) (t : Expr) : Prop :=
  OwnRMWT t ∨ ∃ x rel a v tok e u, t = .let_ x (.store rel a v tok) e ∧
    ((cx.peek a = .ok (.ptr .own u) ∧ wordOf (Ty.ptr .own u) = none) ∨
      (cx.peek a = .ok (.loc .own u) ∧ wordOf (Ty.loc .own u) = none))

/-- (F2) An own cell's words at `LatestP`, from `OwnOKPF` and `OwnFrontierRMW`. -/
theorem own_cellP {E : TEnv} {s : St} {l : AllocLabel} {c : Cell}
    (ho : OwnOKPF E s.mem s.pairs s.vs s.promises) (hRF : OwnFrontierRMW E s) (hc : E.sto l = some c)
    (hown : c.owner = some E.tid) :
    ∃ vals, CellOK E (E.rc l) c.ty vals ∧ ∀ o v, vals[o]? = some v → LatestP s.mem s.promises s.vs.coh ⟨l, o⟩ v := by
  rcases hpf : E.pfr l with _ | f
  · exact OwnOKPF_cellP ho hc hown hpf
  · exact hRF l c f hc hown hpf

/-- (F2) `TailP` at the words of an own cell given at `LatestP`. -/
theorem cellP_tail {E : TEnv} {s : St} {l : AllocLabel} {c : Cell} {n : Nat}
    (hcP : ∃ vals, CellOK E (E.ini l) c.ty vals ∧ ∀ o v, vals[o]? = some v → LatestP s.mem s.promises s.vs.coh ⟨l, o⟩ v)
    (hus : wc c.ty = some n) : ∀ j : Nat, j < n → TailP s ⟨l, j⟩ := by
  intro j hj
  obtain ⟨vals, h1, h4⟩ := hcP
  obtain ⟨h3, -⟩ := h1.plain (notArr_of_wc hus)
  rw [hus, Option.some.injEq] at h3
  have hj' : j < vals.length := by rw [← h3]; exact hj
  exact fun t m ht hm hl => (h4 j (vals[j]'hj') (List.getElem?_eq_getElem hj')).2.2 t m ht hm hl

/-- (F2) After a load from `s` to `s1` (`LoadCoh`, coherence only raised), an own
cell whose words are at `LatestP` at `s` keeps its coherence, hence its tails. -/
theorem cellP_tailLoad {E : TEnv} {s s1 : St} {l : AllocLabel} {c : Cell} {n n0 : Nat}
    (hcP : ∃ vals, CellOK E n0 c.ty vals ∧ ∀ o v, vals[o]? = some v → LatestP s.mem s.promises s.vs.coh ⟨l, o⟩ v)
    (hlc : LoadCoh E s s1) (hmono : ∀ b, s.vs.coh b ≤ s1.vs.coh b) (e1 : s1.mem = s.mem)
    (e2 : s1.promises = s.promises) (hsto : E.sto l = some c) (hown : c.owner = some E.tid)
    (hus : wc c.ty = some n) : ∀ j : Nat, j < n → TailP s1 ⟨l, j⟩ := by
  intro j hj
  obtain ⟨vals, h1, h4⟩ := hcP
  obtain ⟨h3, -⟩ := h1.plain (notArr_of_wc hus)
  rw [hus, Option.some.injEq] at h3
  obtain ⟨valsB, hB1, hB4, -⟩ := hlc.1 l c hsto hown
  obtain ⟨h3B, -⟩ := hB1.plain (notArr_of_wc hus)
  rw [hus, Option.some.injEq] at h3B
  have hj' : j < vals.length := by rw [← h3]; exact hj
  have hjB : j < valsB.length := by rw [← h3B]; exact hj
  have hA := h4 j (vals[j]'hj') (List.getElem?_eq_getElem hj')
  obtain ⟨⟨m1, hm1, hl1, -⟩, hn1, -⟩ := hB4 j (valsB[j]'hjB) (List.getElem?_eq_getElem hjB)
  have heq : s1.vs.coh ⟨l, j⟩ = s.vs.coh ⟨l, j⟩ := by
    rcases Nat.lt_or_ge (s.vs.coh ⟨l, j⟩) (s1.vs.coh ⟨l, j⟩) with hlt | hge
    · exact absurd (hA.2.2 _ m1 hlt hm1 hl1) hn1
    · exact Nat.le_antisymm hge (hmono _)
  unfold TailP; rw [e1, e2, heq]
  exact fun t m ht hm hl => hA.2.2 t m ht hm hl

/-- (S4, F2) **Storing a whole value to an own cell** keeps both invariants, the
thread's own promises skipped — whether or not the store fulfils them.  (F2) The
store is laid out as the cell (`hacc`), so at a cell with a frontier its pair
units are the cell's (`OwnCellF_store`). -/
theorem OwnOKP_store {k : Promises.Knobs} {arch : Arch} {pw : Word} {rel : Bool} {η : TEnv}
    {l : AllocLabel} {c : Cell} {us : List Acc} {ws : List Word}
    (hc : η.sto l = some c) (hown : c.owner = some η.tid) (hacc : accs c.ty = some us)
    {V : Ts} (hv : ValOf η c.ty (ws.map (bumpW V))) (hlen : ws.length = nWords us)
    {s : St} (hV : V ≤ s.vs.vRelSt) (hpl : PromLt s) (hnd : s.promises.Nodup)
    (hm : MemOKP η s.mem s.pairs s.promises) (ho : OwnOKPF η s.mem s.pairs s.vs s.promises) :
    ∀ s', s' ∈ storeUnits k arch pw ⟨l, 0⟩ rel us ws 0 s →
      MemOKP η s'.mem s'.pairs s'.promises ∧ OwnOKPF η s'.mem s'.pairs s'.vs s'.promises := by
  intro s' hs
  have hus : wc c.ty = some (nWords us) := wc_of_accs hacc
  have hm' := storeUnits_memOKP (a := ⟨l, 0⟩) (b := 0) (o0 := 0) hc
    (Or.inl ⟨rfl, rfl, by simp [hacc]⟩) rfl
    ⟨hv, ShapeC_of_wc hus (by rw [List.length_map]; exact hlen)⟩ us ws 0 s
    (fun j w hw => ⟨bumpW V w, by simp [hw], WLe1_refl _⟩) hV hm s' hs
  refine ⟨hm', fun l' c' hc' hown' => ?_⟩
  by_cases hl : l' = l
  · subst hl; rw [hc] at hc'; cases hc'
    obtain ⟨vals, h1, h2, h3⟩ := ho l' c hc hown
    obtain ⟨hwl, -⟩ := h1.plain (notArr_of_wc hus)
    rw [hus, Option.some.injEq] at hwl
    exact OwnCellF_store (a := ⟨l', 0⟩) (A := 0) rfl (E := η) (E' := η) h2 h3 id rfl (fun o h _ _ => h)
      (Or.inl ⟨by rw [hus, List.length_map, hlen], hv⟩)
      (fun j w hw => by simp [hw])
      (fun o ho => by
        rcases ho with ho | ho
        · omega
        · rw [List.getElem?_eq_none (by simp; omega), List.getElem?_eq_none (by omega)])
      (by omega)
      (fun _ o htw _ _ => ⟨Nat.zero_le _, by simpa using TwoAtT_whole hacc htw⟩)
      hlen hV hpl hnd hm.2.2 hs
  · exact OwnCellF_storeOther (ho l' c' hc' hown') hl id rfl rfl hpl hm.2.2 hs

/-- (S4) A message at `a` at or below the bound leads to a readable one. -/
theorem readable_up {mem : Memory} {a : Address} {bound : Nat} :
    ∀ (k t : Nat) (m : Msg), bound - t ≤ k → t ≤ bound → mem[t]? = some m → m.loc = a →
      ∃ t' : Nat, t ≤ t' ∧ t' < mem.size ∧ WeakMem.readable mem a t' bound = true := by
  intro k
  induction k with
  | zero =>
    intro t m hk htb hm hma
    refine ⟨t, Nat.le_refl _, lt_of_get hm, ?_⟩
    have hh : WeakMem.hiddenFrom mem a t bound = false := by
      unfold WeakMem.hiddenFrom; rw [Bool.eq_false_iff]; intro h
      rw [List.any_eq_true] at h
      obtain ⟨t', ht', h⟩ := h
      simp only [Bool.and_eq_true, decide_eq_true_eq] at h
      obtain ⟨hlt, -⟩ := h
      have hb : t' < bound + 1 := List.mem_range.1 ht'
      have hlt' : t < t' := hlt
      omega
    simp [WeakMem.readable, hm, hma, hh]
  | succ k ih =>
    intro t m hk htb hm hma
    cases hh : WeakMem.hiddenFrom mem a t bound with
    | false => exact ⟨t, Nat.le_refl _, lt_of_get hm, by simp [WeakMem.readable, hm, hma, hh]⟩
    | true =>
      unfold WeakMem.hiddenFrom at hh
      rw [List.any_eq_true] at hh
      obtain ⟨t', ht', h⟩ := hh
      simp only [Bool.and_eq_true, decide_eq_true_eq] at h
      obtain ⟨hlt, h⟩ := h
      have hlt' : t < t' := hlt
      have hb : t' < bound + 1 := List.mem_range.1 ht'
      cases ht2 : mem[t']? with
      | none => simp [ht2] at h
      | some m' =>
        simp [ht2] at h
        obtain ⟨t'', a1, a2, a3⟩ := ih t' m' (by omega) (by omega) ht2 h
        exact ⟨t'', Nat.le_trans (Nat.le_of_lt hlt') a1, a2, a3⟩

/-- (S4) A load leaves coherence alone away from its address. -/
theorem stepLoad_cohOther {arch : Arch} {mem : Memory} {pairs : List Ts} {th th' : Promises.Thread}
    {dst : WeakMem.Reg} {a : Address} {deps : List WeakMem.Reg} {acq : Bool}
    (h : th' ∈ Promises.stepLoad arch mem pairs th dst a deps acq) :
    ∀ b, b ≠ a → th'.vs.coh b = th.vs.coh b := by
  simp only [Promises.stepLoad, List.mem_map, List.mem_filter, List.mem_range] at h
  obtain ⟨t, -, rfl⟩ := h
  intro b hb; simp [hb]

theorem stepLoadPair_cohOther {arch : Arch} {mem : Memory} {pairs : List Ts} {th th' : Promises.Thread}
    {dst0 dst1 : WeakMem.Reg} {a : Address} {deps : List WeakMem.Reg} {acq : Bool}
    (h : th' ∈ Promises.stepLoadPair arch mem pairs th dst0 dst1 a deps acq) :
    ∀ b, b ≠ a → b ≠ a.next → th'.vs.coh b = th.vs.coh b := by
  simp only [Promises.stepLoadPair, List.mem_flatMap, List.mem_filterMap, List.mem_filter,
    List.mem_range] at h
  obtain ⟨t0, -, t1, -, hs⟩ := h
  split at hs
  · exact absurd hs (by simp)
  · simp only [Option.some.injEq] at hs
    subst hs
    intro b h0 h1; simp [h0, h1]

/-- (S4) **Loads at latest words have an outcome**, own promises skipped (a
pair load needs no promise at either word of a pair store, `PromOK_pp`). -/
theorem loadUnits_nonemptyP {arch : Arch} {pw : Word} {a : Address} {acq : Bool} :
    ∀ (us : List Acc) (k : Nat) (s : St) (vals : List Word), vals.length = nWords us →
      (∀ t, t ∈ s.promises → ∀ p, p ∈ s.pairs → t ≠ p ∧ t ≠ p + 1) →
      (∀ j v, vals[j]? = some v → LatestP s.mem s.promises s.vs.coh (offs a (k + j)) v) →
      ∃ r, r ∈ loadUnits arch pw a acq us k s
  | [], k, s, _, _, _, _ => ⟨(s, []), by simp [loadUnits]⟩
  | .one :: us, k, s, vals, hn, hpp, hl => by
      cases vals with
      | nil => simp [nWords, Acc.size] at hn; omega
      | cons v rest =>
          have hl0 : LatestP s.mem s.promises s.vs.coh (offs a k) v := by
            have := hl 0 v rfl; simpa using this
          obtain ⟨m0, hm0, hma0, -⟩ := hl0.1
          obtain ⟨t, -, hlt, hr⟩ := readable_up
            (bound := Promises.readBoundOf arch s.vs (Promises.depBound (mth s pw pw pw).regs [0]) (offs a k))
            _ _ m0 (Nat.le_refl _) (coh_le_readBound _ _ _ _) hm0 hma0
          have hx : ∃ th, th ∈ Promises.stepLoad arch s.mem s.pairs (mth s pw pw pw) 1 (offs a k) [0] acq :=
            ⟨_, List.mem_map_of_mem (List.mem_filter.2 ⟨List.mem_range.2 hlt, hr⟩)⟩
          obtain ⟨th, hth⟩ := hx
          have hc := stepLoad_cohOther hth
          have hn' : rest.length = nWords us := by
            simp [nWords, Acc.size] at hn ⊢; omega
          obtain ⟨⟨s', ws⟩, hmem⟩ := loadUnits_nonemptyP (arch := arch) (pw := pw) (a := a) (acq := acq) us (k + 1)
            { s with vs := th.vs, undefs := s.undefs + countUndef [th.regs 1] } rest hn' hpp
            (fun j v' hj => by
              have := hl (j + 1) v' (by simpa using hj)
              rw [show k + 1 + j = k + (j + 1) by omega]
              exact LatestS_congr this (hc _ (by simp [offs] <;> omega)) (fun _ h => h) (fun _ h => h))
          exact ⟨_, by
            simp only [loadUnits, List.mem_flatMap, List.mem_map]
            exact ⟨th, hth, (s', ws), hmem, rfl⟩⟩
  | .two :: us, k, s, vals, hn, hpp, hl => by
      match vals, hn, hl with
      | [], hn, _ => simp [nWords, Acc.size] at hn; omega
      | [_], hn, _ => simp [nWords, Acc.size] at hn; omega
      | v0 :: v1 :: rest, hn, hl =>
          have hl0 : LatestP s.mem s.promises s.vs.coh (offs a k) v0 := by
            have := hl 0 v0 rfl; simpa using this
          have hl1 : LatestP s.mem s.promises s.vs.coh (offs a k).next v1 := by
            have := hl 1 v1 rfl
            have e : (offs a k).next = offs a (k + 1) := by simp [offs, WeakMem.Address.next, Nat.add_assoc]
            rw [e]; simpa using this
          let d := Promises.depBound (mth s pw pw pw).regs [0]
          obtain ⟨m0, hm0, hma0, -⟩ := hl0.1
          obtain ⟨m1, hm1, hma1, -⟩ := hl1.1
          obtain ⟨t0, ht0, hlt0, hr0⟩ := readable_up (bound := Promises.readBoundOf arch s.vs d (offs a k))
            _ _ m0 (Nat.le_refl _) (coh_le_readBound _ _ _ _) hm0 hma0
          obtain ⟨t1, ht1, hlt1, hr1⟩ := readable_up (bound := Promises.readBoundOf arch s.vs d (offs a k).next)
            _ _ m1 (Nat.le_refl _) (coh_le_readBound _ _ _ _) hm1 hma1
          have hns : WeakMem.pairStraddles s.mem s.pairs (offs a k) t0 t1 = false := by
            unfold WeakMem.pairStraddles
            rw [Bool.eq_false_iff]
            intro h
            rw [List.any_eq_true] at h
            obtain ⟨p, hp, h⟩ := h
            simp only [Bool.and_eq_true] at h
            obtain ⟨⟨h0, h1⟩, h2⟩ := h
            have e0 : p ≤ t0 := by
              cases hp0 : s.mem[p]? with
              | none => simp [hp0] at h0
              | some m =>
                  simp [hp0] at h0
                  refine Nat.le_trans (Nat.le_of_not_lt fun hlt => ?_) ht0
                  exact (hpp p (hl0.2.2 p m hlt hp0 h0) p hp).1 rfl
            have e1 : p + 1 ≤ t1 := by
              cases hp1 : s.mem[p + 1]? with
              | none => simp [hp1] at h1
              | some m =>
                  simp [hp1] at h1
                  refine Nat.le_trans (Nat.le_of_not_lt fun hlt => ?_) ht1
                  exact (hpp (p + 1) (hl1.2.2 (p + 1) m hlt hp1 h1) p hp).2 rfl
            simp [e0, e1] at h2
          have hx : ∃ th, th ∈ Promises.stepLoadPair arch s.mem s.pairs (mth s pw pw pw) 1 2 (offs a k) [0] acq := by
            simp only [Promises.stepLoadPair, List.mem_flatMap, List.mem_filterMap, List.mem_filter,
              List.mem_range]
            exact ⟨_, _, ⟨hlt0, hr0⟩, _, ⟨hlt1, hr1⟩, by simp only [mth] at hns ⊢; rw [hns]; rfl⟩
          obtain ⟨th, hth⟩ := hx
          have hc := stepLoadPair_cohOther hth
          have hn' : rest.length = nWords us := by
            simp only [List.length_cons, nWords, List.map_cons, List.sum_cons, Acc.size] at hn ⊢; omega
          obtain ⟨⟨s', ws⟩, hmem⟩ := loadUnits_nonemptyP (arch := arch) (pw := pw) (a := a) (acq := acq) us (k + 2)
            { s with vs := th.vs, undefs := s.undefs + countUndef [th.regs 1, th.regs 2] } rest hn' hpp
            (fun j v' hj => by
              have := hl (j + 2) v' (by simpa using hj)
              rw [show k + 2 + j = k + (j + 2) by omega]
              exact LatestS_congr this (hc _ (by simp [offs] <;> omega)
                (by
                  intro h; have h3 := congrArg WeakMem.Address.offset h
                  change a.offset + (k + (j + 2)) = a.offset + k + 1 at h3
                  rw [Nat.add_assoc] at h3
                  have h4 := Nat.add_left_cancel h3
                  omega)) (fun _ h => h) (fun _ h => h))
          exact ⟨_, by
            simp only [loadUnits, List.mem_flatMap, List.mem_map]
            exact ⟨th, hth, (s', ws), hmem, rfl⟩⟩

/-- (S8b) **Box words can always be loaded** when each is latest at a constant
coherence the reference's view reaches (with no outstanding promise at a pair
store). -/
theorem loadUnits_nonemptyT {arch : Arch} {pw : Word} {a : Address} {acq : Bool} :
    ∀ (us : List Acc) (k : Nat) (s : St) (vals : List Word), vals.length = nWords us →
      (∀ t, t ∈ s.promises → ∀ p, p ∈ s.pairs → t ≠ p ∧ t ≠ p + 1) →
      (∀ j v, vals[j]? = some v → ∃ t, t ≤ pw.view ∧ LatestP s.mem s.promises (fun _ => t) (offs a (k + j)) v) →
      ∃ r, r ∈ loadUnits arch pw a acq us k s
  | [], k, s, _, _, _, _ => ⟨(s, []), by simp [loadUnits]⟩
  | .one :: us, k, s, vals, hn, hpp, hl => by
      cases vals with
      | nil => simp [nWords, Acc.size] at hn; omega
      | cons v rest =>
          obtain ⟨t, ht, hl0⟩ : ∃ t, t ≤ pw.view ∧ LatestP s.mem s.promises (fun _ => t) (offs a k) v := by
            have := hl 0 v rfl; simpa using this
          obtain ⟨m0, hm0, hma0, -⟩ := hl0.1
          obtain ⟨t', -, hlt, hr⟩ := readable_up
            (bound := Promises.readBoundOf arch s.vs (Promises.depBound (mth s pw pw pw).regs [0]) (offs a k))
            _ _ m0 (Nat.le_refl _) (Nat.le_trans ht (view_le_readBound _ _ _ _)) hm0 hma0
          have hx : ∃ th, th ∈ Promises.stepLoad arch s.mem s.pairs (mth s pw pw pw) 1 (offs a k) [0] acq :=
            ⟨_, List.mem_map_of_mem (List.mem_filter.2 ⟨List.mem_range.2 hlt, hr⟩)⟩
          obtain ⟨th, hth⟩ := hx
          have hn' : rest.length = nWords us := by
            simp [nWords, Acc.size] at hn ⊢; omega
          obtain ⟨⟨s', ws⟩, hmem⟩ := loadUnits_nonemptyT (arch := arch) (pw := pw) (a := a) (acq := acq) us (k + 1)
            { s with vs := th.vs, undefs := s.undefs + countUndef [th.regs 1] } rest hn' hpp
            (fun j v' hj => by
              have := hl (j + 1) v' (by simpa using hj)
              rw [show k + 1 + j = k + (j + 1) by omega]
              exact this)
          exact ⟨_, by
            simp only [loadUnits, List.mem_flatMap, List.mem_map]
            exact ⟨th, hth, (s', ws), hmem, rfl⟩⟩
  | .two :: us, k, s, vals, hn, hpp, hl => by
      match vals, hn, hl with
      | [], hn, _ => simp [nWords, Acc.size] at hn; omega
      | [_], hn, _ => simp [nWords, Acc.size] at hn; omega
      | v0 :: v1 :: rest, hn, hl =>
          obtain ⟨u0, hu0, hl0⟩ : ∃ t, t ≤ pw.view ∧ LatestP s.mem s.promises (fun _ => t) (offs a k) v0 := by
            have := hl 0 v0 rfl; simpa using this
          obtain ⟨u1, hu1, hl1⟩ : ∃ t, t ≤ pw.view ∧ LatestP s.mem s.promises (fun _ => t) (offs a k).next v1 := by
            have := hl 1 v1 rfl
            have e : (offs a k).next = offs a (k + 1) := by simp [offs, WeakMem.Address.next, Nat.add_assoc]
            rw [e]; simpa using this
          let d := Promises.depBound (mth s pw pw pw).regs [0]
          obtain ⟨m0, hm0, hma0, -⟩ := hl0.1
          obtain ⟨m1, hm1, hma1, -⟩ := hl1.1
          obtain ⟨t0, ht0, hlt0, hr0⟩ := readable_up (bound := Promises.readBoundOf arch s.vs d (offs a k))
            _ _ m0 (Nat.le_refl _) (Nat.le_trans hu0 (view_le_readBound _ _ _ _)) hm0 hma0
          obtain ⟨t1, ht1, hlt1, hr1⟩ := readable_up (bound := Promises.readBoundOf arch s.vs d (offs a k).next)
            _ _ m1 (Nat.le_refl _) (Nat.le_trans hu1 (view_le_readBound _ _ _ _)) hm1 hma1
          have hns : WeakMem.pairStraddles s.mem s.pairs (offs a k) t0 t1 = false := by
            unfold WeakMem.pairStraddles
            rw [Bool.eq_false_iff]
            intro h
            rw [List.any_eq_true] at h
            obtain ⟨p, hp, h⟩ := h
            simp only [Bool.and_eq_true] at h
            obtain ⟨⟨h0, h1⟩, h2⟩ := h
            have e0 : p ≤ t0 := by
              cases hp0 : s.mem[p]? with
              | none => simp [hp0] at h0
              | some m =>
                  simp [hp0] at h0
                  refine Nat.le_trans (Nat.le_of_not_lt fun hlt => ?_) ht0
                  exact (hpp p (hl0.2.2 p m hlt hp0 h0) p hp).1 rfl
            have e1 : p + 1 ≤ t1 := by
              cases hp1 : s.mem[p + 1]? with
              | none => simp [hp1] at h1
              | some m =>
                  simp [hp1] at h1
                  refine Nat.le_trans (Nat.le_of_not_lt fun hlt => ?_) ht1
                  exact (hpp (p + 1) (hl1.2.2 (p + 1) m hlt hp1 h1) p hp).2 rfl
            simp [e0, e1] at h2
          have hx : ∃ th, th ∈ Promises.stepLoadPair arch s.mem s.pairs (mth s pw pw pw) 1 2 (offs a k) [0] acq := by
            simp only [Promises.stepLoadPair, List.mem_flatMap, List.mem_filterMap, List.mem_filter,
              List.mem_range]
            exact ⟨_, _, ⟨hlt0, hr0⟩, _, ⟨hlt1, hr1⟩, by simp only [mth] at hns ⊢; rw [hns]; rfl⟩
          obtain ⟨th, hth⟩ := hx
          have hn' : rest.length = nWords us := by
            simp only [List.length_cons, nWords, List.map_cons, List.sum_cons, Acc.size] at hn ⊢; omega
          obtain ⟨⟨s', ws⟩, hmem⟩ := loadUnits_nonemptyT (arch := arch) (pw := pw) (a := a) (acq := acq) us (k + 2)
            { s with vs := th.vs, undefs := s.undefs + countUndef [th.regs 1, th.regs 2] } rest hn' hpp
            (fun j v' hj => by
              have := hl (j + 2) v' (by simpa using hj)
              rw [show k + 2 + j = k + (j + 2) by omega]
              exact this)
          exact ⟨_, by
            simp only [loadUnits, List.mem_flatMap, List.mem_map]
            exact ⟨th, hth, (s', ws), hmem, rfl⟩⟩

/-- (S4) **Loading latest words** under `PromAbove` after the load: the
values read are the latest, coherence unmoved. -/
theorem loadUnits_latestPA {arch : Arch} {pw : Word} {a : Address} {acq : Bool} {us : List Acc} {k : Nat}
    {s : St} {vals : List Word} (hn : vals.length = nWords us)
    (hl : ∀ j v, vals[j]? = some v → LatestP s.mem s.promises s.vs.coh (offs a (k + j)) v)
    {r : St × List Word} (hr : r ∈ loadUnits arch pw a acq us k s) (hpa : PromAbove r.1) :
    WLe vals r.2 ∧ r.1.vs.coh = s.vs.coh ∧ r.1.mem = s.mem := by
  obtain ⟨e1, e2, hc⟩ := loadUnits_latestP us k s vals hn hl r hr
  rcases hc with h | ⟨t, m, ht, hm, hle⟩
  · exact ⟨h.1, h.2, e1⟩
  · exact (PromAbove_low hpa (by rw [e2]; exact ht) (by rw [e1]; exact hm) hle).elim

/-- (S4) With no outstanding promise, every promise is above coherence. -/
theorem PromAbove_nil {s : St} (h : s.promises = []) : PromAbove s := fun t ht => by
  rw [h] at ht; cases ht

/-- (S4) `PromAbove` reads only what `Same` keeps. -/
theorem PromAbove_same {s s' : St} (hs : Same s s') (h : PromAbove s') : PromAbove s := fun t ht m hm => by
  obtain ⟨e1, -, e3, e4, -⟩ := hs
  have := h t (by rw [e4]; exact ht) m (by rw [e1]; exact hm)
  rw [e3] at this; exact this

/-- (S4) `PromAbove` after a load holds before it: coherence only grows. -/
theorem loadUnits_pa {arch : Arch} {pw : Word} {a : Address} {acq : Bool} {us : List Acc} {k : Nat} {s : St}
    {r : St × List Word} (hr : r ∈ loadUnits arch pw a acq us k s) (h : PromAbove r.1) : PromAbove s := by
  obtain ⟨f1, -, f3, -⟩ := loadUnits_frame us k s r hr
  intro t ht m hm
  exact Nat.lt_of_le_of_lt (loadUnits_cohMono us k s r hr m.loc)
    (h t (by rw [f3]; exact ht) m (by rw [f1]; exact hm))

/-- (S4) **An own cell can always be loaded**, own promises skipped. -/
theorem OwnOKP_load_nonempty {arch : Arch} {pw : Word} {acq : Bool} {η : TEnv} {l : AllocLabel} {c : Cell}
    {us : List Acc} {s : St} (ho : OwnOKP η s.mem s.vs s.promises) (hpo : PromOK s) (hc : η.sto l = some c)
    (hown : c.owner = some η.tid) (hus : wc c.ty = some (nWords us)) :
    ∃ r, r ∈ loadUnits arch pw ⟨l, 0⟩ acq us 0 s := by
  obtain ⟨vals, h1, _, h4⟩ := OwnOKP_plain ho hc hown (notArr_of_wc hus)
  rw [hus, Option.some.injEq] at h1
  exact loadUnits_nonemptyP us 0 s vals h1.symm (PromOK_pp hpo) (fun j v hj => by
    have e : offs ⟨l, 0⟩ (0 + j) = ⟨l, j⟩ := by simp [offs]
    rw [e]; exact h4 j v hj)

/-- (S4) `MemOK_mono` with promises skipped. -/
theorem MemOKP_mono {η₁ η₂ : TEnv} {mem : Memory} {pairs P : List Ts} (h : MemOKP η₁ mem pairs P)
    (hp : η₁.prog = η₂.prog) (ht : η₁.tid = η₂.tid) (hs : ∀ l c, η₁.sto l = some c → η₂.sto l = some c)
    (hi : ∀ l, η₁.ini l ≤ η₂.ini l) (hnew : ∀ (t : Ts) (m : Msg) c, mem[t]? = some m → η₂.sto m.loc.label = some c →
      η₁.sto m.loc.label = some c)
    (hP : ∀ l f, η₁.pfr l = some f → η₂.pfr l = some f := by first | exact fun _ _ h => h | simp_all)
    (hS : ∀ l, η₁.seen l → η₂.seen l := by first | exact fun _ h => h | simp_all)
    (hB : ∀ l B, η₁.box l = some B → η₂.box l = some B := by first | exact fun _ _ h => h | simp_all)
    (hri : ∀ l, η₁.rini l ≤ η₂.rini l := by rini_le) :
    MemOKP η₂ mem pairs P := by
  obtain ⟨h1, h2, h3⟩ := h
  refine ⟨fun t m c hn ht' hc => ?_, fun t m0 m1 c hp' h0 h1' hc => ?_, h3⟩
  · rcases h1 t m c hn ht' (hnew t m c ht' hc) with hu | hw
    · exact Or.inl hu
    · exact Or.inr (WordOK_map (fun h => ValOf_mono hp ht hs hi h hP hS hB) hw)
  · exact PairOK_map (fun h => ValOf_mono hp ht hs hi h hP hS hB) (h2 t m0 m1 c hp' h0 h1' (hnew t m0 c h0 hc))

/-- (S4) **What a store of a segment's words does to memory**, whether or not
it fulfils promises: memory grows at the cell's label with words of the cell,
`vWr` grows, and every promise it fulfils is at the cell, a word of it. -/
theorem storeCoreP {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool}
    {η : TEnv} {c : Cell} {b o0 : Nat} {S : Ty} {vals : List Word} {V : Ts} {us : List Acc} {ws : List Word}
    {s s' : St} (hc : η.sto a.label = some c) (hseg : SegOf c.ty b S) (hbo : a.offset = b + o0)
    (hv : ValOfS η S vals)
    (hw : ∀ (j : Nat) w, ws[j]? = some w → ∃ w0, vals[o0 + j]? = some w0 ∧ WLe1 w0 (bumpW V w))
    (hV : V ≤ s.vs.vRelSt) (hpl : PromLt s) (hs : s' ∈ storeUnits k arch pw a rel us ws 0 s) :
    GrowsAt s.mem s'.mem a.label ∧ s'.nalloc = s.nalloc ∧ PromLt s' ∧ NewOK η s.mem s'.mem ∧
      s.vs.vWr ≤ s'.vs.vWr ∧
      (∀ t, t ∈ s.promises → t ∉ s'.promises → ∃ m, s.mem[t]? = some m ∧ m.loc.label = a.label) ∧
      (∀ (t : Nat) (m : Msg) (c' : Cell), t ∈ s.promises → t ∉ s'.promises → s.mem[t]? = some m →
        η.sto m.loc.label = some c' → WordOK η c'.ty m.loc.offset (mw m)) := by
  obtain ⟨hg, -, hna⟩ := storeUnits_growsF us ws 0 s s' hs
  obtain ⟨hpl', -, -⟩ := storeUnits_promF us ws 0 s s' hpl hs
  have hfo := storeUnits_fulOK (c := c) hseg hbo hv hw hV hpl hs
  refine ⟨hg, hna, hpl', fun t m c' ht hm hc' => ?_, storeUnits_wrF us ws 0 s s' hs,
    fun t h1 h2 => by obtain ⟨m, a1, a2, -⟩ := hfo t h1 h2; exact ⟨m, a1, a2⟩, fun t m c' h1 h2 hm hc' => ?_⟩
  · obtain ⟨hl, hok⟩ := storeUnits_newOKF hc hseg hbo hv us ws 0 s
      (fun j w h => by obtain ⟨w0, h1, h2⟩ := hw j w h; exact ⟨w0, by rw [Nat.add_zero]; exact h1, h2⟩) hV s' hs
      t m ht hm
    rw [hl, hc] at hc'
    cases hc'
    exact hok
  · obtain ⟨m', a1, a2, a3⟩ := hfo t h1 h2
    rw [hm] at a1; cases a1
    rw [a2, hc] at hc'; cases hc'; exact a3

/-- (S4) The fresh labels stay untouched across a store to a Σ cell. -/
theorem FreshLP_store {g : G} {E E' : TEnv} {s s' : St} {lab : AllocLabel} {c : Cell} (h : FreshLP g E s)
    (hsto : E.sto lab = some c) (hg : GrowsAt s.mem s'.mem lab) (hna : s'.nalloc = s.nalloc)
    (hful : ∀ t, t ∈ s.promises → t ∉ s'.promises → ∃ m, s.mem[t]? = some m ∧ m.loc.label = lab)
    (hE : ∀ l, l ≠ lab → E'.sto l = E.sto l ∧ E'.ini l = E.ini l ∧ E'.pfr l = E.pfr l)
    (hpc : PrivCoh E' s') : FreshLP g E' s' := by
  refine ⟨fun j hj => ?_, hpc⟩
  obtain ⟨f1, f2, f4, f5⟩ := h.1 j (by rw [← hna]; exact hj)
  have hne : freshLabel g.lbase g.n g.i j ≠ lab := fun e => by rw [e, hsto] at f1; cases f1
  obtain ⟨e1, e2, e3⟩ := hE _ hne
  refine ⟨by rw [e1]; exact f1, fun t m ht hl => ?_, by rw [e2]; exact f4, by rw [e3]; exact f5⟩
  by_cases hlt : t < s.mem.size
  · rw [hg.2.1 t hlt] at ht
    have hp := f2 t m ht hl
    refine Classical.byContradiction fun hn => ?_
    obtain ⟨m', hm', e⟩ := hful t hp hn
    rw [ht] at hm'; cases hm'
    exact hne (hl.symm.trans e)
  · exact absurd (hl.symm.trans (hg.2.2 t m (by omega) ht)) hne

/-- (S4) **The words a store writes are hidden** below the new `vWr` unless
they are words of the cell, own promises skipped: each is overwritten by the
store at a later timestamp (`storeUnits_wrP`); (F2) past coherence there were only
own promises and words of the cell. -/
theorem storeUnits_hidP {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool}
    {η : TEnv} {c : Cell} {b o0 : Nat} {S : Ty} {vals : List Word} {V : Ts} {us : List Acc} {ws : List Word}
    {s s' : St} (hc : η.sto a.label = some c)
    (hseg : SegOf c.ty b S) (hbo : a.offset = b + o0) (hv : ValOfS η S vals)
    (hw : ∀ (j : Nat) w, ws[j]? = some w → ∃ w0, vals[o0 + j]? = some w0 ∧ WLe1 w0 (bumpW V w))
    (hV : V ≤ s.vs.vRelSt) (hpl : PromLt s)
    (htail : ∀ j : Nat, j < nWords us → ∀ (t : Ts) (m : Msg), s.vs.coh (offs a (0 + j)) < t → s.mem[t]? = some m →
      m.loc = offs a (0 + j) → t ∈ s.promises ∨ WordOK η c.ty m.loc.offset (mw m))
    (hs : s' ∈ storeUnits k arch pw a rel us ws 0 s) :
    ∀ j, j < nWords us → HiddenP η c.ty s'.mem s'.promises a.label (a.offset + j) s'.vs.vWr := by
  intro j hj t0 m0 hn0 hm0 hl0 hnok
  have e : offs a (0 + j) = ⟨a.label, a.offset + j⟩ := by cases a; simp [offs]
  obtain ⟨t, m, hcase, htw, hm, hml⟩ := storeUnits_wrP us ws 0 s s' hs j hj
  rw [e] at hcase hml
  refine ⟨t, m, ?_, htw, hm, hml⟩
  obtain ⟨hg, -, -⟩ := storeUnits_growsF us ws 0 s s' hs
  by_cases hlt : t0 < s.mem.size
  · have hm0' : s.mem[t0]? = some m0 := by rw [← hg.2.1 t0 hlt]; exact hm0
    by_cases hp0 : t0 ∈ s.promises
    · exfalso
      obtain ⟨m', a1, -, a3⟩ := storeUnits_fulOK (c := c) hseg hbo hv hw hV hpl hs t0 hp0 hn0
      rw [hm0'] at a1; cases a1
      rw [hl0] at a3; exact hnok a3
    · have hle : t0 ≤ s.vs.coh ⟨a.label, a.offset + j⟩ := by
        refine Nat.le_of_not_lt fun h => ?_
        have ht := htail j hj
        rw [e] at ht
        rcases ht t0 m0 h hm0' hl0 with h' | h'
        · exact hp0 h'
        · rw [hl0] at h'; exact hnok h'
      rcases hcase with h | h
      · exact Nat.lt_of_lt_of_le hlt h
      · exact Nat.lt_of_le_of_lt hle h
  · exfalso
    obtain ⟨-, hok⟩ := storeUnits_newOKF hc hseg hbo hv us ws 0 s
      (fun j w h => by obtain ⟨w0, h1, h2⟩ := hw j w h; exact ⟨w0, by rw [Nat.add_zero]; exact h1, h2⟩) hV s' hs t0 m0
      (Nat.le_of_not_lt hlt) hm0
    rw [hl0] at hok; exact hnok hok

/-- (S4) **A store to an own cell keeps `MemInv`**, given the new memory and
owner invariants: the rest follows from `storeCoreP`. -/
theorem MemInv_ownStore {g : G} {E : TEnv} {s s' : St} {a : Address} {c : Cell} {us : List Acc}
    {ws : List Word} {pw : Word} {rel : Bool} {b o0 : Nat} {S : Ty} {q : List Word}
    (hm : MemInv g E s) (hsto : E.sto a.label = some c) (_hown : c.owner = some E.tid)
    (hseg : SegOf c.ty b S) (hbo : a.offset = b + o0) (hq : ValOfS E S q)
    (hinq : ∀ j w, ws[j]? = some w → q[o0 + j]? = some (bumpW s.vs.vRelSt w))
    (hs : s' ∈ storeUnits g.k g.arch pw a rel us ws 0 s)
    (hmo' : MemOKP E s'.mem s'.pairs s'.promises) (hoo' : OwnOKPF E s'.mem s'.pairs s'.vs s'.promises)
    (hpi' : PubInv E s') (hnp : ∀ j, j < nWords us → ¬ PrivU E (offs a j)) :
    MemInv g E s' := by
  obtain ⟨hmo, hoo, hpl, hfr, hsn, hoh, hpd, hopub, -, hbi, hpo⟩ := hm
  obtain ⟨hg, hna, hpl', hnew, hwr, hful, hfw⟩ := storeCoreP hsto hseg hbo hq
    (fun j w hw => ⟨bumpW s.vs.vRelSt w, hinq j w hw, WLe1_refl _⟩) (Nat.le_refl _) hpl hs
  exact ⟨hmo', hoo', hpl', FreshLP_store hfr hsto hg hna hful (fun _ _ => ⟨rfl, rfl, rfl⟩)
    (PrivCoh_storeUnits hfr.2 hs (fun _ h => h) hnp),

    by rw [storeUnits_relSt _ _ _ _ _ hs]; exact hsn, OwnHidP_grow hoh hwr hg.2.1 hnew hfw,
    PubDefP_grow hpd hg.2.1 hnew hfw, hopub.store hpl hs,
    hpi',
    BoxInv_store hbi hsto hpl hpo.1 s' hs, PromOK_store hpo hpl hs⟩

/-- (S4, F2) `OwnOK_storeAt` with promises skipped: storing a component's words
to an own cell (words `vals`, under `η`, becoming `vals'` under `η'`).  (F2) At a
cell with a frontier, a two-word unit the store touches is one of its units
(`hal`); the rest of the cell, and every other own cell, is untouched. -/
theorem OwnOKP_storeAt {k : Promises.Knobs} {arch : Arch} {pw : Word} {rel : Bool} {η η' : TEnv}
    {a : Address} {c : Cell} {b o0 : Nat} {S : Ty} {q : List Word} {us : List Acc} {ws : List Word}
    {vals vals' : List Word}
    (hc : η'.sto a.label = some c) (hseg : SegOf c.ty b S) (hbo : a.offset = b + o0) (hq : ValOfS η' S q)
    {V : Ts} (hinq : ∀ j w, ws[j]? = some w → q[o0 + j]? = some (bumpW V w))
    (hcell' : CellOK η' (η'.rc a.label) c.ty vals')
    (hin : ∀ j w, ws[j]? = some w → vals'[a.offset + j]? = some (bumpW V w)) {s : St}
    (hlat : ∀ o v, vals[o]? = some v →
      LatestSF η c (η.pfr a.label) s.mem (· ∈ s.promises) s.vs.coh ⟨a.label, o⟩ v)
    (hpf : η.pfr a.label ≠ none → OwnPairF η c a.label vals s.mem s.pairs (· ∈ s.promises) s.vs.coh)
    (hout : ∀ o, (o < a.offset ∨ a.offset + nWords us ≤ o) → vals'[o]? = vals[o]?)
    (hcov : a.offset + nWords us ≤ vals.length)
    (hal : η'.pfr a.label ≠ none → ∀ o, TwoAtT c.ty o → InitR η' c a.label o →
      (a.offset ≤ o ∧ o < a.offset + nWords us ∨ a.offset ≤ o + 1 ∧ o + 1 < a.offset + nWords us) →
      a.offset ≤ o ∧ TwoAt us (o - a.offset))
    (f : ∀ {U : Ty} {vs : List Word}, ValOf η U vs → ValOf η' U vs) (hpfr : η'.pfr a.label = η.pfr a.label)
    (hinit : ∀ o, InitRr η' c a.label o → (o < a.offset ∨ a.offset + nWords us ≤ o) →
      (o + 1 < a.offset ∨ a.offset + nWords us ≤ o + 1) → InitRr η c a.label o)
    (hlen : ws.length = nWords us) (hV : V ≤ s.vs.vRelSt) (hpl : PromLt s) (hnd : s.promises.Nodup)
    (hm : MemOKP η' s.mem s.pairs s.promises)
    (ho : ∀ l c, l ≠ a.label → η'.sto l = some c → c.owner = some η'.tid →
      OwnCellF η' s.mem s.pairs s.vs (· ∈ s.promises) l c) :
    ∀ s', s' ∈ storeUnits k arch pw a rel us ws 0 s →
      MemOKP η' s'.mem s'.pairs s'.promises ∧ OwnOKPF η' s'.mem s'.pairs s'.vs s'.promises := by
  intro s' hs
  have hm' := storeUnits_memOKP (a := a) hc hseg hbo hq us ws 0 s
    (fun j w hw => ⟨bumpW V w, by simpa using hinq j w hw, WLe1_refl _⟩) hV hm s' hs
  refine ⟨hm', fun l' c' hc' hown' => ?_⟩
  by_cases hl : l' = a.label
  · subst hl; rw [hc] at hc'; cases hc'
    exact OwnCellF_store (A := a.offset) rfl hlat hpf f hpfr hinit hcell' hin hout hcov hal hlen hV hpl hnd
      hm.2.2 hs
  · exact OwnCellF_storeOther (ho l' c' hl hc' hown') hl id rfl rfl hpl hm.2.2 hs

/-! ## §2 Steps that keep Σ and memory (4d-3) -/

/-- **Lifting a control step**: a step that keeps `E` and changes nothing
`MemInv` reads keeps `ThInvM`. -/
theorem lift {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {E : TEnv}
    (hm : MemInv g E (stOf mem pairs th))
    (h : tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvE p E r.2.2)
    (hs : ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2)) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g E (stOf mem pairs th) r.1 r.2.1 r.2.2 :=
  ⟨h.1, fun r hr => ⟨E, EFoot_refl, h.2 r hr, MemInv_same hm (hs r hr)⟩⟩

/-- (G1) `lift`, keeping `sto`. -/
theorem liftS {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {E : TEnv}
    (hm : MemInv g E (stOf mem pairs th))
    (h : tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvE p E r.2.2)
    (hs : ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2)) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMFS p g E (stOf mem pairs th) r.1 r.2.1 r.2.2 :=
  ⟨h.1, fun r hr => ⟨E, fun _ => rfl, EFoot_refl, h.2 r hr, MemInv_same hm (hs r hr)⟩⟩

/-! ### Which steps change nothing `MemInv` reads -/

/-- Every outcome of a step that only rebinds the frame (`same th'` in
`tstep`) agrees with the old state. -/
macro "same_tac " hr:ident : tactic => `(tactic| (
  repeat' split at $hr:ident
  all_goals first
    | (simp only [List.mem_singleton] at $hr:ident; subst $hr:ident; exact ⟨rfl, rfl, rfl, rfl, rfl⟩)
    | (simp at $hr:ident)))

section
variable {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}

theorem same_ifeq {a b : At} {yes no : Expr} (hterm : th.term = .ifeq a b yes no) :
    ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) := by
  intro r hr; simp only [tstep, hterm] at hr; same_tac hr

theorem same_parity {a : At} {k : String} {ev₀ od : Expr} (hterm : th.term = .parity a k ev₀ od) :
    ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) := by
  intro r hr; simp only [tstep, hterm] at hr; same_tac hr

theorem same_split {a : At} {x y : String} {e : Expr} (hterm : th.term = .split a x y e) :
    ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) := by
  intro r hr; simp only [tstep, hterm] at hr; same_tac hr

theorem same_unpack {a : At} {i x : String} {e : Expr} (hterm : th.term = .unpack a i x e) :
    ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) := by
  intro r hr; simp only [tstep, hterm] at hr; same_tac hr

theorem same_unpackT {a : At} {α x : String} {e : Expr} (hterm : th.term = .unpackT a α x e) :
    ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) := by
  intro r hr; simp only [tstep, hterm] at hr; same_tac hr

theorem same_ifnull {a : At} {y : String} {e₁ e₂ : Expr} (hterm : th.term = .ifnull a e₁ y e₂) :
    ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) := by
  intro r hr; simp only [tstep, hterm] at hr; same_tac hr

theorem same_ret {a : At} (hterm : th.term = .ret a) :
    ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) := by
  intro r hr; simp only [tstep, hterm] at hr; same_tac hr

/-- Entering a block keeps the thread's view, promises and allocation count. -/
theorem enter_same {th th' : TTh} {f : String} {ts : List Ty} {a : At} (h : enter g th f ts a = some th') :
    th'.vs = th.vs ∧ th'.promises = th.promises ∧ th'.nalloc = th.nalloc := by
  simp only [enter, bind, Option.bind] at h
  split at h
  · simp at h
  · cases hv : evalAt th.env a with
    | none => simp [hv] at h
    | some v => simp only [hv, pure, Option.some.injEq] at h; subst h; exact ⟨rfl, rfl, rfl⟩

theorem same_tail {f : String} {is : List String} {a : At} {ts : List Ty} (hterm : th.term = .tail f is a ts) :
    ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) := by
  intro r hr
  simp only [tstep, hterm] at hr
  cases he : enter g th f ts a with
  | none => simp [he, ol] at hr
  | some th' =>
      simp only [he, ol, Option.map_some, Option.toList_some, List.mem_singleton] at hr; subst hr
      obtain ⟨e1, e2, e3⟩ := enter_same he
      exact ⟨rfl, rfl, e1, e2, e3⟩

theorem same_call {x f : String} {is : List String} {a : At} {ts : List Ty} {e : Expr}
    (hterm : th.term = .let_ x (.call f is a ts) e) :
    ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) := by
  intro r hr
  simp only [tstep, hterm] at hr
  cases hc : callFrame g th f ts x e with
  | none => simp [hc, ol] at hr
  | some fr =>
      simp [hc, ol] at hr
      obtain ⟨th', he, rfl⟩ := hr
      obtain ⟨e1, e2, e3⟩ := enter_same he
      exact ⟨rfl, rfl, e1, e2, e3⟩

theorem same_callc {x : String} {fa a : At} {e : Expr} (hterm : th.term = .let_ x (.callc fa a) e) :
    ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) := by
  intro r hr
  simp only [tstep, hterm] at hr
  repeat' split at hr
  all_goals try (simp at hr; done)
  all_goals
    simp [ol] at hr
    obtain ⟨fr, -, hr⟩ := Option.bind_eq_some_iff.1 hr
    simp only [Function.comp, Option.map_eq_some_iff] at hr
    obtain ⟨th', he, rfl⟩ := hr
    obtain ⟨e1, e2, e3⟩ := enter_same he
    exact ⟨rfl, rfl, e1, e2, e3⟩

/-- A `let` whose operation's every outcome keeps the state. -/
theorem same_let {x : String} {op : Op} {e : Expr} (hterm : th.term = .let_ x op e)
    (hc : ∀ f is a ts, op ≠ .call f is a ts) (hcc : ∀ f a, op ≠ .callc f a)
    (hop : ∀ r ∈ evalOp g th.env th.σs (stOf mem pairs th) op, Same (stOf mem pairs th) r.1) :
    ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) := by
  intro r hr
  have key : tstep g mem pairs th = (evalOp g th.env th.σs (stOf mem pairs th) op).map
      fun (s', t, ws) => (s'.mem, s'.pairs, withS { th with term := e, env := (x, t, ws) :: th.env } s') := by
    cases op with
    | call f is a ts => exact absurd rfl (hc f is a ts)
    | callc f a => exact absurd rfl (hcc f a)
    | _ => simp [tstep, hterm]
  rw [key, List.mem_map] at hr
  obtain ⟨⟨s', t, ws⟩, hm, rfl⟩ := hr
  exact hop _ hm

/-- **Pure operations keep the state.** -/
theorem pure_state {env : Env} {σs : List Ty} {s : St} {op : Op} (hA : PureOp op) :
    ∀ r ∈ evalOp g env σs s op, r.1 = s := by
  intro r hr
  cases op <;> simp only [PureOp] at hA <;>
    simp only [evalOp, ol, bind, pure] at hr <;>
    (repeat' split at hr) <;>
    (try simp only [Option.mem_toList] at hr) <;>
    (try (simp only [Option.bind_eq_some_iff] at hr)) <;>
    (try simp only [Option.map_eq_some_iff] at hr) <;>
    (repeat (obtain ⟨_, _, hr⟩ := hr)) <;>
    (repeat' split at hr) <;>
    first
      | rfl
      | (subst hr; rfl)
      | (simp only [Option.some.injEq] at hr; subst hr; rfl)
      | (cases hr)
      | (simp at hr)

theorem same_of_eq {s s' : St} (h : s' = s) : Same s s' := by subst h; exact ⟨rfl, rfl, rfl, rfl, rfl⟩

theorem same_pure {x : String} {op : Op} {e : Expr} (hterm : th.term = .let_ x op e) (hA : PureOp op) :
    ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) :=
  same_let hterm (fun f is a ts h => by subst h; exact hA) (fun f a h => by subst h; exact hA)
    (fun r hr => same_of_eq (pure_state hA r hr))

theorem same_fnptr {x f : String} {e : Expr} (hterm : th.term = .let_ x (.fnptr f) e) :
    ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) :=
  same_let hterm (fun _ _ _ _ h => by cases h) (fun _ _ h => by cases h) (fun r hr => by
    simp only [evalOp] at hr
    split at hr
    · simp only [List.mem_singleton] at hr; subst hr; exact ⟨rfl, rfl, rfl, rfl, rfl⟩
    · simp at hr)

theorem same_inl {x : String} {τ : Ty} {a : At} {e : Expr} (hterm : th.term = .let_ x (.inl τ a) e)
    (hnb : ∀ t ws, evalAt th.env a = some (t, ws) → (Ty.sum t (close th.σs τ)).tier ≠ .boxed) :
    ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) :=
  same_let hterm (fun _ _ _ _ h => by cases h) (fun _ _ h => by cases h) (fun r hm => by
    simp only [evalOp] at hm
    split at hm
    · rename_i t ws hea
      have hS := hnb t ws hea
      simp only [projM_nb (tier_sum hS).1, injM_nb hS, List.mem_flatMap, ol, List.mem_map,
        Option.mem_toList, Option.map_eq_some_iff] at hm
      obtain ⟨_, ⟨_, _, rfl⟩, _, ⟨_, _, rfl⟩, rfl⟩ := hm
      exact ⟨rfl, rfl, rfl, rfl, rfl⟩
    · simp at hm)

theorem same_inr {x : String} {τ : Ty} {a : At} {e : Expr} (hterm : th.term = .let_ x (.inr τ a) e)
    (hnb : ∀ t ws, evalAt th.env a = some (t, ws) → (Ty.sum (close th.σs τ) t).tier ≠ .boxed) :
    ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) :=
  same_let hterm (fun _ _ _ _ h => by cases h) (fun _ _ h => by cases h) (fun r hm => by
    simp only [evalOp] at hm
    split at hm
    · rename_i t ws hea
      have hS := hnb t ws hea
      simp only [projM_nb (tier_sum hS).2, injM_nb hS, List.mem_flatMap, ol, List.mem_map,
        Option.mem_toList, Option.map_eq_some_iff] at hm
      obtain ⟨_, ⟨_, _, rfl⟩, _, ⟨_, _, rfl⟩, rfl⟩ := hm
      exact ⟨rfl, rfl, rfl, rfl, rfl⟩
    · simp at hm)

end

/-! ### The control steps, against memory -/

section
variable {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {cx : Cx} {ρ : Nat → Nat} {η : TEnv}

theorem tstepM_pure {x : String} {op : Op} {e : Expr}
    (hterm : th.term = .let_ x op e) (hA : PureOp op) (hP : ProgT p)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 :=
  lift hm (tstep_pure hterm hA hP hT hi hE htv hRP hPS) (same_pure hterm hA)

theorem tstepM_ifeq {a b : At} {yes no : Expr}
    (hterm : th.term = .ifeq a b yes no) (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 :=
  lift hm (tstep_ifeq hterm hT hi hE htv hRP hPS) (same_ifeq hterm)

theorem tstepM_parity {a : At} {k : String} {ev₀ od : Expr}
    (hterm : th.term = .parity a k ev₀ od) (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 :=
  lift hm (tstep_parity hterm hT hi hE htv hRP hPS) (same_parity hterm)

theorem tstepM_split {a : At} {x y : String} {e : Expr}
    (hterm : th.term = .split a x y e) (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 :=
  lift hm (tstep_split hterm hT hi hE htv hRP hPS) (same_split hterm)

theorem tstepM_unpack {a : At} {i x : String} {e : Expr}
    (hterm : th.term = .unpack a i x e) (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 :=
  lift hm (tstep_unpack hterm hT hi hE htv hRP hPS) (same_unpack hterm)

theorem tstepM_unpackT {a : At} {α x : String} {e : Expr}
    (hterm : th.term = .unpackT a α x e) (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 :=
  lift hm (tstep_unpackT hterm hT hi hE htv hRP hPS) (same_unpackT hterm)

theorem tstepM_ifnull {a : At} {y : String} {e₁ e₂ : Expr}
    (hterm : th.term = .ifnull a e₁ y e₂) (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 :=
  lift hm (tstep_ifnull hterm hT hi hE htv hRP hPS) (same_ifnull hterm)

theorem tstepM_inlS {x : String} {τ : Ty} {a : At} {e : Expr}
    (hterm : th.term = .let_ x (.inl τ a) e) (hP : ProgT p)
    (hnb : ∀ t c₁, cx.use a = .ok (t, c₁) → (close th.σs (.sum t τ)).tier ≠ .boxed)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMFS p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  refine liftS hm (tstep_inl hterm hP hnb hT hi hE htv hRP hPS) (same_inl hterm fun t ws hea => ?_)
  rw [hterm] at hT
  cases hT with
  | let_ hop _ =>
      cases hop with
      | inl _ hu _ =>
          obtain ⟨-, rt, ws', hea', -, hl⟩ := use_FInv hu hi
          rw [hea, Option.some.injEq, Prod.mk.injEq] at hea'
          obtain ⟨rfl, rfl⟩ := hea'
          rw [tier_of_eskel (u := close th.σs (.sum _ τ)) (by show Ty.sum (etok (skel t)) _ = _; rw [hl.2.1]; rfl)]
          exact hnb _ _ hu

/-- (G1) `tstepM_inl` from `tstepM_inlS`. -/
theorem tstepM_inl {x : String} {τ : Ty} {a : At} {e : Expr}
    (hterm : th.term = .let_ x (.inl τ a) e) (hP : ProgT p)
    (hnb : ∀ t c₁, cx.use a = .ok (t, c₁) → (close th.σs (.sum t τ)).tier ≠ .boxed)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 :=
  (tstepM_inlS (hterm := hterm) (hP := hP) (hnb := hnb) (hT := hT) (hi := hi) (hE := hE) (htv := htv) (hm := hm) (hRP := hRP) (hPS := hPS)).imp id
    fun h r hr => (h r hr).toF

theorem tstepM_inrS {x : String} {τ : Ty} {a : At} {e : Expr}
    (hterm : th.term = .let_ x (.inr τ a) e) (hP : ProgT p)
    (hnb : ∀ t c₁, cx.use a = .ok (t, c₁) → (close th.σs (.sum τ t)).tier ≠ .boxed)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMFS p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  refine liftS hm (tstep_inr hterm hP hnb hT hi hE htv hRP hPS) (same_inr hterm fun t ws hea => ?_)
  rw [hterm] at hT
  cases hT with
  | let_ hop _ =>
      cases hop with
      | inr _ hu _ =>
          obtain ⟨-, rt, ws', hea', -, hl⟩ := use_FInv hu hi
          rw [hea, Option.some.injEq, Prod.mk.injEq] at hea'
          obtain ⟨rfl, rfl⟩ := hea'
          rw [tier_of_eskel (u := close th.σs (.sum τ _)) (by show Ty.sum _ (etok (skel t)) = _; rw [hl.2.1]; rfl)]
          exact hnb _ _ hu

/-- (G1) `tstepM_inr` from `tstepM_inrS`. -/
theorem tstepM_inr {x : String} {τ : Ty} {a : At} {e : Expr}
    (hterm : th.term = .let_ x (.inr τ a) e) (hP : ProgT p)
    (hnb : ∀ t c₁, cx.use a = .ok (t, c₁) → (close th.σs (.sum τ t)).tier ≠ .boxed)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 :=
  (tstepM_inrS (hterm := hterm) (hP := hP) (hnb := hnb) (hT := hT) (hi := hi) (hE := hE) (htv := htv) (hm := hm) (hRP := hRP) (hPS := hPS)).imp id
    fun h r hr => (h r hr).toF

theorem tstepM_caseS {a : At} {x y : String} {e₁ e₂ : Expr}
    (hterm : th.term = .case a x e₁ y e₂)
    (hnb : ∀ t c₁, cx.use a = .ok (t, c₁) → (close th.σs t).tier ≠ .boxed)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMFS p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  refine liftS hm (tstep_case hterm hnb hT hi hE htv hRP hPS) ?_
  rw [hterm] at hT
  obtain ⟨ra, rb, ws, j, p', hea, hS, has, -, -⟩ := case_step hT hi hnb htv
  obtain ⟨hta, htb⟩ := tier_sum hS
  intro r hr
  by_cases hj : j < (armsOf ra).length
  · simp only [tstep, hterm, hea, projM_nb hS, has, ol, Option.map_some, Option.toList_some,
      List.flatMap_cons, List.flatMap_nil, hj, ite_true, injM_nb hta, List.append_nil, List.mem_map,
      Option.mem_toList, Option.map_eq_some_iff] at hr
    obtain ⟨_, ⟨_, _, rfl⟩, rfl⟩ := hr
    exact ⟨rfl, rfl, rfl, rfl, rfl⟩
  · simp only [tstep, hterm, hea, projM_nb hS, has, ol, Option.map_some, Option.toList_some,
      List.flatMap_cons, List.flatMap_nil, hj, ite_false, injM_nb htb, List.append_nil, List.mem_map,
      Option.mem_toList, Option.map_eq_some_iff] at hr
    obtain ⟨_, ⟨_, _, rfl⟩, rfl⟩ := hr
    exact ⟨rfl, rfl, rfl, rfl, rfl⟩

/-- (G1) `tstepM_case` from `tstepM_caseS`. -/
theorem tstepM_case {a : At} {x y : String} {e₁ e₂ : Expr}
    (hterm : th.term = .case a x e₁ y e₂)
    (hnb : ∀ t c₁, cx.use a = .ok (t, c₁) → (close th.σs t).tier ≠ .boxed)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 :=
  (tstepM_caseS (hterm := hterm) (hnb := hnb) (hT := hT) (hi := hi) (hE := hE) (htv := htv) (hm := hm) (hRP := hRP) (hPS := hPS)).imp id
    fun h r hr => (h r hr).toF

theorem tstepM_ret {a : At}
    (hterm : th.term = .ret a) (hst : th.stack ≠ []) (hT : Typed p cx th.term)
    (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 :=
  lift hm (tstep_ret hterm hst hT hi hE htv) (same_ret hterm)

