/-- (G1) `tstepM_caseB` from `tstepM_caseBS`. -/
theorem tstepM_caseB {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {ρ : Nat → Nat} {η : TEnv} {a : At} {x y : String} {e₁ e₂ : Expr} {u v : Ty} {c₁ c₂ c₃ : Cx}
    {ra rb : Ty} {ws : List Word} (hterm : th.term = .case a x e₁ y e₂) (hn : 0 < g.n)
    (hb1 : c₁.bind x u = .ok c₂) (he1 : Typed p c₂ e₁) (htv1 : TvOK c₂)
    (hb2 : c₁.bind y v = .ok c₃) (he2 : Typed p c₃ e₂) (htv2 : TvOK c₃)
    (hi1 : FInv ρ η th.σs (Resume p th.stack) c₁ th.env)
    (hea : evalAt th.env a = some (.sum ra rb, ws)) (hv : VR ρ η (.sum u v) (shp (.sum ra rb)) ws)
    (hl : Lay th.σs (.sum u v) (.sum ra rb) ws) (hS : (Ty.sum ra rb).tier = .boxed)
    (hsg : sig (.sum ra rb) = sig (cl ρ η.wit 0 0 (.sum u v)))
    (hE : EnvOK p η) (hm : MemInv g (CE η) (stOf mem pairs th)) (hbf : g.boxFence = true)
    (hpx : PAx g mem pairs th) (hRP1 : RetPw th.σs th.stack c₁.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 :=
  (tstepM_caseBS (hRP1 := hRP1) (hterm := hterm) (hn := hn) (hb1 := hb1) (he1 := he1) (htv1 := htv1) (hb2 := hb2) (he2 := he2) (htv2 := htv2) (hi1 := hi1) (hea := hea) (hv := hv) (hl := hl) (hS := hS) (hsg := hsg) (hE := hE) (hm := hm) (hbf := hbf) (hpx := hpx)).imp id
    fun h r hr hp => (h r hr hp).toF

/-- (T3c-5d, β1) **`case`, every tier** (no `hnb`; T3c-5f: no side condition). -/
theorem tstepM_caseTS {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {cx : Cx}
    {ρ : Nat → Nat} {η : TEnv} {a : At} {x y : String} {e₁ e₂ : Expr}
    (hterm : th.term = .case a x e₁ y e₂) (hn : 0 < g.n)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hbf : g.boxFence = true)
    (hpx : PAx g mem pairs th) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvMFS p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  have hT0 := hT
  rw [hterm] at hT0
  cases hT0 with
  | case hu hb1 he1 hb2 he2 =>
    obtain ⟨u, v, c₁, c₂, c₃, hu, hb1, he1, hb2, he2⟩ : ∃ u v c₁ c₂ c₃,
        cx.use a = .ok (.sum u v, c₁) ∧ c₁.bind x u = .ok c₂ ∧ Typed p c₂ e₁ ∧
        c₁.bind y v = .ok c₃ ∧ Typed p c₃ e₂ := ⟨_, _, _, _, _, hu, hb1, he1, hb2, he2⟩
    obtain ⟨hi1, rt, ws, hea, hv, hl⟩ := use_FInv hu hi
    have hs := hl.2.1
    simp only [close, substTs, skel, etok] at hs
    obtain ⟨ra, rb, rfl, -, -⟩ := eskel_eq_sum hs
    by_cases hS : (Ty.sum ra rb).tier = .boxed
    · have htv12 := case_TvOK hu hb1 hb2 htv
      have ho : cx.opaqueOK _ = true :=
        peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
      have htb := (use_TvOK hu htv).2.1
      have hsg := lay_closed (ρ := ρ) hi.2.2.2.1 hi.2.2.2.2.1 ho htb hl
      exact tstepM_caseBS (hbf := hbf) (hRP1 := retPw_eq hRP (use_ret hu)) hterm hn hb1 he1 htv12.1 hb2 he2 htv12.2 hi1 hea hv hl hS hsg hE hm hpx
    · refine paW <| tstepM_caseS hterm (fun t' c₁' hu' => ?_) hT hi hE htv hm hRP hPS
      rw [hu, Except.ok.injEq, Prod.mk.injEq] at hu'; obtain ⟨rfl, rfl⟩ := hu'
      rw [← tier_of_eskel hl.2.1]; exact hS

/-- (G1) `tstepM_caseT` from `tstepM_caseTS`. -/
theorem tstepM_caseT {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {cx : Cx}
    {ρ : Nat → Nat} {η : TEnv} {a : At} {x y : String} {e₁ e₂ : Expr}
    (hterm : th.term = .case a x e₁ y e₂) (hn : 0 < g.n)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hbf : g.boxFence = true)
    (hpx : PAx g mem pairs th) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 :=
  (tstepM_caseTS (hRP := hRP) (hPS := hPS) (hterm := hterm) (hn := hn) (hT := hT) (hi := hi) (hE := hE) (htv := htv) (hm := hm) (hbf := hbf) (hpx := hpx)).imp id
    fun h r hr hp => (h r hr hp).toF

/-- (F2′ step 2 part 3) `PubWin` of an own cell from `MemInv` and `NoHold`:
an unseen frontier is `seen`, below `vWr`, or held (`OwnPubV`); `NoHold`
excludes the holder. -/
theorem PubWin_of_NoHold {g : G} {E : TEnv} {s : St} {l : AllocLabel} {c : Cell} (hm : MemInv g E s)
    (hsto : E.sto l = some c) (hown : c.owner = some E.tid) (h : NoHold E s l) : PubWin E s l := by
  refine ⟨fun f hf hns => ?_, h.2.1⟩
  rcases hm.2.2.2.2.2.2.2.1 l c f hsto hown hf with h1 | h1 | h1
  · exact absurd h1 hns
  · exact h1
  · exact absurd h1 (h.1 f hf hns)

/-- (S7b′) `publish`'s run-level premise (`NoHold`, F2′ step 2 part 3) at the
cell a `publish` term's handle names. -/
def PubWinT (E : TEnv) (s : St) (th : TTh) : Prop :=
  ∀ x a e rt ws ad, th.term = .let_ x (.publish a) e → evalAt th.env a = some (rt, ws) →
    ws.map (·.val) = [.loc ad 0] → NoHold E s ad.label

/-- **`publish` keeps `MemInv`**, at the view where own cell `l` is published at
the thread's `vWr` and seen. -/
theorem MemInv_publish {g : G} {E E' : TEnv} {s : St} {l : AllocLabel} {c : Cell}
    (hm : MemInv g E s) (hsto : E.sto l = some c) (hown : c.owner = some E.tid)
    (hp : E.prog = E'.prog) (ht : E.tid = E'.tid) (hs : E'.sto = E.sto) (hi : E'.ini = E.ini)
    (hP : E'.pfr = pubP E l s.vs.vWr) (hS : E'.seen = pubS E l) (hR : E'.rini = E.rini)
    (hcpl : ∀ b S, SegOf c.ty b S → accs S ≠ none → TearOK S) (hcT : Ty.coupledOKIn [] c.ty = true)
    (hnT : Ty.noOwnIn [] c.ty = true) (hrT : rgnFree c.ty = true) (hF : PubWin E s l)
    (hbx : ∀ l B, E.box l = some B → E'.box l = some B := by first | exact fun _ _ h => h | simp_all | (intro _ _ h; simpa [CE, TEnv.withSto] using h))
    (hbe : E'.box = E.box := by first | rfl | simp_all)
    (hri : ∀ l, E.rini l ≤ E'.rini l := by rini_le) :
    MemInv g E' (fenceS s .st) := by
  obtain ⟨hmo, hoo, hpl, hfr, hsn, hoh, hpd, hopub, hpi, hbi, hpo⟩ := id hm
  have hsub : ∀ l c, E.sto l = some c → E'.sto l = some c := fun l c h => by rw [hs]; exact h
  have hile : ∀ l, E.ini l ≤ E'.ini l := fun l => by rw [hi]; exact Nat.le_refl _
  have hPm : ∀ l' f, E.pfr l' = some f → E'.pfr l' = some f := fun l' f h => by
    rw [hP]; exact pubP_mono E l s.vs.vWr l' f h
  have hSm : ∀ l', E.seen l' → E'.seen l' := fun l' h => by rw [hS]; exact Or.inr h
  have hmono : ∀ {U : Ty} {vs : List Word}, ValOf E U vs → ValOf E' U vs :=
    fun h => ValOf_mono hp ht hsub hile h hPm hSm hbx
  have hwE : ∀ T o w, WordOK E T o w → WordOK E' T o w := fun T o w h =>
    WordOK_mono hp ht hsub hile hPm hSm h hbx
  have hiniR : ∀ c' l' o, InitR E' c' l' o → InitR E c' l' o := fun c' l' o h N e us h1 h2 => by
    have := h N e us h1 h2; rw [hi] at this; exact this
  have hrcE : ∀ l', E'.rc l' = E.rc l' := fun l' => TEnv.rc_congr (by rw [hi]) (by rw [hR])
  have hnew0 : ∀ (l' : AllocLabel) (o : Nat) (t : Nat) (m : Msg), s.mem.size ≤ t → (fenceS s .st).mem[t]? = some m →
      m.loc = ⟨l', o⟩ → ∀ T, WordOK E' T o (mw m) := fun _ _ t m ht hm _ _ =>
    (Nat.not_le.2 (lt_of_get (show s.mem[t]? = some m from hm)) ht).elim
  refine ⟨MemOKP_mono hmo hp ht hsub hile (fun t m c h hc => by rw [hs] at hc; exact hc) hPm hSm hbx,
    ?_, hpl, ?_, ?_, ?_, ?_, ?_, ?_, BoxInv_tr hbi hbe
      (fun l' B hl h => by
        rw [hS] at h
        rcases h with h | h
        · have h0 := (hbi.2.2 l' B hl).1; rw [h, hsto] at h0; cases h0
        · exact h)
      (fun l _ _ => by rw [hs]) (fun l _ _ => by rw [hi])
      (Nat.le_refl _) (fun _ _ _ _ _ _ h => h) (fun _ _ _ _ _ _ h => h), hpo⟩
  · -- OwnOK
    intro l' c' hc ho
    rw [hs] at hc
    refine OwnCellF_pub (hoo l' c' hc (by rw [ht]; exact ho)) hmono (by rw [hi]) ?_ hmo.2.2 (by rw [hR])
    rw [hP]
    rcases hpf0 : E.pfr l' with _ | f0
    · exact Or.inl rfl
    · exact Or.inr (pubP_mono _ _ _ l' f0 hpf0)
  · -- FreshL
    refine ⟨fun j hj => ?_, PrivCoh_env (s := s) hfr.2 hs ht hPm fun l' => Nat.le_of_eq (hrcE l').symm⟩

    obtain ⟨f1, f2, f4, f5⟩ := hfr.1 j hj
    have hne : freshLabel g.lbase g.n g.i j ≠ l := fun he => by rw [he, hsto] at f1; cases f1
    exact ⟨by rw [hs]; exact f1, f2, by rw [hi]; exact f4, by rw [hP, pubP_ne hne]; exact f5⟩
  · -- SeenLE, at the raised `vRelSt`
    intro l' hl'
    rw [hS] at hl'
    show ∃ f, E'.pfr l' = some f ∧ f ≤ max s.vs.vRelSt s.vs.vWr
    rw [hP]
    rcases hl' with he | hl'
    · simp only [pubP, if_pos he]
      cases hpf : E.pfr l with
      | none => exact ⟨s.vs.vWr, rfl, Nat.le_max_right _ _⟩
      | some f0 =>
        by_cases hsl : E.seen l
        · obtain ⟨f, h1, h2⟩ := hsn l hsl
          rw [hpf] at h1
          have e : f0 = f := Option.some.inj h1
          subst e
          exact ⟨_, rfl, Nat.le_trans h2 (Nat.le_max_left _ _)⟩
        · exact ⟨f0, rfl, Nat.le_trans (hF.1 f0 hpf hsl) (Nat.le_max_right _ _)⟩
    · obtain ⟨f, h1, h2⟩ := hsn l' hl'
      exact ⟨f, pubP_mono E l s.vs.vWr l' f h1, Nat.le_trans h2 (Nat.le_max_left _ _)⟩
  · -- OwnHid: memory and `vWr` are unchanged; the published cell is not planted (P3)
    refine ⟨fun l' c' hc ho o hio => ?_, fun l' c' hc ho hlt => ?_⟩
    · rw [hs] at hc
      exact HiddenP_grow (hoh.1 l' c' hc (by rw [ht]; exact ho) o (fun N e us h1 h2 => by
          have := hio N e us h1 h2; rw [hrcE] at this; exact this)) (hwE _ _)
        (Nat.le_refl _) (fun _ _ => rfl) (fun t m ht' hm hl => hnew0 l' o t m ht' hm hl _)
        (fun _ _ h1 h2 => absurd h1 h2)
    · rw [hs] at hc
      rw [hrcE, hi] at hlt
      by_cases he : l' = l
      · rw [he] at hlt hc ⊢
        rcases hF.2 with hz | hle
        · exact ⟨(E.pfr l).getD s.vs.vWr, by rw [hP]; simp [pubP],
            fun hz' => absurd ((ZW.stoAt (congrFun hs l)).2 hz) hz',
            fun o hio => absurd hz (ZW.not_of_initR hc (hiniR c' l o hio))⟩
        · exact absurd hlt (by have := hle; unfold TEnv.rc; omega)
      · obtain ⟨f, hf, hns, hH⟩ := hoh.2 l' c' hc (by rw [ht]; exact ho) hlt
        refine ⟨f, by rw [hP, pubP_ne he]; exact hf,
          by rw [hS]; exact fun hz h => h.elim he (hns (fun hz0 => hz ((ZW.stoAt (congrFun hs l')).2 hz0))),
          fun o hio => ?_⟩
        exact HiddenP_grow (hH o (hiniR c' l' o hio)) (hwE _ _)
          (Nat.le_refl _) (fun _ _ => rfl) (fun t m ht' hm hl => hnew0 l' o t m ht' hm hl _)
          (fun _ _ h1 h2 => absurd h1 h2)
  · -- PubDef: the published cell is the thread's own
    intro l' c' f hc hown' hf o hio
    rw [hs] at hc
    by_cases he : l' = l
    · rw [he, hsto] at hc
      cases hc
      exact (hown' (by rw [← ht]; exact hown)).elim
    · rw [hP, pubP_ne he] at hf
      exact HiddenP_grow (hpd l' c' f hc (by rw [ht]; exact hown') hf o (hiniR c' l' o hio)) (hwE _ _)
        (Nat.le_refl _) (fun _ _ => rfl) (fun t m ht' hm hl => hnew0 l' o t m ht' hm hl _)
        (fun _ _ h1 h2 => absurd h1 h2)
  · -- OwnPub
    intro l' c' f hc ho hf
    rw [hS]
    by_cases he : l' = l
    · exact Or.inl (Or.inl he)
    · rw [hP, pubP_ne he] at hf
      rw [hs] at hc
      rcases hopub l' c' f hc (by rw [ht]; exact ho) hf with h | h | h
      · exact Or.inl (Or.inr h)
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr (h.congrE fun _ _ h => IniWr.ofEq hs hi hR h))
  · -- PubInv: `l` is the thread's own, and its type is coupled
    obtain ⟨hS0, hI0, hC0, hPP0, hLV0⟩ := hpi
    refine ⟨fun l' hl' => ?_, fun l' c' b S us hc hseg hu hini => ?_, fun l' c' f hc hf => ?_, ?_, ?_⟩
    · rw [hS] at hl'
      rcases hl' with he | hl'
      · rw [he]; exact .inl ⟨c, by rw [hs]; exact hsto, by rw [← ht]; exact hown⟩
      · rcases hS0 l' hl' with ⟨c', h1, h2⟩ | ⟨h1, h2⟩
        · exact .inl ⟨c', by rw [hs]; exact h1, by rw [← ht]; exact h2⟩
        · exact .inr ⟨by rw [hs]; exact h1, by rw [hbe]; exact h2⟩
    · rw [hs] at hc
      obtain ⟨ws, h1, h2⟩ := hI0 l' c' b S us hc hseg hu (fun N e h1 => by
        have := hini N e h1; rw [hi] at this; exact this)
      exact ⟨ws, hmono h1, h2⟩
    · rw [hs] at hc
      by_cases he : l' = l
      · rw [he, hsto] at hc
        rw [← Option.some.inj hc]
        obtain ⟨vals, hcell, -⟩ := hoo l c hsto hown
        exact ⟨LayT_of_CellOK hcell, hcpl, hcT, hnT, hrT⟩
      · rw [hP, pubP_ne he] at hf; exact hC0 l' c' f hc hf
    · intro l' c' f o hc hown' hf htw t0 t1 m0 m1 hn0 hn1 hm0 hm1 hl0 hl1 hh0 hh1 hst
      rw [hs] at hc
      have he : l' ≠ l := fun he => by
        rw [he, hsto] at hc
        rw [← Option.some.inj hc] at hown'
        rcases hown' with ⟨h, -⟩ | ⟨h, b2, S2, us2, o2, hseg2, hL2, htw2, -, -, hiS2⟩
        · exact h (by rw [← ht]; exact hown)
        · rw [he, hrcE, hi] at h
          rw [he, hi] at hiS2
          rcases hF.2 with hz | hle
          · exact ZW.not_of_initR hsto
              (InitR_of_IniSeg (o := o2) hiS2 hseg2 hL2 (by have := TwoAt_lt htw2; omega)) hz
          · exact absurd h (by have := hle; unfold TEnv.rc; omega)
      rw [hP, pubP_ne he] at hf
      exact PairOK_mono hp ht hsub hile hPm hSm
        (hPP0 l' c' f o hc (PubG_tr ht (Nat.le_of_eq (hrcE l').symm) (fun h => ⟨by rw [hrcE, hi] at h; exact h, Nat.le_of_eq (by rw [hi])⟩)
          (fun _ => Nat.le_of_eq (by rw [hi])) hown') hf htw t0 t1 m0 m1 hn0 hn1 hm0 hm1 hl0 hl1 hh0 hh1 hst) hbx
    · intro l' c' f b S us o hc hown' hf hseg hu ho
      rw [hs] at hc
      have he : l' ≠ l := fun he => by
        rw [he, hsto] at hc
        rw [← Option.some.inj hc] at hown'
        exact hown' (by rw [← ht]; exact hown)
      rw [hP, pubP_ne he] at hf
      exact hLV0 l' c' f b S us o hc (by rw [ht]; exact hown') hf hseg hu ho

/-- (S7b) **A planted frontier keeps `MemInv`**: one of the thread's own cells
without a frontier gains the thread's `vWr` as its frontier, unseen
(`OwnPubV`).  The cell's type facts are what `publish` would record
(`PubCpl`); the reader-side clauses are owner-guarded. -/
theorem MemInv_plantF {g : G} {E E' : TEnv} {s : St} {l : AllocLabel} {c : Cell} {F : Ts}
    (hm : MemInv g E s) (hsto : E.sto l = some c) (hown : c.owner = some E.tid) (hnone : E.pfr l = none)
    (hp : E.prog = E'.prog) (ht : E.tid = E'.tid) (hs : E'.sto = E.sto) (hi : E'.ini = E.ini)
    (hP : E'.pfr = fun l' => if l' = l then some F else E.pfr l') (hS : E'.seen = E.seen) (hR : E'.rini = E.rini)
    (hF : F ≤ s.vs.vWr ∨ HoldW E s l F)
    (hcpl : ∀ b S, SegOf c.ty b S → accs S ≠ none → TearOK S) (hcT : Ty.coupledOKIn [] c.ty = true)
    (hnT : Ty.noOwnIn [] c.ty = true) (hrT : rgnFree c.ty = true)
    (hbx : ∀ l B, E.box l = some B → E'.box l = some B := by first | exact fun _ _ h => h | simp_all | (intro _ _ h; simpa [CE, TEnv.withSto] using h))
    (hbe : E'.box = E.box := by first | rfl | simp_all)
    (hri : ∀ l, E.rini l ≤ E'.rini l := by rini_le) :
    MemInv g E' s := by
  obtain ⟨hmo, hoo, hpl, hfr, hsn, hoh, hpd, hopub, hpi, hbi, hpo⟩ := id hm
  have hsub : ∀ l c, E.sto l = some c → E'.sto l = some c := fun l c h => by rw [hs]; exact h
  have hile : ∀ l, E.ini l ≤ E'.ini l := fun l => by rw [hi]; exact Nat.le_refl _
  have hPne : ∀ l', l' ≠ l → E'.pfr l' = E.pfr l' := fun l' he => by rw [hP]; simp only [he, ↓reduceIte]
  have hPm : ∀ l' f, E.pfr l' = some f → E'.pfr l' = some f := fun l' f h => by
    by_cases he : l' = l
    · rw [he, hnone] at h; cases h
    · rw [hPne l' he]; exact h
  have hSm : ∀ l', E.seen l' → E'.seen l' := fun l' h => by rw [hS]; exact h
  have hmono : ∀ {U : Ty} {vs : List Word}, ValOf E U vs → ValOf E' U vs :=
    fun h => ValOf_mono hp ht hsub hile h hPm hSm hbx
  have hwE : ∀ T o w, WordOK E T o w → WordOK E' T o w := fun T o w h =>
    WordOK_mono hp ht hsub hile hPm hSm h hbx
  have hiniR : ∀ c' l' o, InitR E' c' l' o → InitR E c' l' o := fun c' l' o h N e us h1 h2 => by
    have := h N e us h1 h2; rw [hi] at this; exact this
  have hrcE : ∀ l', E'.rc l' = E.rc l' := fun l' => TEnv.rc_congr (by rw [hi]) (by rw [hR])
  have hnew0 : ∀ (l' : AllocLabel) (o : Nat) (t : Nat) (m : Msg), s.mem.size ≤ t → s.mem[t]? = some m →
      m.loc = ⟨l', o⟩ → ∀ T, WordOK E' T o (mw m) := fun _ _ t m ht hm _ _ =>
    (Nat.not_le.2 (lt_of_get hm) ht).elim
  refine ⟨MemOKP_mono hmo hp ht hsub hile (fun t m c h hc => by rw [hs] at hc; exact hc) hPm hSm hbx,
    ?_, hpl, ?_, ?_, ?_, ?_, ?_, ?_, BoxInv_tr hbi hbe (fun _ _ _ h => by rw [hS] at h; exact h)
      (fun l _ _ => by rw [hs]) (fun l _ _ => by rw [hi])
      (Nat.le_refl _) (fun _ _ _ _ _ _ h => h) (fun _ _ _ _ _ _ h => h), hpo⟩
  · -- OwnOK
    intro l' c' hc ho
    rw [hs] at hc
    refine OwnCellF_pub (hoo l' c' hc (by rw [ht]; exact ho)) hmono (by rw [hi]) ?_ hmo.2.2 (by rw [hR])
    by_cases he : l' = l
    · subst he; exact Or.inl hnone
    · exact Or.inr (hPne l' he)
  · -- FreshL
    refine ⟨fun j hj => ?_, PrivCoh_env (s := s) hfr.2 hs ht hPm fun l' => Nat.le_of_eq (hrcE l').symm⟩

    obtain ⟨f1, f2, f4, f5⟩ := hfr.1 j hj
    have hne : freshLabel g.lbase g.n g.i j ≠ l := fun he => by rw [he, hsto] at f1; cases f1
    exact ⟨by rw [hs]; exact f1, f2, by rw [hi]; exact f4, by rw [hPne _ hne]; exact f5⟩
  · -- SeenLE: the planted cell is unseen
    intro l' hl'
    rw [hS] at hl'
    obtain ⟨f, h1, h2⟩ := hsn l' hl'
    exact ⟨f, hPm l' f h1, h2⟩
  · -- OwnHid: memory and `vWr` are unchanged; the planted cell had no frontier, so no planted count
    refine ⟨fun l' c' hc ho o hio => ?_, fun l' c' hc ho hlt => ?_⟩
    · rw [hs] at hc
      exact HiddenP_grow (hoh.1 l' c' hc (by rw [ht]; exact ho) o (fun N e us h1 h2 => by
          have := hio N e us h1 h2; rw [hrcE] at this; exact this)) (hwE _ _)
        (Nat.le_refl _) (fun _ _ => rfl) (fun t m ht' hm hl => hnew0 l' o t m ht' hm hl _)
        (fun _ _ h1 h2 => absurd h1 h2)
    · rw [hs] at hc
      rw [hrcE, hi] at hlt
      obtain ⟨f, hf, hns, hH⟩ := hoh.2 l' c' hc (by rw [ht]; exact ho) hlt
      have he : l' ≠ l := fun he => by rw [he, hnone] at hf; cases hf
      refine ⟨f, by rw [hPne _ he]; exact hf,
        by rw [hS]; exact fun hz => hns (fun hz0 => hz ((ZW.stoAt (congrFun hs l')).2 hz0)), fun o hio => ?_⟩
      exact HiddenP_grow (hH o (hiniR c' l' o hio)) (hwE _ _)
        (Nat.le_refl _) (fun _ _ => rfl) (fun t m ht' hm hl => hnew0 l' o t m ht' hm hl _)
        (fun _ _ h1 h2 => absurd h1 h2)
  · -- PubDef: the planted cell is the thread's own
    intro l' c' f hc hown' hf o hio
    rw [hs] at hc
    by_cases he : l' = l
    · rw [he, hsto] at hc
      cases hc
      exact (hown' (by rw [← ht]; exact hown)).elim
    · rw [hPne _ he] at hf
      exact HiddenP_grow (hpd l' c' f hc (by rw [ht]; exact hown') hf o (hiniR c' l' o hio)) (hwE _ _)
        (Nat.le_refl _) (fun _ _ => rfl) (fun t m ht' hm hl => hnew0 l' o t m ht' hm hl _)
        (fun _ _ h1 h2 => absurd h1 h2)
  · -- OwnPubV: the planted frontier is the thread's `vWr`
    intro l' c' f hc ho hf
    rw [hS]
    rw [hs] at hc
    by_cases he : l' = l
    · subst he
      rw [hP] at hf
      simp at hf
      subst hf
      rcases hF with h | h
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr (h.congrE fun _ _ h => IniWr.ofEq hs hi hR h))
    · rw [hPne _ he] at hf
      exact (hopub l' c' f hc (by rw [ht]; exact ho) hf).imp id
        (Or.imp id fun h => h.congrE fun _ _ h => IniWr.ofEq hs hi hR h)
  · -- PubInv: the planted cell is the thread's own; its type facts are given
    obtain ⟨hS0, hI0, hC0, hPP0, hLV0⟩ := hpi
    refine ⟨fun l' hl' => ?_, fun l' c' b S us hc hseg hu hini => ?_, fun l' c' f hc hf => ?_, ?_, ?_⟩
    · rw [hS] at hl'
      rcases hS0 l' hl' with ⟨c', h1, h2⟩ | ⟨h1, h2⟩
      · exact .inl ⟨c', by rw [hs]; exact h1, by rw [← ht]; exact h2⟩
      · exact .inr ⟨by rw [hs]; exact h1, by rw [hbe]; exact h2⟩
    · rw [hs] at hc
      obtain ⟨ws, h1, h2⟩ := hI0 l' c' b S us hc hseg hu (fun N e h1 => by
        have := hini N e h1; rw [hi] at this; exact this)
      exact ⟨ws, hmono h1, h2⟩
    · rw [hs] at hc
      by_cases he : l' = l
      · rw [he, hsto] at hc
        rw [← Option.some.inj hc]
        obtain ⟨vals, hcell, -⟩ := hoo l c hsto hown
        exact ⟨LayT_of_CellOK hcell, hcpl, hcT, hnT, hrT⟩
      · rw [hPne _ he] at hf; exact hC0 l' c' f hc hf
    · intro l' c' f o hc hown' hf htw t0 t1 m0 m1 hn0 hn1 hm0 hm1 hl0 hl1 hh0 hh1 hst
      rw [hs] at hc
      have he : l' ≠ l := fun he => by
        rw [he, hsto] at hc
        rw [← Option.some.inj hc] at hown'
        rcases hown' with ⟨h, -⟩ | ⟨h, -⟩
        · exact h (by rw [← ht]; exact hown)
        · rw [he, hrcE, hi] at h
          obtain ⟨f', hf', -⟩ := hoh.2 l c hsto hown h
          rw [hnone] at hf'; cases hf'
      rw [hPne _ he] at hf
      exact PairOK_mono hp ht hsub hile hPm hSm
        (hPP0 l' c' f o hc (PubG_tr ht (Nat.le_of_eq (hrcE l').symm) (fun h => ⟨by rw [hrcE, hi] at h; exact h, Nat.le_of_eq (by rw [hi])⟩)
          (fun _ => Nat.le_of_eq (by rw [hi])) hown') hf htw t0 t1 m0 m1 hn0 hn1 hm0 hm1 hl0 hl1 hh0 hh1 hst) hbx
    · intro l' c' f b S us o hc hown' hf hseg hu ho
      rw [hs] at hc
      have he : l' ≠ l := fun he => by
        rw [he, hsto] at hc
        rw [← Option.some.inj hc] at hown'
        exact hown' (by rw [← ht]; exact hown)
      rw [hPne _ he] at hf
      exact hLV0 l' c' f b S us o hc (by rw [ht]; exact hown') hf hseg hu ho

/-- (F2′ step 3) A word of segment `b` initialised at count `ini` lies in a
slot below `ini`. -/
theorem IniSegN_of_InitR {E : TEnv} {c : Cell} {l : AllocLabel} {b o : Nat} {S : Ty}
    (hi : InitR E c l (b + o)) (hseg : SegOf c.ty b S) : IniSegN (E.ini l) c b := by
  intro N e hT
  rcases hseg with ⟨-, rfl, hA⟩ | ⟨N', us, j, hT', hus, -, rfl⟩
  · rw [hT] at hA; simp [accs] at hA
  · rw [hT] at hT'; simp only [Ty.array.injEq, Idx.lit.injEq] at hT'; obtain ⟨-, rfl⟩ := hT'
    have h := hi N _ us hT hus
    refine ⟨us, j, hus, ?_, rfl⟩
    have h2 : j * nWords us < E.ini l * nWords us := Nat.lt_of_le_of_lt (Nat.le_add_right _ _) h
    exact Nat.lt_of_not_le fun hle => absurd h2 (Nat.not_lt.2 (Nat.mul_le_mul_right _ hle))

/-- (F2′ step 3, S3.2) **The ini-raising plant**: `MemInv_plantF` that also
raises the reader-visible count of the planted cell to `N` (`rini` fixed, so
the real count `rc` is unchanged).  The predicted slots (initialised at `N`, not
at the old count) have every non-promise message hidden below `F` (`hhold`: the
holders) and an inhabited segment type (`hinh`); the old slots are hidden below
`vWr ≤ F` (`OwnHidP` part 1, `hFw`).  `hrl` (`rini ≤ ini` at the cell) keeps
`rc`.  `hrl`, `hhold`, `hinh` are lemma-level obligations of the stepper. -/
theorem MemInv_plantFN {g : G} {E E' : TEnv} {s : St} {l : AllocLabel} {c : Cell} {F N : Ts}
    (hm : MemInv g E s) (hsto : E.sto l = some c) (hown : c.owner = some E.tid) (hnone : E.pfr l = none)
    (hp : E.prog = E'.prog) (ht : E.tid = E'.tid) (hs : E'.sto = E.sto)
    (hi : E'.ini = fun l' => if l' = l then N else E.ini l') (hN : E.ini l ≤ N) (hrl : E.rini l ≤ E.ini l)
    (hP : E'.pfr = fun l' => if l' = l then some F else E.pfr l') (hS : E'.seen = E.seen) (hR : E'.rini = E.rini)
    (hF : F ≤ s.vs.vWr ∨ HoldW E s l F) (hFw : E.ini l < N → s.vs.vWr ≤ F)
    (hhold : ∀ o, InitR E' c l o → ¬ InitR E c l o → ∀ (t : Nat) (m : Msg), t ∉ s.promises →
      s.mem[t]? = some m → m.loc = ⟨l, o⟩ →
      ∃ (t' : Nat) (m' : Msg), t < t' ∧ t' ≤ F ∧ s.mem[t']? = some m' ∧ m'.loc = ⟨l, o⟩)
    (hinh : ∀ b S us, SegOf c.ty b S → accs S = some us → IniSeg E' c l b → ¬ IniSeg E c l b →
      ∃ ws, ValOf E' S ws ∧ ws.length = nWords us)
    (hcpl : ∀ b S, SegOf c.ty b S → accs S ≠ none → TearOK S) (hcT : Ty.coupledOKIn [] c.ty = true)
    (hnT : Ty.noOwnIn [] c.ty = true) (hrT : rgnFree c.ty = true)
    (hbx : ∀ l B, E.box l = some B → E'.box l = some B := by first | exact fun _ _ h => h | simp_all | (intro _ _ h; simpa [CE, TEnv.withSto] using h))
    (hbe : E'.box = E.box := by first | rfl | simp_all) :
    MemInv g E' s := by
  obtain ⟨hmo, hoo, hpl, hfr, hsn, hoh, hpd, hopub, hpi, hbi, hpo⟩ := id hm
  have hsub : ∀ l c, E.sto l = some c → E'.sto l = some c := fun l c h => by rw [hs]; exact h
  have hri : ∀ l, E.rini l ≤ E'.rini l := fun l => by rw [hR]; exact Nat.le_refl _
  have hiL : E'.ini l = N := by rw [hi]; simp
  have hiNe : ∀ l', l' ≠ l → E'.ini l' = E.ini l' := fun l' he => by rw [hi]; simp only [he, ↓reduceIte]
  have hile : ∀ l', E.ini l' ≤ E'.ini l' := fun l' => by
    by_cases he : l' = l
    · rw [he, hiL]; exact hN
    · rw [hiNe l' he]; exact Nat.le_refl _
  have hPne : ∀ l', l' ≠ l → E'.pfr l' = E.pfr l' := fun l' he => by rw [hP]; simp only [he, ↓reduceIte]
  have hPm : ∀ l' f, E.pfr l' = some f → E'.pfr l' = some f := fun l' f h => by
    by_cases he : l' = l
    · rw [he, hnone] at h; cases h
    · rw [hPne l' he]; exact h
  have hSm : ∀ l', E.seen l' → E'.seen l' := fun l' h => by rw [hS]; exact h
  have hnS : ¬ E.seen l := fun h => by
    obtain ⟨f, h1, -⟩ := hsn l h; rw [hnone] at h1; cases h1
  -- the planted cell had no planted count: its real count is its reader-visible one
  have hrcl : E.rc l = E.ini l := by
    refine Nat.le_antisymm (E.rc_le_ini l) (Nat.le_of_not_lt fun hlt => ?_)
    obtain ⟨f, hf, -⟩ := hoh.2 l c hsto hown hlt
    rw [hnone] at hf; cases hf
  have hrcE : ∀ l', E'.rc l' = E.rc l' := fun l' => by
    by_cases he : l' = l
    · rw [he]
      have h1 : E'.rini l = E.rini l := by rw [hR]
      have h2 := hrcl
      unfold TEnv.rc at h2 ⊢; rw [hiL, h1]; omega
    · exact TEnv.rc_congr (hiNe l' he) (by rw [hR])
  have hmono : ∀ {U : Ty} {vs : List Word}, ValOf E U vs → ValOf E' U vs :=
    fun h => ValOf_mono hp ht hsub hile h hPm hSm hbx
  have hwE : ∀ T o w, WordOK E T o w → WordOK E' T o w := fun T o w h =>
    WordOK_mono hp ht hsub hile hPm hSm h hbx
  have hiniR : ∀ c' l' o, l' ≠ l → InitR E' c' l' o → InitR E c' l' o := fun c' l' o he h N e us h1 h2 => by
    have := h N e us h1 h2; rw [hiNe l' he] at this; exact this
  have hIW : ∀ a : Address, IniWr E' a → IniWr E a := fun a h c1 N1 e1 us1 h1 h2 h3 => by
    have := h c1 N1 e1 us1 (by rw [hs]; exact h1) h2 h3; rw [hrcE] at this; exact this
  have hnew0 : ∀ (l' : AllocLabel) (o : Nat) (t : Nat) (m : Msg), s.mem.size ≤ t → s.mem[t]? = some m →
      m.loc = ⟨l', o⟩ → ∀ T, WordOK E' T o (mw m) := fun _ _ t m ht hm _ _ =>
    (Nat.not_le.2 (lt_of_get hm) ht).elim
  refine ⟨MemOKP_mono hmo hp ht hsub hile (fun t m c h hc => by rw [hs] at hc; exact hc) hPm hSm hbx,
    ?_, hpl, ?_, ?_, ?_, ?_, ?_, ?_, BoxInv_tr hbi hbe (fun _ _ _ h => by rw [hS] at h; exact h)
      (fun l _ _ => by rw [hs])
      (fun l' B hB => by
        by_cases he : l' = l
        · rw [he] at hB; have := (hbi.2.2 l B hB).1; rw [hsto] at this; cases this
        · exact hiNe l' he)
      (Nat.le_refl _) (fun _ _ _ _ _ _ h => h) (fun _ _ _ _ _ _ h => h), hpo⟩
  · -- OwnOK: the real count is unchanged
    intro l' c' hc ho
    rw [hs] at hc
    by_cases he : l' = l
    · rw [he] at hc ⊢
      obtain ⟨vals, h1, h2, -⟩ := hoo l c' hc (by rw [ht]; exact ho)
      have h1' : CellOK E' (E'.rc l) c'.ty vals := CellOK_map hmono (Nat.le_of_eq (hrcE l)) h1
      have hS' : ∀ o v, vals[o]? = some v → LatestS s.mem (· ∈ s.promises) s.vs.coh ⟨l, o⟩ v := fun o v hv => by
        have := h2 o v hv; rw [hnone] at this; exact LatestSF_none this
      exact ⟨vals, h1', fun o v hv => LatestSF_of_LatestS (hS' o v hv), fun _ => OwnPairF_of_LatestS h1' hS'⟩
    · exact OwnCellF_pub (hoo l' c' hc (by rw [ht]; exact ho)) hmono (hiNe l' he) (.inr (hPne l' he)) hmo.2.2
        (by rw [hR])
  · -- FreshL
    refine ⟨fun j hj => ?_, PrivCoh_env (s := s) hfr.2 hs ht hPm fun l' => Nat.le_of_eq (hrcE l').symm⟩

    obtain ⟨f1, f2, f4, f5⟩ := hfr.1 j hj
    have hne : freshLabel g.lbase g.n g.i j ≠ l := fun he => by rw [he, hsto] at f1; cases f1
    exact ⟨by rw [hs]; exact f1, f2, by rw [hiNe _ hne]; exact f4, by rw [hPne _ hne]; exact f5⟩
  · -- SeenLE: the planted cell is unseen
    intro l' hl'
    rw [hS] at hl'
    obtain ⟨f, h1, h2⟩ := hsn l' hl'
    exact ⟨f, hPm l' f h1, h2⟩
  · -- OwnHid: part 1 at the unchanged real count; part 2 at the planted cell from part 1 (old
    -- slots) and the holders (predicted slots)
    refine ⟨fun l' c' hc ho o hio => ?_, fun l' c' hc ho hlt => ?_⟩
    · rw [hs] at hc
      exact HiddenP_grow (hoh.1 l' c' hc (by rw [ht]; exact ho) o (fun N e us h1 h2 => by
          have := hio N e us h1 h2; rw [hrcE] at this; exact this)) (hwE _ _)
        (Nat.le_refl _) (fun _ _ => rfl) (fun t m ht' hm hl => hnew0 l' o t m ht' hm hl _)
        (fun _ _ h1 h2 => absurd h1 h2)
    · rw [hs] at hc
      by_cases he : l' = l
      · rw [he] at hc hlt ⊢
        rw [hsto] at hc; obtain rfl := Option.some.inj hc
        rw [hrcE, hrcl, hiL] at hlt
        refine ⟨F, by rw [hP]; simp, by rw [hS]; exact fun _ => hnS, fun o hio => ?_⟩
        by_cases hold : InitR E c l o
        · have hr : InitRr E c l o := fun N' e us h1 h2 => by rw [hrcl]; exact hold N' e us h1 h2
          exact HiddenP_grow (hoh.1 l c hsto hown o hr) (hwE _ _) (hFw hlt) (fun _ _ => rfl)
            (fun t m ht' hm hl => hnew0 l o t m ht' hm hl _) (fun _ _ h1 h2 => absurd h1 h2)
        · intro t m hnp hm hloc _
          exact hhold o hio hold t m hnp hm hloc
      · rw [hrcE, hiNe l' he] at hlt
        obtain ⟨f, hf, hns, hH⟩ := hoh.2 l' c' hc (by rw [ht]; exact ho) hlt
        refine ⟨f, by rw [hPne _ he]; exact hf,
        by rw [hS]; exact fun hz => hns (fun hz0 => hz ((ZW.stoAt (congrFun hs l')).2 hz0)), fun o hio => ?_⟩
        exact HiddenP_grow (hH o (hiniR c' l' o he hio)) (hwE _ _)
          (Nat.le_refl _) (fun _ _ => rfl) (fun t m ht' hm hl => hnew0 l' o t m ht' hm hl _)
          (fun _ _ h1 h2 => absurd h1 h2)
  · -- PubDef: the planted cell is the thread's own
    intro l' c' f hc hown' hf o hio
    rw [hs] at hc
    by_cases he : l' = l
    · rw [he, hsto] at hc
      cases hc
      exact (hown' (by rw [← ht]; exact hown)).elim
    · rw [hPne _ he] at hf
      exact HiddenP_grow (hpd l' c' f hc (by rw [ht]; exact hown') hf o (hiniR c' l' o he hio)) (hwE _ _)
        (Nat.le_refl _) (fun _ _ => rfl) (fun t m ht' hm hl => hnew0 l' o t m ht' hm hl _)
        (fun _ _ h1 h2 => absurd h1 h2)
  · -- OwnPubV: the planted frontier is below `vWr` or held
    intro l' c' f hc ho hf
    rw [hS]
    rw [hs] at hc
    by_cases he : l' = l
    · subst he
      rw [hP] at hf
      simp at hf
      subst hf
      rcases hF with h | h
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr (h.congrE fun a _ h' => hIW a h'))
    · rw [hPne _ he] at hf
      exact (hopub l' c' f hc (by rw [ht]; exact ho) hf).imp id
        (Or.imp id fun h => h.congrE fun a _ h' => hIW a h')
  · -- PubInv: the planted cell is the thread's own; its type facts are given
    obtain ⟨hS0, hI0, hC0, hPP0, hLV0⟩ := hpi
    refine ⟨fun l' hl' => ?_, fun l' c' b S us hc hseg hu hini => ?_, fun l' c' f hc hf => ?_, ?_, ?_⟩
    · rw [hS] at hl'
      rcases hS0 l' hl' with ⟨c', h1, h2⟩ | ⟨h1, h2⟩
      · exact .inl ⟨c', by rw [hs]; exact h1, by rw [← ht]; exact h2⟩
      · exact .inr ⟨by rw [hs]; exact h1, by rw [hbe]; exact h2⟩
    · rw [hs] at hc
      by_cases hold : IniSeg E c' l' b
      · obtain ⟨ws, h1, h2⟩ := hI0 l' c' b S us hc hseg hu hold
        exact ⟨ws, hmono h1, h2⟩
      · by_cases he : l' = l
        · rw [he] at hc hini hold
          rw [hsto] at hc; obtain rfl := Option.some.inj hc
          exact hinh b S us hseg hu hini hold
        · refine absurd ?_ hold
          unfold IniSeg at hini ⊢; rw [hiNe l' he] at hini; exact hini
    · rw [hs] at hc
      by_cases he : l' = l
      · rw [he, hsto] at hc
        rw [← Option.some.inj hc]
        obtain ⟨vals, hcell, -⟩ := hoo l c hsto hown
        exact ⟨LayT_of_CellOK hcell, hcpl, hcT, hnT, hrT⟩
      · rw [hPne _ he] at hf; exact hC0 l' c' f hc hf
    · intro l' c' f o hc hown' hf htw t0 t1 m0 m1 hn0 hn1 hm0 hm1 hl0 hl1 hh0 hh1 hst
      rw [hs] at hc
      by_cases he : l' = l
      · -- a planted pair lies in a predicted slot: every non-promise message there is hidden
        rw [he] at hc hown' hf hl0 hh0
        rw [hsto] at hc; obtain rfl := Option.some.inj hc
        rw [hP] at hf; simp at hf; subst hf
        rcases hown' with ⟨h, -⟩ | ⟨-, b, S, us, o', h2, h3, h4, h5, h6, h7⟩
        · exact (h (by rw [← ht]; exact hown)).elim
        · have hlt := TwoAt_lt h4
          have hio : InitR E' c l o := by rw [h5]; exact InitR_of_IniSeg h7 h2 h3 (by omega)
          have hnio : ¬ InitR E c l o := fun hr => h6 (by
            rw [hrcE, hrcl]; rw [h5] at hr; exact IniSegN_of_InitR hr h2)
          obtain ⟨t', m', e1, e2, e3, e4⟩ := hhold o hio hnio t0 m0 hn0 hm0 hl0
          have hT : WeakMem.hiddenFrom s.mem ⟨l, o⟩ t0 F = true := by
            unfold WeakMem.hiddenFrom; rw [List.any_eq_true]
            exact ⟨t', List.mem_range.2 (Nat.lt_succ_of_le e2), by simp [e1, e3, e4]⟩
          rw [hh0] at hT; cases hT
      · rw [hPne _ he] at hf
        exact PairOK_mono hp ht hsub hile hPm hSm
          (hPP0 l' c' f o hc (PubG_tr ht (Nat.le_of_eq (hrcE l').symm)
            (fun h => ⟨by rw [hrcE, hiNe l' he] at h; exact h, Nat.le_of_eq (hiNe l' he)⟩)
            (fun _ => Nat.le_of_eq (hiNe l' he)) hown')
            hf htw t0 t1 m0 m1 hn0 hn1 hm0 hm1 hl0 hl1 hh0 hh1 hst) hbx
    · intro l' c' f b S us o hc hown' hf hseg hu ho
      rw [hs] at hc
      have he : l' ≠ l := fun he => by
        rw [he, hsto] at hc
        rw [← Option.some.inj hc] at hown'
        exact hown' (by rw [← ht]; exact hown)
      rw [hPne _ he] at hf
      exact hLV0 l' c' f b S us o hc (by rw [ht]; exact hown') hf hseg hu ho


/-- (F2′ step 3, RiniLe) `MemInv_plantFN` with `hrl` from the environment's
`rini ≤ ini` (`SysInvW.rle_cut`) and `hFw` from a frontier at or above `vWr`
(`EFoot`'s plant bound). -/
theorem MemInv_plantFNr {g : G} {E E' : TEnv} {s : St} {l : AllocLabel} {c : Cell} {F N : Ts}
    (hm : MemInv g E s) (hsto : E.sto l = some c) (hown : c.owner = some E.tid) (hnone : E.pfr l = none)
    (hp : E.prog = E'.prog) (ht : E.tid = E'.tid) (hs : E'.sto = E.sto)
    (hi : E'.ini = fun l' => if l' = l then N else E.ini l') (hN : E.ini l ≤ N)
    (hrle : ∀ l, E.rini l ≤ E.ini l)
    (hP : E'.pfr = fun l' => if l' = l then some F else E.pfr l') (hS : E'.seen = E.seen) (hR : E'.rini = E.rini)
    (hF : F ≤ s.vs.vWr ∨ HoldW E s l F) (hFlo : s.vs.vWr ≤ F)
    (hhold : ∀ o, InitR E' c l o → ¬ InitR E c l o → ∀ (t : Nat) (m : Msg), t ∉ s.promises →
      s.mem[t]? = some m → m.loc = ⟨l, o⟩ →
      ∃ (t' : Nat) (m' : Msg), t < t' ∧ t' ≤ F ∧ s.mem[t']? = some m' ∧ m'.loc = ⟨l, o⟩)
    (hinh : ∀ b S us, SegOf c.ty b S → accs S = some us → IniSeg E' c l b → ¬ IniSeg E c l b →
      ∃ ws, ValOf E' S ws ∧ ws.length = nWords us)
    (hcpl : ∀ b S, SegOf c.ty b S → accs S ≠ none → TearOK S) (hcT : Ty.coupledOKIn [] c.ty = true)
    (hnT : Ty.noOwnIn [] c.ty = true) (hrT : rgnFree c.ty = true)
    (hbx : ∀ l B, E.box l = some B → E'.box l = some B) (hbe : E'.box = E.box) :
    MemInv g E' s :=
  MemInv_plantFN hm hsto hown hnone hp ht hs hi hN (hrle l) hP hS hR hF (fun _ => hFlo) hhold hinh
    hcpl hcT hnT hrT hbx hbe

/-- (F2′ step 3, b′) A member of a list is at most its `max`-fold. -/
theorem le_foldr_max {L : List Nat} {x : Nat} (h : x ∈ L) : x ≤ L.foldr max 0 := by
  induction L with
  | nil => cases h
  | cons a L ih =>
    simp only [List.foldr_cons]
    rcases List.mem_cons.1 h with rfl | h'
    · exact Nat.le_max_left _ _
    · exact Nat.le_trans (ih h') (Nat.le_max_right _ _)

/-- (F2′ step 3, b′) A list's `max`-fold is `0` or a member. -/
theorem foldr_max_mem (L : List Nat) : L.foldr max 0 = 0 ∨ L.foldr max 0 ∈ L := by
  induction L with
  | nil => exact Or.inl rfl
  | cons a L ih =>
    simp only [List.foldr_cons]
    rcases Nat.le_total a (L.foldr max 0) with h | h
    · rw [Nat.max_eq_right h]
      rcases ih with h0 | h0
      · rw [h0]; rw [h0] at h; exact Or.inr (by rw [Nat.le_zero.1 h]; exact List.mem_cons_self ..)
      · exact Or.inr (List.mem_cons_of_mem _ h0)
    · rw [Nat.max_eq_left h]; exact Or.inr (List.mem_cons_self ..)

/-- (F2′ step 3, b′) A satisfiable predicate on `Nat` has a least witness. -/
theorem exists_least_nat {P : Nat → Prop} (h : ∃ n, P n) : ∃ n, P n ∧ ∀ m, P m → n ≤ m := by
  refine Classical.byContradiction fun hne => ?_
  have key : ∀ n, ∀ m, m ≤ n → ¬ P m := by
    intro n
    induction n with
    | zero => intro m hm hP; exact hne ⟨m, hP, fun k _ => by omega⟩
    | succ n ih =>
      intro m hm hP
      rcases Nat.lt_or_eq_of_le hm with hlt | rfl
      · exact ih m (by omega) hP
      · exact hne ⟨n + 1, hP, fun k hk => Nat.le_of_not_lt fun hk' => ih k (by omega) hk⟩
  obtain ⟨n, hn⟩ := h
  exact key n n (Nat.le_refl _) hn

/-- (F2′ step 3, b′) **The plant's holder bound** at `l`: the largest own
promise `u` with `HoldW E s l u` (a least own promise at an address of `l`
outside the real count lies at or above `u`), `0` if none. -/
noncomputable def plantT (E : TEnv) (s : St) (l : AllocLabel) : Ts :=
  (s.promises.filter fun u => @decide (HoldW E s l u) (Classical.propDecidable _)).foldr max 0

/-- (F2′ step 3, b′) **The planted frontier**: `max vWr plantT`. -/
noncomputable def plantF (E : TEnv) (s : St) (l : AllocLabel) : Ts := max s.vs.vWr (plantT E s l)

/-- (F2′ step 3, b′) **The plant's frontier facts by construction**: at a
private own cell `l` whose newly reader-visible units (`InitR E'`, not
`InitR E`, within the buffer's length: `hNa`) each carry an own outstanding
promise (`hheld`), the frontier `plantF` is at or above `vWr` (`hFw`), below
`max vWr size`, at `vWr` or held (`hF`), and above every non-promise message at
a new unit (`hhold`): such a message is at or below coherence (`OwnOKPF`, the
cell private), and the least own promise there is above coherence
(`PromAbove`) and at most `plantT`. -/
theorem plant_holdF {g : G} {E E' : TEnv} {s : St} {l : AllocLabel} {c : Cell}
    (hm : MemInv g E s) (hsto : E.sto l = some c) (hown : c.owner = some E.tid) (hnone : E.pfr l = none)
    (hpa : PromAbove s)
    (hNa : ∀ Na e us, c.ty = .array (.lit Na) e → accs e = some us → E'.ini l ≤ Na)
    (hheld : ∀ o, InitR E' c l o → ¬ InitR E c l o →
      ∃ u ∈ s.promises, ∃ m, s.mem[u]? = some m ∧ m.loc = ⟨l, o⟩) :
    s.vs.vWr ≤ plantF E s l ∧ plantF E s l ≤ max s.vs.vWr s.mem.size ∧
    (plantF E s l ≤ s.vs.vWr ∨ HoldW E s l (plantF E s l)) ∧
    (∀ o, InitR E' c l o → ¬ InitR E c l o → ∀ (t : Nat) (m : Msg), t ∉ s.promises →
      s.mem[t]? = some m → m.loc = ⟨l, o⟩ →
      ∃ (t' : Nat) (m' : Msg), t < t' ∧ t' ≤ plantF E s l ∧ s.mem[t']? = some m' ∧ m'.loc = ⟨l, o⟩) := by
  classical
  have hPL : PromLt s := hm.2.2.1
  have hmemT : ∀ u, u ∈ s.promises → HoldW E s l u → u ≤ plantT E s l := fun u hu hH => by
    unfold plantT
    exact le_foldr_max (List.mem_filter.2 ⟨hu, decide_eq_true hH⟩)
  have hTcase : plantT E s l = 0 ∨ (plantT E s l ∈ s.promises ∧ HoldW E s l (plantT E s l)) := by
    rcases foldr_max_mem (s.promises.filter fun u => @decide (HoldW E s l u) (Classical.propDecidable _))
      with h | h
    · exact Or.inl h
    · have h' : plantT E s l ∈ s.promises.filter fun u => @decide (HoldW E s l u) (Classical.propDecidable _) :=
        h
      obtain ⟨h1, h2⟩ := List.mem_filter.1 h'
      exact Or.inr ⟨h1, of_decide_eq_true h2⟩
  refine ⟨Nat.le_max_left _ _, ?_, ?_, ?_⟩
  · unfold plantF
    rcases hTcase with h | ⟨h1, -⟩
    · rw [h]; exact Nat.max_le.2 ⟨Nat.le_max_left _ _, Nat.zero_le _⟩
    · exact Nat.max_le.2 ⟨Nat.le_max_left _ _, Nat.le_trans (Nat.le_of_lt (hPL _ h1)) (Nat.le_max_right _ _)⟩
  · unfold plantF
    rcases Nat.le_total (plantT E s l) s.vs.vWr with h | h
    · rw [Nat.max_eq_left h]; exact Or.inl (Nat.le_refl _)
    · rw [Nat.max_eq_right h]
      rcases hTcase with h0 | ⟨-, h2⟩
      · rw [h0]; rw [h0] at h; rw [Nat.le_zero.1 h]; exact Or.inl (Nat.le_refl _)
      · exact Or.inr h2
  · intro o hI' hnI t m htp hmt hloc
    -- the buffer's shape at the new unit
    have hex : ∃ Na e us, c.ty = .array (.lit Na) e ∧ accs e = some us ∧ ¬ o < E.ini l * nWords us := by
      refine Classical.byContradiction fun hne => hnI fun Na e us h1 h2 => ?_
      exact Classical.byContradiction fun hlt => hne ⟨Na, e, us, h1, h2, hlt⟩
    obtain ⟨Na, e, us, hT, hus, hge⟩ := hex
    have hlt' : o < E'.ini l * nWords us := hI' Na e us hT hus
    have hle' : E'.ini l * nWords us ≤ Na * nWords us := Nat.mul_le_mul_right _ (hNa Na e us hT hus)
    -- the cell's words
    obtain ⟨vals, hc, hlat, -⟩ := hm.2.1 l c hsto hown
    have hlen : vals.length = Na * nWords us := by
      rcases hc with ⟨hwc, -⟩ | ⟨Na', e', us', hT', hus', -, hlen, -⟩
      · rw [hT] at hwc; simp [wc, accs] at hwc
      · rw [hT] at hT'; simp only [Ty.array.injEq, Idx.lit.injEq] at hT'
        obtain ⟨rfl, rfl⟩ := hT'
        rw [hus] at hus'; cases hus'; exact hlen
    have hov : o < vals.length := by omega
    have hL := LatestSF_none (by have := hlat o _ (List.getElem?_eq_getElem hov); rw [hnone] at this; exact this)
    obtain ⟨-, -, hlater⟩ := hL
    have htc : t ≤ s.vs.coh ⟨l, o⟩ :=
      Nat.le_of_not_lt fun h => htp (hlater t m h hmt hloc)
    -- the least own promise at the unit
    have hP : ∃ u, u ∈ s.promises ∧ ∃ m, s.mem[u]? = some m ∧ m.loc = (⟨l, o⟩ : Address) := by
      obtain ⟨u, hu, m', h1, h2⟩ := hheld o hI' hnI
      exact ⟨u, hu, m', h1, h2⟩
    obtain ⟨u0, ⟨hu, mu, hmu, hlu⟩, hleast⟩ := exists_least_nat hP
    have hmin : ∀ u' ∈ s.promises, ∀ m', s.mem[u']? = some m' → m'.loc = mu.loc → u0 ≤ u' :=
      fun u' hu' m' h1 h2 => hleast u' ⟨hu', m', h1, by rw [h2, hlu]⟩
    have hnIW : ¬ IniWr E mu.loc := fun hw => by
      have h1 := hw c Na e us (by rw [hlu]; exact hsto) hT hus
      rw [hlu] at h1
      exact hge (Nat.lt_of_lt_of_le h1 (Nat.mul_le_mul_right _ (E.rc_le_ini l)))
    have hHW : HoldW E s l u0 :=
      ⟨u0, hu, mu, hmu, by rw [hlu], Nat.le_refl _, hmin, hnIW⟩
    have hcu : s.vs.coh ⟨l, o⟩ < u0 := by
      have := hpa _ hu mu hmu; rw [hlu] at this; exact this
    refine ⟨u0, mu, Nat.lt_of_le_of_lt htc hcu, ?_, hmu, hlu⟩
    exact Nat.le_trans (hmemT _ hu hHW) (Nat.le_max_right _ _)

/-- (F2′ step 3, b′) **The ini-raising plant at the constructed frontier**:
`MemInv_plantFNr` at `F := plantF E s l`, the frontier facts from
`plant_holdF`; left: the held new units (`hheld`), the buffer bound (`hNa`) and
`hinh`. -/
theorem MemInv_plantFH {g : G} {E E' : TEnv} {s : St} {l : AllocLabel} {c : Cell} {N : Ts}
    (hm : MemInv g E s) (hsto : E.sto l = some c) (hown : c.owner = some E.tid) (hnone : E.pfr l = none)
    (hp : E.prog = E'.prog) (ht : E.tid = E'.tid) (hs : E'.sto = E.sto)
    (hi : E'.ini = fun l' => if l' = l then N else E.ini l') (hN : E.ini l ≤ N)
    (hrle : ∀ l, E.rini l ≤ E.ini l)
    (hP : E'.pfr = fun l' => if l' = l then some (plantF E s l) else E.pfr l') (hS : E'.seen = E.seen)
    (hR : E'.rini = E.rini) (hpa : PromAbove s)
    (hNa : ∀ Na e us, c.ty = .array (.lit Na) e → accs e = some us → N ≤ Na)
    (hheld : ∀ o, InitR E' c l o → ¬ InitR E c l o →
      ∃ u ∈ s.promises, ∃ m, s.mem[u]? = some m ∧ m.loc = ⟨l, o⟩)
    (hinh : ∀ b S us, SegOf c.ty b S → accs S = some us → IniSeg E' c l b → ¬ IniSeg E c l b →
      ∃ ws, ValOf E' S ws ∧ ws.length = nWords us)
    (hcpl : ∀ b S, SegOf c.ty b S → accs S ≠ none → TearOK S) (hcT : Ty.coupledOKIn [] c.ty = true)
    (hnT : Ty.noOwnIn [] c.ty = true) (hrT : rgnFree c.ty = true)
    (hbx : ∀ l B, E.box l = some B → E'.box l = some B) (hbe : E'.box = E.box) :
    MemInv g E' s ∧ s.vs.vWr ≤ plantF E s l ∧ plantF E s l ≤ max s.vs.vWr s.mem.size := by
  have hiL : E'.ini l = N := by rw [hi]; simp
  obtain ⟨h1, h2, h3, h4⟩ := plant_holdF (E' := E') hm hsto hown hnone hpa
    (fun Na e us hT hus => by rw [hiL]; exact hNa Na e us hT hus) hheld
  exact ⟨MemInv_plantFNr hm hsto hown hnone hp ht hs hi hN hrle hP hS hR h3 h1 h4 hinh hcpl hcT hnT hrT
    hbx hbe, h1, h2⟩

/-- (F2′ step 3, b′) **The held prefix**: every unit of the first `k` slots of
buffer `l` is reader-visible at `E` or carries an own outstanding promise
(the slots a published reference of static count `k` predicts). -/
def PrefixHeld (E : TEnv) (s : St) (l : AllocLabel) (c : Cell) (k : Nat) : Prop :=
  ∀ Na e us, c.ty = .array (.lit Na) e → accs e = some us → ∀ o, o < k * nWords us →
    InitR E c l o ∨ ∃ u ∈ s.promises, ∃ m, s.mem[u]? = some m ∧ m.loc = ⟨l, o⟩

/-- (F2′ step 3, b′) The held prefix gives `plant_holdF`'s `hheld` at the count
`max ini k`. -/
theorem held_of_prefix {E E' : TEnv} {s : St} {l : AllocLabel} {c : Cell} {k : Nat}
    (hk : PrefixHeld E s l c k) (hi : E'.ini l = max (E.ini l) k) :
    ∀ o, InitR E' c l o → ¬ InitR E c l o → ∃ u ∈ s.promises, ∃ m, s.mem[u]? = some m ∧ m.loc = ⟨l, o⟩ := by
  intro o hI' hnI
  have hex : ∃ Na e us, c.ty = .array (.lit Na) e ∧ accs e = some us ∧ ¬ o < E.ini l * nWords us := by
    refine Classical.byContradiction fun hne => hnI fun Na e us h1 h2 => ?_
    exact Classical.byContradiction fun hlt => hne ⟨Na, e, us, h1, h2, hlt⟩
  obtain ⟨Na, e, us, hT, hus, hge⟩ := hex
  have h1 := hI' Na e us hT hus
  rw [hi] at h1
  have hok : o < k * nWords us := by
    rcases Nat.le_total (E.ini l) k with h | h
    · rw [Nat.max_eq_right h] at h1; exact h1
    · rw [Nat.max_eq_left h] at h1; exact absurd h1 hge
  rcases hk Na e us hT hus o hok with h | h
  · exact absurd h hnI
  · exact h

/-- (F2′ step 3, b′) **The ini-raising plant at a held prefix**: the planted
count `max ini k` (`k`: the static count of the published reference), the
frontier `plantF`; left: the held prefix (`PrefixHeld`, the certificate's
part), the buffer bounds, and `hinh`. -/
theorem MemInv_plantFK {g : G} {E E' : TEnv} {s : St} {l : AllocLabel} {c : Cell} {k : Nat}
    (hm : MemInv g E s) (hsto : E.sto l = some c) (hown : c.owner = some E.tid) (hnone : E.pfr l = none)
    (hp : E.prog = E'.prog) (ht : E.tid = E'.tid) (hs : E'.sto = E.sto)
    (hi : E'.ini = fun l' => if l' = l then max (E.ini l) k else E.ini l')
    (hrle : ∀ l, E.rini l ≤ E.ini l)
    (hP : E'.pfr = fun l' => if l' = l then some (plantF E s l) else E.pfr l') (hS : E'.seen = E.seen)
    (hR : E'.rini = E.rini) (hpa : PromAbove s)
    (hNa : ∀ Na e us, c.ty = .array (.lit Na) e → accs e = some us → E.ini l ≤ Na ∧ k ≤ Na)
    (hk : PrefixHeld E s l c k)
    (hinh : ∀ b S us, SegOf c.ty b S → accs S = some us → IniSeg E' c l b → ¬ IniSeg E c l b →
      ∃ ws, ValOf E' S ws ∧ ws.length = nWords us)
    (hcpl : ∀ b S, SegOf c.ty b S → accs S ≠ none → TearOK S) (hcT : Ty.coupledOKIn [] c.ty = true)
    (hnT : Ty.noOwnIn [] c.ty = true) (hrT : rgnFree c.ty = true)
    (hbx : ∀ l B, E.box l = some B → E'.box l = some B) (hbe : E'.box = E.box) :
    MemInv g E' s ∧ s.vs.vWr ≤ plantF E s l ∧ plantF E s l ≤ max s.vs.vWr s.mem.size :=
  MemInv_plantFH hm hsto hown hnone hp ht hs hi (Nat.le_max_left _ _) hrle hP hS hR hpa
    (fun Na e us hT hus => Nat.max_le.2 (hNa Na e us hT hus))
    (held_of_prefix hk (by rw [hi]; simp)) hinh hcpl hcT hnT hrT hbx hbe

/-- (U3, transitive) **The simultaneous plant** over a label set `Lp`: every
member is a private own unplanted cell; its count is raised to `N l` and its
frontier planted at `F l` at once.  `MemInv_plantFN` generalised from one
label to a set, with `hinh` at the final environment (its witnesses may name
other members: a sequential fold of single plants does not suffice). -/
theorem MemInv_plantSet {g : G} {E E' : TEnv} {s : St} {Lp : AllocLabel → Prop} {F N : AllocLabel → Ts}
    (hm : MemInv g E s) (hL : ∀ l, Lp l → ∃ c, E.sto l = some c ∧ c.owner = some E.tid)
    (hnone : ∀ l, Lp l → E.pfr l = none)
    (hp : E.prog = E'.prog) (ht : E.tid = E'.tid) (hs : E'.sto = E.sto)
    (hiIn : ∀ l, Lp l → E'.ini l = N l) (hiNe : ∀ l, ¬ Lp l → E'.ini l = E.ini l)
    (hN : ∀ l, Lp l → E.ini l ≤ N l) (hrl : ∀ l, Lp l → E.rini l ≤ E.ini l)
    (hPin : ∀ l, Lp l → E'.pfr l = some (F l)) (hPne : ∀ l, ¬ Lp l → E'.pfr l = E.pfr l)
    (hS : E'.seen = E.seen) (hR : E'.rini = E.rini)
    (hF : ∀ l, Lp l → F l ≤ s.vs.vWr ∨ HoldW E s l (F l))
    (hFw : ∀ l, Lp l → E.ini l < N l → s.vs.vWr ≤ F l)
    (hhold : ∀ l c, Lp l → E.sto l = some c → ∀ o, InitR E' c l o → ¬ InitR E c l o →
      ∀ (t : Nat) (m : Msg), t ∉ s.promises → s.mem[t]? = some m → m.loc = ⟨l, o⟩ →
      ∃ (t' : Nat) (m' : Msg), t < t' ∧ t' ≤ F l ∧ s.mem[t']? = some m' ∧ m'.loc = ⟨l, o⟩)
    (hinh : ∀ l c, Lp l → E.sto l = some c → ∀ b S us, SegOf c.ty b S → accs S = some us →
      IniSeg E' c l b → ¬ IniSeg E c l b → ∃ ws, ValOf E' S ws ∧ ws.length = nWords us)
    (hcpl : ∀ l c, Lp l → E.sto l = some c → ∀ b S, SegOf c.ty b S → accs S ≠ none → TearOK S)
    (hcT : ∀ l c, Lp l → E.sto l = some c → Ty.coupledOKIn [] c.ty = true)
    (hnT : ∀ l c, Lp l → E.sto l = some c → Ty.noOwnIn [] c.ty = true)
    (hrT : ∀ l c, Lp l → E.sto l = some c → rgnFree c.ty = true)
    (hbx : ∀ l B, E.box l = some B → E'.box l = some B) (hbe : E'.box = E.box) :
    MemInv g E' s := by
  obtain ⟨hmo, hoo, hpl, hfr, hsn, hoh, hpd, hopub, hpi, hbi, hpo⟩ := id hm
  have hsub : ∀ l c, E.sto l = some c → E'.sto l = some c := fun l c h => by rw [hs]; exact h
  have hri : ∀ l, E.rini l ≤ E'.rini l := fun l => by rw [hR]; exact Nat.le_refl _
  have hile : ∀ l', E.ini l' ≤ E'.ini l' := fun l' => by
    by_cases he : Lp l'
    · rw [hiIn l' he]; exact hN l' he
    · rw [hiNe l' he]; exact Nat.le_refl _
  have hPm : ∀ l' f, E.pfr l' = some f → E'.pfr l' = some f := fun l' f h => by
    by_cases he : Lp l'
    · rw [hnone l' he] at h; cases h
    · rw [hPne l' he]; exact h
  have hSm : ∀ l', E.seen l' → E'.seen l' := fun l' h => by rw [hS]; exact h
  have hnS : ∀ l, Lp l → ¬ E.seen l := fun l hl h => by
    obtain ⟨f, h1, -⟩ := hsn l h; rw [hnone l hl] at h1; cases h1
  have hrcl : ∀ l, Lp l → E.rc l = E.ini l := fun l hl => by
    obtain ⟨c, hsto, hown⟩ := hL l hl
    refine Nat.le_antisymm (E.rc_le_ini l) (Nat.le_of_not_lt fun hlt => ?_)
    obtain ⟨f, hf, -⟩ := hoh.2 l c hsto hown hlt
    rw [hnone l hl] at hf; cases hf
  have hrcE : ∀ l', E'.rc l' = E.rc l' := fun l' => by
    by_cases he : Lp l'
    · have h1 : E'.rini l' = E.rini l' := by rw [hR]
      have h2 := hrcl l' he
      have h3 := hrl l' he
      have h4 := hN l' he
      unfold TEnv.rc at h2 ⊢; rw [hiIn l' he, h1]; omega
    · exact TEnv.rc_congr (hiNe l' he) (by rw [hR])
  have hmono : ∀ {U : Ty} {vs : List Word}, ValOf E U vs → ValOf E' U vs :=
    fun h => ValOf_mono hp ht hsub hile h hPm hSm hbx
  have hwE : ∀ T o w, WordOK E T o w → WordOK E' T o w := fun T o w h =>
    WordOK_mono hp ht hsub hile hPm hSm h hbx
  have hiniR : ∀ c' l' o, ¬ Lp l' → InitR E' c' l' o → InitR E c' l' o := fun c' l' o he h N e us h1 h2 => by
    have := h N e us h1 h2; rw [hiNe l' he] at this; exact this
  have hIW : ∀ a : Address, IniWr E' a → IniWr E a := fun a h c1 N1 e1 us1 h1 h2 h3 => by
    have := h c1 N1 e1 us1 (by rw [hs]; exact h1) h2 h3; rw [hrcE] at this; exact this
  have hnew0 : ∀ (l' : AllocLabel) (o : Nat) (t : Nat) (m : Msg), s.mem.size ≤ t → s.mem[t]? = some m →
      m.loc = ⟨l', o⟩ → ∀ T, WordOK E' T o (mw m) := fun _ _ t m ht hm _ _ =>
    (Nat.not_le.2 (lt_of_get hm) ht).elim
  refine ⟨MemOKP_mono hmo hp ht hsub hile (fun t m c h hc => by rw [hs] at hc; exact hc) hPm hSm hbx,
    ?_, hpl, ?_, ?_, ?_, ?_, ?_, ?_, BoxInv_tr hbi hbe (fun _ _ _ h => by rw [hS] at h; exact h)
      (fun l _ _ => by rw [hs])
      (fun l' B hB => by
        by_cases he : Lp l'
        · obtain ⟨c, hsto, -⟩ := hL l' he
          have := (hbi.2.2 l' B hB).1; rw [hsto] at this; cases this
        · exact hiNe l' he)
      (Nat.le_refl _) (fun _ _ _ _ _ _ h => h) (fun _ _ _ _ _ _ h => h), hpo⟩
  · -- OwnOK: the real count is unchanged
    intro l' c' hc ho
    rw [hs] at hc
    by_cases he : Lp l'
    · obtain ⟨vals, h1, h2, -⟩ := hoo l' c' hc (by rw [ht]; exact ho)
      have h1' : CellOK E' (E'.rc l') c'.ty vals := CellOK_map hmono (Nat.le_of_eq (hrcE l')) h1
      have hS' : ∀ o v, vals[o]? = some v → LatestS s.mem (· ∈ s.promises) s.vs.coh ⟨l', o⟩ v := fun o v hv => by
        have := h2 o v hv; rw [hnone l' he] at this; exact LatestSF_none this
      exact ⟨vals, h1', fun o v hv => LatestSF_of_LatestS (hS' o v hv), fun _ => OwnPairF_of_LatestS h1' hS'⟩
    · exact OwnCellF_pub (hoo l' c' hc (by rw [ht]; exact ho)) hmono (hiNe l' he) (.inr (hPne l' he)) hmo.2.2
        (by rw [hR])
  · -- FreshL
    refine ⟨fun j hj => ?_, PrivCoh_env (s := s) hfr.2 hs ht hPm fun l' => Nat.le_of_eq (hrcE l').symm⟩

    obtain ⟨f1, f2, f4, f5⟩ := hfr.1 j hj
    have hne : ¬ Lp (freshLabel g.lbase g.n g.i j) := fun he => by
      obtain ⟨c, hsto, -⟩ := hL _ he; rw [hsto] at f1; cases f1
    exact ⟨by rw [hs]; exact f1, f2, by rw [hiNe _ hne]; exact f4, by rw [hPne _ hne]; exact f5⟩
  · -- SeenLE: the planted cells are unseen
    intro l' hl'
    rw [hS] at hl'
    obtain ⟨f, h1, h2⟩ := hsn l' hl'
    exact ⟨f, hPm l' f h1, h2⟩
  · -- OwnHid
    refine ⟨fun l' c' hc ho o hio => ?_, fun l' c' hc ho hlt => ?_⟩
    · rw [hs] at hc
      exact HiddenP_grow (hoh.1 l' c' hc (by rw [ht]; exact ho) o (fun N e us h1 h2 => by
          have := hio N e us h1 h2; rw [hrcE] at this; exact this)) (hwE _ _)
        (Nat.le_refl _) (fun _ _ => rfl) (fun t m ht' hm hl => hnew0 l' o t m ht' hm hl _)
        (fun _ _ h1 h2 => absurd h1 h2)
    · rw [hs] at hc
      by_cases he : Lp l'
      · have hown : c'.owner = some E.tid := by rw [ht]; exact ho
        rw [hrcE, hrcl l' he, hiIn l' he] at hlt
        refine ⟨F l', hPin l' he, by rw [hS]; exact fun _ => hnS l' he, fun o hio => ?_⟩
        by_cases hold : InitR E c' l' o
        · have hr : InitRr E c' l' o := fun N' e us h1 h2 => by rw [hrcl l' he]; exact hold N' e us h1 h2
          exact HiddenP_grow (hoh.1 l' c' hc hown o hr) (hwE _ _) (hFw l' he hlt) (fun _ _ => rfl)
            (fun t m ht' hm hl => hnew0 l' o t m ht' hm hl _) (fun _ _ h1 h2 => absurd h1 h2)
        · intro t m hnp hm hloc _
          exact hhold l' c' he hc o hio hold t m hnp hm hloc
      · rw [hrcE, hiNe l' he] at hlt
        obtain ⟨f, hf, hns, hH⟩ := hoh.2 l' c' hc (by rw [ht]; exact ho) hlt
        refine ⟨f, by rw [hPne _ he]; exact hf,
        by rw [hS]; exact fun hz => hns (fun hz0 => hz ((ZW.stoAt (congrFun hs l')).2 hz0)), fun o hio => ?_⟩
        exact HiddenP_grow (hH o (hiniR c' l' o he hio)) (hwE _ _)
          (Nat.le_refl _) (fun _ _ => rfl) (fun t m ht' hm hl => hnew0 l' o t m ht' hm hl _)
          (fun _ _ h1 h2 => absurd h1 h2)
  · -- PubDef: the planted cells are the thread's own
    intro l' c' f hc hown' hf o hio
    rw [hs] at hc
    by_cases he : Lp l'
    · obtain ⟨c, hsto, hown⟩ := hL l' he
      rw [hsto] at hc; cases hc
      exact (hown' (by rw [← ht]; exact hown)).elim
    · rw [hPne _ he] at hf
      exact HiddenP_grow (hpd l' c' f hc (by rw [ht]; exact hown') hf o (hiniR c' l' o he hio)) (hwE _ _)
        (Nat.le_refl _) (fun _ _ => rfl) (fun t m ht' hm hl => hnew0 l' o t m ht' hm hl _)
        (fun _ _ h1 h2 => absurd h1 h2)
  · -- OwnPubV
    intro l' c' f hc ho hf
    rw [hS]
    rw [hs] at hc
    by_cases he : Lp l'
    · rw [hPin l' he] at hf
      cases hf
      rcases hF l' he with h | h
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr (h.congrE fun a _ h' => hIW a h'))
    · rw [hPne _ he] at hf
      exact (hopub l' c' f hc (by rw [ht]; exact ho) hf).imp id
        (Or.imp id fun h => h.congrE fun a _ h' => hIW a h')
  · -- PubInv
    obtain ⟨hS0, hI0, hC0, hPP0, hLV0⟩ := hpi
    refine ⟨fun l' hl' => ?_, fun l' c' b S us hc hseg hu hini => ?_, fun l' c' f hc hf => ?_, ?_, ?_⟩
    · rw [hS] at hl'
      rcases hS0 l' hl' with ⟨c', h1, h2⟩ | ⟨h1, h2⟩
      · exact .inl ⟨c', by rw [hs]; exact h1, by rw [← ht]; exact h2⟩
      · exact .inr ⟨by rw [hs]; exact h1, by rw [hbe]; exact h2⟩
    · rw [hs] at hc
      by_cases hold : IniSeg E c' l' b
      · obtain ⟨ws, h1, h2⟩ := hI0 l' c' b S us hc hseg hu hold
        exact ⟨ws, hmono h1, h2⟩
      · by_cases he : Lp l'
        · exact hinh l' c' he hc b S us hseg hu hini hold
        · refine absurd ?_ hold
          unfold IniSeg at hini ⊢; rw [hiNe l' he] at hini; exact hini
    · rw [hs] at hc
      by_cases he : Lp l'
      · have hown : c'.owner = some E.tid := by
          obtain ⟨c, hsto, hown⟩ := hL l' he; rw [hsto] at hc; cases hc; exact hown
        obtain ⟨vals, hcell, -⟩ := hoo l' c' hc hown
        exact ⟨LayT_of_CellOK hcell, hcpl l' c' he hc, hcT l' c' he hc, hnT l' c' he hc, hrT l' c' he hc⟩
      · rw [hPne _ he] at hf; exact hC0 l' c' f hc hf
    · intro l' c' f o hc hown' hf htw t0 t1 m0 m1 hn0 hn1 hm0 hm1 hl0 hl1 hh0 hh1 hst
      rw [hs] at hc
      by_cases he : Lp l'
      · -- a planted pair lies in a predicted slot: every non-promise message there is hidden
        rw [hPin l' he] at hf; cases hf
        have hown : c'.owner = some E.tid := by
          obtain ⟨c, hsto, hown⟩ := hL l' he; rw [hsto] at hc; cases hc; exact hown
        rcases hown' with ⟨h, -⟩ | ⟨-, b, S, us, o', h2, h3, h4, h5, h6, h7⟩
        · exact (h (by rw [← ht]; exact hown)).elim
        · have hlt := TwoAt_lt h4
          have hio : InitR E' c' l' o := by rw [h5]; exact InitR_of_IniSeg h7 h2 h3 (by omega)
          have hnio : ¬ InitR E c' l' o := fun hr => h6 (by
            rw [hrcE, hrcl l' he]; rw [h5] at hr; exact IniSegN_of_InitR hr h2)
          obtain ⟨t', m', e1, e2, e3, e4⟩ := hhold l' c' he hc o hio hnio t0 m0 hn0 hm0 hl0
          have hT : WeakMem.hiddenFrom s.mem ⟨l', o⟩ t0 (F l') = true := by
            unfold WeakMem.hiddenFrom; rw [List.any_eq_true]
            exact ⟨t', List.mem_range.2 (Nat.lt_succ_of_le e2), by simp [e1, e3, e4]⟩
          rw [hh0] at hT; cases hT
      · rw [hPne _ he] at hf
        exact PairOK_mono hp ht hsub hile hPm hSm
          (hPP0 l' c' f o hc (PubG_tr ht (Nat.le_of_eq (hrcE l').symm)
            (fun h => ⟨by rw [hrcE, hiNe l' he] at h; exact h, Nat.le_of_eq (hiNe l' he)⟩)
            (fun _ => Nat.le_of_eq (hiNe l' he)) hown')
            hf htw t0 t1 m0 m1 hn0 hn1 hm0 hm1 hl0 hl1 hh0 hh1 hst) hbx
    · intro l' c' f b S us o hc hown' hf hseg hu ho
      rw [hs] at hc
      have he : ¬ Lp l' := fun he => by
        obtain ⟨c, hsto, hown⟩ := hL l' he
        rw [hsto] at hc; cases hc
        exact hown' (by rw [← ht]; exact hown)
      rw [hPne _ he] at hf
      exact hLV0 l' c' f b S us o hc (by rw [ht]; exact hown') hf hseg hu ho

#print axioms MemInv_plantSet

/-- (U3, transitive) **The simultaneous plant at held prefixes**: each member
`l` gets the count `max ini (k l)` and the frontier `plantF E s l`
(`plant_holdF` per member); left: the held prefixes, the buffer bounds and
`hinh` at the final environment. -/
theorem MemInv_plantSetK {g : G} {E E' : TEnv} {s : St} {Lp : AllocLabel → Prop} {k : AllocLabel → Nat}
    (hm : MemInv g E s) (hL : ∀ l, Lp l → ∃ c, E.sto l = some c ∧ c.owner = some E.tid)
    (hnone : ∀ l, Lp l → E.pfr l = none)
    (hp : E.prog = E'.prog) (ht : E.tid = E'.tid) (hs : E'.sto = E.sto)
    (hiIn : ∀ l, Lp l → E'.ini l = max (E.ini l) (k l)) (hiNe : ∀ l, ¬ Lp l → E'.ini l = E.ini l)
    (hrle : ∀ l, E.rini l ≤ E.ini l)
    (hPin : ∀ l, Lp l → E'.pfr l = some (plantF E s l)) (hPne : ∀ l, ¬ Lp l → E'.pfr l = E.pfr l)
    (hS : E'.seen = E.seen) (hR : E'.rini = E.rini) (hpa : PromAbove s)
    (hNa : ∀ l c, Lp l → E.sto l = some c → ∀ Na e us, c.ty = .array (.lit Na) e → accs e = some us →
      E.ini l ≤ Na ∧ k l ≤ Na)
    (hk : ∀ l c, Lp l → E.sto l = some c → PrefixHeld E s l c (k l))
    (hinh : ∀ l c, Lp l → E.sto l = some c → ∀ b S us, SegOf c.ty b S → accs S = some us →
      IniSeg E' c l b → ¬ IniSeg E c l b → ∃ ws, ValOf E' S ws ∧ ws.length = nWords us)
    (hcpl : ∀ l c, Lp l → E.sto l = some c → ∀ b S, SegOf c.ty b S → accs S ≠ none → TearOK S)
    (hcT : ∀ l c, Lp l → E.sto l = some c → Ty.coupledOKIn [] c.ty = true)
    (hnT : ∀ l c, Lp l → E.sto l = some c → Ty.noOwnIn [] c.ty = true)
    (hrT : ∀ l c, Lp l → E.sto l = some c → rgnFree c.ty = true)
    (hbx : ∀ l B, E.box l = some B → E'.box l = some B) (hbe : E'.box = E.box) :
    MemInv g E' s ∧ ∀ l, Lp l → s.vs.vWr ≤ plantF E s l ∧ plantF E s l ≤ max s.vs.vWr s.mem.size := by
  have hH : ∀ l c, Lp l → E.sto l = some c → c.owner = some E.tid := fun l c hl hc => by
    obtain ⟨c0, h1, h2⟩ := hL l hl; rw [h1] at hc; cases hc; exact h2
  have hF := fun l c (hl : Lp l) (hc : E.sto l = some c) =>
    plant_holdF (E' := E') hm hc (hH l c hl hc) (hnone l hl) hpa
      (fun Na e us hT hus => by rw [hiIn l hl]; exact Nat.max_le.2 (hNa l c hl hc Na e us hT hus))
      (held_of_prefix (hk l c hl hc) (hiIn l hl))
  refine ⟨MemInv_plantSet hm hL hnone hp ht hs hiIn hiNe (fun l _ => Nat.le_max_left _ _)
    (fun l _ => hrle l) hPin hPne hS hR
    (fun l hl => by obtain ⟨c, hc, -⟩ := hL l hl; exact (hF l c hl hc).2.2.1)
    (fun l hl _ => by obtain ⟨c, hc, -⟩ := hL l hl; exact (hF l c hl hc).1)
    (fun l c hl hc => (hF l c hl hc).2.2.2) hinh hcpl hcT hnT hrT hbx hbe, fun l hl => ?_⟩
  obtain ⟨c, hc, -⟩ := hL l hl
  exact ⟨(hF l c hl hc).1, (hF l c hl hc).2.1⟩

#print axioms MemInv_plantSetK

/-- (U3, transitive) **The plant closure** from `x` along `R` (`R l a`: a
held prefix unit of `l` names the own private cell `a`): the least label set
containing `x` and closed under `R`.  An inductive predicate: no finiteness
is needed, the plant is simultaneous (`MemInv_plantSet`). -/
inductive ClR (R : AllocLabel → AllocLabel → Prop) (x : AllocLabel) : AllocLabel → Prop
  | base : ClR R x x
  | step {l a : AllocLabel} : ClR R x l → R l a → ClR R x a

/-- (U3, transitive) A property of `x` carried along every `R` edge holds on
the closure. -/
theorem ClR_of {R : AllocLabel → AllocLabel → Prop} {x : AllocLabel} {Q : AllocLabel → Prop}
    (hx : Q x) (hR : ∀ l a, Q l → R l a → Q a) : ∀ a, ClR R x a → Q a := by
  intro a h
  induction h with
  | base => exact hx
  | step _ hr ih => exact hR _ _ ih hr

/-- (U3, transitive) The closure is closed under `R`. -/
theorem ClR_closed {R : AllocLabel → AllocLabel → Prop} {x l a : AllocLabel}
    (hl : ClR R x l) (hr : R l a) : ClR R x a := .step hl hr

/-- (U3, transitive) A buffer cell's slot count (`0` for any other cell). -/
def slotCnt (c : Cell) : Nat :=
  match c.ty with
  | .array (.lit Na) _ => Na
  | _ => 0

theorem slotCnt_arr {c : Cell} {Na : Nat} {e : Ty} (h : c.ty = .array (.lit Na) e) : slotCnt c = Na := by
  unfold slotCnt; rw [h]

/-- (U3, transitive) **The maximal held prefix** of `l`: the largest
`n ≤ slotCnt` with `PrefixHeld E s l c n` (`0` if no cell). -/
noncomputable def Np (E : TEnv) (s : St) (l : AllocLabel) : Nat :=
  match E.sto l with
  | some c => ((List.range (slotCnt c + 1)).filter fun n =>
      @decide (PrefixHeld E s l c n) (Classical.propDecidable _)).foldr max 0
  | none => 0

theorem Np_of {E : TEnv} {s : St} {l : AllocLabel} {c : Cell} (hc : E.sto l = some c) :
    Np E s l = ((List.range (slotCnt c + 1)).filter fun n =>
      @decide (PrefixHeld E s l c n) (Classical.propDecidable _)).foldr max 0 := by
  unfold Np; rw [hc]

theorem PrefixHeld_zero {E : TEnv} {s : St} {l : AllocLabel} {c : Cell} : PrefixHeld E s l c 0 :=
  fun _ _ _ _ _ o ho => absurd ho (by rw [Nat.zero_mul]; exact Nat.not_lt_zero _)

/-- (U3, transitive) The maximal held prefix is held. -/
theorem PrefixHeld_Np {E : TEnv} {s : St} {l : AllocLabel} {c : Cell} (hc : E.sto l = some c) :
    PrefixHeld E s l c (Np E s l) := by
  classical
  rw [Np_of hc]
  rcases foldr_max_mem ((List.range (slotCnt c + 1)).filter fun n =>
      @decide (PrefixHeld E s l c n) (Classical.propDecidable _)) with h | h
  · rw [h]; exact PrefixHeld_zero
  · exact of_decide_eq_true (List.mem_filter.1 h).2

/-- (U3, transitive) Every held prefix within the buffer is at most the
maximal one. -/
theorem le_Np {E : TEnv} {s : St} {l : AllocLabel} {c : Cell} {Na k : Nat} {e : Ty}
    (hc : E.sto l = some c) (hT : c.ty = .array (.lit Na) e) (hk : k ≤ Na) (hp : PrefixHeld E s l c k) :
    k ≤ Np E s l := by
  classical
  rw [Np_of hc]
  refine le_foldr_max (List.mem_filter.2 ⟨List.mem_range.2 ?_, decide_eq_true hp⟩)
  rw [slotCnt_arr hT]; omega

/-- (U3, transitive) The maximal held prefix is within the buffer. -/
theorem Np_le {E : TEnv} {s : St} {l : AllocLabel} {c : Cell} {Na : Nat} {e : Ty}
    (hc : E.sto l = some c) (hT : c.ty = .array (.lit Na) e) : Np E s l ≤ Na := by
  classical
  rw [Np_of hc]
  rcases foldr_max_mem ((List.range (slotCnt c + 1)).filter fun n =>
      @decide (PrefixHeld E s l c n) (Classical.propDecidable _)) with h | h
  · rw [h]; exact Nat.zero_le _
  · have := List.mem_range.1 (List.mem_filter.1 h).1
    rw [slotCnt_arr hT] at this; rw [slotCnt_arr hT]; omega

/-- (Z-alt (a)) A zero-width element type is **inhabited**: it has a
value (of no words) in the bare environment of the program, hence (`ValOf_transferS`)
in every environment of the program. -/
def InhZ (P : Prog) (e : Ty) : Prop := ∃ ws, ValOf ({ prog := P } : TEnv) e ws ∧ ws.length = 0

/-- (Z-alt (a)) `l` is a buffer of uninhabited zero-width elements (e.g. `void`): no slot
of it can ever be initialised, so the plant does not raise its count. -/
def EmptyZ (E : TEnv) (l : AllocLabel) : Prop :=
  ∃ c N e us, E.sto l = some c ∧ c.ty = .array (.lit N) e ∧ accs e = some us ∧ nWords us = 0 ∧
    ¬ InhZ E.prog e

/-- (Z-alt (a)) **The planted count**: the maximal held prefix `Np`, except `0` (no
raise) at a buffer of uninhabited zero-width elements, where `PrefixHeld` is vacuous
and `Np` would be the slot count. -/
noncomputable def NpZ (E : TEnv) (s : St) (l : AllocLabel) : Nat :=
  @ite _ (EmptyZ E l) (Classical.propDecidable _) 0 (Np E s l)

theorem NpZ_of_not {E : TEnv} {s : St} {l : AllocLabel} (h : ¬ EmptyZ E l) : NpZ E s l = Np E s l := by
  show @ite _ (EmptyZ E l) (Classical.propDecidable _) _ _ = _; simp [h]

theorem NpZ_of_empty {E : TEnv} {s : St} {l : AllocLabel} (h : EmptyZ E l) : NpZ E s l = 0 := by
  show @ite _ (EmptyZ E l) (Classical.propDecidable _) _ _ = _; simp [h]

/-- (Z-alt (a)) The planted count is held. -/
theorem PrefixHeld_NpZ {E : TEnv} {s : St} {l : AllocLabel} {c : Cell} (hc : E.sto l = some c) :
    PrefixHeld E s l c (NpZ E s l) := by
  by_cases h : EmptyZ E l
  · rw [NpZ_of_empty h]; exact PrefixHeld_zero
  · rw [NpZ_of_not h]; exact PrefixHeld_Np hc

/-- (Z-alt (a)) The planted count is within the buffer. -/
theorem NpZ_le {E : TEnv} {s : St} {l : AllocLabel} {c : Cell} {Na : Nat} {e : Ty}
    (hc : E.sto l = some c) (hT : c.ty = .array (.lit Na) e) : NpZ E s l ≤ Na := by
  by_cases h : EmptyZ E l
  · rw [NpZ_of_empty h]; exact Nat.zero_le _
  · rw [NpZ_of_not h]; exact Np_le hc hT

/-- (Z-alt (a)) Away from zero-width elements the planted count is `Np`. -/
theorem NpZ_eq_of_pos {E : TEnv} {s : St} {l : AllocLabel} {c : Cell} {Na : Nat} {e : Ty} {us : List Acc}
    (hc : E.sto l = some c) (hT : c.ty = .array (.lit Na) e) (hus : accs e = some us) (hpos : nWords us ≠ 0) :
    NpZ E s l = Np E s l := by
  refine NpZ_of_not fun ⟨c2, N2, e2, us2, hc2, hT2, hus2, h0, _⟩ => hpos ?_
  rw [hc] at hc2; cases hc2
  rw [hT] at hT2; simp only [Ty.array.injEq, Idx.lit.injEq] at hT2; obtain ⟨-, rfl⟩ := hT2
  rw [hus] at hus2; cases hus2; exact h0

/-- (U3, transitive) **The simultaneous plant's environment** over `Lp`:
counts raised to the maximal held prefix, frontiers planted at `plantF`. -/
noncomputable def plantE (E : TEnv) (s : St) (Lp : AllocLabel → Prop) : TEnv :=
  { E with
    ini := fun l => @ite _ (Lp l) (Classical.propDecidable _) (max (E.ini l) (NpZ E s l)) (E.ini l),
    pfr := fun l => @ite _ (Lp l) (Classical.propDecidable _) (some (plantF E s l)) (E.pfr l) }

theorem plantE_ini_in {E : TEnv} {s : St} {Lp : AllocLabel → Prop} {l : AllocLabel} (h : Lp l) :
    (plantE E s Lp).ini l = max (E.ini l) (NpZ E s l) := by
  show @ite _ (Lp l) (Classical.propDecidable _) _ _ = _; simp [h]

theorem plantE_ini_ne {E : TEnv} {s : St} {Lp : AllocLabel → Prop} {l : AllocLabel} (h : ¬ Lp l) :
    (plantE E s Lp).ini l = E.ini l := by
  show @ite _ (Lp l) (Classical.propDecidable _) _ _ = _; simp [h]

theorem plantE_pfr_in {E : TEnv} {s : St} {Lp : AllocLabel → Prop} {l : AllocLabel} (h : Lp l) :
    (plantE E s Lp).pfr l = some (plantF E s l) := by
  show @ite _ (Lp l) (Classical.propDecidable _) _ _ = _; simp [h]

theorem plantE_pfr_ne {E : TEnv} {s : St} {Lp : AllocLabel → Prop} {l : AllocLabel} (h : ¬ Lp l) :
    (plantE E s Lp).pfr l = E.pfr l := by
  show @ite _ (Lp l) (Classical.propDecidable _) _ _ = _; simp [h]

/-- (U3, transitive) **`MemInv` after the simultaneous plant** at the maximal
held prefixes: left, the members' cell facts and `hinh` at the planted
environment. -/
theorem MemInv_plantE {g : G} {E : TEnv} {s : St} {Lp : AllocLabel → Prop}
    (hm : MemInv g E s) (hL : ∀ l, Lp l → ∃ c, E.sto l = some c ∧ c.owner = some E.tid)
    (hnone : ∀ l, Lp l → E.pfr l = none) (hrle : ∀ l, E.rini l ≤ E.ini l) (hpa : PromAbove s)
    (hNa : ∀ l c, Lp l → E.sto l = some c → ∀ Na e us, c.ty = .array (.lit Na) e → accs e = some us →
      E.ini l ≤ Na)
    (hinh : ∀ l c, Lp l → E.sto l = some c → ∀ b S us, SegOf c.ty b S → accs S = some us →
      IniSeg (plantE E s Lp) c l b → ¬ IniSeg E c l b → ∃ ws, ValOf (plantE E s Lp) S ws ∧ ws.length = nWords us)
    (hcpl : ∀ l c, Lp l → E.sto l = some c → ∀ b S, SegOf c.ty b S → accs S ≠ none → TearOK S)
    (hcT : ∀ l c, Lp l → E.sto l = some c → Ty.coupledOKIn [] c.ty = true)
    (hnT : ∀ l c, Lp l → E.sto l = some c → Ty.noOwnIn [] c.ty = true)
    (hrT : ∀ l c, Lp l → E.sto l = some c → rgnFree c.ty = true) :
    MemInv g (plantE E s Lp) s ∧ ∀ l, Lp l → s.vs.vWr ≤ plantF E s l ∧ plantF E s l ≤ max s.vs.vWr s.mem.size :=
  MemInv_plantSetK (k := NpZ E s) hm hL hnone rfl rfl rfl (fun _ h => plantE_ini_in h) (fun _ h => plantE_ini_ne h)
    hrle (fun _ h => plantE_pfr_in h) (fun _ h => plantE_pfr_ne h) rfl rfl hpa
    (fun l c hl hc Na e us hT hus => ⟨hNa l c hl hc Na e us hT hus, NpZ_le hc hT⟩)
    (fun _ _ _ hc => PrefixHeld_NpZ hc) hinh hcpl hcT hnT hrT (fun _ _ h => h) rfl

/-- Every holder of `l` is at most `plantT` (the largest), hence `plantF`. -/
theorem HoldW_le_plantT {E : TEnv} {s : St} {l : AllocLabel} {u : Nat} (h : HoldW E s l u) :
    u ≤ plantT E s l := by
  classical
  obtain ⟨t, ht, m, hm, hl, hut, hmin, hni⟩ := h
  have hH : HoldW E s l t := ⟨t, ht, m, hm, hl, Nat.le_refl _, hmin, hni⟩
  have hmem : t ∈ s.promises.filter fun u => @decide (HoldW E s l u) (Classical.propDecidable _) := by
    simp only [List.mem_filter]; exact ⟨ht, by simp [hH]⟩
  have key : ∀ (L : List Nat), t ∈ L → t ≤ L.foldr max 0 := by
    intro L
    induction L with
    | nil => intro h; cases h
    | cons x L ih =>
      intro h
      simp only [List.foldr_cons]
      rcases List.mem_cons.1 h with e | e
      · subst e; exact Nat.le_max_left _ _
      · exact Nat.le_trans (ih e) (Nat.le_max_right _ _)
  exact Nat.le_trans hut (key _ hmem)

theorem HoldW_le_plantF {E : TEnv} {s : St} {l : AllocLabel} {u : Nat} (h : HoldW E s l u) :
    u ≤ plantF E s l :=
  Nat.le_trans (HoldW_le_plantT h) (Nat.le_max_right _ _)

/-- (ZwIni) At an inhabited zero-width buffer the planted count is the slot count. -/
theorem NpZ_zwS {E : TEnv} {s : St} {l : AllocLabel} {c : Cell} {N : Nat} {e : Ty} {us : List Acc}
    (hc : E.sto l = some c) (hT : c.ty = .array (.lit N) e) (hus : accs e = some us) (h0 : nWords us = 0)
    (hinh : InhZ E.prog e) : NpZ E s l = N := by
  have hne : ¬ EmptyZ E l := by
    rintro ⟨c', N', e', us', hc', hT', hus', -, hni⟩
    rw [hc] at hc'; cases hc'; rw [hT] at hT'; cases hT'
    exact hni hinh
  rw [NpZ_of_not hne]
  have hp : PrefixHeld E s l c N := fun N' e' us' hT' hus' o ho => by
    rw [hT] at hT'; cases hT'; rw [hus] at hus'; cases hus'; rw [h0, Nat.mul_zero] at ho
    exact absurd ho (Nat.not_lt_zero _)
  have h1 := le_Np hc hT (Nat.le_refl _) hp
  have h2 := Np_le (s := s) hc hT
  omega

/-- (U3, transitive) **The simultaneous plant's footprint** at `plantE`. -/
theorem EFoot_plantE {W : Ty → Prop} {g : G} {E : TEnv} {s s' : St} {Lp : AllocLabel → Prop}
    (hown : ∀ l, Lp l → OwnAt E l) (hnone : ∀ l, Lp l → E.pfr l = none)
    (hF : ∀ l, Lp l → s.vs.vWr ≤ plantF E s l ∧ plantF E s l ≤ max s.vs.vWr s.mem.size)
    (hFv : ∀ l, Lp l → s'.vs.vWr ≤ plantF E s l)
    (hFlt : ∀ l, Lp l → plantF E s l ≤ s.vs.vWr ∨ plantF E s l < s.mem.size)
    (hIL : ∀ l, Lp l → NpZ E s l ≤ max (E.ini l) (E.rini l))
    (hgp : ∀ l, Lp l → g.pf l := by first | exact fun _ _ => trivial | assumption) :
    EFootB W g E (plantE E s Lp) s s' := by
  have hini : ∀ l, E.ini l ≤ (plantE E s Lp).ini l ∧ ((plantE E s Lp).ini l = E.ini l ∨ Lp l) := fun l => by
    by_cases hl : Lp l
    · rw [plantE_ini_in hl]; exact ⟨Nat.le_max_left _ _, .inr hl⟩
    · rw [plantE_ini_ne hl]; exact ⟨Nat.le_refl _, .inl rfl⟩
  exact EFoot_plantSet rfl rfl rfl rfl hown hnone (fun _ h => plantE_pfr_in h) (fun _ h => plantE_pfr_ne h)
    (fun l h => (hF l h).1) (fun l h => (hF l h).2) hFv hFlt (fun _ _ _ hu => HoldW_le_plantF hu)
    (fun l hl _ cl N e us hc hT hus h0 hinh => by
      rw [plantE_ini_in hl, NpZ_zwS (E := E) (s := s) hc hT hus h0 hinh]; exact Nat.le_max_right _ _) hini
    (fun l hl => by rw [plantE_ini_in hl]; exact Nat.max_le.2 ⟨Nat.le_max_left _ _, hIL l hl⟩) rfl rfl
    (fun _ => Nat.le_refl _)
    (fun h l => Nat.le_trans (h l) (hini l).1) (RiniW_of_eq rfl)

