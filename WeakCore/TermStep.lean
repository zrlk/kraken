/-- A one-word store at `A`, at the per-address reading `PromAt`: the new latest word is (above)
the stored word or is the old one, and in the old case nothing at `A` is newly visible. -/
theorem stepStore_NPsameS {E : TEnv} {k : Promises.Knobs} {arch : Arch} {s : St} {mem' : Memory}
    {th0 th : Promises.Thread} {A : Address} {w : Word} {deps : List WeakMem.Reg} {rel : Bool} {V : Ts}
    {x : Word} (h : (mem', th) ∈ Promises.stepStore k arch s.mem th0 A (dataE 1 w) deps rel)
    (hr : th0.regs 1 = w) (hp0 : th0.promises = s.promises) (hV : V ≤ th0.vs.vRelSt)
    (hP : ∀ t, t ∈ s.promises → t < s.mem.size) (hF : ∀ t, t ∈ E.fp → t < s.mem.size)
    (hx : LatestNP s.mem (PromAt E s A) A x) :
    ∃ (b : Bool) (x0 : Word), WLe1 (if b then bumpW V w else x) x0 ∧
      LatestNP mem' (PromAt E { s with mem := mem', vs := th.vs, promises := th.promises } A) A x0 ∧
      (b = false → NoNewVis E s { s with mem := mem', vs := th.vs, promises := th.promises } A) := by
  have hw : WLe1 (bumpW V w) ⟨w.val, Promises.storeMview th0 (dataE 1 w) deps rel, 0⟩ :=
    WLe1_msgB (WLe1_refl _) (storeMview_dataE th0 1 w hr deps rel)
      (Nat.le_trans hV (storeMview_relSt th0 _ deps rel))
  rcases stepStore_casesE h with ⟨hmem, hpr⟩ | ⟨t, m, hmem, -, hpr, hm, hloc, hval, hmv⟩
  · subst hmem
    refine ⟨true, _, ?_, LatestNP_push_top _ (fun t ht => (PromAt_sub ht).elim
      (fun h => hP t (by rw [← hp0, ← hpr]; exact h)) (hF t)), fun e => by cases e⟩
    show WLe1 (bumpW V w) ⟨exprVal th0 (dataE 1 w), Promises.storeMview th0 (dataE 1 w) deps rel, 0⟩
    rw [exprVal_dataE th0 1 w hr]; exact hw
  · subst hmem
    obtain ⟨k1, k2⟩ := promAt_erase (E := E) (A := A) (s := s)
      (s1 := { s with mem := s.mem, vs := th.vs, promises := th.promises }) rfl
      (by show th.promises = _; rw [hpr, hp0])
    rcases latestNP_subEraseS hx hm hloc k1 k2 with ⟨h1, hn⟩ | h1
    · exact ⟨false, x, WLe1_refl _, h1, fun _ => hn⟩
    · refine ⟨true, mw m, WLe1_trans hw ⟨?_, fun _ _ _ => hmv⟩, h1, fun e => by cases e⟩
      show w.val = m.val
      rw [hval, exprVal_dataE th0 1 w hr]

/-- `stepStore_NPsameS`, with: a fulfilment at a visible word unit keeps the old word. -/
theorem stepStore_NPsameWF {E : TEnv} {k : Promises.Knobs} {arch : Arch} {s : St} {mem' : Memory}
    {th0 th : Promises.Thread} {A : Address} {w : Word} {deps : List WeakMem.Reg} {rel : Bool} {V : Ts}
    {x : Word} (h : (mem', th) ∈ Promises.stepStore k arch s.mem th0 A (dataE 1 w) deps rel)
    (hr : th0.regs 1 = w) (hp0 : th0.promises = s.promises) (hV : V ≤ th0.vs.vRelSt)
    (hP : ∀ t, t ∈ s.promises → t < s.mem.size) (hF : ∀ t, t ∈ E.fp → t < s.mem.size)
    (hx : LatestNP s.mem (PromAt E s A) A x) :
    ∃ (b : Bool) (x0 : Word), WLe1 (if b then bumpW V w else x) x0 ∧
      LatestNP mem' (PromAt E { s with mem := mem', vs := th.vs, promises := th.promises } A) A x0 ∧
      (b = false → NoNewVis E s { s with mem := mem', vs := th.vs, promises := th.promises } A) ∧
      (VisU E A → th.promises ≠ s.promises → b = false) := by
  by_cases hc : VisU E A ∧ th.promises ≠ s.promises
  · obtain ⟨hW, hne⟩ := hc
    rcases stepStore_casesE h with ⟨-, hpr⟩ | ⟨t, m, hmem, -, -⟩
    · exact absurd (by rw [hpr, hp0]) hne
    · subst hmem
      refine ⟨false, x, WLe1_refl _, ?_, fun _ => ?_, fun _ _ => rfl⟩
      · rw [PromAt_word hW] at hx ⊢; exact hx
      · intro tw hpre t' m' hlt hm' hl'
        exfalso
        have := hpre t' m' hlt hm' hl'
        rw [PromAt_word hW] at this; simp at this
  · obtain ⟨b, x0, h1, h2, h3⟩ := stepStore_NPsameS (E := E) h hr hp0 hV hP hF hx
    exact ⟨b, x0, h1, h2, h3, fun hW hne => absurd ⟨hW, hne⟩ hc⟩

theorem inAcc_cons_ge {u : Acc} {us : List Acc} {n o : Nat} (h : InAcc (u :: us) n o) (ho : u.size ≤ o) :
    ∃ n1, n = n1 + 1 ∧ InAcc us n1 (o - u.size) := by
  obtain ⟨h1, h2⟩ := h
  cases n with
  | zero => simp [nWords] at h2; omega
  | succ n1 =>
    have e1 : nWords ((u :: us).take (n1 + 1)) = u.size + nWords (us.take n1) := by simp [nWords]
    have e2 : nWords ((u :: us).take (n1 + 1 + 1)) = u.size + nWords (us.take (n1 + 1)) := by simp [nWords]
    rw [e1] at h1; rw [e2] at h2
    exact ⟨n1, rfl, by omega, by omega⟩

theorem inAcc_cons_lt {u : Acc} {us : List Acc} {n o : Nat} (h : InAcc (u :: us) n o) (ho : o < u.size) :
    n = 0 := by
  obtain ⟨h1, -⟩ := h
  cases n with
  | zero => rfl
  | succ n1 =>
    have e1 : nWords ((u :: us).take (n1 + 1)) = u.size + nWords (us.take n1) := by simp [nWords]
    rw [e1] at h1; omega

/-- `storeUnits_NPmixN` with the fulfilled visible units: there the selection keeps the old words
(`sel n = false`), so the mix's complement holds the stored ones. -/
theorem storeUnits_NPmixNF {E : TEnv} {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s s' : St) (V : Ts) (old : List Word),
      s' ∈ storeUnits k arch pw a rel us ws i s → V ≤ s.vs.vRelSt → (∀ t, t ∈ s.promises → t < s.mem.size) →
      (∀ t, t ∈ E.fp → t < s.mem.size) → old.length = nWords us →
      (∀ j x, old[j]? = some x → LatestNP s.mem (PromAt E s (offs a (i + j))) (offs a (i + j)) x) →
      ∃ (sel : Nat → Bool) (vals : List Word), WLe (TermTear.mixU us sel (ws.map (bumpW V)) old) vals ∧
        (∀ j x, vals[j]? = some x → LatestNP s'.mem (PromAt E s' (offs a (i + j))) (offs a (i + j)) x) ∧
        (∀ n, n < us.length → sel n = false → us[n]? = some .one ∧
          NoNewVis E s s' (offs a (i + nWords (us.take n)))) ∧
        (∀ t m j, t ∈ s.promises → t ∉ s'.promises → s.mem[t]? = some m → m.loc = offs a (i + j) → VisU E m.loc →
          (TermTear.mixU us sel old (ws.map (bumpW V)))[j]? = (ws.map (bumpW V))[j]?) ∧
        (∀ t m j n, t ∈ s.promises → t ∉ s'.promises → s.mem[t]? = some m → m.loc = offs a (i + j) →
          VisU E m.loc → InAcc us n j → sel n = false)
  | [], _, _, s, s', V, old, hs, _, _, _, hl, _ => by
      simp only [storeUnits, List.mem_singleton] at hs; subst hs
      obtain rfl : old = [] := List.eq_nil_of_length_eq_zero (by simpa [nWords] using hl)
      exact ⟨fun _ => true, [], trivial, fun j x h => by simp at h, fun n hn => by simp at hn,
        fun t _ _ ht hn => absurd ht hn, fun t _ _ _ ht hn => absurd ht hn⟩
  | .one :: us, w :: ws, i, s, s', V, old, hs, hV, hP, hF, hl, hold => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      obtain ⟨o0, old', rfl⟩ : ∃ o0 old', old = o0 :: old' := by
        cases old with
        | nil => rw [TermMem.nWords_one] at hl; simp at hl
        | cons o0 old' => exact ⟨o0, old', rfl⟩
      rw [TermMem.nWords_one] at hl
      simp only [List.length_cons, Nat.add_right_cancel_iff] at hl
      obtain ⟨-, -, -, hrs⟩ := stepStore_cases hst
      have hpsub := stepStore_promSub hst
      have hsz : s.mem.size ≤ mem'.size := by
        rcases stepStore_casesE hst with ⟨hmem, -⟩ | ⟨_, _, hmem, -⟩
        · rw [hmem, Array.size_push]; exact Nat.le_succ _
        · rw [hmem]; exact Nat.le_refl _
      have hne : ∀ j, offs a (i + 1 + j) ≠ offs a i := fun j e => by
        have := congrArg WeakMem.Address.offset e; simp [offs] at this; omega
      have hx0 := hold 0 o0 rfl
      simp only [Nat.add_zero] at hx0
      obtain ⟨b, x0, hb, h0, hnv, hbf⟩ := stepStore_NPsameWF (E := E) (V := V) hst (by simp [mth, regsOf]) rfl hV hP hF hx0
      have hP1 : PromLt { s with mem := mem', vs := th.vs, promises := th.promises } :=
        fun t ht => Nat.lt_of_lt_of_le (hP t (hpsub t ht)) hsz
      have hmt : ∀ t, t < s.mem.size → mem'[t]? = s.mem[t]? := fun t h => by
        rcases stepStore_casesE hst with ⟨hmem, -⟩ | ⟨_, _, hmem, -⟩
        · rw [hmem]; exact push_get h
        · rw [hmem]
      obtain ⟨sel', vals', hW', hL', hS', hC', hB'⟩ := storeUnits_NPmixNF us ws (i + 1)
        { s with mem := mem', vs := th.vs, promises := th.promises } s' V old' hs
        (by show V ≤ th.vs.vRelSt; rw [hrs]; exact hV)
        (fun t ht => Nat.lt_of_lt_of_le (hP t (hpsub t ht)) hsz) (fun t ht => Nat.lt_of_lt_of_le (hF t ht) hsz) hl
        (fun j x hj => PromAt_lat (s := s) (fun F h => stepStore_NPkeepF hst (hne j) h)
          (fun h => stepStore_NPkeep0 hst (hne j) h) (fun _ => stepStore_AtSame hst (hne j)) (by
          have := hold (j + 1) x (by simpa using hj)
          rwa [show i + (j + 1) = i + 1 + j by omega] at this))
      have hA0 := storeUnits_atSame us ws (i + 1) _ s' hs (offs a i) (fun j _ e => hne j e.symm)
      have h0' := PromAt_atSame (E := E) hA0 h0
      have hloc1 : ∀ t m j, t ∈ s.promises → t ∉ s'.promises → s.mem[t]? = some m → m.loc = offs a (i + j) →
          (t ∈ th.promises ∧ ∃ j1, j = j1 + 1 ∧
            { s with mem := mem', vs := th.vs, promises := th.promises }.mem[t]? = some m ∧
            m.loc = offs a (i + 1 + j1)) ∨ (t ∉ th.promises ∧ j = 0 ∧ th.promises ≠ s.promises) := by
        intro t m j ht hn hm hl
        by_cases htp : t ∈ th.promises
        · obtain ⟨-, -, hful⟩ := storeUnits_promF us ws (i + 1)
            { s with mem := mem', vs := th.vs, promises := th.promises } s' hP1 hs
          obtain ⟨m1, j1, w1, hm1, -, -, hl1, -⟩ := hful t htp hn
          have hm1' : mem'[t]? = some m := by rw [hmt t (hP t ht)]; exact hm
          have e : m1 = m := by
            have h2 : mem'[t]? = some m1 := hm1
            rw [hm1'] at h2; cases h2; rfl
          subst e
          refine Or.inl ⟨htp, j1, ?_, hm1, hl1⟩
          rw [hl1] at hl; have := congrArg WeakMem.Address.offset hl; simp [offs] at this; omega
        · refine Or.inr ⟨htp, ?_, fun e => htp (by rw [e]; exact ht)⟩
          rcases stepStore_casesE hst with ⟨-, hpr⟩ | ⟨t0, m0, -, -, hpr, hm0, hl0, -⟩
          · exact absurd (by rw [hpr]; exact ht) htp
          · have e : t = t0 := Classical.byContradiction fun hne =>
              htp (by rw [hpr]; exact (List.mem_erase_of_ne hne).2 ht)
            subst e
            rw [hm0] at hm; cases hm
            rw [hl0] at hl; have := congrArg WeakMem.Address.offset hl; simp [offs] at this; omega
      refine ⟨fun n => match n with | 0 => b | n + 1 => sel' n, x0 :: vals', ?_, fun j x hj => ?_, fun n hn hsel => ?_,
        fun t m j ht hn hm hl hvis => ?_, fun t m j n ht hn hm hl hvis hI => ?_⟩
      · show WLe ((if b then [bumpW V w] else [o0]) ++ TermTear.mixU us sel' (ws.map (bumpW V)) old') (x0 :: vals')
        cases b
        · exact ⟨hb, hW'⟩
        · exact ⟨hb, hW'⟩
      · cases j with
        | zero => simp only [List.getElem?_cons_zero, Option.some.injEq] at hj; subst hj; simpa using h0'
        | succ j =>
            have := hL' j x (by simpa using hj)
            rwa [show i + 1 + j = i + (j + 1) by omega] at this
      · cases n with
        | zero =>
            have e : offs a (i + nWords ((Acc.one :: us).take 0)) = offs a i := by simp [nWords]
            rw [e]
            exact ⟨rfl, (hnv hsel).trans (noNewVis_atSame hA0)⟩
        | succ n =>
            have hn' : n < us.length := by simp at hn; omega
            have e : offs a (i + nWords ((Acc.one :: us).take (n + 1))) = offs a (i + 1 + nWords (us.take n)) := by
              rw [List.take_succ_cons, TermMem.nWords_one]; congr 1; omega
            rw [e]
            obtain ⟨hu1, hS1⟩ := hS' n hn' hsel
            exact ⟨by simpa using hu1, (noNewVis_atSame (s' := { s with mem := mem', vs := th.vs, promises := th.promises })
              (stepStore_AtSame hst (hne _))).trans hS1⟩
      · rcases hloc1 t m j ht hn hm hl with ⟨htp, j1, rfl, hm1, hl1⟩ | ⟨-, rfl, hne0⟩
        · have := hC' t m j1 htp hn hm1 hl1 hvis
          show ((if b then [o0] else [bumpW V w]) ++ TermTear.mixU us sel' old' (ws.map (bumpW V)))[j1 + 1]? = _
          cases b <;> simpa using this
        · have hl0 : m.loc = offs a i := by rw [hl, Nat.add_zero]
          have hb0 : b = false := hbf (by rw [hl0] at hvis; exact hvis) hne0
          subst hb0
          show ([bumpW V w] ++ TermTear.mixU us sel' old' (ws.map (bumpW V)))[0]? = _
          simp
      · rcases hloc1 t m j ht hn hm hl with ⟨htp, j1, rfl, hm1, hl1⟩ | ⟨-, rfl, hne0⟩
        · obtain ⟨n1, rfl, hI1⟩ := inAcc_cons_ge hI (by simp [Acc.size])
          show sel' n1 = false
          exact hB' t m j1 n1 htp hn hm1 hl1 hvis (by simpa [Acc.size] using hI1)
        · obtain rfl := inAcc_cons_lt hI (by simp [Acc.size])
          have hl0 : m.loc = offs a i := by rw [hl, Nat.add_zero]
          exact hbf (by rw [hl0] at hvis; exact hvis) hne0
  | .two :: us, w0 :: w1 :: ws, i, s, s', V, old, hs, hV, hP, hF, hl, hold => by
      simp only [storeUnits] at hs
      obtain ⟨o0, o1, old', rfl⟩ : ∃ o0 o1 old', old = o0 :: o1 :: old' := by
        match old, hl with
        | o0 :: o1 :: old', _ => exact ⟨o0, o1, old', rfl⟩
        | [], hl => rw [TermMem.nWords_two] at hl; simp at hl
        | [_], hl => rw [TermMem.nWords_two] at hl; simp at hl
      rw [TermMem.nWords_two] at hl
      simp only [List.length_cons, Nat.add_right_cancel_iff] at hl
      have e0 : exprVal (mth s pw w0 w1) (dataE 1 w0) = w0.val :=
        exprVal_dataE _ 1 w0 (by simp [mth, regsOf])
      have e1 : exprVal (mth s pw w0 w1) (dataE 2 w1) = w1.val :=
        exprVal_dataE _ 2 w1 (by simp [mth, regsOf])
      have hV0 : V ≤ max (Promises.storeMview (mth s pw w0 w1) (dataE 1 w0) [0] rel)
          (Promises.storeMview (mth s pw w0 w1) (dataE 2 w1) [0] rel) :=
        Nat.le_trans hV (Nat.le_trans (storeMview_relSt (mth s pw w0 w1) _ [0] rel) (Nat.le_max_left _ _))
      have hw0 : WLe1 (bumpW V w0) ⟨w0.val, max (Promises.storeMview (mth s pw w0 w1) (dataE 1 w0) [0] rel)
          (Promises.storeMview (mth s pw w0 w1) (dataE 2 w1) [0] rel), 0⟩ :=
        WLe1_msgB (WLe1_refl _) (fun x g hx =>
          Nat.le_trans (storeMview_dataE _ 1 w0 (by simp [mth, regsOf]) [0] rel x g hx) (Nat.le_max_left _ _)) hV0
      have hw1 : WLe1 (bumpW V w1) ⟨w1.val, max (Promises.storeMview (mth s pw w0 w1) (dataE 1 w0) [0] rel)
          (Promises.storeMview (mth s pw w0 w1) (dataE 2 w1) [0] rel), 0⟩ :=
        WLe1_msgB (WLe1_refl _) (fun x g hx =>
          Nat.le_trans (storeMview_dataE _ 2 w1 (by simp [mth, regsOf]) [0] rel x g hx) (Nat.le_max_right _ _)) hV0
      obtain ⟨q1, _, _, q4, q5⟩ := stepStorePair_eq s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel
      generalize Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel = R at q1 q4 q5 hs
      obtain ⟨mem', pairs', th⟩ := R
      simp only at q1 q4 q5 hs
      rw [e0, e1] at q1
      generalize max (Promises.storeMview (mth s pw w0 w1) (dataE 1 w0) [0] rel)
          (Promises.storeMview (mth s pw w0 w1) (dataE 2 w1) [0] rel) = mv at q1 hw0 hw1
      have en : (offs a i).next = offs a (i + 1) := by simp [offs, WeakMem.Address.next, Nat.add_assoc]
      have hnx : (offs a i).next ≠ offs a i := WeakMem.Address.next_ne _
      have hne : ∀ j, offs a (i + 2 + j) ≠ offs a i := fun j e => by
        have := congrArg WeakMem.Address.offset e; simp [offs] at this; omega
      have hne1 : ∀ j, offs a (i + 2 + j) ≠ (offs a i).next := fun j e => by
        rw [en] at e; have := congrArg WeakMem.Address.offset e; simp [offs] at this; omega
      have hP0 : ∀ t, t ∈ (mth s pw w0 w1).promises → t < s.mem.size := hP
      have hPt : ∀ (Q : List Ts) t, (∀ t, t ∈ Q → t ∈ th.promises ∨ t ∈ E.fp) → t ∈ Q → t < s.mem.size :=
        fun Q t hQ ht => by
          rcases hQ t ht with h | h
          · rw [q4] at h; exact hP0 t h
          · exact hF t h
      have h0 : ∀ Q : List Ts, (∀ t, t ∈ Q → t ∈ th.promises ∨ t ∈ E.fp) →
          LatestNP mem' Q (offs a i) (mw ⟨offs a i, w0.val, mv⟩) := fun Q hQ => by
        rw [q1]
        exact LatestNP_push_other (LatestNP_push_top ⟨offs a i, w0.val, mv⟩ (fun t ht => hPt Q t hQ ht)) hnx
      have h1 : ∀ Q : List Ts, (∀ t, t ∈ Q → t ∈ th.promises ∨ t ∈ E.fp) →
          LatestNP mem' Q (offs a i).next (mw ⟨(offs a i).next, w1.val, mv⟩) := fun Q hQ => by
        rw [q1]
        exact LatestNP_push_top ⟨(offs a i).next, w1.val, mv⟩
          (fun t ht => by rw [Array.size_push]; exact Nat.lt_succ_of_lt (hPt Q t hQ ht))
      have hsz : s.mem.size ≤ mem'.size := by rw [q1, Array.size_push, Array.size_push]; omega
      have hP2 : PromLt { s with mem := mem', pairs := pairs', vs := th.vs, promises := th.promises } :=
        fun t ht => by
          have ht' : t ∈ s.promises := by have := ht; simp only at this; rw [q4] at this; exact this
          exact Nat.lt_of_lt_of_le (hP t ht') hsz
      obtain ⟨sel', vals', hW', hL', hS', hC', hB'⟩ := storeUnits_NPmixNF us ws (i + 2)
        { s with mem := mem', pairs := pairs', vs := th.vs, promises := th.promises } s' V old' hs
        (by show V ≤ th.vs.vRelSt; rw [q5]; exact hV)
        (fun t ht => by
          have ht' : t ∈ s.promises := by have := ht; simp only at this; rw [q4] at this; exact this
          exact Nat.lt_of_lt_of_le (hP t ht') hsz) (fun t ht => Nat.lt_of_lt_of_le (hF t ht) hsz) hl
        (fun j x hj => by
          have := hold (j + 2) x (by simpa using hj)
          rw [show i + (j + 2) = i + 2 + j by omega] at this
          refine PromAt_lat (s := s) (fun F h => ?_) (fun h => ?_) (fun _ => by
            show AtSame _ _ mem' th.promises _
            rw [q1, q4]
            exact AtSame_trans (AtSame_push fun e => hne j e.symm) (AtSame_push fun e => hne1 j e.symm)) this
          · show LatestNP mem' (th.promises ++ F) _ x
            rw [q1, q4]
            exact LatestNP_push_other (LatestNP_push_other h (fun e => hne j e.symm)) (fun e => hne1 j e.symm)
          · show LatestNP mem' [] _ x
            rw [q1]
            exact LatestNP_push_other (LatestNP_push_other h (fun e => hne j e.symm)) (fun e => hne1 j e.symm))
      have h0' := storeUnits_NPkeep (E := E) us ws (i + 2) _ s' hs (offs a i) _ (fun j _ e => hne j e.symm)
        (h0 _ (fun t ht => PromAt_sub ht))
      have h1' := storeUnits_NPkeep (E := E) us ws (i + 2) _ s' hs (offs a i).next _ (fun j _ e => hne1 j e.symm)
        (h1 _ (fun t ht => PromAt_sub ht))
      refine ⟨fun n => match n with | 0 => true | n + 1 => sel' n,
        mw ⟨offs a i, w0.val, mv⟩ :: mw ⟨(offs a i).next, w1.val, mv⟩ :: vals', ?_, fun j x hj => ?_,
        fun n hn hsel => ?_, fun t m j ht hn hm hl hvis => ?_, fun t m j n ht hn hm hl hvis hI => ?_⟩
      · show WLe ([bumpW V w0, bumpW V w1] ++ TermTear.mixU us sel' (ws.map (bumpW V)) old') _
        exact ⟨hw0, hw1, hW'⟩
      · match j, hj with
        | 0, hj => simp only [List.getElem?_cons_zero, Option.some.injEq] at hj; subst hj; simpa using h0'
        | 1, hj =>
            simp only [List.getElem?_cons_succ, List.getElem?_cons_zero, Option.some.injEq] at hj; subst hj
            rw [← en]; exact h1'
        | j + 2, hj =>
            have := hL' j x (by simpa using hj)
            rwa [show i + 2 + j = i + (j + 2) by omega] at this
      · cases n with
        | zero => cases hsel
        | succ n =>
            have hn' : n < us.length := by simp at hn; omega
            have e : offs a (i + nWords ((Acc.two :: us).take (n + 1))) = offs a (i + 2 + nWords (us.take n)) := by
              rw [List.take_succ_cons, TermMem.nWords_two]; congr 1; omega
            rw [e]
            obtain ⟨hu1, hS1⟩ := hS' n hn' hsel
            refine ⟨by simpa using hu1, (noNewVis_atSame (s' := { s with mem := mem', pairs := pairs', vs := th.vs, promises := th.promises })
              ?_).trans hS1⟩
            show AtSame _ _ mem' th.promises _
            rw [q1, q4]
            exact AtSame_trans (AtSame_push fun e => hne _ e.symm) (AtSame_push fun e => hne1 _ e.symm)
      all_goals
        have htp : t ∈ th.promises := by rw [q4]; exact ht
        obtain ⟨-, -, hful⟩ := storeUnits_promF us ws (i + 2)
          { s with mem := mem', pairs := pairs', vs := th.vs, promises := th.promises } s' hP2 hs
        obtain ⟨m1, j1, w1', hm1, -, -, hl1, -⟩ := hful t htp hn
        have hm1' : mem'[t]? = some m := by
          rw [q1, push_get (by rw [Array.size_push]; exact Nat.lt_succ_of_lt (hP t ht)), push_get (hP t ht)]
          exact hm
        have e : m1 = m := by
          have h2 : mem'[t]? = some m1 := hm1
          rw [hm1'] at h2; cases h2; rfl
        subst e
        have hj : j = j1 + 2 := by
          rw [hl1] at hl; have := congrArg WeakMem.Address.offset hl; simp [offs] at this; omega
        subst hj
      · have := hC' t m1 j1 htp hn hm1 hl1 hvis
        show ([o0, o1] ++ TermTear.mixU us sel' old' (ws.map (bumpW V)))[j1 + 2]? = _
        simpa using this
      · obtain ⟨n1, rfl, hI1⟩ := inAcc_cons_ge hI (by simp [Acc.size])
        show sel' n1 = false
        exact hB' t m1 j1 n1 htp hn hm1 hl1 hvis (by simpa [Acc.size] using hI1)
  | .one :: _, [], _, _, s', _, _, hs, _, _, _, _, _ => by simp [storeUnits] at hs
  | .two :: _, [], _, _, s', _, _, hs, _, _, _, _, _ => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, s', _, _, hs, _, _, _, _, _ => by simp [storeUnits] at hs

#print axioms storeUnits_NPmixNF

end TermNPmixW

namespace TermStep
open CoreLang CoreTerm CoreTyping TermRun TermClose TermTv TermSound TermMem
open WeakMem (Val Msg Memory Address VState Ts Arch AllocLabel)

/-- **(option 3) `storeUnits_NPmix`, with the complement**: at a unit where the store fulfils an own
promise at a visible word unit, the mix keeps the old words, so its complement holds the stored ones. -/
theorem storeUnits_NPmixF {E : TEnv} {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s s' : St) (V : Ts) (old : List Word),
      s' ∈ storeUnits k arch pw a rel us ws i s → V ≤ s.vs.vRelSt → (∀ t, t ∈ s.promises → t < s.mem.size) →
      (∀ t, t ∈ E.fp → t < s.mem.size) → old.length = nWords us →
      (∀ j x, old[j]? = some x → LatestNP s.mem (PromAt E s (offs a (i + j))) (offs a (i + j)) x) →
      ∃ (sel : Nat → Bool) (vals : List Word), WLe (TermTear.mixU us sel (ws.map (bumpW V)) old) vals ∧
        (∀ j x, vals[j]? = some x → LatestNP s'.mem (PromAt E s' (offs a (i + j))) (offs a (i + j)) x) ∧
        ∀ t m j, t ∈ s.promises → t ∉ s'.promises → s.mem[t]? = some m → m.loc = offs a (i + j) → VisU E m.loc →
          (TermTear.mixU us sel old (ws.map (bumpW V)))[j]? = (ws.map (bumpW V))[j]? :=
  fun us ws i s s' V old hs hV hP hF hl hold =>
    let ⟨sel, vals, h1, h2, _, h4, _⟩ := TermNPmixW.storeUnits_NPmixNF (E := E) us ws i s s' V old hs hV hP hF hl hold
    ⟨sel, vals, h1, h2, h4⟩

#print axioms storeUnits_NPmixF

/-- (P4) `stepStore_NPsame` for the latest word with promises included: a
fulfilled promise leaves it unchanged. -/
theorem stepStore_NPsame0 {k : Promises.Knobs} {arch : Arch} {mem mem' : Memory} {th th' : Promises.Thread}
    {A : Address} {w : Word} {deps : List WeakMem.Reg} {rel : Bool} {V : Ts} {x : Word}
    (h : (mem', th') ∈ Promises.stepStore k arch mem th A (dataE 1 w) deps rel) (hr : th.regs 1 = w)
    (hV : V ≤ th.vs.vRelSt) (hx : LatestNP mem [] A x) :
    ∃ (b : Bool) (x0 : Word), WLe1 (if b then bumpW V w else x) x0 ∧ LatestNP mem' [] A x0 :=
  let ⟨b, x0, h1, h2, _⟩ := stepStore_NPsame0F h hr hV hx
  ⟨b, x0, h1, h2⟩

/-- **(P4) A store's new latest non-promise words, unit by unit**: each unit's
words are (above) the stored words or are the old words, so the cell's new
latest non-promise words lie above a unit-selection mix of the stored value
and the old words. A unit may fulfil one of the thread's promises (then the
old words may stay the latest non-promise ones); a pair unit appends both
words above every promise. -/
theorem storeUnits_NPmix {E : TEnv} {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s s' : St) (V : Ts) (old : List Word),
      s' ∈ storeUnits k arch pw a rel us ws i s → V ≤ s.vs.vRelSt → (∀ t, t ∈ s.promises → t < s.mem.size) →
      (∀ t, t ∈ E.fp → t < s.mem.size) → old.length = nWords us →
      (∀ j x, old[j]? = some x → LatestNP s.mem (PromAt E s (offs a (i + j))) (offs a (i + j)) x) →
      ∃ (sel : Nat → Bool) (vals : List Word), WLe (TermTear.mixU us sel (ws.map (bumpW V)) old) vals ∧
        ∀ j x, vals[j]? = some x → LatestNP s'.mem (PromAt E s' (offs a (i + j))) (offs a (i + j)) x :=
  fun us ws i s s' V old hs hV hP hF hl hold =>
    let ⟨sel, vals, h1, h2, _⟩ := storeUnits_NPmixF (E := E) us ws i s s' V old hs hV hP hF hl hold
    ⟨sel, vals, h1, h2⟩

/-- (F2) **A component store at an own or foreign cell with a frontier, memory's
holding**: as the foreign branch of `tstepMR_storePubLoc`, the component's new
latest non-promise words are a unit-selection mix of the stored value and the
component's old held words (`storeUnits_NPmix`, `VRR_mix`), so the cell's entry
needs at most `Rv` on top of its old resources.  No coherence fact is used: at a
cell with a frontier, typed messages of other threads may sit above coherence. -/
theorem heldMixAt {g : G} {E : TEnv} {s : St} {H : Res} {a : Address} {c : Cell} {us : List Acc}
    {ws : List Word} {U : Ty} {Rv : Res} {f : Ts} (hm : MemInv g E s) (hH : MemHeld E s H)
    (hsto : E.sto a.label = some c) (hf : E.pfr a.label = some f) (hat : AtOff c.ty a.offset U)
    (hini : IniAt E.ini c a U) (hna : ∀ N e, U ≠ .array (.lit N) e)
    (hiaU : TermTear.IallOK [] U = true) (hfo1 : ∀ t, t ∈ E.fp → t < s.mem.size)
    (hU : EnvValR E U ws Rv) (hus : accs U = some us) (hlen : ws.length = nWords us)
    {k : Promises.Knobs} {arch : Arch} {pw : Word} {rel : Bool} {s' : St}
    (hs' : s' ∈ storeUnits k arch pw a rel us ws 0 s) :
    ∃ H2, H2 ≤ Rv + H ∧ MemHeld E s' H2 := by
  have hwU : wc U = some (nWords us) := wc_of_accs hus
  have hcpU := coupledOK_AtOff hat (MemInv_cplT hm hsto hf)
  obtain ⟨R0, H0, rfl, hent0, hX⟩ := MemHeld_focus hH a.label
  obtain ⟨vals0, hL0, hC0⟩ := hent0.2 c hsto
  rcases own_segR hC0 hat hini hna with ⟨b, oS, S, wS, Rsg, Rrc, -, hbo, hatS, hwS, hbw, hR0, ⟨hvs, hVs⟩, hput⟩ |
    ⟨-, -, -, -, -, -, -, hz0⟩
  rotate_left
  · obtain rfl := nWords_zero_nil (hz0 _ hus)
    simp only [storeUnits, List.mem_singleton] at hs'
    subst hs'
    exact ⟨_, fun k => by simp only [Res.add_apply]; omega, hH⟩
  have hsl : ((vals0.drop b).take wS).length = wS := by
    simp only [List.length_take, List.length_drop]; omega
  obtain ⟨n, Rq, Rr2, hwn, hle2, hRs, hvq, hput2⟩ := VRR_at E.unsee hatS hvs (by rw [hsl]; exact hwS)
  rw [hwU] at hwn
  obtain rfl : nWords us = n := Option.some.inj hwn
  rw [hsl] at hle2
  obtain ⟨n', hwn', -, -, hVq⟩ := VR_at E.unsee hatS (VRR_VR S (RLink_of (Coh_CE _) (CohR_CE _)) hvs) hVs
    (by rw [hsl]; exact hwS)
  rw [hwU] at hwn'
  obtain rfl : nWords us = n' := Option.some.inj hwn'
  have hlenv : a.offset + nWords us ≤ vals0.length := by
    rw [← hbo, Nat.add_assoc]; exact Nat.le_trans (Nat.add_le_add_left hle2 b) hbw
  have hvqe : (((vals0.drop b).take wS).drop oS).take (nWords us) = (vals0.drop a.offset).take (nWords us) := by
    rw [take_drop_take hle2, drop_drop', hbo]
  rw [hvqe] at hvq hVq
  generalize hqo : (vals0.drop a.offset).take (nWords us) = qold at hvq hVq
  have hlq : qold.length = nWords us := by rw [← hqo]; simp; omega
  have hPb : ∀ t, t ∈ s.promises → t < s.mem.size := fun t ht => hm.2.2.1 t ht
  obtain ⟨sel, vals', hWv, hLv⟩ := storeUnits_NPmix (E := E) us ws 0 s s'
    s.vs.vRelSt qold hs' (Nat.le_refl _) hPb hfo1 hlq
    (fun j w hj => by
      have hj' : vals0[a.offset + j]? = some w := by
        rw [← hqo] at hj
        by_cases hjn : j < nWords us
        · rw [List.getElem?_take_of_lt hjn, List.getElem?_drop] at hj; exact hj
        · rw [List.getElem?_eq_none (by simp; omega)] at hj; cases hj
      have e : offs a (0 + j) = ⟨a.label, a.offset + j⟩ := by simp [offs]
      rw [e]; exact hL0 _ w hj')
  have hst := hU.store hm.2.2.2.2.1
  have hln : (ws.map (bumpW s.vs.vRelSt)).length = nWords us := by
    rw [List.length_map, hlen]
  obtain ⟨Rm, hvm, hRm⟩ := TermTear.VRR_mix (sel := sel) hcpU hiaU hus hst.1 hvq hln hlq
  have hVm := TermTear.Valid_mix (sel := sel) hus hst.2 hVq hln hlq
  have hlm0 := TermTear.length_mixU us sel _ _ hln hlq
  generalize hqm : TermTear.mixU us sel (ws.map (bumpW s.vs.vRelSt)) qold = qm
    at hvm hVm hWv hlm0
  have hQ := hput2 qm Rm hvm hlm0
  have hQV := (VR_put E.unsee hatS (VRR_VR S (RLink_of (Coh_CE _) (CohR_CE _)) hvs) hVs
    (by rw [hsl]; exact hwS) (VRR_VR _ (RLink_of (Coh_CE _) (CohR_CE _)) hvm) hVm (by rw [hlm0]; exact hwU)).2.2
  rw [hlm0] at hQV
  have hQl : (((vals0.drop b).take wS).take oS ++ qm ++ ((vals0.drop b).take wS).drop (oS + nWords us)).length = wS := by
    simp only [List.length_append, List.length_take, List.length_drop, hlm0]; omega
  have hcell' := hput _ _ ⟨hQ, hQV⟩ hQl
  have hsp := splice_seg vals0 qm b wS oS (by rw [hlm0]; exact hle2)
  rw [hlm0] at hsp
  rw [hsp, hbo] at hcell'
  have hlv' : vals'.length = nWords us := by rw [← WLe.length hWv, hlm0]
  have hcell2 := CellOKR_up (WLe.append (WLe.append (WLe_refl (vals0.take a.offset)) hWv)
    (WLe_refl (vals0.drop (a.offset + nWords us)))) hcell'
  have hlat' : ∀ o w, (vals0.take a.offset ++ vals' ++ vals0.drop (a.offset + nWords us))[o]? = some w →
      LatestNP s'.mem (PromAt E s' ⟨a.label, o⟩) ⟨a.label, o⟩ w := by
    intro o w hov
    rw [splice_get vals0 vals' a.offset (nWords us) o hlv' hlenv] at hov
    by_cases hr : a.offset ≤ o ∧ o < a.offset + nWords us
    · rw [iteT hr] at hov
      have := hLv (o - a.offset) w hov
      have e2 : offs a (0 + (o - a.offset)) = ⟨a.label, o⟩ := by
        simp only [offs, Nat.zero_add]; congr 1; exact Nat.add_sub_of_le hr.1
      rw [e2] at this; exact this
    · rw [iteF hr] at hov
      refine storeUnits_NPkeep us ws 0 _ s' hs' _ w (fun j hj e => ?_) (hL0 o w hov)
      have h' : o = a.offset + j := by simpa [offs] using congrArg WeakMem.Address.offset e
      subst h'
      exact hr ⟨Nat.le_add_right _ _, Nat.add_lt_add_left hj _⟩
  have hent : HeldEntry E s' a.label (Rm + Rr2 + Rrc) := by
    refine ⟨fun h => (by rw [hsto] at h; cases h), fun c2 hc2 => ?_⟩
    rw [hsto] at hc2; cases hc2
    exact ⟨_, hlat', hcell2⟩
  have hX' : MemHeldX E s' a.label H0 := MemHeldX_tr hX (fun _ _ => rfl) (fun _ _ => rfl)
    (fun l' hne o w hl => storeUnits_NPkeep us ws 0 _ s' hs' ⟨l', o⟩ w
      (fun j _ he => hne (by have := congrArg WeakMem.Address.label he; simpa [offs] using this)) hl) id
  refine ⟨Rm + Rr2 + Rrc + H0, Res.le_def.2 fun k => ?_, MemHeld_unfocus hX' hent⟩
  subst hR0; subst hRs
  have h2 := hRm k
  simp only [Res.add_apply] at h2 ⊢
  omega



end TermStep

namespace TermTear
open CoreLang CoreTerm CoreTyping TermRun TermClose TermSound
open TermStep

/-! ## (§11) The two-sided mix: a selection and its complement share both values' resources -/

theorem mix2_wrap {t : Ty} {us : List Acc} {sel : Nat → Bool} {ρ1 ρ2 ρ ρ' : Nat → Nat} {η1 η2 η η' : TEnv}
    {ws1 ws2 : List Word} {R1 R2 : Res} (hu : accs t = some us)
    (l1 : ws1.length = nWords us) (l2 : ws2.length = nWords us)
    (hI1 : ∀ j, MI true sel t j = true → ρ j = ρ1 j) (hI2 : ∀ j, MI false sel t j = true → ρ j = ρ2 j)
    (hJ1 : ∀ j, MI true sel t j = true → ρ' j = ρ2 j) (hJ2 : ∀ j, MI false sel t j = true → ρ' j = ρ1 j)
    (hT1 : ∀ j, MT true sel t j = true → η.wit j = η1.wit j ∧ η.rrs j = η1.rrs j ∧ η.urrs j = η1.urrs j)
    (hT2 : ∀ j, MT false sel t j = true → η.wit j = η2.wit j ∧ η.rrs j = η2.rrs j ∧ η.urrs j = η2.urrs j)
    (hU1 : ∀ j, MT true sel t j = true → η'.wit j = η2.wit j ∧ η'.rrs j = η2.rrs j ∧ η'.urrs j = η2.urrs j)
    (hU2 : ∀ j, MT false sel t j = true → η'.wit j = η1.wit j ∧ η'.rrs j = η1.rrs j ∧ η'.urrs j = η1.urrs j)
    (hE1 : CE η = CE η1) (hE2 : CE η = CE η2) (hF1 : CE η' = CE η1) (hF2 : CE η' = CE η2)
    (h1 : VRR ρ1 η1 t (shp t) ws1 R1) (h2 : VRR ρ2 η2 t (shp t) ws2 R2)
    (hint : 2 ≤ us.length → ∃ Ra Rb, VRR ρ η t (shp t) (mixU us sel ws1 ws2) Ra ∧
      VRR ρ' η' t (shp t) (mixU us sel ws2 ws1) Rb ∧ Ra + Rb ≤ R1 + R2) :
    ∃ Ra Rb, VRR ρ η t (shp t) (mixU us sel ws1 ws2) Ra ∧
      VRR ρ' η' t (shp t) (mixU us sel ws2 ws1) Rb ∧ Ra + Rb ≤ R1 + R2 := by
  by_cases hn : us.length ≤ 1
  · have hnU : nU t ≤ 1 := by rw [nU_of_accs hu]; exact hn
    rw [mixU_small hn l1 l2, mixU_small hn l2 l1]
    cases hs : sel 0
    · refine ⟨R2, R1, ?_, ?_, fun k => by simp only [Res.add_apply]; omega⟩
      · simp only [Bool.false_eq_true, ite_false]
        exact VRR_congr t ρ2 ρ η2 η _ _ _ (fun j hj => (hI2 j (by rw [MI_small j hnU]; simp [hs, hj])).symm)
          (fun j hj => have h := hT2 j (by rw [MT_small j hnU]; simp [hs, hj]); ⟨h.1.symm, h.2.1.symm, h.2.2.symm⟩)
          hE2.symm h2
      · simp only [Bool.false_eq_true, ite_false]
        exact VRR_congr t ρ1 ρ' η1 η' _ _ _ (fun j hj => (hJ2 j (by rw [MI_small j hnU]; simp [hs, hj])).symm)
          (fun j hj => have h := hU2 j (by rw [MT_small j hnU]; simp [hs, hj]); ⟨h.1.symm, h.2.1.symm, h.2.2.symm⟩)
          hF1.symm h1
    · refine ⟨R1, R2, ?_, ?_, Res.le_refl _⟩
      · simp only [ite_true]
        exact VRR_congr t ρ1 ρ η1 η _ _ _ (fun j hj => (hI1 j (by rw [MI_small j hnU]; simp [hs, hj])).symm)
          (fun j hj => have h := hT1 j (by rw [MT_small j hnU]; simp [hs, hj]); ⟨h.1.symm, h.2.1.symm, h.2.2.symm⟩)
          hE1.symm h1
      · simp only [ite_true]
        exact VRR_congr t ρ2 ρ' η2 η' _ _ _ (fun j hj => (hJ1 j (by rw [MI_small j hnU]; simp [hs, hj])).symm)
          (fun j hj => have h := hU1 j (by rw [MT_small j hnU]; simp [hs, hj]); ⟨h.1.symm, h.2.1.symm, h.2.2.symm⟩)
          hF2.symm h2
  · exact hint (by omega)

theorem mixR2_gen : ∀ (t : Ty) (ke : KEnv) (us : List Acc) (sel : Nat → Bool) (ρ1 ρ2 ρ ρ' : Nat → Nat)
    (η1 η2 η η' : TEnv) (ws1 ws2 : List Word) (R1 R2 : Res),
    Ty.coupledOKIn ke t = true → IallOK ke t = true → accs t = some us →
    ws1.length = nWords us → ws2.length = nWords us →
    (∀ j, MI true sel t j = true → ρ j = ρ1 j) → (∀ j, MI false sel t j = true → ρ j = ρ2 j) →
    (∀ j, MI true sel t j = true → ρ' j = ρ2 j) → (∀ j, MI false sel t j = true → ρ' j = ρ1 j) →
    (∀ j, MT true sel t j = true → η.wit j = η1.wit j ∧ η.rrs j = η1.rrs j ∧ η.urrs j = η1.urrs j) →
    (∀ j, MT false sel t j = true → η.wit j = η2.wit j ∧ η.rrs j = η2.rrs j ∧ η.urrs j = η2.urrs j) →
    (∀ j, MT true sel t j = true → η'.wit j = η2.wit j ∧ η'.rrs j = η2.rrs j ∧ η'.urrs j = η2.urrs j) →
    (∀ j, MT false sel t j = true → η'.wit j = η1.wit j ∧ η'.rrs j = η1.rrs j ∧ η'.urrs j = η1.urrs j) →
    CE η = CE η1 → CE η = CE η2 → CE η' = CE η1 → CE η' = CE η2 → CZ ke η1 → CZ ke η2 →
    VRR ρ1 η1 t (shp t) ws1 R1 → VRR ρ2 η2 t (shp t) ws2 R2 →
    ∃ Ra Rb, VRR ρ η t (shp t) (mixU us sel ws1 ws2) Ra ∧
      VRR ρ' η' t (shp t) (mixU us sel ws2 ws1) Rb ∧ Ra + Rb ≤ R1 + R2 := by
  intro t
  induction t with
  | prod a b iha ihb =>
    intro ke us sel ρ1 ρ2 ρ ρ' η1 η2 η η' ws1 ws2 R1 R2 hok hia hu l1 l2 hI1 hI2 hJ1 hJ2 hT1 hT2 hU1 hU2
      hE1 hE2 hF1 hF2 hc1 hc2 h1 h2
    refine mix2_wrap hu l1 l2 hI1 hI2 hJ1 hJ2 hT1 hT2 hU1 hU2 hE1 hE2 hF1 hF2 h1 h2 (fun hn => ?_)
    have hnU : ¬ nU (.prod a b) ≤ 1 := by rw [nU_of_accs hu]; omega
    simp only [Ty.coupledOKIn, Bool.and_eq_true] at hok
    simp only [IallOK, Bool.and_eq_true] at hia
    cases ha : accs a with
    | none => simp [accs, ha] at hu
    | some ua =>
    cases hb' : accs b with
    | none => simp [accs, ha, hb'] at hu
    | some ub =>
    have hus : us = ua ++ ub := by simp [accs, ha, hb'] at hu; exact hu.symm
    subst hus
    have hna : nU a = ua.length := nU_of_accs ha
    have hMI : ∀ L j, MI L sel (.prod a b) j =
        (MI L sel a j || MI L (fun i => sel (i + ua.length)) b j) := by
      intro L j; simp only [MI, edgeU, hnU, ite_false, hna]
    have hMT : ∀ L j, MT L sel (.prod a b) j =
