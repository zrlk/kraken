/-- `VR_transfer` for the resourceful `VRR` (same structure; resources unchanged). -/
theorem VRR_transfer : ∀ (t : Ty) (ke : KEnv) (η₁ η₂ : TEnv) (ρ : Nat → Nat) (rt : Shp) (ws : List Word) (X : Res),
    Ty.noOwnIn ke t = true →
    (∀ k S vs Y, η₁.rrs k S vs Y → η₂.rrs k S vs Y) → (∀ k S vs Y, η₁.urrs k S vs Y → η₂.urrs k S vs Y) →
    η₁.wit = η₂.wit → η₁.prog = η₂.prog →
    (∀ l c, η₁.sto l = some c → η₂.sto l = some c) →
    (∀ l, η₁.ini l ≤ η₂.ini l) → (∀ l f, η₁.pfr l = some f → η₂.pfr l = some f) →
    (∀ l, η₁.seen l → η₂.seen l) → (∀ l B, η₁.box l = some B → η₂.box l = some B) →
    VRR ρ η₁ t rt ws X → (hri : ∀ l, η₁.rini l ≤ η₂.rini l := by rini_le) → VRR ρ η₂ t rt ws X
  | .tvar k, _, η₁, η₂, ρ, rt, ws, X, _, hr, _, _, _, _, _, _, _, _, hv, hri => by
      simp only [VRR] at hv ⊢
      obtain ⟨w0, h0, h1⟩ := hv; exact ⟨w0, h0, hr k rt _ X h1⟩
  | .refine t ψ, ke, η₁, η₂, ρ, rt, ws, X, hn, hr, hur, hw, hp, hs, hi, hP, hS, hBx, hv, hri => by
      simp only [Ty.noOwnIn] at hn
      simp only [VRR] at hv ⊢
      exact ⟨VRR_transfer t ke η₁ η₂ ρ rt ws X hn hr hur hw hp hs hi hP hS hBx hv.1, IniR_mono (TEnv.selIni_le hw hi hri t) hv.2⟩
  | .iex b, ke, η₁, η₂, ρ, rt, ws, X, hn, hr, hur, hw, hp, hs, hi, hP, hS, hBx, hv, hri => by
      simp only [Ty.noOwnIn] at hn
      simp only [VRR] at hv ⊢
      obtain ⟨n, rb, w, h1, h2⟩ := hv
      exact ⟨n, rb, w, h1, VRR_transfer b ke η₁ η₂ (vcons w ρ) rb ws X hn hr hur hw hp hs hi hP hS hBx h2⟩
  | .prod a b, ke, η₁, η₂, ρ, rt, ws, X, hn, hr, hur, hw, hp, hs, hi, hP, hS, hBx, hv, hri => by
      simp only [Ty.noOwnIn, Bool.and_eq_true] at hn
      simp only [VRR] at hv ⊢
      obtain ⟨ra, rb, h1, Ra, Rb, hR, hz, hf⟩ := hv
      refine ⟨ra, rb, h1, Ra, Rb, hR, hz, fun n hn' => ?_⟩
      obtain ⟨e1, e2, e3⟩ := hf n hn'
