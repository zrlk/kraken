  obtain ⟨rt0, w0, hea0, hwv0, -⟩ := atom_num hi.1.2.1 htvk0 hio0
  obtain ⟨rt1, w1, hea1, hwv1, -⟩ := atom_num hi.1.2.1 htvk1 hio1
  have key : tstep g mem pairs th =
