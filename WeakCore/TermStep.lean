/-! # Protocol words' positions in a closed cell type -/

/-- A leaf for `AtOff`: not a pair, array or `μ` (the only types `AtOff` descends into). -/
def Solid (V : Ty) : Prop :=
  (∀ a b, V ≠ .prod a b) ∧ (∀ i e, V ≠ .array i e) ∧ (∀ t, V ≠ .mu t)

theorem Solid_word (r : Idx) (P : Proto) : Solid (.word r P) :=
  ⟨(fun _ _ h => by cases h), (fun _ _ h => by cases h), (fun _ h => by cases h)⟩

theorem Solid_word2 (r : Idx) (P : Proto2) : Solid (.word2 r P) :=
  ⟨(fun _ _ h => by cases h), (fun _ _ h => by cases h), (fun _ h => by cases h)⟩

theorem cl_mu_eq (ρ : Nat → Nat) (W : Nat → Ty) (s : Ty) :
    cl ρ W 0 0 (.mu s) = .mu (cl ρ W 1 0 s) := rfl

/-- A component lies within its container. -/
theorem AtOff_bound {T U : Ty} {o : Nat} (h : AtOff T o U) {L us : List Acc}
    (hL : accs T = some L) (hu : accs U = some us) : o + nWords us ≤ nWords L := by
  obtain ⟨pre, post, e, hn⟩ := AtOff_embed h hL hu
  subst e; subst hn
  simp only [TermSound.nWords_append]; omega

/-- Inversion at a pair, for a target that is not a `μ`. -/
theorem AtOff_prod_inv {a b V : Ty} {o : Nat} (hV : ∀ t, V ≠ .mu t) (h : AtOff (.prod a b) o V) :
    (o = 0 ∧ V = .prod a b) ∨ AtOff a o V ∨
      (∃ as o2, accs a = some as ∧ o = nWords as + o2 ∧ AtOff b o2 V) := by
  generalize hT : Ty.prod a b = T at h
  induction h with
  | here _ => exact Or.inl ⟨rfl, rfl⟩
  | fst h' _ => cases hT; exact Or.inr (Or.inl h')
  | snd ha h' _ => cases hT; exact Or.inr (Or.inr ⟨_, _, ha, rfl, h'⟩)
  | elem _ _ _ _ => cases hT
  | mu _ _ _ _ => rw [cl_mu_eq] at hT; cases hT
  | fold _ _ _ _ _ => exact absurd (cl_mu_eq _ _ _) (hV _)

/-- Inversion at an array, for a target that is not a `μ`. -/
theorem AtOff_array_inv {i : Idx} {e V : Ty} {o : Nat} (hV : ∀ t, V ≠ .mu t)
    (h : AtOff (.array i e) o V) :
    (o = 0 ∧ V = .array i e) ∨
      (∃ n j o2 us, i = .lit n ∧ accs e = some us ∧ j < n ∧ o = j * nWords us + o2 ∧ AtOff e o2 V) := by
  generalize hT : Ty.array i e = T at h
  induction h with
  | here _ => exact Or.inl ⟨rfl, rfl⟩
  | fst _ _ => cases hT
  | snd _ _ _ => cases hT
  | elem hu hj h' _ => cases hT; exact Or.inr ⟨_, _, _, _, rfl, hu, hj, rfl, h'⟩
  | mu _ _ _ _ => rw [cl_mu_eq] at hT; cases hT
  | fold _ _ _ _ _ => exact absurd (cl_mu_eq _ _ _) (hV _)

/-- At a leaf container, only the leaf itself, at offset 0. -/
theorem AtOff_solid {X V : Ty} {d : Nat} (hX : Solid X) (hV : ∀ t, V ≠ .mu t) (h : AtOff X d V) :
    d = 0 ∧ V = X := by
  generalize hT : X = T at h
  induction h with
  | here _ => exact ⟨rfl, rfl⟩
  | fst _ _ => exact absurd hT (hX.1 _ _)
  | snd _ _ _ => exact absurd hT (hX.1 _ _)
  | elem _ _ _ _ => exact absurd hT (hX.2.1 _ _)
  | mu _ _ _ _ => rw [cl_mu_eq] at hT; exact absurd hT (hX.2.2 _)
  | fold _ _ _ _ _ => exact absurd (cl_mu_eq _ _ _) (hV _)

/-- **Nesting**: a laid-out component `U` at `o` and a leaf component `V` at `o'`
of one type are disjoint by word ranges, or `V` is a component of `U`. -/
theorem AtOff_nest {T U V : Ty} {o : Nat} {vs : List Acc} (hV : Solid V) (hvs : accs V = some vs)
    (h1 : AtOff T o U) :
    ∀ {us : List Acc}, accs U = some us → ∀ {o' : Nat}, AtOff T o' V →
      o' + nWords vs ≤ o ∨ o + nWords us ≤ o' ∨ (o ≤ o' ∧ AtOff U (o' - o) V) := by
  induction h1 with
  | here _ =>
      intro us _ o' h2
      exact Or.inr (Or.inr ⟨Nat.zero_le _, by simpa using h2⟩)
  | @fst a b u o h1 ih =>
      intro us hu o' h2
      rcases AtOff_prod_inv hV.2.2 h2 with ⟨_, e⟩ | h2 | ⟨as, o2, ha, e, h2⟩
      · exact absurd e (hV.1 _ _)
      · exact ih hu h2
      · have := AtOff_bound h1 ha hu
        omega
  | @snd a b u o as ha h1 ih =>
      intro us hu o' h2
      rcases AtOff_prod_inv hV.2.2 h2 with ⟨_, e⟩ | h2 | ⟨as', o2, ha', e, h2'⟩
      · exact absurd e (hV.1 _ _)
      · have := AtOff_bound h2 ha hvs
        omega
      · rw [ha] at ha'; cases ha'; subst e
        rcases ih hu h2' with h | h | ⟨hle, h⟩
        · omega
        · omega
        · refine Or.inr (Or.inr ⟨by omega, ?_⟩)
          rw [show nWords as + o2 - (nWords as + o) = o2 - o by omega]; exact h
  | @elem e u n j o es he hj h1 ih =>
      intro us hu o' h2
      rcases AtOff_array_inv hV.2.2 h2 with ⟨_, e'⟩ | ⟨n', j', o2, es', hn, he', hj', eo, h2'⟩
      · exact absurd e' (hV.2.1 _ _)
      · cases hn; rw [he] at he'; cases he'; subst eo
        have b1 := AtOff_bound h1 he hu
        have b2 := AtOff_bound h2' he hvs
        rcases Nat.lt_trichotomy j j' with hlt | rfl | hgt
        · have : (j + 1) * nWords es ≤ j' * nWords es := Nat.mul_le_mul_right _ hlt
          rw [Nat.succ_mul] at this
          omega
        · rcases ih hu h2' with h | h | ⟨hle, h⟩
          · omega
          · omega
          · refine Or.inr (Or.inr ⟨by omega, ?_⟩)
            rw [show j * nWords es + o2 - (j * nWords es + o) = o2 - o by omega]; exact h
        · have : (j' + 1) * nWords es ≤ j * nWords es := Nat.mul_le_mul_right _ hgt
          rw [Nat.succ_mul] at this
          omega
  | @mu ρ W s u o hW hg h1 ih =>
      intro us hu o' h2
      rcases AtOff_mu_inv hW hg h2 with ⟨_, e⟩ | h2
      · rw [cl_mu_eq] at e; exact absurd e (hV.2.2 _)
      · exact ih hu h2
  | @fold ρ W s T o hW hg ha h1 ih =>
      intro us hu o' h2
      rcases ih (by rw [accs_cl_unfold_eq hW hg]; exact hu) h2 with h | h | ⟨hle, h⟩
      · exact Or.inl h
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr ⟨hle, .mu hW hg h⟩)

/-- Disjointness from a component with no `V` inside. -/
theorem AtOff_disj {T U V : Ty} {o o' : Nat} {us vs : List Acc} (hV : Solid V)
    (hvs : accs V = some vs) (h1 : AtOff T o U) (hus : accs U = some us) (h2 : AtOff T o' V)
    (hU : ∀ d, ¬ AtOff U d V) : o' + nWords vs ≤ o ∨ o + nWords us ≤ o' := by
  rcases AtOff_nest hV hvs h1 hus h2 with h | h | ⟨_, h⟩
  · exact Or.inl h
  · exact Or.inr h
  · exact absurd h (hU _)

/-! ## Goal 1: uniqueness of words -/

theorem accs_word {r : Idx} {P : Proto} (hP : P.ghost = false) : accs (.word r P) = some [.one] := by
  simp [accs, hP]

theorem accs_word2 {r : Idx} {P : Proto2} : accs (.word2 r P) = some [.two] := rfl

/-- (S7f α) `IniAt` at a non-ghost word unit gives `IniW`. -/
theorem IniW_word {E : TEnv} {a : Address} {c : Cell} {r : Idx} {P : Proto} (hsto : E.sto a.label = some c)
    (hat : AtOff c.ty a.offset (.word r P)) (hg : P.ghost = false) (hini : IniAt E.ini c a (.word r P)) :
    IniW E a := by
  intro c' N e us hc' hT hus
  rw [hsto] at hc'
  obtain rfl : c = c' := Option.some.inj hc'
  rcases hini N e hT with ⟨hU, -⟩ | ⟨us', j, o, hus', hj, ho, hat'⟩
  · rw [hT] at hU; cases hU
  · rw [hus] at hus'
    obtain rfl : us = us' := Option.some.inj hus'
    have hb := AtOff_bound hat' hus (accs_word hg)
    rw [show nWords [Acc.one] = 1 from rfl] at hb
    have hm : (j + 1) * nWords us ≤ E.ini a.label * nWords us := Nat.mul_le_mul_right _ hj
    rw [Nat.succ_mul] at hm
    rw [← ho]
    exact Nat.lt_of_lt_of_le (Nat.add_lt_add_left (Nat.lt_of_succ_le hb) _) hm

/-- (S7f α) `IniW` at a word unit gives `IniAt`. -/
theorem IniAt_of_IniW {E : TEnv} {a : Address} {c : Cell} {r : Idx} {P : Proto} (hsto : E.sto a.label = some c)
    (hat : AtOff c.ty a.offset (.word r P)) (hw : IniW E a) : IniAt E.ini c a (.word r P) := by
  intro N e hT
  refine Or.inr ?_
  have hat2 := hat
  rw [hT] at hat2
  rcases AtOff_array_inv (fun t h => by cases h) hat2 with ⟨-, h⟩ | ⟨n', j, o2, us, hn, hus, -, ho, hat'⟩
  · cases h
  · obtain rfl : N = n' := by cases hn; rfl
    have hlt := hw c N e us hsto hT hus
    refine ⟨us, j, o2, hus, Nat.lt_of_not_le fun hle => ?_, ho.symm, hat'⟩
    have hm : E.ini a.label * nWords us ≤ j * nWords us := Nat.mul_le_mul_right _ hle
    exact absurd (Nat.lt_of_lt_of_le hlt hm) (by rw [ho]; exact Nat.not_lt.2 (Nat.le_add_right _ _))

theorem AtOff_word_uniq {T : Ty} {o : Nat} {r r' : Idx} {P P' : Proto}
    (hP : P.ghost = false) (hP' : P'.ghost = false)
    (h1 : AtOff T o (.word r P)) (h2 : AtOff T o (.word r' P')) : r = r' ∧ P = P' := by
  rcases AtOff_nest (Solid_word r' P') (accs_word hP') h1 (accs_word hP) h2 with h | h | ⟨_, h⟩
  · simp [nWords, Acc.size] at h; omega
  · simp [nWords, Acc.size] at h; omega
  · have := (AtOff_solid (Solid_word r P) (Solid_word r' P').2.2 h).2
    cases this; exact ⟨rfl, rfl⟩

theorem AtOff_word2_uniq {T : Ty} {o : Nat} {r r' : Idx} {P P' : Proto2}
    (h1 : AtOff T o (.word2 r P)) (h2 : AtOff T o (.word2 r' P')) : r = r' ∧ P = P' := by
  rcases AtOff_nest (Solid_word2 r' P') accs_word2 h1 accs_word2 h2 with h | h | ⟨_, h⟩
  · simp [nWords, Acc.size] at h; omega
  · simp [nWords, Acc.size] at h; omega
  · have := (AtOff_solid (Solid_word2 r P) (Solid_word2 r' P').2.2 h).2
    cases this; exact ⟨rfl, rfl⟩

/-- A word and a pair at `o2` (covering `o2`, `o2 + 1`) never overlap. -/
theorem AtOff_word_word2 {T : Ty} {o o2 : Nat} {r r' : Idx} {P : Proto} {P' : Proto2}
    (hP : P.ghost = false) (h1 : AtOff T o (.word r P)) (h2 : AtOff T o2 (.word2 r' P')) :
    o + 1 ≤ o2 ∨ o2 + 2 ≤ o := by
  rcases AtOff_nest (Solid_word r P) (accs_word hP) h2 accs_word2 h1 with h | h | ⟨_, h⟩
  · simp [nWords, Acc.size] at h; omega
  · simp [nWords, Acc.size] at h; omega
  · have := (AtOff_solid (Solid_word2 r' P') (Solid_word r P).2.2 h).2
    cases this

/-- Two pairs are at the same offset or disjoint. -/
theorem AtOff_word2_word2 {T : Ty} {o o' : Nat} {r r' : Idx} {P P' : Proto2}
    (h1 : AtOff T o (.word2 r P)) (h2 : AtOff T o' (.word2 r' P')) :
    (o = o' ∧ r = r' ∧ P = P') ∨ o + 2 ≤ o' ∨ o' + 2 ≤ o := by
  rcases AtOff_nest (Solid_word2 r' P') accs_word2 h1 accs_word2 h2 with h | h | ⟨hle, h⟩
  · simp [nWords, Acc.size] at h; omega
  · simp [nWords, Acc.size] at h; omega
  · have := AtOff_solid (Solid_word2 r P) (Solid_word2 r' P').2.2 h
    obtain ⟨hd, e⟩ := this
    cases e; exact Or.inl ⟨by omega, rfl, rfl⟩

/-! ## Goal 2: word-free components

`Ty.wordFree` reads only the head, so it does not exclude a word inside a pair
(see `wordFree_counterexample`).  `dwf` is the deep version along the
constructors `AtOff` descends into. -/

/-- Deep word-freeness along pairs, arrays and `μ` (a `tvar` is word-free: under a
closed `μ` it stands for the `μ` itself). -/
def dwf : Ty → Bool
  | .word _ _ => false
  | .word2 _ _ => false
  | .prod a b => dwf a && dwf b
  | .array _ e => dwf e
  | .mu t => dwf t
  | _ => true

theorem dwf_shiftT : ∀ (t : Ty) (c : Nat), dwf (t.shiftT c) = dwf t := by
  intro t
  induction t with
  | prod a b iha ihb => intro c; simp [Ty.shiftT, dwf, iha, ihb]
  | array i e ih => intro c; simp [Ty.shiftT, dwf, ih]
  | mu t ih => intro c; simp [Ty.shiftT, dwf, ih]
  | tvar k => intro c; simp only [Ty.shiftT]; split <;> rfl
  | _ => intro c; simp [Ty.shiftT, dwf]

theorem dwf_substT : ∀ (t : Ty) (j : Nat) (s : Ty), dwf s = true → dwf t = true →
    dwf (Ty.substT j s t) = true := by
  intro t
  induction t with
  | prod a b iha ihb =>
      intro j s hs ht; simp only [dwf, Bool.and_eq_true] at ht
      simp [Ty.substT, dwf, iha j s hs ht.1, ihb j s hs ht.2]
  | array i e ih => intro j s hs ht; simp only [dwf] at ht; simp [Ty.substT, dwf, ih j s hs ht]
  | mu t ih =>
      intro j s hs ht; simp only [dwf] at ht
      simp only [Ty.substT, dwf]
      exact ih (j + 1) (s.shiftT 0) (by rw [dwf_shiftT]; exact hs) ht
  | tvar k =>
      intro j s hs _; simp only [Ty.substT]
      split
      · exact hs
      · split <;> rfl
  | _ => intro j s _ ht; revert ht; simp [Ty.substT, dwf]

theorem dwf_unfold {ρ : Nat → Nat} {W : Nat → Ty} (hW : ∀ k, Clo (W k)) {s : Ty}
    (h : dwf (cl ρ W 0 0 (.mu s)) = true) : dwf (cl ρ W 0 0 (unfold1 (.mu s))) = true := by
  rw [cl_unfold1 hW, cl_mu_eq]
  rw [cl_mu_eq] at h
  exact dwf_substT _ 0 _ h (by simp only [dwf] at h; exact h)

theorem AtOff_dwf {U V : Ty} {d : Nat} (hV : dwf V = false) (hVm : ∀ t, V ≠ .mu t)
    (h : AtOff U d V) : dwf U = false := by
  induction h with
  | here _ => exact hV
  | fst _ ih => simp [dwf, ih hV hVm]
  | snd _ _ ih => simp [dwf, ih hV hVm]
  | elem _ _ _ ih => simp [dwf, ih hV hVm]
  | mu hW _ _ ih =>
      cases e : dwf (cl _ _ 0 0 (.mu _))
      · rfl
      · have := dwf_unfold hW e; rw [ih hV hVm] at this; cases this
  | fold _ _ _ _ _ => exact absurd (cl_mu_eq _ _ _) (hVm _)

theorem AtOff_wordFree_disj {T U : Ty} {o o' : Nat} {us : List Acc} {r : Idx} {P : Proto}
    (hP : P.ghost = false) (h1 : AtOff T o U) (hdw : dwf U = true) (hus : accs U = some us)
    (h2 : AtOff T o' (.word r P)) : o' < o ∨ o + nWords us ≤ o' := by
  have := AtOff_disj (Solid_word r P) (accs_word hP) h1 hus h2
    (fun d hd => by rw [AtOff_dwf rfl (Solid_word r P).2.2 hd] at hdw; cases hdw)
  have hn : nWords [Acc.one] = 1 := rfl
  rw [hn] at this; omega

theorem AtOff_wordFree_disj2 {T U : Ty} {o o' : Nat} {us : List Acc} {r : Idx} {P : Proto2}
    (h1 : AtOff T o U) (hdw : dwf U = true) (hus : accs U = some us)
    (h2 : AtOff T o' (.word2 r P)) : o' + 2 ≤ o ∨ o + nWords us ≤ o' := by
  have := AtOff_disj (Solid_word2 r P) accs_word2 h1 hus h2
    (fun d hd => by rw [AtOff_dwf rfl (Solid_word2 r P).2.2 hd] at hdw; cases hdw)
  simpa [nWords, Acc.size] using this

/-! ## Counterexamples to the head-only and ghost-free-less forms -/

/-- Head-only `wordFree` admits a pair holding a word at offset 0. -/
theorem wordFree_counterexample (r : Idx) (P : Proto) (hP : P.ghost = false) :
    Ty.wordFree (.prod (.word r P) .int) = true ∧
    AtOff (.prod (.word r P) .int) 0 (.prod (.word r P) .int) ∧
    AtOff (.prod (.word r P) .int) 0 (.word r P) ∧
    accs (.prod (.word r P) .int) = some [.one, .one] := by
  refine ⟨rfl, .here (Or.inl (by simp [accs, hP])), .fst (.here (Or.inl (by simp [accs, hP]))), ?_⟩
  simp [accs, hP]

/-- Two different ghost words share an offset. -/
theorem ghost_counterexample (P : Proto) (hP : P.ghost = true) :
    AtOff (.prod (.word (.lit 0) P) (.word (.lit 1) P)) 0 (.word (.lit 0) P) ∧
    AtOff (.prod (.word (.lit 0) P) (.word (.lit 1) P)) 0 (.word (.lit 1) P) := by
  have ha : accs (.word (.lit 0) P) = some [] := by simp [accs, hP]
  refine ⟨.fst (.here (Or.inl (by simp [accs, hP]))), ?_⟩
  have := AtOff.snd (a := .word (.lit 0) P) (o := 0) ha (.here (Or.inl (by simp [accs, hP])) :
    AtOff (.word (.lit 1) P) 0 (.word (.lit 1) P))
  simpa [nWords] using this


/-! ### (P4 step 3, W3) Frame-internal word steps, with credits -/

/-- The credits read only memory and the promises. -/
theorem PromCr_eqs {E : TEnv} {s s' : St} {cr db : Ts → Res} (h : PromCr E s cr db)
    (e1 : s'.mem = s.mem) (e2 : s'.promises = s.promises) : PromCr E s' cr db := by
  unfold PromCr; rw [e1, e2]; exact h

theorem pSum_eqp {s s' : St} (f : Ts → Res) (e : s'.promises = s.promises) : pSum s' f = pSum s f := by
  unfold pSum; rw [e]

/-- (P4) A step that keeps memory and the promises: memory's holding and the
credits carry over; the frame's bound moves by the step's exchange `C → F`. -/
theorem mc_keep {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem mem' : Memory} {pairs pairs' : List Ts} {th th' : TTh}
    {η : TEnv} {Tot Rf Rs H C F : Res} {cr db : Ts → Res}
    (hT : ThInvRE p (CE η) th' Tot) (hm' : MemInv g (CE η) (stOf mem' pairs' th'))
    (e1 : (stOf mem' pairs' th').mem = (stOf mem pairs th).mem)
    (e2 : (stOf mem' pairs' th').promises = (stOf mem pairs th).promises)
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hM : MintStepN g η (stOf mem pairs th) (stOf mem' pairs' th') C F) (hle : Tot + C ≤ Rf + Rs + F) :
    ∃ Tot H' C F, ThInvMCFS p g (CE η) (stOf mem pairs th) Sp mem' pairs' th' Tot H' cr db ∧
      MintStepN g η (stOf mem pairs th) (stOf mem' pairs' th') C F ∧
      Tot + H' + pSum (stOf mem' pairs' th') cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf mem' pairs' th') db + F := by
  refine ⟨Tot, H, C, F, ⟨CE η, EFoot_refl, (by seenT), (by boxT), hT, hm', MemHeldK_eqs hH e1 e2, PromCr_eqs hC e1 e2⟩, hM, ?_⟩
  rw [pSum_eqp cr e2, pSum_eqp db e2]
  intro k
  have h1 := hle k
  simp only [Res.add_apply] at h1 ⊢
  omega

/-- (claim export) `mc_keep` at a frame step's `MintStep` (possibly `claim`). -/
theorem mc_keepM {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem mem' : Memory} {pairs pairs' : List Ts} {th th' : TTh}
    {η : TEnv} {Tot Rf Rs H C F : Res} {cr db : Ts → Res}
    (hT : ThInvRE p (CE η) th' Tot) (hm' : MemInv g (CE η) (stOf mem' pairs' th'))
    (e1 : (stOf mem' pairs' th').mem = (stOf mem pairs th).mem)
    (e2 : (stOf mem' pairs' th').promises = (stOf mem pairs th).promises)
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hM : MintStep g η (stOf mem pairs th) (stOf mem' pairs' th') C F) (hcl : ClaimAt th.term C F) (hle : Tot + C ≤ Rf + Rs + F) :
    ∃ Tot H' C F, ThInvMCFS p g (CE η) (stOf mem pairs th) Sp mem' pairs' th' Tot H' cr db ∧
      MintStep g η (stOf mem pairs th) (stOf mem' pairs' th') C F ∧ ClaimAt th.term C F ∧
      Tot + H' + pSum (stOf mem' pairs' th') cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf mem' pairs' th') db + F := by
  refine ⟨Tot, H, C, F, ⟨CE η, EFoot_refl, (by seenT), (by boxT), hT, hm', MemHeldK_eqs hH e1 e2, PromCr_eqs hC e1 e2⟩, hM, hcl, ?_⟩
  rw [pSum_eqp cr e2, pSum_eqp db e2]
  intro k
  have h1 := hle k
  simp only [Res.add_apply] at h1 ⊢
  omega

/-- **(P4) `mkWord`, with credits**: the token's region key moves into the new
word value, which holds it (a holding clause); memory is unchanged. -/
theorem tstepMC_mkWord {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x rn : String} {P : Proto} {v tk : At} {e : Expr}
    {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.mkWord rn P v tk) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hng : P.ghost = false)
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | mkWordGhost _ _ _ _ _ _ _ hg =>
    rw [hng] at hg; cases hg
  | mkWord hidx hpwf hu heq hv hst hcl hng' hho hb =>
  rename_i c₁ r r' j k c cl
  obtain ⟨rt0, ws0, R0, Rr, -, -, -, hR0, hi1, hle⟩ := useR hu hi hE.2.2
  have hR : R0 = .one (.rg (ev ρ r)) + .one (.wd (ev ρ r)) := by
    simp only [VRR, tokWd_none] at hR0; rw [hR0, heq ρ hi1.1.1]
  obtain ⟨tv, htvk, hio⟩ := hv
  obtain ⟨rt, w, hea, hwv, -⟩ := atom_num hi1.1.2.1 htvk hio
  have key : tstep g mem pairs th =
      [((stOf mem pairs th).mem, (stOf mem pairs th).pairs,
        withS { th with term := e, env := (x, .word (.lit 0) P, [w]) :: th.env } (stOf mem pairs th))] := by
    simp only [tstep, hterm, evalOp, hng, hea]; rfl
  rw [key]
  refine ⟨by simp, fun r0 hr => ?_⟩
  simp only [List.mem_singleton] at hr
  subst hr
  obtain ⟨cl', hcl', hent⟩ := hst
  rw [hcl] at hcl'; cases hcl'
  have hn := hent ρ hi1.1.1
  have hvr : VRR ρ η (.word r P) (shp (.word (.lit 0) P)) [w] (.one (.rg (ev ρ r)) + wdW P (ev ρ r)) := by
    simp only [VRR]
    refine ⟨⟨hpwf, fun _ => ⟨_, by simp [hwv], _, cl, _, hcl, hn⟩⟩, Or.inl ⟨?_, by first | rfl | trivial⟩⟩
    exact ⟨hng, ev ρ j, c, cl, ev ρ k, by simp [hwv], hcl, hho, hn⟩
  have hfr := bindR hb hi1 (RLink_of hE.2.1 hE.2.2) hvr (Lay_word th.σs r P hng w)
  have hfr' : FInvR ρ η th.σs (ResumeR p th.stack Rs) c' ((x, .word (.lit 0) P, [w]) :: th.env) Rf :=
    FInvR_mono hfr (frame_trade hle (by rw [hR]; exact tokNone_pays P _ _ (Res.le_refl _)))
  refine mc_keep (C := .zero) (F := .zero) ⟨ρ, η, c', Rf, Rs, rfl, hE, ⟨he, hck⟩, htv', by simpa [withS] using hfr', rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩
    (by rw [stOf_withS]; exact hm) (by rw [stOf_withS]) (by rw [stOf_withS]) hH hC .none ?_
  first | exact Res.le_refl _ | (rw [Res.add_zero, Res.add_zero]; exact Res.le_refl _)

/-- **(P4) ghost `mkWord`, with credits**: the token stays in the frame (now
tagged with the word's state); the ghost word holds nothing. -/
theorem tstepMC_mkWordGhost {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x rn : String} {P : Proto} {v tk : At} {e : Expr}
    {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.mkWord rn P v tk) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hg : P.ghost = true)
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | mkWord _ _ _ _ _ _ _ hng _ _ => rw [hg] at hng; cases hng
  | mkWordGhost hidx hpwf hu heq hv hst hcl hg' hho hb =>
  rename_i c₁ r r' j k c cl
  obtain ⟨rt0, ws0, R0, Rr, -, -, -, hR0, hi1, hle⟩ := useR hu hi hE.2.2
  have hR : R0 = .one (.rg (ev ρ r)) + .one (.wd (ev ρ r)) := by
    simp only [VRR, tokWd_none] at hR0; rw [hR0, heq ρ hi1.1.1]
  have key : tstep g mem pairs th =
      [((stOf mem pairs th).mem, (stOf mem pairs th).pairs,
        withS { th with term := e, env := (x, .prod (.word (.lit 0) P) (.tok (.lit 0) none), []) :: th.env }
          (stOf mem pairs th))] := by
    simp only [tstep, hterm, evalOp, hg]; rfl
  rw [key]
  refine ⟨by simp, fun r0 hr => ?_⟩
  simp only [List.mem_singleton] at hr
  subst hr
  have hvr : VRR ρ η (.prod (.word r P) (.tok r (some (P, j))))
      (shp (.prod (.word (.lit 0) P) (.tok (.lit 0) none))) [] (wdW P (ev ρ r) + .one (.rg (ev ρ r))) := by
    simp only [VRR]
    refine ⟨_, _, rfl, wdW P (ev ρ r), .one (.rg (ev ρ r)), rfl, fun hn => ?_, fun n hn => ?_⟩
    · simp [shp_wc, wc, accs, hg, nWords] at hn
    · simp [shp_wc, wc, accs, hg, nWords] at hn
      subst hn
      refine ⟨by simp, ⟨⟨hpwf, fun h => by rw [hg] at h; cases h⟩, Or.inr ⟨fun h => ?_, by first | rfl | trivial⟩⟩,
        by first | rfl | trivial⟩
      have h1 := h.1; rw [hg] at h1; cases h1
  have hl2 := Lay_pair (Lay_wordGhost th.σs r P hg) (Lay_tokGhost th.σs r P j)
  have hfr := bindR hb hi1 (RLink_of hE.2.1 hE.2.2) hvr hl2
  have hfr' : FInvR ρ η th.σs (ResumeR p th.stack Rs) c'
      ((x, .prod (.word (.lit 0) P) (.tok (.lit 0) none), []) :: th.env) Rf :=
    FInvR_mono hfr (frame_trade hle (by
      rw [hR]; exact fun k => by have := wdW_le P (ev ρ r) k; simp only [Res.add_apply] at *; omega))
  refine mc_keep (C := .zero) (F := .zero) ⟨ρ, η, c', Rf, Rs, rfl, hE, ⟨he, hck⟩, htv', by simpa [withS] using hfr', rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩
    (by rw [stOf_withS]; exact hm) (by rw [stOf_withS]) (by rw [stOf_withS]) hH hC .none ?_
  first | exact Res.le_refl _ | (rw [Res.add_zero, Res.add_zero]; exact Res.le_refl _)

/-- **(P4) `load` of a protocol word through an own reference, with credits**:
the state value binds as `Int[x]`, carrying nothing; memory unchanged. -/
theorem tstepMC_loadWordOwn {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {acq : Bool} {a : At} {r : Idx} {P : Proto}
    {e : Expr} {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.load acq a) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.ptr .own (.word r P)))
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hi0 := hi.1
  have hRk := OpT_retSk hop
  cases hop with
  | loadOwn hp hnw _ _ _ | loadPub hp hnw _ _ _ _ | loadRgn hp hnw _ _ _ _ | loadCap hp hnw _ _ _ _ _
  | loadTorn hp hnw _ _ _ _ => exfalso; rw [hpk] at hp; cases hp; simp [wordOf] at hnw
  | loadWord hp hw hg hb =>
  rw [hpk] at hp; cases hp
  simp only [wordOf, Option.some.injEq] at hw; subst hw
  obtain ⟨lab, c, pw, ru, hea, hpw, hsto, hcty, hacc, hown, hsku, hsig⟩ :=
    ownPtr_view hi0 hpk htv (by simp [Cx.opaqueOK, Ty.guardT])
  have hna : ∀ N e', c.ty ≠ .array (.lit N) e' := fun N e' h => hacc (by rw [h]; simp [accs])
  obtain ⟨us, hus, ⟨ro, hro⟩, hld, hstw⟩ := ownLoad (arch := g.arch) (pw := pw) (acq := acq) (s := stOf mem pairs th)
    hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hsto hown (Fd_lay hcty).1 (Fd_lay hcty).2.1
    (fun ws => ((Fd_lay hcty).2.2.2 ws).1) (fun R ws => (Fd_VR η hcty).1) hna hsku
    (peek_cell_lyt hi0.2.1 hpk hea rfl rfl).2 hsig
    (by rw [(Fd_lay hcty).2.2.1]; exact pub_accs hi0.2.2.2.1 hi0.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi0.2.1 htv hpk rfl (by simp [Cx.opaqueOK, Ty.guardT]) hea rfl)
  obtain ⟨r', rfl⟩ := eskel_word (show etok (skel ru) = .word (.lit 0) P by rw [hsku]; rfl)
  have key : tstep g mem pairs th =
      (loadUnits g.arch pw ⟨lab, 0⟩ acq us 0 (stOf mem pairs th)).map fun (s', ws) =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, .int, ws) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, cellOf, addrOf, hpw, wordOf, Option.isSome_some,
      ↓reduceIte, hus, List.map_map]; rfl
  rw [key] at ⊢
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hro), fun r0 hr hpr0 => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨⟨s', wsr⟩, hl, rfl⟩ := hr
  obtain ⟨hvr, -, f1, f2, f3, f4, f5⟩ := hld (s', wsr) hl (hpr0)
  obtain ⟨w, n, rfl, hvr'⟩ := word_bind hg hvr
  have hfr := bindR0 hb (pushR x n hi) hvr' (Lay_int w rfl) trivial
  refine mc_keep (C := .zero) (F := .zero) ⟨vcons n ρ, η, c', Rf, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩
    (MemInv_load hm f1 f2 f3 f4 f5 (loadUnits_relSt _ _ _ _ hl) (loadUnits_vWr _ _ _ _ hl)) f1 f4 hH hC .none ?_
  first | exact Res.le_refl _ | (rw [Res.add_zero, Res.add_zero]; exact Res.le_refl _)

/-- **(P4) `load` of a protocol word through a `pub` reference, with
