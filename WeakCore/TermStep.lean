/-! ## The owner's next read of a piece, and when a piece is overtaken

Timestamp level, generic in the promise lists: `P` the owner's outstanding
promises, `Q a` what the shared reading skips at `a` (`PromAt E s a`). -/

/-- The shared reading's message at `a`: the latest one not in `Q`. -/
def ReadTs (mem : Memory) (Q : List Ts) (a : Address) (t : Ts) : Prop :=
  t ∉ Q ∧ (∃ m, mem[t]? = some m ∧ m.loc = a) ∧
    ∀ (t' : Ts) (m' : Msg), t < t' → mem[t']? = some m' → m'.loc = a → t' ∈ Q

/-- `t` is the message at `a` just before `t'`. -/
def PredTs (mem : Memory) (a : Address) (t' t : Ts) : Prop :=
  t < t' ∧ (∃ m, mem[t]? = some m ∧ m.loc = a) ∧
    ∀ (t'' : Ts) (m' : Msg), t < t'' → t'' < t' → mem[t'']? = some m' → m'.loc ≠ a

/-- `t` is the lowest promise of `P` at `a`. -/
def LowestIn (mem : Memory) (P : List Ts) (a : Address) (t : Ts) : Prop :=
  t ∈ P ∧ (∃ m, mem[t]? = some m ∧ m.loc = a) ∧
    ∀ t', t' ∈ P → (∃ m, mem[t']? = some m ∧ m.loc = a) → t ≤ t'

/-- Unit `a` is overtaken: the reading is not what the owner's fulfilling RMW of
its lowest promise there reads. -/
def OverU (mem : Memory) (P Q : List Ts) (a : Address) : Prop :=
  ∃ t t', ReadTs mem Q a t ∧ LowestIn mem P a t' ∧ ¬ PredTs mem a t' t

/-- The piece at units `b .. b+n-1` of `l` is overtaken at some unit. -/
def Over (mem : Memory) (P : List Ts) (Q : Address → List Ts) (l : AllocLabel) (b n : Nat) : Prop :=
  ∃ o, o < n ∧ OverU mem P (Q ⟨l, b + o⟩) ⟨l, b + o⟩

/-- What the owner's next RMW of the units from `b` reads: at a unit with an own
promise, the predecessor of the lowest; elsewhere the reading. -/
def PredWords (mem : Memory) (P : List Ts) (Q : Address → List Ts) (l : AllocLabel) (b : Nat)
    (ws : List Word) : Prop :=
  ∀ o w, ws[o]? = some w →
    (∃ t', LowestIn mem P ⟨l, b + o⟩ t' ∧ PredAt mem ⟨l, b + o⟩ t' w) ∨
      ((∀ t', ¬ LowestIn mem P ⟨l, b + o⟩ t') ∧ LatestNP mem (Q ⟨l, b + o⟩) ⟨l, b + o⟩ w)

theorem ReadTs_of_LatestNP {mem : Memory} {Q : List Ts} {a : Address} {w : Word} (h : LatestNP mem Q a w) :
    ∃ t m, ReadTs mem Q a t ∧ mem[t]? = some m ∧ mw m = w := by
  obtain ⟨t, m, hq, hm, hl, hw, hlast⟩ := h
  exact ⟨t, m, ⟨hq, ⟨m, hm, hl⟩, hlast⟩, hm, hw⟩

theorem ReadTs_uniq {mem : Memory} {Q : List Ts} {a : Address} {t t' : Ts}
    (h : ReadTs mem Q a t) (h' : ReadTs mem Q a t') : t = t' := by
  obtain ⟨hq, ⟨m, hm, hl⟩, hlast⟩ := h
  obtain ⟨hq', ⟨m', hm', hl'⟩, hlast'⟩ := h'
  rcases Nat.lt_trichotomy t t' with hlt | e | hlt
  · exact absurd (hlast t' m' hlt hm' hl') hq'
  · exact e
  · exact absurd (hlast' t m hlt hm hl) hq

/-- **`PredWords_eq_read`**: a piece that is not overtaken is read by its owner's
next RMW as the shared reading reads it. -/
theorem PredWords_eq_read {mem : Memory} {P : List Ts} {Q : Address → List Ts} {l : AllocLabel} {b n : Nat}
    {ws : List Word} (hO : ¬ Over mem P Q l b n) (hn : ws.length = n)
    (hr : ∀ o w, ws[o]? = some w → LatestNP mem (Q ⟨l, b + o⟩) ⟨l, b + o⟩ w) :
    PredWords mem P Q l b ws := by
  intro o w hw
  have ho : o < n := by
    rw [← hn]; exact (List.getElem?_eq_some_iff.1 hw).1
  by_cases hlo : ∃ t', LowestIn mem P ⟨l, b + o⟩ t'
  · obtain ⟨t', ht'⟩ := hlo
    refine Or.inl ⟨t', ht', ?_⟩
    obtain ⟨t, m, hrt, hm, hmw⟩ := ReadTs_of_LatestNP (hr o w hw)
    have hp : PredTs mem ⟨l, b + o⟩ t' t :=
      Classical.byContradiction fun hnp => hO ⟨o, ho, t, t', hrt, ht', hnp⟩
    obtain ⟨hlt, ⟨m0, hm0, hl0⟩, hbet⟩ := hp
    rw [hm] at hm0; cases hm0
    exact ⟨t, m, hlt, hm, hl0, hmw, hbet⟩
  · exact Or.inr ⟨fun t' h => hlo ⟨t', h⟩, hr o w hw⟩

/-- **`OverU_mono`**: memory extended (a prefix kept, the owner's promises in it),
the owner's promises unchanged, and the reading at `a` either unchanged or moved
above every own promise at `a`: an overtaken unit stays overtaken. -/
theorem OverU_mono {mem mem' : Memory} {P Q Q' : List Ts} {a : Address}
    (hpre : ∀ t, t < mem.size → mem'[t]? = mem[t]?) (hP : ∀ t, t ∈ P → t < mem.size)
    (hrd : ∀ t, ReadTs mem' Q' a t → ReadTs mem Q a t ∨
      ∀ t', t' ∈ P → (∃ m, mem[t']? = some m ∧ m.loc = a) → t' < t)
    (hex : ∃ t, ReadTs mem' Q' a t) (h : OverU mem P Q a) : OverU mem' P Q' a := by
  obtain ⟨t, t', hrt, ⟨htP, ⟨m', hm', hl'⟩, hlow⟩, hnp⟩ := h
  obtain ⟨t2, hrt2⟩ := hex
  have hs' := hP t' htP
  have hlow' : LowestIn mem' P a t' := by
    refine ⟨htP, ⟨m', by rw [hpre t' hs']; exact hm', hl'⟩, fun t'' h1 ⟨m'', h2, h3⟩ => hlow t'' h1 ⟨m'', ?_, h3⟩⟩
    rw [← hpre t'' (hP t'' h1)]; exact h2
  refine ⟨t2, t', hrt2, hlow', fun hp2 => ?_⟩
  rcases hrd t2 hrt2 with h0 | habove
  · obtain rfl := ReadTs_uniq h0 hrt
    apply hnp
    obtain ⟨hlt, ⟨m0, hm0, hl0⟩, hbet⟩ := hp2
    refine ⟨hlt, ⟨m0, by rw [← hpre t2 (Nat.lt_trans hlt hs')]; exact hm0, hl0⟩, fun t'' m'' h1 h2 h3 => ?_⟩
    exact hbet t'' m'' h1 h2 (by rw [hpre t'' (Nat.lt_trans h2 hs')]; exact h3)
  · exact absurd (Nat.lt_trans (habove t' htP ⟨m', hm', hl'⟩) hp2.1) (Nat.lt_irrefl _)

/-- **`Over_mono`**: the same, unit by unit over a piece. -/
theorem Over_mono {mem mem' : Memory} {P : List Ts} {Q Q' : Address → List Ts} {l : AllocLabel} {b n : Nat}
    (hpre : ∀ t, t < mem.size → mem'[t]? = mem[t]?) (hP : ∀ t, t ∈ P → t < mem.size)
    (hrd : ∀ o, o < n → ∀ t, ReadTs mem' (Q' ⟨l, b + o⟩) ⟨l, b + o⟩ t →
      ReadTs mem (Q ⟨l, b + o⟩) ⟨l, b + o⟩ t ∨
        ∀ t', t' ∈ P → (∃ m, mem[t']? = some m ∧ m.loc = ⟨l, b + o⟩) → t' < t)
    (hex : ∀ o, o < n → ∃ t, ReadTs mem' (Q' ⟨l, b + o⟩) ⟨l, b + o⟩ t)
    (h : Over mem P Q l b n) : Over mem' P Q' l b n := by
  obtain ⟨o, ho, hu⟩ := h
  exact ⟨o, ho, OverU_mono hpre hP (hrd o ho) (hex o ho) hu⟩

/-! ### Plant credits

A promise of the thread at a non-word unit of a planted piece of one of its
own frontier cells may carry a **plant credit**: what its owner's next RMW of
the piece reads, when the piece is overtaken (`Over`).  Built at the system
level (`TermPlant`); a thread step drops it (`dropP`, `tstepMCF_stepP`). -/

/-- The credit clause of `PromCr` at promise `tw` (message `m`). -/
def OldCr (E : TEnv) (s : St) (m : Msg) (tw : Ts) (R : Res) : Prop :=
  (∃ w, PredAt s.mem m.loc tw w ∧ VRes E m.loc w R) ∨ ((∀ w, ¬ PredAt s.mem m.loc tw w) ∧ R = .zero)

/-- (§11) The **window** of a promise list below bound `wb`. -/
def winL (wb : Ts) (P : List Ts) : List Ts := P.filter (fun t => decide (t ≤ wb))

/-- (§11) **Pinned words**: at every word `o` (of the piece at word `b` of
`l`, layout `us`) in an access unit chosen by `K`, `ws` has the word just
before the lowest promise of `W` there, if any.  Prefix-stable: memory only
grows, so `PredAt` and `LowestIn` (for unchanged `W`) never change. -/
def PinW (mem : Memory) (W : List Ts) (l : AllocLabel) (b : Nat) (us : List Acc) (K : Nat → Bool)
    (ws : List Word) : Prop :=
  ∀ i o w t', K i = true → InAcc us i o → ws[o]? = some w → LowestIn mem W ⟨l, b + o⟩ t' →
    PredAt mem ⟨l, b + o⟩ t' w

/-- (§11) **A plant credit** `R` at promise `tw` (message `m`): `m` lies in
the non-word solid piece `S` (layout `us`, from word `sb + b0`) of an own cell
with a frontier; for a window bound `wb` (above `tw`, inside memory, below
every foreign promise at the cell skipped by the thread), `tw` is the
thread's lowest window promise in the piece; and `R` is at least the
resources of a value of `S` whose words at the access units `K` are pinned
(`PinW`) to what the owner's fulfilling RMWs of the window promises there
read, or nothing.  No `Over`, no current reading: prefix-stable.  Which units
are overtaken, and that `K` covers them, is the separate completeness
predicate (`TermPlant.PlantCrC`). -/
def PlantCr (E : TEnv) (s : St) (m : Msg) (tw : Ts) (R : Res) : Prop :=
  ∃ c sb S0 b0 S us wb, E.sto m.loc.label = some c ∧ c.owner = some E.tid ∧ E.pfr m.loc.label ≠ none ∧
    SegOf c.ty sb S0 ∧ AtOff S0 b0 S ∧ Solid S ∧ ¬ WordUnit E m.loc ∧ accs S = some us ∧ 0 < nWords us ∧
    sb + b0 ≤ m.loc.offset ∧ m.loc.offset < sb + b0 + nWords us ∧ tw ≤ wb ∧ wb < s.mem.size ∧
    (∀ tf mf, tf ∈ FpAt E ⟨m.loc.label, 0⟩ → s.mem[tf]? = some mf → mf.loc.label = m.loc.label → wb < tf) ∧
    (∀ t' m', t' ∈ s.promises → s.mem[t']? = some m' → m'.loc.label = m.loc.label →
      sb + b0 ≤ m'.loc.offset → m'.loc.offset < sb + b0 + nWords us → t' ≤ wb → tw ≤ t') ∧
    ((∃ K ws R0, ws.length = nWords us ∧ ValOfR E S ws R0 ∧ R0 ≤ R ∧
        PinW s.mem (winL wb s.promises) m.loc.label (sb + b0) us K ws) ∨
      R = .zero)

/-- **`PromCr′`**: each own promise carries its `PromCr` credit or a
plant credit. -/
def PromCrP (E : TEnv) (s : St) (cr db : Ts → Res) : Prop :=
  ∀ tw, tw ∈ s.promises → ∃ m, s.mem[tw]? = some m ∧ DbRes E s.mem m tw (db tw) ∧
    (OldCr E s m tw (cr tw) ∨ PlantCr E s m tw (cr tw))

theorem PromCrP_of {E : TEnv} {s : St} {cr db : Ts → Res} (h : PromCr E s cr db) : PromCrP E s cr db :=
  fun tw htw => let ⟨m, hm, hd, hc⟩ := h tw htw; ⟨m, hm, hd, Or.inl hc⟩

theorem WordUnit_of_WordAt {E : TEnv} {a : Address} {n : Nat} {P : Proto} (h : WordAt E a n P) :
    WordUnit E a :=
  let ⟨c, hc, hA, hg⟩ := h; ⟨c, hc, Or.inl ⟨_, P, hg, hA⟩⟩

/-- At a non-word unit the `PromCr` clause holds with no credit. -/
theorem OldCr_zero {E : TEnv} {s : St} {m : Msg} {tw : Ts} (hw : ¬ WordUnit E m.loc) :
    OldCr E s m tw .zero := by
  by_cases hp : ∃ w, PredAt s.mem m.loc tw w
  · obtain ⟨w, hw'⟩ := hp
    refine Or.inl ⟨w, hw', ?_⟩
    have hR : WRes E m.loc w .zero := Or.inr ⟨fun n P hA _ => hw (WordUnit_of_WordAt hA), rfl⟩
    by_cases hv : Vis E m.loc.label ∧ IniW E m.loc
    · exact Or.inl ⟨hv.1, hv.2, hR⟩
    · exact Or.inr ⟨hv, rfl⟩
  · exact Or.inr ⟨fun w h => hp ⟨w, h⟩, rfl⟩

/-- The credits with plant credits dropped. -/
noncomputable def dropP (E : TEnv) (s : St) (cr : Ts → Res) (t : Ts) : Res := by
  classical
  exact if ∃ m, s.mem[t]? = some m ∧ OldCr E s m t (cr t) then cr t else .zero

theorem dropP_le {E : TEnv} {s : St} {cr : Ts → Res} (t : Ts) : dropP E s cr t ≤ cr t := by
  unfold dropP
  split
  · exact Res.le_refl _
  · exact Res.zero_le _

/-- **Dropping the plant credits** leaves `PromCr`. -/
theorem PromCrP_drop {E : TEnv} {s : St} {cr db : Ts → Res} (h : PromCrP E s cr db) :
    PromCr E s (dropP E s cr) db := by
  intro tw htw
  obtain ⟨m, hm, hd, hc⟩ := h tw htw
  refine ⟨m, hm, hd, ?_⟩
  show OldCr E s m tw (dropP E s cr tw)
  unfold dropP
  split
  next h1 =>
    obtain ⟨m', hm', ho⟩ := h1
    rw [hm] at hm'; cases hm'; exact ho
  next h1 =>
    rcases hc with ho | ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, hw, _⟩
    · exact absurd ⟨m, hm, ho⟩ h1
    · exact OldCr_zero hw

theorem pSum_dropP_le {E : TEnv} {s s0 : St} {cr : Ts → Res} : pSum s (dropP E s0 cr) ≤ pSum s cr :=
  sum_map_le _ fun t _ => dropP_le t

/-- **`tstepMCF_step` at `PromCr′`**: the step drops the plant credits. -/
theorem tstepMCF_stepP {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {Rf Rs H : Res} {cr db : Ts → Res}
    [ProgRetIall p] [TermA4.ProgCkWC p] (hP : ProgT p) (hp : g.p = p) (hn : 0 < g.n) (hnd : isDone th = false)
    (hsc : StepScope cx th.term ∨ StepScopeR th.σs cx th.term)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hpx : PAx g mem pairs th) (hC : PromCrP (CE η) (stOf mem pairs th) cr db)
    (hia : StoreIall ρ η cx th)
    (hdw : StoreCrZ η cx (stOf mem pairs th) th) (hnvp : OwnOpT cx th.term → OwnNVPF (CE η) (stOf mem pairs th))
    (hwp : ∀ x a e rt ws ad, th.term = .let_ x (.publish a) e → evalAt th.env a = some (rt, ws) →
      ws.map (·.val) = [.loc ad 0] → FlipOK (CE η) (stOf mem pairs th) ad.label)
    (hwin : PubWinT (CE η) (stOf mem pairs th) th)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRF : OwnFrontierRMWT (CE η) (stOf mem pairs th) th.term) (hrmw : NoPlantRMW (CE η) th) (hbf : g.boxFence = true) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hSub : PwSubS) (hSig : PwSig) (hown1 : PubLe1 th Rf Rs H := by assumption)
    (hZ : ZOK g (CE η) th := by exact fun _ _ h => False.elim h)
    (hPb : ∀ y a e rt ws ad, th.term = .let_ y (.publish a) e → evalAt th.env a = some (rt, ws) →
      ws.map (·.val) = [.loc ad 0] → g.pf ad.label := by exact fun _ _ _ _ _ _ _ _ _ => trivial) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F cr' db',
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr' db' ∧ MintStep g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧ ClaimAtP th C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr' + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db' + F := by
  obtain ⟨hne, hall⟩ := tstepMCF_stepL (hZ := hZ) (hPb := hPb) hP hp hn hnd hsc hT hCk hi hE htv hm hH hpx (PromCrP_drop hC) hia hdw hnvp
    hwp hwin hfo hRF hrmw hbf hRP hPS hSub hSig
  refine ⟨hne, fun r hr hpa => ?_⟩
  obtain ⟨Tot, H', C, F, cr', db', h1, h2, hcl, h3⟩ := hall r hr hpa
  exact ⟨Tot, H', C, F, cr', db', h1, h2, hcl, Res.le_trans h3
    (Res.add_le_add (Res.add_le_add (Res.add_le_add (Res.le_refl _) pSum_dropP_le) (Res.le_refl _)) (Res.le_refl _))⟩


/-! ## (UndefNew) The step's new cells carry `undef` placeholders (B2, `TermUndefZ`)

A protocol word is not zeroable, nor is any type with a word at an offset (`atOff_word_nz`), so
every protocol-word unit of a cell the step allocates has an `undef` message after the step
(`UndefNew_of_EFoot`, from the footprint's `UndefAtT`). -/

/-- Unrolling keeps zeroability: the recursion variable is not zeroable (`onRec = false`). -/
theorem zero_unfold1 (s : Ty) (h : zeroableIn [] [] (.mu s) = true) :
    zeroableIn [] [] (unfold1 (.mu s)) = true := by
  have e1 : unfold1 (.mu s) = substTs [.mu s] 0 0 s := substT_eq (.mu s) s 0 0
  rw [e1]
  have h' : zeroableIn [] ([] ++ [none]) s = true := by simpa [zeroableIn] using h
  have hZ : ∀ k, KEnv.ask [none] k false (·.zero) = true →
      ∃ σ, [Ty.mu s][k]? = some σ ∧ zeroableIn [] [] σ = true := by
    intro k hk
    cases k with
    | zero => simp [KEnv.ask] at hk
    | succ k => simp [KEnv.ask] at hk
  have := (KindSound.zero_subst_gen (keS := [none]) (keC := []) (σs := [.mu s]) hZ s [] 0 []).1 h'
  simpa using this

/-- **No type with a protocol word at an offset is zeroable.** -/
theorem atOff_word_nz {T : Ty} {o : Nat} {u : Ty} (h : AtOff T o u) :
    ∀ (r : Idx) (P : Proto), u = .word r P → zeroableIn [] [] T = false := by
  induction h with
  | here _ => intro r P e; subst e; simp [zeroableIn]
  | fst _ ih => intro r P e; simp [zeroableIn, ih r P e]
  | snd _ _ ih => intro r P e; simp [zeroableIn, ih r P e]
  | elem _ _ _ ih => intro r P e; simp [zeroableIn, ih r P e]
  | @mu ρ W s u o hW _ _ ih =>
    intro r P e
    have h1 := ih r P e
    rw [cl_unfold1 hW s] at h1
    cases hz : zeroableIn [] [] (cl ρ W 0 0 (.mu s)) with
    | false => rfl
    | true =>
      have hm : cl ρ W 0 0 (.mu s) = .mu (cl ρ W 1 0 s) := by simp [cl]
      rw [hm] at hz h1
      rw [zero_unfold1 _ hz] at h1
      cases h1
  | @fold ρ W s T o _ _ _ _ _ =>
    intro r P e
    have hm : cl ρ W 0 0 (.mu s) = .mu (cl ρ W 1 0 s) := by simp [cl]
    rw [hm] at e
    cases e

/-- `alloc` (`new`, a box) leaves an `undef` placeholder at every unit of the new label. -/
theorem alloc_undef {k : Promises.Knobs} {arch : WeakMem.Arch} {lbl : WeakMem.AllocLabel} {us : List Acc}
    {ws : List Word} {s s' : St} {pw : Word} (hr : (s', pw) ∈ alloc k arch lbl us ws s) :
    ∀ o, o < nWords us → ∃ (t : Nat) (m : WeakMem.Msg), s'.mem[t]? = some m ∧ m.loc = ⟨lbl, o⟩ ∧
      m.val = .undef := by
  intro o ho
  obtain ⟨s1, hst, -, -, -, -, -, -, -, -, -, hget⟩ := alloc_unf hr
  have h1 : s1.mem[s.mem.size + o]? = some ⟨⟨lbl, o⟩, .undef, 0⟩ := by
    rw [hget]
    have a1 : ¬ (s.mem.size + o < s.mem.size) := by omega
    have a2 : s.mem.size + o < s.mem.size + nWords us := by omega
    simp only [a1, a2, ite_false, ite_true, Nat.add_sub_cancel_left]
  have hx := (TermLiveProps.storeUnits_ext hst).mem
  have hlt : s.mem.size + o < s1.mem.size := by
    cases hq : s1.mem[s.mem.size + o]? with
    | none => rw [hq] at h1; cases h1
    | some _ => exact (Array.getElem?_eq_some_iff.1 hq).1
  refine ⟨s.mem.size + o, ⟨⟨lbl, o⟩, .undef, 0⟩, ?_, rfl, rfl⟩
  show (s', pw).1.mem[s.mem.size + o]? = _
  rw [hx.get _ hlt]; exact h1

/-- `allocBuf` without a zero (`newBuf` at a non-zeroable element) leaves an `undef` placeholder at
every unit. -/
theorem allocBuf_undef (lbl : WeakMem.AllocLabel) (n : Nat) (s : St) :
    ∀ o, o < n → ∃ (t : Nat) (m : WeakMem.Msg), (allocBuf lbl n none s).1.mem[t]? = some m ∧
      m.loc = ⟨lbl, o⟩ ∧ m.val = .undef := by
  intro o ho
  refine ⟨s.mem.size + o, ⟨⟨lbl, o⟩, .undef, 0⟩, ?_, rfl, rfl⟩
  rw [allocBuf_mem]
  have h := TermLiveProps.fold_get (fun j => (⟨offs ⟨lbl, 0⟩ j, bufVal none j, 0⟩ : WeakMem.Msg))
    (List.range n) s.mem o (by simp; exact ho)
  rw [h]
  simp [offs, bufVal]

/-- `newBuf`'s zero: none at an element type with a protocol word at an offset. -/
theorem newBuf_z_none {e : Ty} {o : Nat} {r : Idx} {P : Proto} (h : AtOff e o (.word r P)) :
    (if zeroableIn [] [] e then zeroWords e else none) = none := by
  rw [atOff_word_nz h r P rfl]; rfl

/-- **`UndefNew`**: every protocol-word unit of a cell allocated by the step has an `undef`
message after it. -/
def UndefNew (g : G) (s s' : St) (E' : TEnv) : Prop :=
  ∀ (l : WeakMem.AllocLabel) (c : Cell), FreshIn g s.nalloc s'.nalloc l → E'.sto l = some c →
    ∀ (o n : Nat) (P : Proto), AtOff c.ty o (.word (.lit n) P) → P.ghost = false →
      ∃ (t : Nat) (m : WeakMem.Msg), s'.mem[t]? = some m ∧ m.loc = ⟨l, o⟩ ∧ m.val = .undef

/-- **`UndefNew` from the footprint**, the fresh labels blank before the step. -/
theorem UndefNew_of_EFoot {W : Ty → Prop} {g : G} {E E' : TEnv} {s s' : St} (hE : EFootB W g E E' s s')
    (hnone : ∀ l, FreshIn g s.nalloc s'.nalloc l → E.sto l = none) : UndefNew g s s' E' := by
  intro l c hl hc o n P hA hg
  rcases hE.2.2.1 l with h | ⟨-, T, hT, -, hU, -⟩
  · rw [h, hnone l hl] at hc; cases hc
  · rw [hT] at hc
    cases hc
    have hA' : AtOff T o (.word (.lit n) P) := hA
    have hw1 : accs (Ty.word (.lit n) P) = some [Acc.one] := by simp [accs, hg]
    have hn1 : nWords [Acc.one] = 1 := rfl
    rcases hU (atOff_word_nz hA' (.lit n) P rfl) with ⟨L, hL, hU⟩ | ⟨K, e, L, rfl, he, hU⟩
    · have hb := AtOff_bound hA' hL hw1
      exact hU o (by omega)
    · rcases AtOff_array_inv (fun t h => by cases h) hA' with ⟨-, h⟩ | ⟨K', j, o2, us, hK, hus, hj, ho, hA2⟩
      · cases h
      · cases hK
        have hUL : L = us := Option.some.inj (he.symm.trans hus)
        subst hUL
        have hb := AtOff_bound hA2 he hw1
        have h2 : (j + 1) * nWords L ≤ K * nWords L := Nat.mul_le_mul_right _ hj
        rw [Nat.succ_mul] at h2
        refine hU o ?_
        rw [ho]
        generalize j * nWords L = a at *
        generalize K * nWords L = b at *
        omega

/-- **`UndefNew` from the footprint at the invariant** (`fresh_blank`). -/
theorem UndefNew_of_EFootM {W : Ty → Prop} {g : G} {E E' : TEnv} {s s' : St} (hm : MemInv g E s) (hE : EFootB W g E E' s s') :
    UndefNew g s s' E' :=
  UndefNew_of_EFoot hE (fun _ hl => (fresh_blank hm hl).1)

/-! ## Resource determinism and own-store exclusion -/

/-- **Resource-deterministic types**: no type variable, `μ`, or index or type
package reachable through `VRR`'s descent, so a value's resources are a function of
its words (`VRR_det`). -/
def DetT : Ty → Bool
  | .prod a b => DetT a && DetT b
  | .sum a b => DetT a && DetT b
  | .refine t _ => DetT t
  | .iall t => DetT t
  | .iex _ | .tex _ _ | .tvar _ | .mu _ => false
  | _ => true

/-- **`VRR` is functional at a `DetT` type**: the same words carry the same
resources. -/
theorem VRR_det (t : Ty) : DetT t = true → ∀ {ρ : Nat → Nat} {η : TEnv} {rt : Shp} {ws : List Word}
    {R R' : Res}, VRR ρ η t rt ws R → VRR ρ η t rt ws R' → R = R' := by
  induction t with
  | prod a b iha ihb =>
    intro hd ρ η rt ws R R' h1 h2
    simp only [DetT, Bool.and_eq_true] at hd
    simp only [VRR] at h1 h2
    obtain ⟨ra, rb, e, Ra, Rb, hR, hz, hh⟩ := h1
    obtain ⟨ra', rb', e', Ra', Rb', hR', hz', hh'⟩ := h2
    rw [e] at e'; cases e'
    cases hw : ra.wc with
    | none => rw [hz hw, hz' hw]
    | some n =>
      obtain ⟨-, a1, b1⟩ := hh n hw
      obtain ⟨-, a2, b2⟩ := hh' n hw
      rw [hR, hR', iha hd.1 a1 a2, ihb hd.2 b1 b2]
  | sum a b iha ihb =>
    intro hd ρ η rt ws R R' h1 h2
    simp only [DetT, Bool.and_eq_true] at hd
    simp only [VRR] at h1 h2
    obtain ⟨n, Ra, Rb, e, h1⟩ := h1
    obtain ⟨n', Ra', Rb', e', h2⟩ := h2
    rw [e] at e'; cases e'
    rcases h1 with ⟨ht, x, s, B, hx, -, hB, hn, -, -, hL, hR⟩ | ⟨j, p, hdj, hL, hR⟩ <;>
      rcases h2 with ⟨ht', x', s', B', hx', -, hB', hn', -, -, hL', hR'⟩ | ⟨j', p', hdj', hL', hR'⟩
    · rw [hx] at hx'
      injection hx' with h0 _
      injection h0 with hxx _
      subst hxx
      rw [hB] at hB'; cases hB'
      rw [hn] at hn'
      obtain rfl : s = s' := by injection hn' with h; omega
      by_cases hj : B.tag - s < (armsOf Ra).length
      · obtain ⟨q1, q2⟩ := hL hj
        obtain ⟨q1', q2'⟩ := hL' hj
        cases hbx : isBoxed Ra
        · obtain ⟨q, c1, -, -, -, c5⟩ := q2 hbx
          obtain ⟨q', c1', -, -, -, c5'⟩ := q2' hbx
          rw [c1] at c1'; cases c1'
          exact iha hd.1 c5 c5'
        · exact iha hd.1 (q1 hbx) (q1' hbx)
      · have hj2 : (armsOf Ra).length ≤ B.tag - s := by omega
        obtain ⟨q1, q2⟩ := hR hj2
        obtain ⟨q1', q2'⟩ := hR' hj2
        cases hbx : isBoxed Rb
        · obtain ⟨q, c1, -, -, -, c5⟩ := q2 hbx
          obtain ⟨q', c1', -, -, -, c5'⟩ := q2' hbx
          rw [c1] at c1'; cases c1'
          exact ihb hd.2 c5 c5'
        · exact ihb hd.2 (q1 hbx) (q1' hbx)
    · rw [ht] at hdj'; simp [decodeArm] at hdj'
    · rw [ht'] at hdj; simp [decodeArm] at hdj
    · rw [hdj] at hdj'; cases hdj'
      by_cases hj : j < (armsOf Ra).length
      · obtain ⟨q, c1, c2⟩ := hL hj
        obtain ⟨q', c1', c2'⟩ := hL' hj
        rw [c1] at c1'; cases c1'
        exact iha hd.1 c2 c2'
      · have hj2 : (armsOf Ra).length ≤ j := by omega
        obtain ⟨q, c1, c2⟩ := hR hj2
        obtain ⟨q', c1', c2'⟩ := hR' hj2
        rw [c1] at c1'; cases c1'
        exact ihb hd.2 c2 c2'
  | refine t ψ ih =>
    intro hd ρ η rt ws R R' h1 h2
    simp only [DetT] at hd
    simp only [VRR] at h1 h2
    exact ih hd h1.1 h2.1
  | iall t ih =>
    intro hd ρ η rt ws R R' h1 h2
    simp only [DetT] at hd
    simp only [VRR] at h1 h2
    exact ih hd (h1 0) (h2 0)
  | word r P =>
    intro _ ρ η rt ws R R' h1 h2
    simp only [VRR] at h1 h2
    obtain ⟨-, h1⟩ := h1
    obtain ⟨-, h2⟩ := h2
    rcases h1 with ⟨a1, e1⟩ | ⟨a1, e1⟩ <;> rcases h2 with ⟨a2, e2⟩ | ⟨a2, e2⟩
    · rw [e1, e2]
    · exact absurd a1 a2
    · exact absurd a2 a1
    · rw [e1, e2]
  | word2 r P =>
    intro _ ρ η rt ws R R' h1 h2
    simp only [VRR] at h1 h2
    obtain ⟨-, h1⟩ := h1
    obtain ⟨-, h2⟩ := h2
    rcases h1 with ⟨a1, e1⟩ | ⟨a1, e1⟩ <;> rcases h2 with ⟨a2, e2⟩ | ⟨a2, e2⟩
    · rw [e1, e2]
    · exact absurd a1 a2
    · exact absurd a2 a1
    · rw [e1, e2]
  | _ =>
    first
    | (intro hd; simp [DetT] at hd; done)
    | (intro _ ρ η rt ws R R' h1 h2
       simp only [VRR] at h1 h2 <;>
       first | exact h1.elim | exact h1.trans h2.symm | exact h1.2.trans h2.2.symm)


/-- **No overwrite at an outstanding promise's unit**: a store whose result
keeps `PromAbove`, at a unit carrying a promise still outstanding after it, fulfils a
lower promise there (its new coherence is that promise's timestamp, below the
outstanding one); it writes no new message at the unit. -/
theorem store_promAbove_unit {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool}
    {us : List Acc} {ws : List Word} {s s' : St} (hs : s' ∈ storeUnits k arch pw a rel us ws 0 s)
    (hpl : PromLt s) (hpa : PromAbove s') {j : Nat} (hj : j < nWords us) {tw : Ts} {m : Msg}
    (htw : tw ∈ s'.promises) (hm : s'.mem[tw]? = some m) (hloc : m.loc = offs a j)
    (hsz : tw < s.mem.size) :
    ∃ u ∈ s.promises, ∃ mu, s.mem[u]? = some mu ∧ mu.loc = offs a j ∧ s'.vs.coh (offs a j) = u ∧ u < tw := by
  have h1 := hpa tw htw m hm
  rw [hloc] at h1
  rcases storeUnits_cohW us ws 0 s s' hs hpl j hj with h | ⟨u, hu, mu, hmu, hl, hc⟩
  · rw [Nat.zero_add] at h
    exact absurd (Nat.lt_of_lt_of_le (Nat.lt_trans h1 hsz) h) (Nat.lt_irrefl _)
  · rw [Nat.zero_add] at hl hc
    exact ⟨u, hu, mu, hmu, hl, hc, hc ▸ h1⟩



/-- **A pin at a `DetT` sub-piece is bounded by the whole value**: the
resources a `DetT` piece `U` at offset `o` of `S` carries in the slice of `ws` are part
of those `S` carries in `ws`. -/
theorem pin_le_at (E : TEnv) {ρ : Nat → Nat} {S U : Ty} {o n : Nat} (h : AtOff S o U)
    (hd : DetT U = true) {ws : List Word} {R RP : Res}
    (hv : VRR ρ (CE E) S (shp S) ws R) (hwc : wc S = some ws.length) (hn : wc U = some n)
    (hp : VRR ρ (CE E) U (shp U) ((ws.drop o).take n) RP) : RP ≤ R := by
  obtain ⟨n', Rq, Rr, hn', -, hR, hq, -⟩ := VRR_at E h hv hwc
  rw [hn] at hn'
  cases hn'
  rw [VRR_det U hd hp hq, hR]
  exact Res.le_add_right _ _

end TermStep
