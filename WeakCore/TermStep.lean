            have e2 : o = j * nWords us + (0 + jj) := congrArg WeakMem.Address.offset (hloc.symm.trans he)
            omega
        obtain ⟨jj, hjj, rfl⟩ := hjj
        obtain ⟨e1, -⟩ := SegOf_unique2 hseg hu (show j * nWords us + jj - b < nWords usS by omega) hsegj hwe hjj
          (show b + (j * nWords us + jj - b) = j * nWords us + jj by omega)
        unfold IniSegN; intro N1 e1' hT1
        rw [hT] at hT1; simp only [Ty.array.injEq, Idx.lit.injEq] at hT1; obtain ⟨-, rfl⟩ := hT1
        exact ⟨usB, j, husB, (by have h2 : j < E'.rc ad.label := (by rw [hrc']; omega); exact h2), by rw [hnu]; exact e1⟩)
      (hrcg := fun l h => by
        by_cases hl : l = ad.label
        · subst hl; rw [hrc', hil] at h; have := E.rc_le_ini ad.label; rw [hil]; exact ⟨by omega, by omega⟩
        · exact ⟨by rwa [TEnv.rc_congr (hio l hl) (hrio l hl), hio l hl] at h, Nat.le_of_eq (hio l hl)⟩)
      (fun c' h => by
        have h' : E'.sto ad.label = some c' := h
        rw [hs, hsto] at h'; rw [← Option.some.inj h', ← ht]; exact hown)
      (fun l c' h => Or.inl (by rw [hs] at h; exact h))
      (fun l c' b S usS hc hseg hu hini => by
        have hc0 : E.sto l = some c' := by rw [hs] at hc; exact hc
        by_cases hold : IniSeg E c' l b
        · exact Or.inl ⟨hc0, hold⟩
        · refine Or.inr ?_
          have hl : l = ad.label := by
            refine Classical.byContradiction fun hne => hold fun N1 e1 h1 => ?_
            have := hini N1 e1 h1; rw [hio l hne] at this; exact this
          subst hl
          rw [hsto] at hc0; obtain rfl := Option.some.inj hc0
          rcases hseg with ⟨-, rfl, -⟩ | ⟨N1, us1, j1, hT1, -, -, -⟩
          · rw [hT] at hu; simp [accs] at hu
          · rw [hT] at hT1; simp only [Ty.array.injEq, Idx.lit.injEq] at hT1
            obtain ⟨-, rfl⟩ := hT1
            rw [husB] at hu; obtain rfl := Option.some.inj hu
            exact ⟨ws', hmono hq', by rw [hwl', hnu]⟩),
    BoxInv_tr (BoxInv_store (a := ⟨ad.label, j * nWords us⟩) hbi hsto hpl hpo.1 s' hs') hbe
      (fun _ _ _ h => by rw [hse] at h; exact h)
      (fun l _ _ => by rw [hs])
      (fun l B hl => hio l (fun he => by have h0 := (hbi.2.2 l B hl).1; rw [he, hsto] at h0; cases h0))
      (Nat.le_refl _) (fun _ _ _ _ _ _ h => h) (fun _ _ _ _ _ _ h => h), PromOK_store hpo hpl hs'⟩

/-- The initialised counts with label `l0`'s raised to at least `m`. -/
def bumpIni (ini : AllocLabel → Nat) (l0 : AllocLabel) (m : Nat) : AllocLabel → Nat :=
  fun l => if l = l0 then max (ini l) m else ini l

/-- (IniLe) Bumping both counts keeps the count below the old one or the new real count. -/
theorem bumpIni_le_max (ini rini : AllocLabel → Nat) (l0 : AllocLabel) (m : Nat) :
    bumpIni ini l0 m l0 ≤ max (ini l0) (bumpIni rini l0 m l0) := by
  simp only [bumpIni, ite_true]; omega

theorem bumpIni_le (ini : AllocLabel → Nat) (l0 : AllocLabel) (m : Nat) (l : AllocLabel) :
    ini l ≤ bumpIni ini l0 m l := by
  unfold bumpIni; split
  · exact Nat.le_max_left _ _
  · exact Nat.le_refl _

theorem bumpIni_self (ini : AllocLabel → Nat) (l0 : AllocLabel) (m : Nat) :
    bumpIni ini l0 m l0 = max (ini l0) m := by simp [bumpIni]

theorem bumpIni_other (ini : AllocLabel → Nat) (l0 : AllocLabel) (m : Nat) (l : AllocLabel) (h : l ≠ l0) :
    bumpIni ini l0 m l = ini l := by simp [bumpIni, h]

/-- (BII) The counts a typed `bufInit` leaves at its buffer: both past the written slot. -/
def BufInitBump (th : TTh) (b i : At) (E' : TEnv) : Prop :=
  ∀ rt w ad rti wi n, evalAt th.env b = some (rt, [w]) → w.val = .loc ad 0 →
    evalAt th.env i = some (rti, [wi]) → numOf [wi] = some n → n + 1 ≤ E'.ini ad.label ∧ n + 1 ≤ E'.rini ad.label

/-- (BII) **`tstepM_bufInit` with the count it leaves** (`BufInitBump`); **P1 + P4 at the thread, `bufInit`** (T3c-5b): a plain store of the value at
slot `j = ini` of the own buffer; the frame's view raises the buffer's
initialised count past `j` (`bumpIni`), which the result's `ini (k+1)` reads. -/
theorem tstepM_bufInitB {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {b i v : At} {e : Expr}
    (hterm : th.term = .let_ x (.bufInit b i v) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hZ : ZOK g (CE η) th) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      ∃ E', EFootP g (CE η) E' (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) ∧ ThInvE p E' r.2.2 ∧
        MemInv g E' (stOf r.1 r.2.1 r.2.2) ∧ BufInitBump th b i E' := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | bufInit hu hbuf hint heq hlt hu2 hsub hb =>
  obtain ⟨t, tv, u, n, k, j, c₁, c₂, hu, hbuf, hint, heq, hlt, hu2, hsub, hb⟩ : ∃ t tv u n k j c₁ c₂,
      cx.use b = .ok (t, c₁) ∧ bufOf t = some (.own, n, u, k) ∧ IntIdx c₁ i j ∧ EqI c₁ j k ∧
      LtI c₁ k n ∧ c₁.use v = .ok (tv, c₂) ∧ SubS c₂ tv u ∧
      c₂.bind x (.refine (.loc .own (.array n u)) (.ini (.add k (.lit 1)))) = .ok c' :=
    ⟨_, _, _, _, _, _, _, _, hu, hbuf, hint, heq, hlt, hu2, hsub, hb⟩
  have ht : t = .refine (.loc .own (.array n u)) (.ini k) := by
    unfold bufOf at hbuf; split at hbuf
    · simp only [Option.some.injEq, Prod.mk.injEq] at hbuf
      obtain ⟨h1, rfl, rfl, rfl⟩ := hbuf; subst h1; rfl
    · simp at hbuf
  subst ht
  have htu := use_TvOK hu htv
  obtain ⟨hi1, rb, wsb, hea, hvb, hlb⟩ := use_FInv hu hi
  obtain ⟨hi2, rv, wsv, hev, hvv, hlv⟩ := use_FInv hu2 hi1
  have hJK : ev ρ j = ev ρ k := heq ρ hi1.1
  have hKN : ev ρ k < ev ρ n := hlt ρ hi1.1
  obtain ⟨ti, hpi, hti⟩ := hint
  obtain ⟨rti, wsi, hei, hvi, -⟩ := peek_VR hi1.2.1 hpi
  obtain ⟨wi, rfl, hwi⟩ := map_singleton (VR_intS hti hvi)
  have hvb0 := hvb
  simp only [VR] at hvb
  obtain ⟨hv, hir⟩ := hvb
  rcases hv with ⟨-, e0, he0⟩ | ⟨ad, c, U, hws, hsto, hat0, hFU, hmode, hini0⟩
  · have he0 := Fd_nonmu he0 (fun b => by simp [cl])
    simp only [cl, clI_zero, Ty.array.injEq, Idx.lit.injEq] at he0
    omega
  obtain rfl := Fd_nonmu hFU (fun b => by simp [cl])
  obtain ⟨w, rfl, hwv⟩ := map_singleton hws
  have hKi : ev ρ k ≤ η.ini ad.label := by
    simp only [IniR] at hir; exact Nat.le_trans (hir ad (by simp [hwv])) (TEnv.selIni_le_ini _ _ _)
  have hKm : ev ρ k ≤ η.rc ad.label := by
    simp only [IniR] at hir; have h := hir ad (by simp [hwv]); rw [TEnv.selIni_loc] at h; exact h
  have hat := hat0
  have hini := hini0
  simp only [cl, clI_zero] at hat hini
  -- the runtime handle type
  have hs' : etok (skel rb) = rf (.loc (skelM .own) (.array (.lit 0) (etok (skel (close th.σs u))))) := by
    rw [hlb.2.1]; rfl
  obtain ⟨μr, nr, ur, ψ, rfl, -, hsu⟩ := buf_runtime' hs'
  -- the element type: guarded, laid out
  have htb1 : tb c₁.ke.length u = true := by
    have h := htu.2.1
    rw [← htu.2.2] at h
    simp [tb] at h
    exact h
  have ho : c₁.opaqueOK u = true :=
    sub_opaqueOK hsub (peek_opaqueOK htu.1 (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu2).1)
  have hsig : sig ur = sig (cl ρ η.wit 0 0 u) := by
    have e1 : sig ur = sig (close th.σs u) := sig_of_eskel hsu
    rw [e1]; exact sig_WitL hi1.2.2.2.1 ρ ho (lt_of_guardT htb1 hi1.2.2.2.2.1)
  obtain ⟨us0, hus0⟩ : ∃ us, accs (cl ρ η.wit 0 0 u) = some us := by
    rcases AtOff_lay hat with h | ⟨n', e', he', h⟩
    · simp [accs] at h
    · simp only [Ty.array.injEq] at he'; rw [he'.2]
      exact Option.ne_none_iff_exists'.1 h
  obtain ⟨us, hus⟩ : ∃ us, accs ur = some us := by
    have : wc ur ≠ none := by rw [wc_of_sig hsig]; simp [wc, hus0]
    cases h : accs ur with
    | none => simp [wc, h] at this
    | some us => exact ⟨us, rfl⟩
  have hweA : accs (cl ρ η.wit 0 0 u) = some us := (accs_rtW hE.2.1 hi1.2.2.2.1 hi1.2.2.2.2.1 ho htb1 (buf_lyt hlb.2.2.2.2 rfl).2).symm.trans hus
  have hwe : wc (cl ρ η.wit 0 0 u) = some (nWords us) := by rw [← wc_of_sig hsig]; simp [wc, hus]
  obtain ⟨hval, hlen⟩ := ownStoreVal (cx := c₁) hE.2.1 hi1.2.2.2.1 hi1.2.2.2.2.1 hi2.1 hsub ho htb1 hvv hlv hsig hus
  -- the new view
  let ini' := bumpIni η.ini ad.label (ev ρ j + 1)
  let rini' := bumpIni η.rini ad.label (ev ρ j + 1)
  have hri' : ∀ l, η.rini l ≤ rini' l := bumpIni_le _ _ _
  have hile : ∀ l, η.ini l ≤ ini' l := bumpIni_le η.ini ad.label (ev ρ j + 1)
  have hx : Ext η (η.withSto η.sto ini' (Ri := rini')) := Ext_withSto hE.2.1 (fun l c h => h) hile (Ri := rini') (hRi := hri')
  let rtR : Ty := Ty.refine (Ty.loc μr (Ty.array nr ur)) (Pred.ini (Idx.lit (ev ρ j + 1)))
  have key : tstep g mem pairs th =
      (storeUnits g.k g.arch w (offs ad (ev ρ j * nWords us)) false us wsv 0 (stOf mem pairs th)).map fun s' =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, rtR, [w]) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hei, hev, numOf, hwi, addrOf, hwv, bufElem, hus, List.map_map]; rfl
  rw [key]
  obtain ⟨s0, hs0⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := w)
    (a := offs ad (ev ρ j * nWords us)) (rel := false) us wsv 0 (stOf mem pairs th) hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hs0), fun r hr hpa => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨s', hs', rfl⟩ := hr
  have hvr : VR ρ (η.withSto η.sto ini' (Ri := rini')) (.refine (.loc .own (.array n u)) (.ini (.add k (.lit 1))))
      (shp rtR) [w] := by
    have h1 := VR_ext hE.2.1 hx hvb0
    simp only [VR] at h1 ⊢
    refine ⟨h1.1, fun a ha => ?_⟩
    have hav : a = ad := by simp [hwv] at ha; exact ha.symm
    subst hav
    show ev ρ (.add k (.lit 1)) ≤ min (bumpIni η.ini a.label (ev ρ j + 1) a.label)
      (bumpIni η.rini a.label (ev ρ j + 1) a.label)
    rw [bumpIni_self, bumpIni_self]; simp [ev]; omega
  have hlay : Lay th.σs (.refine (.loc .own (.array n u)) (.ini (.add k (.lit 1))))
      rtR [w] := Lay_repred hlb
  exact ⟨CE (η.withSto η.sto ini' (Ri := rini')), EFoot_ini (harr := .inr (ArrAt_of_buf hm hsto hmode hat)) rfl rfl rfl rfl rfl rfl ⟨c, hsto, hmode⟩
      (hz := by
        by_cases hzl : g.zf ad.label
        · by_cases hpf : (CE η).pfr ad.label = none
          · exact .inr (.inl hpf)
          · have hlo : ev ρ j < η.ini ad.label ∧ ev ρ j < η.rini ad.label := by
              by_cases hrc : (CE η).rc ad.label ≤ ev ρ j
              · exact hZ _ ⟨x, b, i, v, e, _, w, ad, 0, hterm, hea, hwv, rfl⟩ hzl x b i v e hterm _ w ad _ wi (ev ρ j)
                  hea hwv hei (by simp [numOf, hwi]) rfl hpf hrc
              · have h := hKm; change ¬ (min (η.ini ad.label) (η.rini ad.label) ≤ ev ρ j) at hrc
                unfold TEnv.rc at h; omega
            refine .inr (.inr ⟨?_, ?_⟩)
            · show bumpIni η.ini ad.label (ev ρ j + 1) ad.label = η.ini ad.label
              rw [bumpIni_self]; omega
            · show bumpIni η.rini ad.label (ev ρ j + 1) ad.label = η.rini ad.label
              rw [bumpIni_self]; omega
        · exact .inl hzl)
      (hfz := fun _ => by
        show bumpIni η.ini ad.label (ev ρ j + 1) ad.label = η.ini ad.label ∨ η.ini ad.label ≤ η.rini ad.label
        have h := hKm; unfold TEnv.rc at h; rw [bumpIni_self]; omega)
      (fun l => ite_ini_cases _ _ _ l)
      (riniW_bufInit (E := CE η) (E' := CE (η.withSto η.sto ini' (Ri := rini'))) hm hsto hini hweA
        (show ev ρ j ≤ η.rc ad.label by omega) (bumpIni_self _ _ _) (fun l' h => bumpIni_other _ _ _ l' h) s' hs'), ⟨ρ, η.withSto η.sto ini' (Ri := rini'), c', rfl, ⟨hE.1, hx.1, hx.2.2.2.2.2.2.2.2.2.2.1⟩, he, htv',
      bind_FInv hb (FInv_ext hE.2.1 hx hi2) hvr hlay, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
    MemInv_bufInit (E := CE η) (E' := CE (η.withSto η.sto ini' (Ri := rini'))) hm hsto hmode hat hini hweA
      (by omega) (show ev ρ j ≤ η.rc ad.label by omega) hval hlen rfl rfl rfl (bumpIni_self _ _ _)
      (fun l' h => bumpIni_other _ _ _ l' h) (bumpIni_self _ _ _) (fun l' h => bumpIni_other _ _ _ l' h) rfl rfl (fun _ _ h => h) rfl (fun l => hri' l) s' hs' hpa,
    fun rt' w' ad' rti' wi' n' he' hw' hei' hn' => by
      rw [hea] at he'
      simp only [Option.some.injEq, Prod.mk.injEq, List.cons.injEq, and_true] at he'
      obtain ⟨-, rfl⟩ := he'
      rw [hwv] at hw'
      cases hw'
      rw [hei] at hei'
      simp only [Option.some.injEq, Prod.mk.injEq, List.cons.injEq, and_true] at hei'
      obtain ⟨-, rfl⟩ := hei'
      have hn : n' = ev ρ j := by simp [numOf, hwi] at hn'; exact hn'.symm
      subst hn
      show ev ρ j + 1 ≤ bumpIni η.ini ad.label (ev ρ j + 1) ad.label ∧
        ev ρ j + 1 ≤ bumpIni η.rini ad.label (ev ρ j + 1) ad.label
      rw [bumpIni_self, bumpIni_self]; exact ⟨Nat.le_max_right _ _, Nat.le_max_right _ _⟩⟩

/-- **P1 + P4 at the thread, `bufInit`** (T3c-5b): a plain store of the value at
slot `j = ini` of the own buffer; the frame's view raises the buffer's
initialised count past `j` (`bumpIni`), which the result's `ini (k+1)` reads. -/
theorem tstepM_bufInit {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {b i v : At} {e : Expr}
    (hterm : th.term = .let_ x (.bufInit b i v) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hZ : ZOK g (CE η) th) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  obtain ⟨h1, h2⟩ := tstepM_bufInitB hterm hP hT hi hE htv hm hZ hRP hPS
  exact ⟨h1, fun r hr hpa => let ⟨E', a1, a2, a3, _⟩ := h2 r hr hpa; ⟨E', a1, a2, a3⟩⟩

/-! ## §12 The zero of a new buffer (option (1) for `newBuf`)

The runtime zeroes a buffer of `close σs τ` with that type's `zeroWords`
when it is `Zeroable`.  Those words are a value of the witness rendition
`cl ρ η.wit 0 0 τ` (`zero_valOf`): Zeroable types' zero words are values
(`zp`), and zeroability (`zrel_zero`) and the zero words (`zrel_words`)
transfer along zero agreement (`ZRel`) between renditions with the same
`sig`. -/

/-- `env`'s known index values are `ρ`'s. -/
def IAgree (env : IEnv) (ρ : Nat → Nat) : Prop := ∀ k v, env[k]? = some (some v) → ρ k = v

theorem IAgree.cons {env : IEnv} {ρ : Nat → Nat} (h : IAgree env ρ) (w : Nat) :
    IAgree (none :: env) (vcons w ρ) := by
  intro k v hk
  cases k with
  | zero => simp at hk
  | succ k => rw [vcons_succ]; exact h k v (by simpa using hk)

theorem IAgree.cons0 {env : IEnv} {ρ : Nat → Nat} (h : IAgree env ρ) :
    IAgree (some 0 :: env) (vcons 0 ρ) := by
  intro k v hk
  cases k with
  | zero => simp at hk; rw [vcons_zero]; exact hk
  | succ k => rw [vcons_succ]; exact h k v (by simpa using hk)

theorem ev_of_evalIn {env : IEnv} {ρ : Nat → Nat} (h : IAgree env ρ) :
    ∀ (i : Idx) (v : Nat), i.evalIn env = some v → ev ρ i = v
  | .lit _, v, hv => by simpa [Idx.evalIn, ev] using hv
  | .var k, v, hv => by
      simp only [Idx.evalIn] at hv
      cases hk : env[k]? with
      | none => simp [hk] at hv
      | some o =>
          simp only [hk, Option.join_some] at hv; subst hv
          exact h k _ hk
  | .add i j, v, hv => by
      simp only [Idx.evalIn] at hv
      cases hi : i.evalIn env <;> cases hj : j.evalIn env <;> simp [hi, hj] at hv
      simp only [ev, ev_of_evalIn h i _ hi, ev_of_evalIn h j _ hj]; omega
  | .sub i j, v, hv => by
      simp only [Idx.evalIn] at hv
      cases hi : i.evalIn env <;> cases hj : j.evalIn env <;> simp [hi, hj] at hv
      simp only [ev, ev_of_evalIn h i _ hi, ev_of_evalIn h j _ hj]; omega
  | .smul n i, v, hv => by
      simp only [Idx.evalIn] at hv
      cases hi : i.evalIn env <;> simp [hi] at hv
      simp only [ev, ev_of_evalIn h i _ hi]; omega

theorem IniR_of_zeroHolds {env : IEnv} {ρ : Nat → Nat} (h : IAgree env ρ) (ini : WeakMem.AllocLabel → Nat)
    (ws : List Word) : ∀ ψ : Pred, ψ.zeroHolds env = true → IniR ρ ini ψ ws
  | .tt, _ => trivial
  | .le _ _, _ => trivial
  | .eq _ _, _ => trivial
  | .and p q, hz => by
      simp only [Pred.zeroHolds, Bool.and_eq_true] at hz
      exact ⟨IniR_of_zeroHolds h ini ws p hz.1, IniR_of_zeroHolds h ini ws q hz.2⟩
  | .ini i, hz => by
      simp only [Pred.zeroHolds, beq_iff_eq] at hz
      intro a _; rw [ev_of_evalIn h i 0 hz]; exact Nat.zero_le _

/-- No kind says `Zeroable` (a closed type's `μ`/`∃α` variables). -/
def KNone (ke : KEnv) : Prop := ∀ k, ke.ask k false (·.zero) = false

theorem KNone.cons {ke : KEnv} (h : KNone ke) : KNone (none :: ke) := by
  intro k; cases k with
  | zero => rfl
  | succ k => have := h k; unfold KEnv.ask at this ⊢; simpa using this

theorem wc_of_shape {t : Ty} {q : List Word} (hw : wc t ≠ none) (hs : ShapeC t q) : wc t = some q.length := by
  cases ha : accs t with
  | none => simp [wc, ha] at hw
  | some us => simp only [wc, ha, Option.map_some, hs us ha]

theorem shape_of_wc {t : Ty} {q : List Word} (hw : wc t = some q.length) : ShapeC t q := by
  intro us hu; simp only [wc, hu, Option.map_some, Option.some.injEq] at hw; exact hw.symm

/-- (D3) Encoding a payload of view-0 words gives view-0 words. -/
theorem encodeArm_view0 {tr : Tier} {as : List Ty} {j : Nat} {p q : List Word}
    (hp : ∀ w ∈ p, w.view = 0) (h : encodeArm tr as j p = some q) : ∀ w ∈ q, w.view = 0 := by
  intro x hx
  unfold encodeArm at h
  split at h
  · cases ha : as[j]? with
    | none => simp [ha] at h
    | some arm =>
        simp only [ha, Option.bind_eq_bind, Option.bind_some] at h
        split at h
        · split at h
          · simp only [Option.some.injEq] at h; subst h
            simp only [List.mem_singleton] at hx; subst hx
            simp only [List.mem_singleton, forall_eq] at hp; exact hp
          · split at h
            · simp only [Option.some.injEq] at h; subst h
              simp only [List.mem_singleton] at hx; subst hx; rfl
            · cases h
          · cases h
        · split at h
          · simp only [Option.some.injEq] at h; subst h
            simp only [List.mem_singleton] at hx; subst hx
            simp only [List.mem_singleton, forall_eq] at hp; exact hp
          · split at h
            · simp only [Option.some.injEq] at h; subst h
              simp only [List.mem_singleton] at hx; subst hx; rfl
            · cases h
          · cases h
        · simp only [Option.some.injEq] at h; subst h
          simp only [List.mem_singleton] at hx; subst hx; rfl
        · cases h
  · split at h
    · simp only [Option.some.injEq] at h; subst h
      simp only [List.mem_cons, List.mem_singleton, List.not_mem_nil, or_false] at hx
      rcases hx with rfl | rfl <;> rfl
    · simp only [Option.some.injEq] at h; subst h
      simp only [List.mem_cons, List.mem_singleton, List.not_mem_nil, or_false] at hx
      rcases hx with rfl | rfl
      · rfl
      · simp only [List.mem_singleton, forall_eq] at hp; exact hp
    · cases h
  · cases h

/-- (D3) Words of view 0 are below any words with their values. -/
theorem WLe_of_view0 : ∀ {q ws : List Word}, ws.map (·.val) = q.map (·.val) → (∀ w ∈ q, w.view = 0) → WLe q ws
  | [], [], _, _ => WLe_refl []
  | [], _ :: _, e, _ => by simp at e
  | _ :: _, [], e, _ => by simp at e
  | x :: q, y :: ws, e, h => by
      simp only [List.map_cons, List.cons.injEq] at e
      exact ⟨⟨e.1.symm, fun a g _ => by rw [h x (by simp)]; exact Nat.zero_le _⟩,
        WLe_of_view0 e.2 fun w hw => h w (by simp [hw])⟩

/-- The claim for one type. -/
def ZP (u : Ty) : Prop :=
  ∀ (env : IEnv) (ke : KEnv), u.arrFree = true → KNone ke → zeroableIn env ke u = true →
    ∃ zs, zeroWords u = some zs ∧ wc u = some zs.length ∧
      ∀ ws : List Word, ws.map (·.val) = zs →
        Valid u ws ∧ ∀ (ρ : Nat → Nat) (η : TEnv), IAgree env ρ → VR ρ η u (shp u) ws

/-- The claim for a sum component: the arm `sel` picks, its zero payload,
and its injection. -/
def ZAP (sel : Ty → Bool) (t : Ty) : Prop :=
  ∀ (env : IEnv) (ke : KEnv), t.arrFree = true → KNone ke → zeroArmP sel env ke t = some true →
    ∃ j arm p, (armsOf t).findIdx? sel = some j ∧ (armsOf t)[j]? = some arm ∧
      zeroWords arm = some p ∧ wc arm = some p.length ∧
      (∀ ws : List Word, ws.map (·.val) = p → Valid arm ws) ∧
      (t.tier ≠ .boxed → ∀ pw : List Word, pw.map (·.val) = p →
        ∃ q, ofArm t j pw = some q ∧ wc t = some q.length ∧ Valid t q ∧
          ∀ (ρ : Nat → Nat) (η : TEnv), IAgree env ρ → VR ρ η t (shp t) q)

theorem zeroArmP_none (sel : Ty → Bool) : ∀ (t : Ty) (env : IEnv) (ke : KEnv),
    zeroArmP sel env ke t = none → (armsOf t).findIdx? sel = none := by
  intro t
  induction t with
  | sum a b iha ihb =>
      intro env ke h
      simp only [zeroArmP] at h
      cases ha : zeroArmP sel env ke a with
      | none => simp [ha] at h; simp [armsOf, iha env ke ha, ihb env ke h]
      | some _ => simp [ha] at h
  | void => intro _ _ _; simp [armsOf]
  | refine t ψ ih =>
      intro env ke h; simp only [zeroArmP] at h
      cases hx : zeroArmP sel env ke t with
      | none => simp only [armsOf]; exact ih env ke hx
      | some _ => simp [hx] at h
  | iall t ih => intro env ke h; simp only [zeroArmP] at h; simp only [armsOf]; exact ih _ _ h
  | iex t ih => intro env ke h; simp only [zeroArmP] at h; simp only [armsOf]; exact ih _ _ h
  | mu t ih => intro env ke h; simp only [zeroArmP] at h; simp only [armsOf]; exact ih _ _ h
  | tex κ t ih =>
      intro env ke h; simp only [zeroArmP] at h
      cases hx : zeroArmP sel env (none :: ke) t with
      | none => simp only [armsOf]; exact ih _ _ hx
      | some _ => simp [hx] at h
  | _ =>
      intro env ke h
      simp only [zeroArmP] at h
      split at h
      · simp at h
      · rename_i hs; simp [armsOf, hs]

theorem zap_leaf {sel : Ty → Bool} {t : Ty} (hA : armsOf t = [t]) (hs : sumHead t = false)
    (hz : ∀ env ke, zeroArmP sel env ke t = if sel t then some (zeroableIn env ke t) else none)
    (hZ : ZP t) : ZAP sel t := by
  intro env ke haf hk h
  rw [hz] at h
  split at h
  · rename_i hsel
    simp only [Option.some.injEq] at h
    obtain ⟨zs, hzw, hwc, hv⟩ := hZ env ke haf hk h
    refine ⟨0, t, zs, by simp [hA, hsel], by simp [hA], hzw, hwc, fun ws e => (hv ws e).1,
      fun _ pw e => ⟨pw, by simp [ofArm, hs], ?_, (hv pw e).1, fun ρ η ha => (hv pw e).2 ρ η ha⟩⟩
    rw [hwc, ← e, List.length_map]
  · simp at h

/-- A wrapper with its body's arms, tier and layout: the claim passes through. -/
theorem zap_wrap {sel : Ty → Bool} {t u : Ty} {env env' : IEnv}
    (hA : armsOf t = armsOf u) (hs : sumHead t = sumHead u) (ht : t.tier = u.tier) (hw : wc t = wc u)
    (hval : ∀ q, Valid u q → Valid t q)
    (hvr : ∀ q, (∀ (ρ : Nat → Nat) (η : TEnv), IAgree env' ρ → VR ρ η u (shp u) q) →
      ∀ (ρ : Nat → Nat) (η : TEnv), IAgree env ρ → VR ρ η t (shp t) q)
    (h : ∃ j arm p, (armsOf u).findIdx? sel = some j ∧ (armsOf u)[j]? = some arm ∧
      zeroWords arm = some p ∧ wc arm = some p.length ∧
      (∀ ws : List Word, ws.map (·.val) = p → Valid arm ws) ∧
      (u.tier ≠ .boxed → ∀ pw : List Word, pw.map (·.val) = p →
        ∃ q, ofArm u j pw = some q ∧ wc u = some q.length ∧ Valid u q ∧
          ∀ (ρ : Nat → Nat) (η : TEnv), IAgree env' ρ → VR ρ η u (shp u) q)) :
    ∃ j arm p, (armsOf t).findIdx? sel = some j ∧ (armsOf t)[j]? = some arm ∧
      zeroWords arm = some p ∧ wc arm = some p.length ∧
      (∀ ws : List Word, ws.map (·.val) = p → Valid arm ws) ∧
      (t.tier ≠ .boxed → ∀ pw : List Word, pw.map (·.val) = p →
        ∃ q, ofArm t j pw = some q ∧ wc t = some q.length ∧ Valid t q ∧
          ∀ (ρ : Nat → Nat) (η : TEnv), IAgree env ρ → VR ρ η t (shp t) q) := by
  obtain ⟨j, arm, p, hf, ha, hzw, hwc, hva, hinj⟩ := h
  have eo : ofArm t = ofArm u := (asArm_congr hs ht hA).2
  refine ⟨j, arm, p, hA ▸ hf, hA ▸ ha, hzw, hwc, hva, fun htb pw e => ?_⟩
  obtain ⟨q, hq, hwq, hvq, hrq⟩ := hinj (ht ▸ htb) pw e
  exact ⟨q, eo ▸ hq, hw ▸ hwq, hval q hvq, hvr q hrq⟩

theorem zap : ∀ (t : Ty), (∀ u ∈ armsOf t, ZP u) → ∀ sel, ZAP sel t := by
  intro t
  induction t with
  | sum c d ihc ihd =>
      intro hIH sel env ke haf hk h
      have hIHc : ∀ u ∈ armsOf c, ZP u := fun u hu => hIH u (by simp [armsOf, hu])
      have hIHd : ∀ u ∈ armsOf d, ZP u := fun u hu => hIH u (by simp [armsOf, hu])
      simp only [Ty.arrFree, Bool.and_eq_true] at haf
      simp only [zeroArmP] at h
      cases hzc : zeroArmP sel env ke c with
      | some x =>
          cases x
          · simp [hzc] at h
          obtain ⟨j, arm, p, hf, harm, hzw, hwc, hva, hinj⟩ := ihc hIHc sel env ke haf.1 hk hzc
          have hj : j < (armsOf c).length := (List.getElem?_eq_some_iff.mp harm).1
          have harmS : (armsOf (.sum c d))[j]? = some arm := by
            simp only [armsOf]; rw [List.getElem?_append_left hj]; exact harm
          refine ⟨j, arm, p, by simp [armsOf, hf], harmS, hzw, hwc, hva, fun ht pw e => ?_⟩
          have hmem : arm ∈ armsOf (.sum c d) := List.mem_of_getElem? harmS
          obtain ⟨⟨k, hk', -⟩, -⟩ := arm_of_tier ht hmem
          have hpw : PayOK arm pw :=
            atom_payok (atom_of_mem _ _ hmem) (hva pw e) (shape_of_wc (by rw [hwc, ← e, List.length_map])) hk'
          obtain ⟨q, hq⟩ := encode_ok ht harmS hpw
          obtain ⟨p', hd, ep, hp', q', hq', eq'⟩ := enc_canon ht harmS hpw hq
          have e' : p'.map (·.val) = p := by rw [← e]; exact ep.symm
          obtain ⟨q0, hq0, hwc0, hv0, hvr0⟩ := hinj (tier_sum ht).1 p' e'
          refine ⟨q, by simp only [ofArm, sumHead, ite_true]; exact hq,
            wc_of_shape (wc_sum_ne _ _) (shape_sum hq),
            Or.inr ⟨j, p', arm, hd, harmS, hp', ⟨q', hq', eq'⟩,
              fun _ => ⟨q0, hq0, shape_of_wc hwc0, by rw [hwc0]; simp, hv0⟩,
              fun h => absurd h (by omega)⟩, fun ρ η ha => ?_⟩
          refine ⟨_, _, _, rfl, Or.inr ⟨j, p', ?_, fun _ => ⟨q0, ofArm_lnorm hq0, ?_⟩,
            fun h => absurd h (by have := ArmsLe.length (arms_lnorm c); omega)⟩⟩
          · have := decodeArm_mono (arms_lnorm (.sum c d)) hd
            rw [← tier_lnorm (.sum c d)] at this; exact this
          · rw [shp_lnorm]; exact hvr0 ρ η ha
      | none =>
          simp [hzc] at h
          obtain ⟨j, arm, p, hf, harm, hzw, hwc, hva, hinj⟩ := ihd hIHd sel env ke haf.2 hk h
          have hnc := zeroArmP_none sel c env ke hzc
          generalize hm : (armsOf c).length = m
          have harmS : (armsOf (.sum c d))[j + m]? = some arm := by
            simp only [armsOf]; rw [List.getElem?_append_right (by omega)]
            rw [hm, Nat.add_sub_cancel]; exact harm
          refine ⟨j + m, arm, p, by simp [armsOf, hnc, hf, hm], harmS, hzw, hwc, hva, fun ht pw e => ?_⟩
          have hmem : arm ∈ armsOf (.sum c d) := List.mem_of_getElem? harmS
          obtain ⟨⟨k, hk', -⟩, -⟩ := arm_of_tier ht hmem
          have hpw : PayOK arm pw :=
            atom_payok (atom_of_mem _ _ hmem) (hva pw e) (shape_of_wc (by rw [hwc, ← e, List.length_map])) hk'
          obtain ⟨q, hq⟩ := encode_ok ht harmS hpw
          obtain ⟨p', hd, ep, hp', q', hq', eq'⟩ := enc_canon ht harmS hpw hq
          have e' : p'.map (·.val) = p := by rw [← e]; exact ep.symm
          obtain ⟨q0, hq0, hwc0, hv0, hvr0⟩ := hinj (tier_sum ht).2 p' e'
          have hlen : (armsOf (lnorm c)).length = m := by rw [← ArmsLe.length (arms_lnorm _)]; exact hm
          refine ⟨q, by simp only [ofArm, sumHead, ite_true]; exact hq,
            wc_of_shape (wc_sum_ne _ _) (shape_sum hq),
            Or.inr ⟨j + m, p', arm, hd, harmS, hp', ⟨q', hq', eq'⟩,
              fun h => absurd h (by omega),
              fun _ => ⟨q0, by rw [hm, Nat.add_sub_cancel]; exact hq0, shape_of_wc hwc0, by rw [hwc0]; simp, hv0⟩⟩,
            fun ρ η ha => ?_⟩
          refine ⟨_, _, _, rfl, Or.inr ⟨j + m, p', ?_, fun h => absurd h (by omega),
            fun _ => ⟨q0, ?_, ?_⟩⟩⟩
          · have := decodeArm_mono (arms_lnorm (.sum c d)) hd
            rw [← tier_lnorm (.sum c d)] at this; exact this
          · rw [hlen, Nat.add_sub_cancel]; exact ofArm_lnorm hq0
          · rw [shp_lnorm]; exact hvr0 ρ η ha
  | void => intro _ sel env ke _ _ h; simp [zeroArmP] at h
  | refine u ψ ih =>
      intro hIH sel env ke haf hk h
      simp only [zeroArmP] at h
      cases hx : zeroArmP sel env ke u with
      | none => simp [hx] at h
      | some x =>
          simp only [hx, Option.map_some, Option.some.injEq, Bool.and_eq_true] at h
          obtain ⟨rfl, hzh⟩ := h
          exact zap_wrap (t := .refine u ψ) (u := u) rfl rfl (tier_refine u ψ) (by simp [wc, accs]) (fun q hv => hv)
            (fun q hr ρ η ha => ⟨hr ρ η ha, IniR_of_zeroHolds ha _ q ψ hzh⟩)
            (ih (by simpa [armsOf] using hIH) sel env ke (by simpa [Ty.arrFree] using haf) hk hx)
  | iall u ih =>
      intro hIH sel env ke haf hk h
      simp only [zeroArmP] at h
      exact zap_wrap (t := .iall u) (u := u) (env' := none :: env) rfl rfl (tier_iall u) (by simp [wc, accs]) (fun q hv => hv)
        (fun q hr ρ η ha => by simp only [VR]; exact fun n => hr _ η (ha.cons n))
        (ih (by simpa [armsOf] using hIH) sel _ ke (by simpa [Ty.arrFree] using haf) hk h)
  | iex u ih =>
      intro hIH sel env ke haf hk h
      simp only [zeroArmP] at h
      exact zap_wrap (t := .iex u) (u := u) (env' := some 0 :: env) rfl rfl (tier_iex u) (wc_iex u) (fun q hv => hv)
        (fun q hr ρ η ha => ⟨_, _, 0, rfl, hr _ η ha.cons0⟩)
        (ih (by simpa [armsOf] using hIH) sel _ ke (by simpa [Ty.arrFree] using haf) hk h)
  | mu u ih =>
      intro hIH sel env ke haf hk h
      simp only [zeroArmP] at h
      exact zap_wrap (t := .mu u) (u := u) (env' := env) rfl rfl (tier_mu u) (by simp [wc, accs]) (fun q hv => hv)
        (fun q hr ρ η ha => hr ρ _ ha)
        (ih (by simpa [armsOf] using hIH) sel env _ (by simpa [Ty.arrFree] using haf) hk.cons h)
  | tex κ u _ =>
      intro _ sel env ke _ _ h
      simp only [zeroArmP] at h
      cases hx : zeroArmP sel env (none :: ke) u <;> simp [hx] at h
  | _ =>
      intro hIH sel
      exact zap_leaf (by simp [armsOf]) (by simp [sumHead]) (fun env ke => by simp only [zeroArmP] <;> rfl)
        (hIH _ (by simp [armsOf]))

theorem zeroWords_sum {a b arm : Ty} {j : Nat} {p : List WeakMem.Val} {q : List Word}
    (hzi : zeroIdx (Ty.sum a b).tier (armsOf (.sum a b)) = some j)
    (ha : (armsOf (.sum a b))[j]? = some arm) (hp : zeroWords arm = some p)
    (hq : encodeArm (Ty.sum a b).tier (armsOf (.sum a b)) j (p.map cst) = some q) :
    zeroWords (.sum a b) = some (q.map (·.val)) := by
  rw [zeroWords]
  split
  · rename_i hz0; rw [hzi] at hz0; cases hz0
  · rename_i j' hz0
    rw [hzi] at hz0; cases hz0
    split
    · rename_i ha0; rw [ha] at ha0; cases ha0
    · rename_i arm' ha0
      rw [ha] at ha0; cases ha0
      simp [hp, hq]

theorem map_val_cst : ∀ p : List WeakMem.Val, (p.map cst).map (·.val) = p
  | [] => rfl
  | v :: vs => by simp only [List.map_cons, map_val_cst vs]; rfl

theorem map_val_nil {ws : List Word} (e : ws.map (·.val) = []) : ws = [] := by simpa using e

theorem map_val_one {ws : List Word} {v : WeakMem.Val} (e : ws.map (·.val) = [v]) : ws.length = 1 := by
  have := congrArg List.length e; simpa using this

/-- **The zero value is a value** (option (1), M3): a `Zeroable` closed type's
`zeroWords` are a valid value of it, of its word count. -/
theorem zp : ∀ (n : Nat) (T : Ty), sizeOf T < n → ZP T := by
  intro n
  induction n with
  | zero => intro T h; omega
  | succ n ih =>
    intro T hT env ke haf hk hz
    cases T with
    | unit =>
        refine ⟨[], by simp [zeroWords], by simp [wc, accs, nWords], fun ws e => ⟨trivial, fun ρ η _ => ?_⟩⟩
        simp [VR]
    | int =>
        refine ⟨[.num 0], by simp [zeroWords], by simp [wc, accs, nWords, Acc.size], fun ws e => ⟨trivial, fun ρ η _ => ?_⟩⟩
        simp only [VR]; exact ⟨0, e⟩
    | intS i =>
        simp only [zeroableIn, beq_iff_eq] at hz
        refine ⟨[.num 0], by simp [zeroWords], by simp [wc, accs, nWords, Acc.size], fun ws e => ⟨trivial, fun ρ η ha => ?_⟩⟩
        simp only [VR]; rw [ev_of_evalIn ha i 0 hz]; exact e
    | fix sg w =>
        refine ⟨[.num 0], by simp [zeroWords], by simp [wc, accs, nWords, Acc.size], fun ws e => ⟨trivial, fun ρ η _ => ?_⟩⟩
        simp only [VR, shp]; exact ⟨trivial, 0, e, pw2_pos w⟩
    | lanes sg w =>
        refine ⟨[.num 0], by simp [zeroWords], by simp [wc, accs, nWords, Acc.size], fun ws e => ⟨trivial, fun ρ η _ => ?_⟩⟩
        simp only [VR, shp]; exact ⟨trivial, 0, e⟩
    | ptrOpt μ u =>
        refine ⟨[.null], by simp [zeroWords], by simp [wc, accs, nWords, Acc.size], fun ws e => ⟨Or.inl e, fun ρ η _ => ?_⟩⟩
        simp only [VR]; exact Or.inl e
    | loc μ u =>
        cases u with
        | array i e0 =>
            simp only [zeroableIn, beq_iff_eq] at hz
            refine ⟨[.null], by simp [zeroWords], by simp [wc, accs, nWords, Acc.size], fun ws e => ⟨Or.inl e, fun ρ η ha => ?_⟩⟩
            simp only [VR]
            refine Or.inl ⟨e, cl ρ η.wit 0 0 e0, ?_⟩
            rw [show cl ρ η.wit 0 0 (.array i e0) = .array (.lit 0) (cl ρ η.wit 0 0 e0) by
              simp [cl, clI_zero, ev_of_evalIn ha i 0 hz]]
            exact .refl
        | _ => simp [zeroableIn] at hz
    | prod a b =>
        simp only [zeroableIn, Bool.and_eq_true] at hz
        simp only [Ty.arrFree, Bool.and_eq_true] at haf
        have ha : sizeOf a < n := by simp at hT; omega
        have hb : sizeOf b < n := by simp at hT; omega
        obtain ⟨za, hza, hwa, hva⟩ := ih a ha env ke haf.1 hk hz.1
        obtain ⟨zb, hzb, hwb, hvb⟩ := ih b hb env ke haf.2 hk hz.2
        refine ⟨za ++ zb, by simp [zeroWords, hza, hzb], by simp [wc_prod, hwa, hwb], fun ws e => ?_⟩
        have e1 : (ws.take za.length).map (·.val) = za := by rw [List.map_take, e]; simp
        have e2 : (ws.drop za.length).map (·.val) = zb := by rw [List.map_drop, e]; simp
        have hl : za.length ≤ ws.length := by
          have := congrArg List.length e; simp at this; omega
        refine ⟨fun k hk' => ?_, fun ρ η hag => ?_⟩
        · rw [hwa, Option.some.injEq] at hk'; subst hk'
          exact ⟨(hva _ e1).1, (hvb _ e2).1⟩
        · simp only [VR, shp]
          refine ⟨_, _, rfl, fun k hk' => ?_⟩
          rw [shp_wc, hwa, Option.some.injEq] at hk'; subst hk'
          exact ⟨hl, (hva _ e1).2 ρ η hag, (hvb _ e2).2 ρ η hag⟩
    | refine u ψ =>
        simp only [zeroableIn, Bool.and_eq_true] at hz
        have hu : sizeOf u < n := by simp at hT; omega
        obtain ⟨z, hzw, hw, hv⟩ := ih u hu env ke (by simpa [Ty.arrFree] using haf) hk hz.1
        refine ⟨z, by simpa [zeroWords] using hzw, by simpa [wc, accs] using hw, fun ws e => ⟨(hv ws e).1, fun ρ η ha => ?_⟩⟩
        simp only [VR, shp]
        exact ⟨(hv ws e).2 ρ η ha, IniR_of_zeroHolds ha _ ws ψ hz.2⟩
    | iall u =>
        simp only [zeroableIn] at hz
        have hu : sizeOf u < n := by simp at hT; omega
        obtain ⟨z, hzw, hw, hv⟩ := ih u hu _ ke (by simpa [Ty.arrFree] using haf) hk hz
        refine ⟨z, by simpa [zeroWords] using hzw, by simpa [wc, accs] using hw, fun ws e => ⟨(hv ws e).1, fun ρ η ha => ?_⟩⟩
        simp only [VR, shp]
        exact fun m => (hv ws e).2 _ η (ha.cons m)
    | iex u =>
        simp only [zeroableIn] at hz
        have hu : sizeOf u < n := by simp at hT; omega
        obtain ⟨z, hzw, hw, hv⟩ := ih u hu _ ke (by simpa [Ty.arrFree] using haf) hk hz
        refine ⟨z, by simpa [zeroWords] using hzw, by rw [wc_iex]; exact hw, fun ws e => ⟨(hv ws e).1, fun ρ η ha => ?_⟩⟩
        simp only [VR, shp]
        exact ⟨_, _, 0, rfl, (hv ws e).2 _ η ha.cons0⟩
    | mu u =>
        simp only [zeroableIn] at hz
        have hu : sizeOf u < n := by simp at hT; omega
        obtain ⟨z, hzw, hw, hv⟩ := ih u hu env _ (by simpa [Ty.arrFree] using haf) hk.cons hz
        refine ⟨z, by simpa [zeroWords] using hzw, by simpa [wc, accs] using hw, fun ws e => ⟨(hv ws e).1, fun ρ η ha => ?_⟩⟩
        simp only [VR, shp]
        exact (hv ws e).2 ρ _ ha
    | sum a b =>
        have hIH : ∀ u ∈ armsOf (.sum a b), ZP u := by
          intro u hu
          refine ih u ?_
          simp only [armsOf, List.mem_append] at hu
          rcases hu with hu | hu
          · have := armsOf_sizeOf a u hu; simp at hT; omega
          · have := armsOf_sizeOf b u hu; simp at hT; omega
        -- the zero arm, by tier
        have key : ∀ sel : Ty → Bool, (Ty.sum a b).tier ≠ .boxed →
            zeroIdx (Ty.sum a b).tier (armsOf (.sum a b)) = (armsOf (.sum a b)).findIdx? sel →
            zeroArmP sel env ke (.sum a b) = some true →
            ∃ zs, zeroWords (.sum a b) = some zs ∧ wc (.sum a b) = some zs.length ∧
              ∀ ws : List Word, ws.map (·.val) = zs →
                Valid (.sum a b) ws ∧ ∀ (ρ : Nat → Nat) (η : TEnv), IAgree env ρ → VR ρ η (.sum a b) (shp (.sum a b)) ws := by
          intro sel ht hzi h
          obtain ⟨j, arm, p, hf, harm, hzw, _, _, hinj⟩ := zap _ hIH sel env ke haf hk h
          have e : (p.map cst).map (·.val) = p := map_val_cst p
          obtain ⟨q, hq, hwq, hvq, hrq⟩ := hinj ht _ e
          simp only [ofArm, sumHead, ite_true] at hq
          refine ⟨q.map (·.val), zeroWords_sum (hzi.trans hf) harm hzw hq, by simpa using hwq,
            fun ws e' => ⟨Valid_vals _ _ _ e'.symm hvq, fun ρ η ha => VR_up _ _ _ _ (WLe_of_view0 e' (encodeArm_view0
              (fun w hw => by simp only [List.mem_map] at hw; obtain ⟨v, _, rfl⟩ := hw; rfl) hq)) (hrq ρ η ha)⟩⟩
        simp only [zeroableIn] at hz
        split at hz
        · rename_i hn
          refine key Ty.payloadFree (by rw [hn]; simp) (by rw [hn]; rfl) ?_
          simp only [zeroArmP]; simpa using hz
        · rename_i hw
          refine key (fun _ => true) (by rw [hw]; simp) ?_ ?_
          · rw [hw]
            cases hA : armsOf (Ty.sum a b) with
            | nil => rfl
            | cons x xs => simp [zeroIdx, List.findIdx?_cons]
          · simp only [zeroArmP]; simpa using hz
        · cases hz
    | tvar k => simp only [zeroableIn] at hz; rw [hk k] at hz; cases hz
    | array i u => simp [Ty.arrFree] at haf
    | _ => simp [zeroableIn] at hz

/-! ### The runtime rendition's zero is the witness rendition's -/

/-- A selector reads only what `sig` keeps. -/
def SelS (sel : Ty → Bool) : Prop := ∀ u v, sig u = sig v → sel u = sel v

theorem selS_pf : SelS Ty.payloadFree := fun u v h => by
  simp only [Ty.payloadFree, ← info_sig u, h, info_sig]

theorem selS_tr : SelS (fun _ => true) := fun _ _ _ => rfl

theorem rf_inj {x y : Ty} (h : rf x = rf y) : x = y := by
  cases x <;> cases y <;> simp_all [rf]

theorem sig_refine {u u' : Ty} {ψ φ : Pred} (h : sig (.refine u ψ) = sig (.refine u' φ)) : sig u = sig u' := by
  simp only [sig, skel, er_rf] at h; exact rf_inj h

theorem armsOf_sig (t : Ty) : armsOf (sig t) = (armsOf t).map sig := by
  simp only [sig, armsOf_er, armsOf_skel, List.map_map]; rfl

theorem arms_sig {a b : Ty} (h : sig a = sig b) : (armsOf a).map sig = (armsOf b).map sig := by
  rw [← armsOf_sig, ← armsOf_sig, h]

theorem armsLe_of_sig : ∀ {as bs : List Ty}, as.map sig = bs.map sig → ArmsLe as bs
  | [], [], _ => .nil
  | a :: as, b :: bs, h => by
      simp only [List.map_cons, List.cons.injEq] at h
      exact .cons (ArmLe.of_info (by rw [← info_sig a, h.1, info_sig])) (armsLe_of_sig h.2)
  | [], _ :: _, h => by simp at h
  | _ :: _, [], h => by simp at h

theorem findIdx_of_sig {sel : Ty → Bool} (hs : SelS sel) :
    ∀ {as bs : List Ty}, as.map sig = bs.map sig → as.findIdx? sel = bs.findIdx? sel
  | [], [], _ => rfl
  | a :: as, b :: bs, h => by
      simp only [List.map_cons, List.cons.injEq] at h
      simp only [List.findIdx?_cons, hs a b h.1, findIdx_of_sig hs h.2]
  | [], _ :: _, h => by simp at h
  | _ :: _, [], h => by simp at h

theorem getElem_of_sig {as bs : List Ty} (h : as.map sig = bs.map sig) {j : Nat} {x : Ty}
    (hx : as[j]? = some x) : ∃ y, bs[j]? = some y ∧ sig x = sig y := by
  have h1 := congrArg (·[j]?) h
  simp only [List.getElem?_map, hx, Option.map_some] at h1
  cases hy : bs[j]? with
  | none => simp [hy] at h1
  | some y => simp only [hy, Option.map_some, Option.some.injEq] at h1; exact ⟨y, rfl, h1⟩

/-- **Zeroability transfers** along `ZRel` between renditions with the same `sig`. -/
theorem zrel_zero : ∀ (R T : Ty) (env : IEnv) (ke : KEnv), ZRel env R T → sig R = sig T → KNone ke →
    (zeroableIn env ke R = true → zeroableIn env ke T = true) ∧
    ∀ sel : Ty → Bool, SelS sel →
      (zeroArmP sel env ke R = some true → zeroArmP sel env ke T = some true) ∧
      (zeroArmP sel env ke R = none → zeroArmP sel env ke T = none) := by
  have leaf : ∀ (R T : Ty) (env : IEnv) (ke : KEnv) (sel : Ty → Bool), sel R = sel T →
      (zeroableIn env ke R = true → zeroableIn env ke T = true) →
      zeroArmP sel env ke R = (if sel R then some (zeroableIn env ke R) else none) →
      zeroArmP sel env ke T = (if sel T then some (zeroableIn env ke T) else none) →
      (zeroArmP sel env ke R = some true → zeroArmP sel env ke T = some true) ∧
      (zeroArmP sel env ke R = none → zeroArmP sel env ke T = none) := by
    intro R T env ke sel hs z e1 e2
    rw [e1, e2, ← hs]
    cases sel R
    · exact ⟨fun hz => by simp at hz, fun _ => rfl⟩
    · refine ⟨fun hz => ?_, fun hz => by simp at hz⟩
      simp at hz ⊢; exact z hz
  intro R
  induction R with
  | intS i =>
      intro T env ke hR hs hk
      cases T <;> simp only [ZRel] at hR
      rename_i j
      have z : zeroableIn env ke (.intS i) = true → zeroableIn env ke (.intS j) = true := by
        simp only [zeroableIn, beq_iff_eq]; exact hR 0
      exact ⟨z, fun sel hsel => leaf _ _ env ke sel (hsel _ _ hs) z (by simp only [zeroArmP] <;> rfl)
        (by simp only [zeroArmP] <;> rfl)⟩
  | prod a b iha ihb =>
      intro T env ke hR hs hk
      cases T <;> simp only [ZRel] at hR
      rename_i a' b'
      have hs' : sig a = sig a' ∧ sig b = sig b' := by simpa [sig, skel, er] using hs
      have z : zeroableIn env ke (.prod a b) = true → zeroableIn env ke (.prod a' b') = true := by
        simp only [zeroableIn, Bool.and_eq_true]
        exact fun hz => ⟨(iha a' env ke hR.1 hs'.1 hk).1 hz.1, (ihb b' env ke hR.2 hs'.2 hk).1 hz.2⟩
      exact ⟨z, fun sel hsel => leaf _ _ env ke sel (hsel _ _ hs) z (by simp only [zeroArmP] <;> rfl)
        (by simp only [zeroArmP] <;> rfl)⟩
  | sum a b iha ihb =>
      intro T env ke hR hs hk
      cases T <;> simp only [ZRel] at hR
      rename_i a' b'
      have hs' : sig a = sig a' ∧ sig b = sig b' := by simpa [sig, skel, er] using hs
      have ht : (Ty.sum a b).tier = (Ty.sum a' b').tier := tier_of_sig hs
      have arm : ∀ sel : Ty → Bool, SelS sel → (zeroArmP sel env ke a <|> zeroArmP sel env ke b) = some true →
          (zeroArmP sel env ke a' <|> zeroArmP sel env ke b') = some true := by
        intro sel hsel hz
        have za := (iha a' env ke hR.1 hs'.1 hk).2 sel hsel
        have zb := (ihb b' env ke hR.2 hs'.2 hk).2 sel hsel
        cases ha : zeroArmP sel env ke a with
        | none => rw [za.2 ha]; simp [ha] at hz ⊢; exact zb.1 hz
        | some x =>
            have hx : x = true := by simpa [ha] using hz
            subst hx; rw [za.1 ha]; simp
      refine ⟨?_, fun sel hsel => ⟨?_, ?_⟩⟩
      · simp only [zeroableIn, ← ht]
        split
        · simp only [beq_iff_eq]; exact arm _ selS_pf
        · simp only [beq_iff_eq]; exact arm _ selS_tr
        · exact id
      · simp only [zeroArmP]; exact arm sel hsel
      · simp only [zeroArmP]; intro hz
        have za := (iha a' env ke hR.1 hs'.1 hk).2 sel hsel
        have zb := (ihb b' env ke hR.2 hs'.2 hk).2 sel hsel
        cases ha : zeroArmP sel env ke a with
        | none => rw [za.2 ha]; simp [ha] at hz ⊢; exact zb.2 hz
        | some x => simp [ha] at hz
  | array i t ih =>
      intro T env ke hR hs hk
      cases T <;> simp only [ZRel] at hR
      rename_i j t'
      have hs' : sig t = sig t' := by simpa [sig, skel, er] using hs
      have z : zeroableIn env ke (.array i t) = true → zeroableIn env ke (.array j t') = true := by
        simp only [zeroableIn]; exact (ih t' env ke hR.2 hs' hk).1
      exact ⟨z, fun sel hsel => leaf _ _ env ke sel (hsel _ _ hs) z (by simp only [zeroArmP] <;> rfl)
        (by simp only [zeroArmP] <;> rfl)⟩
  | loc μ t _ =>
      intro T env ke hR hs hk
      cases T <;> simp only [ZRel] at hR
      rename_i μ' t'
      have z : zeroableIn env ke (.loc μ t) = true → zeroableIn env ke (.loc μ' t') = true := by
        cases t with
        | array i u =>
            cases t' <;> simp only [LocZ] at hR
            simp only [zeroableIn, beq_iff_eq]; exact hR 0
        | _ => simp [zeroableIn]
      exact ⟨z, fun sel hsel => leaf _ _ env ke sel (hsel _ _ hs) z (by simp only [zeroArmP] <;> rfl)
        (by simp only [zeroArmP] <;> rfl)⟩
  | mu t ih =>
      intro T env ke hR hs hk
      cases T <;> simp only [ZRel] at hR
      rename_i t'
      have hs' : sig t = sig t' := by simpa [sig, skel, er] using hs
      have hi := ih t' env (none :: ke) hR hs' hk.cons
      exact ⟨by simp only [zeroableIn]; exact hi.1, fun sel hsel => by simp only [zeroArmP]; exact hi.2 sel hsel⟩
  | iall t ih =>
      intro T env ke hR hs hk
      cases T <;> simp only [ZRel] at hR
      rename_i t'
      have hs' : sig t = sig t' := by simpa [sig, skel, er] using hs
      have hi := ih t' _ ke hR hs' hk
      exact ⟨by simp only [zeroableIn]; exact hi.1, fun sel hsel => by simp only [zeroArmP]; exact hi.2 sel hsel⟩
  | iex t ih =>
      intro T env ke hR hs hk
      cases T <;> simp only [ZRel] at hR
      rename_i t'
      have hs' : sig t = sig t' := by simpa [sig, skel, er] using hs
      have hi := ih t' _ ke hR hs' hk
      exact ⟨by simp only [zeroableIn]; exact hi.1, fun sel hsel => by simp only [zeroArmP]; exact hi.2 sel hsel⟩
  | refine t ψ ih =>
      intro T env ke hR hs hk
      cases T <;> simp only [ZRel] at hR
      rename_i t' φ
      have hs' : sig t = sig t' := sig_refine hs
      have z : zeroableIn env ke (.refine t ψ) = true → zeroableIn env ke (.refine t' φ) = true := by
        simp only [zeroableIn, Bool.and_eq_true]
        exact fun hz => ⟨(ih t' env ke hR.1 hs' hk).1 hz.1, hR.2 hz.2⟩
      refine ⟨z, fun sel hsel => ?_⟩
      have hi := (ih t' env ke hR.1 hs' hk).2 sel hsel
      simp only [zeroArmP]
      refine ⟨fun hz => ?_, fun hz => ?_⟩
      · cases hx : zeroArmP sel env ke t with
        | none => simp [hx] at hz
        | some x =>
            simp only [hx, Option.map_some, Option.some.injEq, Bool.and_eq_true] at hz
            rw [hi.1 (by rw [hx, hz.1])]
            simp only [Option.map_some, Option.some.injEq, Bool.and_eq_true]
            exact ⟨trivial, hR.2 hz.2⟩
      · cases hx : zeroArmP sel env ke t with
        | none => rw [hi.2 hx]; rfl
        | some x => simp [hx] at hz
  | tex κ t ih =>
      intro T env ke hR hs hk
      cases T <;> simp only [ZRel] at hR
      rename_i κ' t'
      have hs' : sig t = sig t' := by simp [sig, skel, er] at hs; exact hs.2
      have hi := ih t' env (none :: ke) hR hs' hk.cons
      refine ⟨by simp only [zeroableIn]; exact id, fun sel hsel => ?_⟩
      simp only [zeroArmP]
      refine ⟨fun hz => ?_, fun hz => ?_⟩
      · cases hx : zeroArmP sel env (none :: ke) t <;> simp [hx] at hz
      · cases hx : zeroArmP sel env (none :: ke) t with
        | none => rw [(hi.2 sel hsel).2 hx]; rfl
        | some x => simp [hx] at hz
  | void =>
      intro T env ke hR hs hk
      cases T <;> simp only [ZRel] at hR
      exact ⟨by simp [zeroableIn], fun sel _ => ⟨by simp [zeroArmP], by simp [zeroArmP]⟩⟩
  | tvar k =>
      intro T env ke hR hs hk
      cases T <;> simp only [ZRel] at hR
      rename_i k'
      have z : zeroableIn env ke (.tvar k) = true → zeroableIn env ke (.tvar k') = true := fun hz => by
        simp only [zeroableIn] at hz; rw [hk k] at hz; cases hz
      refine ⟨z, fun sel hsel =>
        leaf _ _ env ke sel (hsel _ _ hs) z
          (by simp only [zeroArmP] <;> rfl) (by simp only [zeroArmP] <;> rfl)⟩
  | _ =>
      intro T env ke hR hs hk
      cases T <;> simp only [ZRel] at hR <;>
      exact ⟨fun hz => by simpa only [zeroableIn] using hz, fun sel hsel => leaf _ _ env ke sel (hsel _ _ hs)
        (fun hz => by simpa only [zeroableIn] using hz) (by simp only [zeroArmP] <;> rfl) (by simp only [zeroArmP] <;> rfl)⟩

theorem zeroIdx_of_sig {tr : Tier} {as bs : List Ty} (h : as.map sig = bs.map sig) :
    zeroIdx tr as = zeroIdx tr bs := by
  cases tr with
  | niche => simp only [zeroIdx]; exact findIdx_of_sig selS_pf h
  | wide => cases as <;> cases bs <;> simp [zeroIdx] at h ⊢
  | boxed => rfl

/-- `ZRel` relates the flattened arms, position by position. -/
theorem arms_zrel : ∀ (t t' : Ty) (env : IEnv), ZRel env t t' →
    (armsOf t).length = (armsOf t').length ∧
    ∀ (j : Nat) x, (armsOf t)[j]? = some x → ∃ y env', (armsOf t')[j]? = some y ∧ ZRel env' x y := by
  intro t
  induction t with
  | sum a b iha ihb =>
      intro t' env hR
      cases t' <;> simp only [ZRel] at hR
      rename_i a' b'
      obtain ⟨la, fa⟩ := iha a' env hR.1
      obtain ⟨lb, fb⟩ := ihb b' env hR.2
      refine ⟨by simp [armsOf, la, lb], fun j x hx => ?_⟩
      simp only [armsOf] at hx ⊢
      by_cases hj : j < (armsOf a).length
      · rw [List.getElem?_append_left hj] at hx
        obtain ⟨y, e, hy, hz⟩ := fa j x hx
        exact ⟨y, e, by rw [List.getElem?_append_left (la ▸ hj)]; exact hy, hz⟩
      · rw [List.getElem?_append_right (by omega)] at hx
        obtain ⟨y, e, hy, hz⟩ := fb _ x hx
        exact ⟨y, e, by rw [List.getElem?_append_right (by omega), ← la]; exact hy, hz⟩
  | refine u ψ ih =>
      intro t' env hR
      cases t' <;> simp only [ZRel] at hR
      simp only [armsOf]; exact ih _ env hR.1
  | iall u ih => intro t' env hR; cases t' <;> simp only [ZRel] at hR; simp only [armsOf]; exact ih _ _ hR
  | iex u ih => intro t' env hR; cases t' <;> simp only [ZRel] at hR; simp only [armsOf]; exact ih _ _ hR
  | mu u ih => intro t' env hR; cases t' <;> simp only [ZRel] at hR; simp only [armsOf]; exact ih _ _ hR
  | tex κ u ih => intro t' env hR; cases t' <;> simp only [ZRel] at hR; simp only [armsOf]; exact ih _ _ hR
  | void => intro t' env hR; cases t' <;> simp only [ZRel] at hR; simp [armsOf]
  | _ =>
      intro t' env hR
      refine ⟨?_, fun j x hx => ?_⟩
      · cases t' <;> simp only [ZRel] at hR <;> simp [armsOf]
      · simp only [armsOf] at hx
        cases j with
        | succ j => simp at hx
        | zero =>
          simp at hx; subst hx
          refine ⟨t', env, ?_, hR⟩
          cases t' <;> simp only [ZRel] at hR <;> simp [armsOf]

theorem zeroWords_sum_inv {a b : Ty} {zs : List WeakMem.Val} (h : zeroWords (.sum a b) = some zs) :
    ∃ j arm p q, zeroIdx (Ty.sum a b).tier (armsOf (.sum a b)) = some j ∧
      (armsOf (.sum a b))[j]? = some arm ∧ zeroWords arm = some p ∧
      encodeArm (Ty.sum a b).tier (armsOf (.sum a b)) j (p.map cst) = some q ∧ q.map (·.val) = zs := by
  rw [zeroWords] at h
  split at h
  · cases h
  · rename_i j hzi
    split at h
    · cases h
    · rename_i arm ha
      cases hp : zeroWords arm with
      | none => simp [hp] at h
      | some p =>
          cases hq : encodeArm (Ty.sum a b).tier (armsOf (.sum a b)) j (p.map cst) with
          | none => simp [hp, hq] at h
          | some q => simp [hp, hq] at h; exact ⟨j, arm, p, q, hzi, ha, hp, hq, h⟩

/-- **The zero words transfer** along `ZRel` between renditions with the same `sig`. -/
theorem zrel_words : ∀ (n : Nat) (R T : Ty) (env : IEnv) (zs : List WeakMem.Val), sizeOf R < n →
    ZRel env R T → sig R = sig T → zeroWords R = some zs → zeroWords T = some zs := by
  intro n
  induction n with
  | zero => intro R T env zs h; omega
  | succ n ih =>
    intro R T env zs hn hR hs hz
    cases R with
    | unit | int | intS _ | fix _ _ | lanes _ _ | ptrOpt _ _ =>
        cases T <;> simp only [ZRel] at hR <;> simpa [zeroWords] using hz
    | loc μ u =>
        cases u with
        | array i e0 =>
            cases T <;> simp only [ZRel] at hR
            rename_i μ' u'
            cases u' <;> simp only [LocZ] at hR
            simpa [zeroWords] using hz
        | _ => simp [zeroWords] at hz
    | prod a b =>
        cases T <;> simp only [ZRel] at hR
        rename_i a' b'
        have hs' : sig a = sig a' ∧ sig b = sig b' := by simpa [sig, skel, er] using hs
        have ha : sizeOf a < n := by simp at hn; omega
        have hb : sizeOf b < n := by simp at hn; omega
        simp only [zeroWords] at hz ⊢
        cases hza : zeroWords a with
        | none => simp [hza] at hz
        | some za =>
          cases hzb : zeroWords b with
          | none => simp [hza, hzb] at hz
          | some zb =>
            simp [hza, hzb] at hz
            have ha' := ih a a' env za ha hR.1 hs'.1 hza
            have hb' := ih b b' env zb hb hR.2 hs'.2 hzb
            simp [ha', hb', hz]
    | refine u ψ =>
        cases T <;> simp only [ZRel] at hR
        rename_i u' φ
        have hu : sizeOf u < n := by simp at hn; omega
        have := ih u u' env zs hu hR.1 (sig_refine hs) (by simpa [zeroWords] using hz)
        simpa [zeroWords] using this
    | iall u =>
        cases T <;> simp only [ZRel] at hR
        rename_i u'
        have hu : sizeOf u < n := by simp at hn; omega
        have := ih u u' _ zs hu hR (by simpa [sig, skel, er] using hs) (by simpa [zeroWords] using hz)
        simpa [zeroWords] using this
    | iex u =>
        cases T <;> simp only [ZRel] at hR
        rename_i u'
        have hu : sizeOf u < n := by simp at hn; omega
        have := ih u u' _ zs hu hR (by simpa [sig, skel, er] using hs) (by simpa [zeroWords] using hz)
        simpa [zeroWords] using this
    | mu u =>
        cases T <;> simp only [ZRel] at hR
        rename_i u'
        have hu : sizeOf u < n := by simp at hn; omega
        have := ih u u' _ zs hu hR (by simpa [sig, skel, er] using hs) (by simpa [zeroWords] using hz)
        simpa [zeroWords] using this
    | sum a b =>
        have hR0 := hR
        cases T <;> simp only [ZRel] at hR
        rename_i a' b'
        obtain ⟨j, x, p, q, hzi, hx, hp, hq, rfl⟩ := zeroWords_sum_inv hz
        have hA := arms_sig hs
        have ht := tier_of_sig hs
        obtain ⟨y, hy, hxy⟩ := getElem_of_sig hA hx
        obtain ⟨y', env', hy', hr⟩ := (arms_zrel _ _ env hR0).2 j x hx
        obtain rfl : y = y' := Option.some.inj (hy.symm.trans hy')
        have hxn : sizeOf x < n := by have := armsOf_getElem_lt hx; omega
        have hp' := ih x y env' p hxn hr hxy hp
        exact zeroWords_sum (by rw [← ht, ← zeroIdx_of_sig hA]; exact hzi) hy hp'
          (by rw [← ht]; exact encodeArm_mono (armsLe_of_sig hA) hq)
    | _ => simp [zeroWords] at hz

theorem knone_nil : KNone [] := fun k => by simp [KEnv.ask]

theorem agree_nil (ρ : Nat → Nat) : IAgree [] ρ := fun k v h => by simp at h

/-- **`newBuf`'s zero is a value of the witness rendition** (option (1), M3):
the runtime zeroes a buffer at `close σs τ` with its `zeroWords`; under layout
and zero agreement (`WitL`) those words are a value of `cl ρ η.wit 0 0 τ`, of
its word count. -/
theorem zero_valOf {σs : List Ty} {η : TEnv} {opq : List Nat} (h : WitL σs η.wit opq)
    (hC : ∀ k, Clo (η.wit k)) (hAF : WitAF η) (ρ : Nat → Nat) {τ : Ty}
    (hg : opq.all (fun k => τ.guardT k) = true) (hr : ∀ k, τ.guardT k = false → k < σs.length)
    (haf : τ.arrFree = true) {zs : List WeakMem.Val}
    (hz : zeroableIn [] [] (close σs τ) = true) (hw : zeroWords (close σs τ) = some zs) :
    ValOf η (cl ρ η.wit 0 0 τ) (zs.map cst) ∧ wc (cl ρ η.wit 0 0 τ) = some zs.length := by
  have hs := sig_WitL h ρ hg hr
  have hR := zrel_WitL h hC ρ hg hr
  have hT := (zrel_zero _ _ [] [] hR hs knone_nil).1 hz
  have hwT := zrel_words _ _ _ [] zs (Nat.lt_succ_self _) hR hs hw
  obtain ⟨zs', hzw', hwc, hv⟩ := zp _ _ (Nat.lt_succ_self _) [] [] (arrFree_cl hAF.af τ 0 0 haf) knone_nil hT
  obtain rfl : zs = zs' := Option.some.inj (hwT.symm.trans hzw')
  exact ⟨⟨(hv _ (map_val_cst zs)).2 _ _ (agree_nil _), (hv _ (map_val_cst zs)).1⟩, hwc⟩

/-! ## §13 `newBuf` (T3c-5b, option (1))

`newBuf n τ` allocates `K` slots of `close σs τ` at the next fresh label, each
word the zero's (when the element type is `Zeroable` at runtime) or `undef`
(`allocBuf`).  The frame's view gains the cell `array (lit K) (cl ρ η.wit 0 0 τ)`
and counts `K` slots initialised exactly when it was zeroed (`bumpIni`); the
static `ini` claim needs that only when the static type is `Zeroable`, which
implies the runtime one (`zero_close`).  A fresh label has no slot counted
(`FreshL`), so the count is exactly that. -/

/-- `arrFree` reads only what `sig` keeps. -/
theorem arrFree_rf (t : Ty) : (rf t).arrFree = t.arrFree := by cases t <;> rfl

theorem arrFree_skel (t : Ty) : (skel t).arrFree = t.arrFree := by
  induction t <;> simp_all [skel, Ty.arrFree, arrFree_rf]

theorem arrFree_er (t : Ty) : (er t).arrFree = t.arrFree := by
  induction t <;> simp_all [er, Ty.arrFree]

theorem arrFree_sig (t : Ty) : (sig t).arrFree = t.arrFree := by
  simp [sig, arrFree_er, arrFree_skel]

/-- The word `allocBuf` writes at `j`. -/
def bufVal (z : Option (List WeakMem.Val)) (j : Nat) : WeakMem.Val :=
  match z with
  | some (z0 :: zs) => (z0 :: zs).getD (j % (z0 :: zs).length) .undef
  | _ => .undef

theorem bufVal_some {zs : List WeakMem.Val} {j : Nat} (h : 0 < zs.length) :
    zs[j % zs.length]? = some (bufVal (some zs) j) := by
  cases zs with
  | nil => simp at h
  | cons z0 zs =>
      simp only [bufVal]
      rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (Nat.mod_lt _ h)]
      rfl

theorem bufVal_none {z : Option (List WeakMem.Val)} (h : z = none) (j : Nat) : bufVal z j = .undef := by
  subst h; rfl

theorem allocBuf_mem (lbl : AllocLabel) (n : Nat) (z : Option (List WeakMem.Val)) (s : St) :
    (allocBuf lbl n z s).1.mem =
      (List.range n).foldl (fun m j => m.push ((fun j => (⟨offs ⟨lbl, 0⟩ j, bufVal z j, 0⟩ : Msg)) j)) s.mem := by
  simp only [allocBuf]
  congr 1

/-- **`newBuf`'s allocation** (T3c-5b, option (1)): at a fresh label, a buffer
of `N` slots of `e`, each word the zero's (when there is one) or `undef`;
memory stays OK, and the new cell is the thread's own buffer at its latest
words with `η.ini lbl` slots initialised — which needs the zero to be a value
of `e` when that count is positive. -/
theorem allocBuf_ok {lbl : AllocLabel} {N : Nat} {e : Ty} {us : List Acc} {z : Option (List WeakMem.Val)}
    {s : St} {η : TEnv} (hus : accs e = some us)
    (hz : ∀ zs, z = some zs → ValOf (allocE η lbl (.array (.lit N) e)) e (zs.map cst) ∧ zs.length = nWords us)
    (hini : η.ini lbl ≤ N) (hini0 : 0 < η.ini lbl → z ≠ none)
    (hfresh : ∀ (t : Nat) (m : Msg), s.mem[t]? = some m → m.loc.label ≠ lbl)
    (hnone : η.sto lbl = none)
    (hm : MemOK η s.mem s.pairs) (ho : OwnOK η s.mem s.vs) :
    MemOK (allocE η lbl (.array (.lit N) e)) (allocBuf lbl (N * nWords us) z s).1.mem
        (allocBuf lbl (N * nWords us) z s).1.pairs ∧
      OwnOK (allocE η lbl (.array (.lit N) e)) (allocBuf lbl (N * nWords us) z s).1.mem
        (allocBuf lbl (N * nWords us) z s).1.vs ∧
      (allocBuf lbl (N * nWords us) z s).2 = cst (.loc ⟨lbl, 0⟩ 0) := by
  generalize hw : nWords us = w at hz ⊢
  let n := N * w
  let f : Nat → Msg := fun j => ⟨offs ⟨lbl, 0⟩ j, bufVal z j, 0⟩
  have hM : (allocBuf lbl n z s).1.mem = (List.range n).foldl (fun m j => m.push (f j)) s.mem :=
    allocBuf_mem lbl n z s
  have hP : (allocBuf lbl n z s).1.pairs = s.pairs := rfl
  have hV : (allocBuf lbl n z s).1.vs.coh =
      fun b => if b.label = lbl ∧ b.offset < n then s.mem.size + b.offset else s.vs.coh b := rfl
  show MemOK _ (allocBuf lbl n z s).1.mem (allocBuf lbl n z s).1.pairs ∧
    OwnOK _ (allocBuf lbl n z s).1.mem (allocBuf lbl n z s).1.vs ∧
    (allocBuf lbl n z s).2 = cst (.loc ⟨lbl, 0⟩ 0)
  have hget : ∀ t : Nat, (allocBuf lbl n z s).1.mem[t]? =
      if t < s.mem.size then s.mem[t]? else if t < s.mem.size + n then some (f (t - s.mem.size)) else none := by
    intro t; rw [hM]; exact fold_get f n s.mem t
  have hsz : (allocBuf lbl n z s).1.mem.size = s.mem.size + n := by rw [hM]; exact fold_size f n s.mem
  have hold : ∀ t, t < s.mem.size → (allocBuf lbl n z s).1.mem[t]? = s.mem[t]? := fun t ht => by
    rw [hget t]; simp [ht]
  have hmono : ∀ {U : Ty} {vs : List Word}, ValOf η U vs → ValOf (allocE η lbl (.array (.lit N) e)) U vs :=
    fun h => ValOf_mono (η₁ := η) (η₂ := allocE η lbl (.array (.lit N) e)) rfl rfl
      (fun _ _ h' => allocE_sub hnone h') (fun _ => Nat.le_refl _) h
  have hzw : ∀ zs, z = some zs → 0 < n → 0 < w ∧ ∀ j, zs[j % w]? = some (bufVal z j) := by
    intro zs hzs hn
    have hl := (hz zs hzs).2
    have hw0 : 0 < w := Nat.pos_of_ne_zero (fun h => by simp [n, h] at hn)
    refine ⟨hw0, fun j => ?_⟩
    rw [hzs, ← hl]; exact bufVal_some (by omega)
  have hMem : MemOK (allocE η lbl (.array (.lit N) e)) (allocBuf lbl n z s).1.mem (allocBuf lbl n z s).1.pairs := by
    obtain ⟨h1, h2, h3⟩ := hm
    rw [hP]
    refine ⟨fun t m c ht hc => ?_, fun t m0 m1 c hp h0 h1' hc => ?_, fun t hp => ?_⟩
    · obtain ⟨t, rfl⟩ : ∃ t' : Nat, t' = t := ⟨t, rfl⟩
      rw [hget t] at ht
      by_cases hlt : t < s.mem.size
      · simp only [hlt, ite_true] at ht
        rw [allocE_ne (hfresh t m ht)] at hc
        rcases h1 t m c ht hc with hu | hw'
        · exact Or.inl hu
        · exact Or.inr (WordOK_map hmono hw')
      · simp only [hlt, ite_false] at ht
        split at ht
        · rename_i hlt2
          simp only [Option.some.injEq] at ht; subst ht
          simp [f, offs, allocE] at hc; subst hc
          rcases Option.eq_none_or_eq_some z with hzc | ⟨zs, hzc⟩
          · exact Or.inl (bufVal_none hzc _)
          · obtain ⟨hw0, hg⟩ := hzw zs hzc (by omega)
            refine Or.inr ⟨(t - s.mem.size) / w * w, e, zs.map cst, (t - s.mem.size) % w,
              cst (bufVal z (t - s.mem.size)),
              Or.inr ⟨N, us, (t - s.mem.size) / w, rfl, hus, (Nat.div_lt_iff_lt_mul hw0).2 (by omega), by rw [hw]⟩,
              ⟨(hz zs hzc).1, ShapeC_of_wc (wc_of_accs hus) (by rw [List.length_map, hw]; exact (hz zs hzc).2)⟩,
              by rw [List.getElem?_map, hg _]; rfl, ⟨rfl, fun _ _ _ => Nat.zero_le _⟩, ?_⟩
            simp only [f, offs, Nat.zero_add]; exact Nat.div_add_mod' _ _
        · cases ht
    · have hl := h3 t hp
      rw [hold t (Nat.lt_of_succ_lt hl)] at h0
      rw [hold (t + 1) hl] at h1'
      rw [allocE_ne (hfresh t m0 h0)] at hc
      exact PairOK_map hmono (h2 t m0 m1 c hp h0 h1' hc)
    · rw [hsz]; exact Nat.lt_of_lt_of_le (h3 t hp) (Nat.le_add_right _ _)
  refine ⟨hMem, fun l' c' hc' hown' => ?_, rfl⟩
  by_cases hl : l' = lbl
  · subst hl
    rw [allocE_eq] at hc'; cases hc'
    refine ⟨(List.range n).map (fun j => cst (bufVal z j)), Or.inr ?_, fun o v hov => ?_⟩
    · refine ⟨N, e, us, rfl, hus, hini, by simp [n, hw], fun j hj => ?_⟩
      rcases Option.eq_none_or_eq_some z with hzc | ⟨zs, hzc⟩
      · exact absurd hzc (hini0 (by simpa [allocE] using (show 0 < (allocE η l' (.array (.lit N) e)).ini l' by omega)))
      · have hzl := (hz zs hzc).2
        have e1 : (((List.range n).map (fun j => cst (bufVal z j))).drop (j * nWords us)).take (nWords us) =
            zs.map cst := by
          rw [hw]
          apply List.ext_getElem?; intro i
          rw [slice_get]
          by_cases hi : i < w
          · rw [if_pos hi]
            have hjN' : j < N := by have : (allocE η l' (.array (.lit N) e)).ini l' = η.ini l' := rfl; omega
            have hjN : j * w + i < n := by
              have := Nat.mul_le_mul_right w (show j + 1 ≤ N by omega); rw [Nat.succ_mul] at this
              show j * w + i < N * w; omega
            rw [List.getElem?_map, List.getElem?_range hjN]
            obtain ⟨_, hg⟩ := hzw zs hzc (by omega)
            have hmod : (j * w + i) % w = i := by
              rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hi]
            have := hg (j * w + i); rw [hmod] at this
            rw [List.getElem?_map, this]; rfl
          · rw [if_neg hi]; symm; exact List.getElem?_eq_none (by simp only [List.length_map]; omega)
        rw [e1]; exact (hz zs hzc).1
    · obtain ⟨o, rfl⟩ : ∃ o' : Nat, o' = o := ⟨o, rfl⟩
      have ho' : o < n := by
        have := (List.getElem?_eq_some_iff.1 hov).1; simpa using this
      rw [List.getElem?_map, List.getElem?_range ho'] at hov
      simp only [Option.map_some, Option.some.injEq] at hov; subst hov
      refine ⟨⟨f o, ?_, by simp [f, offs], rfl, fun _ _ _ => Nat.zero_le _⟩, fun t m ht hm' => ?_⟩
      · rw [hV, hget]; simp [ho']
      · obtain ⟨t, rfl⟩ : ∃ t' : Nat, t' = t := ⟨t, rfl⟩
        rw [hV] at ht; simp [ho'] at ht
        replace ht : s.mem.size + o < (t : Nat) := ht
        rw [hget t] at hm'
        have h0 : ¬ t < s.mem.size := by omega
        simp only [h0, ite_false] at hm'
        split at hm'
        · simp only [Option.some.injEq] at hm'; subst hm'
          simp [f, offs]; intro h; replace h : (t : Nat) - s.mem.size = o := h; omega
        · cases hm'
  · rw [allocE_ne hl] at hc'
    obtain ⟨vals', h1, h4⟩ := ho l' c' hc' hown'
    refine ⟨vals', CellOK_map hmono (Nat.le_refl _) h1, fun o v hov => ?_⟩
    obtain ⟨⟨m, hm0, hma, hmv, hmw⟩, hab⟩ := h4 o v hov
    have hcoh : (allocBuf lbl n z s).1.vs.coh ⟨l', o⟩ = s.vs.coh ⟨l', o⟩ := by rw [hV]; simp [hl]
    refine ⟨⟨m, ?_, hma, hmv, hmw⟩, fun t m' ht hm' => ?_⟩
    · rw [hcoh, hold _ (lt_of_get hm0)]; exact hm0
    · have ht' : s.vs.coh ⟨l', o⟩ < t := by rw [← hcoh]; exact ht
      rw [hget t] at hm'
      by_cases hlt : t < s.mem.size
      · simp only [hlt, ite_true] at hm'; exact hab t m' ht' hm'
      · simp only [hlt, ite_false] at hm'
        split at hm'
        · simp only [Option.some.injEq] at hm'; subst hm'
          intro e; apply hl
          have := congrArg WeakMem.Address.label e
          simpa [f, offs] using this.symm
        · cases hm'


/-- (S4) `allocBuf_ok` with own promises skipped. -/
theorem allocBuf_okP {lbl : AllocLabel} {N : Nat} {e : Ty} {us : List Acc} {z : Option (List WeakMem.Val)}
    {s : St} {η : TEnv} (hus : accs e = some us)
    (hz : ∀ zs, z = some zs → ValOf (allocE η lbl (.array (.lit N) e)) e (zs.map cst) ∧ zs.length = nWords us)
    (hini : η.ini lbl ≤ N) (hini0 : 0 < η.ini lbl → z ≠ none)
    (hfresh : ∀ (t : Nat) (m : Msg), s.mem[t]? = some m → m.loc.label = lbl → t ∈ s.promises)
    (hnone : η.sto lbl = none) (hpl : PromLt s) (hpp : ∀ t, t ∈ s.promises → t ∉ s.pairs)
    (hm : MemOKP η s.mem s.pairs s.promises) (ho : OwnOKPF η s.mem s.pairs s.vs s.promises)
    (hpf0 : η.pfr lbl = none) :
    MemOKP (allocE η lbl (.array (.lit N) e)) (allocBuf lbl (N * nWords us) z s).1.mem
        (allocBuf lbl (N * nWords us) z s).1.pairs s.promises ∧
      OwnOKPF (allocE η lbl (.array (.lit N) e)) (allocBuf lbl (N * nWords us) z s).1.mem
        (allocBuf lbl (N * nWords us) z s).1.pairs (allocBuf lbl (N * nWords us) z s).1.vs s.promises ∧
      (allocBuf lbl (N * nWords us) z s).2 = cst (.loc ⟨lbl, 0⟩ 0) := by
  generalize hw : nWords us = w at hz ⊢
  let n := N * w
  let f : Nat → Msg := fun j => ⟨offs ⟨lbl, 0⟩ j, bufVal z j, 0⟩
  have hM : (allocBuf lbl n z s).1.mem = (List.range n).foldl (fun m j => m.push (f j)) s.mem :=
    allocBuf_mem lbl n z s
  have hP : (allocBuf lbl n z s).1.pairs = s.pairs := rfl
  have hV : (allocBuf lbl n z s).1.vs.coh =
      fun b => if b.label = lbl ∧ b.offset < n then s.mem.size + b.offset else s.vs.coh b := rfl
  show MemOKP _ (allocBuf lbl n z s).1.mem (allocBuf lbl n z s).1.pairs s.promises ∧
    OwnOKPF _ (allocBuf lbl n z s).1.mem (allocBuf lbl n z s).1.pairs (allocBuf lbl n z s).1.vs s.promises ∧
    (allocBuf lbl n z s).2 = cst (.loc ⟨lbl, 0⟩ 0)
  have hget : ∀ t : Nat, (allocBuf lbl n z s).1.mem[t]? =
      if t < s.mem.size then s.mem[t]? else if t < s.mem.size + n then some (f (t - s.mem.size)) else none := by
    intro t; rw [hM]; exact fold_get f n s.mem t
  have hsz : (allocBuf lbl n z s).1.mem.size = s.mem.size + n := by rw [hM]; exact fold_size f n s.mem
  have hold : ∀ t, t < s.mem.size → (allocBuf lbl n z s).1.mem[t]? = s.mem[t]? := fun t ht => by
    rw [hget t]; simp [ht]
  have hmono : ∀ {U : Ty} {vs : List Word}, ValOf η U vs → ValOf (allocE η lbl (.array (.lit N) e)) U vs :=
    fun h => ValOf_mono (η₁ := η) (η₂ := allocE η lbl (.array (.lit N) e)) rfl rfl
      (fun _ _ h' => allocE_sub hnone h') (fun _ => Nat.le_refl _) h
  have hzw : ∀ zs, z = some zs → 0 < n → 0 < w ∧ ∀ j, zs[j % w]? = some (bufVal z j) := by
    intro zs hzs hn
    have hl := (hz zs hzs).2
    have hw0 : 0 < w := Nat.pos_of_ne_zero (fun h => by simp [n, h] at hn)
    refine ⟨hw0, fun j => ?_⟩
    rw [hzs, ← hl]; exact bufVal_some (by omega)
  have hMem : MemOKP (allocE η lbl (.array (.lit N) e)) (allocBuf lbl n z s).1.mem (allocBuf lbl n z s).1.pairs
      s.promises := by
    obtain ⟨h1, h2, h3⟩ := hm
    rw [hP]
    refine ⟨fun t m c hn ht hc => ?_, fun t m0 m1 c hp h0 h1' hc => ?_, fun t hp => ?_⟩
    · obtain ⟨t, rfl⟩ : ∃ t' : Nat, t' = t := ⟨t, rfl⟩
      rw [hget t] at ht
      by_cases hlt : t < s.mem.size
      · simp only [hlt, ite_true] at ht
        rw [allocE_ne (fun e => hn (hfresh t m ht e))] at hc
        rcases h1 t m c hn ht hc with hu | hw'
        · exact Or.inl hu
        · exact Or.inr (WordOK_map hmono hw')
      · simp only [hlt, ite_false] at ht
        split at ht
        · rename_i hlt2
          simp only [Option.some.injEq] at ht; subst ht
          simp [f, offs, allocE] at hc; subst hc
          rcases Option.eq_none_or_eq_some z with hzc | ⟨zs, hzc⟩
          · exact Or.inl (bufVal_none hzc _)
          · obtain ⟨hw0, hg⟩ := hzw zs hzc (by omega)
            refine Or.inr ⟨(t - s.mem.size) / w * w, e, zs.map cst, (t - s.mem.size) % w,
              cst (bufVal z (t - s.mem.size)),
              Or.inr ⟨N, us, (t - s.mem.size) / w, rfl, hus, (Nat.div_lt_iff_lt_mul hw0).2 (by omega), by rw [hw]⟩,
              ⟨(hz zs hzc).1, ShapeC_of_wc (wc_of_accs hus) (by rw [List.length_map, hw]; exact (hz zs hzc).2)⟩,
              by rw [List.getElem?_map, hg _]; rfl, ⟨rfl, fun _ _ _ => Nat.zero_le _⟩, ?_⟩
            simp only [f, offs, Nat.zero_add]; exact Nat.div_add_mod' _ _
        · cases ht
    · have hl := h3 t hp
      rw [hold t (Nat.lt_of_succ_lt hl)] at h0
      rw [hold (t + 1) hl] at h1'
      rw [allocE_ne (fun e => hpp t (hfresh t m0 h0 e) hp)] at hc
      exact PairOK_map hmono (h2 t m0 m1 c hp h0 h1' hc)
    · rw [hsz]; exact Nat.lt_of_lt_of_le (h3 t hp) (Nat.le_add_right _ _)
  refine ⟨hMem, fun l' c' hc' hown' => ?_, rfl⟩
  by_cases hl : l' = lbl
  · subst hl
    rw [allocE_eq] at hc'; cases hc'
    have hrc : (allocE η l' (.array (.lit N) e)).rc l' ≤ (allocE η l' (.array (.lit N) e)).ini l' :=
      TEnv.rc_le_ini _ _
    refine ⟨(List.range n).map (fun j => cst (bufVal z j)), Or.inr ?_, fun o v hov => LatestSF_of_LatestS ?_,
      fun h => absurd hpf0 h⟩
    · refine ⟨N, e, us, rfl, hus, Nat.le_trans hrc hini, by simp [n, hw], fun j hj => ?_⟩
      rcases Option.eq_none_or_eq_some z with hzc | ⟨zs, hzc⟩
      · exact absurd hzc (hini0 (by simpa [allocE] using (show 0 < (allocE η l' (.array (.lit N) e)).ini l' by omega)))
      · have hzl := (hz zs hzc).2
        have e1 : (((List.range n).map (fun j => cst (bufVal z j))).drop (j * nWords us)).take (nWords us) =
            zs.map cst := by
          rw [hw]
          apply List.ext_getElem?; intro i
          rw [slice_get]
          by_cases hi : i < w
          · rw [if_pos hi]
            have hjN' : j < N := by have : (allocE η l' (.array (.lit N) e)).ini l' = η.ini l' := rfl; omega
            have hjN : j * w + i < n := by
              have := Nat.mul_le_mul_right w (show j + 1 ≤ N by omega); rw [Nat.succ_mul] at this
              show j * w + i < N * w; omega
            rw [List.getElem?_map, List.getElem?_range hjN]
            obtain ⟨_, hg⟩ := hzw zs hzc (by omega)
            have hmod : (j * w + i) % w = i := by
              rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hi]
            have := hg (j * w + i); rw [hmod] at this
            rw [List.getElem?_map, this]; rfl
          · rw [if_neg hi]; symm; exact List.getElem?_eq_none (by simp only [List.length_map]; omega)
        rw [e1]; exact (hz zs hzc).1
    · obtain ⟨o, rfl⟩ : ∃ o' : Nat, o' = o := ⟨o, rfl⟩
      have ho' : o < n := by
        have := (List.getElem?_eq_some_iff.1 hov).1; simpa using this
      rw [List.getElem?_map, List.getElem?_range ho'] at hov
      simp only [Option.map_some, Option.some.injEq] at hov; subst hov
      refine ⟨⟨f o, ?_, by simp [f, offs], rfl, fun _ _ _ => Nat.zero_le _⟩, fun hp => ?_,
        fun t m ht hm' hlo => ?_⟩
      · rw [hV, hget]; simp [ho']
      · rw [hV] at hp; simp [ho'] at hp
        exact Nat.not_lt.2 (Nat.le_add_right _ _) (hpl _ hp)
      · exfalso
        obtain ⟨t, rfl⟩ : ∃ t' : Nat, t' = t := ⟨t, rfl⟩
        rw [hV] at ht; simp [ho'] at ht
        replace ht : s.mem.size + o < (t : Nat) := ht
        rw [hget t] at hm'
        have h0 : ¬ t < s.mem.size := by omega
        simp only [h0, ite_false] at hm'
        split at hm'
        · simp only [Option.some.injEq] at hm'; subst hm'
          revert hlo; simp [f, offs]; intro h; replace h : (t : Nat) - s.mem.size = o := h; omega
        · cases hm'
  · rw [allocE_ne hl] at hc'
    exact OwnCellF_frame (ho l' c' hc' hown') hmono rfl rfl hold
      (fun t m ht hm' => by
        rw [hget t] at hm'
        simp only [Nat.not_lt.2 ht, ite_false] at hm'
        split at hm'
        · simp only [Option.some.injEq] at hm'; subst hm'
          intro e; apply hl; simpa [f, offs] using e.symm
        · cases hm')
      (fun o => by rw [hV]; simp [hl]) (fun _ h => h) (fun _ _ h _ _ => h) (fun _ h => h) hm.2.2


/-- (M2b) With a zero, every message `allocBuf` writes is a word of the new
buffer: there is no placeholder. -/
theorem allocBuf_newOK {lbl : AllocLabel} {N : Nat} {e : Ty} {us : List Acc} {z : Option (List WeakMem.Val)}
    {s : St} {η : TEnv} (hus : accs e = some us)
    (hz : ∀ zs, z = some zs → ValOf (allocE η lbl (.array (.lit N) e)) e (zs.map cst) ∧ zs.length = nWords us)
    (zs : List WeakMem.Val) (hzc : z = some zs) (t : Nat) (m : Msg) (ht : s.mem.size ≤ t)
    (hm : (allocBuf lbl (N * nWords us) z s).1.mem[t]? = some m) :
    WordOK (allocE η lbl (.array (.lit N) e)) (.array (.lit N) e) m.loc.offset (mw m) := by
  generalize hw : nWords us = w at hz hm
  let n := N * w
  let f : Nat → Msg := fun j => ⟨offs ⟨lbl, 0⟩ j, bufVal z j, 0⟩
  have hM : (allocBuf lbl n z s).1.mem = (List.range n).foldl (fun m j => m.push (f j)) s.mem :=
    allocBuf_mem lbl n z s
  have hget : (allocBuf lbl n z s).1.mem[t]? =
      if t < s.mem.size then s.mem[t]? else if t < s.mem.size + n then some (f (t - s.mem.size)) else none := by
    rw [hM]; exact fold_get f n s.mem t
  change (allocBuf lbl n z s).1.mem[t]? = some m at hm
  rw [hget] at hm
  have h0 : ¬ t < s.mem.size := by omega
  simp only [h0, ite_false] at hm
  split at hm
  · rename_i hlt2
    simp only [Option.some.injEq] at hm; subst hm
    have hl := (hz zs hzc).2
    have hn : 0 < n := by omega
    have hw0 : 0 < w := Nat.pos_of_ne_zero (fun h => by simp [n, h] at hn)
    have hg : ∀ j, zs[j % w]? = some (bufVal z j) := fun j => by
      rw [hzc, ← hl]; exact bufVal_some (by omega)
    refine ⟨(t - s.mem.size) / w * w, e, zs.map cst, (t - s.mem.size) % w,
      cst (bufVal z (t - s.mem.size)),
      Or.inr ⟨N, us, (t - s.mem.size) / w, rfl, hus, (Nat.div_lt_iff_lt_mul hw0).2 (by omega), by rw [hw]⟩,
      ⟨(hz zs hzc).1, ShapeC_of_wc (wc_of_accs hus) (by rw [List.length_map, hw]; exact (hz zs hzc).2)⟩,
      by rw [List.getElem?_map, hg _]; rfl, ⟨rfl, fun _ _ _ => Nat.zero_le _⟩, ?_⟩
    simp only [f, offs, Nat.zero_add]; exact Nat.div_add_mod' _ _
  · cases hm

/-- **`newBuf`'s allocation** only appends, at its label, keeps the promises,
and counts one more allocation. -/
theorem allocBuf_grows (lbl : AllocLabel) (n : Nat) (z : Option (List WeakMem.Val)) (s : St) :
    GrowsAt s.mem (allocBuf lbl n z s).1.mem lbl ∧ (allocBuf lbl n z s).1.promises = s.promises ∧
      (allocBuf lbl n z s).1.nalloc = s.nalloc + 1 := by
  let f : Nat → Msg := fun j => ⟨offs ⟨lbl, 0⟩ j, bufVal z j, 0⟩
  have hM : (allocBuf lbl n z s).1.mem = (List.range n).foldl (fun m j => m.push (f j)) s.mem :=
    allocBuf_mem lbl n z s
  refine ⟨⟨?_, fun t ht => ?_, fun t m ht hm => ?_⟩, rfl, rfl⟩
  · rw [hM, fold_size]; omega
  · rw [hM, fold_get]; simp [ht]
  · rw [hM, fold_get] at hm
    have h0 : ¬ t < s.mem.size := by omega
    simp only [h0, ite_false] at hm
    split at hm
    · simp only [Option.some.injEq] at hm; subst hm; rfl
    · cases hm

/-- (privSlot) `PrivCoh` across `allocBuf`: at the fresh label the old messages
are promises and the new ones are the placeholders at coherence, `.undef` unless
zeroed (and then every slot is counted). -/
theorem PrivCoh_allocBuf {E E' : TEnv} {s : St} {lbl : AllocLabel} {n : Nat} {z : Option (List WeakMem.Val)}
    (h : PrivCoh E s) (hU : ∀ a, PrivU E' a → a.label ≠ lbl → PrivU E a)
    (hO : OwnOKPF E' (allocBuf lbl n z s).1.mem (allocBuf lbl n z s).1.pairs (allocBuf lbl n z s).1.vs
      (allocBuf lbl n z s).1.promises)
    (hfresh : ∀ (t : Nat) (m : Msg), s.mem[t]? = some m → m.loc.label = lbl → t ∈ s.promises)
    (hz : ∀ a, PrivU E' a → a.label = lbl → z = none) : PrivCoh E' (allocBuf lbl n z s).1 := by
  obtain ⟨hg, hpr, -⟩ := allocBuf_grows lbl n z s
  refine PrivCoh_growsAt h hU hO hg (fun t h1 h2 => absurd (hpr ▸ h1) h2) fun t m ht hm hu hl => ?_
  have hget := fold_get (fun j => (⟨offs ⟨lbl, 0⟩ j, bufVal z j, 0⟩ : Msg)) n s.mem t
  rw [← allocBuf_mem] at hget
  rw [hget] at hm
  by_cases h1 : t < s.mem.size
  · simp only [h1, ↓reduceIte] at hm
    exact absurd (hpr ▸ hfresh t m hm hl) ht
  · by_cases h2 : t < s.mem.size + n
    · simp only [h1, h2, ↓reduceIte, Option.some.injEq] at hm
      subst hm
      have hz0 := hz _ hu hl
      refine ⟨?_, bufVal_none hz0 _⟩
      show t = (if (offs ⟨lbl, 0⟩ (t - s.mem.size)).label = lbl ∧ (offs ⟨lbl, 0⟩ (t - s.mem.size)).offset < n
        then s.mem.size + (offs ⟨lbl, 0⟩ (t - s.mem.size)).offset else s.vs.coh (offs ⟨lbl, 0⟩ (t - s.mem.size)))
      have hc : (offs ⟨lbl, 0⟩ (t - s.mem.size)).label = lbl ∧ (offs ⟨lbl, 0⟩ (t - s.mem.size)).offset < n :=
        ⟨rfl, show 0 + (t - s.mem.size) < n by omega⟩
      rw [if_pos hc]
      show t = s.mem.size + (0 + (t - s.mem.size))
      omega
    · simp only [h1, h2, ↓reduceIte] at hm; cases hm
#print axioms PrivCoh_allocBuf

/-- `newBuf`'s allocation only raises `vWr` (to the last message in memory). -/
theorem allocBuf_vWr_le (lbl : AllocLabel) (n : Nat) (z : Option (List WeakMem.Val)) (s : St) :
    s.vs.vWr ≤ (allocBuf lbl n z s).1.vs.vWr :=
  show s.vs.vWr ≤ max s.vs.vWr (s.mem.size + n - 1) from Nat.le_max_left _ _

/-- (S7b′) A buffer allocation keeps `OwnPubV` (at the same environment). -/
theorem OwnPubV.allocBuf {E : TEnv} {s : St} (h : OwnPubV E s) (hpl : PromLt s) (lbl : AllocLabel) (n : Nat)
    (z : Option (List WeakMem.Val)) : OwnPubV E (allocBuf lbl n z s).1 := by
  obtain ⟨hg, hpr, -⟩ := allocBuf_grows lbl n z s
  exact h.mono (allocBuf_vWr_le lbl n z s) hpl (fun t h1 h2 => absurd (by rw [hpr]; exact h1) h2)
    (fun u hu => .inl (by rw [hpr] at hu; exact hu)) hg.2.1



/-- (T3c-5d) `newBuf`'s allocation keeps `BoxInv`. -/
theorem BoxInv_allocBuf {g : G} {E E' : TEnv} {s : St} {lbl : AllocLabel} {n : Nat} {z : Option (List WeakMem.Val)}
    (h : BoxInv g E s) (hlbl : lbl = freshLabel g.lbase g.n g.i s.nalloc) (hb : E'.box = E.box) (hse : E'.seen = E.seen)
    (hs : ∀ l, l ≠ lbl → E'.sto l = E.sto l) (hi : ∀ l, l ≠ lbl → E'.ini l = E.ini l) :
    BoxInv g E' (allocBuf lbl n z s).1 := by
  obtain ⟨hg, hpr, hna⟩ := allocBuf_grows lbl n z s
  have hne : ∀ l B, E.box l = some B → l ≠ lbl := fun l B hl he => by
    rw [he, hlbl, h.1 s.nalloc (Nat.le_refl _)] at hl; cases hl
  exact BoxInv_tr h hb (fun _ _ _ h => by rw [hse] at h; exact h) (fun l B hl => hs l (hne l B hl))
    (fun l B hl => hi l (hne l B hl))
    (by rw [hna]; omega)
    (fun l B hl o v t hv => by
      rw [hpr]; exact LatestP_growsAt hv hg (hne l B hl) (fun _ h => h) (fun _ h1 h2 => absurd h1 h2))
    (fun l B hl _ o v hv => by
      rw [hpr]; exact LatestS_growsAt hv hg (hne l B hl) (by simp [allocBuf, hne l B hl]))

/-- (UndefNew) `allocBuf` at a non-zeroable element (no zero) leaves an `undef` placeholder at
every unit of the new buffer. -/
theorem allocBuf_undefT {lbl : AllocLabel} {K n : Nat} {z : Option (List WeakMem.Val)} {s : St} {e : Ty}
    {L : List Acc} (he : accs e = some L) (hn : nWords L = n) (hz : zeroableIn [] [] e = false → z = none) :
    UndefAtT (allocBuf lbl (K * n) z s).1.mem lbl (.array (.lit K) e) := by
  intro hT
  have hz0 : z = none := hz (by simpa [zeroableIn] using hT)
  subst hz0
  refine .inr ⟨K, e, L, rfl, he, fun o ho => ?_⟩
  rw [hn] at ho
  refine ⟨s.mem.size + o, ⟨⟨lbl, o⟩, .undef, 0⟩, ?_, rfl, rfl⟩
  rw [allocBuf_mem]
  have h := TermLiveProps.fold_get (fun j => (⟨offs ⟨lbl, 0⟩ j, bufVal none j, 0⟩ : Msg))
    (List.range (K * n)) s.mem o (by simp; exact ho)
  rw [h]
  simp [offs, bufVal]

/-- (msgWords) `allocBuf` writes past the old memory only within the new buffer's words. -/
theorem allocBuf_words {lbl : AllocLabel} {K n : Nat} {z : Option (List WeakMem.Val)} {s : St} {e : Ty}
    {L : List Acc} (he : accs e = some L) (hn : nWords L = n) :
    ∀ (t : Nat) (m : Msg), s.mem.size ≤ t → (allocBuf lbl (K * n) z s).1.mem[t]? = some m → m.loc.label = lbl →
      InWords (.array (.lit K) e) m.loc.offset := by
  intro t m ht hm _
  rw [allocBuf_mem, TermMem.fold_get] at hm
  have a1 : ¬ t < s.mem.size := by omega
  simp only [a1, ↓reduceIte] at hm
  by_cases h1 : t < s.mem.size + K * n
  · simp only [h1, ↓reduceIte] at hm
    cases hm
    refine ⟨fun L' hL' => by simp [accs] at hL', fun N e' us' hT hus' => ?_⟩
    simp only [Ty.array.injEq, Idx.lit.injEq] at hT
    obtain ⟨rfl, rfl⟩ := hT
    rw [he] at hus'
    cases hus'
    show 0 + (t - s.mem.size) < _
    rw [hn]
    omega
  · simp only [h1, ↓reduceIte] at hm
    cases hm

/-- (NewAt) `allocBuf` writes a message past the old memory at every unit of the new buffer
(zeros or `undef`s). -/
theorem allocBuf_newT {lbl : AllocLabel} {K n : Nat} {z : Option (List WeakMem.Val)} {s : St} {e : Ty}
    {L : List Acc} (he : accs e = some L) (hn : nWords L = n) :
    NewAtT s.mem.size (allocBuf lbl (K * n) z s).1.mem lbl (.array (.lit K) e) := by
  refine ⟨?_, allocBuf_words he hn⟩
  refine .inr ⟨K, e, L, rfl, he, fun o ho => ?_⟩
  rw [hn] at ho
  refine ⟨s.mem.size + o, ⟨offs ⟨lbl, 0⟩ o, bufVal z o, 0⟩, Nat.le_add_right _ _, ?_, by simp [offs]⟩
  rw [allocBuf_mem]
  have h := TermLiveProps.fold_get (fun j => (⟨offs ⟨lbl, 0⟩ j, bufVal z j, 0⟩ : Msg))
    (List.range (K * n)) s.mem o (by simp; exact ho)
  rw [h]
  simp

/-- **P1 + P4 at the thread, `newBuf`** (T3c-5b, option (1)): a buffer of `K`
slots of the closed element type, at the next fresh label, zeroed when the
runtime element type is `Zeroable` (`zero_valOf`: the zero is a value of the
witness rendition); the frame's view grows by the new cell and counts `K`
slots initialised exactly when the static type says so (`zero_close`).  The
runtime element type has a layout because the type arguments do (`KindsL`,
`accs_close`). -/
theorem tstepM_newBufA {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {n : At} {τ : Ty} {e : Expr}
    (hterm : th.term = .let_ x (.newBuf n τ) e) (hniA : noIallV τ = true) (hP : ProgT p)
    (hn : 0 < g.n)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMFA p g ρ η th (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | newBuf hwf hsc hop haf hint hb =>
  rename_i k
  obtain ⟨ti, hpi, hti⟩ := hint
  obtain ⟨rti, wsi, hei, hvi, -⟩ := peek_VR hi.2.1 hpi
  obtain ⟨wi, rfl, hwi⟩ := map_singleton (VR_intS hti hvi)
  have hlay : accs (close th.σs τ) ≠ none := accs_close hwf hi.2.2.2.2.1 haf hi.2.2.2.2.2.1.2.2
  obtain ⟨us, hus⟩ : ∃ us, accs (close th.σs τ) = some us := Option.ne_none_iff_exists'.1 hlay
  -- the two renditions of the element type
  have hr : ∀ k, τ.guardT k = false → k < th.σs.length := lt_of_guardT (tb_of_wf τ hwf) hi.2.2.2.2.1
  have hsig : sig (close th.σs τ) = sig (cl ρ η.wit 0 0 τ) := sig_WitL hi.2.2.2.1 ρ hop hr
  have hwT : wc (cl ρ η.wit 0 0 τ) = some (nWords us) := by rw [← wc_of_sig hsig]; simp [wc, hus]
  obtain ⟨usT, husT⟩ : ∃ usT, accs (cl ρ η.wit 0 0 τ) = some usT := by
    cases h : accs (cl ρ η.wit 0 0 τ) with
    | none => simp [wc, h] at hwT
    | some usT => exact ⟨usT, rfl⟩
  have hnw : nWords usT = nWords us := by rw [wc_of_accs husT] at hwT; exact Option.some.inj hwT
  have hafT : (cl ρ η.wit 0 0 τ).arrFree = true := arrFree_cl hi.2.2.2.2.2.2.1.af τ 0 0 haf
  have hafR : (close th.σs τ).arrFree = true := by rw [← arrFree_sig, hsig, arrFree_sig]; exact hafT
  -- the zero
  let z : Option (List WeakMem.Val) := if zeroableIn [] [] (close th.σs τ) = true then zeroWords (close th.σs τ) else none
  have hzv : ∀ zs, z = some zs → ValOf η (cl ρ η.wit 0 0 τ) (zs.map cst) ∧ wc (cl ρ η.wit 0 0 τ) = some zs.length := by
    intro zs h
    simp only [z] at h
    split at h
    · exact zero_valOf hi.2.2.2.1 (fun k => (hE.2.1 k).1) hi.2.2.2.2.2.2.1 ρ hop hr haf ‹_› h
    · cases h
  have hstat : zeroableIn [] cx.ke τ = true → z.isSome = true := by
    intro h
    have hR := KindSound.zero_close cx.ke th.σs τ hi.2.2.2.2.2.1.2.1 h
    obtain ⟨zs, hzs, -⟩ := zp _ _ (Nat.lt_succ_self _) [] [] hafR knone_nil hR
    simp [z, hR, hzs]
  -- the new view
  let K := ev ρ k
  let lbl := freshLabel g.lbase g.n g.i th.nalloc
  let iv : Nat := if z.isSome then K else 0
  let ini' := bumpIni η.ini lbl iv
  let rini' := bumpIni η.rini lbl iv
  have hri' : ∀ l, η.rini l ≤ rini' l := bumpIni_le _ _ _
  let E0 := CE (η.withSto η.sto ini' (Ri := rini'))
  let T := Ty.array (.lit K) (cl ρ η.wit 0 0 τ)
  let E' := allocE E0 lbl T
  let η' := η.withSto E'.sto ini' (Ri := rini')
  obtain ⟨hmo, hoo, hpl, hfr, hsn, hoh, hpd, hopub, hpi, hbi, hpo⟩ := id hm
  obtain ⟨hnone, hfresh, hi0, hpf0⟩ := hfr.1 th.nalloc (Nat.le_refl _)
  have hnone0 : E0.sto lbl = none := hnone
  have hx : Ext η η' := Ext_withSto hE.2.1 (fun l c h => allocE_sub (η := E0) hnone0 h) (bumpIni_le _ _ _)
    (Ri := rini') (hRi := hri')
  let rtR : Ty := .refine (.loc .own (.array (.lit K) (close th.σs τ))) (.ini (.lit iv))
  let R := allocBuf lbl (K * nWords us) z (stOf mem pairs th)
  have key : tstep g mem pairs th =
      [(R.1.mem, R.1.pairs, withS { th with term := e, env := (x, rtR, [R.2]) :: th.env } R.1)] := by
    simp only [tstep, hterm, evalOp, hei, numOf, hus, Option.bind_eq_bind, Option.bind_some, hwi]; rfl
  rw [key]
  refine ⟨by simp, fun r hr' => ?_⟩
  simp only [List.mem_singleton] at hr'
  subst hr'
  have hpw : R.2 = cst (.loc ⟨lbl, 0⟩ 0) := rfl
  -- memory, at the view with the raised count (the label is fresh)
  have hsub0 : ∀ l c, (CE η).sto l = some c → E0.sto l = some c := fun l c h => h
  have hile0 : ∀ l, (CE η).ini l ≤ E0.ini l := bumpIni_le η.ini lbl iv
  have hmo0 : MemOKP E0 (stOf mem pairs th).mem (stOf mem pairs th).pairs (stOf mem pairs th).promises :=
    MemOKP_mono hmo rfl rfl hsub0 hile0 (fun t m c h hc => hc)
  have hmono0 : ∀ {U : Ty} {vs : List Word}, ValOf (CE η) U vs → ValOf E0 U vs :=
    fun h => ValOf_mono (η₁ := CE η) (η₂ := E0) rfl rfl hsub0 hile0 h
  have hoo0 : OwnOKPF E0 (stOf mem pairs th).mem (stOf mem pairs th).pairs (stOf mem pairs th).vs
      (stOf mem pairs th).promises := by
    intro l c hc ho
    have hne : l ≠ lbl := fun h => by rw [h] at hc; rw [hnone0] at hc; cases hc
    exact OwnCellF_env (hoo l c hc ho) hmono0 (bumpIni_other _ _ _ _ hne) rfl hmo.2.2 (bumpIni_other _ _ _ _ hne)
  have hi0' : η.ini lbl = 0 := hi0
  have hini : E0.ini lbl ≤ K := by
    show bumpIni η.ini lbl iv lbl ≤ K
    rw [bumpIni_self, hi0']
    refine Nat.max_le.2 ⟨Nat.zero_le _, ?_⟩
    simp only [iv]; split <;> omega
  have hini0 : 0 < E0.ini lbl → z ≠ none := by
    intro h hz0
    have : E0.ini lbl = 0 := by
      show bumpIni η.ini lbl iv lbl = 0
      rw [bumpIni_self, hi0']; simp [iv, hz0]
    omega
  have hzE : ∀ zs, z = some zs → ValOf E' (cl ρ η.wit 0 0 τ) (zs.map cst) ∧ zs.length = nWords usT :=
    fun zs h => ⟨ValOf_mono (η₁ := η) (η₂ := E') rfl rfl (fun l c h' => allocE_sub (η := E0) hnone0 h')
      (bumpIni_le _ _ _) (hzv zs h).1,
      by have := (hzv zs h).2; rw [hwT] at this; rw [hnw]; exact (Option.some.inj this).symm⟩
  have hab := allocBuf_okP (lbl := lbl) (N := K) (e := cl ρ η.wit 0 0 τ) (us := usT) (z := z)
    (s := stOf mem pairs th) (η := E0) husT hzE
    hini hini0 hfresh hnone0 hpl hpo.2.1 hmo0 hoo0 hpf0
  rw [hnw] at hab
  obtain ⟨hmo', hoo', -⟩ := hab
  obtain ⟨hg, hpr, hna⟩ := allocBuf_grows lbl (K * nWords us) z (stOf mem pairs th)
  have hwE : ∀ T o w, WordOK (CE η) T o w → WordOK E' T o w := fun T o w h =>
    WordOK_mono (η₁ := CE η) (η₂ := E') rfl rfl (fun l c h' => allocE_sub (η := E0) hnone0 h')
      (bumpIni_le _ _ _) (fun _ _ h' => h') (fun _ h' => h') h
  have hiniE : ∀ l c o, l ≠ lbl → InitR E' c l o → InitR (CE η) c l o := fun l c o hl hi N1 e1 us1 h1 h2 => by
    have := hi N1 e1 us1 h1 h2
    rw [show E'.ini l = η.ini l from bumpIni_other _ _ _ _ hl] at this; exact this
  have hoh' : OwnHidP E' R.1.mem R.1.vs R.1.promises := by
    refine ⟨?_, ?_⟩
    · intro l c hc ho o hi
