  have key : MemHeldL (boxE E (freshLabel g.lbase g.n g.i s.nalloc) B) r.1 H S :=
    MemHeldL_trS hH (fun _ => rfl) (fun _ => rfl)
      (fun l c hc o w hw => LatestNP_growsAtF hg (fun t h => hsub.subset h) hful (fun e => by rw [e, hnone] at hc; cases hc) hw)
