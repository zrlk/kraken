  have hP1 : ∀ t, t ∈ s1.promises → t < s1.mem.size := by rw [e1, e2]; exact hP
  have hto : ∀ b w, LatestNP s2.mem (PromAt E s2 b) b w → LatestNP s'.mem (PromAt E s' b) b w :=
    fun b w h => by rw [PromAt_eqp e4, e3]; exact h
  have htA : ∀ lo hi, lo ≤ a.offset → a.offset < hi → TouchS s s' a.label lo hi := fun lo hi h1 h2 => by
    obtain ⟨t, m, h1', h2', h3', h4', h5'⟩ :=
      TouchS_store (s0 := s) hs2 (by simp [nWords, Acc.size]) (by rw [e1]) hcoh1 h1 h2
    exact ⟨t, m, by rw [e3]; exact h1', h2', h3', h4', by rw [e4]; exact h5'⟩
  obtain ⟨H', hH', hle⟩ : ∃ H', MemHeldK E s Sl E s' H' ∧ H' ≤ H + Rv := by
    refine heldOneL (s' := s') hH hsto hat hini hna hwc (fun w0 Rq hl0 hv0 hV0 => ?_) (fun b w hb hl => ?_) htA
    · have hl0' : LatestNP s1.mem (PromAt E s1 a) a w0 := by rw [PromAt_eqp e2, e1]; exact hl0
      obtain ⟨sel, vals, hW, hL⟩ := storeUnits_NPmix (E := E) [.one] [nw] 0 s1 s2 s1.vs.vRelSt [w0] hs2
        (Nat.le_refl _) hP1 (fun t ht => by rw [e1]; exact hFb t ht) rfl (fun j x hj => by
          match j, hj with
          | 0, hj =>
            simp only [List.getElem?_cons_zero, Option.some.injEq] at hj
            subst hj; rw [ha0]; exact hl0')
      rw [TermTear.mixU_small (by simp) rfl rfl] at hW
      have hst := hval.store hS
      by_cases hs0 : sel 0 = true
      · simp only [hs0, ↓reduceIte] at hW
        obtain ⟨w1, rfl⟩ : ∃ w1, vals = [w1] := by
          match vals, hW with
          | [w1], _ => exact ⟨w1, rfl⟩
          | [], h => exact (h : False).elim
          | _ :: _ :: _, h => exact (h.2 : False).elim
        have hl1 := hL 0 w1 rfl
        rw [ha0] at hl1
        exact ⟨w1, Rv, hto _ _ hl1, VRR_up _ _ _ _ _ hW hst.1, Valid_vals _ _ _ hW.vals hst.2,
          Res.le_def.2 fun k => by simp only [Res.add_apply]; omega⟩
      · simp only [hs0] at hW
        obtain ⟨w1, rfl⟩ : ∃ w1, vals = [w1] := by
          match vals, hW with
          | [w1], _ => exact ⟨w1, rfl⟩
          | [], h => exact (h : False).elim
          | _ :: _ :: _, h => exact (h.2 : False).elim
        have hl1 := hL 0 w1 rfl
        rw [ha0] at hl1
        exact ⟨w1, Rq, hto _ _ hl1, VRR_up _ _ _ _ _ hW hv0, Valid_vals _ _ _ hW.vals hV0,
          Res.le_def.2 fun k => by simp only [Res.add_apply]; omega⟩
    · have hl' : LatestNP s1.mem (PromAt E s1 b) b w := by rw [PromAt_eqp e2, e1]; exact hl
      refine hto _ _ (storeUnits_NPkeep [.one] [nw] 0 s1 s2 hs2 b w (fun j hj => ?_) hl')
      have : j = 0 := by simp [nWords, Acc.size] at hj; omega
      subst this; rw [ha0]; exact hb
  rcases hcase with ⟨m, hmem, hpr⟩ | ⟨tw, pm, htw, hmem, hpr, hpm, hpl, tr, mr, htr, hmr, hmrl, hmrv⟩
  · refine ⟨H', hH', PromCr_keep hC hpr hP (fun t ht => by rw [hmem]; exact push_lt ht) (fun _ _ _ _ => rfl), ?_⟩
    have hpS : ∀ f, pSum s' f = pSum s f := fun f => by unfold pSum; rw [hpr]
    rw [hpS, hpS]
    exact Res.le_def.2 fun k => by have := hle k; simp only [Res.add_apply] at this ⊢; omega
  · have hdb0 : db tw = .zero := by
