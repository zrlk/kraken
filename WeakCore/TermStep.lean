/-- **No newly visible message at `A`**: above any bound `tw` below which every message of `s`
at `A` was skipped (in `PromAt E s A`), every message of `s'` at `A` is skipped too. -/
def NoNewVis (E : TEnv) (s s' : St) (A : Address) : Prop :=
  ∀ tw : Ts, (∀ (t : Ts) (m : Msg), tw < t → s.mem[t]? = some m → m.loc = A → t ∈ PromAt E s A) →
    ∀ (t : Ts) (m : Msg), tw < t → s'.mem[t]? = some m → m.loc = A → t ∈ PromAt E s' A

theorem NoNewVis.trans {E : TEnv} {s1 s2 s3 : St} {A : Address} (h1 : NoNewVis E s1 s2 A)
    (h2 : NoNewVis E s2 s3 A) : NoNewVis E s1 s3 A :=
  fun tw h => h2 tw (h1 tw h)

-- COPY (timestamped) of TermStep.PromAt_atSame (membership step)
theorem memPromAt_atSame {E : TEnv} {s s' : St} {a : Address}
    (hA : AtSame s.mem s.promises s'.mem s'.promises a) {t : Ts} {m : Msg} (hm : s.mem[t]? = some m)
    (hl : m.loc = a) : t ∈ PromAt E s a ↔ t ∈ PromAt E s' a := by
  by_cases hw : VisU E a
  · rw [PromAt_word hw, PromAt_word hw]
  · by_cases hq : PredU E a
    · rw [mem_PromAt_pred hw hq, mem_PromAt_pred hw hq, (AtSame_app (FpAt E a) hA).2 t m hm hl,
        AboveFW_atSame hA.1]
    · rw [PromAt_nword hw hq, PromAt_nword hw hq]; exact (AtSame_app (FpAt E a) hA).2 t m hm hl

theorem noNewVis_atSame {E : TEnv} {s s' : St} {A : Address}
    (hA : AtSame s.mem s.promises s'.mem s'.promises A) : NoNewVis E s s' A := by
  intro tw h t m hlt hm hl
  have hm0 := (hA.1 t m hl).2 hm
  exact (memPromAt_atSame hA hm0 hl).1 (h t m hlt hm0 hl)

/-- A store keeps `AtSame` at every address it does not write. -/
theorem storeUnits_atSame {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s s' : St), s' ∈ storeUnits k arch pw a rel us ws i s →
      ∀ B : Address, (∀ j : Nat, j < nWords us → B ≠ offs a (i + j)) →
        AtSame s.mem s.promises s'.mem s'.promises B
  | [], _, _, s, s', hs => by
      simp only [storeUnits, List.mem_singleton] at hs; subst hs; exact fun _ _ => AtSame_refl
  | .one :: us, w :: ws, i, s, s', hs => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      intro B hB
      have hB0 : B ≠ offs a i := by have := hB 0 (by rw [TermMem.nWords_one]; omega); simpa using this
      exact AtSame_trans (stepStore_AtSame hst hB0) (storeUnits_atSame us ws (i + 1) _ s' hs B (fun j hj => by
        have := hB (j + 1) (by rw [TermMem.nWords_one]; omega)
        rwa [show i + (j + 1) = i + 1 + j by omega] at this))
  | .two :: us, w0 :: w1 :: ws, i, s, s', hs => by
      simp only [storeUnits] at hs
      obtain ⟨q1, _, _, q4, -⟩ := stepStorePair_eq s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel
      generalize Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel = R at q1 q4 hs
      obtain ⟨mem', pairs', th⟩ := R
      simp only at q1 q4 hs
      intro B hB
      have hB0 : B ≠ offs a i := by have := hB 0 (by rw [TermMem.nWords_two]; omega); simpa using this
      have hB1 : B ≠ (offs a i).next := by
        have := hB 1 (by rw [TermMem.nWords_two]; omega)
        intro e; apply this; rw [e]; rfl
      refine AtSame_trans (M' := mem') (P' := th.promises) ?_ (storeUnits_atSame us ws (i + 2) _ s' hs B (fun j hj => by
        have := hB (j + 2) (by rw [TermMem.nWords_two]; omega)
        rwa [show i + (j + 2) = i + 2 + j by omega] at this))
      rw [q1, q4]
      exact AtSame_trans (AtSame_push fun e => hB0 e.symm) (AtSame_push fun e => hB1 e.symm)
  | .one :: _, [], _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [], _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, s', hs => by simp [storeUnits] at hs

/-- Discharging promise `t` (memory unchanged) shrinks the reading `PromAt` by at most `t`. -/
theorem promAt_erase {E : TEnv} {s s1 : St} {A : Address} {t : Ts} (hm : s1.mem = s.mem)
    (hp : s1.promises = s.promises.erase t) :
    (∀ u, u ∈ PromAt E s1 A → u ∈ PromAt E s A) ∧ (∀ u, u ∈ PromAt E s A → u ∉ PromAt E s1 A → u = t) := by
  have k1 : ∀ u, u ∈ s1.promises ++ FpAt E A → u ∈ s.promises ++ FpAt E A := fun u hu => by
    rw [hp] at hu
    rcases List.mem_append.1 hu with h | h
    · exact List.mem_append.2 (Or.inl (List.mem_of_mem_erase h))
    · exact List.mem_append.2 (Or.inr h)
  have k2 : ∀ u, u ∈ s.promises ++ FpAt E A → u ∉ s1.promises ++ FpAt E A → u = t := fun u hu hn =>
    Classical.byContradiction fun hne => hn (by
      rw [hp]
      rcases List.mem_append.1 hu with h | h
      · exact List.mem_append.2 (Or.inl ((List.mem_erase_of_ne hne).2 h))
      · exact List.mem_append.2 (Or.inr h))
  by_cases hw : VisU E A
  · rw [PromAt_word (s := s1) hw, PromAt_word (s := s) hw]
    exact ⟨fun u h => h, fun u h _ => by cases h⟩
  · by_cases hq : PredU E A
    · refine ⟨fun u h => ?_, fun u h hn => ?_⟩
      · rw [mem_PromAt_pred hw hq] at h
        rw [mem_PromAt_pred hw hq]
        rw [hm] at h
        exact ⟨k1 u h.1, h.2⟩
      · rw [mem_PromAt_pred hw hq] at h
        rw [mem_PromAt_pred hw hq] at hn
        rw [hm] at hn
        exact k2 u h.1 (fun h1 => hn ⟨h1, h.2⟩)
    · rw [PromAt_nword (s := s1) hw hq, PromAt_nword (s := s) hw hq]; exact ⟨k1, k2⟩

-- COPY (timestamped) of TermStep.LatestNP_subErase
theorem latestNP_subEraseS {M : Memory} {P P' : List Ts} {A : Address} {x : Word} {t : Ts} {m : Msg}
    (h : LatestNP M P A x) (hmt : M[t]? = some m) (hloc : m.loc = A)
    (hsub : ∀ u, u ∈ P' → u ∈ P) (hd : ∀ u, u ∈ P → u ∉ P' → u = t) :
    (LatestNP M P' A x ∧ ∀ tw : Ts, (∀ (t' : Ts) (m' : Msg), tw < t' → M[t']? = some m' → m'.loc = A → t' ∈ P) →
        ∀ (t' : Ts) (m' : Msg), tw < t' → M[t']? = some m' → m'.loc = A → t' ∈ P') ∨
      LatestNP M P' A (mw m) := by
  obtain ⟨t0, m0, ht0, hm0, hl0, hw0, hlast⟩ := h
  by_cases hc : t0 < t ∧ t ∉ P'
  · refine Or.inr ⟨t, m, hc.2, hmt, hloc, rfl, fun t' m' hlt hm' hl' => ?_⟩
    exact Classical.byContradiction fun hn =>
      Nat.ne_of_gt hlt (hd t' (hlast t' m' (Nat.lt_trans hc.1 hlt) hm' hl') hn)
  · refine Or.inl ⟨⟨t0, m0, fun h => ht0 (hsub _ h), hm0, hl0, hw0, fun t' m' hlt hm' hl' => ?_⟩,
      fun tw htw t' m' hlt hm' hl' => ?_⟩
    · exact Classical.byContradiction fun hn => by
        have e := hd t' (hlast t' m' hlt hm' hl') hn
        subst e; exact hc ⟨hlt, hn⟩
    · have h0 : t0 ≤ tw := Nat.le_of_not_lt fun hl => ht0 (htw t0 m0 hl hm0 hl0)
      exact Classical.byContradiction fun hn => by
        have e := hd t' (htw t' m' hlt hm' hl') hn
        subst e; exact hc ⟨Nat.lt_of_le_of_lt h0 hlt, hn⟩

