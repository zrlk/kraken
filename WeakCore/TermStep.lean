/-! ### (P4 step 4) Pair protocols: holding by clause -/

/-- Two pair families sharing a value overlap (`overlap2` is exact). -/
theorem overlap2_of_common {a b : Clause2} {n0 n1 ka0 ka1 kb0 kb1 : Nat}
    (ha0 : n0 = a.s0 * ka0 + a.o0) (ha1 : n1 = a.s1 * ka1 + a.o1) (har : Rel2Holds a.rel ka0 ka1)
    (hb0 : n0 = b.s0 * kb0 + b.o0) (hb1 : n1 = b.s1 * kb1 + b.o1) (hbr : Rel2Holds b.rel kb0 kb1) :
    overlap2 a b = true := by
  have c0 : overlap ⟨a.s0, a.o0, true⟩ ⟨b.s0, b.o0, true⟩ = true :=
    overlap_of_common (n := n0) (by rw [ha0]; exact inCl_of ⟨a.s0, a.o0, true⟩ ka0)
      (by rw [hb0]; exact inCl_of ⟨b.s0, b.o0, true⟩ kb0)
  have c1 : overlap ⟨a.s1, a.o1, true⟩ ⟨b.s1, b.o1, true⟩ = true :=
    overlap_of_common (n := n1) (by rw [ha1]; exact inCl_of ⟨a.s1, a.o1, true⟩ ka1)
      (by rw [hb1]; exact inCl_of ⟨b.s1, b.o1, true⟩ kb1)
  unfold overlap2
  rw [c0, c1, Bool.true_and, Bool.true_and]
  by_cases z0 : a.s0 = 0
  · simp [z0]
  by_cases z1 : a.s1 = 0
  · simp [z1]
  by_cases e0' : a.s0 ≠ b.s0
  · simp [e0']
  have e0 : a.s0 = b.s0 := Decidable.not_not.1 e0'
  by_cases e1' : a.s1 ≠ b.s1
  · simp [e1']
  have e1 : a.s1 = b.s1 := Decidable.not_not.1 e1'
  have d0 : ((a.o0 : Int) - b.o0) / a.s0 = (kb0 : Int) - ka0 := by
    have : ((a.o0 : Int) - b.o0) = (a.s0 : Int) * ((kb0 : Int) - ka0) := by
      rw [e0] at ha0 ⊢
      have := congrArg (fun x : Nat => (x : Int)) (ha0.symm.trans hb0)
      simp only [Int.natCast_add, Int.natCast_mul] at this
      rw [Int.mul_sub]; omega
    rw [this, Int.mul_ediv_cancel_left _ (by exact_mod_cast z0)]
  have d1 : ((a.o1 : Int) - b.o1) / a.s1 = (kb1 : Int) - ka1 := by
    have : ((a.o1 : Int) - b.o1) = (a.s1 : Int) * ((kb1 : Int) - ka1) := by
      rw [e1] at ha1 ⊢
      have := congrArg (fun x : Nat => (x : Int)) (ha1.symm.trans hb1)
      simp only [Int.natCast_add, Int.natCast_mul] at this
      rw [Int.mul_sub]; omega
    rw [this, Int.mul_ediv_cancel_left _ (by exact_mod_cast z1)]
  rw [d0, d1]
  simp only [Bool.or_eq_true]
  right
  cases ha : a.rel <;> cases hb : b.rel <;> rw [ha] at har <;> rw [hb] at hbr <;>
    simp only [Rel2Holds] at har hbr <;>
    simp only [rel2Compat, rel2Shift, beq_iff_eq, decide_eq_true_eq] <;> omega

/-- The pair states of a well-formed pair protocol are disjoint. -/
theorem pwf2_disjoint {P : Proto2} (hp : pwf2 P = true) {c j : Nat} {a b : Clause2}
    {n0 n1 ka0 ka1 kb0 kb1 : Nat} (hc : P.clauses[c]? = some a) (hj : P.clauses[j]? = some b)
    (ha0 : n0 = a.s0 * ka0 + a.o0) (ha1 : n1 = a.s1 * ka1 + a.o1) (har : Rel2Holds a.rel ka0 ka1)
    (hb0 : n0 = b.s0 * kb0 + b.o0) (hb1 : n1 = b.s1 * kb1 + b.o1) (hbr : Rel2Holds b.rel kb0 kb1) :
    c = j := by
  have hA : (enumFrom P.clauses 0).all (fun (i, a) =>
      (enumFrom P.clauses 0).all fun (j, b) => j ≤ i || !overlap2 a b) = true := by
    revert hp; unfold pwf2; simp only [Bool.and_eq_true]; intro hp
    exact hp.1.1.1
  have m1 := mem_enumFrom P.clauses 0 c a hc
  have m2 := mem_enumFrom P.clauses 0 j b hj
  simp only [Nat.add_zero] at m1 m2
  rcases Nat.lt_trichotomy c j with hlt | heq | hgt
  · have h := List.all_eq_true.1 (List.all_eq_true.1 hA _ m1) _ m2
    simp only [overlap2_of_common ha0 ha1 har hb0 hb1 hbr, Bool.not_true, Bool.or_false,
      decide_eq_true_eq] at h
    omega
  · exact heq
  · have h := List.all_eq_true.1 (List.all_eq_true.1 hA _ m2) _ m1
    simp only [overlap2_of_common hb0 hb1 hbr ha0 ha1 har, Bool.not_true, Bool.or_false,
      decide_eq_true_eq] at h
    omega

theorem holds2_of_st {ρ : Nat → Nat} {cx : Cx} {P : Proto2} {i0 i1 k0 k1 : Idx} {c : Nat} {cl : Clause2}
    (hsat : Sat cx.facts ρ) (hst : InState2 cx P i0 i1 c k0 k1)
    (hcl : P.clauses[c]? = some cl) (hh : cl.holds = true) :
    Word2Holds P [.num (ev ρ i0), .num (ev ρ i1)] := by
  obtain ⟨cl0, h0, hent⟩ := hst
  rw [hcl] at h0; cases h0
  obtain ⟨e0, e1, e2⟩ := hent ρ hsat
  exact ⟨_, _, c, cl, _, _, rfl, hcl, hh, e0, e1, e2⟩

theorem nholds2_of_st {ρ : Nat → Nat} {cx : Cx} {P : Proto2} {i0 i1 k0 k1 : Idx} {c : Nat} {cl : Clause2}
    (hp : pwf2 P = true) (hsat : Sat cx.facts ρ) (hst : InState2 cx P i0 i1 c k0 k1)
    (hcl : P.clauses[c]? = some cl) (hh : cl.holds = false) :
    ¬ Word2Holds P [.num (ev ρ i0), .num (ev ρ i1)] := by
  obtain ⟨cl0, h0, hent⟩ := hst
  rw [hcl] at h0; cases h0
  obtain ⟨e0, e1, e2⟩ := hent ρ hsat
  rintro ⟨n0, n1, c2, cl2, k0', k1', hv, hc2, hh2, f0, f1, f2⟩
  simp only [List.cons.injEq, WeakMem.Val.num.injEq, and_true] at hv
  obtain ⟨rfl, rfl⟩ := hv
  have e := pwf2_disjoint hp hcl hc2 e0 e1 e2 f0 f1 f2
  subst e
  rw [hcl] at hc2; cases hc2
  rw [hh] at hh2; cases hh2

theorem InP2_of_st {ρ : Nat → Nat} {cx : Cx} {P : Proto2} {i0 i1 k0 k1 : Idx} {c : Nat}
    (hsat : Sat cx.facts ρ) (hst : InState2 cx P i0 i1 c k0 k1) : InP2 P (ev ρ i0) (ev ρ i1) := by
  obtain ⟨cl, hcl, hent⟩ := hst
  obtain ⟨e0, e1, e2⟩ := hent ρ hsat
  exact ⟨c, cl, _, _, hcl, e0, e1, e2⟩

open Classical in
/-- (P4) What a protocol pair of region `n` with values `vs` holds. -/
noncomputable def wr2 (P : Proto2) (n : Nat) (vs : List WeakMem.Val) : Res :=
  if Word2Holds P vs then Res.one (.rg n) else .zero

theorem VRR_word2_wr {ρ₀ : Nat → Nat} {η : TEnv} {n : Nat} {P : Proto2} {S : Shp} {ws : List Word} {R : Res}
    (h : VRR ρ₀ η (.word2 (.lit n) P) S ws R) : R = wr2 P n (ws.map (·.val)) + Res.one (.wd n) := by
  simp only [VRR] at h
  rcases h.2 with ⟨hh, rfl⟩ | ⟨hh, rfl⟩
  · simp [wr2, hh, ev]
  · simp [wr2, hh, ev]

theorem VRR_word2_of {ρ₀ : Nat → Nat} {η : TEnv} {n : Nat} {P : Proto2} {S : Shp} {ws : List Word}
    {n0 n1 : Nat} (hp : pwf2 P = true) (hv : ws.map (·.val) = [.num n0, .num n1]) (hin : InP2 P n0 n1) :
    VRR ρ₀ η (.word2 (.lit n) P) S ws (wr2 P n (ws.map (·.val)) + Res.one (.wd n)) := by
  simp only [VRR]
  refine ⟨⟨hp, n0, n1, hv, hin⟩, ?_⟩
  by_cases hh : Word2Holds P (ws.map (·.val))
  · exact Or.inl ⟨hh, by simp [wr2, hh, ev]⟩
  · exact Or.inr ⟨hh, by simp [wr2, hh, ev]⟩

theorem wr2_holds {P : Proto2} {n : Nat} {vs : List WeakMem.Val} (h : Word2Holds P vs) :
    wr2 P n vs = .one (.rg n) := by simp [wr2, h]

theorem wr2_nholds {P : Proto2} {n : Nat} {vs : List WeakMem.Val} (h : ¬ Word2Holds P vs) :
    wr2 P n vs = .zero := by simp [wr2, h]

/-! ### (P4 step 4) `stp`: memory's side -/

theorem Fd_word2_eq {T : Ty} {n : Nat} {P : Proto2} (h : Fd T (.word2 (.lit n) P)) : T = .word2 (.lit n) P := by
  generalize hU : Ty.word2 (.lit n) P = U at h
  cases h with
  | refl => rfl
  | fold => simp [cl] at hU

theorem Fd_epair_eq {T : Ty} {n : Nat} {P : ECounter} (h : Fd T (.epair (.lit n) P)) : T = .epair (.lit n) P := by
  generalize hU : Ty.epair (.lit n) P = U at h
  cases h with
  | refl => rfl
  | fold => simp [cl] at hU

theorem ValOfR_word2_vals {E : TEnv} {n : Nat} {P : Proto2} {ws ws' : List Word} {R : Res}
    (h : ValOfR E (.word2 (.lit n) P) ws R) (hv : ws'.map (·.val) = ws.map (·.val)) :
    ValOfR E (.word2 (.lit n) P) ws' R := by
  refine ⟨?_, by simp [Valid]⟩
  have := h.1; simp only [VRR] at this ⊢; rw [hv]; exact this


theorem storeUnits_two {k : Promises.Knobs} {arch : Arch} {pw w0 w1 : Word} {A : Address} {rel : Bool} {s s' : St}
    (hs : s' ∈ storeUnits k arch pw A rel [.two] [w0, w1] 0 s) :
    ∃ mv, s'.mem = (s.mem.push ⟨A, w0.val, mv⟩).push ⟨A.next, w1.val, mv⟩ ∧ s'.promises = s.promises := by
  simp only [storeUnits, List.mem_singleton] at hs
  subst hs
  refine ⟨max (Promises.storeMview (mth s pw w0 w1) (dataE 1 w0) [0] rel)
    (Promises.storeMview (mth s pw w0 w1) (dataE 2 w1) [0] rel), ?_, rfl⟩
  show (Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs A 0) (dataE 1 w0) (dataE 2 w1) [0] rel).1 = _
  simp only [Promises.stepStorePair, offs_zero]
  congr 3
  · cases h : w0.val <;> simp [dataE, h, mth, regsOf]
  · cases h : w1.val <;> simp [dataE, h, mth, regsOf]

/-- (P4) A protocol pair in memory has a well-formed protocol (memory's
holding records the cell's value, whose pair component says so). -/
theorem pwf2_of_held {η : TEnv} {s : St} {H : Res} {A : Address} {c : Cell} {n : Nat} {P : Proto2}
    (hH : MemHeld (CE η) s H) (hsto : η.sto A.label = some c) (hat : AtOff c.ty A.offset (.word2 (.lit n) P))
    (hini : IniAt η.ini c A (.word2 (.lit n) P)) : pwf2 P = true := by
  obtain ⟨R0, H0, -, hent0, -⟩ := MemHeld_focus hH A.label
  obtain ⟨vals0, -, hC0⟩ := hent0.2 c hsto
  have hna : ∀ N e, Ty.word2 (.lit n) P ≠ .array (.lit N) e := fun N e h => by cases h
  obtain ⟨b, oS, S, wS, Rsg, Rrc, -, -, hatS, hwS, hbw, -, ⟨hvs, -⟩, -⟩ := (own_segR hC0 hat hini hna).resolve_right (fun ⟨_, _, _, _, _, _, _, hz⟩ => by have h := hz _ (by simp [accs] : accs (Ty.word2 (.lit n) P) = some [.two]); simp [nWords, Acc.size] at h)
  have hsl : ((vals0.drop b).take wS).length = wS := by
    simp only [List.length_take, List.length_drop]; omega
  obtain ⟨n1, Rq, Rr2, -, -, -, hvq, -⟩ := VRR_at (CE η).unsee hatS hvs (by rw [hsl]; exact hwS)
  simp only [VRR] at hvq
  exact hvq.1.1

theorem wc_word2 {r : Idx} {P : Proto2} : wc (.word2 r P) = some 2 := by
  simp [wc, accs, nWords, Acc.size]

theorem WordUnit_pair0 {E : TEnv} {A : Address} {c : Cell} {n : Nat} {P : Proto2}
    (hsto : E.sto A.label = some c) (hat : AtOff c.ty A.offset (.word2 (.lit n) P)) : WordUnit E A :=
  ⟨c, hsto, Or.inr (Or.inl ⟨_, P, hat⟩)⟩

theorem WordUnit_pair1 {E : TEnv} {A : Address} {c : Cell} {n : Nat} {P : Proto2}
    (hsto : E.sto A.label = some c) (hat : AtOff c.ty A.offset (.word2 (.lit n) P)) : WordUnit E A.next :=
  ⟨c, hsto, Or.inr (Or.inr ⟨_, P, by simp [WeakMem.Address.next], by simpa [WeakMem.Address.next] using hat⟩)⟩

/-- **(P4) A pair store, memory's side** (own or published cell; `stepStorePair`
is append-only): both new words are the latest at the pair's two word units,
so the cell's entry trades the pair's old resources (dropped) for the stored
pair's `Rv`; promises and credits are untouched. -/
theorem pairStoreHeld {g : G} {η : TEnv} {s s' : St} {H : Res} {cr db : Ts → Res}
    {A : Address} {c : Cell} {n : Nat} {P : Proto2} {w0 w1 : Word} {Rv : Res}
    {k : Promises.Knobs} {arch : Arch} {pw : Word} {rel : Bool}
    (hm : MemInv g (CE η) s) (hH : MemHeld (CE η) s H) (hC : PromCr (CE η) s cr db) (hfo : FpOK (CE η) s)
    (hsto : η.sto A.label = some c) (hat : AtOff c.ty A.offset (.word2 (.lit n) P))
    (hini : IniAt η.ini c A (.word2 (.lit n) P))
    (hv : ValOfR (CE η) (.word2 (.lit n) P) [w0, w1] (Rv + Res.one (.wd n)))
    (hs : s' ∈ storeUnits k arch pw A rel [.two] [w0, w1] 0 s) :
    ∃ H', MemHeld (CE η) s' H' ∧ PromCr (CE η) s' cr db ∧
      H' + pSum s' cr + pSum s db ≤ Rv + H + pSum s cr + pSum s' db := by
  obtain ⟨mv, hmem, hpr⟩ := storeUnits_two hs
  have hPb : ∀ t, t ∈ s.promises → t < s.mem.size := fun t ht => hm.2.2.1 t ht
  have hne : A.next ≠ A := WeakMem.Address.next_ne A
  have hPs : ∀ B t, t ∈ PromAt (CE η) s' B → t < s.mem.size := fun B t ht =>
    (PromAt_sub ht).elim (fun h => hPb t (by rw [← hpr]; exact h)) (fun h => hfo.1 t h)
  have hl1 : LatestNP s'.mem (PromAt (CE η) s' A) A (mw ⟨A, w0.val, mv⟩) := by
    rw [hmem]
    exact LatestNP_push_other (LatestNP_push_top (M := s.mem) ⟨A, w0.val, mv⟩ (hPs A))
      (by exact hne)
  have hl1' : LatestNP s'.mem (PromAt (CE η) s' A.next) A.next (mw ⟨A.next, w1.val, mv⟩) := by
    rw [hmem]
    exact LatestNP_push_top _ (fun t ht => by rw [Array.size_push]; exact Nat.lt_succ_of_lt (hPs _ t ht))
  have hkeep : ∀ b w, b ≠ A → b ≠ A.next → LatestNP s.mem (PromAt (CE η) s b) b w →
      LatestNP s'.mem (PromAt (CE η) s' b) b w := by
    intro b w h0 h1 hl
    refine PromAt_atSame ?_ hl
    rw [hmem, hpr]
    exact AtSame_trans (AtSame_push (fun e => h0 e.symm)) (AtSame_push (fun e => h1 e.symm))
  have hv' := ValOfR_word2_vals (ws' := [mw ⟨A, w0.val, mv⟩, mw ⟨A.next, w1.val, mv⟩]) hv (by simp [mw])
  obtain ⟨H', x0', x1', R0, hH', -, -, hR0v, hEq⟩ := heldPair hH hsto hat hini wc_word2 (fun N e h => by cases h)
    hl1 hl1' hv' hkeep
  have hpS : ∀ f, pSum s' f = pSum s f := fun f => by unfold pSum; rw [hpr]
  refine ⟨H', hH', PromCr_keep hC hpr hPb (fun t ht => by
    rw [hmem, push_lt (by rw [Array.size_push]; omega), push_lt ht]) (fun _ _ _ _ => rfl), ?_⟩
  rw [hpS, hpS]
  exact Res.le_def.2 fun k => by
    have := congrArg (fun R : Res => R k) hEq
    have h0 := wd_le_VRR_word2 hR0v k
    simp only [Res.add_apply] at this h0 ⊢; omega

/-- `pairStoreHeld` with slot lists. -/
theorem pairStoreHeldL {g : G} {η : TEnv} {s s' : St} {H : Res} {Sl : AllocLabel → List Res} {cr db : Ts → Res}
    {A : Address} {c : Cell} {n : Nat} {P : Proto2} {w0 w1 : Word} {Rv : Res}
    {k : Promises.Knobs} {arch : Arch} {pw : Word} {rel : Bool}
    (hm : MemInv g (CE η) s) (hH : MemHeldL (CE η) s H Sl) (hC : PromCr (CE η) s cr db) (hfo : FpOK (CE η) s)
    (hsto : η.sto A.label = some c) (hat : AtOff c.ty A.offset (.word2 (.lit n) P))
    (hini : IniAt η.ini c A (.word2 (.lit n) P))
    (hv : ValOfR (CE η) (.word2 (.lit n) P) [w0, w1] (Rv + Res.one (.wd n)))
    (hs : s' ∈ storeUnits k arch pw A rel [.two] [w0, w1] 0 s) :
    ∃ H', MemHeldK (CE η) s Sl (CE η) s' H' ∧ PromCr (CE η) s' cr db ∧
      H' + pSum s' cr + pSum s db ≤ Rv + H + pSum s cr + pSum s' db := by
  have htA : ∀ lo hi, lo ≤ A.offset → A.offset < hi → TouchS s s' A.label lo hi := fun lo hi h1 h2 =>
    TouchS_store (s0 := s) hs (by simp [nWords, Acc.size]) rfl (fun _ => Nat.le_refl _) h1 h2
  obtain ⟨mv, hmem, hpr⟩ := storeUnits_two hs
  have hPb : ∀ t, t ∈ s.promises → t < s.mem.size := fun t ht => hm.2.2.1 t ht
  have hne : A.next ≠ A := WeakMem.Address.next_ne A
  have hPs : ∀ B t, t ∈ PromAt (CE η) s' B → t < s.mem.size := fun B t ht =>
    (PromAt_sub ht).elim (fun h => hPb t (by rw [← hpr]; exact h)) (fun h => hfo.1 t h)
  have hl1 : LatestNP s'.mem (PromAt (CE η) s' A) A (mw ⟨A, w0.val, mv⟩) := by
    rw [hmem]
    exact LatestNP_push_other (LatestNP_push_top (M := s.mem) ⟨A, w0.val, mv⟩ (hPs A))
      (by exact hne)
  have hl1' : LatestNP s'.mem (PromAt (CE η) s' A.next) A.next (mw ⟨A.next, w1.val, mv⟩) := by
    rw [hmem]
    exact LatestNP_push_top _ (fun t ht => by rw [Array.size_push]; exact Nat.lt_succ_of_lt (hPs _ t ht))
  have hkeep : ∀ b w, b ≠ A → b ≠ A.next → LatestNP s.mem (PromAt (CE η) s b) b w →
      LatestNP s'.mem (PromAt (CE η) s' b) b w := by
    intro b w h0 h1 hl
    refine PromAt_atSame ?_ hl
    rw [hmem, hpr]
    exact AtSame_trans (AtSame_push (fun e => h0 e.symm)) (AtSame_push (fun e => h1 e.symm))
  have hv' := ValOfR_word2_vals (ws' := [mw ⟨A, w0.val, mv⟩, mw ⟨A.next, w1.val, mv⟩]) hv (by simp [mw])
  obtain ⟨H', x0', x1', R0, hH', -, -, hR0v, hEq⟩ := heldPairL hH hsto hat hini wc_word2 (fun N e h => by cases h)
    hl1 hl1' hv' hkeep htA
  have hpS : ∀ f, pSum s' f = pSum s f := fun f => by unfold pSum; rw [hpr]
  refine ⟨H', hH', PromCr_keep hC hpr hPb (fun t ht => by
    rw [hmem, push_lt (by rw [Array.size_push]; omega), push_lt ht]) (fun _ _ _ _ => rfl), ?_⟩
  rw [hpS, hpS]
  exact Res.le_def.2 fun k => by
    have := congrArg (fun R : Res => R k) hEq
    have h0 := wd_le_VRR_word2 hR0v k
    simp only [Res.add_apply] at this h0 ⊢; omega
#print axioms pairStoreHeldL

/-- **(P4) A pair store's frame side**: the pair token comes out of the frame
(`rg n`); the stored pair holds `Rv` — `rg n` after a Give (holding state),
nothing after a Keep, which binds the token back. -/
theorem stp_frame {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {K : TEnv → Nat → List Word → Res → Prop}
    {cx c₁ c' : Cx} {env : Env} {x : String} {v0 v1 tk : At} {r r' i0 i1 j0 j1 k0' k1' : Idx} {P : Proto2}
    {c₂ : Nat} {xt : Ty} {Rf : Res} {cl' : Clause2}
    (hi : FInvR ρ η σs K cx env Rf) (hcr : CohR η) (hL : RLink η) (hpwf : pwf2 P = true)
    (hu : cx.use tk = .ok (.tok2 r' P i0 i1, c₁)) (hr : EqI c₁ r r') (hj0 : IntIdx c₁ v0 j0)
    (hj1 : IntIdx c₁ v1 j1) (hst : InState2 c₁ P j0 j1 c₂ k0' k1') (hcl : P.clauses[c₂]? = some cl')
    (hb : c₁.bind x xt = .ok c')
    (hxt : (xt = .unit ∧ cl'.holds = true) ∨ (xt = .tok2 r' P j0 j1 ∧ cl'.holds = false)) :
    ∃ rt0 rt1 w0 w1 Tf Rv, evalAt env v0 = some (rt0, [w0]) ∧ w0.val = .num (ev ρ j0) ∧
      evalAt env v1 = some (rt1, [w1]) ∧ w1.val = .num (ev ρ j1) ∧
      FInvR ρ η σs K c' ((x, .unit, []) :: env) Tf ∧ Tf + Rv ≤ Rf ∧
      ∀ (E : TEnv) (sh : Shp), VRR (fun _ => 0) E (.word2 (.lit (ev ρ r)) P) sh [w0, w1]
        (Rv + Res.one (.wd (ev ρ r))) := by
  obtain ⟨rtt, wst, Rt, Rr, -, -, -, hvt, hi1, hle⟩ := useR hu hi hcr
  simp only [VRR] at hvt
  have hsat : Sat c₁.facts ρ := hi1.1.1
  have hrr : ev ρ r = ev ρ r' := hr ρ hsat
  obtain ⟨tv0, htvk0, hio0⟩ := hj0
  obtain ⟨rt0, w0, hev0, hwv0, -⟩ := atom_num hi1.1.2.1 htvk0 hio0
  obtain ⟨tv1, htvk1, hio1⟩ := hj1
  obtain ⟨rt1, w1, hev1, hwv1, -⟩ := atom_num hi1.1.2.1 htvk1 hio1
  have hvals : [w0, w1].map (·.val) = [.num (ev ρ j0), .num (ev ρ j1)] := by simp [hwv0, hwv1]
  have hvw : ∀ (E : TEnv) (sh : Shp), VRR (fun _ => 0) E (.word2 (.lit (ev ρ r)) P) sh [w0, w1]
      (wr2 P (ev ρ r) [.num (ev ρ j0), .num (ev ρ j1)] + Res.one (.wd (ev ρ r))) := by
    intro E sh
    have := VRR_word2_of (ρ₀ := fun _ => 0) (η := E) (n := ev ρ r) (S := sh) hpwf hvals (InP2_of_st hsat hst)
    rwa [hvals] at this
  rcases hxt with ⟨rfl, hh⟩ | ⟨rfl, hh⟩
  · have hfr := bindR hb hi1 hL (show VRR ρ η .unit (shp .unit) [] .zero from rfl) (unit_Lay _)
    rw [Res.add_zero] at hfr
    refine ⟨rt0, rt1, w0, w1, Rr, Rt, hev0, hwv0, hev1, hwv1, hfr, ?_, fun E sh => ?_⟩
    · rw [Res.add_comm]; exact hle
    · have := hvw E sh
      have e : wr2 P (ev ρ r) [.num (ev ρ j0), .num (ev ρ j1)] = Rt := by
        rw [wr2_holds (holds2_of_st hsat hst hcl hh), hvt, hrr]
      rwa [e] at this
  · have hfr := bindR hb hi1 hL (show VRR ρ η (.tok2 r' P j0 j1) (shp .unit) [] Rt from hvt) (Lay_etok_unit rfl)
    refine ⟨rt0, rt1, w0, w1, Rr + Rt, .zero, hev0, hwv0, hev1, hwv1, hfr, ?_, fun E sh => ?_⟩
    · rw [Res.add_zero, Res.add_comm]; exact hle
    · have := hvw E sh
      rwa [wr2_nholds (nholds2_of_st hpwf hsat hst hcl hh)] at this

/-- (P4) The common end of the pair stores (`storeWordC_fin` for pairs). -/
theorem stpC_fin {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {c' : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {e : Expr}
    {pw w0 w1 : Word} {A : Address} {c : Cell} {n : Nat} {P : Proto2} {Rf Rs H Tf Rv : Res} {cr db : Ts → Res}
    (hkey : tstep g mem pairs th = (storeUnits g.k g.arch pw A rel [.two] [w0, w1] 0 (stOf mem pairs th)).map
        fun s' => (s'.mem, s'.pairs, withS { th with term := e, env := (x, .unit, []) :: th.env } s'))
    (hmi : ∀ s', s' ∈ storeUnits g.k g.arch pw A rel [.two] [w0, w1] 0 (stOf mem pairs th) → MemInv g (CE η) s')
    (hsto : η.sto A.label = some c) (hat : AtOff c.ty A.offset (.word2 (.lit n) P))
    (hini : IniAt η.ini c A (.word2 (.lit n) P))
    (hv : ValOfR (CE η) (.word2 (.lit n) P) [w0, w1] (Rv + Res.one (.wd n)))
    (hfr : FInvR ρ η th.σs (ResumeR p th.stack Rs) c' ((x, .unit, []) :: th.env) Tf) (hle : Tf + Rv ≤ Rf)
    (hE : EnvOK p η) (he : TypedK p η c' e) (htv' : TvOK c')
    (hm : MemInv g (CE η) (stOf mem pairs th)) (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack c'.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  rw [hkey]
  obtain ⟨s0, hs0⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := pw) (a := A) (rel := rel)
    [.two] [w0, w1] 0 (stOf mem pairs th) rfl
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hs0), fun r hr => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨s', hs', rfl⟩ := hr
  obtain ⟨H', hH', hC', hb⟩ := pairStoreHeldL hm hH hC hfo hsto hat hini hv hs'
  refine ⟨Tf + Rs, H', .zero, .zero, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Tf, Rs, rfl, hE, he, htv', hfr, rfl, hRP⟩, hmi s' hs', hH', hC'⟩,
    .none, ?_⟩
  show Tf + Rs + H' + pSum s' cr + pSum (stOf mem pairs th) db + Res.zero ≤
    Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum s' db + Res.zero
  rw [Res.add_zero, Res.add_zero]
  refine Res.le_def.2 fun k => ?_
  have h1 := (Res.le_def.1 hle) k
  have h2 := (Res.le_def.1 hb) k
  simp only [Res.add_apply] at h1 h2 ⊢
  omega

/-- **(P4 step 4) A protocol pair's `stp` through an own or `pub` pointer, with
resources and credits** (`stpOwn_core`/`stpPub_core`): the cell is the pair
(`Fd_word2_eq`); `stp_frame`, then `stpC_fin`. -/
theorem stpC_core {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx c₁ c' : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v0 v1 tk : At}
    {μ : Mode} {r r' i0 i1 j0 j1 k0' k1' : Idx} {P : Proto2} {c₂ : Nat} {e : Expr} {xt : Ty} {cl' : Clause2}
    {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.stp rel a v0 v1 tk) e)
    (hpk : cx.peek a = .ok (.ptr μ (.word2 r P))) (hμ : μ = .own ∨ μ = .pub)
    (hu : cx.use tk = .ok (.tok2 r' P i0 i1, c₁)) (hr : EqI c₁ r r') (hj0 : IntIdx c₁ v0 j0)
    (hj1 : IntIdx c₁ v1 j1) (hst : InState2 c₁ P j0 j1 c₂ k0' k1') (hcl : P.clauses[c₂]? = some cl')
    (hxt : (xt = .unit ∧ cl'.holds = true) ∨ (xt = .tok2 r' P j0 j1 ∧ cl'.holds = false))
    (hb : c₁.bind x xt = .ok c') (he : TypedK p η c' e) (htv' : TvOK c')
    (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRPc : RetPw th.σs th.stack c'.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  obtain ⟨hi1, -⟩ := use_FInv hu hi.1
  have ho : cx.opaqueOK (.word2 r P) = true := by simp [Cx.opaqueOK, Ty.guardT]
  have hcellW : ∀ {c : Cell}, Fd c.ty (cl ρ η.wit 0 0 (.word2 r P)) →
      c.ty = .word2 (.lit (ev ρ r)) P := fun hcty => by
    have h' := hcty; simp only [cl, clI_zero] at h'; exact Fd_word2_eq h'
  rcases hμ with rfl | rfl
  · obtain ⟨lab, c, pw, ru, hea, hpw, hsto, hcty, -, hown, hsku, -⟩ := ownPtr_view hi.1 hpk htv ho
    have hct := hcellW hcty
    have hat : AtOff c.ty (⟨lab, 0⟩ : Address).offset (.word2 (.lit (ev ρ r)) P) := by
      rw [hct]; exact .here (Or.inl (by simp [accs]))
    have hini : IniAt η.ini c ⟨lab, 0⟩ (.word2 (.lit (ev ρ r)) P) :=
      IniAt_of_ne fun N e h => by rw [hct] at h; cases h
    have hpwf := pwf2_of_held hH.memHeld hsto hat hini
    obtain ⟨rt0, rt1, w0, w1, Tf, Rv, hev0, hwv0, hev1, hwv1, hfr, hle, hvR⟩ :=
      stp_frame hi hE.2.2 (RLink_of hE.2.1 hE.2.2) hpwf hu hr hj0 hj1 hst hcl hb hxt
    obtain ⟨r'', rfl⟩ := eskel_word2 (show etok (skel ru) = .word2 (.lit 0) P by rw [hsku]; rfl)
    have hval := (Fd_EnvVal (CE η) hcty).2 (storeWord2_val (r := r) hpwf hi1.1 hst hwv0 hwv1)
    have husA : accs c.ty = some [Acc.two] := by rw [hct]; simp [accs]
    have hus' : wc c.ty = some (nWords [Acc.two]) := by rw [hct]; simp [wc, accs]
    have key : tstep g mem pairs th =
        (storeUnits g.k g.arch pw ⟨lab, 0⟩ rel [.two] [w0, w1] 0 (stOf mem pairs th)).map fun s' =>
          (s'.mem, s'.pairs, withS { th with term := e, env := (x, .unit, []) :: th.env } s') := by
      simp only [tstep, hterm, evalOp, hea, hev0, hev1, word2Of, addrOf, hpw, List.map_map]; rfl
    exact stpC_fin (A := ⟨lab, 0⟩) key (fun s' hs' => MemInv_store hm hsto hown husA hval rfl s' hs')
      hsto hat hini ⟨hvR _ _, by simp [Valid]⟩ hfr hle hE he htv' hm hH hC hfo hRPc
  · obtain ⟨lab, c, pw, ru, f, hea, hpw, hsto, hcty, hf, -, -, hsku, -⟩ := pubPtr_view hi.1 hpk htv ho
    have hct := hcellW hcty
    have hat : AtOff c.ty (⟨lab, 0⟩ : Address).offset (.word2 (.lit (ev ρ r)) P) := by
      rw [hct]; exact .here (Or.inl (by simp [accs]))
    have hini : IniAt η.ini c ⟨lab, 0⟩ (.word2 (.lit (ev ρ r)) P) :=
      IniAt_of_ne fun N e h => by rw [hct] at h; cases h
    have hpwf := pwf2_of_held hH.memHeld hsto hat hini
    obtain ⟨rt0, rt1, w0, w1, Tf, Rv, hev0, hwv0, hev1, hwv1, hfr, hle, hvR⟩ :=
      stp_frame hi hE.2.2 (RLink_of hE.2.1 hE.2.2) hpwf hu hr hj0 hj1 hst hcl hb hxt
    obtain ⟨r'', rfl⟩ := eskel_word2 (show etok (skel ru) = .word2 (.lit 0) P by rw [hsku]; rfl)
    have husc : accs c.ty = some [.two] := by rw [hct]; simp [accs]
    have hval := (Fd_EnvVal (CE η) hcty).2 (storeWord2_val (r := r) hpwf hi1.1 hst hwv0 hwv1)
    have key : tstep g mem pairs th =
        (storeUnits g.k g.arch pw ⟨lab, 0⟩ rel [.two] [w0, w1] 0 (stOf mem pairs th)).map fun s' =>
          (s'.mem, s'.pairs, withS { th with term := e, env := (x, .unit, []) :: th.env } s') := by
      simp only [tstep, hterm, evalOp, hea, hev0, hev1, word2Of, addrOf, hpw, List.map_map]; rfl
    refine stpC_fin (A := ⟨lab, 0⟩) key (fun s' hs' => ?_) hsto hat hini ⟨hvR _ _, by simp [Valid]⟩
      hfr hle hE he htv' hm hH hC hfo hRPc
    by_cases hown : c.owner = some η.tid
    · exact MemInv_storeF hm hsto hown husc hval rfl s' hs'
    · have hna : ∀ N e, c.ty ≠ .array (.lit N) e := fun N e he => by rw [he] at husc; simp [accs] at husc
      exact MemInv_storePubAt (a := ⟨lab, 0⟩) hm hsto hown hf (.here (Or.inl (by rw [husc]; simp)))
        (IniAt_of_ne fun N e he => hna N e he) hna hval husc rfl s' hs'

/-- **(P4 step 4) `stp`** (own or `pub` pointer, Give and Keep), **with resources
and promise credits** (`tstepM_stp`): Give moves the pair token `rg n` from
the frame into the stored (holding) pair; Keep re-binds it and stores a
non-holding pair.  `stepStorePair` is append-only: both words become the
latest at the pair's units and the old pair's resources are dropped
(`pairStoreHeld`); the credits are untouched.  Nothing is minted. -/
theorem tstepMC_stp {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v0 v1 tk : At}
    {μ : Mode} {r : Idx} {P : Proto2} {e : Expr} {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.stp rel a v0 v1 tk) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.ptr μ (.word2 r P))) (hμ : μ = .own ∨ μ = .pub)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  have hT0 := hT
  have hCk0 := hCk
  rw [hterm] at hT0 hCk0
  cases hT0 with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk0
  have htv' := OpT_TvOK hP hop htv
  cases hop with
  | stpGive hp hw hu hr hj0 hj1 _ _ hst hcl _ _ hh _ hb =>
    rw [hpk] at hp; cases hp
    simp only [word2Of, Option.some.injEq, Prod.mk.injEq] at hw; obtain ⟨rfl, rfl⟩ := hw
    exact stpC_core hterm hpk hμ hu hr hj0 hj1 hst hcl (Or.inl ⟨rfl, hh⟩) hb ⟨he, hck⟩ htv' hi hE htv hm hH hC hfo (by rw [bind_ret hb, use_ret hu]; exact hRP)
  | stpKeep hp hw hu hr hj0 hj1 _ _ hst hcl _ _ hh hb =>
    rw [hpk] at hp; cases hp
    simp only [word2Of, Option.some.injEq, Prod.mk.injEq] at hw; obtain ⟨rfl, rfl⟩ := hw
    exact stpC_core hterm hpk hμ hu hr hj0 hj1 hst hcl (Or.inr ⟨rfl, hh⟩) hb ⟨he, hck⟩ htv' hi hE htv hm hH hC hfo (by rw [bind_ret hb, use_ret hu]; exact hRP)

/-- **(S5) A protocol pair's `stp` through an own or `pub` locative, with
resources and credits** (`stpC_core` for locatives, as `storeWordLocC_core`):
the pair is a component of its cell (`cell_target`); own cell
`MemInv_storeAt`, another thread's `MemInv_storePubAt`; `stpC_fin` does the
rest. -/
theorem stpLocC_core {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx c₁ c' : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v0 v1 tk : At}
    {μ : Mode} {r r' i0 i1 j0 j1 k0' k1' : Idx} {P : Proto2} {c₂ : Nat} {e : Expr} {xt : Ty} {cl' : Clause2}
    {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.stp rel a v0 v1 tk) e)
    (hpk : cx.peek a = .ok (.loc μ (.word2 r P))) (hμ : μ = .own ∨ μ = .pub)
    (hu : cx.use tk = .ok (.tok2 r' P i0 i1, c₁)) (hr : EqI c₁ r r') (hj0 : IntIdx c₁ v0 j0)
    (hj1 : IntIdx c₁ v1 j1) (hst : InState2 c₁ P j0 j1 c₂ k0' k1') (hcl : P.clauses[c₂]? = some cl')
    (hxt : (xt = .unit ∧ cl'.holds = true) ∨ (xt = .tok2 r' P j0 j1 ∧ cl'.holds = false))
    (hb : c₁.bind x xt = .ok c') (he : TypedK p η c' e) (htv' : TvOK c')
    (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRPc : RetPw th.σs th.stack c'.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  have hi0 := hi.1
  obtain ⟨hi1, -⟩ := use_FInv hu hi0
  have hus2 : accs (cl ρ η.wit 0 0 (.word2 r P)) = some [.two] := pair_accs_cl (wit := η.wit) (Or.inl ⟨r, P, rfl⟩)
  have hcell : cellOf (Ty.loc μ (.word2 r P)) = some (μ, .word2 r P) := by simp [cellOf]
  obtain ⟨rt, ws, hea, hv, hl⟩ := peek_VR hi0.2.1 hpk
  obtain ⟨ad, c, hws, hsto, hat, hmode, hini⟩ := cell_target hcell (Fd_noarr (by rw [hus2]; simp)) hv
  obtain ⟨pw, rfl, hpw⟩ := map_singleton hws
  have hsk := hl.2.1
  obtain ⟨μr, ru, rfl, -, hsku⟩ : ∃ μr ru, rt = .loc μr ru ∧ skelM μr = skelM μ ∧
      etok (skel ru) = etok (skel (close th.σs (.word2 r P))) := by
    simp only [close, substTs, skel, etok] at hsk
    obtain ⟨μr, ru, rfl, h1, h2⟩ := eskel_eq_loc hsk
    exact ⟨μr, ru, rfl, h1, h2⟩
  obtain ⟨r'', rfl⟩ := eskel_word2 (show etok (skel ru) = .word2 (.lit 0) P by rw [hsku]; rfl)
  have hat' : AtOff c.ty ad.offset (.word2 (.lit (ev ρ r)) P) := by simpa only [cl, clI_zero] using hat
  have hini' : IniAt η.ini c ad (.word2 (.lit (ev ρ r)) P) := by simpa only [cl, clI_zero] using (IniAt_mono (modeIni_le_ini _ _ _) hini)
  have hpwf := pwf2_of_held hH.memHeld hsto hat' hini'
  obtain ⟨rt0, rt1, w0, w1, Tf, Rv, hev0, hwv0, hev1, hwv1, hfr, hle, hvR⟩ :=
    stp_frame hi hE.2.2 (RLink_of hE.2.1 hE.2.2) hpwf hu hr hj0 hj1 hst hcl hb hxt
  have hval := storeWord2_val (η := η) (r := r) hpwf hi1.1 hst hwv0 hwv1
  have hna : ∀ N e, cl ρ η.wit 0 0 (.word2 r P) ≠ .array (.lit N) e := fun N e h => by simp [cl] at h
  have hwUA : accs (cl ρ η.wit 0 0 (.word2 r P)) = some [Acc.two] := hus2
  have hwU : wc (cl ρ η.wit 0 0 (.word2 r P)) = some (nWords [Acc.two]) := by simp [wc, hus2]
  have key : tstep g mem pairs th =
      (storeUnits g.k g.arch pw ad rel [.two] [w0, w1] 0 (stOf mem pairs th)).map fun s' =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, .unit, []) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hev0, hev1, word2Of, addrOf, hpw, List.map_map]; rfl
  refine stpC_fin (A := ad) key (fun s' hs' => ?_) hsto hat' hini' ⟨hvR _ _, by simp [Valid]⟩
    hfr hle hE he htv' hm hH hC hfo hRPc
  by_cases hown : c.owner = some η.tid
  · exact MemInv_storeAtI hm hsto hown hat (IniAt_mono (modeIni_le_ini _ _ _) hini) hna hval hwUA rfl s' hs'
  · have hpub : μ = .pub := by
      rcases hμ with rfl | rfl
      · exact absurd hmode hown
      · rfl
    subst hpub
    simp only [ModeOK] at hmode
    obtain ⟨f, hf, -⟩ := hmode
    exact MemInv_storePubAt hm hsto hown hf hat hini hna hval hus2 rfl s' hs'

/-- **(S5) `stp` through an own or `pub` locative** (Give and Keep), **with
resources and promise credits** (`tstepM_stpLoc`), as `tstepMC_stp`. -/
theorem tstepMC_stpLoc {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v0 v1 tk : At}
    {μ : Mode} {r : Idx} {P : Proto2} {e : Expr} {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .let_ x (.stp rel a v0 v1 tk) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.loc μ (.word2 r P))) (hμ : μ = .own ∨ μ = .pub)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  have hT0 := hT
  have hCk0 := hCk
  rw [hterm] at hT0 hCk0
  cases hT0 with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk0
  have htv' := OpT_TvOK hP hop htv
  cases hop with
  | stpGive hp hw hu hr hj0 hj1 _ _ hst hcl _ _ hh _ hb =>
    rw [hpk] at hp; cases hp
    simp only [word2Of, Option.some.injEq, Prod.mk.injEq] at hw; obtain ⟨rfl, rfl⟩ := hw
    exact stpLocC_core hterm hpk hμ hu hr hj0 hj1 hst hcl (Or.inl ⟨rfl, hh⟩) hb ⟨he, hck⟩ htv' hi hE htv hm hH hC hfo (by rw [bind_ret hb, use_ret hu]; exact hRP)
  | stpKeep hp hw hu hr hj0 hj1 _ _ hst hcl _ _ hh hb =>
    rw [hpk] at hp; cases hp
    simp only [word2Of, Option.some.injEq, Prod.mk.injEq] at hw; obtain ⟨rfl, rfl⟩ := hw
    exact stpLocC_core hterm hpk hμ hu hr hj0 hj1 hst hcl (Or.inr ⟨rfl, hh⟩) hb ⟨he, hck⟩ htv' hi hE htv hm hH hC hfo (by rw [bind_ret hb, use_ret hu]; exact hRP)

/-! ### (P4 step 4) `casp`, with resources -/

/-- An epoch pair's bump moves its counter (half 0, the bare parameter) by one. -/
theorem epoch2_succ {ρ : Nat → Nat} {cx : Cx} {P : Proto2} {i0 i1 j0 j1 k0 k1 k0' k1' : Idx} {c c' : Nat}
    (hp : pwf2 P = true) (he : P.epoch = true) (hsat : Sat cx.facts ρ)
    (hi : InState2 cx P i0 i1 c k0 k1) (hj : InState2 cx P j0 j1 c' k0' k1') (hb : Bump2 cx k0 k0') :
    ev ρ j0 = ev ρ i0 + 1 := by
  have hok : epochOK2 P = true := by
    revert hp; unfold pwf2; simp only [Bool.and_eq_true]; intro hp
    have := hp.2; rw [he] at this; simpa using this
  unfold epochOK2 at hok
  simp only [Bool.and_eq_true] at hok
  have hall := hok.1.2
  obtain ⟨a, ha, hia⟩ := hi
  obtain ⟨b, hb', hjb⟩ := hj
  have ea := List.all_eq_true.1 hall a (List.mem_of_getElem? ha)
  have eb := List.all_eq_true.1 hall b (List.mem_of_getElem? hb')
  simp only [Bool.and_eq_true, beq_iff_eq] at ea eb
  obtain ⟨e1, -, -⟩ := hia ρ hsat
  obtain ⟨e2, -, -⟩ := hjb ρ hsat
  have e3 := hb ρ hsat
  simp only [HalfStep] at e3
  rw [ea.1.2, ea.2] at e1
  rw [eb.1.2, eb.2] at e2
  omega

theorem rmwNewVal_dataE2 (r0 r1 w : Word) : Promises.rmwNewVal (regsOf r0 r1 w) (dataE 2 w) = w.val := by
  cases h : w.val <;> simp [dataE, h, Promises.rmwNewVal, regsOf]

/-- (P4) An epoch pair in memory has a well-formed counter. -/
theorem pwfE_of_held {η : TEnv} {s : St} {H : Res} {A : Address} {c : Cell} {n : Nat} {P : ECounter}
    (hH : MemHeld (CE η) s H) (hsto : η.sto A.label = some c) (hat : AtOff c.ty A.offset (.epair (.lit n) P))
    (hini : IniAt η.ini c A (.epair (.lit n) P)) : pwfE P = true := by
  obtain ⟨R0, H0, -, hent0, -⟩ := MemHeld_focus hH A.label
  obtain ⟨vals0, -, hC0⟩ := hent0.2 c hsto
  have hna : ∀ N e, Ty.epair (.lit n) P ≠ .array (.lit N) e := fun N e h => by cases h
  obtain ⟨b, oS, S, wS, Rsg, Rrc, -, -, hatS, hwS, hbw, -, ⟨hvs, -⟩, -⟩ := (own_segR hC0 hat hini hna).resolve_right (fun ⟨_, _, _, _, _, _, _, hz⟩ => by have h := hz _ (by simp [accs] : accs (Ty.epair (.lit n) P) = some [.two]); simp [nWords, Acc.size] at h)
  have hsl : ((vals0.drop b).take wS).length = wS := by
    simp only [List.length_take, List.length_drop]; omega
  obtain ⟨n1, Rq, Rr2, -, -, -, hvq, -⟩ := VRR_at (CE η).unsee hatS hvs (by rw [hsl]; exact hwS)
  simp only [VRR] at hvq
  exact hvq.1.1

/-- **(P4) A `casp`'s append, memory and credits** (two-word component `U` at
`A`, `A.next`; the RMW read `m0`, `m1`, adjacent to `mem.size`, `mem.size + 1`):
both new words are the latest at their units, so the cell's entry trades the
component's resources at the old latest words `[w0, w1]` (which are the read
messages' when both units are word units) for the new ones; the credits are
kept; the written counter word and its predecessor are what `MintStep` names. -/
theorem rmwPairAcc {E : TEnv} {s s' : St} {H : Res} {cr db : Ts → Res} {A : Address} {c : Cell} {U : Ty}
    {t0 t1 : Ts} {m0 m1 : Msg} {x0 x1 : WeakMem.Val} {mv : Ts} {Rx : Res}
    (hP : ∀ t, t ∈ s.promises → t < s.mem.size) (hFb : ∀ t, t ∈ E.fp → t < s.mem.size) (hH : MemHeld E s H) (hC : PromCr E s cr db)
    (hsto : E.sto A.label = some c) (hat : AtOff c.ty A.offset U) (hini : IniAt E.ini c A U)
    (hwU : wc U = some 2) (hna : ∀ N e, U ≠ .array (.lit N) e)
    (hm0 : s.mem[t0]? = some m0) (hl0 : m0.loc = A) (hm1 : s.mem[t1]? = some m1) (hl1 : m1.loc = A.next)
    (ha0 : WeakMem.rmwAdjacent s.mem A t0 s.mem.size = true)
    (ha1 : WeakMem.rmwAdjacent s.mem A.next t1 (s.mem.size + 1) = true)
    (hmem : s'.mem = (s.mem.push ⟨A, x0, mv⟩).push ⟨A.next, x1, mv⟩) (hpr : s'.promises = s.promises)
    (hx : ValOfR E U [mw ⟨A, x0, mv⟩, mw ⟨A.next, x1, mv⟩] Rx)
    (hown : OwnL E A.label → t0 ∉ s.promises ∧ t1 ∉ s.promises) :
    ∃ H' w0 w1 R0, MemHeld E s' H' ∧ PromCr E s' cr db ∧ VRR (fun _ => 0) (CE E.unsee) U (shp U) [w0, w1] R0 ∧
      (WordUnit E A → WordUnit E A.next → w0 = mw m0 ∧ w1 = mw m1) ∧
      H' + pSum s' cr + pSum s db + R0 = H + pSum s cr + pSum s' db + Rx ∧
      PredAt s'.mem A s.mem.size (mw m0) ∧ s'.mem[s.mem.size]? = some ⟨A, x0, mv⟩ ∧ s.mem.size ∉ s'.promises := by
  have hne : A.next ≠ A := WeakMem.Address.next_ne A
  obtain ⟨-, hb0⟩ := rmwAdjacent_spec ha0
  obtain ⟨-, hb1⟩ := rmwAdjacent_spec ha1
  have ht0 := lt_of_get hm0
  have hsz1 : s.mem.size < (s.mem.push ⟨A, x0, mv⟩).size := by rw [Array.size_push]; omega
  have hget : ∀ t, t < s.mem.size → s'.mem[t]? = s.mem[t]? := fun t ht => by
    rw [hmem, push_lt (Nat.lt_trans ht hsz1), push_lt ht]
  have hPA : ∀ B t, t ∈ PromAt E s' B → t < s.mem.size := fun B t ht =>
    (PromAt_sub ht).elim (fun h => hP t (by rw [← hpr]; exact h)) (fun h => hFb t h)
  have hl1n : LatestNP s'.mem (PromAt E s' A) A (mw ⟨A, x0, mv⟩) := by
    rw [hmem]
    exact LatestNP_push_other (LatestNP_push_top (M := s.mem) ⟨A, x0, mv⟩ (hPA A)) (by exact hne)
  have hl1n' : LatestNP s'.mem (PromAt E s' A.next) A.next (mw ⟨A.next, x1, mv⟩) := by
    rw [hmem]
    exact LatestNP_push_top _ (fun t ht => Nat.lt_trans (hPA _ t ht) hsz1)
  have hkeep : ∀ b w, b ≠ A → b ≠ A.next → LatestNP s.mem (PromAt E s b) b w →
      LatestNP s'.mem (PromAt E s' b) b w := by
    intro b w h0 h1 hl
    refine PromAt_atSame ?_ hl
    rw [hmem, hpr]
    exact AtSame_trans (AtSame_push (fun e => h0 e.symm)) (AtSame_push (fun e => h1 e.symm))
  obtain ⟨H', w0, w1, R0, hH', hw0, hw1, hv0, hEq⟩ := heldPair hH hsto hat hini hwU hna hl1n hl1n' hx hkeep
  have hid : WordUnit E A → WordUnit E A.next → w0 = mw m0 ∧ w1 = mw m1 := by
    intro hW0 hW1
    have hn : t0 ∉ PromAt E s A ∧ t1 ∉ PromAt E s A.next := by
      by_cases hV : Vis E A.label
      · rw [PromAt_word ⟨hW0, hV⟩, PromAt_word (a := A.next) ⟨hW1, hV⟩]; simp
      · have ho : Priv E A.label := Classical.byContradiction hV
        rw [PromAt_own ho, PromAt_own (a := A.next) ho]; exact hown ho.1
    refine ⟨LatestNP_uniq hw0 ⟨t0, m0, hn.1, hm0, hl0, rfl, fun t' m' hlt hm' hl' =>
      absurd hl' (hb0 t' m' hlt (lt_of_get hm') hm')⟩,
      LatestNP_uniq hw1 ⟨t1, m1, hn.2, hm1, hl1, rfl, fun t' m' hlt hm' hl' =>
        absurd hl' (hb1 t' m' hlt (Nat.lt_succ_of_lt (lt_of_get hm')) hm')⟩⟩
  have hpS : ∀ f, pSum s' f = pSum s f := fun f => by unfold pSum; rw [hpr]
  refine ⟨H', w0, w1, R0, hH', PromCr_keep hC hpr hP hget (fun _ _ _ _ => rfl), hv0, hid, ?_, ?_, ?_, ?_⟩
  · rw [hpS, hpS]
    exact Res.ext fun k => by
      have := congrArg (fun R : Res => R k) hEq
      simp only [Res.add_apply] at this ⊢; omega
  · refine ⟨t0, m0, ht0, by rw [hget t0 ht0]; exact hm0, hl0, rfl, fun t' m' h1 h2 h3 => ?_⟩
    rw [hget t' h2] at h3
    exact hb0 t' m' h1 h2 h3
  · rw [hmem, push_lt hsz1]; simp
  · rw [hpr]; exact fun h => Nat.lt_irrefl _ (hP _ h)

/-- `rmwPairAcc` with slot lists. -/
theorem rmwPairAccL {E : TEnv} {s s' : St} {H : Res} {Sl : AllocLabel → List Res} {cr db : Ts → Res} {A : Address} {c : Cell} {U : Ty}
    {t0 t1 : Ts} {m0 m1 : Msg} {x0 x1 : WeakMem.Val} {mv : Ts} {Rx : Res}
    (hP : ∀ t, t ∈ s.promises → t < s.mem.size) (hFb : ∀ t, t ∈ E.fp → t < s.mem.size) (hH : MemHeldL E s H Sl) (hC : PromCr E s cr db)
    (hsto : E.sto A.label = some c) (hat : AtOff c.ty A.offset U) (hini : IniAt E.ini c A U)
    (hwU : wc U = some 2) (hna : ∀ N e, U ≠ .array (.lit N) e)
    (hm0 : s.mem[t0]? = some m0) (hl0 : m0.loc = A) (hm1 : s.mem[t1]? = some m1) (hl1 : m1.loc = A.next)
    (ha0 : WeakMem.rmwAdjacent s.mem A t0 s.mem.size = true)
    (ha1 : WeakMem.rmwAdjacent s.mem A.next t1 (s.mem.size + 1) = true)
    (hmem : s'.mem = (s.mem.push ⟨A, x0, mv⟩).push ⟨A.next, x1, mv⟩) (hpr : s'.promises = s.promises)
    (hx : ValOfR E U [mw ⟨A, x0, mv⟩, mw ⟨A.next, x1, mv⟩] Rx)
    (hown : OwnL E A.label → t0 ∉ s.promises ∧ t1 ∉ s.promises) :
    ∃ H' w0 w1 R0, MemHeldK E s Sl E s' H' ∧ PromCr E s' cr db ∧ VRR (fun _ => 0) (CE E.unsee) U (shp U) [w0, w1] R0 ∧
      (WordUnit E A → WordUnit E A.next → w0 = mw m0 ∧ w1 = mw m1) ∧
      H' + pSum s' cr + pSum s db + R0 = H + pSum s cr + pSum s' db + Rx ∧
      PredAt s'.mem A s.mem.size (mw m0) ∧ s'.mem[s.mem.size]? = some ⟨A, x0, mv⟩ ∧ s.mem.size ∉ s'.promises := by
  have hne : A.next ≠ A := WeakMem.Address.next_ne A
  obtain ⟨-, hb0⟩ := rmwAdjacent_spec ha0
  obtain ⟨-, hb1⟩ := rmwAdjacent_spec ha1
  have ht0 := lt_of_get hm0
  have hsz1 : s.mem.size < (s.mem.push ⟨A, x0, mv⟩).size := by rw [Array.size_push]; omega
  have hget : ∀ t, t < s.mem.size → s'.mem[t]? = s.mem[t]? := fun t ht => by
    rw [hmem, push_lt (Nat.lt_trans ht hsz1), push_lt ht]
  have hPA : ∀ B t, t ∈ PromAt E s' B → t < s.mem.size := fun B t ht =>
    (PromAt_sub ht).elim (fun h => hP t (by rw [← hpr]; exact h)) (fun h => hFb t h)
  have hl1n : LatestNP s'.mem (PromAt E s' A) A (mw ⟨A, x0, mv⟩) := by
    rw [hmem]
    exact LatestNP_push_other (LatestNP_push_top (M := s.mem) ⟨A, x0, mv⟩ (hPA A)) (by exact hne)
  have hl1n' : LatestNP s'.mem (PromAt E s' A.next) A.next (mw ⟨A.next, x1, mv⟩) := by
    rw [hmem]
    exact LatestNP_push_top _ (fun t ht => Nat.lt_trans (hPA _ t ht) hsz1)
  have hkeep : ∀ b w, b ≠ A → b ≠ A.next → LatestNP s.mem (PromAt E s b) b w →
      LatestNP s'.mem (PromAt E s' b) b w := by
    intro b w h0 h1 hl
    refine PromAt_atSame ?_ hl
    rw [hmem, hpr]
    exact AtSame_trans (AtSame_push (fun e => h0 e.symm)) (AtSame_push (fun e => h1 e.symm))
  obtain ⟨H', w0, w1, R0, hH', hw0, hw1, hv0, hEq⟩ := heldPairL hH hsto hat hini hwU hna hl1n hl1n' hx hkeep
    (fun lo hi h1 h2 => ⟨s.mem.size, ⟨A, x0, mv⟩, by rw [hmem, push_lt hsz1]; simp, rfl, h1, h2, Or.inl (Nat.le_refl _)⟩)
  have hid : WordUnit E A → WordUnit E A.next → w0 = mw m0 ∧ w1 = mw m1 := by
    intro hW0 hW1
    have hn : t0 ∉ PromAt E s A ∧ t1 ∉ PromAt E s A.next := by
      by_cases hV : Vis E A.label
      · rw [PromAt_word ⟨hW0, hV⟩, PromAt_word (a := A.next) ⟨hW1, hV⟩]; simp
      · have ho : Priv E A.label := Classical.byContradiction hV
        rw [PromAt_own ho, PromAt_own (a := A.next) ho]; exact hown ho.1
    refine ⟨LatestNP_uniq hw0 ⟨t0, m0, hn.1, hm0, hl0, rfl, fun t' m' hlt hm' hl' =>
      absurd hl' (hb0 t' m' hlt (lt_of_get hm') hm')⟩,
      LatestNP_uniq hw1 ⟨t1, m1, hn.2, hm1, hl1, rfl, fun t' m' hlt hm' hl' =>
        absurd hl' (hb1 t' m' hlt (Nat.lt_succ_of_lt (lt_of_get hm')) hm')⟩⟩
  have hpS : ∀ f, pSum s' f = pSum s f := fun f => by unfold pSum; rw [hpr]
  refine ⟨H', w0, w1, R0, hH', PromCr_keep hC hpr hP hget (fun _ _ _ _ => rfl), hv0, hid, ?_, ?_, ?_, ?_⟩
  · rw [hpS, hpS]
    exact Res.ext fun k => by
      have := congrArg (fun R : Res => R k) hEq
      simp only [Res.add_apply] at this ⊢; omega
  · refine ⟨t0, m0, ht0, by rw [hget t0 ht0]; exact hm0, hl0, rfl, fun t' m' h1 h2 h3 => ?_⟩
    rw [hget t' h2] at h3
    exact hb0 t' m' h1 h2 h3
  · rw [hmem, push_lt hsz1]; simp
  · rw [hpr]; exact fun h => Nat.lt_irrefl _ (hP _ h)
#print axioms rmwPairAccL

/-- (P4) A reference's target cell. -/
theorem ptrTarget {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {K : TEnv → List Word → Prop}
    {cx : Cx} {env : Env} {w : At} {μ : Mode} {u : Ty}
    (hi : FInv ρ η σs K cx env) (hpk : cx.peek w = .ok (.ptr μ u)) :
    ∃ rw pw lab c, evalAt env w = some (rw, [pw]) ∧ pw.val = .loc ⟨lab, 0⟩ 0 ∧ η.sto lab = some c ∧
      Fd c.ty (cl ρ η.wit 0 0 u) := by
  obtain ⟨rt, ws, hea, hv, -⟩ := peek_VR hi.2.1 hpk
  simp only [VR] at hv
  obtain ⟨a, c, hws, ha0, hsto, hfd, -, -⟩ := hv
  obtain ⟨pw, rfl, hpw⟩ := map_singleton hws
  refine ⟨rt, pw, a.label, c, hea, ?_, hsto, hfd⟩
  rw [hpw]
  cases a with
  | mk l o => simp only at ha0; subst ha0; rfl

/-- (S5) **`caspC_core` at any address `A` of the cell** (a locative's
target, `AtOff c.ty A.offset U`); `caspC_core` is its instance at `⟨lab, 0⟩`. -/
theorem caspC_coreA {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx cok : Cx} {ρ : Nat → Nat} {η : TEnv} {acq rel : Bool} {w e0 e1 v0 v1 : At} {t : String}
    {ok fail : Expr} {A : Address} {c : Cell} {U : Ty} {f : List WeakMem.Val → Res}
    {pw x0 x1 n0 n1 : Word} {rw rt0 rt1 rtv0 rtv1 : Ty} {Rf Rs Rok H C F : Res} {cr db : Ts → Res}
    (hterm : th.term = .casp acq rel w e0 e1 v0 v1 t ok fail)
    (hea : evalAt th.env w = some (rw, [pw])) (haddr : addrOf pw = some A)
    (hee0 : evalAt th.env e0 = some (rt0, [x0])) (hee1 : evalAt th.env e1 = some (rt1, [x1]))
    (hev0 : evalAt th.env v0 = some (rtv0, [n0])) (hev1 : evalAt th.env v1 = some (rtv1, [n1]))
    (hne : loadUnits g.arch pw A acq [.two] 0 (stOf mem pairs th) ≠ [])
    (hcell : ∀ s1 ws, (s1, ws) ∈ loadUnits g.arch pw A acq [.two] 0 (stOf mem pairs th) → PromAbove s1 →
        MemInv g (CE η) s1 ∧ ∀ s1', MemInv g (CE η) s1' →
          ∀ s2, s2 ∈ storeUnits g.k g.arch pw A rel [.two] [n0, n1] 0 s1' → MemInv g (CE η) s2)
    (hsto : η.sto A.label = some c) (hat : AtOff c.ty A.offset U) (hini : IniAt η.ini c A U)
    (hwU : wc U = some 2) (hna : ∀ N e, U ≠ .array (.lit N) e)
    (hR : ∀ ws R, VRR (fun _ => 0) (CE (CE η).unsee) U (shp U) ws R → R = f (ws.map (·.val)))
    (hWf : (WordUnit (CE η) A ∧ WordUnit (CE η) A.next) ∨ ∀ vs, f vs = .zero)
    (hnew : ∀ ws : List Word, ws.map (·.val) = [n0.val, n1.val] → ValOfR (CE η) U ws (f [n0.val, n1.val]))
    (hpd : ∀ t, t ∈ th.promises → t ∉ pairs)
    (hok : TypedK p η cok ok) (htvok : TvOK cok)
    (hiok : FInvR ρ η th.σs (ResumeR p th.stack Rs) cok ((t, .unit, []) :: th.env) Rok)
    (hres : Rok + f [n0.val, n1.val] + C ≤ Rf + f [x0.val, x1.val] + F)
    (hmint : ∀ (s' : St) (tw : Ts) (w0 : Word) (m' : Msg), PredAt s'.mem A tw w0 → w0.val = x0.val →
        s'.mem[tw]? = some m' → m'.loc = A → m'.val = n0.val → tw ∉ s'.promises →
        MintStepN g η (stOf mem pairs th) s' C F)
    (hfail : TypedK p η cx fail)
    (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRPf : RetPw th.σs th.stack cx.ret) (hRPo : RetPw th.σs th.stack cok.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  have key : tstep g mem pairs th =
      (Promises.stepRmwPair g.arch mem pairs (mth (stOf mem pairs th) pw n0 n1) 1 2 A x0.val x1.val
          (dataE 1 n0) (dataE 2 n1) [0] acq rel).map fun (mem', pairs', th') =>
        (mem', pairs', withS (if (th'.regs 1).val == x0.val && (th'.regs 2).val == x1.val then
            { th with term := ok, env := (t, .unit, []) :: th.env } else { th with term := fail })
          ⟨mem', pairs, th'.vs, th'.promises, th.nalloc, th.undefs + countUndef [th'.regs 1, th'.regs 2]⟩) := by
    simp only [tstep, hterm, hea, hee0, hee1, hev0, hev1, haddr]; rfl
  rw [key] at ⊢
  obtain ⟨hx0, hx1⟩ := loadUnits_two_msg hne
  refine ⟨fun h => stepRmwPair_ne_nil hx0 hx1 (List.map_eq_nil_iff.1 h), fun r hr hpr0 => ?_⟩
  have hpr := hpr0
  have hpA := hpr
  rw [List.mem_map] at hr
  obtain ⟨⟨mem', pairs', th'⟩, hin, rfl⟩ := hr
  obtain ⟨s1, rd0, rd1, hl1, hr0, hr1, hcase⟩ := stepRmwPair_split (k := g.k) (s := stOf mem pairs th) hin
  obtain ⟨t0, t1, m0, m1, hm0, hl0, hm1, hl1', hv0, hv1, hmc, hcoh⟩ := stepRmwPair_memR hin (by decide) hpd
  have hP : ∀ t, t ∈ (stOf mem pairs th).promises → t < (stOf mem pairs th).mem.size :=
    fun t ht => hm.2.2.1 t ht
  rw [hr0] at hv0
  rw [hr1] at hv1
  rcases hcase with ⟨hne', hsame⟩ | ⟨h0, h1, s2, hs2, hsame⟩ | ⟨h0, h1, tw', pm, htw', hpm, hpl, hsame⟩
  · have hb : ((th'.regs 1).val == x0.val && (th'.regs 2).val == x1.val) = false := by
      rw [hr0, hr1]
      cases e0 : (rd0.val == x0.val) <;> cases e1 : (rd1.val == x1.val) <;> simp_all
    simp only [hb]
    have hp1 : PromAbove s1 := PromAbove_lockS (PromAbove_same hsame (fun t ht m hm => hpr t ht m hm))
    obtain ⟨hm1i, -⟩ := hcell s1 [rd0, rd1] hl1 hp1
    have hfl : mem' = mem ∧ th'.promises = th.promises := by
      rcases hmc with ⟨-, h1, h2⟩ | ⟨h0', h1', -⟩
      · exact ⟨h1, h2⟩
      · exact absurd ⟨hv0.trans h0', hv1.trans h1'⟩ hne'
    obtain ⟨rfl, hpr⟩ := hfl
    refine ⟨Rf + Rs, H, .zero, .zero, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, cx, Rf, Rs, rfl, hE, hfail, htv, hi, rfl, hRPf⟩,
      MemInv_same (MemInv_lockS g.arch hm1i) hsame, MemHeldK_eqs hH rfl hpr,
      PromCr_keep hC hpr hP (fun t _ => rfl) (fun _ _ _ _ => rfl)⟩, MintStepN.none, ?_⟩
    simp only [pSum, stOf, withS, hpr]
    exact Res.le_def.2 fun k => by simp only [Res.add_apply]; omega
  · have hb : ((th'.regs 1).val == x0.val && (th'.regs 2).val == x1.val) = true := by
      rw [hr0, hr1]; simp [h0, h1]
    simp only [hb, ite_true]
    have hp2 : PromAbove s2 :=
      PromAbove_lockS (s := setRel s2 (lockR g.arch (stOf mem pairs th) s1).vs) (PromAbove_same hsame (fun t ht m hm => hpr t ht m hm))
    have hp1' : PromAbove (bumpRel (lockR g.arch (stOf mem pairs th) s1) _) := storeUnits_promAbove hs2 hp2
    obtain ⟨hm1i, hst2⟩ := hcell s1 [rd0, rd1] hl1 (fun t ht m hm => hp1' t ht m hm)
    rcases hmc with ⟨hn, -, -⟩ | ⟨hmv0, hmv1, mv, hmem, hpr, ha0, ha1⟩
    · exact absurd ⟨hv0.symm.trans h0, hv1.symm.trans h1⟩ hn
    have e0 : Promises.rmwNewVal (mth (stOf mem pairs th) pw n0 n1).regs (dataE 1 n0) = n0.val :=
      rmwNewVal_dataE pw n0 n1
    have e1 : Promises.rmwNewVal (mth (stOf mem pairs th) pw n0 n1).regs (dataE 2 n1) = n1.val :=
      rmwNewVal_dataE2 pw n0 n1
    rw [e0, e1] at hmem
    have hownP : OwnL (CE η) A.label → t0 ∉ th.promises ∧ t1 ∉ th.promises := by
      intro _
      have hc := hcoh ⟨hmv0, hmv1⟩
      have ht0 := lt_of_get hm0
      have ht1 := lt_of_get hm1
      have hsz : mem.size < (mem.push ⟨A, n0.val, mv⟩).size := by rw [Array.size_push]; exact Nat.lt_succ_self _
      refine ⟨fun h => ?_, fun h => ?_⟩
      · have := hpA t0 (by show t0 ∈ th'.promises; rw [hpr]; exact h) m0
          (by show mem'[t0]? = some m0; rw [hmem, push_lt (Nat.lt_trans ht0 hsz), push_lt ht0]; exact hm0)
        rw [hl0] at this; exact absurd hc.1 (Nat.lt_asymm this)
      · have := hpA t1 (by show t1 ∈ th'.promises; rw [hpr]; exact h) m1
          (by show mem'[t1]? = some m1; rw [hmem, push_lt (Nat.lt_trans ht1 hsz), push_lt ht1]; exact hm1)
        rw [hl1'] at this; exact absurd hc.2 (Nat.lt_asymm this)
    obtain ⟨H', w0, w1, R0, hH', hC', hv0', hid, hEq, hpred, hm', hnp⟩ :=
      rmwPairAccL (E := CE η) (A := A) (c := c) (U := U) (s := stOf mem pairs th)
        (s' := ⟨mem', pairs', th'.vs, th'.promises, th.nalloc, th.undefs + countUndef [th'.regs 1, th'.regs 2]⟩)
        hP hfo.1 hH hC hsto hat hini hwU hna hm0 hl0 hm1 hl1' ha0 ha1 hmem hpr (hnew _ (by simp [mw])) hownP
    have hR0 : R0 = f [x0.val, x1.val] := by
      rw [hR _ _ hv0']
      rcases hWf with ⟨hW0, hW1⟩ | hz
      · obtain ⟨rfl, rfl⟩ := hid hW0 hW1
        simp [mw, hmv0, hmv1]
      · rw [hz, hz]
    refine ⟨Rok + Rs, H', C, F, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, cok, Rok, Rs, rfl, hE, hok, htvok, hiok, rfl, hRPo⟩,
      MemInv_same (MemInv_lockS g.arch
        (MemInv_setRel (hst2 _ (MemInv_bumpRel (MemInv_lockR g.arch (stOf mem pairs th) hm1i) _) s2 hs2) (MemInv_lockR g.arch (stOf mem pairs th) hm1i).2.2.2.2.1)) hsame, hH', hC'⟩,
      hmint _ _ (mw m0) _ hpred (by simp [mw, hmv0]) hm' rfl rfl hnp, ?_⟩
    simp only [pSum, stOf, withS] at hEq ⊢
    exact Res.le_def.2 fun k => by
      have h1 := hres k
      have h2 := congrArg (fun R : Res => R k) hEq
      simp only [Res.add_apply] at h1 h2 ⊢
      rw [hR0] at h2
      omega
  · exfalso
    have hp3 : th'.promises = th.promises := by
      rcases hmc with ⟨_, _, h⟩ | ⟨_, _, _, _, h, _⟩ <;> exact h
    have hs1p : s1.promises = th.promises :=
      (TermMem.loadUnits_frame [.two] 0 (stOf mem pairs th) (s1, [rd0, rd1]) hl1).2.2.1
    have e := hsame.2.2.2.1
    rw [lockS_prom] at e
    simp only [pairFulS] at e
    rw [hp3, hs1p] at e
    rw [hs1p] at htw'
    have hl := congrArg List.length e
    have h1 := List.length_erase_of_mem htw'
    have h2 := List.length_erase_le (l := th.promises.erase tw') (a := tw' + 1)
    have h3 := List.length_pos_of_mem htw'
    omega

/-- **(P4) A `casp` at a two-word component `U` of a cell, with resources**:
the component's resources are `f` of its two values (`hR`; at a protocol pair
`wr2`, at an epoch pair nothing).  Failure keeps memory and the frame; success
appends both words (`rmwPairAcc`), trades `f` of the old values (the read
messages', `hWf`) for `f` of the new ones, and mints what `hmint` says.  A
fulfilment is excluded by `hpd`. -/
theorem caspC_core {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx cok : Cx} {ρ : Nat → Nat} {η : TEnv} {acq rel : Bool} {w e0 e1 v0 v1 : At} {t : String}
    {ok fail : Expr} {lab : AllocLabel} {c : Cell} {U : Ty} {f : List WeakMem.Val → Res}
    {pw x0 x1 n0 n1 : Word} {rw rt0 rt1 rtv0 rtv1 : Ty} {Rf Rs Rok H C F : Res} {cr db : Ts → Res}
    (hterm : th.term = .casp acq rel w e0 e1 v0 v1 t ok fail)
    (hea : evalAt th.env w = some (rw, [pw])) (hpw : pw.val = .loc ⟨lab, 0⟩ 0)
    (hee0 : evalAt th.env e0 = some (rt0, [x0])) (hee1 : evalAt th.env e1 = some (rt1, [x1]))
    (hev0 : evalAt th.env v0 = some (rtv0, [n0])) (hev1 : evalAt th.env v1 = some (rtv1, [n1]))
    (hne : loadUnits g.arch pw ⟨lab, 0⟩ acq [.two] 0 (stOf mem pairs th) ≠ [])
    (hcell : ∀ s1 ws, (s1, ws) ∈ loadUnits g.arch pw ⟨lab, 0⟩ acq [.two] 0 (stOf mem pairs th) → PromAbove s1 →
        MemInv g (CE η) s1 ∧ ∀ s1', MemInv g (CE η) s1' →
          ∀ s2, s2 ∈ storeUnits g.k g.arch pw ⟨lab, 0⟩ rel [.two] [n0, n1] 0 s1' → MemInv g (CE η) s2)
    (hsto : η.sto lab = some c) (hat : AtOff c.ty 0 U) (hini : IniAt η.ini c ⟨lab, 0⟩ U)
    (hwU : wc U = some 2) (hna : ∀ N e, U ≠ .array (.lit N) e)
    (hR : ∀ ws R, VRR (fun _ => 0) (CE (CE η).unsee) U (shp U) ws R → R = f (ws.map (·.val)))
    (hWf : (WordUnit (CE η) ⟨lab, 0⟩ ∧ WordUnit (CE η) (⟨lab, 0⟩ : Address).next) ∨ ∀ vs, f vs = .zero)
    (hnew : ∀ ws : List Word, ws.map (·.val) = [n0.val, n1.val] → ValOfR (CE η) U ws (f [n0.val, n1.val]))
    (hpd : ∀ t, t ∈ th.promises → t ∉ pairs)
    (hok : TypedK p η cok ok) (htvok : TvOK cok)
    (hiok : FInvR ρ η th.σs (ResumeR p th.stack Rs) cok ((t, .unit, []) :: th.env) Rok)
    (hres : Rok + f [n0.val, n1.val] + C ≤ Rf + f [x0.val, x1.val] + F)
    (hmint : ∀ (s' : St) (tw : Ts) (w0 : Word) (m' : Msg), PredAt s'.mem ⟨lab, 0⟩ tw w0 → w0.val = x0.val →
        s'.mem[tw]? = some m' → m'.loc = ⟨lab, 0⟩ → m'.val = n0.val → tw ∉ s'.promises →
        MintStepN g η (stOf mem pairs th) s' C F)
    (hfail : TypedK p η cx fail)
    (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hRPo : RetPw th.σs th.stack cok.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  exact caspC_coreA (A := ⟨lab, 0⟩) hterm hea (by simp [addrOf, hpw]) hee0 hee1 hev0 hev1 hne hcell hsto hat
    hini hwU hna hR hWf hnew hpd hok htvok hiok hres hmint hfail hi hE htv hm hH hC hfo hRP hRPo

/-- `caspC_core` from the operands' types: the atoms' values, the cell
(`caspCell`), matched with the reference's target cell. -/
theorem caspC_mid {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx cok : Cx} {ρ : Nat → Nat} {η : TEnv} {acq rel : Bool} {w e0 e1 v0 v1 : At} {t : String}
    {ok fail : Expr} {μ : Mode} {tw : Ty} {i0 i1 j0 j1 : Idx} {lab : AllocLabel} {c : Cell} {U : Ty}
    {f : List WeakMem.Val → Res} {pw : Word} {rw : Ty} {Rf Rs Rok H C F : Res} {cr db : Ts → Res}
    (hterm : th.term = .casp acq rel w e0 e1 v0 v1 t ok fail)
    (hpk : cx.peek w = .ok (.ptr μ tw)) (hμ : μ = .own ∨ μ = .pub)
    (htw : (∃ r P, tw = .word2 r P) ∨ (∃ r P, tw = .epair r P))
    (hie0 : IntIdx cx e0 i0) (hie1 : IntIdx cx e1 i1) (hj0 : IntIdx cx v0 j0) (hj1 : IntIdx cx v1 j1)
    (hnv : ∀ n0 n1 : Word, n0.val = .num (ev ρ j0) → n1.val = .num (ev ρ j1) →
      (∃ R ws, VR ρ η tw R ws) → EnvVal (CE η) (cl ρ η.wit 0 0 tw) [n0, n1])
    (hea : evalAt th.env w = some (rw, [pw])) (hpw : pw.val = .loc ⟨lab, 0⟩ 0)
    (hsto : η.sto lab = some c) (hat : AtOff c.ty 0 U) (hini : IniAt η.ini c ⟨lab, 0⟩ U)
    (hwU : wc U = some 2) (hna : ∀ N e, U ≠ .array (.lit N) e)
    (hR : ∀ ws R, VRR (fun _ => 0) (CE (CE η).unsee) U (shp U) ws R → R = f (ws.map (·.val)))
    (hWf : (WordUnit (CE η) ⟨lab, 0⟩ ∧ WordUnit (CE η) (⟨lab, 0⟩ : Address).next) ∨ ∀ vs, f vs = .zero)
    (hnew : ∀ ws : List Word, ws.map (·.val) = [.num (ev ρ j0), .num (ev ρ j1)] →
      ValOfR (CE η) U ws (f [.num (ev ρ j0), .num (ev ρ j1)]))
    (hpd : ∀ t, t ∈ th.promises → t ∉ pairs)
    (hok : TypedK p η cok ok) (htvok : TvOK cok)
    (hiok : FInvR ρ η th.σs (ResumeR p th.stack Rs) cok ((t, .unit, []) :: th.env) Rok)
    (hres : Rok + f [.num (ev ρ j0), .num (ev ρ j1)] + C ≤ Rf + f [.num (ev ρ i0), .num (ev ρ i1)] + F)
    (hmint : ∀ (s' : St) (tw : Ts) (w0 : Word) (m' : Msg), PredAt s'.mem ⟨lab, 0⟩ tw w0 →
        w0.val = .num (ev ρ i0) → s'.mem[tw]? = some m' → m'.loc = ⟨lab, 0⟩ → m'.val = .num (ev ρ j0) →
        tw ∉ s'.promises → MintStepN g η (stOf mem pairs th) s' C F)
    (hfail : TypedK p η cx fail)
    (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hRPo : RetPw th.σs th.stack cok.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  obtain ⟨te0, hte0, hio0⟩ := hie0
  obtain ⟨rt0, x0, hee0, hx0, -⟩ := atom_num hi.1.2.1 hte0 hio0
  obtain ⟨te1, hte1, hio1⟩ := hie1
  obtain ⟨rt1, x1, hee1, hx1, -⟩ := atom_num hi.1.2.1 hte1 hio1
  obtain ⟨tv0, htv0, hjo0⟩ := hj0
  obtain ⟨rtv0, n0, hev0, hn0, -⟩ := atom_num hi.1.2.1 htv0 hjo0
  obtain ⟨tv1, htv1, hjo1⟩ := hj1
  obtain ⟨rtv1, n1, hev1, hn1, -⟩ := atom_num hi.1.2.1 htv1 hjo1
  obtain ⟨lab', pw', rw', hea2, hpw2, hne, hcell⟩ := caspCell (acq := acq) (rel := rel) (g := g) (mem := mem)
    (pairs := pairs) hpk hμ htw (hnv n0 n1 hn0 hn1) hi.1 hE htv hm
  rw [hea] at hea2
  simp only [Option.some.injEq, Prod.mk.injEq, List.cons.injEq, and_true] at hea2
  obtain ⟨-, rfl⟩ := hea2
  obtain rfl : lab' = lab := by
    rw [hpw] at hpw2; simp only [Val.loc.injEq, Address.mk.injEq] at hpw2; exact hpw2.1.1.symm
  exact caspC_core hterm hea hpw hee0 hee1 hev0 hev1 hne
    (fun s1 ws h hp => ⟨(hcell s1 ws h hp).1, (hcell s1 ws h hp).2⟩) hsto hat hini hwU hna hR hWf
    (fun ws hws => by rw [hn0, hn1] at hws ⊢; exact hnew ws hws) hpd hok htvok hiok
    (by rw [hx0, hx1, hn0, hn1]; exact hres)
    (fun s' tw w0 m' h1 h2 h3 h4 h5 h6 => hmint s' tw w0 m' h1 (h2.trans hx0) h3 h4 (h5.trans hn0) h6)
    hfail hi hE htv hm hH hC hfo hRP hRPo

/-- (S5) `caspC_mid` for a locative: the atoms' values, the cell
(`caspLocCell`), matched with the locative's target address. -/
theorem caspLocC_mid {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx cok : Cx} {ρ : Nat → Nat} {η : TEnv} {acq rel : Bool} {w e0 e1 v0 v1 : At} {t : String}
    {ok fail : Expr} {μ : Mode} {tw : Ty} {i0 i1 j0 j1 : Idx} {A : Address} {c : Cell} {U : Ty}
    {f : List WeakMem.Val → Res} {pw : Word} {rw : Ty} {Rf Rs Rok H C F : Res} {cr db : Ts → Res}
    (hterm : th.term = .casp acq rel w e0 e1 v0 v1 t ok fail)
    (hpk : cx.peek w = .ok (.loc μ tw)) (hμ : μ = .own ∨ μ = .pub)
    (htw : (∃ r P, tw = .word2 r P) ∨ (∃ r P, tw = .epair r P))
    (hie0 : IntIdx cx e0 i0) (hie1 : IntIdx cx e1 i1) (hj0 : IntIdx cx v0 j0) (hj1 : IntIdx cx v1 j1)
    (hnv : ∀ n0 n1 : Word, n0.val = .num (ev ρ j0) → n1.val = .num (ev ρ j1) →
      (∃ R ws, VR ρ η tw R ws) → EnvVal (CE η) (cl ρ η.wit 0 0 tw) [n0, n1])
    (hea : evalAt th.env w = some (rw, [pw])) (haddr : addrOf pw = some A)
    (hsto : η.sto A.label = some c) (hat : AtOff c.ty A.offset U) (hini : IniAt η.ini c A U)
    (hwU : wc U = some 2) (hna : ∀ N e, U ≠ .array (.lit N) e)
    (hR : ∀ ws R, VRR (fun _ => 0) (CE (CE η).unsee) U (shp U) ws R → R = f (ws.map (·.val)))
    (hWf : (WordUnit (CE η) A ∧ WordUnit (CE η) A.next) ∨ ∀ vs, f vs = .zero)
    (hnew : ∀ ws : List Word, ws.map (·.val) = [.num (ev ρ j0), .num (ev ρ j1)] →
      ValOfR (CE η) U ws (f [.num (ev ρ j0), .num (ev ρ j1)]))
    (hpd : ∀ t, t ∈ th.promises → t ∉ pairs)
    (hok : TypedK p η cok ok) (htvok : TvOK cok)
    (hiok : FInvR ρ η th.σs (ResumeR p th.stack Rs) cok ((t, .unit, []) :: th.env) Rok)
    (hres : Rok + f [.num (ev ρ j0), .num (ev ρ j1)] + C ≤ Rf + f [.num (ev ρ i0), .num (ev ρ i1)] + F)
    (hmint : ∀ (s' : St) (tw : Ts) (w0 : Word) (m' : Msg), PredAt s'.mem A tw w0 →
        w0.val = .num (ev ρ i0) → s'.mem[tw]? = some m' → m'.loc = A → m'.val = .num (ev ρ j0) →
        tw ∉ s'.promises → MintStepN g η (stOf mem pairs th) s' C F)
    (hfail : TypedK p η cx fail)
    (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hRPo : RetPw th.σs th.stack cok.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  obtain ⟨te0, hte0, hio0⟩ := hie0
  obtain ⟨rt0, x0, hee0, hx0, -⟩ := atom_num hi.1.2.1 hte0 hio0
  obtain ⟨te1, hte1, hio1⟩ := hie1
  obtain ⟨rt1, x1, hee1, hx1, -⟩ := atom_num hi.1.2.1 hte1 hio1
  obtain ⟨tv0, htv0, hjo0⟩ := hj0
  obtain ⟨rtv0, n0, hev0, hn0, -⟩ := atom_num hi.1.2.1 htv0 hjo0
  obtain ⟨tv1, htv1, hjo1⟩ := hj1
  obtain ⟨rtv1, n1, hev1, hn1, -⟩ := atom_num hi.1.2.1 htv1 hjo1
  obtain ⟨ad', pw', rw', hea2, haddr2, hne, hcell⟩ := caspLocCell (acq := acq) (rel := rel) (g := g)
    (mem := mem) (pairs := pairs) hpk hμ htw (hnv n0 n1 hn0 hn1) hi.1 hE htv hm
  rw [hea] at hea2
  simp only [Option.some.injEq, Prod.mk.injEq, List.cons.injEq, and_true] at hea2
  obtain ⟨-, rfl⟩ := hea2
  obtain rfl : ad' = A := Option.some.inj (haddr2.symm.trans haddr)
  exact caspC_coreA hterm hea haddr hee0 hee1 hev0 hev1 hne
    (fun s1 ws h hp => ⟨(hcell s1 ws h hp).1, (hcell s1 ws h hp).2⟩) hsto hat hini hwU hna hR hWf
    (fun ws hws => by rw [hn0, hn1] at hws ⊢; exact hnew ws hws) hpd hok htvok hiok
    (by rw [hx0, hx1, hn0, hn1]; exact hres)
    (fun s' tw w0 m' h1 h2 h3 h4 h5 h6 => hmint s' tw w0 m' h1 (h2.trans hx0) h3 h4 (h5.trans hn0) h6)
    hfail hi hE htv hm hH hC hfo hRP hRPo

/-- **(P4 step 4) `casp`** (own or `pub` reference to a protocol or epoch pair),
**with resources and promise credits** (`tstepM_casp`): `caspMove` (nothing
moves), `caspTake` (the pair's region token moves from memory to the bound
`tok2`), `caspBump` (the bound epoch token is minted, `MintStep.epoch2`; the
pair keeps holding), `caspE` (an epoch pair holds nothing).  Failure keeps
everything.  `hpd` (no promise of the thread is a pair-top timestamp) rules out
the fulfilment outcome. -/
theorem tstepMC_casp {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {acq rel : Bool} {w e0 e1 v0 v1 : At} {t : String} {ok fail : Expr}
    {μ : Mode} {u : Ty} {Rf Rs H : Res} {cr db : Ts → Res}
    (hterm : th.term = .casp acq rel w e0 e1 v0 v1 t ok fail)
    (hpk : cx.peek w = .ok (.ptr μ u)) (hμ : μ = .own ∨ μ = .pub)
    (hu : (∃ r P, u = .word2 r P) ∨ (∃ r P, u = .epair r P))
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  have hpd : ∀ t, t ∈ th.promises → t ∉ pairs := MemInv_nopair hm
  have hsat : Sat cx.facts ρ := hi.1.1
  have hRL := RLink_of hE.2.1 hE.2.2
  obtain ⟨rw, pw, lab, c, hea, hpw, hsto, hfd⟩ := ptrTarget hi.1 hpk
  have hT0 := hT
  have hCk0 := hCk
  rw [hterm] at hT0 hCk0
  -- The protocol-pair cases share the cell facts.
  have hW2 : ∀ {r : Idx} {P : Proto2}, u = .word2 r P →
      c.ty = .word2 (.lit (ev ρ r)) P ∧ AtOff c.ty 0 (.word2 (.lit (ev ρ r)) P) ∧
        IniAt η.ini c ⟨lab, 0⟩ (.word2 (.lit (ev ρ r)) P) := by
    intro r P hu'
    subst hu'
    have h' := hfd; simp only [cl, clI_zero] at h'
    have hct := Fd_word2_eq h'
    exact ⟨hct, by rw [hct]; exact .here (Or.inl (by simp [accs])),
      IniAt_of_ne fun N e h => by rw [hct] at h; cases h⟩
  cases TermA4.CkW_inv_casp hCk0 with
  | caspE hp hwn hwe _ hie0 hie1 hj0 hj1 _ hb hok hfail =>
    rw [hpk] at hp; cases hp
    rcases hu with ⟨r, P, rfl⟩ | ⟨r, P, rfl⟩
    · simp [word2Of] at hwn
    simp only [epairOf, Option.some.injEq, Prod.mk.injEq] at hwe; obtain ⟨rfl, rfl⟩ := hwe
    have h' := hfd; simp only [cl, clI_zero] at h'
    have hct := Fd_epair_eq h'
    have hat : AtOff c.ty 0 (.epair (.lit (ev ρ r)) P) := by rw [hct]; exact .here (Or.inl (by simp [accs]))
    have hini : IniAt η.ini c ⟨lab, 0⟩ (.epair (.lit (ev ρ r)) P) :=
      IniAt_of_ne fun N e h => by rw [hct] at h; cases h
    have hpwf := pwfE_of_held hH.memHeld hsto hat hini
    have hiok := bindR hb hi hRL (show VRR ρ η .unit (shp .unit) [] .zero from rfl) (unit_Lay _)
    exact caspC_mid (f := fun _ => .zero) (C := .zero) (F := .zero) hterm hpk hμ (Or.inr ⟨_, _, rfl⟩)
      hie0 hie1 hj0 hj1 (fun n0 n1 hn0 hn1 _ => storeEPair_val hpwf ⟨_, _, hn0, hn1⟩) hea hpw hsto hat hini
      (by simp [wc, accs, nWords, Acc.size]) (fun N e h => by cases h)
      (fun ws R h => by simp only [VRR] at h; exact h.2) (Or.inr fun _ => rfl)
      (fun ws hws => ⟨by simp only [VRR]; exact ⟨⟨hpwf, _, _, hws⟩, trivial⟩, by simp [Valid]⟩) hpd hok.tk
