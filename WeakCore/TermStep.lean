/-- (U3 R1) **`ValOf` transfers along agreement on the labels its words
name, box payloads by `PayT`** (`VR_monoH` at the unseen code views). -/
theorem ValOf_monoH {G : AllocLabel → Prop} {η₁ η₂ : TEnv} {T : Ty} {ws : List Word}
    (hpay : PayT G (CE η₁.unsee) (CE η₂.unsee))
    (hp : η₁.prog = η₂.prog) (ht : η₁.tid = η₂.tid)
    (hs : ∀ l c, G l → η₁.sto l = some c → η₂.sto l = some c)
    (hi : ∀ l, G l → η₁.ini l ≤ η₂.ini l) (hri : ∀ l, G l → η₁.rini l ≤ η₂.rini l)
    (hP : ∀ l f, G l → η₁.pfr l = some f → ∃ f', η₂.pfr l = some f' ∧ f' ≤ f)
    (hBx : ∀ l B, G l → η₁.box l = some B → η₂.box l = some B)
    (hG : LabsIn G ws) (h : ValOf η₁ T ws) : ValOf η₂ T ws :=
  ⟨VR_monoH hpay T (CE η₁.unsee) (CE η₂.unsee) _ _ ws (CoreEq.refl _) (CoreEq.refl _)
    (fun _ _ _ h => h) (fun _ _ _ h => h)
    ⟨hs, hi, hri, hP, fun _ _ _ h => h.elim, fun _ _ h => h.elim, hBx, rfl, hp, ht⟩ hG h.1, h.2⟩

#print axioms ValOf_monoH

/-- (U3 R1) What `VR` checks at a reference it reads: a published cell, or a
box, either `seen` or with a frontier the word's view reaches. -/
def Insp (η : TEnv) (l : AllocLabel) (v : Ts) : Prop :=
  (∃ c f, η.sto l = some c ∧ η.pfr l = some f ∧ (η.seen l ∨ f ≤ v)) ∨
    (∃ B, η.box l = some B ∧ ((η.seen l ∧ ∃ f, η.pfr l = some f ∧ B.fr ≤ f) ∨ B.fr ≤ v))

/-- (U3 R1) Every reference word of `ws` satisfies `Q` at its label and view. -/
def LabsV (Q : AllocLabel → Ts → Prop) (ws : List Word) : Prop :=
  ∀ w ∈ ws, ∀ (a : Address) (g : Nat), w.val = .loc a g → Q a.label w.view

theorem LabsV.labsIn {Q : AllocLabel → Ts → Prop} {ws : List Word} (h : LabsV Q ws) :
    LabsIn (fun l => ∃ v, Q l v) ws := fun w hw a g e => ⟨_, h w hw a g e⟩

theorem LabsV_noloc {Q : AllocLabel → Ts → Prop} {ws : List Word} {vs : List WeakMem.Val} (h : ws.map (·.val) = vs)
    (hv : ∀ (a : Address) (g : Nat), WeakMem.Val.loc a g ∉ vs) : LabsV Q ws := by
  intro w hw a g e
  exact absurd (h ▸ List.mem_map.2 ⟨w, hw, e⟩) (hv a g)

theorem LabsV_nil {Q : AllocLabel → Ts → Prop} {ws : List Word} (h : ws.length = 0) : LabsV Q ws := by
  intro w hw; rw [List.length_eq_zero_iff] at h; subst h; cases hw

theorem LabsV_one {Q : AllocLabel → Ts → Prop} {ws : List Word} {a : Address} {g : Nat}
    (hv : ws.map (·.val) = [.loc a g]) (hQ : ∀ w ∈ ws, Q a.label w.view) : LabsV Q ws := by
  match ws, hv with
  | [w], hv =>
    simp only [List.map_cons, List.map_nil, List.cons.injEq, and_true] at hv
    intro w' hw' a' g' e
    rw [List.mem_singleton] at hw'; subst hw'
    rw [hv] at e; simp only [Val.loc.injEq] at e; obtain ⟨rfl, -⟩ := e
    exact hQ _ (List.mem_singleton.2 rfl)
  | [], hv => cases hv
  | _ :: _ :: _, hv => simp at hv

theorem LabsV_takeDrop {Q : AllocLabel → Ts → Prop} {ws : List Word} (n : Nat)
    (h1 : LabsV Q (ws.take n)) (h2 : LabsV Q (ws.drop n)) : LabsV Q ws := by
  intro w hw
  rw [← List.take_append_drop n ws, List.mem_append] at hw
  rcases hw with hw | hw
  · exact h1 w hw
  · exact h2 w hw

/-- (U3 R1) A decoded payload keeps every reference word of a canonical
encoding (a wide sum's payload-free filler is a number). -/
theorem decodeArm_labsV {Q : AllocLabel → Ts → Prop} {tr : Tier} {as : List Ty} {ws : List Word} {j : Nat}
    {p q : List Word} (h : decodeArm tr as ws = some (j, p)) (he : encodeArm tr as j p = some q)
    (hq : q.map (·.val) = ws.map (·.val)) (hp : LabsV Q p) : LabsV Q ws := by
  unfold decodeArm at h
  split at h
  · rename_i w
    split at h
    · rename_i a g hv
      simp only [Option.bind_eq_bind, Option.bind_eq_some_iff, Option.pure_def, Option.some.injEq] at h
      obtain ⟨⟨j', x⟩, -, h⟩ := h
      simp only [Prod.mk.injEq] at h
      obtain ⟨-, rfl⟩ := h
      have := hp _ (List.mem_singleton.2 rfl) a 0 rfl
      exact LabsV_one (a := a) (g := g) (by simp [hv]) fun w' hw' => by
        rw [List.mem_singleton] at hw'; subst hw'; exact this
    · rename_i n hv
      exact LabsV_noloc (vs := [.num n]) (by simp [hv]) (by simp)
    · cases h
  · rename_i t w
    split at h
    · rename_i n hv
      simp only [Option.bind_eq_bind, Option.bind_eq_some_iff, Option.pure_def] at h
      obtain ⟨arm, -, h⟩ := h
      split at h <;> simp only [Option.some.injEq, Prod.mk.injEq] at h <;> obtain ⟨rfl, rfl⟩ := h
      · simp only [encodeArm, Option.some.injEq] at he; subst he
        simp only [List.map_cons, List.map_nil, cst_val, List.cons.injEq, and_true] at hq
        exact LabsV_noloc (vs := [.num n, .num 0]) (by simp [hv, ← hq.2]) (by simp)
      · intro w' hw' a' g' e
        simp only [List.mem_cons, List.not_mem_nil, or_false] at hw'
        rcases hw' with rfl | rfl
        · rw [hv] at e; cases e
        · exact hp _ (List.mem_singleton.2 rfl) a' g' e
    · cases h
  · cases h

/-- (U3 R1) Re-injecting a payload keeps its reference words (label and view). -/
theorem ofArm_labsV {Q : AllocLabel → Ts → Prop} {t : Ty} {j : Nat} {p q : List Word}
    (h : ofArm t j p = some q) (hq : LabsV Q q) : LabsV Q p := by
  unfold ofArm at h
  split at h
  · unfold encodeArm at h
    split at h
    · simp only [Option.bind_eq_bind, Option.bind_eq_some_iff] at h
      obtain ⟨arm, -, h⟩ := h
      split at h
      · rename_i w
        split at h
        · rename_i a g hv
          simp only [Option.some.injEq] at h; subst h
          have := hq _ (List.mem_singleton.2 rfl) a _ rfl
          exact LabsV_one (a := a) (g := g) (by simp [hv]) fun w' hw' => by
            rw [List.mem_singleton] at hw'; subst hw'; exact this
        · rename_i hv
          exact LabsV_noloc (vs := [.null]) (by simp [hv]) (by simp)
        · cases h
      · rename_i w
        split at h
        · rename_i a g hv
          simp only [Option.some.injEq] at h; subst h
          have := hq _ (List.mem_singleton.2 rfl) a _ rfl
          exact LabsV_one (a := a) (g := g) (by simp [hv]) fun w' hw' => by
            rw [List.mem_singleton] at hw'; subst hw'; exact this
        · rename_i hv
          exact LabsV_noloc (vs := [.null]) (by simp [hv]) (by simp)
        · cases h
      · intro _ hw; cases hw
      · cases h
    · split at h
      · intro _ hw; cases hw
      · rename_i w
        simp only [Option.some.injEq] at h; subst h
        intro w' hw' a g e
        rw [List.mem_singleton] at hw'; subst hw'
        exact hq _ (by simp) a g e
      · cases h
    · cases h
  · split at h
    · simp only [Option.some.injEq] at h; subst h; exact hq
    · cases h

