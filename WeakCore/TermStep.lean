/-- (P4) `VR_store`, resourcefully. -/
theorem VRR_store {η : TEnv} (hc : Coh η) (hr : CohR η) {V : WeakMem.Ts} {ρ : Nat → Nat} {t : Ty} {S : Shp}
    {ws : List Word} {X : Res} (hS : ∀ l, η.seen l → ∃ f, η.pfr l = some f ∧ f ≤ V) (hL : LocAbove V ws)
    (h : VRR ρ η t S ws X) : VRR ρ η.unsee t S ws X := by
  have c1 := VRR_close hc.unsee hr.unsee ρ t [] 0 ρ ρ S ws X (fun _ => rfl) (fun _ hk => absurd hk (Nat.not_lt_zero _))
  have c2 := VRR_close hc hr ρ t [] 0 ρ ρ S ws X (fun _ => rfl) (fun _ hk => absurd hk (Nat.not_lt_zero _))
  refine c1.2 ?_
  exact VRR_unsee V _ (CE η) (CE η.unsee) ρ S ws X (fun _ _ _ _ h => h) (fun _ _ _ _ h => h) rfl rfl rfl
    (fun _ _ h => h) (fun _ => Nat.le_refl _) (fun _ _ h => h) (fun l hl => Or.inr (hS l hl))
    (fun _ _ h => h) hL (c2.1 h)

/-- (P4) `VR_seen`, resourcefully. -/
theorem VRR_seen {η : TEnv} (hc : Coh η) (hr : CohR η) {ρ : Nat → Nat} {t : Ty} {S : Shp} {ws : List Word}
    {X : Res} (h : VRR ρ η.unsee t S ws X) : VRR ρ η t S ws X := by
  have c1 := VRR_close hc.unsee hr.unsee ρ t [] 0 ρ ρ S ws X (fun _ => rfl) (fun _ hk => absurd hk (Nat.not_lt_zero _))
  have c2 := VRR_close hc hr ρ t [] 0 ρ ρ S ws X (fun _ => rfl) (fun _ hk => absurd hk (Nat.not_lt_zero _))
  refine c2.2 ?_
  exact VRR_mono _ (CE η.unsee) (CE η) ρ S ws X (fun _ _ _ _ h => h) (fun _ _ _ _ h => h) rfl rfl rfl
    (fun _ _ h => h) (fun _ => Nat.le_refl _) (fun _ _ h => h) (fun _ h => h.elim) (fun _ _ h => h) (c1.1 h)

/-- (P4) `VR_ren0`, resourcefully: re-boxing keeps the resources. -/
theorem VRR_ren0 (w1 w2 : Word) (x1 x2 : WeakMem.Address) (B1 B2 : Box)
    (h1 : w1.val = .loc x1 0) (h2 : w2.val = .loc x2 0) (ho2 : x2.offset = 0)
    (hpay : WLe B1.pay B2.pay) :
    ∀ (t : Ty) (η : TEnv) (ρ : Nat → Nat) (R : Shp) (s1 s2 : Nat) (X : Res),
      B1.tag + s2 = B2.tag + s1 →
      (∀ k S ws Y, ¬ η.rrs k S ws Y) → bh R →
      η.box x1.label = some B1 → η.box x2.label = some B2 → η.sto x1.label = none →
      η.ini x1.label ≤ η.ini x2.label → min (η.ini x1.label) (η.rini x1.label) ≤ η.rini x2.label → (BoxSeen η x2.label B2 ∨ B2.fr ≤ w2.view) →
      VRR ρ η t (vsh s1 R) [w1] X → VRR ρ η t (vsh s2 R) [w2] X := by
  intro t
  induction t with
  | unit | array | share | cap | tok | tok2 | tokE =>
      intro η ρ R s1 s2 X _ _ _ _ _ _ _ _ _ h; simpa only [VRR] using h
  | word2 | epair =>
      intro η ρ R s1 s2 X _ _ _ _ _ _ _ _ _ h
      simp [VRR, h1] at h
  | word r P =>
      intro η ρ R s1 s2 X _ _ _ _ _ _ _ _ _ h
      simp only [VRR] at h ⊢
      obtain ⟨⟨hp, hg⟩, hR⟩ := h
      rcases hR with ⟨hw, _⟩ | ⟨_, hX⟩
      · exfalso; simp [WordHolds, h1] at hw
      · refine ⟨⟨hp, fun hg' => ?_⟩, Or.inr ⟨by simp [WordHolds, h2], hX⟩⟩
        obtain ⟨n, hn, _⟩ := hg hg'
        simp [h1] at hn
  | iall b ih =>
      intro η ρ R s1 s2 X ht hr hR hb1 hb2 hs hi hri hm h
      simp only [VRR] at h ⊢
      exact fun n => ih η (vcons n ρ) R s1 s2 X ht hr hR hb1 hb2 hs hi hri hm (h n)
  | void => intros; simp_all [VRR]
  | opq _ => intro η ρ R s1 s2 X _ _ _ _ _ _ _ _ _ h; simp [VRR, VR, h1] at h
  | int => intro η ρ R s1 s2 X _ _ _ _ _ _ _ _ _ h; simp [VRR, h1] at h
  | tid =>
      intro η ρ R s1 s2 X _ _ _ _ _ hs _ _ _ h
      simp only [VRR, VR] at h
      obtain ⟨⟨l, c, he, hc, -⟩, -⟩ := h
      simp only [List.map_cons, List.map_nil, h1, List.cons.injEq] at he
      have hl : x1.label = l := by cases he.1; rfl
      rw [hl, hc] at hs; cases hs
  | intS => intro η ρ R s1 s2 X _ _ _ _ _ _ _ _ _ h; simp [VRR, h1] at h
  | code => intro η ρ R s1 s2 X _ _ _ _ _ _ _ _ _ h; simp [VRR, h1] at h
  | tvar k =>
      intro η ρ R s1 s2 X _ hr _ _ _ _ _ _ _ h
      simp only [VRR] at h; obtain ⟨_, _, h⟩ := h; exact absurd h (hr _ _ _ _)
  | ptr _ _ =>
      intro η ρ R s1 s2 X _ _ _ _ _ hs _ _ _ h
      simp only [VRR, List.map_cons, List.map_nil, List.cons.injEq, and_true, h1] at h
      obtain ⟨⟨a, c, ha, _, hc, _⟩, _⟩ := h; cases ha; rw [hs] at hc; cases hc
  | ptrOpt _ _ =>
      intro η ρ R s1 s2 X _ _ _ _ _ hs _ _ _ h
      simp only [VRR, List.map_cons, List.map_nil, List.cons.injEq, and_true, h1] at h
      rcases h with ⟨h | ⟨a, c, ha, _, hc, _⟩, _⟩
      · cases h
      · cases ha; rw [hs] at hc; cases hc
  | loc _ _ =>
      intro η ρ R s1 s2 X _ _ _ _ _ hs _ _ _ h
      simp only [VRR, List.map_cons, List.map_nil, List.cons.injEq, and_true, h1] at h
      rcases h with ⟨⟨h, _⟩ | ⟨a, c, _, ha, hc, _⟩, _⟩
      · cases h
      · cases ha; rw [hs] at hc; cases hc
  | fix _ _ =>
      intro η ρ R s1 s2 X _ _ _ _ _ _ _ _ _ h
      simp only [VRR] at h; obtain ⟨⟨_, n, hn, _⟩, _⟩ := h; simp [h1] at hn
  | lanes _ _ =>
      intro η ρ R s1 s2 X _ _ _ _ _ _ _ _ _ h
      simp only [VRR] at h; obtain ⟨⟨_, n, hn⟩, _⟩ := h; simp [h1] at hn
  | refine t ψ ih =>
      intro η ρ R s1 s2 X ht hr hR hb1 hb2 hs hi hri hm h
      simp only [VRR] at h ⊢
      exact ⟨ih η ρ R s1 s2 X ht hr hR hb1 hb2 hs hi hri hm h.1, IniR_ren h1 h2 (TEnv.selIni_le_at η t hi hri) ψ h.2⟩
  | mu b ih =>
      intro η ρ R s1 s2 X ht hr hR hb1 hb2 hs hi hri hm h
      simp only [VRR] at h ⊢
      refine ih _ ρ R s1 s2 X ht ?_ hR hb1 hb2 hs hi hri hm h
      intro k S ws Y hk
      cases k with
      | zero => simp [TEnv.push0, TEnv.ins, TEnv.insR] at hk
      | succ k => exact hr k S ws Y (by simpa [TEnv.push0, TEnv.ins, TEnv.insR] using hk)
  | prod a b _ _ =>
      intro η ρ R s1 s2 X _ _ hR _ _ _ _ _ _ h
      simp only [VRR] at h
      obtain ⟨ra, rb, hr, _⟩ := h
      cases R <;> simp_all [vsh, bh]
  | iex b ih =>
      intro η ρ R s1 s2 X ht hr hR hb1 hb2 hs hi hri hm h
      simp only [VRR] at h ⊢
      obtain ⟨n, rb, w, hrt, hv⟩ := h
      cases R with
      | iex m r0 =>
          simp only [vsh, Shp.iex.injEq] at hrt
          obtain ⟨rfl, rfl⟩ := hrt
          exact ⟨m, vsh s2 r0, w, rfl, ih η _ r0 s1 s2 X ht hr hR hb1 hb2 hs hi hri hm hv⟩
      | _ => simp [vsh] at hrt
  | tex κ b ih =>
      intro η ρ R s1 s2 X ht hr hR hb1 hb2 hs hi hri hm h
      simp only [VRR] at h ⊢
      obtain ⟨n, rb, s, hrt, hc, hk, hv⟩ := h
      cases R with
      | tex m r0 =>
          simp only [vsh, Shp.tex.injEq] at hrt
          obtain ⟨rfl, rfl⟩ := hrt
          refine ⟨m, vsh s2 r0, s, rfl, hc, hk, ih _ ρ r0 s1 s2 X ht ?_ hR hb1 hb2 hs hi hri hm hv⟩
          intro k S ws Y hk
          cases k with
          | zero => simp [TEnv.push0, TEnv.ins, TEnv.insR] at hk
          | succ k => exact hr k S ws Y (by simpa [TEnv.push0, TEnv.ins, TEnv.insR] using hk)
      | _ => simp [vsh] at hrt
  | sum a b iha ihb =>
      intro η ρ R s1 s2 X ht hr hR hb1 hb2 hs hi hri hm h
      simp only [VRR] at h ⊢
      obtain ⟨n, Ra, Rb, hrt, h⟩ := h
      cases R with
      | sum m R0 =>
          simp only [vsh, Shp.sum.injEq] at hrt
          obtain ⟨rfl, rfl⟩ := hrt
          simp only [bh] at hR
          rcases h with ⟨htr, x, s, B, hw, ho, hb, hn, ⟨hsB, hwa⟩, hmo, hA, hB⟩ | ⟨j, p, hd, _, _⟩
          · simp only [List.map_cons, List.map_nil, List.cons.injEq, and_true, h1] at hw
            cases hw
            rw [hb1] at hb; cases hb
            have hn' : s = s1 := by simp at hn; omega
            subst s
            have hpl : B1.pay.length = B2.pay.length := by simpa using congrArg List.length hpay.vals
            refine ⟨_, Ra, Rb, rfl, Or.inl ⟨htr, x2, s2, B2, by simp [h2], ho2, hb2, rfl,
              ⟨by omega, by rw [show B2.tag - s2 = B1.tag - s1 by omega, ← hpl]; exact hwa⟩,
              by rcases hm with hm | hm; exact Or.inl hm; exact Or.inr (by simpa using hm), fun hj => ?_, fun hj => ?_⟩⟩
            · have e : B2.tag - s2 = B1.tag - s1 := by omega
              rw [e] at hj ⊢
              refine ⟨fun hx => iha η ρ (shp Ra) s1 s2 X ht hr (bh_shp Ra hx) hb1 hb2 hs hi hri hm ((hA hj).1 hx),
                fun hx => ?_⟩
              obtain ⟨q, hq, hs1, hw1, hv1, hv⟩ := (hA hj).2 hx
              obtain ⟨q', hq', hw'⟩ := ofArm_wle hpay hq
              exact ⟨q', hq', ShapeC_vals hw'.vals hs1, hw1, Valid_vals _ _ _ hw'.vals hv1, VRR_up _ _ _ _ _ hw' hv⟩
            · have e : B2.tag - s2 = B1.tag - s1 := by omega
              rw [e] at hj ⊢
              refine ⟨fun hx => ihb η ρ (shp Rb) (s1 + (armsOf Ra).length) (s2 + (armsOf Ra).length) X (by omega)
                hr (bh_shp Rb hx) hb1 hb2 hs hi hri hm ((hB hj).1 hx), fun hx => ?_⟩
              obtain ⟨q, hq, hs1, hw1, hv1, hv⟩ := (hB hj).2 hx
              obtain ⟨q', hq', hw'⟩ := ofArm_wle hpay hq
              exact ⟨q', hq', ShapeC_vals hw'.vals hs1, hw1, Valid_vals _ _ _ hw'.vals hv1, VRR_up _ _ _ _ _ hw' hv⟩
          · rw [hR] at hd; simp [decodeArm] at hd
      | _ => simp [vsh] at hrt

/-- (P4) `VR_ren`, resourcefully (coherent view). -/
theorem VRR_ren {η : TEnv} (hc : Coh η) (hcr : CohR η) {ρ : Nat → Nat} {t : Ty} {R : Shp} {s1 s2 : Nat}
    {w1 w2 : Word} {x1 x2 : WeakMem.Address} {B1 B2 : Box} {X : Res}
    (h1 : w1.val = .loc x1 0) (h2 : w2.val = .loc x2 0) (ho2 : x2.offset = 0)
    (hb1 : η.box x1.label = some B1) (hb2 : η.box x2.label = some B2) (hs : η.sto x1.label = none)
    (hi : η.ini x1.label ≤ η.ini x2.label) (ht : B1.tag + s2 = B2.tag + s1) (hpay : WLe B1.pay B2.pay)
    (hm : BoxSeen η x2.label B2 ∨ B2.fr ≤ w2.view) (hR : bh R)
    (h : VRR ρ η t (vsh s1 R) [w1] X) (hri : min (η.ini x1.label) (η.rini x1.label) ≤ η.rini x2.label) :
    VRR ρ η t (vsh s2 R) [w2] X := by
  have c := fun S ws => VRR_close hc hcr ρ t [] 0 ρ ρ S ws X (fun _ => rfl) (fun _ hk => absurd hk (Nat.not_lt_zero _))
  exact (c _ _).2 (VRR_ren0 w1 w2 x1 x2 B1 B2 h1 h2 ho2 hpay _ (CE η) ρ R s1 s2 X ht
    (fun _ _ _ _ h => by simp [CE] at h) hR hb1 hb2 hs hi hri hm ((c _ _).1 h))

/-- (P4) `VR_boxL`, resourcefully: the payload's resources are the reference's. -/
theorem VRR_boxL {ρ : Nat → Nat} {η : TEnv} {a b Ra Rb : Ty} {w : Word} {x : WeakMem.Address} {B : Box}
    {q : List Word} {X : Res} (hS : (Ty.sum Ra Rb).tier = .boxed) (hRa : isBoxed Ra = false)
    (hw : w.val = .loc x 0) (hx : x.offset = 0) (hB : η.box x.label = some B) (hown : BoxSeen η x.label B ∨ B.fr ≤ w.view)
    (hj : B.tag < (armsOf Ra).length) (hq : ofArm Ra B.tag B.pay = some q) (hv : VRR ρ η.unsee a (shp Ra) q X)
    (hs : ShapeC Ra q) (hwc : wc Ra ≠ none) (hvd : Valid Ra q)
    (hwa : ((armsOf (.sum Ra Rb))[B.tag]?).bind wc = some B.pay.length) :
    VRR ρ η (.sum a b) (shp (.sum Ra Rb)) [w] X := by
  refine ⟨_, _, _, rfl, Or.inl ⟨tier_lsum hS, x, 0, B, by simp [hw], hx, hB, wc_boxed hS,
    ⟨Nat.zero_le _, by rw [Nat.sub_zero]; exact armsWc_lnorm hwa⟩,
    hown.imp id (fun h w' hw' => by rw [List.mem_singleton] at hw'; subst hw'; exact h), fun _ => ⟨fun h => ?_, fun _ => ?_⟩, fun h => ?_⟩⟩
  · rw [isBoxed_lnorm] at h; rw [hRa] at h; cases h
  · exact ⟨q, by rw [Nat.sub_zero]; exact ofArm_lnorm hq, ShapeC_wc (wc_lnorm Ra).symm hs,
      by rw [wc_lnorm]; exact hwc, Valid_lnorm _ _ hvd, by rw [shp_lnorm]; exact hv⟩
  · rw [armsOf_lnorm, List.length_map] at h; omega

/-- (P4) `VR_boxR`, resourcefully. -/
theorem VRR_boxR {ρ : Nat → Nat} {η : TEnv} {a b Ra Rb : Ty} {w : Word} {x : WeakMem.Address} {B : Box}
    {q : List Word} {X : Res} (hS : (Ty.sum Ra Rb).tier = .boxed) (hRb : isBoxed Rb = false)
    (hw : w.val = .loc x 0) (hx : x.offset = 0) (hB : η.box x.label = some B) (hown : BoxSeen η x.label B ∨ B.fr ≤ w.view)
    (hj : (armsOf Ra).length ≤ B.tag) (hq : ofArm Rb (B.tag - (armsOf Ra).length) B.pay = some q)
    (hv : VRR ρ η.unsee b (shp Rb) q X) (hs : ShapeC Rb q) (hwc : wc Rb ≠ none) (hvd : Valid Rb q)
    (hwa : ((armsOf (.sum Ra Rb))[B.tag]?).bind wc = some B.pay.length) :
    VRR ρ η (.sum a b) (shp (.sum Ra Rb)) [w] X := by
  refine ⟨_, _, _, rfl, Or.inl ⟨tier_lsum hS, x, 0, B, by simp [hw], hx, hB, wc_boxed hS,
    ⟨Nat.zero_le _, by rw [Nat.sub_zero]; exact armsWc_lnorm hwa⟩,
    hown.imp id (fun h w' hw' => by rw [List.mem_singleton] at hw'; subst hw'; exact h), fun h => ?_, fun _ => ⟨fun h => ?_, fun _ => ?_⟩⟩⟩
  · rw [armsOf_lnorm, List.length_map] at h; omega
  · rw [isBoxed_lnorm] at h; rw [hRb] at h; cases h
  · refine ⟨q, ?_, ShapeC_wc (wc_lnorm Rb).symm hs, by rw [wc_lnorm]; exact hwc, Valid_lnorm _ _ hvd,
      by rw [shp_lnorm]; exact hv⟩
    rw [Nat.sub_zero, armsOf_lnorm, List.length_map]; exact ofArm_lnorm hq

/-- (P4) `VR_boxLB`, resourcefully. -/
theorem VRR_boxLB {ρ : Nat → Nat} {η : TEnv} {a b Ra Rb : Ty} {w : Word} {x : WeakMem.Address} {B : Box}
    {X : Res} (hS : (Ty.sum Ra Rb).tier = .boxed) (hRa : isBoxed Ra = true)
    (hw : w.val = .loc x 0) (hx : x.offset = 0) (hB : η.box x.label = some B) (hown : BoxSeen η x.label B ∨ B.fr ≤ w.view)
    (hj : B.tag < (armsOf Ra).length) (hv : VRR ρ η a (vsh 0 (shp Ra)) [w] X)
    (hwa : ((armsOf (.sum Ra Rb))[B.tag]?).bind wc = some B.pay.length) :
    VRR ρ η (.sum a b) (shp (.sum Ra Rb)) [w] X := by
  refine ⟨_, _, _, rfl, Or.inl ⟨tier_lsum hS, x, 0, B, by simp [hw], hx, hB, wc_boxed hS,
    ⟨Nat.zero_le _, by rw [Nat.sub_zero]; exact armsWc_lnorm hwa⟩,
    hown.imp id (fun h w' hw' => by rw [List.mem_singleton] at hw'; subst hw'; exact h), fun _ => ⟨fun _ => ?_, fun h => ?_⟩, fun h => ?_⟩⟩
  · rw [shp_lnorm]; exact hv
  · rw [isBoxed_lnorm, hRa] at h; cases h
  · rw [armsOf_lnorm, List.length_map] at h; omega

/-- (P4) `VR_boxRB`, resourcefully. -/
theorem VRR_boxRB {ρ : Nat → Nat} {η : TEnv} {a b Ra Rb : Ty} {w : Word} {x : WeakMem.Address} {B : Box}
    {X : Res} (hS : (Ty.sum Ra Rb).tier = .boxed) (hRb : isBoxed Rb = true)
    (hw : w.val = .loc x 0) (hx : x.offset = 0) (hB : η.box x.label = some B) (hown : BoxSeen η x.label B ∨ B.fr ≤ w.view)
    (hj : (armsOf Ra).length ≤ B.tag) (hv : VRR ρ η b (vsh (armsOf Ra).length (shp Rb)) [w] X)
    (hwa : ((armsOf (.sum Ra Rb))[B.tag]?).bind wc = some B.pay.length) :
    VRR ρ η (.sum a b) (shp (.sum Ra Rb)) [w] X := by
  refine ⟨_, _, _, rfl, Or.inl ⟨tier_lsum hS, x, 0, B, by simp [hw], hx, hB, wc_boxed hS,
    ⟨Nat.zero_le _, by rw [Nat.sub_zero]; exact armsWc_lnorm hwa⟩,
    hown.imp id (fun h w' hw' => by rw [List.mem_singleton] at hw'; subst hw'; exact h), fun h => ?_, fun _ => ⟨fun _ => ?_, fun h => ?_⟩⟩⟩
  · rw [armsOf_lnorm, List.length_map] at h; omega
  · rw [shp_lnorm, armsOf_lnorm, List.length_map, Nat.zero_add]; exact hv
  · rw [isBoxed_lnorm, hRb] at h; cases h

/-- (P4) `case_arm_nb`, resourcefully: the payload read back carries the
reference's resources. -/
theorem case_arm_nbR {ρ : Nat → Nat} {η : TEnv} {u ra : Ty} {j : Nat} {pay p1 q : List Word} {X : Res}
    (hc : Coh η) (hcr : CohR η) (hra : isBoxed ra = false) (hsg : sig ra = sig (cl ρ η.wit 0 0 u))
    (hq : ofArm (lnorm ra) j pay = some q) (hs : ShapeC (lnorm ra) q) (hw : wc (lnorm ra) ≠ none)
    (hvd : Valid (lnorm ra) q) (hvr : VRR ρ η.unsee u (shp (lnorm ra)) q X) (hp : WLe pay p1) :
    ∃ q1, ofArm ra j p1 = some q1 ∧ ShapeC ra q1 ∧ wc ra ≠ none ∧ Valid ra q1 ∧ VRR ρ η u (shp ra) q1 X := by
  obtain ⟨q1, hq1, hw1⟩ := ofArm_wle hp hq
  have e := hw1.vals
  have hs1 : ShapeC ra q1 := ShapeC_wc (wc_lnorm ra) (ShapeC_vals e hs)
  have hwc : wc ra ≠ none := by rw [← wc_lnorm]; exact hw
  have hvd1 : Valid (lnorm ra) q1 := Valid_vals _ _ _ e hvd
  have hvrR : VRR ρ η.unsee u (shp ra) q1 X := by rw [← shp_lnorm]; exact VRR_up _ _ _ _ _ hw1 hvr
  have hvr1 : VR ρ η.unsee u (shp ra) q1 := VRR_VR u (RLink_unsee (RLink_of hc hcr)) hvrR
  have hlT : lnorm (cl ρ η.wit 0 0 u) = lnorm ra := by rw [← lnorm_sig (cl ρ η.wit 0 0 u), ← hsg, lnorm_sig]
  have hsT : shp (cl ρ η.wit 0 0 u) = shp ra := by rw [← shp_sig (cl ρ η.wit 0 0 u), ← hsg, shp_sig]
  have c1 := VR_close hc.unsee ρ u [] 0 ρ ρ (shp ra) q1 (fun _ => rfl)
    (fun _ hk => absurd hk (Nat.not_lt_zero _))
  have hvT : VR ρ (CE η.unsee) (cl ρ η.wit 0 0 u) (shp (cl ρ η.wit 0 0 u)) q1 := by
    rw [hsT]; exact c1.1 hvr1
  have hV := Valid_of_VR _ (CE η.unsee) ρ q1 (fun _ _ _ h => h) (by rw [hlT]; exact hvd1) hvT
  have hVr : Valid ra q1 := Valid_of_sig hsg.symm hV
  refine ⟨q1, ofArm_back hq1 ?_, hs1, hwc, hVr, VRR_seen hc hcr hvrR⟩
  intro x w hx hk hp1 hnl
  subst hp1
  exact null_arm hVr hs1 hra hx hk hq1 hnl

/-- (P4) `MemHeld_tr`, needing the latest words only at Σ's labels. -/
theorem MemHeld_trS {E E' : TEnv} {s s' : St} {H : Res} (h : MemHeld E s H)
    (hsto : ∀ l, E'.sto l = E.sto l) (hini : ∀ l, E'.ini l = E.ini l)
    (hlat : ∀ l c, E.sto l = some c → ∀ o w, LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w →
      LatestNP s'.mem (PromAt E s' ⟨l, o⟩) ⟨l, o⟩ w)
    (hv : ∀ {T : Ty} {vs : List Word} {R : Res}, ValOfR E T vs R → ValOfR E' T vs R)
    (htid : E'.tid = E.tid := by first | rfl | assumption)
    (hpf : ∀ l, E'.pfr l = E.pfr l := by first | exact fun _ => rfl | assumption)
    (hfp : E'.fp = E.fp := by first | rfl | assumption)
    (hri : ∀ l, E'.rini l = E.rini l := by first | exact fun _ => rfl | assumption) :
    MemHeld E' s' H := by
  obtain ⟨L, Rl, hnd, hcov, rfl, hent⟩ := h
  refine ⟨L, Rl, hnd, fun l c hc => hcov l c (by rw [← hsto l]; exact hc), rfl, fun l hl => ?_⟩
  obtain ⟨h0, h1⟩ := hent l hl
  refine ⟨fun hn => h0 (by rw [← hsto l]; exact hn), fun c hc => ?_⟩
  have hc' : E.sto l = some c := by rw [← hsto l]; exact hc
  obtain ⟨vals, hL, hC⟩ := h1 c hc'
  refine ⟨vals, fun o w hw => by
    rw [PromAt_congr (a := ⟨l, o⟩) (hsto l) htid (hpf l) hfp (hini l) (TEnv.rc_congr (hini l) (hri l))]
    exact hlat l c hc' o w (hL o w hw), ?_⟩
  rw [hini l]
  rcases hC with ⟨h1, h2⟩ | ⟨N, e, us, Rs, hT, hu, hn, hl, hRs, hR, hj⟩
  · exact Or.inl ⟨h1, hv h2⟩
  · exact Or.inr ⟨N, e, us, Rs, hT, hu, hn, hl, hRs, hR, fun j Rj h1 h2 => slotR_imp (hj j Rj h1 h2) (TEnv.rc_congr (hini l) (hri l)) hv⟩

/-- **(P4) A box allocation keeps memory's holding**: the fresh label is
outside Σ, so every Σ cell's latest words survive (`LatestNP_growsAt`), the
promises are unchanged, and the view only gains the new ghost box. -/
theorem MemHeld_box {g : G} {E : TEnv} {s : St} {H : Res} {us : List Acc} {ws : List Word} {r : St × Word}
    (hm : MemInv g E s) (hH : MemHeld E s H)
    (hr : r ∈ alloc g.k g.arch (freshLabel g.lbase g.n g.i s.nalloc) us ws s) (B : Box) :
    MemHeld (boxE E (freshLabel g.lbase g.n g.i s.nalloc) B) (if g.boxFence then fenceS r.1 .st else r.1) H := by
  have hnone := (hm.2.2.2.1.1 s.nalloc (Nat.le_refl _)).1
  obtain ⟨hg, hsub, -, -, hful⟩ := alloc_growsP hm.2.2.1 r hr
  have hbnone : E.box (freshLabel g.lbase g.n g.i s.nalloc) = none := hm.2.2.2.2.2.2.2.2.2.1.1 s.nalloc (Nat.le_refl _)
  have key : MemHeld (boxE E (freshLabel g.lbase g.n g.i s.nalloc) B) r.1 H :=
    MemHeld_trS hH (fun _ => rfl) (fun _ => rfl)
      (fun l c hc o w hw => LatestNP_growsAtF hg (fun t h => hsub.subset h) hful (fun e => by rw [e, hnone] at hc; cases hc) hw)
      (fun h => ValOfR_mono (η₁ := E) (η₂ := boxE E (freshLabel g.lbase g.n g.i s.nalloc) B) rfl rfl (fun _ _ h => h) (fun _ => Nat.le_refl _) h (hB := fun l B' h' => by
        have hne : l ≠ freshLabel g.lbase g.n g.i s.nalloc := fun e => by rw [e, hbnone] at h'; cases h'
        simp only [boxE, hne, ↓reduceIte]; exact h'))
  split
  · exact MemHeld_eqs key rfl rfl
  · exact key

/-- (S8b) Memory's holding survives seeing a label outside Σ (no frontier
yet): it reads frontiers only at Σ cells. -/
theorem MemHeld_seeE {E : TEnv} {s : St} {H : Res} {lbl : AllocLabel} {F : Ts} (h : MemHeld E s H)
    (hsto : E.sto lbl = none) (hpf : E.pfr lbl = none) : MemHeld (seeE E lbl F) s H := by
  obtain ⟨L, Rl, hnd, hcov, rfl, hent⟩ := h
  refine ⟨L, Rl, hnd, hcov, rfl, fun l hl => ?_⟩
  obtain ⟨h0, h1⟩ := hent l hl
  refine ⟨h0, fun c hc => ?_⟩
  obtain ⟨vals, hL, hC⟩ := h1 c hc
  have hne : l ≠ lbl := fun e => by
    have hc' : E.sto l = some c := hc
    rw [e, hsto] at hc'; cases hc'
  have hv : ∀ {T : Ty} {vs : List Word} {R : Res}, ValOfR E T vs R → ValOfR (seeE E lbl F) T vs R :=
    fun h => ValOfR_mono (η₁ := E) (η₂ := seeE E lbl F) rfl rfl (fun _ _ h => h) (fun _ => Nat.le_refl _) h
      (hP := fun l' f h' => by
        by_cases e : l' = lbl
        · rw [e, hpf] at h'; cases h'
        · simp only [seeE, e, ↓reduceIte]; exact h')
  refine ⟨vals, fun o w hw => by
    rw [PromAt_congr (E' := seeE E lbl F) (E := E) (a := ⟨l, o⟩) rfl rfl (by simp [seeE, hne])]
    exact hL o w hw, ?_⟩
  rcases hC with ⟨h1, h2⟩ | ⟨N, e, us, Rs, hT, hu, hn, hl, hRs, hR, hj⟩
  · exact Or.inl ⟨h1, hv h2⟩
  · exact Or.inr ⟨N, e, us, Rs, hT, hu, hn, hl, hRs, hR, fun j Rj h1 h2 => slotR_imp (hj j Rj h1 h2) rfl hv⟩


/-- (H, pins) `MemHeld_trS` along the lists (they are kept). -/
theorem MemHeldL_trS {E E' : TEnv} {s s' : St} {H : Res} {S : AllocLabel → List Res} (h : MemHeldL E s H S)
    (hsto : ∀ l, E'.sto l = E.sto l) (hini : ∀ l, E'.ini l = E.ini l)
    (hlat : ∀ l c, E.sto l = some c → ∀ o w, LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w →
      LatestNP s'.mem (PromAt E s' ⟨l, o⟩) ⟨l, o⟩ w)
    (hv : ∀ {T : Ty} {vs : List Word} {R : Res}, ValOfR E T vs R → ValOfR E' T vs R)
    (htid : E'.tid = E.tid := by first | rfl | assumption)
    (hpf : ∀ l, E'.pfr l = E.pfr l := by first | exact fun _ => rfl | assumption)
    (hfp : E'.fp = E.fp := by first | rfl | assumption)
    (hri : ∀ l, E'.rini l = E.rini l := by first | exact fun _ => rfl | assumption) :
    MemHeldL E' s' H S := by
  obtain ⟨L, hnd, hcov, hoff, rfl, hent⟩ := h
  refine ⟨L, hnd, fun l c hc => hcov l c (by rw [← hsto l]; exact hc), hoff, rfl, fun l hl => ?_⟩
  obtain ⟨h0, h1⟩ := hent l hl
  refine ⟨fun hn => h0 (by rw [← hsto l]; exact hn), fun c hc => ?_⟩
  have hc' : E.sto l = some c := by rw [← hsto l]; exact hc
  obtain ⟨vals, hL, hC⟩ := h1 c hc'
  refine ⟨vals, fun o w hw => by
    rw [PromAt_congr (a := ⟨l, o⟩) (hsto l) htid (hpf l) hfp (hini l) (TEnv.rc_congr (hini l) (hri l))]
    exact hlat l c hc' o w (hL o w hw), ?_⟩
  rw [hini l, TEnv.rc_congr (hini l) (hri l)]
  rcases hC with ⟨hw, R, hR, hRs⟩ | ⟨N, e, us, hT, hu, hn, hl, hRs, hj⟩
  · exact Or.inl ⟨hw, R, hv hR, hRs⟩
  · exact Or.inr ⟨N, e, us, hT, hu, hn, hl, hRs, fun j Rj q1 q2 => slotR_imp (hj j Rj q1 q2) rfl hv⟩
#print axioms MemHeldL_trS

/-- (H, pins) `MemHeld_box` along the lists. -/
theorem MemHeldL_box {g : G} {E : TEnv} {s : St} {H : Res} {S : AllocLabel → List Res} {us : List Acc}
    {ws : List Word} {r : St × Word}
    (hm : MemInv g E s) (hH : MemHeldL E s H S)
    (hr : r ∈ alloc g.k g.arch (freshLabel g.lbase g.n g.i s.nalloc) us ws s) (B : Box) :
    MemHeldL (boxE E (freshLabel g.lbase g.n g.i s.nalloc) B) (if g.boxFence then fenceS r.1 .st else r.1) H S := by
