/-- (P4) The cell of a `pub` pointer to a one-word type, for a `cas` (the cell
half of `casCell_core`). -/
theorem plainCellPtr {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {K : TEnv → List Word → Prop}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {acq rel : Bool} {w : At} {u : Ty}
    (hpk : cx.peek w = .ok (.ptr .pub u)) (hone : u.rawWords = some 1) (ho : cx.opaqueOK u = true)
    (hi : FInv ρ η th.σs K cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (nw : Word) (hval : EnvVal (CE η) (cl ρ η.wit 0 0 u) [nw]) : CasCell g mem pairs th η acq rel w nw := by
  obtain ⟨lab, c, pw, ru, f, hea, hpw, hsto, hcty, hf, -, -, -, -⟩ := pubPtr_view hi hpk htv ho
  have hlr : accs ru = accs (cl ρ η.wit 0 0 u) :=
    pub_accs hi.2.2.2.1 hi.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi.2.1 htv hpk rfl ho hea rfl
  have hus : accs ru = some [.one] := by rw [hlr]; exact accs_cl_one hone
  have husc : accs c.ty = some [.one] := by rw [(Fd_lay hcty).2.2.1]; exact accs_cl_one hone
  obtain ⟨ru', pw', lab', us', hea', hpw', hus', -, hne, hld, hstw⟩ :=
    loadPub_core (acq := acq) (g := g) (mem := mem) (pairs := pairs) hpk ho hi hE htv hm
  have e1 := Option.some.inj (hea.symm.trans hea')
  simp only [Prod.mk.injEq, List.cons.injEq, and_true, Ty.ptr.injEq, true_and] at e1
  obtain ⟨rfl, rfl⟩ := e1
  obtain rfl : lab = lab' := by
    rw [hpw] at hpw'; simp only [Val.loc.injEq, WeakMem.Address.mk.injEq] at hpw'; exact hpw'.1.1
  obtain rfl : us' = [.one] := Option.some.inj (hus'.symm.trans hus)
  refine ⟨⟨lab, 0⟩, pw, _, hea, by simp [addrOf, hpw], hne, fun s1 ws hl hp => ⟨(hld s1 ws hl hp).2.2,
    fun s1' hm1' s2 hs2 => ?_⟩⟩
  have hval' := (Fd_EnvVal (CE η) hcty).2 hval
  by_cases hown : c.owner = some η.tid
  · exact MemInv_storeF hm1' hsto hown husc hval' rfl s2 hs2
  · have hna : ∀ N e, c.ty ≠ .array (.lit N) e := fun N e he => by rw [he] at husc; simp [accs] at husc
    exact MemInv_storePubAt (a := ⟨lab, 0⟩) hm1' hsto hown hf (.here (Or.inl (by rw [husc]; simp)))
      (IniAt_of_ne fun N e he => hna N e he) hna hval' husc rfl s2 hs2

/-- (P4) The target of a reference to a one-word non-affine component: the
component's position, layout, and deep word-freeness (`dwf`, from
non-affinity: a word is affine). -/
theorem plainTarget {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {K : TEnv → List Word → Prop} {p : Prog}
    {cx : Cx} {env : Env} {w : At} {tw u : Ty} {μ : Mode}
    (hi : FInv ρ η σs K cx env) (hE : EnvOK p η) (hpk : cx.peek w = .ok tw)
    (hc : cellOf tw = some (μ, u)) (hone : u.rawWords = some 1) (haff : affine cx.ke u = false)
    (htb : tb cx.ke.length u = true) :
    ∃ rt pw ad c, evalAt env w = some (rt, [pw]) ∧ pw.val = .loc ad 0 ∧ η.sto ad.label = some c ∧
      AtOff c.ty ad.offset (cl ρ η.wit 0 0 u) ∧ IniAt η.ini c ad (cl ρ η.wit 0 0 u) ∧
      dwf (cl ρ η.wit 0 0 u) = true := by
  have hus : accs (cl ρ η.wit 0 0 u) = some [.one] := accs_cl_one hone
  obtain ⟨rt, ws, hea, hv, -⟩ := peek_VR hi.2.1 hpk
  obtain ⟨ad, c, hws, hsto, hat, -, hini⟩ := cell_target hc (Fd_noarr (by rw [hus]; simp)) hv
  obtain ⟨pw, rfl, hpw⟩ := map_singleton hws
  exact ⟨rt, pw, ad, c, hea, hpw, hsto, hat, (IniAt_mono (modeIni_le_ini _ _ _) hini), dwf_of_affine _ []
    (AffineCl.affine_cl0 ρ η.wit cx.ke (fun k => (hE.2.1 k).1) (fun k _ hk => hi.2.2.2.2.2.2.2.2.1 k hk) u haff htb)⟩

/-- (N2) A one-word list of a defined value starts with a defined word. -/
theorem single_nundef {ws : List Word} {v : WeakMem.Val} (h : ws.map (·.val) = [v])
    (hv : v ≠ .undef) {w : Word} (hw : ws[0]? = some w) : w.val ≠ .undef := by
  obtain ⟨w0, rfl, e⟩ := map_singleton h
  simp only [List.getElem?_cons_zero, Option.some.injEq] at hw
  subst hw; rw [e]; exact hv

/-- (N2) A one-unit existential's units: its body's, or one word. -/
theorem accs_iex_one {t : Ty} (h : accs (.iex t) = some [.one]) :
    accs t = some [.one] ∨ (Ty.iex t).rawWords = some 1 := by
  by_cases hc : t.countI 0 ≥ 2
  · cases hr : (Ty.iex t).rawWords with
    | none => left; simpa [accs, hc, hr] using h
    | some k =>
        match k, hr with
        | 0, hr => simp [accs, hc, hr] at h
        | 1, hr => right; rfl
        | 2, hr => simp [accs, hc, hr] at h
        | k + 3, hr => left; simpa [accs, hc, hr] using h
  · left; simpa [accs, hc] using h

/-- (N2) A one-unit type existential's units: its body's, or one word. -/
theorem accs_tex_one {κ : Kind} {t : Ty} (h : accs (.tex κ t) = some [.one]) :
    accs t = some [.one] ∨ (Ty.tex κ t).rawWords = some 1 := by
  by_cases hc : t.countT 0 ≥ 2
  · cases hr : (Ty.tex κ t).rawWords with
    | none => left; simpa [accs, hc, hr] using h
    | some k =>
        match k, hr with
        | 0, hr => simp [accs, hc, hr] at h
        | 1, hr => right; rfl
        | 2, hr => simp [accs, hc, hr] at h
        | k + 3, hr => left; simpa [accs, hc, hr] using h
  · left; simpa [accs, hc] using h

theorem nWords_one_eq {us : List Acc} (h : nWords us = 1) : us = [.one] := by
  match us, h with
  | [], h => simp [nWords] at h
  | [.one], _ => rfl
  | .one :: u :: us, h => cases u <;> simp [nWords, Acc.size] at h <;> omega
  | .two :: us, h => simp [nWords, Acc.size] at h <;> omega

/-- (N2) A decoded sum's first word is defined. -/
theorem decodeArm_head0 {tr : Tier} {as : List Ty} {ws : List Word} {r : Nat × List Word}
    (h : decodeArm tr as ws = some r) {w : Word} (hw : ws[0]? = some w) : w.val ≠ .undef := by
  unfold decodeArm at h
  split at h
  · simp only [List.getElem?_cons_zero, Option.some.injEq] at hw
    subst hw
    split at h <;> simp_all
  · simp only [List.getElem?_cons_zero, Option.some.injEq] at hw
    subst hw
    split at h <;> simp_all
  · cases h

/-- **(N2) A value of a one-word type is not `undef`** (the one-word case of
`TermTyped.VR_one_nundef`, here for the `cas` expected word; a duplicate because
`TermTyped`, which needs `TermFul.OneAt`, comes after this file). -/
theorem VR_word1_nundef : ∀ (T : Ty) {ρ : Nat → Nat} {η : TEnv} {ws : List Word} {w : Word},
    VR ρ η T (shp T) ws → accs T = some [.one] → ws[0]? = some w → w.val ≠ .undef := by
  intro T
  induction T with
  | unit | void | share _ | cap _ _ | tok _ _ | tok2 _ _ _ _ | tokE _ _ _ =>
      intro ρ η ws w _ hus; simp [accs] at hus
  | word2 _ _ | epair _ _ =>
      intro ρ η ws w _ hus; simp [accs] at hus
  | array _ _ _ | tvar _ =>
      intro ρ η ws w _ hus; simp [accs] at hus
  | opq _ =>
      intro ρ η ws w hv _ hw
      simp only [VR] at hv
      obtain ⟨n, hn⟩ := hv
      exact single_nundef hn (by simp) hw
  | int =>
      intro ρ η ws w hv _ hw
      simp only [VR] at hv
      obtain ⟨n, hn⟩ := hv
      exact single_nundef hn (by simp) hw
  | tid =>
      intro ρ η ws w hv _ hw
      simp only [VR] at hv
      obtain ⟨l, c, hn, -⟩ := hv
      exact single_nundef hn (by simp) hw
  | intS _ =>
      intro ρ η ws w hv _ hw
      simp only [VR] at hv
      exact single_nundef hv (by simp) hw
  | fix _ _ =>
      intro ρ η ws w hv _ hw
      simp only [VR] at hv
      obtain ⟨-, n, hn, -⟩ := hv
      exact single_nundef hn (by simp) hw
  | lanes _ _ =>
      intro ρ η ws w hv _ hw
      simp only [VR] at hv
      obtain ⟨-, n, hn⟩ := hv
      exact single_nundef hn (by simp) hw
  | code _ _ _ _ =>
      intro ρ η ws w hv _ hw
      simp only [VR] at hv
      obtain ⟨i, d, hn, -⟩ := hv
      exact single_nundef hn (by simp) hw
  | ptr _ _ _ =>
      intro ρ η ws w hv _ hw
      simp only [VR] at hv
      obtain ⟨a, c, hn, -⟩ := hv
      exact single_nundef hn (by simp) hw
  | ptrOpt _ _ _ =>
      intro ρ η ws w hv _ hw
      simp only [VR] at hv
      rcases hv with hn | ⟨a, c, hn, -⟩
      · exact single_nundef hn (by simp) hw
      · exact single_nundef hn (by simp) hw
  | loc _ _ _ =>
      intro ρ η ws w hv _ hw
      simp only [VR] at hv
      rcases hv with ⟨hn, -⟩ | ⟨a, c, U, hn, -⟩
      · exact single_nundef hn (by simp) hw
      · exact single_nundef hn (by simp) hw
  | word _ P =>
      intro ρ η ws w hv hus hw
      simp only [VR] at hv
      cases hg : P.ghost
      · obtain ⟨n, hn, -⟩ := hv.2 hg
        exact single_nundef hn (by simp) hw
      · simp [accs, hg] at hus
  | refine t _ ih =>
      intro ρ η ws w hv hus hw
      simp only [VR, shp] at hv
      simp only [accs] at hus
      exact ih hv.1 hus hw
  | mu t ih =>
      intro ρ η ws w hv hus hw
      simp only [VR, shp] at hv
      simp only [accs] at hus
      exact ih hv hus hw
  | iall t ih =>
      intro ρ η ws w hv hus hw
      simp only [VR, shp] at hv
      simp only [accs] at hus
      exact ih (hv 0) hus hw
  | iex t ih =>
      intro ρ η ws w hv hus hw
      simp only [VR, shp] at hv
      obtain ⟨n, rb, w', e, hv⟩ := hv
      simp only [Shp.iex.injEq] at e
      obtain ⟨-, rfl⟩ := e
      rcases accs_iex_one hus with h | hr
      · exact ih hv h hw
      · obtain ⟨ut, hut, hn⟩ := accs_inner (rawWords_iex_inner hr)
        rw [nWords_one_eq hn] at hut
        exact ih hv hut hw
  | tex κ t ih =>
      intro ρ η ws w hv hus hw
      simp only [VR, shp] at hv
      obtain ⟨n, rb, s, e, -, -, hv⟩ := hv
      simp only [Shp.tex.injEq] at e
      obtain ⟨-, rfl⟩ := e
      rcases accs_tex_one hus with h | hr
      · exact ih hv h hw
      · obtain ⟨ut, hut, hn⟩ := accs_inner (rawWords_tex_inner hr)
        rw [nWords_one_eq hn] at hut
        exact ih hv hut hw
  | prod a b iha ihb =>
      intro ρ η ws w hv hus hw
      simp only [VR, shp] at hv
      obtain ⟨ra, rb, e, hsp⟩ := hv
      simp only [Shp.prod.injEq] at e
      obtain ⟨rfl, rfl⟩ := e
      cases ha : accs a with
      | none => simp [accs, ha] at hus
      | some ua =>
      cases hb : accs b with
      | none => simp [accs, ha, hb] at hus
      | some ub =>
      simp [accs, ha, hb] at hus
      obtain ⟨-, hva, hvb⟩ := hsp (nWords ua) (by rw [shp_wc]; simp [wc, ha])
      match ua, ub, hus with
      | [], [.one], _ =>
          exact ihb hvb hb (by simpa [nWords] using hw)
      | [.one], [], _ =>
          exact iha hva ha (by simpa [nWords, Acc.size] using hw)
  | sum a b _ _ =>
      intro ρ η ws w hv _ hw
      simp only [VR] at hv
      obtain ⟨n, Ra, Rb, -, hb | ⟨jj, pp, hdec, -⟩⟩ := hv
      · obtain ⟨-, x, s, B, hmap, -⟩ := hb
        exact single_nundef hmap (by simp) hw
      · exact decodeArm_head0 hdec hw

