/-- (G1) `tstepM_newBuf` from `tstepM_newBufA`. -/
theorem tstepM_newBuf {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {n : At} {τ : Ty} {e : Expr}
    (hterm : th.term = .let_ x (.newBuf n τ) e) (hniA : noIallV τ = true) (hP : ProgT p)
    (hn : 0 < g.n)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 :=
  (tstepM_newBufA (hterm := hterm) (hniA := hniA) (hP := hP) (hn := hn) (hT := hT) (hi := hi) (hE := hE) (htv := htv) (hm := hm) (hRP := hRP) (hPS := hPS)).imp id
    fun h r hr => (h r hr).toF

/-! ## §13 Publication (D3 M3)

`publish` runs `dmb ishst` (`fenceS .st`: `vRelSt := max vRelSt vWr`) and
re-types the reference `pub`.  The ghost moves with it: the cell's frontier
becomes the publisher's `vWr` (`pubP`; a cell published before keeps its
frontier), and the publisher has seen the cell (`pubS`), so its `pub`
reference needs no view on its word.  `SeenLE` holds at the new `vRelSt`; a
cell published before was seen already (`OwnPub`). -/

/-- The frontier map after publishing `l` at `V`. -/
def pubP (η : TEnv) (l : AllocLabel) (V : Ts) : AllocLabel → Option Ts :=
  fun l' => if l' = l then some ((η.pfr l).getD V) else η.pfr l'

/-- The seen set after publishing `l`. -/
def pubS (η : TEnv) (l : AllocLabel) : AllocLabel → Prop := fun l' => l' = l ∨ η.seen l'

theorem pubP_mono (η : TEnv) (l : AllocLabel) (V : Ts) :
    ∀ l' f, η.pfr l' = some f → pubP η l V l' = some f := by
  intro l' f h
  simp only [pubP]
  split
  · next he => rw [he] at h; simp [h]
  · exact h

theorem pubP_ne {η : TEnv} {l l' : AllocLabel} {V : Ts} (h : l' ≠ l) : pubP η l V l' = η.pfr l' := by
  simp [pubP, h]

/-- A release fence keeps `MemInv`: it only raises `vRelSt`. -/
theorem MemInv_fence {g : G} {E : TEnv} {s : St} (hm : MemInv g E s) : MemInv g E (fenceS s .st) := by
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11⟩ := hm
  exact ⟨h1, h2, h3, h4, SeenLE.mono h5 (show s.vs.vRelSt ≤ max s.vs.vRelSt s.vs.vWr from Nat.le_max_left _ _),
    h6, h7, h8, h9, h10, h11⟩


/-- (T3c-5d) `E` with a new box at `lbl`. -/
def boxE (E : TEnv) (lbl : AllocLabel) (B : Box) : TEnv :=
  { E with box := fun l => if l = lbl then some B else E.box l }

/-- (S4) `storeUnits_memOK0` with own promises skipped. -/
theorem storeUnits_memOKP0 {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool}
    {η : TEnv} (hc : η.sto a.label = none) :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s : St),
      MemOKP η s.mem s.pairs s.promises → ∀ s', s' ∈ storeUnits k arch pw a rel us ws i s →
        MemOKP η s'.mem s'.pairs s'.promises
  | [], _, _, s, hm, s', hs => by
      simp only [storeUnits, List.mem_singleton] at hs; subst hs; exact hm
  | .one :: us, w :: ws, i, s, hm, s', hs => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      obtain ⟨t, hcase, _, -, -⟩ := stepStore_casesC hst
      have hm' : MemOKP η mem' s.pairs th.promises := by
        rcases hcase with ⟨rfl, _, hprom⟩ | ⟨rfl, _, hprom, _, m, hmt, hma, -, -⟩
        · rw [hprom]
          refine MemOKP_push hm _ fun c' hc' => ?_
          simp only [offs] at hc'
          rw [hc] at hc'; cases hc'
        · rw [hprom]
          obtain ⟨h1, h2, h3⟩ := hm
          refine ⟨fun t' m' c' hP ht hc' => ?_, h2, h3⟩
          by_cases e : t' = t
          · subst e
            rw [hmt] at ht; cases ht
            have hc2 : η.sto a.label = some c' := by rw [hma] at hc'; exact hc'
            rw [hc] at hc2; cases hc2
          · exact h1 t' m' c' (fun h => hP ((List.mem_erase_of_ne e).2 h)) ht hc'
      exact storeUnits_memOKP0 hc us ws (i + 1) _ hm' s' hs
  | .two :: us, w0 :: w1 :: ws, i, s, hm, s', hs => by
      simp only [storeUnits] at hs
      obtain ⟨q1, q2, -, q4, -⟩ := stepStorePair_eq s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0)
        (dataE 2 w1) [0] rel
      refine storeUnits_memOKP0 hc us ws (i + 2) _ ?_ s' hs
      show MemOKP η (Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel).1
        (Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel).2.1
        (Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel).2.2.promises
      rw [q1, q2, q4]
      refine MemOKP_pushPair hm (offs a i) _ _ _ fun c' hc' => ?_
      simp only [offs] at hc'
      rw [hc] at hc'; cases hc'
  | .one :: _, [], _, _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [], _, _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, _, s', hs => by simp [storeUnits] at hs

/-- (S4) **An allocation outside Σ** (a box), own promises skipped: Σ's
invariants survive. -/
theorem alloc_ok0P {k : Promises.Knobs} {arch : Arch} {lbl : AllocLabel} {us : List Acc} {ws : List Word}
    {s : St} {η : TEnv} (hnone : η.sto lbl = none) (hpl : PromLt s) (hnd : s.promises.Nodup)
    (hm : MemOKP η s.mem s.pairs s.promises) (ho : OwnOKPF η s.mem s.pairs s.vs s.promises) :
    ∀ r, r ∈ alloc k arch lbl us ws s →
      MemOKP η r.1.mem r.1.pairs r.1.promises ∧ OwnOKPF η r.1.mem r.1.pairs r.1.vs r.1.promises ∧
        r.2 = cst (.loc ⟨lbl, 0⟩ 0) := by
  intro r hr
  obtain ⟨s1, hs, hr2, e4, e2, -, -, -, -, -, esz, eget⟩ := alloc_unf hr
  have hold : ∀ t, t < s.mem.size → s1.mem[t]? = s.mem[t]? := fun t ht => by rw [eget t]; simp [ht]
  have hM1 : MemOKP η s1.mem s1.pairs s1.promises := by
    obtain ⟨h1, h2, h3⟩ := hm
    rw [e2, e4]
    refine ⟨fun t m c hP ht hc => ?_, fun t m0 m1 c hp h0 h1' hc => ?_, fun t hp => ?_⟩
    · rw [eget t] at ht
      by_cases hlt : t < s.mem.size
      · simp only [hlt, ite_true] at ht
        exact h1 t m c hP ht hc
      · simp only [hlt, ite_false] at ht
        split at ht
        · simp only [Option.some.injEq] at ht; subst ht; exact Or.inl rfl
        · cases ht
    · have hl := h3 t hp
      rw [hold t (Nat.lt_of_succ_lt hl)] at h0
      rw [hold (t + 1) hl] at h1'
      exact h2 t m0 m1 c hp h0 h1' hc
    · rw [esz]; exact Nat.lt_of_lt_of_le (h3 t hp) (Nat.le_add_right _ _)
  refine ⟨storeUnits_memOKP0 (a := ⟨lbl, 0⟩) hnone us ws 0 s1 hM1 r.1 hs, fun l c hc hown => ?_, hr2⟩
  have hl : l ≠ lbl := fun e => by rw [e, hnone] at hc; cases hc
  exact OwnCellF_alloc (ho l c hc hown) hl id rfl rfl rfl hpl hm.2.2 r hr

/-- (S4) An allocation only raises `vWr`. -/
theorem alloc_wrP {k : Promises.Knobs} {arch : Arch} {lbl : AllocLabel} {us : List Acc} {ws : List Word}
    {s : St} : ∀ r, r ∈ alloc k arch lbl us ws s → s.vs.vWr ≤ r.1.vs.vWr := by
  intro r hr
  obtain ⟨s1, hs, -, -, -, -, -, e7, -, -, -, -⟩ := alloc_unf hr
  have g1 := storeUnits_wrF us ws 0 s1 r.1 hs
  rw [e7] at g1; exact Nat.le_trans (Nat.le_max_left _ _) g1

/-- (B4) A store only raises `vWr`. -/
theorem storeUnits_vWr_mono {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s s' : St), s' ∈ storeUnits k arch pw a rel us ws i s →
      s.vs.vWr ≤ s'.vs.vWr
  | [], _, _, s, s', hs => by
      simp only [storeUnits, List.mem_singleton] at hs; subst hs; exact Nat.le_refl _
  | .one :: us, w :: ws, i, s, s', hs => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      obtain ⟨t, -, -, -, hwr⟩ := stepStore_casesC hst
      refine Nat.le_trans ?_ (storeUnits_vWr_mono us ws (i + 1) _ s' hs)
      show s.vs.vWr ≤ th.vs.vWr
      rw [hwr]; exact Nat.le_max_left _ _
  | .two :: us, w0 :: w1 :: ws, i, s, s', hs => by
      simp only [storeUnits] at hs
      have q6 := stepStorePair_vWr s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel
      generalize Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel = R at q6 hs
      obtain ⟨mem', pairs', th⟩ := R
      simp only at q6 hs
      refine Nat.le_trans ?_ (storeUnits_vWr_mono us ws (i + 2) _ s' hs)
      show s.vs.vWr ≤ th.vs.vWr
      rw [q6]; exact Nat.le_max_left _ _
  | .one :: _, [], _, _, _, hs => by simp [storeUnits] at hs
  | .two :: _, [], _, _, _, hs => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, _, hs => by simp [storeUnits] at hs

/-- (B4) After an allocation `vWr` reaches the old memory size less one: the
new words lie at the old size and above, and `alloc` raises `vWr` to the last. -/
theorem alloc_size_fr {k : Promises.Knobs} {arch : Arch} {lbl : AllocLabel} {us : List Acc} {ws : List Word}
    {s : St} {r : St × Word} (hr : r ∈ alloc k arch lbl us ws s) : s.mem.size ≤ r.1.vs.vWr + 1 := by
  obtain ⟨s1, hs, -, -, -, -, -, e7, -⟩ := alloc_unf hr
  have h1 := storeUnits_vWr_mono us ws 0 s1 r.1 hs
  rw [e7] at h1
  have h2 : s.mem.size + nWords us - 1 ≤ r.1.vs.vWr := Nat.le_trans (Nat.le_max_right _ _) h1
  omega

/-- (B4, box L1 prep) A box allocation's `vWr` reaches the old memory size plus
the payload length: the tag word and the payload lie at the old size and above. -/
theorem alloc_size_len {k : Promises.Knobs} {arch : Arch} {lbl : AllocLabel} {us : List Acc} {w : Word}
    {p : List Word} {s : St} {r : St × Word} (f : Word → Word)
    (hr : r ∈ alloc k arch lbl (.one :: us) (w :: p) s) (hlen : p.length = nWords us) :
    s.mem.size + (p.map f).length ≤ r.1.vs.vWr := by
  obtain ⟨s1, hs, -, -, -, -, -, e7, -⟩ := alloc_unf hr
  have h1 := storeUnits_vWr_mono _ _ 0 s1 r.1 hs
  rw [e7] at h1
  have h2 : s.mem.size + nWords (.one :: us) - 1 ≤ r.1.vs.vWr := Nat.le_trans (Nat.le_max_right _ _) h1
  have h3 : nWords (.one :: us) = 1 + nWords us := by simp [nWords, Acc.size]
  rw [List.length_map, hlen]
  omega

/-- (S8b) After an allocation, every word of the new block has coherence at
most `vWr`: the box frontier `B.fr` covers the box's words. -/
theorem alloc_coh_le_vWr {k : Promises.Knobs} {arch : Arch} {lbl : AllocLabel} {us : List Acc} {ws : List Word}
    {s : St} : ∀ r, r ∈ alloc k arch lbl us ws s → ∀ o, o < nWords us → r.1.vs.coh ⟨lbl, o⟩ ≤ r.1.vs.vWr := by
  intro r hr o ho
  obtain ⟨s1, hs, -, -, -, -, -, e7, -, ec0, -, -⟩ := alloc_unf hr
  refine storeUnits_cohWr ⟨lbl, o⟩ us ws 0 s1 r.1 hs ?_
  rw [ec0 o ho, e7]
  exact Nat.le_trans (by omega) (Nat.le_max_right _ _)

/-- (S4) `PromAbove` after an allocation holds before it: coherence only moves
to the new words, past every promise. -/
theorem alloc_pa {k : Promises.Knobs} {arch : Arch} {lbl : AllocLabel} {us : List Acc} {ws : List Word}
    {s : St} {r : St × Word} (hpl : PromLt s) (hr : r ∈ alloc k arch lbl us ws s) (h : PromAbove r.1) :
    PromAbove s := by
  simp only [alloc, List.mem_map] at hr
  obtain ⟨s', hs, rfl⟩ := hr
  let n := nWords us
  let f : Nat → Msg := fun j => ⟨offs ⟨lbl, 0⟩ j, .undef, 0⟩
  let M1 := (List.range n).foldl (fun m j => m.push (f j)) s.mem
  let V1 : VState := { s.vs with
    coh := fun b => if b.label = lbl ∧ b.offset < n then s.mem.size + b.offset else s.vs.coh b
    vWr := max s.vs.vWr (s.mem.size + n - 1) }
  let s1 : St := { s with mem := M1, vs := V1, nalloc := s.nalloc + 1 }
  have hs1 : s' ∈ storeUnits k arch (cst (.loc ⟨lbl, 0⟩ 0)) ⟨lbl, 0⟩ false us ws 0 s1 := hs
  have h1 : PromAbove s1 := storeUnits_promAbove hs1 h
  intro t ht m hm
  have htl := hpl t ht
  have hm1 : M1[t]? = some m := by
    rw [fold_get f n s.mem t]
    split
    · exact hm
    · rename_i hn; exact absurd htl hn
  have h2 := h1 t ht m hm1
  change (if m.loc.label = lbl ∧ m.loc.offset < n then s.mem.size + m.loc.offset else s.vs.coh m.loc) < t at h2
  split at h2
  · exact absurd (Nat.lt_trans (Nat.lt_of_le_of_lt (Nat.le_add_right _ _) h2) htl) (Nat.lt_irrefl _)
  · exact h2

/-- (S6) A boxing allocation (with or without its fence) takes one label. -/
theorem nalloc_alloc_box {k : Promises.Knobs} {arch : Arch} {lbl : AllocLabel} {us : List Acc} {ws : List Word}
    {s : St} {r : St × Word} {b : Bool} (hpl : PromLt s) (hr : r ∈ alloc k arch lbl us ws s) :
    s.nalloc < (if b then fenceS r.1 .st else r.1).nalloc := by
  have h := (alloc_growsP hpl r hr).2.2.1
  cases b <;> simp [fenceS, h]

/-- (T3c-5d) **A boxed sum's allocation keeps `MemInv`**: the block `[tag,
payload…]` at the next fresh label is outside Σ (`alloc_ok0`), so Σ's
invariants survive; the new ghost box, the thread's own, is at its latest words
(`alloc_latest`), (S8b) each at a timestamp at most the frontier `B.fr`, the
`vWr` after the init stores (`alloc_coh_le_vWr`). -/
theorem MemInv_box {g : G} {E : TEnv} {s : St} {us : List Acc} {j : Nat} {p : List Word} {r : St × Word}
    (hm : MemInv g E s) (hn : 0 < g.n)
    (hr : r ∈ alloc g.k g.arch (freshLabel g.lbase g.n g.i s.nalloc) (.one :: us) (cst (.num j) :: p) s)
    (hlen : p.length = nWords us) :
    MemInv g (boxE E (freshLabel g.lbase g.n g.i s.nalloc) ⟨j, p.map (bumpW s.vs.vRelSt), E.tid, r.1.vs.vWr⟩) r.1 ∧
      r.2 = cst (.loc ⟨freshLabel g.lbase g.n g.i s.nalloc, 0⟩ 0) ∧
      BoxWords ⟨j, p.map (bumpW s.vs.vRelSt), E.tid, r.1.vs.vWr⟩
        (fun o w => LatestP r.1.mem r.1.promises r.1.vs.coh ⟨freshLabel g.lbase g.n g.i s.nalloc, o⟩ w) := by
  obtain ⟨hmo, hoo, hpl, hfr, hsn, hoh, hpd, hopub, hpi, hbi, hpo⟩ := id hm
  obtain ⟨hnone, hfresh, hini0, hpf0⟩ := hfr.1 s.nalloc (Nat.le_refl _)
  obtain ⟨hmo', hoo', hpw⟩ := alloc_ok0P hnone hpl hpo.1 hmo hoo r hr
  obtain ⟨hg, hsl, hna, hpl', hful⟩ := alloc_growsP hpl r hr
  obtain ⟨l1, l2⟩ := alloc_latP hpl hpo.1 r hr
  have hwr := alloc_wrP r hr
  have hrel := alloc_relSt r hr
  have hcw := alloc_coh_le_vWr r hr
  have hbnone := hbi.1 s.nalloc (Nat.le_refl _)
  let B : Box := ⟨j, p.map (bumpW s.vs.vRelSt), E.tid, r.1.vs.vWr⟩
  have hBm : ∀ l B', E.box l = some B' →
      (boxE E (freshLabel g.lbase g.n g.i s.nalloc) B).box l = some B' :=
    fun l B' h => by
      have hne : l ≠ freshLabel g.lbase g.n g.i s.nalloc := fun e => by rw [e, hbnone] at h; cases h
      simp only [boxE, if_neg hne]; exact h
  have hmono : ∀ {U : Ty} {vs : List Word}, ValOf E U vs →
      ValOf (boxE E (freshLabel g.lbase g.n g.i s.nalloc) B) U vs :=
    fun h => ValOf_mono (η₁ := E)
      (η₂ := boxE E (freshLabel g.lbase g.n g.i s.nalloc) B) rfl rfl (fun _ _ h' => h') (fun _ => Nat.le_refl _) h (hB := hBm)
  have hwA : ∀ T o w, WordOK E T o w →
      WordOK (boxE E (freshLabel g.lbase g.n g.i s.nalloc) B) T o w :=
    fun T o w h => WordOK_map hmono h
  have hsne : ∀ l c, E.sto l = some c → l ≠ freshLabel g.lbase g.n g.i s.nalloc :=
    fun l c h e => by rw [e, hnone] at h; cases h
  -- the new box's words: latest at the new coherence, which is at most `B.fr`
  have hnw : BoxWords B (fun o w => LatestP r.1.mem r.1.promises r.1.vs.coh ⟨freshLabel g.lbase g.n g.i s.nalloc, o⟩ w ∧
      r.1.vs.coh ⟨freshLabel g.lbase g.n g.i s.nalloc, o⟩ ≤ r.1.vs.vWr) := by
    have e2 : nWords (Acc.one :: us) = nWords us + 1 := by
      simp only [nWords, List.map_cons, List.sum_cons, Acc.size]; omega
    refine ⟨⟨?_, hcw 0 (by rw [e2]; omega)⟩, fun o w hw => ?_⟩
    · obtain ⟨⟨m, h1, h2, h3, -⟩, h5, h6⟩ := l1 0 (cst (.num j)) (by simp [nWords, Acc.size]; omega) rfl
      exact ⟨⟨m, h1, h2, h3, fun x g hx => by simp [cst, Promises.TVal.mk0] at hx⟩, h5, h6⟩
    · simp only [B, List.getElem?_map] at hw
      cases hpo : p[o]? with
      | none => rw [hpo] at hw; cases hw
      | some w0 =>
          rw [hpo] at hw; simp only [Option.map_some, Option.some.injEq] at hw; subst hw
          have hlt : o < p.length := (List.getElem?_eq_some_iff.1 hpo).1
          have hlt' : o + 1 < nWords (Acc.one :: us) := by
            have e : p.length = nWords us := hlen
            rw [e2, ← e]; exact Nat.succ_lt_succ hlt
          exact ⟨l1 (o + 1) w0 hlt' (by simpa using hpo), hcw (o + 1) hlt'⟩
  refine ⟨⟨MemOKP_mono hmo' rfl rfl (fun _ _ h => h) (fun _ => Nat.le_refl _) (fun _ _ _ _ h => h) (hB := hBm),
    fun l c hc ho => ?_, hpl', ⟨fun j' hj' => ?_, PrivCoh_growsAt hfr.2 (fun a hu _ => hu)
      (fun l c hc ho => OwnCellF_env (hoo' l c hc ho) hmono rfl rfl hmo'.2.2) hg hful
      fun t m _ _ hu hl => absurd hu (notPrivU_none (by rw [hl]; exact hnone))⟩,
    fun l hl => by rw [hrel]; exact hsn l hl,
    OwnHidP.imp hoh (fun l c hc ho => ⟨hc, ho, rfl, rfl, rfl, id⟩)
      (fun l c o V V' hc hle h => HiddenP_growsAt h (hwA _ _) hle hg (hsne l c hc) hful) hwr,
    fun l c f hc ho hf o hi => HiddenP_growsAt (hpd l c f hc ho hf o hi) (hwA _ _) (Nat.le_refl _) hg
      (hsne l c hc) hful,
    hopub.alloc hpl hr, ?_, ?_, PromOK_alloc hpo hpl hr⟩, hpw, hnw.imp fun _ _ h => h.1⟩
  · exact OwnCellF_env (hoo' l c hc ho) hmono rfl rfl hmo'.2.2
  · have hj : s.nalloc + 1 ≤ j' := by rw [← hna]; exact hj'
    obtain ⟨f1, f2, f4, f5⟩ := hfr.1 j' (by omega)
    have hne : freshLabel g.lbase g.n g.i j' ≠ freshLabel g.lbase g.n g.i s.nalloc := fun h => by
      have := freshLabel_inj_k hn h; omega
    refine ⟨f1, fun t m ht hl => ?_, f4, f5⟩
    by_cases hlt : t < s.mem.size
    · rw [hg.2.1 t hlt] at ht
      have hp := f2 t m ht hl
      refine Classical.byContradiction fun hn' => ?_
      obtain ⟨m', hm', e⟩ := hful t hp hn'
      rw [ht] at hm'; cases hm'
      exact hne (hl.symm.trans e)
    · have := hg.2.2 t m (by omega) ht; exact absurd (hl.symm.trans this) hne
  · exact PubInv_grow hpi hmo.2.2 hg (alloc_pairs _ hr) hful rfl rfl (fun _ _ h => h) (fun _ => Nat.le_refl _)
      rfl rfl
      (fun c h => by simp only [boxE] at h; rw [hnone] at h; cases h) (fun l c h => Or.inl h)
      (fun l c b S us' h _ _ hini => Or.inl ⟨h, hini⟩) hBm
      (hpl := fun c h => by simp only [boxE] at h; rw [hnone] at h; cases h) (hrcg := fun _ h => ⟨h, Nat.le_refl _⟩)
  · refine ⟨fun j' hj' => ?_, fun l B' hl => ?_, fun l B' hl => ?_⟩
    · have hj : s.nalloc + 1 ≤ j' := by rw [← hna]; exact hj'
      have hne : freshLabel g.lbase g.n g.i j' ≠ freshLabel g.lbase g.n g.i s.nalloc := fun h => by
        have := freshLabel_inj_k hn h; omega
      simp only [boxE, if_neg hne]; exact hbi.1 j' (by omega)
    · by_cases hlb : l = freshLabel g.lbase g.n g.i s.nalloc
      · subst hlb
        simp only [boxE, ↓reduceIte, Option.some.injEq] at hl
        subst hl
        exact hnw.imp fun o w h => ⟨_, h.2, LatestS_congr h.1 rfl (fun _ h => h) (fun _ h => h)⟩
      · simp only [boxE, if_neg hlb] at hl
        exact (hbi.2.1 l B' hl).imp fun o w ⟨t, ht, hw⟩ =>
          ⟨t, ht, LatestP_growsAt hw hg hlb (fun t h => hsl.subset h) hful⟩
    by_cases hlb : l = freshLabel g.lbase g.n g.i s.nalloc
    · subst hlb
      simp only [boxE, ↓reduceIte, Option.some.injEq] at hl
      subst hl
      exact ⟨hnone, hini0, fun _ => hnw.imp fun _ _ h => h.1⟩
    · simp only [boxE, if_neg hlb] at hl
      obtain ⟨h1, h2, h3⟩ := hbi.2.2 l B' hl
      exact ⟨h1, h2, fun hs => (h3 hs).imp fun o w hw => l2 _ _ hlb hw⟩

/-- (S8b) The box fence raises `vRelSt` to `vWr`. -/
theorem fenceS_vWr_le (s : St) : s.vs.vWr ≤ (fenceS s .st).vs.vRelSt := by
  show s.vs.vWr ≤ max s.vs.vRelSt s.vs.vWr
  exact Nat.le_max_right _ _

/-- (S8b) `E` with the box at `lbl` seen at frontier `F`. -/
def seeE (E : TEnv) (lbl : AllocLabel) (F : Ts) : TEnv :=
  { E with pfr := fun l => if l = lbl then some F else E.pfr l, seen := fun l => l = lbl ∨ E.seen l }

/-- (S8b) **Seeing a box keeps `MemInv`**: the box at `lbl` (outside Σ, no
frontier yet) becomes seen at a frontier `F` the thread's `vRelSt` covers (the
box fence), its words at the thread's coherence. -/
theorem MemInv_seeBox {g : G} {E : TEnv} {s : St} {lbl : AllocLabel} {B : Box} {F : Ts}
    (hm : MemInv g E s) (hB : E.box lbl = some B) (hsto : E.sto lbl = none) (hpf : E.pfr lbl = none)
    (hF : F ≤ s.vs.vRelSt) (hlat : BoxWords B fun o w => LatestP s.mem s.promises s.vs.coh ⟨lbl, o⟩ w) :
    MemInv g (seeE E lbl F) s := by
  obtain ⟨hmo, hoo, hpl, hfr, hsn, hoh, hpd, hopub, hpi, hbi, hpo⟩ := id hm
  have hne : ∀ l c, E.sto l = some c → l ≠ lbl := fun l c h e => by rw [e, hsto] at h; cases h
  have hPe : ∀ l, l ≠ lbl → (seeE E lbl F).pfr l = E.pfr l := fun l h => by simp [seeE, h]
  have hPm : ∀ l f, E.pfr l = some f → (seeE E lbl F).pfr l = some f := fun l f h => by
    by_cases e : l = lbl
    · rw [e, hpf] at h; cases h
    · rw [hPe l e]; exact h
  have hSm : ∀ l, E.seen l → (seeE E lbl F).seen l := fun l h => Or.inr h
  have hmono : ∀ {U : Ty} {vs : List Word}, ValOf E U vs → ValOf (seeE E lbl F) U vs :=
    fun h => ValOf_mono (η₁ := E) (η₂ := seeE E lbl F) rfl rfl (fun _ _ h => h) (fun _ => Nat.le_refl _) h hPm hSm (fun _ _ h => h)
  have hwE : ∀ T o w, WordOK E T o w → WordOK (seeE E lbl F) T o w := fun T o w h =>
    WordOK_mono (η₁ := E) (η₂ := seeE E lbl F) rfl rfl (fun _ _ h => h) (fun _ => Nat.le_refl _) hPm hSm h (fun _ _ h => h)
  obtain ⟨hS0, hI0, hC0, hPP0, hLV0⟩ := hpi
  refine ⟨MemOKP_mono hmo rfl rfl (fun _ _ h => h) (fun _ => Nat.le_refl _) (fun _ _ _ _ h => h) hPm hSm
      (fun _ _ h => h),
    fun l c hc ho => OwnCellF_env (hoo l c hc ho) hmono rfl (hPe l (hne l c hc)) hmo.2.2, hpl,
    ⟨fun j hj => ?_, PrivCoh_of hfr.2
      (fun a ⟨c, N, e, us, h1, h2, h3, h4⟩ => ⟨c, N, e, us, h1, h2, by rw [← hPe _ (hne _ c h1)]; exact h3, h4⟩)
      (fun _ _ => rfl) (fun t m h1 h2 _ => ⟨h1, h2⟩)⟩, fun l hl => ?_,

    OwnHidP.imp hoh (fun l c hc ho => ⟨hc, ho, rfl, rfl, hPe l (hne l c hc), fun h => h.resolve_left (hne l c hc)⟩)
      (fun l c o V V' _ hle h => HiddenP_le (fun t m h1 h2 h3 h4 => h t m h1 h2 h3 (fun h => h4 (hwE _ _ _ h))) hle)
      (Nat.le_refl _),
    fun l c f hc ho hf o hi t m h1 h2 h3 h4 =>
      hpd l c f hc ho (by rw [← hPe l (hne l c hc)]; exact hf) o hi t m h1 h2 h3 (fun h => h4 (hwE _ _ _ h)),
    fun l c f hc ho hf => (hopub l c f hc ho (by rw [← hPe l (hne l c hc)]; exact hf)).imp Or.inr id,
    ⟨fun l hl => ?_, fun l c b S us hc hseg hu hini => ?_, fun l c f hc hf => hC0 l c f hc
      (by rw [← hPe l (hne l c hc)]; exact hf), ?_, ?_⟩, ⟨hbi.1, hbi.2.1, fun l B' hl => ?_⟩, hpo⟩
  · obtain ⟨f1, f2, f4, f5⟩ := hfr.1 j hj
    have hj' : freshLabel g.lbase g.n g.i j ≠ lbl := fun e => by
      have := hbi.1 j hj; rw [e, hB] at this; cases this
    exact ⟨f1, f2, f4, by rw [hPe _ hj']; exact f5⟩
  · rcases hl with h | h
    · subst h; exact ⟨F, by simp [seeE], hF⟩
    · obtain ⟨f, h1, h2⟩ := hsn l h
      exact ⟨f, hPm l f h1, h2⟩
  · rcases hl with h | h
    · subst h; exact .inr ⟨hsto, by show E.box _ ≠ none; rw [hB]; simp⟩
    · exact hS0 l h
  · obtain ⟨ws, h1, h2⟩ := hI0 l c b S us hc hseg hu hini
    exact ⟨ws, hmono h1, h2⟩
  · intro l c f o hc hown hf htw t0 t1 m0 m1 hn0 hn1 hm0 hm1 hl0 hl1 hh0 hh1 hst
    exact PairOK_mono (η₁ := E) (η₂ := seeE E lbl F) rfl rfl (fun _ _ h => h) (fun _ => Nat.le_refl _) hPm hSm
      (hPP0 l c f o hc hown (by rw [← hPe l (hne l c hc)]; exact hf) htw t0 t1 m0 m1 hn0 hn1 hm0 hm1 hl0 hl1
        hh0 hh1 hst) (fun _ _ h => h)
  · intro l c f b S us o hc hown hf hseg hu ho
    exact hLV0 l c f b S us o hc hown (by rw [← hPe l (hne l c hc)]; exact hf) hseg hu ho
  · obtain ⟨h1, h2, h3⟩ := hbi.2.2 l B' hl
    refine ⟨h1, h2, fun hs => ?_⟩
    rcases hs with h | h
    · subst h
      have hl' : E.box _ = some B' := hl
      rw [hB] at hl'; cases hl'; exact hlat
    · exact h3 h

/-- (S8b) **A box creation keeps `MemInv`**, with the box fence: the new box
at the next fresh label, its frontier the `vWr` after the init stores, seen
there (the fence raises `vRelSt` to it). -/
theorem MemInv_boxF {g : G} {E : TEnv} {s : St} {us : List Acc} {j : Nat} {p : List Word} {r : St × Word}
    (hm : MemInv g E s) (hn : 0 < g.n) (hbf : g.boxFence = true)
    (hr : r ∈ alloc g.k g.arch (freshLabel g.lbase g.n g.i s.nalloc) (.one :: us) (cst (.num j) :: p) s)
    (hlen : p.length = nWords us) :
    MemInv g (seeBoxE E (freshLabel g.lbase g.n g.i s.nalloc) ⟨j, p.map (bumpW s.vs.vRelSt), E.tid, r.1.vs.vWr⟩
        r.1.vs.vWr) (if g.boxFence then fenceS r.1 .st else r.1) ∧
      r.2 = cst (.loc ⟨freshLabel g.lbase g.n g.i s.nalloc, 0⟩ 0) := by
  obtain ⟨hm1, hpw, hlat⟩ := MemInv_box (us := us) hm hn hr hlen
  rw [if_pos hbf]
  refine ⟨?_, hpw⟩
  have hfr := hm.2.2.2.1.1 s.nalloc (Nat.le_refl _)
  exact MemInv_seeBox (MemInv_fence hm1) (by simp [boxE]) hfr.1 hfr.2.2.2 (fenceS_vWr_le r.1) hlat

theorem injM_box {g : G} {s : St} {t : Ty} {j : Nat} {p : List Word} {us : List Acc} (hb : isBoxed t = true)
    (hu : (armsOf t)[j]?.bind accs = some us) :
    injM g s t j p = (alloc g.k g.arch (freshLabel g.lbase g.n g.i s.nalloc) (.one :: us) (cst (.num j) :: p) s).map
      fun (s', pw) => (if g.boxFence then fenceS s' .st else s', [pw]) := by
  simp only [injM, hb, ite_true, hu]

/-- (S8b) An extension survives forgetting `seen`. -/
theorem Ext_unsee {η η' : TEnv} (h : Ext η η') : Ext η.unsee η'.unsee :=
  ⟨h.1.unsee, h.2.1, h.2.2.1, h.2.2.2.1, h.2.2.2.2.1, h.2.2.2.2.2.1, h.2.2.2.2.2.2.1, fun _ h' => h',
    h.2.2.2.2.2.2.2.2.1, h.2.2.2.2.2.2.2.2.2.1, h.2.2.2.2.2.2.2.2.2.2.1.unsee, h.rini⟩

/-- (T3c-5d) **`inl` into a boxed sum, unboxed operand**: the payload goes into
a fresh own box (`MemInv_box`); the frame's view grows by the ghost box. -/
theorem tstepM_inlBS {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {ρ : Nat → Nat} {η : TEnv} {x : String} {τ : Ty} {a : At} {e : Expr} {t : Ty} {c₁ : Cx}
    {rt : Ty} {ws : List Word} (hterm : th.term = .let_ x (.inl τ a) e) (hn : 0 < g.n)
    (hc' : ∀ c', c₁.bind x (.sum t τ) = .ok c' → Typed p c' e ∧ TvOK c')
    (hb : ∃ c', c₁.bind x (.sum t τ) = .ok c')
    (hi1 : FInv ρ η th.σs (Resume p th.stack) c₁ th.env)
    (hea : evalAt th.env a = some (rt, ws)) (hv : VR ρ η t (shp rt) ws) (hl : Lay th.σs t rt ws)
    (hS : (Ty.sum rt (close th.σs τ)).tier = .boxed) (hrb : isBoxed rt = false)
    (hE : EnvOK p η) (hm : MemInv g (CE η) (stOf mem pairs th)) (hbf : g.boxFence = true) (hRP1 : RetPw th.σs th.stack c₁.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMFS p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  obtain ⟨c', hb⟩ := hb
  obtain ⟨he, htv'⟩ := hc' c' hb
  obtain ⟨hshape, hsk, hwc, hval, hly⟩ := hl
  obtain ⟨j, p0, arm, us, has, harm, hus, hnw, q1, hq1, eq1⟩ := asArm_box rt ws hval hshape hwc hrb
  have hj : j < (armsOf rt).length := (List.getElem?_eq_some_iff.mp harm).1
  have harmS : (armsOf (.sum rt (close th.σs τ)))[j]? = some arm := by
    simp only [armsOf]; rw [List.getElem?_append_left hj]; exact harm
  have hSb : isBoxed (.sum rt (close th.σs τ)) = true := by simp [isBoxed, sumHead, hS]
  have hRa : isBoxed rt = false := hrb
  let s := stOf mem pairs th
  let lbl := freshLabel g.lbase g.n g.i s.nalloc
  let V := s.vs.vRelSt
  have hbnone : η.box lbl = none := hm.2.2.2.2.2.2.2.2.2.1.1 s.nalloc (Nat.le_refl _)
  have hstoL : η.sto lbl = none := (hm.2.2.2.1.1 s.nalloc (Nat.le_refl _)).1
  have hpfL : η.pfr lbl = none := (hm.2.2.2.1.1 s.nalloc (Nat.le_refl _)).2.2.2
  have key : tstep g mem pairs th =
      (alloc g.k g.arch lbl (.one :: us) (cst (.num j) :: p0) s).map fun (s', pw) =>
        ((if g.boxFence then fenceS s' .st else s').mem, (if g.boxFence then fenceS s' .st else s').pairs,
          withS { th with term := e, env := (x, .sum rt (close th.σs τ), [pw]) :: th.env }
            (if g.boxFence then fenceS s' .st else s')) := by
    simp only [tstep, hterm, evalOp, hea, projM_nbB hrb, has, ol, Option.map_some, Option.toList_some,
      List.flatMap_cons, List.flatMap_nil, List.append_nil, injM_box hSb (by rw [harmS]; exact hus), List.map_map]
    rfl
  rw [key]
  refine ⟨?_, ?_⟩
  · obtain ⟨r, hr⟩ := alloc_nonempty (k := g.k) (arch := g.arch) (lbl := lbl) (us := .one :: us)
      (ws := cst (.num j) :: p0) (s := s) (by simp [nWords, Acc.size] at hnw ⊢; omega)
    exact List.ne_nil_of_mem (List.mem_map_of_mem hr)
  · intro r hr
    rw [List.mem_map] at hr
    obtain ⟨⟨s', pw⟩, hal, rfl⟩ := hr
    let B : Box := ⟨j, p0.map (bumpW V), (CE η).tid, s'.vs.vWr⟩
    let η' := η.withSto η.sto (P := fun l => if l = lbl then some s'.vs.vWr else η.pfr l)
      (S := fun l => l = lbl ∨ η.seen l) (Bx := fun l => if l = lbl then some B else η.box l)
    have hx : Ext η η' := Ext_withSto hE.2.1 (fun _ _ h => h) (fun _ => Nat.le_refl _) (hS := fun _ h => Or.inr h)
      (hP := fun l f h => by
        have hne : l ≠ lbl := fun e => by rw [e, hpfL] at h; cases h
        simp only [hne, ↓reduceIte]; exact h)
      (hB := fun l B' h => by
        have hne : l ≠ lbl := fun e => by rw [e, hbnone] at h; cases h
        simp only [hne, ↓reduceIte]; exact h)
    have hCE : CE η' = seeBoxE (CE η) lbl B s'.vs.vWr := rfl
    have hBS : BoxSeen η' lbl B := ⟨by simp [η', TEnv.withSto], s'.vs.vWr, by simp [η', TEnv.withSto], Nat.le_refl _⟩
    obtain ⟨hm', hpw⟩ := MemInv_boxF (us := us) hm hn hbf hal hnw.symm
    simp only at hpw
    subst hpw
    obtain ⟨q', hq', eq'⟩ := ofArm_wle (WLe_bump V p0) hq1
    have hwq : WLe ws q' := WLe_trans (asArm_ofArm_wle has hq1 eq1) eq'
    have eqw : VEq ws q' := eq1.symm.trans eq'.vals
    have hv2 : VR ρ η'.unsee t (shp rt) q' :=
      VR_ext hE.2.1.unsee (Ext_unsee hx) (VR_store hE.2.1 (V := V) (fun l hl => hm.2.2.2.2.1 l hl)
        (LocAbove_ofArm hq' (LocAbove_bump V p0)) (VR_up _ _ _ _ hwq hv))
    have hvr : VR ρ η' (.sum t τ) (shp (.sum rt (close th.σs τ))) [cst (.loc ⟨lbl, 0⟩ 0)] :=
      VR_boxL (B := B) hS hRa rfl rfl (by simp [η', TEnv.withSto]) (Or.inl hBS) hj hq' hv2
        (ShapeC_vals eqw hshape) hwc (Valid_vals _ _ _ eqw hval)
        (by show ((armsOf (.sum rt (close th.σs τ)))[j]?).bind wc = some (p0.map (bumpW V)).length
            rw [harmS]; simp [wc, hus, hnw, List.length_map])
    refine ⟨CE η', fun _ => rfl, by rw [hCE]; exact EFoot_seeBox (nalloc_alloc_box hm.2.2.1 hal) rfl hpfL hstoL (alloc_size_fr hal) (by first | exact Nat.le_refl _ | (simp only [hbf, ↓reduceIte]; exact Nat.le_refl _) | (simp only [hbf, ↓reduceIte, stOf, withS]; exact Nat.le_refl _)) (alloc_size_len _ hal (by first | exact hlen | exact hnw.symm)),
      ⟨ρ, η', c', rfl, ⟨hE.1, hx.1, hx.2.2.2.2.2.2.2.2.2.2.1⟩, he, htv', ?_, retPw_eq hRP1 (bind_ret hb)⟩, ?_⟩
    · exact bind_FInv hb (FInv_ext hE.2.1 hx hi1) hvr (Lay_box ⟨hshape, hsk, hwc, hval, hly⟩ hS)
    · rw [hCE]; exact hm'

/-- (G1) `tstepM_inlB` from `tstepM_inlBS`. -/
theorem tstepM_inlB {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {ρ : Nat → Nat} {η : TEnv} {x : String} {τ : Ty} {a : At} {e : Expr} {t : Ty} {c₁ : Cx}
    {rt : Ty} {ws : List Word} (hterm : th.term = .let_ x (.inl τ a) e) (hn : 0 < g.n)
    (hc' : ∀ c', c₁.bind x (.sum t τ) = .ok c' → Typed p c' e ∧ TvOK c')
    (hb : ∃ c', c₁.bind x (.sum t τ) = .ok c')
    (hi1 : FInv ρ η th.σs (Resume p th.stack) c₁ th.env)
    (hea : evalAt th.env a = some (rt, ws)) (hv : VR ρ η t (shp rt) ws) (hl : Lay th.σs t rt ws)
    (hS : (Ty.sum rt (close th.σs τ)).tier = .boxed) (hrb : isBoxed rt = false)
    (hE : EnvOK p η) (hm : MemInv g (CE η) (stOf mem pairs th)) (hbf : g.boxFence = true) (hRP1 : RetPw th.σs th.stack c₁.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 :=
  (tstepM_inlBS (hRP1 := hRP1) (hterm := hterm) (hn := hn) (hc' := hc') (hb := hb) (hi1 := hi1) (hea := hea) (hv := hv) (hl := hl) (hS := hS) (hrb := hrb) (hE := hE) (hm := hm) (hbf := hbf)).imp id
    fun h r hr => (h r hr).toF


/-- (T3c-5d) **`projM` at an own box**: the tag, then the payload — the box's
latest words (`BoxInv`) — read through the reference; memory, coherence and
the frontiers `MemInv` reads are kept. -/
theorem projM_ownS {g : G} {s : St} {t : Ty} {pw : Word} {x : Address} {B : Box}
    {arm : Ty} {us : List Acc}
    (hW : BoxWords B fun o w => LatestP s.mem s.promises s.vs.coh ⟨x.label, o⟩ w) (hb : isBoxed t = true)
    (hpw : pw.val = .loc x 0) (hx : x.offset = 0)
    (harm : (armsOf t)[B.tag]? = some arm) (hus : accs arm = some us) (hlen : B.pay.length = nWords us) :
    (s.promises = [] → ∃ r, r ∈ projM g s t [pw] ∧ PromAbove r.1) ∧
      ∀ r ∈ projM g s t [pw], (r.1.mem = s.mem ∧ r.1.promises = s.promises) ∧ (PromAbove r.1 →
      r.2.1 = B.tag ∧ WLe B.pay r.2.2 ∧
      r.1.mem = s.mem ∧ r.1.pairs = s.pairs ∧ r.1.vs.coh = s.vs.coh ∧ r.1.promises = s.promises ∧
      r.1.nalloc = s.nalloc ∧ r.1.vs.vRelSt = s.vs.vRelSt ∧ r.1.vs.vWr = s.vs.vWr) := by
  obtain ⟨hL0, hLp⟩ := hW
  have hxe : x = ⟨x.label, 0⟩ := by cases x; simp_all
  have h0 : ∀ j v, [cst (.num B.tag)][j]? = some v → LatestP s.mem s.promises s.vs.coh (offs x (0 + j)) v := by
    intro j v hj
    cases j with
    | zero => simp only [List.getElem?_cons_zero, Option.some.injEq] at hj; subst hj; rw [hxe]; exact hL0
    | succ j => simp at hj
  have hp : ∀ (s1 : St), s1.mem = s.mem → s1.vs.coh = s.vs.coh → s1.promises = s.promises →
      ∀ j v, B.pay[j]? = some v → LatestP s1.mem s1.promises s1.vs.coh (offs x (1 + j)) v := by
    intro s1 e1 e2 e3 j v hj
    rw [e1, e2, e3, hxe]; simpa [offs, Nat.add_comm] using hLp j v hj
  have hsplit : projM g s t [pw] = (loadUnits g.arch pw x false [.one] 0 s).flatMap fun (s1, tw) =>
      match tw with
      | [tag] =>
          match tag.val with
          | .num j =>
              match (armsOf t)[j]?.bind accs with
              | some us => (loadUnits g.arch pw x false us 1 s1).map fun (s2, p) => (s2, j, p)
              | none => []
          | _ => []
      | _ => [] := by
    simp only [projM, hb, ite_true, addrOf, hpw]; rfl
  -- the outcomes of the tag load
  have htag : ∀ r1 ∈ loadUnits g.arch pw x false [.one] 0 s, PromAbove r1.1 → ∃ tg, r1.2 = [tg] ∧
      tg.val = .num B.tag ∧
      r1.1.mem = s.mem ∧ r1.1.vs.coh = s.vs.coh ∧ r1.1.pairs = s.pairs ∧ r1.1.promises = s.promises ∧
      r1.1.nalloc = s.nalloc ∧ r1.1.vs.vRelSt = s.vs.vRelSt ∧ r1.1.vs.vWr = s.vs.vWr := by
    intro r1 hr1 hpa1
    obtain ⟨hw, hc, hm⟩ := loadUnits_latestPA (by simp [nWords, Acc.size]) h0 hr1 hpa1
    obtain ⟨tg, e, hw1⟩ := WLe_one hw
    obtain ⟨f1, f2, f3, f4⟩ := loadUnits_frame _ _ _ r1 hr1
    exact ⟨tg, e, hw1.1.symm, hm, hc, f2, f3, f4, loadUnits_relSt _ _ _ _ hr1, loadUnits_vWr _ _ _ _ hr1⟩
  have hbind : (armsOf t)[B.tag]?.bind accs = some us := by rw [harm]; exact hus
  rw [hsplit]
  refine ⟨fun h0n => ?_, fun r hr => ?_⟩
  · have hpp0 : ∀ (s' : St), s'.promises = [] → ∀ t, t ∈ s'.promises → ∀ p, p ∈ s'.pairs → t ≠ p ∧ t ≠ p + 1 :=
      fun s' h t ht => by rw [h] at ht; cases ht
    obtain ⟨r1, hr1⟩ := loadUnits_nonemptyP (arch := g.arch) (pw := pw) (a := x) (acq := false) [.one] 0 s _
      (by simp [nWords, Acc.size]) (hpp0 s h0n) h0
    have e3' : r1.1.promises = s.promises := (loadUnits_frame _ _ _ r1 hr1).2.2.1
    obtain ⟨tg, e, htv, e1, e2, -, e4, -⟩ := htag r1 hr1 (PromAbove_nil (by rw [e3']; exact h0n))
    obtain ⟨r2, hr2⟩ := loadUnits_nonemptyP (arch := g.arch) (pw := pw) (a := x) (acq := false) us 1 r1.1 B.pay
      hlen (hpp0 r1.1 (by rw [e4]; exact h0n)) (hp r1.1 e1 e2 e4)
    refine ⟨(r2.1, B.tag, r2.2), List.mem_flatMap.2 ⟨r1, hr1, ?_⟩,
      PromAbove_nil (by rw [(loadUnits_frame _ _ _ r2 hr2).2.2.1, e4]; exact h0n)⟩
    obtain ⟨s1, tw⟩ := r1
    simp only at e
    subst e
    simp only [htv, hbind]
    exact List.mem_map_of_mem hr2
  · obtain ⟨⟨s1, tw⟩, hr1, hr⟩ := List.mem_flatMap.1 hr
    have hin : ∃ (j : Nat) (us' : List Acc) (s2 : St) (p : List Word),
        (s2, p) ∈ loadUnits g.arch pw x false us' 1 s1 ∧ r = (s2, j, p) := by
      simp only at hr
      split at hr
      · split at hr
        · split at hr
          · obtain ⟨⟨s2, p⟩, h2, he⟩ := List.mem_map.1 hr; exact ⟨_, _, s2, p, h2, he.symm⟩
          · cases hr
        · cases hr
      · cases hr
    obtain ⟨_, _, _, _, h20, hreq⟩ := hin
    obtain ⟨g1, -, g3, -⟩ := loadUnits_frame _ _ _ _ hr1
    obtain ⟨g1', -, g3', -⟩ := loadUnits_frame _ _ _ _ h20
    refine ⟨by rw [hreq]; exact ⟨g1'.trans g1, g3'.trans g3⟩, fun hpa => ?_⟩
    have hp1 : PromAbove s1 := loadUnits_pa h20 (by rw [hreq] at hpa; exact hpa)
    obtain ⟨tg, e, htv, e1, e2, e3, e4, e5, e6, e7⟩ := htag _ hr1 hp1
    simp only at e e1 e2 e3 e4 e5 e6 e7
    subst e
    simp only [htv, hbind, List.mem_map] at hr
    obtain ⟨⟨s2, p⟩, hr2, rfl⟩ := hr
    obtain ⟨hw, hc, hm⟩ := loadUnits_latestPA hlen (hp s1 e1 e2 e4) hr2 hpa
    obtain ⟨f1, f2, f3, f4⟩ := loadUnits_frame _ _ _ _ hr2
    simp only at hw hc hm f1 f2 f3 f4
    exact ⟨rfl, hw, hm.trans e1, f2.trans e3, hc.trans e2, f3.trans e4, f4.trans e5,
      (loadUnits_relSt _ _ _ _ hr2).trans e6, (loadUnits_vWr _ _ _ _ hr2).trans e7⟩

/-- (S8b) `projM` at a box not seen: its words below the frontier, read
through a reference whose view reaches it (`BoxTopP`, `loadUnits_topPA`). -/
theorem projM_ownT {g : G} {s : St} {t : Ty} {pw : Word} {x : Address} {B : Box}
    {arm : Ty} {us : List Acc}
    (hW : BoxWords B fun o w => ∃ t, t ≤ pw.view ∧ LatestP s.mem s.promises (fun _ => t) ⟨x.label, o⟩ w) (hb : isBoxed t = true)
    (hpw : pw.val = .loc x 0) (hx : x.offset = 0)
    (harm : (armsOf t)[B.tag]? = some arm) (hus : accs arm = some us) (hlen : B.pay.length = nWords us) :
    (s.promises = [] → ∃ r, r ∈ projM g s t [pw] ∧ PromAbove r.1) ∧
      ∀ r ∈ projM g s t [pw], (r.1.mem = s.mem ∧ r.1.promises = s.promises) ∧ (PromAbove r.1 →
      r.2.1 = B.tag ∧ WLe B.pay r.2.2 ∧
      r.1.mem = s.mem ∧ r.1.pairs = s.pairs ∧ (∀ b : Address, b.label ≠ x.label → r.1.vs.coh b = s.vs.coh b) ∧
      (∀ b, s.vs.coh b ≤ r.1.vs.coh b) ∧ r.1.promises = s.promises ∧
      r.1.nalloc = s.nalloc ∧ r.1.vs.vRelSt = s.vs.vRelSt ∧ r.1.vs.vWr = s.vs.vWr) := by
  obtain ⟨hL0, hLp⟩ := hW
  have hxe : x = ⟨x.label, 0⟩ := by cases x; simp_all
  have h0 : ∀ j v, [cst (.num B.tag)][j]? = some v →
      ∃ t, t ≤ pw.view ∧ LatestP s.mem s.promises (fun _ => t) (offs x (0 + j)) v := by
    intro j v hj
    cases j with
    | zero => simp only [List.getElem?_cons_zero, Option.some.injEq] at hj; subst hj; rw [hxe]; exact hL0
    | succ j => simp at hj
  have hp : ∀ (s1 : St), s1.mem = s.mem → s1.promises = s.promises →
      ∀ j v, B.pay[j]? = some v → ∃ t, t ≤ pw.view ∧ LatestP s1.mem s1.promises (fun _ => t) (offs x (1 + j)) v := by
    intro s1 e1 e3 j v hj
    rw [e1, e3, hxe]; simpa [offs, Nat.add_comm] using hLp j v hj
  have hsplit : projM g s t [pw] = (loadUnits g.arch pw x false [.one] 0 s).flatMap fun (s1, tw) =>
      match tw with
      | [tag] =>
          match tag.val with
          | .num j =>
              match (armsOf t)[j]?.bind accs with
              | some us => (loadUnits g.arch pw x false us 1 s1).map fun (s2, p) => (s2, j, p)
              | none => []
          | _ => []
      | _ => [] := by
    simp only [projM, hb, ite_true, addrOf, hpw]; rfl
  -- the outcomes of the tag load
  have htag : ∀ r1 ∈ loadUnits g.arch pw x false [.one] 0 s, PromAbove r1.1 → ∃ tg, r1.2 = [tg] ∧
      tg.val = .num B.tag ∧
      r1.1.mem = s.mem ∧ r1.1.pairs = s.pairs ∧ r1.1.promises = s.promises ∧
      r1.1.nalloc = s.nalloc ∧ r1.1.vs.vRelSt = s.vs.vRelSt ∧ r1.1.vs.vWr = s.vs.vWr := by
    intro r1 hr1 hpa1
    have hw := loadUnits_topPA (by simp [nWords, Acc.size]) h0 hr1 hpa1
    obtain ⟨tg, e, hw1⟩ := WLe_one hw
    obtain ⟨f1, f2, f3, f4⟩ := loadUnits_frame _ _ _ r1 hr1
    exact ⟨tg, e, hw1.1.symm, f1, f2, f3, f4, loadUnits_relSt _ _ _ _ hr1, loadUnits_vWr _ _ _ _ hr1⟩
  have hbind : (armsOf t)[B.tag]?.bind accs = some us := by rw [harm]; exact hus
  rw [hsplit]
  refine ⟨fun h0n => ?_, fun r hr => ?_⟩
  · have hpp0 : ∀ (s' : St), s'.promises = [] → ∀ t, t ∈ s'.promises → ∀ p, p ∈ s'.pairs → t ≠ p ∧ t ≠ p + 1 :=
      fun s' h t ht => by rw [h] at ht; cases ht
    obtain ⟨r1, hr1⟩ := loadUnits_nonemptyT (arch := g.arch) (pw := pw) (a := x) (acq := false) [.one] 0 s _
      (by simp [nWords, Acc.size]) (hpp0 s h0n) h0
    have e3' : r1.1.promises = s.promises := (loadUnits_frame _ _ _ r1 hr1).2.2.1
    obtain ⟨tg, e, htv, e1, -, e4, -⟩ := htag r1 hr1 (PromAbove_nil (by rw [e3']; exact h0n))
    obtain ⟨r2, hr2⟩ := loadUnits_nonemptyT (arch := g.arch) (pw := pw) (a := x) (acq := false) us 1 r1.1 B.pay
      hlen (hpp0 r1.1 (by rw [e4]; exact h0n)) (hp r1.1 e1 e4)
    refine ⟨(r2.1, B.tag, r2.2), List.mem_flatMap.2 ⟨r1, hr1, ?_⟩,
      PromAbove_nil (by rw [(loadUnits_frame _ _ _ r2 hr2).2.2.1, e4]; exact h0n)⟩
    obtain ⟨s1, tw⟩ := r1
    simp only at e
    subst e
    simp only [htv, hbind]
    exact List.mem_map_of_mem hr2
  · obtain ⟨⟨s1, tw⟩, hr1, hr⟩ := List.mem_flatMap.1 hr
    have hin : ∃ (j : Nat) (us' : List Acc) (s2 : St) (p : List Word),
        (s2, p) ∈ loadUnits g.arch pw x false us' 1 s1 ∧ r = (s2, j, p) := by
      simp only at hr
      split at hr
      · split at hr
        · split at hr
          · obtain ⟨⟨s2, p⟩, h2, he⟩ := List.mem_map.1 hr; exact ⟨_, _, s2, p, h2, he.symm⟩
          · cases hr
        · cases hr
      · cases hr
    obtain ⟨_, _, _, _, h20, hreq⟩ := hin
    obtain ⟨g1, -, g3, -⟩ := loadUnits_frame _ _ _ _ hr1
    obtain ⟨g1', -, g3', -⟩ := loadUnits_frame _ _ _ _ h20
    refine ⟨by rw [hreq]; exact ⟨g1'.trans g1, g3'.trans g3⟩, fun hpa => ?_⟩
    have hp1 : PromAbove s1 := loadUnits_pa h20 (by rw [hreq] at hpa; exact hpa)
    obtain ⟨tg, e, htv, e1, e3, e4, e5, e6, e7⟩ := htag _ hr1 hp1
    simp only at e e1 e3 e4 e5 e6 e7
    subst e
    simp only [htv, hbind, List.mem_map] at hr
    obtain ⟨⟨s2, p⟩, hr2, rfl⟩ := hr
    have hw := loadUnits_topPA hlen (hp s1 e1 e4) hr2 hpa
    obtain ⟨f1, f2, f3, f4⟩ := loadUnits_frame _ _ _ _ hr2
    have c1 := loadUnits_cohF _ _ _ _ hr1
    have c2 := loadUnits_cohF _ _ _ _ hr2
    have m1 := loadUnits_cohMono _ _ _ _ hr1
    have m2 := loadUnits_cohMono _ _ _ _ hr2
    simp only at hw f1 f2 f3 f4 c1 c2 m1 m2
    exact ⟨rfl, hw, f1.trans e1, f2.trans e3, fun b hb => (c2 b hb).trans (c1 b hb),
      fun b => Nat.le_trans (m1 b) (m2 b), f3.trans e4, f4.trans e5,
      (loadUnits_relSt _ _ _ _ hr2).trans e6, (loadUnits_vWr _ _ _ _ hr2).trans e7⟩


/-- (S8b) **`projM` at an own box**: at a box the thread has seen, its latest
words at its coherence (`projM_ownS`); else the reference's view reaches the
box's frontier and its words below it are read (`projM_ownT`).  Coherence moves
only at the box, and not at all if seen (`CohRd`). -/
theorem projM_own {g : G} {E : TEnv} {s : St} {t : Ty} {pw : Word} {x : Address} {B : Box}
    {arm : Ty} {us : List Acc} (hbi : BoxInv g E s) (hsee : E.seen x.label ∨ B.fr ≤ pw.view)
    (hb : isBoxed t = true)
    (hpw : pw.val = .loc x 0) (hx : x.offset = 0) (hB : E.box x.label = some B)
    (harm : (armsOf t)[B.tag]? = some arm) (hus : accs arm = some us) (hlen : B.pay.length = nWords us) :
    (s.promises = [] → ∃ r, r ∈ projM g s t [pw] ∧ PromAbove r.1) ∧
      ∀ r ∈ projM g s t [pw], (r.1.mem = s.mem ∧ r.1.promises = s.promises) ∧ (PromAbove r.1 →
      r.2.1 = B.tag ∧ WLe B.pay r.2.2 ∧
      r.1.mem = s.mem ∧ r.1.pairs = s.pairs ∧ CohRd E x.label s r.1 ∧ r.1.promises = s.promises ∧
      r.1.nalloc = s.nalloc ∧ r.1.vs.vRelSt = s.vs.vRelSt ∧ r.1.vs.vWr = s.vs.vWr) := by
  by_cases hs : E.seen x.label
  · obtain ⟨hne, hpr⟩ := projM_ownS (g := g) (t := t) ((hbi.2.2 x.label B hB).2.2 hs) hb hpw hx harm hus hlen
    refine ⟨hne, fun r hr => ⟨(hpr r hr).1, fun hpa => ?_⟩⟩
    obtain ⟨a1, a2, a3, a4, a5, a6, a7, a8, a9⟩ := (hpr r hr).2 hpa
    exact ⟨a1, a2, a3, a4, CohRd_of_eq a5, a6, a7, a8, a9⟩
  · have hfr : B.fr ≤ pw.view := hsee.resolve_left hs
    obtain ⟨hne, hpr⟩ := projM_ownT (g := g) (t := t)
      ((hbi.2.1 x.label B hB).imp fun _ _ ⟨t, ht, hl⟩ => ⟨t, Nat.le_trans ht hfr, hl⟩) hb hpw hx harm hus hlen
    refine ⟨hne, fun r hr => ⟨(hpr r hr).1, fun hpa => ?_⟩⟩
    obtain ⟨a1, a2, a3, a4, a5, a5', a6, a7, a8, a9⟩ := (hpr r hr).2 hpa
    exact ⟨a1, a2, a3, a4, ⟨fun h => absurd h hs, a5, a5'⟩, a6, a7, a8, a9⟩

/-- (S4) `PromAbove` after an injection holds before it. -/
theorem injM_pa {g : G} {s : St} {t : Ty} {j : Nat} {p : List Word} {r : St × List Word} (hpl : PromLt s)
    (hr : r ∈ injM g s t j p) (h : PromAbove r.1) : PromAbove s := by
  unfold injM at hr
  split at hr
  · split at hr
    · obtain ⟨⟨s', pw⟩, hal, rfl⟩ := List.mem_map.1 hr
      refine alloc_pa hpl hal ?_
      simp only at h
      split at h
      · exact h
      · exact h
    · cases hr
  · cases hq : ofArm t j p with
    | none => simp [hq, ol] at hr
    | some q =>
        simp only [hq, ol, Option.map_some, Option.toList_some, List.mem_singleton] at hr
        subst hr; exact h

/-- (T3c-5d) **`inr` into a boxed sum, unboxed operand.** -/
theorem tstepM_inrBS {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {ρ : Nat → Nat} {η : TEnv} {x : String} {τ : Ty} {a : At} {e : Expr} {t : Ty} {c₁ : Cx}
    {rt : Ty} {ws : List Word} (hterm : th.term = .let_ x (.inr τ a) e) (hn : 0 < g.n)
    (hc' : ∀ c', c₁.bind x (.sum τ t) = .ok c' → Typed p c' e ∧ TvOK c')
    (hb : ∃ c', c₁.bind x (.sum τ t) = .ok c')
    (hi1 : FInv ρ η th.σs (Resume p th.stack) c₁ th.env)
    (hea : evalAt th.env a = some (rt, ws)) (hv : VR ρ η t (shp rt) ws) (hl : Lay th.σs t rt ws)
    (hS : (Ty.sum (close th.σs τ) rt).tier = .boxed) (hrb : isBoxed rt = false)
    (hE : EnvOK p η) (hm : MemInv g (CE η) (stOf mem pairs th)) (hbf : g.boxFence = true) (hRP1 : RetPw th.σs th.stack c₁.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMFS p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  obtain ⟨c', hb⟩ := hb
  obtain ⟨he, htv'⟩ := hc' c' hb
  obtain ⟨hshape, hsk, hwc, hval, hly⟩ := hl
  obtain ⟨j, p0, arm, us, has, harm, hus, hnw, q1, hq1, eq1⟩ := asArm_box rt ws hval hshape hwc hrb
  let τc := close th.σs τ
  let n := (armsOf τc).length
  have harmS : (armsOf (.sum τc rt))[n + j]? = some arm := by
    simp only [armsOf]; rw [List.getElem?_append_right (Nat.le_add_right _ _), Nat.add_sub_cancel_left]
    exact harm
  have hSb : isBoxed (.sum τc rt) = true := by simp [isBoxed, sumHead, τc, hS]
  have hRb : isBoxed rt = false := hrb
  let s := stOf mem pairs th
  let lbl := freshLabel g.lbase g.n g.i s.nalloc
  let V := s.vs.vRelSt
  have hbnone : η.box lbl = none := hm.2.2.2.2.2.2.2.2.2.1.1 s.nalloc (Nat.le_refl _)
  have hstoL : η.sto lbl = none := (hm.2.2.2.1.1 s.nalloc (Nat.le_refl _)).1
  have hpfL : η.pfr lbl = none := (hm.2.2.2.1.1 s.nalloc (Nat.le_refl _)).2.2.2
  have key : tstep g mem pairs th =
      (alloc g.k g.arch lbl (.one :: us) (cst (.num (n + j)) :: p0) s).map fun (s', pw) =>
        ((if g.boxFence then fenceS s' .st else s').mem, (if g.boxFence then fenceS s' .st else s').pairs,
          withS { th with term := e, env := (x, .sum τc rt, [pw]) :: th.env }
            (if g.boxFence then fenceS s' .st else s')) := by
    simp only [tstep, hterm, evalOp, hea, projM_nbB hrb, has, ol, Option.map_some, Option.toList_some,
      List.flatMap_cons, List.flatMap_nil, List.append_nil, injM_box (t := Ty.sum (close th.σs τ) rt) (j := (armsOf (close th.σs τ)).length + j) hSb (by rw [harmS]; exact hus), List.map_map]
    rfl
  rw [key]
  refine ⟨?_, ?_⟩
  · obtain ⟨r, hr⟩ := alloc_nonempty (k := g.k) (arch := g.arch) (lbl := lbl) (us := .one :: us)
      (ws := cst (.num (n + j)) :: p0) (s := s) (by simp [nWords, Acc.size] at hnw ⊢; omega)
    exact List.ne_nil_of_mem (List.mem_map_of_mem hr)
  · intro r hr
    rw [List.mem_map] at hr
    obtain ⟨⟨s', pw⟩, hal, rfl⟩ := hr
    let B : Box := ⟨n + j, p0.map (bumpW V), (CE η).tid, s'.vs.vWr⟩
    let η' := η.withSto η.sto (P := fun l => if l = lbl then some s'.vs.vWr else η.pfr l)
      (S := fun l => l = lbl ∨ η.seen l) (Bx := fun l => if l = lbl then some B else η.box l)
    have hx : Ext η η' := Ext_withSto hE.2.1 (fun _ _ h => h) (fun _ => Nat.le_refl _) (hS := fun _ h => Or.inr h)
      (hP := fun l f h => by
        have hne : l ≠ lbl := fun e => by rw [e, hpfL] at h; cases h
        simp only [hne, ↓reduceIte]; exact h)
      (hB := fun l B' h => by
        have hne : l ≠ lbl := fun e => by rw [e, hbnone] at h; cases h
        simp only [hne, ↓reduceIte]; exact h)
    have hCE : CE η' = seeBoxE (CE η) lbl B s'.vs.vWr := rfl
    have hBS : BoxSeen η' lbl B := ⟨by simp [η', TEnv.withSto], s'.vs.vWr, by simp [η', TEnv.withSto], Nat.le_refl _⟩
    obtain ⟨hm', hpw⟩ := MemInv_boxF (us := us) hm hn hbf hal hnw.symm
    simp only at hpw
    subst hpw
    obtain ⟨q', hq', eq'⟩ := ofArm_wle (WLe_bump V p0) hq1
    have hwq : WLe ws q' := WLe_trans (asArm_ofArm_wle has hq1 eq1) eq'
    have eqw : VEq ws q' := eq1.symm.trans eq'.vals
    have hv2 : VR ρ η'.unsee t (shp rt) q' :=
      VR_ext hE.2.1.unsee (Ext_unsee hx) (VR_store hE.2.1 (V := V) (fun l hl => hm.2.2.2.2.1 l hl)
        (LocAbove_ofArm hq' (LocAbove_bump V p0)) (VR_up _ _ _ _ hwq hv))
    have hvr : VR ρ η' (.sum τ t) (shp (.sum τc rt)) [cst (.loc ⟨lbl, 0⟩ 0)] :=
      VR_boxR (B := B) hS hRb rfl rfl (by simp [η', TEnv.withSto]) (Or.inl hBS) (Nat.le_add_right _ _)
        (by show ofArm rt (n + j - n) _ = _; rw [Nat.add_sub_cancel_left]; exact hq') hv2
        (ShapeC_vals eqw hshape) hwc (Valid_vals _ _ _ eqw hval)
        (by show ((armsOf (.sum τc rt))[n + j]?).bind wc = some (p0.map (bumpW V)).length
            rw [harmS]; simp [wc, hus, hnw, List.length_map])
    refine ⟨CE η', fun _ => rfl, by rw [hCE]; exact EFoot_seeBox (nalloc_alloc_box hm.2.2.1 hal) rfl hpfL hstoL (alloc_size_fr hal) (by first | exact Nat.le_refl _ | (simp only [hbf, ↓reduceIte]; exact Nat.le_refl _) | (simp only [hbf, ↓reduceIte, stOf, withS]; exact Nat.le_refl _)) (alloc_size_len _ hal (by first | exact hlen | exact hnw.symm)),
      ⟨ρ, η', c', rfl, ⟨hE.1, hx.1, hx.2.2.2.2.2.2.2.2.2.2.1⟩, he, htv', ?_, retPw_eq hRP1 (bind_ret hb)⟩, ?_⟩
    · exact bind_FInv hb (FInv_ext hE.2.1 hx hi1) hvr (TermSound.Lay_boxR ⟨hshape, hsk, hwc, hval, hly⟩ hS)
    · rw [hCE]; exact hm'

/-- (G1) `tstepM_inrB` from `tstepM_inrBS`. -/
theorem tstepM_inrB {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {ρ : Nat → Nat} {η : TEnv} {x : String} {τ : Ty} {a : At} {e : Expr} {t : Ty} {c₁ : Cx}
    {rt : Ty} {ws : List Word} (hterm : th.term = .let_ x (.inr τ a) e) (hn : 0 < g.n)
    (hc' : ∀ c', c₁.bind x (.sum τ t) = .ok c' → Typed p c' e ∧ TvOK c')
    (hb : ∃ c', c₁.bind x (.sum τ t) = .ok c')
    (hi1 : FInv ρ η th.σs (Resume p th.stack) c₁ th.env)
    (hea : evalAt th.env a = some (rt, ws)) (hv : VR ρ η t (shp rt) ws) (hl : Lay th.σs t rt ws)
    (hS : (Ty.sum (close th.σs τ) rt).tier = .boxed) (hrb : isBoxed rt = false)
    (hE : EnvOK p η) (hm : MemInv g (CE η) (stOf mem pairs th)) (hbf : g.boxFence = true) (hRP1 : RetPw th.σs th.stack c₁.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 :=
  (tstepM_inrBS (hRP1 := hRP1) (hterm := hterm) (hn := hn) (hc' := hc') (hb := hb) (hi1 := hi1) (hea := hea) (hv := hv) (hl := hl) (hS := hS) (hrb := hrb) (hE := hE) (hm := hm) (hbf := hbf)).imp id
    fun h r hr => (h r hr).toF

/-- (T3c-5d) What `VR_boxE` gives at a boxed operand, with `BoxInv`. -/
theorem boxed_operand {g : G} {ρ : Nat → Nat} {η : TEnv} {s : St} {t rt : Ty} {ws : List Word}
    (hc : Coh η) (hbi : BoxInv g (CE η) s) (hrb : isBoxed rt = true)
    (hsg : sig rt = sig (cl ρ η.wit 0 0 t)) (hv : VR ρ η t (shp rt) ws) :
    ∃ w x B arm us, ws = [w] ∧ w.val = .loc x 0 ∧ x.offset = 0 ∧ η.box x.label = some B ∧
      (armsOf rt)[B.tag]? = some arm ∧ accs arm = some us ∧ nWords us = B.pay.length ∧
      η.sto x.label = none ∧ η.ini x.label = 0 ∧ (η.seen x.label ∨ B.fr ≤ w.view) := by
  have hsp := sumSpine_of_isBoxed rt hrb
  have hspc : sumSpine (cl ρ η.wit 0 0 t) := by rw [← sumSpine_sig, ← hsg, sumSpine_sig]; exact hsp
  have hv0 : VR ρ η t (vsh 0 (shp rt)) ws := by rw [vsh_zero rt hrb]; exact hv
  obtain ⟨w, x0, B0, as, rfl, hw, hx0, hB0, -, has, hwa0, hsee0⟩ := VR_boxE hc (bh_shp rt hrb) hspc hv0
  rw [headArms_shp rt hsp, Option.some.injEq] at has; subst has
  rw [Nat.sub_zero, List.getElem?_map] at hwa0
  obtain ⟨arm, harm, hwarm⟩ : ∃ arm, (armsOf rt)[B0.tag]? = some arm ∧ wc arm = some B0.pay.length := by
    cases h : (armsOf rt)[B0.tag]? with
    | none => rw [h] at hwa0; simp at hwa0
    | some arm => rw [h] at hwa0; simp only [Option.map_some, Option.bind_some, wc_lnorm] at hwa0; exact ⟨arm, rfl, hwa0⟩
  obtain ⟨us, hus, hnw⟩ : ∃ us, accs arm = some us ∧ nWords us = B0.pay.length := by
    simp only [wc] at hwarm
    cases h : accs arm with
    | none => rw [h] at hwarm; cases hwarm
    | some us => rw [h] at hwarm; exact ⟨us, rfl, Option.some.inj hwarm⟩
  obtain ⟨hsto0, hini0, -⟩ := hbi.2.2 x0.label B0 hB0
  exact ⟨w, x0, B0, arm, us, rfl, hw, hx0, hB0, harm, hus, hnw, hsto0, hini0, hsee0.imp_left fun h => h.1⟩

/-- (T3c-5d) **`inl` into a boxed sum, boxed operand**: the operand's own box is
read (`projM_own`) and its tag and payload re-boxed at the same tag. -/
theorem tstepM_inlBBS {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {ρ : Nat → Nat} {η : TEnv} {x : String} {τ : Ty} {a : At} {e : Expr} {t : Ty} {c₁ : Cx}
    {rt : Ty} {ws : List Word} (hterm : th.term = .let_ x (.inl τ a) e) (hn : 0 < g.n)
    (hc' : ∀ c', c₁.bind x (.sum t τ) = .ok c' → Typed p c' e ∧ TvOK c')
    (hb : ∃ c', c₁.bind x (.sum t τ) = .ok c')
    (hi1 : FInv ρ η th.σs (Resume p th.stack) c₁ th.env)
    (hea : evalAt th.env a = some (rt, ws)) (hv : VR ρ η t (shp rt) ws) (hl : Lay th.σs t rt ws)
    (hS : (Ty.sum rt (close th.σs τ)).tier = .boxed) (hrb : isBoxed rt = true)
    (hsg : sig rt = sig (cl ρ η.wit 0 0 t))
    (hE : EnvOK p η) (hm : MemInv g (CE η) (stOf mem pairs th)) (hbf : g.boxFence = true)
    (hpx : PAx g mem pairs th) (hRP1 : RetPw th.σs th.stack c₁.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvMFS p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  obtain ⟨c', hb⟩ := hb
  obtain ⟨he, htv'⟩ := hc' c' hb
  have hbi := hm.2.2.2.2.2.2.2.2.2.1
  obtain ⟨w, x0, B0, arm, us, rfl, hw, hx0, hB0, harm, hus, hnw, hsto0, hini0, hsee0⟩ :=
    boxed_operand hE.2.1 hbi hrb hsg hv
  have hj : B0.tag < (armsOf rt).length := (List.getElem?_eq_some_iff.mp harm).1
  let S := Ty.sum rt (close th.σs τ)
  have harmS : (armsOf S)[B0.tag]? = some arm := by
    simp only [S, armsOf]; rw [List.getElem?_append_left hj]; exact harm
  have hSb : isBoxed S = true := by simp [S, isBoxed, sumHead, hS]
  let s := stOf mem pairs th
  obtain ⟨hne, hpr⟩ := projM_own (g := g) (s := s) (t := rt) hbi hsee0 hrb hw hx0 hB0 harm hus hnw.symm
