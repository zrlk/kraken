/-- (S7b) `MemInv_plantF` at the thread's `vWr`. -/
theorem MemInv_plant {g : G} {E E' : TEnv} {s : St} {l : AllocLabel} {c : Cell}
    (hm : MemInv g E s) (hsto : E.sto l = some c) (hown : c.owner = some E.tid) (hnone : E.pfr l = none)
    (hp : E.prog = E'.prog) (ht : E.tid = E'.tid) (hs : E'.sto = E.sto) (hi : E'.ini = E.ini)
    (hP : E'.pfr = fun l' => if l' = l then some s.vs.vWr else E.pfr l') (hS : E'.seen = E.seen) (hR : E'.rini = E.rini)
    (hcpl : ∀ b S, SegOf c.ty b S → accs S ≠ none → TearOK S) (hcT : Ty.coupledOKIn [] c.ty = true)
    (hnT : Ty.noOwnIn [] c.ty = true) (hrT : rgnFree c.ty = true)
    (hbx : ∀ l B, E.box l = some B → E'.box l = some B := by first | exact fun _ _ h => h | simp_all | (intro _ _ h; simpa [CE, TEnv.withSto] using h))
    (hbe : E'.box = E.box := by first | rfl | simp_all)
    (hri : ∀ l, E.rini l ≤ E'.rini l := by rini_le) :
    MemInv g E' s :=
  MemInv_plantF hm hsto hown hnone hp ht hs hi hP hS hR (.inl (Nat.le_refl _)) hcpl hcT hnT hrT hbx hbe hri

/-- (S7b) `MemInv_plant` at the record update. -/
theorem MemInv_plantU {g : G} {E : TEnv} {s : St} {l : AllocLabel} {c : Cell}
    (hm : MemInv g E s) (hsto : E.sto l = some c) (hown : c.owner = some E.tid) (hnone : E.pfr l = none)
    (hcpl : ∀ b S, SegOf c.ty b S → accs S ≠ none → TearOK S) (hcT : Ty.coupledOKIn [] c.ty = true)
    (hnT : Ty.noOwnIn [] c.ty = true) (hrT : rgnFree c.ty = true) :
    MemInv g { E with pfr := fun l' => if l' = l then some s.vs.vWr else E.pfr l' } s :=
  MemInv_plant hm hsto hown hnone rfl rfl rfl rfl rfl rfl rfl hcpl hcT hnT hrT

/-- A buffer cell's locative to a buffer is to the whole cell. -/
theorem AtOff_arr_here {T U : Ty} {o : Nat} (h : AtOff T o U) :
    ∀ {N : Nat} {S : Ty}, T = .array (.lit N) S → accs S ≠ none → accs U = none → U = T := by
  induction h with
  | here _ => intro _ _ _ _ _; rfl
  | fold _ _ ha _ _ => intro _ _ _ _ hU; exact absurd hU ha
  | fst _ _ => intro _ _ e; cases e
  | snd _ _ _ => intro _ _ e; cases e
  | @elem e0 u n j o us hus hj h0 _ =>
      intro N S he ha hU
      simp only [Ty.array.injEq, Idx.lit.injEq] at he
      obtain ⟨-, rfl⟩ := he
      exact absurd hU (accs_AtOff h0 ha)
  | mu _ _ _ _ => intro _ _ e; simp [cl] at e

theorem skel_close_locArr (σs : List Ty) (μ : Mode) (n : Idx) (u : Ty) :
    skel (close σs (.loc μ (.array n u))) = .loc (skelM μ) (.array (.lit 0) (skel (close σs u))) := by
  simp [close, substTs, skel]

/-! ## §14 Loading a published cell (D3 M4b)

A load through a `pub` reference.  At the thread's own cell it is an own load
(`ownLoad`).  At another thread's cell, the reference's view is past the
cell's frontier (`ModeOK`; the thread has seen only its own cells,
`SeenOwn`), so the load's bound is too: a one-word unit reads a word of the
cell's type (`PubDef`), a two-word unit two words of one value (`PubPair`),
and the units splice into one value (`TermTear.assemble`, the type being
coupled, `PubCpl`).  The load's units are its runtime pointee's (`accs ru`);
that they are the cell's (`hlay`) is assumed here (open). -/

/-- (c1) A `pub` reference's mode clause gives its cell's frontier, and the reference's view is
past it unless the thread has seen the cell. -/
theorem pubFr {env : Env} {a : At} {η : TEnv} {rt : Ty} {pw : Word} {ad : Address} {c : Cell}
    (_ : evalAt env a = some (rt, [pw])) (_ : pw.val = .loc ad 0) (_ : η.sto ad.label = some c)
    (h : ModeOK η.tid η.pfr η.seen .pub ad.label c [pw]) :
    ∃ f, η.pfr ad.label = some f ∧ (η.seen ad.label ∨ f ≤ pw.view) := by
  obtain ⟨f, hf, hS⟩ := h
  exact ⟨f, hf, hS.imp id fun h => h pw (List.mem_singleton_self _)⟩

/-- (c1) The reference half of `VR` at `ptr μ u`, at any mode: the cell, its type, the mode's
clause (`ModeOK`) and the runtime pointee's skeleton (`pubPtr_view` at `pub`). -/
theorem ptr_view {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {K : TEnv → List Word → Prop}
    {cx : Cx} {env : Env} {a : At} {μ : Mode} {u : Ty}
    (hi : FInv ρ η σs K cx env) (hpk : cx.peek a = .ok (.ptr μ u))
    (htv : TvOK cx) (ho : cx.opaqueOK u = true) :
    ∃ lab c pw μr ru, evalAt env a = some (.ptr μr ru, [pw]) ∧ pw.val = .loc ⟨lab, 0⟩ 0 ∧
      η.sto lab = some c ∧ Fd c.ty (cl ρ η.wit 0 0 u) ∧ ModeOK η.tid η.pfr η.seen μ lab c [pw] ∧
      accs c.ty ≠ none ∧ skelM μr = skelM μ ∧ etok (skel ru) = etok (skel (close σs u)) ∧
      sig ru = sig (cl ρ η.wit 0 0 u) := by
  obtain ⟨rt, ws, hea, hv, hl⟩ := peek_VR hi.2.1 hpk
  simp only [VR] at hv
  obtain ⟨⟨lab, off⟩, c, hws, hoff, hsto, hcty, hmode, hacc⟩ := hv
  simp only at hoff; subst hoff
  obtain ⟨pw, rfl, hpw⟩ : ∃ pw, ws = [pw] ∧ pw.val = .loc ⟨lab, 0⟩ 0 := by
    match ws, hws with
    | [pw], h => exact ⟨pw, rfl, by simpa using h⟩
    | [], h => simp at h
    | _ :: _ :: _, h => simp at h
  have hsk : etok (skel rt) = .ptr (skelM μ) (etok (skel (close σs u))) := by
    rw [hl.2.1, close_ptr]; rfl
  obtain ⟨μr, ru, rfl, hμ, hsku⟩ := eskel_eq_ptr hsk
  have htb : tb cx.ke.length u = true :=
    tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.ptr μ u) = some (μ, u))
  have hsig : sig ru = sig (cl ρ η.wit 0 0 u) := by
    have h1 : sig ru = sig (close σs u) := sig_of_eskel hsku
    rw [h1]; exact sig_WitL hi.2.2.2.1 ρ ho (lt_of_guardT htb hi.2.2.2.2.1)
  exact ⟨lab, c, pw, μr, ru, hea, hpw, hsto, hcty, hmode, hacc, hμ, hsku, hsig⟩

theorem pubPtr_view {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {K : TEnv → List Word → Prop}
    {cx : Cx} {env : Env} {a : At} {u : Ty}
    (hi : FInv ρ η σs K cx env) (hpk : cx.peek a = .ok (.ptr .pub u))
    (htv : TvOK cx) (ho : cx.opaqueOK u = true) :
    ∃ lab c pw ru f, evalAt env a = some (.ptr .pub ru, [pw]) ∧ pw.val = .loc ⟨lab, 0⟩ 0 ∧
      η.sto lab = some c ∧ Fd c.ty (cl ρ η.wit 0 0 u) ∧ η.pfr lab = some f ∧ (η.seen lab ∨ f ≤ pw.view) ∧
      accs c.ty ≠ none ∧ etok (skel ru) = etok (skel (close σs u)) ∧ sig ru = sig (cl ρ η.wit 0 0 u) := by
  obtain ⟨lab, c, pw, μr, ru, hea, hpw, hsto, hcty, hmode, hacc, hμ, hsku, hsig⟩ := ptr_view hi hpk htv ho
  obtain rfl : μr = .pub := by cases μr <;> simp [skelM] at hμ ⊢
  obtain ⟨f, hf, hS⟩ := pubFr hea hpw hsto hmode
  exact ⟨lab, c, pw, ru, f, hea, hpw, hsto, hcty, hf, hS, hacc, hsku, hsig⟩

/-- What a load of one unit at offset `o` read: a message at `offs a o` not
hidden below `V` (one word); two such, no pair store straddling them (two). -/
def UnitRead (mem : Memory) (pairs : List Ts) (a : Address) (V : Ts) (P : List Ts) :
    Acc → Nat → List Word → Prop
  | .one, o, [w] => ∃ (t : Nat) (m : Msg), mem[t]? = some m ∧ m.loc = offs a o ∧
      WeakMem.hiddenFrom mem (offs a o) t V = false ∧ WLe1 (mw m) w ∧ t ∉ P
  | .two, o, [w0, w1] => ∃ (t0 t1 : Nat) (m0 m1 : Msg), mem[t0]? = some m0 ∧ mem[t1]? = some m1 ∧
      m0.loc = offs a o ∧ m1.loc = offs a (o + 1) ∧
      WeakMem.hiddenFrom mem (offs a o) t0 V = false ∧ WeakMem.hiddenFrom mem (offs a (o + 1)) t1 V = false ∧
      WeakMem.pairStraddles mem pairs (offs a o) t0 t1 = false ∧ WLe1 (mw m0) w0 ∧ WLe1 (mw m1) w1 ∧
      t0 ∉ P ∧ t1 ∉ P
  | _, _, _ => False

/-- What a load read, unit by unit. -/
def Reads (mem : Memory) (pairs : List Ts) (a : Address) (V : Ts) (P : List Ts) :
    List Acc → Nat → List Word → Prop
  | [], _, ws => ws = []
  | u :: us, k, ws => UnitRead mem pairs a V P u k (ws.take u.size) ∧
      Reads mem pairs a V P us (k + u.size) (ws.drop u.size)

/-- **What a load reads**: each unit, messages not hidden below its address
register's view, a pair not straddled. -/
theorem loadUnits_reads {arch : Arch} {pw : Word} {a : Address} {acq : Bool} :
    ∀ (us : List Acc) (k : Nat) (s : St) (r : St × List Word), r ∈ loadUnits arch pw a acq us k s →
      ∀ P : List Ts, (∀ (t : Nat) (m : Msg), t ∈ P → s.mem[t]? = some m → r.1.vs.coh m.loc < t) →
      Reads s.mem s.pairs a pw.view P us k r.2
  | [], k, s, r, hr, P, _ => by
      simp only [loadUnits, List.mem_singleton] at hr; subst hr; rfl
  | .one :: us, k, s, r, hr, P, hP => by
      simp only [loadUnits, List.mem_flatMap, List.mem_map] at hr
      obtain ⟨th, hth, ⟨s', ws⟩, hmem, rfl⟩ := hr
      have ih := loadUnits_reads us (k + 1) _ (s', ws) hmem P hP
      have hcm := loadUnits_cohMono us (k + 1) _ (s', ws) hmem
      simp only [Promises.stepLoad, List.mem_map, List.mem_filter, List.mem_range] at hth
      obtain ⟨t, ⟨_, hrd⟩, rfl⟩ := hth
      obtain ⟨m, hm, hloc, hh⟩ := readable_get hrd
      have e : s.mem[t]! = m := by simp [getElem!_def, hm]
      refine ⟨?_, ih⟩
      refine ⟨t, m, hm, hloc, hiddenFrom_mono (view_le_bound arch s pw s.vs _) hh,
        ⟨by simp [mw, e], fun _ _ _ => by simp [mw, e]⟩, fun htp => ?_⟩
      have h1 := hP t m htp hm
      rw [hloc] at h1
      have h2 := Nat.le_trans (by
        show t ≤ (if offs a k = offs a k then max (s.vs.coh (offs a k)) t else s.vs.coh (offs a k))
        split
        · exact Nat.le_max_right _ _
        · rename_i hne; exact absurd rfl hne) (hcm (offs a k))
      exact absurd (Nat.lt_of_le_of_lt h2 h1) (Nat.lt_irrefl _)
  | .two :: us, k, s, r, hr, P, hP => by
      simp only [loadUnits, List.mem_flatMap, List.mem_map] at hr
      obtain ⟨th, hth, ⟨s', ws⟩, hmem, rfl⟩ := hr
      have ih := loadUnits_reads us (k + 2) _ (s', ws) hmem P hP
      have hcm := loadUnits_cohMono us (k + 2) _ (s', ws) hmem
      simp only [Promises.stepLoadPair, List.mem_flatMap, List.mem_filterMap, List.mem_filter,
        List.mem_range] at hth
      obtain ⟨t0, ⟨_, hr0⟩, t1, ⟨_, hr1⟩, hs⟩ := hth
      split at hs
      · exact absurd hs (by simp)
      · rename_i hns
        simp only [Option.some.injEq] at hs
        subst hs
        obtain ⟨m0, hm0, hl0, hh0⟩ := readable_get hr0
        obtain ⟨m1, hm1, hl1, hh1⟩ := readable_get hr1
        have e0 : s.mem[t0]! = m0 := by simp [getElem!_def, hm0]
        have e1 : s.mem[t1]! = m1 := by simp [getElem!_def, hm1]
        have hnx : (offs a k).next = offs a (k + 1) := by simp [offs, WeakMem.Address.next, Nat.add_assoc]
        refine ⟨?_, ih⟩
        refine ⟨t0, t1, m0, m1, hm0, hm1, hl0, by rw [hl1, hnx],
          hiddenFrom_mono (view_le_bound arch s pw s.vs _) hh0,
          by rw [← hnx]; exact hiddenFrom_mono (view_le_bound arch s pw s.vs _) hh1,
          by simpa using hns, ⟨by simp [mw, e0], fun _ _ _ => by simp [mw, e0]⟩,
          ⟨by simp [mw, e1], fun _ _ _ => by simp [mw, e1]⟩, fun htp => ?_, fun htp => ?_⟩
        · have h1 := hP t0 m0 htp hm0
          rw [hl0] at h1
          have h2 := Nat.le_trans (by
            show t0 ≤ (if offs a k = offs a k then max (s.vs.coh (offs a k)) t0
              else if offs a k = (offs a k).next then max (s.vs.coh (offs a k).next) t1 else s.vs.coh (offs a k))
            split
            · exact Nat.le_max_right _ _
            · rename_i hne; exact absurd rfl hne) (hcm (offs a k))
          exact absurd (Nat.lt_of_le_of_lt h2 h1) (Nat.lt_irrefl _)
        · have h1 := hP t1 m1 htp hm1
          rw [hl1] at h1
          have h2 := Nat.le_trans (by
            show t1 ≤ (if (offs a k).next = offs a k then max (s.vs.coh (offs a k)) t0
              else if (offs a k).next = (offs a k).next then max (s.vs.coh (offs a k).next) t1
              else s.vs.coh (offs a k).next)
            split
            · rename_i heq; exact absurd (congrArg WeakMem.Address.offset heq) (Nat.succ_ne_self _)
            · split
              · exact Nat.le_max_right _ _
              · rename_i hne; exact absurd rfl hne) (hcm (offs a k).next)
          exact absurd (Nat.lt_of_le_of_lt h2 h1) (Nat.lt_irrefl _)

theorem UnitRead_len {mem : Memory} {pairs : List Ts} {a : Address} {V : Ts} {P : List Ts} {u : Acc} {o : Nat}
    {ws : List Word} (h : UnitRead mem pairs a V P u o ws) : ws.length = u.size := by
  cases u with
  | one =>
    match ws, h with
    | [_], _ => rfl
    | [], h => simp [UnitRead] at h
    | _ :: _ :: _, h => simp [UnitRead] at h
  | two =>
    match ws, h with
    | [_, _], _ => rfl
    | [], h => simp [UnitRead] at h
    | [_], h => simp [UnitRead] at h
    | _ :: _ :: _ :: _, h => simp [UnitRead] at h

theorem UnitRead_one {mem : Memory} {pairs : List Ts} {a : Address} {V : Ts} {P : List Ts} {o : Nat}
    {ws : List Word} (h : UnitRead mem pairs a V P .one o ws) :
    ∃ (w : Word) (t : Nat) (m : Msg), ws = [w] ∧ mem[t]? = some m ∧ m.loc = offs a o ∧
      WeakMem.hiddenFrom mem (offs a o) t V = false ∧ WLe1 (mw m) w ∧ t ∉ P := by
  match ws, h with
  | [w], ⟨t, m, h1, h2, h3, h4, h5⟩ => exact ⟨w, t, m, rfl, h1, h2, h3, h4, h5⟩
  | [], h => simp [UnitRead] at h
  | _ :: _ :: _, h => simp [UnitRead] at h

theorem UnitRead_two {mem : Memory} {pairs : List Ts} {a : Address} {V : Ts} {P : List Ts} {o : Nat}
    {ws : List Word} (h : UnitRead mem pairs a V P .two o ws) :
    ∃ (w0 w1 : Word) (t0 t1 : Nat) (m0 m1 : Msg), ws = [w0, w1] ∧ mem[t0]? = some m0 ∧ mem[t1]? = some m1 ∧
      m0.loc = offs a o ∧ m1.loc = offs a (o + 1) ∧
      WeakMem.hiddenFrom mem (offs a o) t0 V = false ∧ WeakMem.hiddenFrom mem (offs a (o + 1)) t1 V = false ∧
      WeakMem.pairStraddles mem pairs (offs a o) t0 t1 = false ∧ WLe1 (mw m0) w0 ∧ WLe1 (mw m1) w1 ∧
      t0 ∉ P ∧ t1 ∉ P := by
  match ws, h with
  | [w0, w1], ⟨t0, t1, m0, m1, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11⟩ =>
    exact ⟨w0, w1, t0, t1, m0, m1, rfl, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11⟩
  | [], h => simp [UnitRead] at h
  | [_], h => simp [UnitRead] at h
  | _ :: _ :: _ :: _, h => simp [UnitRead] at h


/-- `Reads` by unit index, as `TermTear.assemble` takes it. -/
theorem Reads_unit {mem : Memory} {pairs : List Ts} {a : Address} {V : Ts} {P : List Ts} :
    ∀ (us : List Acc) (k : Nat) (ws : List Word), Reads mem pairs a V P us k ws →
      ws.length = nWords us ∧ ∀ i u, us[i]? = some u →
        UnitRead mem pairs a V P u (k + nWords (us.take i)) ((ws.drop (nWords (us.take i))).take u.size)
  | [], k, ws, h => by
      simp only [Reads] at h; subst h
      exact ⟨rfl, fun i u hu => by simp at hu⟩
  | u :: us, k, ws, h => by
      simp only [Reads] at h
      obtain ⟨h1, h2⟩ := h
      obtain ⟨ih1, ih2⟩ := Reads_unit us (k + u.size) (ws.drop u.size) h2
      have hl := UnitRead_len h1
      rw [List.length_take] at hl
      refine ⟨?_, fun i u' hu => ?_⟩
      · rw [List.length_drop] at ih1
        simp only [nWords, List.map_cons, List.sum_cons] at ih1 ⊢
        omega
      · cases i with
        | zero =>
          simp at hu; subst hu
          simpa [nWords] using h1
        | succ j =>
          simp only [List.getElem?_cons_succ] at hu
          have := ih2 j u' hu
          have e : nWords ((u :: us).take (j + 1)) = u.size + nWords (us.take j) := by simp [nWords]
          have e2 : ws.drop (u.size + nWords (us.take j)) = (ws.drop u.size).drop (nWords (us.take j)) := by
            simp [List.drop_drop, Nat.add_comm]
          rw [e, e2, ← Nat.add_assoc]; exact this


/-- A load keeps `MemInv` when coherence moves only off the thread's own cells. -/
theorem MemInv_loadF {g : G} {E : TEnv} {s s' : St} (h : MemInv g E s) (e1 : s'.mem = s.mem)
    (e2 : s'.pairs = s.pairs)
    (e3 : ∀ l c, E.sto l = some c → c.owner = some E.tid → ∀ o, s'.vs.coh ⟨l, o⟩ = s.vs.coh ⟨l, o⟩)
    (e4 : s'.promises = s.promises) (e5 : s'.nalloc = s.nalloc) (e6 : s'.vs.vRelSt = s.vs.vRelSt)
    (e7 : s'.vs.vWr = s.vs.vWr)
    (e3b : ∀ l B, E.box l = some B → ∀ o, s'.vs.coh ⟨l, o⟩ = s.vs.coh ⟨l, o⟩) : MemInv g E s' := by
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11⟩ := h
  refine ⟨by rw [e1, e2, e4]; exact h1, ?_, by unfold PromLt at h3 ⊢; rw [e1, e4]; exact h3, ⟨fun j hj => ?_, PrivCoh_of h4.2 (fun _ h => h)
      (fun a ⟨c, _, _, _, hc, ho, _⟩ => e3 _ c hc ho a.offset)
      (fun t m h1 h2 _ => ⟨by rw [← e4]; exact h1, by rw [← e1]; exact h2⟩)⟩,

    by rw [e6]; exact h5, OwnHidP.imp h6 (fun l c hc ho => ⟨hc, ho, rfl, rfl, rfl, id⟩)
      (fun l c o V V' _ hle h => by rw [e1, e4]; exact HiddenP_le h hle) (Nat.le_of_eq e7.symm),
    by rw [e1, e4]; exact h7, h8.eqv (Nat.le_of_eq e7.symm) e1 e4,
    ⟨h9.1, h9.2.1, h9.2.2.1, by unfold PubMem PubPair PubLive; rw [e1, e2, e4]; exact h9.2.2.2⟩, ?_,
    PromOK_eq h11 e2 e4⟩
  · rw [e1, e2, e4]; exact OwnOKSF_congr h2 e3
  · obtain ⟨f1, f2, f4, f5⟩ := h4.1 j (by rw [← e5]; exact hj)
    exact ⟨f1, by rw [e1, e4]; exact f2, f4, f5⟩
  · exact BoxInv_tr h10 rfl (fun _ _ _ h => h) (fun _ _ _ => rfl) (fun _ _ _ => rfl) (by omega)
      (fun _ _ _ _ _ _ hv => by rw [e1, e4]; exact hv)
      (fun l B hl _ o v hv => by
        rw [e1, e4]; exact LatestS_congr hv (e3b l B hl o) (fun _ h => h) (fun _ h => h))

/-- (c1) `loadPub_core` at any mode whose clause gives the cell's frontier (`hV`): at `pub` from
`ModeOK` (`pubFr`), at a region from `ModeOK1`. -/
theorem loadCell_core {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {acq : Bool} {a : At} {μ : Mode} {u : Ty}
    {K : TEnv → List Word → Prop}
    (hpk : cx.peek a = .ok (.ptr μ u)) (hoq : cx.opaqueOK u = true)
    (hi : FInv ρ η th.σs K cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hV : ∀ rt pw ad c, evalAt th.env a = some (rt, [pw]) → pw.val = .loc ad 0 → η.sto ad.label = some c →
      ModeOK η.tid η.pfr η.seen μ ad.label c [pw] → ModeOK η.tid η.pfr η.seen .pub ad.label c [pw]) :
    ∃ μr ru pw lab us, evalAt th.env a = some (.ptr μr ru, [pw]) ∧ skelM μr = skelM μ ∧ pw.val = .loc ⟨lab, 0⟩ 0 ∧
      accs ru = some us ∧ etok (skel ru) = etok (skel (close th.σs u)) ∧
      loadUnits g.arch pw ⟨lab, 0⟩ acq us 0 (stOf mem pairs th) ≠ [] ∧
      (∀ s' wsr, (s', wsr) ∈ loadUnits g.arch pw ⟨lab, 0⟩ acq us 0 (stOf mem pairs th) → PromAbove s' →
        VR ρ η u (shp ru) wsr ∧ Lay th.σs u ru wsr ∧ MemInv g (CE η) s') ∧
      ∃ ws, VR ρ η u (shp ru) ws := by
  obtain ⟨lab, c, pw, μr, ru, hea, hpw, hsto, hcty, hmode, hacc, hμ, hsku, hsig⟩ := ptr_view hi hpk htv hoq
  obtain ⟨f, hf, hsf⟩ := pubFr hea hpw hsto (hV _ pw ⟨lab, 0⟩ c hea hpw hsto hmode)
  have hna : ∀ N e', c.ty ≠ .array (.lit N) e' := fun N e' h =>
    hacc (by rw [h]; simp [accs])
  have hlr : accs ru = accs c.ty := by rw [(Fd_lay hcty).2.2.1]; exact pub_accs hi.2.2.2.1 hi.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi.2.1 htv hpk rfl hoq hea rfl
  obtain ⟨us, hus⟩ : ∃ us, accs ru = some us := by
    cases h : accs ru with
    | none => rw [h] at hlr; exact absurd hlr.symm hacc
    | some us => exact ⟨us, rfl⟩
  have husc : accs c.ty = some us := by rw [← hlr, hus]
  refine ⟨μr, ru, pw, lab, us, hea, hμ, hpw, hus, hsku, ?_⟩
  by_cases hown : c.owner = some η.tid
  · -- the thread's own cell: an own load
    obtain ⟨us', hus', ⟨r0, hr0⟩, hld, hstw⟩ := ownLoad (arch := g.arch) (pw := pw) (acq := acq)
      (s := stOf mem pairs th) hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hsto hown (Fd_lay hcty).1 (Fd_lay hcty).2.1
      (fun ws => ((Fd_lay hcty).2.2.2 ws).1) (fun R ws => (Fd_VR η hcty).1) hna hsku (peek_cell_lyt hi.2.1 hpk hea rfl rfl).2 hsig
      hlr
    rw [hus] at hus'
    obtain rfl : us = us' := Option.some.inj hus'
    refine ⟨List.ne_nil_of_mem hr0, fun s' wsr hl hpa => ?_, hstw.elim fun ws h => ⟨ws, h.1⟩⟩
    obtain ⟨hvr, hlay', f1, f2, f3, f4, f5⟩ := hld (s', wsr) hl hpa
    exact ⟨hvr, hlay',
      MemInv_load hm f1 f2 f3 f4 f5 (loadUnits_relSt _ _ _ _ hl) (loadUnits_vWr _ _ _ _ hl)⟩
  · -- another thread's cell
    have hm' := hm
    obtain ⟨-, -, -, -, -, -, hpd, -, ⟨hSO, hInh, hCpl, hPP, hLV⟩, -⟩ := hm
    have hfv : f ≤ pw.view := by
      rcases hsf with hs | hs
      · rcases hSO lab hs with ⟨c0, h1, h2⟩ | ⟨h1, -⟩
        · refine absurd ?_ hown
          have h1' : η.sto lab = some c0 := h1
          rw [hsto] at h1'
          rw [Option.some.inj h1']; exact h2
        · have h1' : η.sto lab = none := h1
          rw [hsto] at h1'; cases h1'
      · exact hs
    have hoff : ∀ n, offs (⟨lab, 0⟩ : Address) (0 + n) = ⟨lab, n⟩ := fun n => by simp [offs]
    have hlive : ∀ j, j < nWords us → ∃ (t : Nat) (m : Msg),
        (stOf mem pairs th).mem[t]? = some m ∧ m.loc = offs ⟨lab, 0⟩ (0 + j) := by
      intro j hj
      obtain ⟨t, m, h1, h2⟩ := hLV lab c f 0 c.ty us j hsto hown hf (Or.inl ⟨rfl, rfl, by rw [husc]; simp⟩) husc hj
      exact ⟨t, m, h1, by rw [h2]; simp [offs]⟩
    obtain ⟨r0, hr0⟩ := loadUnits_nonemptyL (arch := g.arch) (pw := pw) (a := ⟨lab, 0⟩) (acq := acq)
      us 0 (stOf mem pairs th) hlive
    have hst0 : ∃ ws, VR ρ η u (shp ru) ws := by
      obtain ⟨Q0, hQ0, -⟩ := hInh lab c 0 c.ty us hsto (Or.inl ⟨rfl, rfl, by rw [husc]; simp⟩) husc
        (fun N e1 h1 => absurd h1 (hna N e1))
      obtain ⟨hvr0, -⟩ := ValOf.env hQ0
      replace hvr0 := (Fd_VR η hcty).1 hvr0
      rw [(Fd_lay hcty).1] at hvr0
      refine ⟨Q0, ?_⟩
      rw [shp_of_sig hsig]
      exact (VR_close hE.2.1 ρ u [] 0 ρ (fun _ => 0) (shp (cl ρ η.wit 0 0 u)) Q0 (fun k => rfl)
        (fun k hk => absurd hk (Nat.not_lt_zero _))).2 hvr0
    refine ⟨List.ne_nil_of_mem hr0, fun s' wsr hl hpa => ?_, hst0⟩
    obtain ⟨f1, f2, f3, f4⟩ := loadUnits_frame us 0 _ (s', wsr) hl
    have hrd := Reads_unit us 0 wsr (loadUnits_reads us 0 _ (s', wsr) hl (stOf mem pairs th).promises
      (fun t m ht hm => hpa t (by rw [f3]; exact ht) m (by rw [f1]; exact hm)))
    have hcpl : TearOK c.ty := (hCpl lab c f hsto hf).2.1 0 c.ty (Or.inl ⟨rfl, rfl, hacc⟩) hacc
    have hunit : ∀ i, i < us.length → ∃ ws, (ValOf (CE η) c.ty ws ∧ ws.length = nWords us) ∧
        ∀ j x y, nWords (us.take i) ≤ j → j < nWords (us.take (i + 1)) → ws[j]? = some x →
          wsr[j]? = some y → WLe1 x y := by
      intro i hi
      obtain ⟨u0, hu0⟩ : ∃ u0, us[i]? = some u0 := ⟨_, List.getElem?_eq_getElem hi⟩
      have hU := hrd.2 i u0 hu0
      rw [nWords_take_succ hu0]
      generalize hn : nWords (us.take i) = n at hU ⊢
      cases u0 with
      | one =>
        obtain ⟨w, t, m, hw, hm, hloc, hh, hwl, hnp⟩ := UnitRead_one hU
        rw [hoff] at hloc hh
        have hy : wsr[n]? = some w := by
          have h1 : (wsr.drop n)[0]? = some w := by
            rw [← List.getElem?_take_of_lt (show 0 < Acc.size .one by decide), hw]; rfl
          rw [List.getElem?_drop, Nat.add_zero] at h1; exact h1
        have hwok : WordOK (CE η) c.ty n (mw m) := by
          refine Classical.byContradiction fun hno => ?_
          obtain ⟨t', m', h1, h2, h3, h4⟩ :=
            hpd lab c f hsto hown hf n (fun N e1 us1 h1 _ => absurd h1 (hna N e1)) t m hnp hm hloc hno
          have hT : WeakMem.hiddenFrom (stOf mem pairs th).mem ⟨lab, n⟩ t f = true := by
            unfold WeakMem.hiddenFrom; rw [List.any_eq_true]
            exact ⟨t', List.mem_range.2 (Nat.lt_succ_of_le h2), by simp [h1, h3, h4]⟩
          rw [hiddenFrom_mono hfv hh] at hT; cases hT
        obtain ⟨b, S, ws, o', w0, hseg, ⟨hval, hsh⟩, hget, hle0, hbo⟩ := hwok
        rcases hseg with ⟨rfl, rfl, -⟩ | ⟨N, _, _, hT, _⟩
        · refine ⟨ws, ⟨hval, hsh us husc⟩, fun j x y hj1 hj2 hx hy' => ?_⟩
          simp only [Acc.size] at hj2
          have hj : j = n := by omega
          have ho' : o' = n := by omega
          subst hj ho'
          rw [hget] at hx; cases hx
          rw [hy] at hy'; cases hy'
          exact WLe1_trans hle0 hwl
        · exact absurd hT (hna _ _)
      | two =>
        obtain ⟨w0, w1, t0, t1, m0, m1, hw, hm0, hm1, hl0, hl1, hh0, hh1, hst, hle0, hle1, hn0, hn1⟩ :=
          UnitRead_two hU
        rw [hoff] at hl0 hh0 hst
        rw [show offs (⟨lab, 0⟩ : Address) (0 + n + 1) = ⟨lab, n + 1⟩ by simp [offs]] at hl1 hh1
        have hy0 : wsr[n]? = some w0 := by
          have h1 : (wsr.drop n)[0]? = some w0 := by
            rw [← List.getElem?_take_of_lt (show 0 < Acc.size .two by decide), hw]; rfl
          rw [List.getElem?_drop, Nat.add_zero] at h1; exact h1
        have hy1 : wsr[n + 1]? = some w1 := by
          have h1 : (wsr.drop n)[1]? = some w1 := by
            rw [← List.getElem?_take_of_lt (show 1 < Acc.size .two by decide), hw]; rfl
          rw [List.getElem?_drop] at h1; exact h1
        have hpo := hPP lab c f n hsto (.inl ⟨hown, 0, c.ty, us, n, Or.inl ⟨rfl, rfl, by rw [husc]; simp⟩, husc,
          ⟨i, hu0, hn.symm⟩, (Nat.zero_add n).symm, fun N e h => by rw [h] at husc; simp [accs] at husc⟩) hf
          ⟨0, c.ty, us, n, Or.inl ⟨rfl, rfl, by rw [husc]; simp⟩, husc, ⟨i, hu0, hn.symm⟩,
          (Nat.zero_add n).symm⟩ t0 t1 m0 m1 hn0 hn1 hm0 hm1 hl0 hl1
          (hiddenFrom_mono hfv hh0) (hiddenFrom_mono hfv hh1) hst
        obtain ⟨b, S, ws, o', x0, x1, hseg, ⟨hval, hsh⟩, hg0, hg1, hx0, hx1, hbo⟩ := hpo
        rcases hseg with ⟨rfl, rfl, -⟩ | ⟨N, _, _, hT, _⟩
        · refine ⟨ws, ⟨hval, hsh us husc⟩, fun j x y hj1 hj2 hx hy => ?_⟩
          simp only [Acc.size] at hj2
          have ho' : o' = n := by omega
          subst ho'
          rcases (show j = o' ∨ j = o' + 1 by omega) with rfl | rfl
          · rw [hg0] at hx; cases hx; rw [hy0] at hy; cases hy; exact WLe1_trans hx0 hle0
          · rw [hg1] at hx; cases hx; rw [hy1] at hy; cases hy; exact WLe1_trans hx1 hle1
        · exact absurd hT (hna _ _)
    obtain ⟨vals, ⟨hvals, hvl⟩, hle⟩ :=
      TermTear.assemble (P := fun ws => ValOf (CE η) c.ty ws ∧ ws.length = nWords us)
        (fun k ws1 ws2 hb h1 h2 => ⟨⟨hcpl _ _ _ _ _ husc hb h1.1.1 h2.1.1 h1.2 h2.2,
            TermTear.Valid_tear husc hb h1.1.2 h2.1.2 h1.2 h2.2⟩,
          by rw [TermTear.splice_length (h1.2.trans h2.2.symm)]; exact h2.2⟩)
        (fun ws h => h.2) wsr hrd.1 hunit
          (hInh lab c 0 c.ty us hsto (Or.inl ⟨rfl, rfl, by rw [husc]; simp⟩) husc (fun N e1 h1 => absurd h1 (hna N e1)))
    obtain ⟨hvr0, hV0⟩ := ValOf.env hvals
    replace hvr0 := (Fd_VR η hcty).1 hvr0
    rw [(Fd_lay hcty).1] at hvr0
    replace hV0 := ((Fd_lay hcty).2.2.2 _).1 hV0
    have hvr : VR ρ η u (shp ru) wsr := by
      rw [shp_of_sig hsig]
      exact (VR_close hE.2.1 ρ u [] 0 ρ (fun _ => 0) (shp (cl ρ η.wit 0 0 u)) wsr (fun k => rfl)
        (fun k hk => absurd hk (Nat.not_lt_zero _))).2 (VR_up _ _ vals wsr hle hvr0)
    have hlay' : Lay th.σs u ru wsr :=
      ⟨fun us' h => by rw [hus] at h; cases h; rw [← hvl, hle.length], hsku, by simp [wc, hus],
        Valid_of_sig hsig.symm (Valid_vals _ vals wsr hle.vals hV0), (peek_cell_lyt hi.2.1 hpk hea rfl rfl).2⟩
    refine ⟨hvr, hlay', ?_⟩
    refine MemInv_loadF hm' f1 f2 (fun l c1 hc1 ho1 o => loadUnits_cohF us 0 _ (s', wsr) hl ⟨l, o⟩ ?_)
      f3 f4 (loadUnits_relSt _ _ _ _ hl) (loadUnits_vWr _ _ _ _ hl)
      (fun l B hB o => loadUnits_cohF us 0 _ (s', wsr) hl ⟨l, o⟩ (fun he => by
        have h0 := (hm'.2.2.2.2.2.2.2.2.2.1.2.2 l B hB).1
        have hl0 : l = lab := he
        rw [hl0] at h0; have h1 : η.sto lab = none := h0; rw [hsto] at h1; cases h1))
    intro hle'
    have hl' : l = lab := hle'
    have h1 : η.sto l = some c1 := hc1
    rw [hl', hsto] at h1
    exact hown (by rw [Option.some.inj h1]; exact ho1)

/-- (c1) A `load` through a reference at any mode with `hV`: the step's outcomes are the loads'
(`loadCell_core`), the bound name taking the runtime pointee type. -/
theorem loadCell_step {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx c' : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {acq : Bool} {a : At} {μ : Mode} {u : Ty} {e : Expr}
    {K : TEnv → List Word → Prop}
    (hterm : th.term = .let_ x (.load acq a) e)
    (hpk : cx.peek a = .ok (.ptr μ u)) (haf : affine cx.ke u = false) (hb : cx.bind x u = .ok c')
    (hi : FInv ρ η th.σs K cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hV : ∀ rt pw ad c, evalAt th.env a = some (rt, [pw]) → pw.val = .loc ad 0 → η.sto ad.label = some c →
      ModeOK η.tid η.pfr η.seen μ ad.label c [pw] → ModeOK η.tid η.pfr η.seen .pub ad.label c [pw]) :
    ∃ ru L, tstep g mem pairs th = L.map (fun (s', ws) =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, ru, ws) :: th.env } s')) ∧ L ≠ [] ∧
      (∀ s' wsr, (s', wsr) ∈ L → PromAbove s' →
        VR ρ η u (shp ru) wsr ∧ Lay th.σs u ru wsr ∧ MemInv g (CE η) s') ∧
      ∀ s' wsr, (s', wsr) ∈ L → s'.mem = (stOf mem pairs th).mem ∧ s'.promises = (stOf mem pairs th).promises := by
  have hnwc : wordOf (close th.σs (.ptr μ u)) = none := by
    rw [close_ptr]; exact wordOf_ptr_of_wordFree (wordFree_close hi.2.2.2.2.2.1 u (wordFreeIn_of_affine u haf))
  obtain ⟨μr, ru, pw, lab, us, hea, -, hpw, hus, hsku, hne, hld, -⟩ :=
    loadCell_core (acq := acq) (g := g) (mem := mem) (pairs := pairs) hpk (bind_opaqueOK hb) hi hE htv hm hV
  have hwr : wordOf (Ty.ptr μr ru) = none := by
    cases ru with
    | word r P =>
        obtain ⟨r', hX⟩ := eskel_word (show etok (skel (close th.σs u)) = .word (.lit 0) P by rw [← hsku]; rfl)
        rw [close_ptr, hX] at hnwc; simp [wordOf] at hnwc
    | _ => rfl
  refine ⟨ru, loadUnits g.arch pw ⟨lab, 0⟩ acq us 0 (stOf mem pairs th), ?_, hne, hld, fun s' wsr hl => ?_⟩
  · simp only [tstep, hterm, evalOp, hea, cellOf, addrOf, hpw, hwr, Option.isSome_none,
      Bool.false_eq_true, ↓reduceIte, hus, List.map_map]; rfl
  · obtain ⟨f1, -, f3, -⟩ := loadUnits_frame us 0 _ (s', wsr) hl
    exact ⟨f1, f3⟩

/-- (T3d-1) The memory half of a `load` through a `pub` reference, factored
out of `tstepM_loadPub` so that a protocol word's load (`loadWord`) shares it:
every outcome reads a value of the pointee type and keeps `MemInv`. -/
theorem loadPub_core {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {acq : Bool} {a : At} {u : Ty}
    {K : TEnv → List Word → Prop}
    (hpk : cx.peek a = .ok (.ptr .pub u)) (hoq : cx.opaqueOK u = true)
    (hi : FInv ρ η th.σs K cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) :
    ∃ ru pw lab us, evalAt th.env a = some (.ptr .pub ru, [pw]) ∧ pw.val = .loc ⟨lab, 0⟩ 0 ∧
      accs ru = some us ∧ etok (skel ru) = etok (skel (close th.σs u)) ∧
      loadUnits g.arch pw ⟨lab, 0⟩ acq us 0 (stOf mem pairs th) ≠ [] ∧
      (∀ s' wsr, (s', wsr) ∈ loadUnits g.arch pw ⟨lab, 0⟩ acq us 0 (stOf mem pairs th) → PromAbove s' →
        VR ρ η u (shp ru) wsr ∧ Lay th.σs u ru wsr ∧ MemInv g (CE η) s') ∧
      ∃ ws, VR ρ η u (shp ru) ws := by
  obtain ⟨μr, ru, pw, lab, us, hea, hμ, h1⟩ :=
    loadCell_core (acq := acq) (g := g) (mem := mem) (pairs := pairs) hpk hoq hi hE htv hm
      (fun _ _ _ _ _ _ _ h => h)
  obtain rfl : μr = .pub := by cases μr <;> simp [skelM] at hμ ⊢
  exact ⟨ru, pw, lab, us, hea, h1⟩

/-- (c1) `tstepM_loadPub`'s step at any mode with `hV`. -/
theorem tstepM_loadCell {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx c' : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {acq : Bool} {a : At} {μ : Mode} {u : Ty} {e : Expr}
    (hterm : th.term = .let_ x (.load acq a) e)
    (hpk : cx.peek a = .ok (.ptr μ u)) (haf : affine cx.ke u = false) (hb : cx.bind x u = .ok c')
    (he : Typed p c' e) (htv' : TvOK c') (hRk : skel c'.ret = skel cx.ret)
    (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel)
    (hV : ∀ rt pw ad c, evalAt th.env a = some (rt, [pw]) → pw.val = .loc ad 0 → η.sto ad.label = some c →
      ModeOK η.tid η.pfr η.seen μ ad.label c [pw] → ModeOK η.tid η.pfr η.seen .pub ad.label c [pw]) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  obtain ⟨ru, L, key, hne, hld, -⟩ := loadCell_step (g := g) (mem := mem) (pairs := pairs) hterm hpk haf hb hi hE htv hm hV
  rw [key]
  refine ⟨fun h => hne (List.map_eq_nil_iff.1 h), fun r hr hpr0 => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨⟨s', wsr⟩, hl, rfl⟩ := hr
  obtain ⟨hvr, hlay', hm'⟩ := hld s' wsr hl (hpr0)
  exact ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv', bind_FInv hb hi hvr hlay', retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩, hm'⟩

/-- **P1 + P4 at the thread, `load` through a `pub` reference** (D3 M4b).
The reference's runtime pointee lays the cell out as its type does
(`pub_accs`). -/
theorem tstepM_loadPub {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {acq : Bool} {a : At} {u : Ty} {e : Expr}
    (hterm : th.term = .let_ x (.load acq a) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.ptr .pub u)) (hnw : wordOf (Ty.ptr .pub u) = none)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | loadWord hp hw _ _ => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | loadOwn hp _ hc _ _ => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | loadRgn hp _ hc _ _ _ => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | loadCap hp _ hc _ _ _ _ => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | loadTorn hp _ hc _ _ _ => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | loadPub hp _ hc haf _ hb =>
  obtain ⟨t, u', hp, hc, haf, hb⟩ : ∃ t u', cx.peek a = .ok t ∧ cellOf t = some (.pub, u') ∧
      affine cx.ke u' = false ∧ cx.bind x u' = .ok c' := ⟨_, _, hp, hc, haf, hb⟩
  rw [hpk] at hp; cases hp
  simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc; subst hc
  exact tstepM_loadCell (hterm := hterm) (hpk := hpk) (haf := haf) (hb := hb) (he := he) (htv' := htv') (hRk := hRk) (hi := hi) (hE := hE) (htv := htv) (hm := hm) (hRP := hRP) (hPS := hPS) (hV := fun _ _ _ _ _ _ _ h => h)

/-- (T3d-1) A protocol word read is a number in a state of its protocol (`VR`
at `word`), so it binds as `Int[x]` at a fresh index `x` valued at it. -/
theorem word_bind {ρ : Nat → Nat} {η : TEnv} {r : Idx} {P : Proto} {R : Shp} {ws : List Word}
    (hg : P.ghost = false) (h : VR ρ η (.word r P) R ws) :
    ∃ w n, ws = [w] ∧ VR (vcons n ρ) η (.intS (.var 0)) (shp .int) [w] := by
  simp only [VR] at h
  obtain ⟨n, hn, -⟩ := h.2 hg
  obtain ⟨w, rfl, hw⟩ := map_singleton hn
  exact ⟨w, n, rfl, by simp [VR, hw, ev, vins]⟩

/-- (T3d-1) **P1 + P4 at the thread, `load` of a protocol word through an own
reference** (`loadWord`): `ownLoad` reads a value of `word r P`, which
`word_bind` rebinds as `Int[x]`. -/
theorem tstepM_loadWordOwn {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {acq : Bool} {a : At} {r : Idx} {P : Proto}
    {e : Expr} (hterm : th.term = .let_ x (.load acq a) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.ptr .own (.word r P)))
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | loadOwn hp hnw _ _ _ | loadPub hp hnw _ _ _ _ | loadRgn hp hnw _ _ _ _ | loadCap hp hnw _ _ _ _ _
  | loadTorn hp hnw _ _ _ _ => exfalso; rw [hpk] at hp; cases hp; simp [wordOf] at hnw
  | loadWord hp hw hg hb =>
  rw [hpk] at hp; cases hp
  simp only [wordOf, Option.some.injEq] at hw; subst hw
  obtain ⟨lab, c, pw, ru, hea, hpw, hsto, hcty, hacc, hown, hsku, hsig⟩ :=
    ownPtr_view hi hpk htv (by simp [Cx.opaqueOK, Ty.guardT])
  have hna : ∀ N e', c.ty ≠ .array (.lit N) e' := fun N e' h => hacc (by rw [h]; simp [accs])
  obtain ⟨us, hus, ⟨ro, hro⟩, hld, hstw⟩ := ownLoad (arch := g.arch) (pw := pw) (acq := acq) (s := stOf mem pairs th)
    hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hsto hown (Fd_lay hcty).1 (Fd_lay hcty).2.1
    (fun ws => ((Fd_lay hcty).2.2.2 ws).1) (fun R ws => (Fd_VR η hcty).1) hna hsku
    (peek_cell_lyt hi.2.1 hpk hea rfl rfl).2 hsig
    (by rw [(Fd_lay hcty).2.2.1]; exact pub_accs hi.2.2.2.1 hi.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi.2.1 htv hpk rfl (by simp [Cx.opaqueOK, Ty.guardT]) hea rfl)
  obtain ⟨r', rfl⟩ := eskel_word (show etok (skel ru) = .word (.lit 0) P by rw [hsku]; rfl)
  have key : tstep g mem pairs th =
      (loadUnits g.arch pw ⟨lab, 0⟩ acq us 0 (stOf mem pairs th)).map fun (s', ws) =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, .int, ws) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, cellOf, addrOf, hpw, wordOf, Option.isSome_some,
      ↓reduceIte, hus, List.map_map]; rfl
  rw [key] at ⊢
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hro), fun r0 hr hpr0 => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨⟨s', wsr⟩, hl, rfl⟩ := hr
  obtain ⟨hvr, -, f1, f2, f3, f4, f5⟩ := hld (s', wsr) hl (hpr0)
  obtain ⟨w, n, rfl, hvr'⟩ := word_bind hg hvr
  exact ⟨CE η, EFoot_refl, ⟨vcons n ρ, η, c', rfl, hE, he, htv', bind_FInv hb (push_FInv x n hi) hvr' (Lay_int w rfl), retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
    MemInv_load hm f1 f2 f3 f4 f5 (loadUnits_relSt _ _ _ _ hl) (loadUnits_vWr _ _ _ _ hl)⟩

/-- (T3d-1) **P1 + P4 at the thread, `load` of a protocol word through a `pub`
reference** (`loadWord`): `loadPub_core`, then `word_bind`. -/
theorem tstepM_loadWordPub {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {acq : Bool} {a : At} {r : Idx} {P : Proto}
    {e : Expr} (hterm : th.term = .let_ x (.load acq a) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.ptr .pub (.word r P)))
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | loadOwn hp hnw _ _ _ | loadPub hp hnw _ _ _ _ | loadRgn hp hnw _ _ _ _ | loadCap hp hnw _ _ _ _ _
  | loadTorn hp hnw _ _ _ _ => exfalso; rw [hpk] at hp; cases hp; simp [wordOf] at hnw
  | loadWord hp hw hg hb =>
  rw [hpk] at hp; cases hp
  simp only [wordOf, Option.some.injEq] at hw; subst hw
  obtain ⟨ru, pw, lab, us, hea, hpw, hus, hsku, hne, hld, hstw⟩ :=
    loadPub_core (acq := acq) (g := g) (mem := mem) (pairs := pairs) hpk
      (by simp [Cx.opaqueOK, Ty.guardT]) hi hE htv hm
  obtain ⟨r', rfl⟩ := eskel_word (show etok (skel ru) = .word (.lit 0) P by rw [hsku]; rfl)
  have key : tstep g mem pairs th =
      (loadUnits g.arch pw ⟨lab, 0⟩ acq us 0 (stOf mem pairs th)).map fun (s', ws) =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, .int, ws) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, cellOf, addrOf, hpw, wordOf, Option.isSome_some,
      ↓reduceIte, hus, List.map_map]; rfl
  rw [key] at ⊢
  refine ⟨fun h => hne (List.map_eq_nil_iff.1 h), fun r0 hr hpr0 => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨⟨s', wsr⟩, hl, rfl⟩ := hr
  obtain ⟨hvr, -, hm'⟩ := hld s' wsr hl (hpr0)
  obtain ⟨w, n, rfl, hvr'⟩ := word_bind hg hvr
  exact ⟨CE η, EFoot_refl, ⟨vcons n ρ, η, c', rfl, hE, he, htv', bind_FInv hb (push_FInv x n hi) hvr' (Lay_int w rfl), retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩, hm'⟩

/-- (T3d-1) The stored number is in a state of the protocol (`InState`), so it
is a value of the word (`VR` at `word`). -/
theorem storeWord_val {ρ : Nat → Nat} {η : TEnv} {c₁ : Cx} {P : Proto} {r j k' : Idx} {c₂ : Nat}
    {w : Word} (hp : pwf P = true) (hsat : Sat c₁.facts ρ) (hst : InState c₁ P j c₂ k')
    (hwv : w.val = .num (ev ρ j)) :
    EnvVal (CE η) (cl ρ η.wit 0 0 (.word r P)) [w] := by
  obtain ⟨cl', hcl', hent⟩ := hst
  refine ⟨?_, ?_⟩
  · simp only [cl, VR]
    refine ⟨hp, fun _ => ?_⟩
    exact ⟨_, by simp [hwv], _, cl', _, hcl', hent ρ hsat⟩
  · simp [cl, Valid]

/-- (T3d-1) What a word store binds (`xt`) — `Unit` after a Give or a Hand, a
token after a Keep — is `Unit` with no words at runtime (option 1b). -/
def StoreBind (ρ : Nat → Nat) (η : TEnv) (σs : List Ty) (xt : Ty) : Prop :=
  VR ρ η xt (shp .unit) [] ∧ Lay σs xt .unit []

/-- (T3d-1) **P1 + P4 at the thread, a protocol word's store through an own
reference**: the value is in a state of the protocol (`storeWord_val`); one
`num` word is stored as at `storeOwn`; the binding is `Unit` at runtime
(`StoreBind`).  `pwf` comes from the cell's current value (`ownLoad`). -/
theorem storeWordOwn_core {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx c₁ c' : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v tk : At}
    {r r' i j k' : Idx} {P : Proto} {c₂ : Nat} {e : Expr} {xt : Ty}
    (hterm : th.term = .let_ x (.store rel a v (some tk)) e)
    (hpk : cx.peek a = .ok (.ptr .own (.word r P))) (hg : P.ghost = false)
    (hu : cx.use tk = .ok (.tok r' (some (P, i)), c₁)) (hj : IntIdx c₁ v j) (hst : InState c₁ P j c₂ k')
    (hb : c₁.bind x xt = .ok c') (he : Typed p c' e) (htv' : TvOK c')
    (htag : StoreBind ρ η th.σs xt)
    (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  obtain ⟨hi1, -⟩ := use_FInv hu hi
  obtain ⟨tv, htvk, hio⟩ := hj
  obtain ⟨rt, w, hev, hwv, -⟩ := atom_num hi1.2.1 htvk hio
  obtain ⟨lab, c, pw, ru, hea, hpw, hsto, hcty, hacc, hown, hsku, hsig⟩ :=
    ownPtr_view hi hpk htv (by simp [Cx.opaqueOK, Ty.guardT])
  have hna : ∀ N e', c.ty ≠ .array (.lit N) e' := fun N e' h => hacc (by rw [h]; simp [accs])
  obtain ⟨us0, -, ⟨ro, hro⟩, hld, hstw⟩ := ownLoad (arch := g.arch) (pw := pw) (acq := false)
    (s := stOf mem pairs th) hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hsto hown (Fd_lay hcty).1 (Fd_lay hcty).2.1
    (fun ws => ((Fd_lay hcty).2.2.2 ws).1) (fun R ws => (Fd_VR η hcty).1) hna hsku
    (peek_cell_lyt hi.2.1 hpk hea rfl rfl).2 hsig
    (by rw [(Fd_lay hcty).2.2.1]; exact pub_accs hi.2.2.2.1 hi.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi.2.1 htv hpk rfl (by simp [Cx.opaqueOK, Ty.guardT]) hea rfl)
  have hpwf : pwf P = true := by
    obtain ⟨_, hvr0, -⟩ := hstw
    simp only [VR] at hvr0; exact hvr0.1
  obtain ⟨r'', rfl⟩ := eskel_word (show etok (skel ru) = .word (.lit 0) P by rw [hsku]; rfl)
  have hus : accs (Ty.word r'' P) = some [.one] := by simp [accs, hg]
  have hval := (Fd_EnvVal (CE η) hcty).2 (storeWord_val (r := r) hpwf hi1.1 hst hwv)
  have hlen : [w].length = nWords [Acc.one] := rfl
  have husA : accs c.ty = some [Acc.one] := ((Fd_lay hcty).2.2.1.trans (pub_accs hi.2.2.2.1 hi.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi.2.1 htv hpk rfl (by simp [Cx.opaqueOK, Ty.guardT]) hea rfl).symm).trans hus
  have hus' : wc c.ty = some (nWords [Acc.one]) := by
    rw [(Fd_lay hcty).2.1, ← wc_of_sig hsig]; simp [wc, hus]
  have key : tstep g mem pairs th =
      (storeUnits g.k g.arch pw ⟨lab, 0⟩ rel [.one] [w] 0 (stOf mem pairs th)).map fun s' =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, .unit, []) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hev, cellOf, addrOf, hpw, hus, List.map_map]; rfl
  rw [key]
  obtain ⟨s0, hs0⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := pw) (a := ⟨lab, 0⟩) (rel := rel)
    [.one] [w] 0 (stOf mem pairs th) hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hs0), fun r hr => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨s', hs', rfl⟩ := hr
  exact ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv', bind_FInv hb hi1 htag.1 htag.2, retPw_eq hRP ((bind_ret hb).trans (use_ret hu))⟩,
    MemInv_store hm hsto hown husA hval hlen s' hs'⟩

/-! ## §15 (M4b) Stores to published cells -/

/-- **A whole-value store laid out as its cell keeps `MemInv`**, whoever owns
the cell, given no outstanding promise there. -/
theorem MemInv_storeF {g : G} {E : TEnv} {s : St} {lab : AllocLabel} {c : Cell} {us : List Acc}
    {ws : List Word} {pw : Word} {rel : Bool} (hm : MemInv g E s) (hsto : E.sto lab = some c)
    (hown : c.owner = some E.tid) (hacc : accs c.ty = some us)
    (hv : EnvVal E c.ty ws) (hlen : ws.length = nWords us) :
    ∀ s', s' ∈ storeUnits g.k g.arch pw ⟨lab, 0⟩ rel us ws 0 s → MemInv g E s' :=
  MemInv_store hm hsto hown hacc hv hlen

/-! ## §16 (M5a) Layout through `μ`, as an equality; components embed -/

/-! ### (P7) `coupledOK` through `μ`: folds and components -/

/-- (P7) Two types of one `sig` have one `fitsGranule`. -/
theorem fits_of_sig {a b : Ty} (h : sig a = sig b) : a.fitsGranule = b.fitsGranule := by
  have ha : info Ty.top (sig a) = info Ty.top a := by
    simp only [sig]; rw [info_er _ Ty.top (fun _ => rfl), info_skel]
  have hb : info Ty.top (sig b) = info Ty.top b := by
    simp only [sig]; rw [info_er _ Ty.top (fun _ => rfl), info_skel]
  simp only [Ty.fitsGranule, Ty.width]; rw [← ha, ← hb, h]

section CplAgree
variable {ρ : Nat → Nat} {W W' : Nat → Ty}

/-- (P7) **`coupledOK` does not see a guarded variable** (cf. `accs_cl_guard`):
closing it at a closed `X` is as leaving it open under a `μ`-bound entry. -/
theorem coupled_cl_guard (hW : ∀ k, W' (k + 1) = W k) (hXT : ∀ m, (W' 0).tyMentions m = false)
    (hXI : ∀ m, (W' 0).idxMentions m = false)
    (hWc : ∀ k (ke1 ke2 : KEnv), Ty.coupledOKIn ke1 (W k) = Ty.coupledOKIn ke2 (W k)) :
    ∀ (t : Ty) (c d : Nat) (ke : KEnv), ke.length = c → t.unguarded c = false →
      Ty.coupledOKIn ke (cl ρ W' c d t) = Ty.coupledOKIn (ke ++ [none]) (cl ρ W (c + 1) d t) := by
  have hI := countI_cl_agree (ρ := ρ) hW hXT hXI
  have hT := countT_cl_agree (ρ := ρ) hW hXT
  intro t
  induction t with
  | tvar j =>
      intro c d ke hl hg
      have hk : j ≠ c := by simpa [Ty.unguarded] using hg
      by_cases h1 : j < c
      · simp only [cl, h1, show j < c + 1 by omega, ite_true]
        exact TermSound.CoupledCl.coupledOKIn_agree (.tvar j) (j + 1) ke (ke ++ [none]) (by simp [tb])
          (fun k hk' => by rw [List.getElem?_append_left (by omega)])
      · have h2 : ¬ j < c + 1 := by omega
        have e : j - c = (j - (c + 1)) + 1 := by omega
        simp only [cl, h1, h2, ite_false]; rw [e, hW]; exact hWc _ _ _
  | prod a b iha ihb =>
      intro c d ke hl hg
      simp only [Ty.unguarded, Bool.or_eq_false_iff] at hg
      simp only [cl, Ty.coupledOKIn, iha c d ke hl hg.1, ihb c d ke hl hg.2]
  | sum a b iha ihb =>
      intro c d ke hl hg
      simp only [Ty.unguarded, Bool.or_eq_false_iff] at hg
      simp only [cl, Ty.coupledOKIn, iha c d ke hl hg.1, ihb c d ke hl hg.2]
  | array i t ih =>
      intro c d ke hl hg; simp only [cl, Ty.coupledOKIn]
      exact ih c d ke hl (by simpa [Ty.unguarded] using hg)
  | iall t ih =>
      intro c d ke hl hg; simp only [cl, Ty.coupledOKIn]
      exact ih c (d + 1) ke hl (by simpa [Ty.unguarded] using hg)
  | refine t ψ ih =>
      intro c d ke hl hg; simp only [cl, Ty.coupledOKIn]
      exact ih c d ke hl (by simpa [Ty.unguarded] using hg)
  | mu t ih =>
      intro c d ke hl hg; simp only [cl, Ty.coupledOKIn]
      exact ih (c + 1) d (none :: ke) (by simp [hl]) (by simpa [Ty.unguarded] using hg)
  | tex κ t ih =>
      intro c d ke hl hg
      have hf := fits_of_sig (sig_cl_guard (ρ := ρ) hW (.tex κ t) c d hg)
      simp only [cl] at hf
      have hb := ih (c + 1) d (some κ :: ke) (by simp [hl]) (by simpa [Ty.unguarded] using hg)
      simp only [cl, Ty.coupledOKIn, hf, hT t (c + 1) d 0 (by omega)]
      rw [hb]; rfl
  | iex t ih =>
      intro c d ke hl hg
      have hf := fits_of_sig (sig_cl_guard (ρ := ρ) hW (.iex t) c d hg)
      simp only [cl] at hf
      have hb := ih c (d + 1) ke hl (by simpa [Ty.unguarded] using hg)
      simp only [cl, Ty.coupledOKIn, hf, hI t c (d + 1) 0, hb]
  | _ => intro c d ke _ _; simp [cl, Ty.coupledOKIn]

end CplAgree

/-- (P7) **Unfolding a closed guarded `μ` type keeps `coupledOK`**, both ways. -/
theorem coupledOK_unfold {ρ : Nat → Nat} {W : Nat → Ty} (hW : ∀ k, Clo (W k)) {s : Ty}
    (hg : s.unguarded 0 = false) :
    Ty.coupledOKIn [] (cl ρ W 0 0 (unfold1 (.mu s))) = Ty.coupledOKIn [] (cl ρ W 0 0 (.mu s)) := by
  have e1 : unfold1 (.mu s) = substTs [.mu s] 0 0 s := substT_eq (.mu s) s 0 0
  have e2 := cl_substTs [.mu s] 0 0 (ρ := ρ) (W₀ := W) (W₁ := wcons (cl ρ W 0 0 (.mu s)) W)
    (fun k hk => absurd hk (Nat.not_lt_zero _))
    (fun j σ hj => by
      cases j with
      | zero => simp at hj; subst hj; simp [wcons]
      | succ j => simp at hj)
    (fun k => by simp [wcons]) s 0 0
  simp only [Nat.add_zero] at e2
  rw [e1, e2]
  have hX := Clo_cl0 (ρ := ρ) hW (.mu s)
  have := coupled_cl_guard (ρ := ρ) (W := W) (W' := wcons (cl ρ W 0 0 (.mu s)) W) (fun k => by simp [wcons])
    (fun m => by simpa [wcons] using hX.1 m) (fun m => by simpa [wcons] using hX.2 m)
    (fun k ke1 ke2 => TermSound.CoupledCl.coupledOKIn_closed (hW k).1 ke1 ke2) s 0 0 [] rfl hg
  rw [this]; rfl

/-- (P7) A folded type of a coupled type is coupled. -/
theorem coupledOK_Fd {T U : Ty} (h : Fd T U) (hU : Ty.coupledOKIn [] U = true) :
    Ty.coupledOKIn [] T = true := by
  revert hU
  induction h with
  | refl => exact id
  | fold hW hg _ _ ih => intro hU; exact ih (by rw [coupledOK_unfold hW hg]; exact hU)

/-- (P7) Every component of a coupled type is coupled. -/
theorem coupledOK_AtOff {T U : Ty} {o : Nat} (h : AtOff T o U) (hT : Ty.coupledOKIn [] T = true) :
    Ty.coupledOKIn [] U = true := by
  revert hT
  induction h with
  | here _ => exact id
  | fst _ ih => intro hT; simp only [Ty.coupledOKIn, Bool.and_eq_true] at hT; exact ih hT.1
  | snd _ _ ih => intro hT; simp only [Ty.coupledOKIn, Bool.and_eq_true] at hT; exact ih hT.2
  | elem _ _ _ ih => intro hT; simp only [Ty.coupledOKIn] at hT; exact ih hT
  | mu hW hg _ ih => intro hT; exact ih (by rw [coupledOK_unfold hW hg]; exact hT)
  | fold hW hg _ _ ih => intro hT; rw [← coupledOK_unfold hW hg]; exact ih hT

section NoOwnAgree
variable {ρ : Nat → Nat} {W W' : Nat → Ty}

/-- (B.3) Closing the `μ`-bound variable at any `X` reaches no more `noOwn`
than leaving it open (`noOwnIn` answers `true` at a `μ`-bound entry). -/
theorem noOwn_cl_le (hW : ∀ k, W' (k + 1) = W k)
    (hWc : ∀ k (ke1 ke2 : KEnv), Ty.noOwnIn ke1 (W k) = Ty.noOwnIn ke2 (W k)) :
    ∀ (t : Ty) (c d : Nat) (ke : KEnv), ke.length = c → Ty.noOwnIn ke (cl ρ W' c d t) = true →
      Ty.noOwnIn (ke ++ [none]) (cl ρ W (c + 1) d t) = true := by
  intro t
  induction t with
  | tvar j =>
      intro c d ke hl h
      subst hl
      by_cases h1 : j < ke.length
      · simp only [cl, h1, show j < ke.length + 1 by omega, ite_true] at h ⊢
        simp only [Ty.noOwnIn, KEnv.ask] at h ⊢
        rwa [List.getElem?_append_left h1]
      · by_cases h2 : j = ke.length
        · subst h2
          simp only [cl, Nat.lt_irrefl, show ke.length < ke.length + 1 by omega, ite_true]
          simp only [Ty.noOwnIn, KEnv.ask, List.getElem?_append_right (Nat.le_refl _), Nat.sub_self,
            List.getElem?_cons_zero]
        · have h3 : ¬ j < ke.length + 1 := by omega
          have e : j - ke.length = (j - (ke.length + 1)) + 1 := by omega
          simp only [cl, h1, h3, ite_false] at h ⊢
          rw [e, hW] at h; rw [hWc _ _ ke]; exact h
  | prod a b iha ihb =>
      intro c d ke hl h
      simp only [cl, Ty.noOwnIn, Bool.and_eq_true] at h ⊢; exact ⟨iha c d ke hl h.1, ihb c d ke hl h.2⟩
  | sum a b iha ihb =>
      intro c d ke hl h
      simp only [cl, Ty.noOwnIn, Bool.and_eq_true] at h ⊢; exact ⟨iha c d ke hl h.1, ihb c d ke hl h.2⟩
  | array i t ih => intro c d ke hl h; simp only [cl, Ty.noOwnIn] at h ⊢; exact ih c d ke hl h
  | refine t ψ ih => intro c d ke hl h; simp only [cl, Ty.noOwnIn] at h ⊢; exact ih c d ke hl h
  | iall t ih => intro c d ke hl h; simp only [cl, Ty.noOwnIn] at h ⊢; exact ih c (d + 1) ke hl h
  | iex t ih => intro c d ke hl h; simp only [cl, Ty.noOwnIn] at h ⊢; exact ih c (d + 1) ke hl h
  | mu t ih =>
      intro c d ke hl h; simp only [cl, Ty.noOwnIn] at h ⊢
      exact ih (c + 1) d (none :: ke) (by simp [hl]) h
  | tex κ t ih =>
      intro c d ke hl h; simp only [cl, Ty.noOwnIn, Bool.and_eq_true] at h ⊢
      exact ⟨h.1, ih (c + 1) d (some κ :: ke) (by simp [hl]) h.2⟩
  | ptr m t ih =>
      intro c d ke hl h
      cases m with
      | own => simp [cl, clM, Ty.noOwnIn] at h
      | pub => simp only [cl, clM, Ty.noOwnIn] at h ⊢; exact ih c d ke hl h
      | rgn _ => simp [cl, clM, Ty.noOwnIn]
  | ptrOpt m t ih =>
      intro c d ke hl h
      cases m with
      | own => simp [cl, clM, Ty.noOwnIn] at h
      | pub => simp only [cl, clM, Ty.noOwnIn] at h ⊢; exact ih c d ke hl h
      | rgn _ => simp [cl, clM, Ty.noOwnIn]
  | loc m t ih =>
      intro c d ke hl h
      cases m with
      | own => simp [cl, clM, Ty.noOwnIn] at h
      | pub => simp only [cl, clM, Ty.noOwnIn] at h ⊢; exact ih c d ke hl h
      | rgn _ => simp [cl, clM, Ty.noOwnIn]
  | _ => intro c d ke _ _; simp [cl, Ty.noOwnIn]

/-- (B.3) Conversely, closing the `μ`-bound variable at a `noOwn` `X` keeps
`noOwn`. -/
theorem noOwn_cl_ge (hW : ∀ k, W' (k + 1) = W k)
    (hWc : ∀ k (ke1 ke2 : KEnv), Ty.noOwnIn ke1 (W k) = Ty.noOwnIn ke2 (W k))
    (hX : ∀ ke : KEnv, Ty.noOwnIn ke (W' 0) = true) :
    ∀ (t : Ty) (c d : Nat) (ke : KEnv), ke.length = c → Ty.noOwnIn (ke ++ [none]) (cl ρ W (c + 1) d t) = true →
      Ty.noOwnIn ke (cl ρ W' c d t) = true := by
  intro t
  induction t with
  | tvar j =>
      intro c d ke hl h
      subst hl
      by_cases h1 : j < ke.length
      · simp only [cl, h1, show j < ke.length + 1 by omega, ite_true] at h ⊢
        simp only [Ty.noOwnIn, KEnv.ask] at h ⊢
        rwa [List.getElem?_append_left h1] at h
      · by_cases h2 : j = ke.length
        · subst h2
          simp only [cl, Nat.lt_irrefl, ite_false, Nat.sub_self]
          exact hX ke
        · have h3 : ¬ j < ke.length + 1 := by omega
          have e : j - ke.length = (j - (ke.length + 1)) + 1 := by omega
          simp only [cl, h1, h3, ite_false] at h ⊢
          rw [e, hW, hWc _ _ (ke ++ [none])]; exact h
  | prod a b iha ihb =>
      intro c d ke hl h
      simp only [cl, Ty.noOwnIn, Bool.and_eq_true] at h ⊢; exact ⟨iha c d ke hl h.1, ihb c d ke hl h.2⟩
  | sum a b iha ihb =>
      intro c d ke hl h
      simp only [cl, Ty.noOwnIn, Bool.and_eq_true] at h ⊢; exact ⟨iha c d ke hl h.1, ihb c d ke hl h.2⟩
  | array i t ih => intro c d ke hl h; simp only [cl, Ty.noOwnIn] at h ⊢; exact ih c d ke hl h
  | refine t ψ ih => intro c d ke hl h; simp only [cl, Ty.noOwnIn] at h ⊢; exact ih c d ke hl h
  | iall t ih => intro c d ke hl h; simp only [cl, Ty.noOwnIn] at h ⊢; exact ih c (d + 1) ke hl h
  | iex t ih => intro c d ke hl h; simp only [cl, Ty.noOwnIn] at h ⊢; exact ih c (d + 1) ke hl h
  | mu t ih =>
      intro c d ke hl h; simp only [cl, Ty.noOwnIn] at h ⊢
      exact ih (c + 1) d (none :: ke) (by simp [hl]) h
  | tex κ t ih =>
      intro c d ke hl h; simp only [cl, Ty.noOwnIn, Bool.and_eq_true] at h ⊢
      exact ⟨h.1, ih (c + 1) d (some κ :: ke) (by simp [hl]) h.2⟩
  | ptr m t ih =>
      intro c d ke hl h
      cases m with
      | own => simp [cl, clM, Ty.noOwnIn] at h
      | pub => simp only [cl, clM, Ty.noOwnIn] at h ⊢; exact ih c d ke hl h
      | rgn _ => simp [cl, clM, Ty.noOwnIn]
  | ptrOpt m t ih =>
      intro c d ke hl h
      cases m with
      | own => simp [cl, clM, Ty.noOwnIn] at h
      | pub => simp only [cl, clM, Ty.noOwnIn] at h ⊢; exact ih c d ke hl h
      | rgn _ => simp [cl, clM, Ty.noOwnIn]
  | loc m t ih =>
      intro c d ke hl h
      cases m with
      | own => simp [cl, clM, Ty.noOwnIn] at h
      | pub => simp only [cl, clM, Ty.noOwnIn] at h ⊢; exact ih c d ke hl h
      | rgn _ => simp [cl, clM, Ty.noOwnIn]
  | _ => intro c d ke _ _; simp [cl, Ty.noOwnIn]

end NoOwnAgree

/-- (B.3) **Unfolding a closed `μ` type keeps `noOwn`**, both ways (no guard
needed: `noOwnIn` assumes the recursive variable is `noOwn`, and the unfolding
puts the `μ` type itself there). -/
theorem noOwn_unfold {ρ : Nat → Nat} {W : Nat → Ty} (hW : ∀ k, Clo (W k)) {s : Ty} :
    Ty.noOwnIn [] (cl ρ W 0 0 (unfold1 (.mu s))) = Ty.noOwnIn [] (cl ρ W 0 0 (.mu s)) := by
  have e1 : unfold1 (.mu s) = substTs [.mu s] 0 0 s := substT_eq (.mu s) s 0 0
  have e2 := cl_substTs [.mu s] 0 0 (ρ := ρ) (W₀ := W) (W₁ := wcons (cl ρ W 0 0 (.mu s)) W)
    (fun k hk => absurd hk (Nat.not_lt_zero _))
    (fun j σ hj => by
      cases j with
      | zero => simp at hj; subst hj; simp [wcons]
      | succ j => simp at hj)
    (fun k => by simp [wcons]) s 0 0
  simp only [Nat.add_zero] at e2
  rw [e1, e2]
  have hWc : ∀ k (ke1 ke2 : KEnv), Ty.noOwnIn ke1 (W k) = Ty.noOwnIn ke2 (W k) :=
    fun k ke1 ke2 => TermSound.NoOwnCl.noOwnIn_closed (hW k).1 ke1 ke2
  have hw' : ∀ k, wcons (cl ρ W 0 0 (.mu s)) W (k + 1) = W k := fun k => by simp [wcons]
  have eR : Ty.noOwnIn [] (cl ρ W 0 0 (.mu s)) = Ty.noOwnIn ([] ++ [none]) (cl ρ W (0 + 1) 0 s) := by
    simp [cl, Ty.noOwnIn]
  cases hb : Ty.noOwnIn [] (cl ρ W 0 0 (.mu s)) with
  | false =>
      cases hL : Ty.noOwnIn [] (cl ρ (wcons (cl ρ W 0 0 (.mu s)) W) 0 0 s) with
      | false => rfl
      | true =>
          have := noOwn_cl_le hw' hWc s 0 0 [] rfl hL
          rw [eR, this] at hb; cases hb
  | true =>
      have hX : ∀ ke : KEnv, Ty.noOwnIn ke (wcons (cl ρ W 0 0 (.mu s)) W 0) = true := by
        intro ke
        show Ty.noOwnIn ke (cl ρ W 0 0 (.mu s)) = true
        rw [TermSound.NoOwnCl.noOwnIn_closed (Clo_cl hW ρ (.mu s)).1 ke []]; exact hb
      exact noOwn_cl_ge hw' hWc hX s 0 0 [] rfl (by rw [← eR]; exact hb)

/-- (B.3) A folded type of a `noOwn` type is `noOwn`. -/
theorem noOwn_Fd {T U : Ty} (h : Fd T U) (hU : Ty.noOwnIn [] U = true) :
    Ty.noOwnIn [] T = true := by
  revert hU
  induction h with
  | refl => exact id
  | fold hW _ _ _ ih => intro hU; exact ih (by rw [noOwn_unfold hW]; exact hU)

/-- (S7) Substituting a region-free type for the innermost bound variable keeps
region-freedom. -/
theorem rgnFree_cl_shift {ρ : Nat → Nat} {W W₁ : Nat → Ty} (h0 : rgnFree (W₁ 0) = true)
    (hs : ∀ k, W₁ (k + 1) = W k) (t : Ty) :
    ∀ (c d : Nat), rgnFree (cl ρ W (c + 1) d t) = true → rgnFree (cl ρ W₁ c d t) = true := by
  induction t with
  | tvar k =>
      intro c d h
      simp only [cl] at h ⊢
      by_cases h1 : k < c
      · simp [h1, rgnFree]
      · by_cases h2 : k = c
        · subst h2; simpa using h0
        · have h3 : ¬ k < c + 1 := by omega
          have e : k - c = (k - (c + 1)) + 1 := by omega
          simp only [h1, h3, ↓reduceIte] at h ⊢
          rw [e, hs]; exact h
  | ptr μ t _ => intro c d h; cases μ <;> simp_all [rgnFree, cl, clM]
  | ptrOpt μ t _ => intro c d h; cases μ <;> simp_all [rgnFree, cl, clM]
  | loc μ t _ => intro c d h; cases μ <;> simp_all [rgnFree, cl, clM]
  | prod a b iha ihb =>
      intro c d h; simp only [cl, rgnFree, Bool.and_eq_true] at h ⊢; exact ⟨iha c d h.1, ihb c d h.2⟩
  | sum a b iha ihb =>
      intro c d h; simp only [cl, rgnFree, Bool.and_eq_true] at h ⊢; exact ⟨iha c d h.1, ihb c d h.2⟩
  | array i t ih => intro c d h; simp only [cl, rgnFree] at h ⊢; exact ih c d h
  | mu t ih => intro c d h; simp only [cl, rgnFree] at h ⊢; exact ih (c + 1) d h
  | tex κ t ih => intro c d h; simp only [cl, rgnFree] at h ⊢; exact ih (c + 1) d h
  | iall t ih => intro c d h; simp only [cl, rgnFree] at h ⊢; exact ih c (d + 1) h
  | iex t ih => intro c d h; simp only [cl, rgnFree] at h ⊢; exact ih c (d + 1) h
  | refine t ψ ih => intro c d h; simp only [cl, rgnFree] at h ⊢; exact ih c d h
  | _ => intro c d _; simp [cl, rgnFree]

/-- (S7) Unfolding a closed `μ` type keeps region-freedom. -/
theorem rgnFree_unfold {ρ : Nat → Nat} {W : Nat → Ty} {s : Ty} (h : rgnFree (cl ρ W 0 0 (.mu s)) = true) :
    rgnFree (cl ρ W 0 0 (unfold1 (.mu s))) = true := by
  have e1 : unfold1 (.mu s) = substTs [.mu s] 0 0 s := substT_eq (.mu s) s 0 0
  have e2 := cl_substTs [.mu s] 0 0 (ρ := ρ) (W₀ := W) (W₁ := wcons (cl ρ W 0 0 (.mu s)) W)
    (fun k hk => absurd hk (Nat.not_lt_zero _))
    (fun j σ hj => by
      cases j with
      | zero => simp at hj; subst hj; simp [wcons]
      | succ j => simp at hj)
    (fun k => by simp [wcons]) s 0 0
  simp only [Nat.add_zero] at e2
  rw [e1, e2]
  have h1 : rgnFree (cl ρ W (0 + 1) 0 s) = true := by simp only [cl, rgnFree] at h; exact h
  exact rgnFree_cl_shift (W₁ := wcons (cl ρ W 0 0 (.mu s)) W) (show rgnFree (cl ρ W 0 0 (.mu s)) = true from h)
    (fun k => by simp [wcons]) s 0 0 h1

/-- (S7) A folded type of a region-free type is region-free. -/
theorem rgnFree_Fd {T U : Ty} (h : Fd T U) (hU : rgnFree U = true) : rgnFree T = true := by
  revert hU
  induction h with
  | refl => exact id
  | fold _ _ _ _ ih => intro hU; exact ih (rgnFree_unfold hU)

/-- (S7) The scope of `publish a` (until R2): the published cell's type is
region-free (`rgnFree`), through an own pointer or an own buffer locative.  A
type variable passes: its witness is region-free (`WitR`), since `publish`'s
`sharedOKIn` makes every unguarded one `share` and the scope checks `share`
witnesses where they are chosen (`call`, `tail`, `packT`). -/
def PubScope (cx : Cx) (a : At) : Prop :=
  ∀ t, cx.peek a = .ok t → ∀ μ u, (t = .ptr μ u ∨ ∃ ψ, t = .refine (.loc μ u) ψ) → rgnFree u = true

/-- (B.3) Every component of a `noOwn` type is `noOwn`. -/
theorem noOwn_AtOff {T U : Ty} {o : Nat} (h : AtOff T o U) (hT : Ty.noOwnIn [] T = true) :
    Ty.noOwnIn [] U = true := by
  revert hT
  induction h with
  | here _ => exact id
  | fst _ ih => intro hT; simp only [Ty.noOwnIn, Bool.and_eq_true] at hT; exact ih hT.1
  | snd _ _ ih => intro hT; simp only [Ty.noOwnIn, Bool.and_eq_true] at hT; exact ih hT.2
  | elem _ _ _ ih => intro hT; simp only [Ty.noOwnIn] at hT; exact ih hT
  | mu hW _ _ ih => intro hT; exact ih (by rw [noOwn_unfold hW]; exact hT)
  | fold hW _ _ _ ih => intro hT; rw [← noOwn_unfold hW]; exact ih hT

/-! ### The publish family's shared steps

`publish`, and in TermC1Rgn `region` and `intoRgn`, publish one own cell: invert the
own reference (`ownPtr_inv`, `ownBuf_inv`), derive the closed cell type's facts (`pubTyFacts`,
`pubTyFactsBuf`), and take the footprint, extension and `MemInv` of the publish (`pubCell_post`) at
`pubEnvAt`. -/

/-- `tb` of a use's payload, from the context's `TvOK`. -/
theorem tb_use {cx c₁ : Cx} {a : At} {t : Ty} (hu : cx.use a = .ok (t, c₁)) (htv : TvOK cx) :
    tb c₁.ke.length t = true := by
  have h := (use_TvOK hu htv).2.1
  rw [← (use_TvOK hu htv).2.2] at h
  exact h

/-- The closed-type facts `MemInv_publish` asks of a published own cell (whole-cell form), from the
payload's facts at the use site. -/
theorem pubTyFacts {p : Prog} {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {K : TEnv → List Word → Prop}
    {c₁ : Cx} {env : Env} {u : Ty} {c : Cell}
    (hi1 : FInv ρ η σs K c₁ env) (hE : EnvOK p η) (htbu : tb c₁.ke.length u = true)
    (hcty : Fd c.ty (cl ρ η.wit 0 0 u)) (hacc : accs c.ty ≠ none)
    (hcu : Ty.coupledOKIn c₁.ke u = true) (hnu : Ty.noOwnIn c₁.ke u = true) (hru : rgnFree u = true) :
    (∀ b S, SegOf c.ty b S → accs S ≠ none → TearOK S) ∧ Ty.coupledOKIn [] c.ty = true ∧
      Ty.noOwnIn [] c.ty = true ∧ rgnFree c.ty = true := by
  have hcc := coupledOK_cl0 ρ η.wit c₁.ke (fun k => (hE.2.1 k).1) (fun k _ hk => hi1.2.2.2.2.2.2.2.1 k hk) hcu htbu
  refine ⟨fun b S hseg _ => ?_, coupledOK_Fd hcty hcc,
    noOwn_Fd hcty (NoOwnCl.noOwn_cl0 ρ η.wit c₁.ke (fun k => (hE.2.1 k).1)
      (fun k _ hk => hi1.2.2.2.2.2.2.2.2.2.1 k hk) u hnu htbu),
    rgnFree_Fd hcty (rgnFree_cl0 ρ η.wit c₁.ke (fun k hk => hi1.2.2.2.2.2.2.2.2.2.2 k hk) hcu hru)⟩
  obtain ⟨-, rfl⟩ := SegOf_lay hacc hseg
  exact TearOK_Fd hcty (TearOK_of_cpl hcc)

/-- The closed-type facts `MemInv_publish` asks of a published own buffer cell, from the buffer
type's facts at the use site. -/
theorem pubTyFactsBuf {p : Prog} {g : G} {s : St} {ρ : Nat → Nat} {η : TEnv} {σs : List Ty}
    {K : TEnv → List Word → Prop} {c₁ : Cx} {env : Env} {n : Idx} {u : Ty} {l : AllocLabel} {o : Nat} {c : Cell}
    (hi1 : FInv ρ η σs K c₁ env) (hE : EnvOK p η) (hm : MemInv g (CE η) s) (hsto : η.sto l = some c)
    (hown : c.owner = some η.tid) (htbu : tb c₁.ke.length (.array n u) = true)
    (hat : AtOff c.ty o (cl ρ η.wit 0 0 (.array n u)))
    (hcu : Ty.coupledOKIn c₁.ke (.array n u) = true) (hnu : Ty.noOwnIn c₁.ke (.array n u) = true)
    (hru : rgnFree (.array n u) = true) :
    (∀ b S, SegOf c.ty b S → accs S ≠ none → TearOK S) ∧ Ty.coupledOKIn [] c.ty = true ∧
      Ty.noOwnIn [] c.ty = true ∧ rgnFree c.ty = true := by
  have hcc := coupledOK_cl0 ρ η.wit c₁.ke (fun k => (hE.2.1 k).1) (fun k _ hk => hi1.2.2.2.2.2.2.2.1 k hk) hcu htbu
  have harr : c.ty = cl ρ η.wit 0 0 (.array n u) := by
    obtain ⟨vals, hcell, -⟩ := hm.2.1 l c hsto hown
    rcases LayT_of_CellOK hcell with ha | ⟨N, S, hT, ha⟩
    · exact absurd (accs_AtOff hat ha) (by simp [cl, accs])
    · exact (AtOff_arr_here hat hT ha (by simp [cl, accs])).symm
  refine ⟨fun b S hseg ha => ?_, by rw [harr]; exact hcc, ?_, ?_⟩
  · rcases hseg with ⟨-, rfl, -⟩ | ⟨N, usS, j, hT, -, -, -⟩
    · exact absurd (accs_AtOff hat ha) (by simp [cl, accs])
    · have e1 := AtOff_arr_here hat hT ha (by simp [cl, accs])
      rw [hT] at e1
      simp only [cl, Ty.array.injEq] at e1
      obtain ⟨-, rfl⟩ := e1
      simp only [cl, Ty.coupledOK, Ty.coupledOKIn] at hcc; exact TearOK_of_cpl hcc
  · rw [harr]
    exact NoOwnCl.noOwn_cl0 ρ η.wit c₁.ke (fun k => (hE.2.1 k).1)
      (fun k _ hk => hi1.2.2.2.2.2.2.2.2.2.1 k hk) _ hnu htbu
  · rw [harr]
    exact rgnFree_cl0 ρ η.wit c₁.ke (fun k hk => hi1.2.2.2.2.2.2.2.2.2.2 k hk) hcu hru

/-- Inverting an own-pointer use: the cell, its handle word, and the layout. -/
theorem ownPtr_inv {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {K : TEnv → List Word → Prop} {cx c₁ : Cx}
    {env : Env} {a : At} {u : Ty} (hu : cx.use a = .ok (.ptr .own u, c₁)) (hi : FInv ρ η σs K cx env) :
    FInv ρ η σs K c₁ env ∧ ∃ lab c pw μr ru, evalAt env a = some (.ptr μr ru, [pw]) ∧
      pw.val = .loc ⟨lab, 0⟩ 0 ∧ η.sto lab = some c ∧ Fd c.ty (cl ρ η.wit 0 0 u) ∧ c.owner = some η.tid ∧
      accs c.ty ≠ none ∧ Lay σs (.ptr .own u) (.ptr μr ru) [pw] := by
  obtain ⟨hi1, rt, ws, hea, hv, hl⟩ := use_FInv hu hi
  obtain ⟨μ', u', rfl, -, -⟩ := eskel_eq_ptr (by simpa [close, substTs, skel, etok] using hl.2.1)
  simp only [VR] at hv
  obtain ⟨⟨lab, off⟩, c0, hws, hoff, hsto, hcty, hmode, hacc⟩ := hv
  simp only at hoff; subst hoff
  obtain ⟨pw, rfl, hpw⟩ : ∃ pw, ws = [pw] ∧ pw.val = .loc ⟨lab, 0⟩ 0 := by
    match ws, hws with
    | [pw], h => exact ⟨pw, rfl, by simpa using h⟩
    | [], h => simp at h
    | _ :: _ :: _, h => simp at h
  exact ⟨hi1, lab, c0, pw, μ', u', hea, hpw, hsto, hcty, hmode, hacc, hl⟩

/-- Inverting an own-buffer use: the runtime handle type and the layout at any result mode with the
same skeleton and layout mode. -/
theorem ownBuf_inv {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {K : TEnv → List Word → Prop} {cx c₁ : Cx}
    {env : Env} {a : At} {n k : Idx} {u : Ty}
    (hu : cx.use a = .ok (.refine (.loc .own (.array n u)) (.ini k), c₁)) (hi : FInv ρ η σs K cx env) :
    FInv ρ η σs K c₁ env ∧ ∃ μr nr ur ψ wsb, evalAt env a = some (.refine (.loc μr (.array nr ur)) ψ, wsb) ∧
      VR ρ η (.refine (.loc .own (.array n u)) (.ini k)) (shp (.refine (.loc μr (.array nr ur)) ψ)) wsb ∧
      ∀ ν νr, skelM νr = skelM ν → modeC 0 νr = modeC 0 ν →
        Lay σs (.refine (.loc ν (.array n u)) (.ini k)) (.refine (.loc νr (.array nr ur)) ψ) wsb := by
  obtain ⟨hi1, rb, wsb, hea, hvb, hlb⟩ := use_FInv hu hi
  have hs' : etok (skel rb) = rf (.loc (skelM .own) (.array (.lit 0) (etok (skel (close σs u))))) := by
    rw [hlb.2.1]; rfl
  obtain ⟨μr, nr, ur, ψ, rfl, -, hsu⟩ := buf_runtime' hs'
  refine ⟨hi1, μr, nr, ur, ψ, wsb, hea, hvb, fun ν νr hs hc => ?_⟩
  obtain ⟨h1, -, h3, h4⟩ := hlb
  refine ⟨h1, ?_, h3, h4.1, ?_⟩
  · rw [close_refine]
    show etok (rf (skel (.loc νr (.array nr ur)))) = etok (rf (skel (close σs (.loc ν (.array n u)))))
    rw [skel_close_locArr]
    show rf (.loc (skelM νr) (.array (.lit 0) (etok (skel ur)))) = _
    rw [hsu, hs]; rfl
  · have hb := (buf_lyt h4.2 rfl).2
    simp only [close, substTs, lyt, etok, anyB_zero, Bool.false_eq_true, ite_false, idxC, ofMs] at hb ⊢
    rw [hc, hb]

/-- A pointer's layout does not depend on its mode beyond `skelM`/`modeC`. -/
theorem Lay_ptr_remode {σs : List Ty} {μ μr ν νr : Mode} {u ru : Ty} {ws : List Word}
    (h : Lay σs (.ptr μ u) (.ptr μr ru) ws) (hs : skelM νr = skelM ν) (hc : modeC 0 νr = modeC 0 ν) :
    Lay σs (.ptr ν u) (.ptr νr ru) ws := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := h
  refine ⟨by simpa [ShapeC, accs] using h1, ?_, by simpa [wc, accs] using h3, by simpa [Valid] using h4, ?_⟩
  · simp only [close_ptr, skel, etok, Ty.ptr.injEq] at h2 ⊢; exact ⟨hs, h2.2⟩
  · simp only [close_ptr, lyt, etok, Ty.ptr.injEq] at h5 ⊢; exact ⟨hc, h5.2⟩

/-- The Σ after publishing own cell `lab` at `V` (seen), with region counter `Rd`
(`publish`, `intoRgn`: `η.rid`; `region`: `η.rid + 1`). -/
def pubEnvAt (η : TEnv) (lab : AllocLabel) (V : Ts) (Rd : Nat) : TEnv :=
  η.withSto η.sto η.ini (pubP η lab V) (pubS η lab) η.box Rd

/-- After publishing, the cell has a frontier and is seen. -/
theorem pubEnvAt_seen (η : TEnv) (lab : AllocLabel) (V : Ts) (Rd : Nat) :
    (CE (pubEnvAt η lab V Rd)).pfr lab ≠ none ∧ (CE (pubEnvAt η lab V Rd)).seen lab :=
  ⟨by simp [pubEnvAt, TEnv.withSto, CE, pubP], Or.inl rfl⟩

/-- **Publishing one own cell**: the footprint, the extension and `MemInv` after the release fence,
from the cell's closed-type facts, `NoHold` and the plant gate. -/
theorem pubCell_post {p : Prog} {g : G} {η : TEnv} {s : St} {lab : AllocLabel} {c : Cell} {Rd : Nat}
    (hE : EnvOK p η) (hm : MemInv g (CE η) s) (hsto : η.sto lab = some c) (hown : c.owner = some η.tid)
    (hR : η.rid ≤ Rd)
    (hF : (∀ b S, SegOf c.ty b S → accs S ≠ none → TearOK S) ∧ Ty.coupledOKIn [] c.ty = true ∧
      Ty.noOwnIn [] c.ty = true ∧ rgnFree c.ty = true)
    (hnh : NoHold (CE η) s lab) (hgp : g.pf lab) :
    EFootP g (CE η) (CE (pubEnvAt η lab s.vs.vWr Rd)) s (fenceS s .st) ∧ Ext η (pubEnvAt η lab s.vs.vWr Rd) ∧
      MemInv g (CE (pubEnvAt η lab s.vs.vWr Rd)) (fenceS s .st) :=
  ⟨EFoot_pub (hgp := hgp) rfl rfl rfl rfl rfl ⟨c, hsto, hown⟩ (fun _ => rfl) (fun _ => Iff.rfl) hnh.2.2,
   Ext_withSto hE.2.1 (fun _ _ h => h) (fun _ => Nat.le_refl _) (pubP_mono η lab _) (fun _ h => Or.inr h) (hR := hR),
   MemInv_publish (E := CE η) (hF := PubWin_of_NoHold (E := CE η) hm hsto hown hnh)
     hm hsto hown rfl rfl rfl rfl rfl rfl rfl hF.1 hF.2.1 hF.2.2.1 hF.2.2.2⟩

/-- **P1 + P4 at the thread, `publish`** (D3 M3): an own reference, or an own
buffer handle, becomes `pub`; the view publishes its cell (`pubP`, `pubS`). -/
theorem tstepM_publish {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {a : At} {e : Expr}
    (hterm : th.term = .let_ x (.publish a) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hsc : PubScope cx a)
    (hwin : ∀ rt ws ad, evalAt th.env a = some (rt, ws) → ws.map (·.val) = [.loc ad 0] →
      NoHold (CE η) (stOf mem pairs th) ad.label)
    (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hPb : ∀ y a e rt ws ad, th.term = .let_ y (.publish a) e → evalAt th.env a = some (rt, ws) →
      ws.map (·.val) = [.loc ad 0] → g.pf ad.label := by exact fun _ _ _ _ _ _ _ _ _ => trivial) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMFP p g (CE η) (stOf mem pairs th) th r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | publish hu hsh hb =>
    obtain ⟨u, c₁, hu, hsh, hb⟩ : ∃ u c₁, cx.use a = .ok (.ptr .own u, c₁) ∧
        Ty.sharedOKIn c₁.ke (.ptr .pub u) = true ∧ c₁.bind x (.ptr .pub u) = .ok c' := ⟨_, _, hu, hsh, hb⟩
    obtain ⟨hi1, lab, c, pw, μr, ru, hea, hpw, hsto, hcty, hown, hacc, hl⟩ := ownPtr_inv hu hi
    have hwsv : [pw].map (·.val) = [.loc ⟨lab, 0⟩ 0] := by simp [hpw]
    simp only [Ty.sharedOKIn, Bool.and_eq_true] at hsh
    have hF := pubTyFacts hi1 hE (by simpa [tb] using tb_use hu htv) hcty hacc hsh.1.1 hsh.1.2
      (hsc _ (use_cases hu).1 _ _ (Or.inl rfl))
    obtain ⟨hfoot, hx, hmi⟩ := pubCell_post (Rd := η.rid) hE hm hsto hown (Nat.le_refl _) hF
      (hwin _ _ ⟨lab, 0⟩ hea hwsv) (hPb x a e _ _ ⟨lab, 0⟩ hterm hea hwsv)
    have key : tstep g mem pairs th =
        [((fenceS (stOf mem pairs th) .st).mem, (fenceS (stOf mem pairs th) .st).pairs,
          withS { th with term := e, env := (x, .ptr .pub ru, [pw]) :: th.env } (fenceS (stOf mem pairs th) .st))] := by
      simp only [tstep, hterm, evalOp, hea]; rfl
    rw [key]
    refine ⟨by simp, fun r hr => ?_⟩
    simp only [List.mem_singleton] at hr
    subst hr
    have hvr : VR ρ (pubEnvAt η lab (stOf mem pairs th).vs.vWr η.rid) (.ptr .pub u) (shp (.ptr .pub ru)) [pw] := by
      simp only [VR]
      exact ⟨⟨lab, 0⟩, c, hwsv, rfl, hsto, hcty,
        ⟨(η.pfr lab).getD (stOf mem pairs th).vs.vWr, by simp [pubEnvAt, TEnv.withSto, pubP], Or.inl (Or.inl rfl)⟩, hacc⟩
    exact ⟨_, hfoot, ⟨ρ, _, c', rfl, ⟨hE.1, hx.1, hx.2.2.2.2.2.2.2.2.2.2.1⟩, he, htv',
        bind_FInv hb (FInv_ext hE.2.1 hx hi1) hvr (Lay_ptr_remode hl rfl rfl),
        retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩, hmi,
      fun y a' e' rt' ws' ad' ht' hea' hws' => by
        rw [hterm] at ht'
        cases ht'
        rw [hea] at hea'
        cases hea'
        have h2 : [pw.val] = [.loc ad' 0] := hws'
        rw [hpw] at h2
        cases h2
        exact (pubEnvAt_seen _ _ _ _).1⟩
  | publishBuf hu hsh hb =>
    obtain ⟨n, k, u, c₁, hu, hsh, hb⟩ : ∃ n k u c₁, cx.use a = .ok (.refine (.loc .own (.array n u)) (.ini k), c₁) ∧
        Ty.sharedOKIn c₁.ke (.loc .pub (.array n u)) = true ∧
        c₁.bind x (.refine (.loc .pub (.array n u)) (.ini k)) = .ok c' := ⟨_, _, _, _, hu, hsh, hb⟩
    obtain ⟨hi1, μr, nr, ur, ψ, wsb, hea, hvb, hlay⟩ := ownBuf_inv hu hi
    have hl := hlay .pub .pub rfl rfl
    have key : tstep g mem pairs th =
        [((fenceS (stOf mem pairs th) .st).mem, (fenceS (stOf mem pairs th) .st).pairs,
          withS { th with term := e, env := (x, .refine (.loc .pub (.array nr ur)) ψ, wsb) :: th.env }
            (fenceS (stOf mem pairs th) .st))] := by
      simp only [tstep, hterm, evalOp, hea]; rfl
    rw [key]
    refine ⟨by simp, fun r hr => ?_⟩
    simp only [List.mem_singleton] at hr
    subst hr
    simp only [VR] at hvb
    obtain ⟨hv, hir⟩ := hvb
    rcases hv with ⟨hnull, e0, he0⟩ | ⟨ad, c, U, hws, hsto, hat, hFU, hmode, hini⟩
    · -- a null handle (an empty buffer): only the fence
      have hvr : VR ρ η (.refine (.loc .pub (.array n u)) (.ini k)) (shp (.refine (.loc .pub (.array nr ur)) ψ)) wsb := by
        simp only [VR]; exact ⟨Or.inl ⟨hnull, e0, he0⟩, IniR_mono (TEnv.selIni_le_ini η _) hir⟩
      refine ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv', bind_FInv hb hi1 hvr hl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩, MemInv_fence hm,
        fun y a' e' rt' ws' ad' ht' hea' hws' => ?_⟩
      rw [hterm] at ht'
      cases ht'
      rw [hea] at hea'
      cases hea'
      rw [hnull] at hws'
      simp at hws'
    · obtain rfl := Fd_nonmu hFU (fun b => by simp [cl])
      have hown : c.owner = some η.tid := hmode
      simp only [Ty.sharedOKIn, Bool.and_eq_true] at hsh
      have hF := pubTyFactsBuf hi1 hE hm hsto hown (by simpa [tb] using tb_use hu htv) hat hsh.1.1 hsh.1.2
        (hsc _ (use_cases hu).1 _ _ (Or.inr ⟨_, rfl⟩))
      obtain ⟨hfoot, hx, hmi⟩ := pubCell_post (Rd := η.rid) hE hm hsto hown (Nat.le_refl _) hF
        (hwin _ _ ad hea hws) (hPb x a e _ _ ad hterm hea hws)
      have hvr : VR ρ (pubEnvAt η ad.label (stOf mem pairs th).vs.vWr η.rid)
          (.refine (.loc .pub (.array n u)) (.ini k)) (shp (.refine (.loc .pub (.array nr ur)) ψ)) wsb := by
        simp only [VR]
        exact ⟨Or.inr ⟨ad, c, _, hws, hsto, hat, .refl,
          ⟨(η.pfr ad.label).getD (stOf mem pairs th).vs.vWr, by simp [pubEnvAt, TEnv.withSto, pubP], Or.inl (Or.inl rfl)⟩,
          (IniAt_mono (modeIni_le_ini _ _ _) hini)⟩, IniR_mono (TEnv.selIni_le_ini η _) hir⟩
      exact ⟨_, hfoot, ⟨ρ, _, c', rfl, ⟨hE.1, hx.1, hx.2.2.2.2.2.2.2.2.2.2.1⟩, he, htv',
          bind_FInv hb (FInv_ext hE.2.1 hx hi1) hvr hl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩, hmi,
        fun y a' e' rt' ws' ad' ht' hea' hws' => by
          rw [hterm] at ht'
          cases ht'
          rw [hea] at hea'
          cases hea'
          rw [hws] at hws'
          cases hws'
          exact (pubEnvAt_seen _ _ _ _).1⟩



/-! ## §17 (M5b) Loading through a `pub` locative

A `pub` locative's target is a component of a segment of its cell (`at_seg`):
the whole cell, or a buffer slot below the initialised count.  A torn read of
another thread's cell is assembled over the whole segment (`TermTear.assemble`):
the units the load does not read are taken from a value of the segment type
(`Inh`), the units it reads are words of values of that one segment
(`SegOf_unique`), and the target's words are then cut out (`VR_at`). -/


/-- A message another thread's reader reads past the frontier is a word of the cell. -/
theorem pub_wordOK {E : TEnv} {mem : Memory} {l : AllocLabel} {c : Cell} {f V : Ts} {o t : Nat} {m : Msg}
    {P : List Ts} (hpd : PubDefP E mem P) (hsto : E.sto l = some c) (hown : c.owner ≠ some E.tid)
    (hf : E.pfr l = some f) (hfv : f ≤ V) (hi : InitR E c l o) (hnp : t ∉ P) (hm : mem[t]? = some m)
    (hloc : m.loc = ⟨l, o⟩)
    (hh : WeakMem.hiddenFrom mem ⟨l, o⟩ t V = false) : WordOK E c.ty o (mw m) := by
  refine Classical.byContradiction fun hno => ?_
  obtain ⟨t', m', h1, h2, h3, h4⟩ := hpd l c f hsto hown hf o hi t m hnp hm hloc hno
  have hT : WeakMem.hiddenFrom mem ⟨l, o⟩ t f = true := by
    unfold WeakMem.hiddenFrom; rw [List.any_eq_true]
    exact ⟨t', List.mem_range.2 (Nat.lt_succ_of_le h2), by simp [h1, h3, h4]⟩
  rw [hiddenFrom_mono hfv hh] at hT; cases hT


/-- **Loading another thread's published cell at a locative**: the load can
read, and what it reads bounds a value of the target type. -/
theorem pubLoadAt {E : TEnv} {s : St} {ad : Address} {c : Cell} {U : Ty} {us : List Acc} {f : Ts}
    {arch : Arch} {pw : Word} {acq : Bool}
    (hpi : PubInv E s) (hpd : PubDefP E s.mem s.promises)
    (hsto : E.sto ad.label = some c) (hown : c.owner ≠ some E.tid) (hf : E.pfr ad.label = some f)
    (hfv : f ≤ pw.view)
    (hat : AtOff c.ty ad.offset U) (hini : IniAt E.ini c ad U) (hna : ∀ N e, U ≠ .array (.lit N) e)
    (hus : accs U = some us) :
    (∃ r, r ∈ loadUnits arch pw ad acq us 0 s) ∧
    (∀ r, r ∈ loadUnits arch pw ad acq us 0 s → PromAbove r.1 → ∃ q, ValOf E U q ∧ WLe q r.2) ∧
    ∃ q, ValOf E U q := by
  obtain ⟨-, hInh, hCpl, hPP, hLV⟩ := hpi
  obtain ⟨hlt, hcplS, -⟩ := hCpl ad.label c f hsto hf
  obtain ⟨b, oS, S, L, hseg, hbo, hatS, hL, hiS⟩ := at_seg hlt hat hini hna
  obtain ⟨pre, post, hLe, hpre⟩ := AtOff_embed hatS hL hus
  have hLe' : L = pre ++ (us ++ post) := by rw [hLe, List.append_assoc]
  have hnL : nWords L = nWords pre + nWords us + nWords post := by
    rw [hLe, nWords_append, nWords_append]
  have hcpl : TearOK S := hcplS b S hseg (by rw [hL]; simp)
  have hoff : ∀ n, offs ad (0 + n) = ⟨ad.label, b + (oS + n)⟩ := fun n => by
    simp only [offs, Nat.zero_add, ← hbo, Nat.add_assoc]
  have hlive : ∀ j, j < nWords us → ∃ (t : Nat) (m : Msg), s.mem[t]? = some m ∧ m.loc = offs ad (0 + j) := by
    intro j hj
    obtain ⟨t, m, h1, h2⟩ := hLV ad.label c f b S L (oS + j) hsto hown hf hseg hL (by omega)
    exact ⟨t, m, h1, by rw [h2, hoff]⟩
  obtain ⟨r0, hr0⟩ := loadUnits_nonemptyL (arch := arch) (pw := pw) (a := ad) (acq := acq) us 0 s hlive
  have hst0 : ∃ q, ValOf E U q := by
    obtain ⟨Q0, hQ0, hQl⟩ := hInh ad.label c b S L hsto hseg hL hiS
    obtain ⟨n0, -, -, hvU, hVU⟩ := VR_at E.unsee hatS hQ0.1 hQ0.2 (by rw [hQl]; exact wc_of_accs hL)
    exact ⟨_, hvU, hVU⟩
  refine ⟨⟨r0, hr0⟩, fun r hr hpa => ?_, hst0⟩
  obtain ⟨f1, -, f3, -⟩ := loadUnits_frame us 0 _ r hr
  have hrd := Reads_unit us 0 r.2 (loadUnits_reads us 0 _ r hr s.promises
    (fun t m ht hm => hpa t (by rw [f3]; exact ht) m (by rw [f1]; exact hm)))
  have hrl : r.2.length = nWords us := hrd.1
  obtain ⟨Q0, hQ0, hQl⟩ := hInh ad.label c b S L hsto hseg hL hiS
  have hbnd : oS + nWords us ≤ Q0.length := by omega
  obtain ⟨wsL, hwsL⟩ : ∃ w, w = Q0.take oS ++ r.2 ++ Q0.drop (oS + nWords us) := ⟨_, rfl⟩
  have hwsLlen : wsL.length = nWords L := by
    rw [hwsL]; simp only [List.length_append, List.length_take, List.length_drop, hrl, hQl]; omega
  have hunit : ∀ i, i < L.length → ∃ ws, (ValOf E S ws ∧ ws.length = nWords L) ∧
      ∀ j x y, nWords (L.take i) ≤ j → j < nWords (L.take (i + 1)) → ws[j]? = some x →
        wsL[j]? = some y → WLe1 x y := by
    intro i hi
    by_cases hi1 : i < pre.length
    · refine ⟨Q0, ⟨hQ0, hQl⟩, fun j x y _ hj2 hx hy => ?_⟩
      have h1 : nWords (L.take (i + 1)) ≤ nWords pre := by
        rw [hLe', List.take_append, nWords_append,
          show i + 1 - pre.length = 0 by omega, List.take_zero]
        have := nWords_take_le pre (i + 1)
        simp only [nWords, List.map_nil, List.sum_nil, Nat.add_zero] at this ⊢; exact this
      rw [hwsL, splice_get Q0 r.2 oS (nWords us) j hrl hbnd, iteF (by omega)] at hy
      rw [hx] at hy; cases hy; exact WLe1_refl _
    by_cases hi2 : i < pre.length + us.length
    · obtain ⟨i', rfl⟩ : ∃ i', i = pre.length + i' := ⟨i - pre.length, by omega⟩
      have hi' : i' < us.length := by omega
      obtain ⟨u0, hu0⟩ : ∃ u0, us[i']? = some u0 := ⟨_, List.getElem?_eq_getElem hi'⟩
      have hLi : L[pre.length + i']? = some u0 := by
        rw [hLe', List.getElem?_append_right (by omega), Nat.add_sub_cancel_left,
          List.getElem?_append_left hi']; exact hu0
      have ht1 : nWords (L.take (pre.length + i')) = oS + nWords (us.take i') := by
        rw [hLe', List.take_append, List.take_of_length_le (by omega), nWords_append,
          Nat.add_sub_cancel_left, List.take_append, show i' - us.length = 0 by omega,
          List.take_zero, List.append_nil, hpre]
      have ht2 : nWords (L.take (pre.length + i' + 1)) = oS + nWords (us.take i') + u0.size := by
        rw [nWords_take_succ hLi, ht1]
      have hnb : nWords (us.take i') + u0.size ≤ nWords us := by
        rw [← nWords_take_succ hu0]; exact nWords_take_le us (i' + 1)
      have hU := hrd.2 i' u0 hu0
      rw [ht1, ht2]
      rw [Nat.zero_add] at hU
      generalize hn : nWords (us.take i') = n at hU hnb ⊢
      cases u0 with
      | one =>
        have hsz : Acc.size .one = 1 := rfl
        obtain ⟨w, t, m, hw, hm, hloc, hh, hwl, hnp⟩ := UnitRead_one hU
        rw [← Nat.zero_add n, hoff] at hloc hh
        have hy : r.2[n]? = some w := by
          have h1 : (r.2.drop n)[0]? = some w := by
            rw [← List.getElem?_take_of_lt (show 0 < Acc.size .one by decide), hw]; rfl
          rw [List.getElem?_drop, Nat.add_zero] at h1; exact h1
        have hpos : oS + n < nWords L := by simp only [Acc.size] at hnb; omega
        have hwok := pub_wordOK hpd hsto hown hf hfv (InitR_of_IniSeg hiS hseg hL hpos) hnp hm hloc hh
        obtain ⟨b', S', ws, o', w0, hseg', hvs, hget, hle0, hbo'⟩ := hwok
        obtain ⟨rfl, rfl⟩ := SegOf_unique hseg hL hpos hseg' hvs (List.getElem?_eq_some_iff.1 hget).1 hbo'.symm
        refine ⟨ws, ⟨hvs.1, hvs.2 L hL⟩, fun j x y' hj1 hj2 hx hy' => ?_⟩
        simp only [Acc.size] at hj2
        have hj : j = oS + n := by omega
        have ho' : o' = oS + n := by omega
        subst hj ho'
        rw [hget] at hx; cases hx
        rw [hwsL, splice_get Q0 r.2 oS (nWords us) _ hrl hbnd, iteT ⟨by omega, by omega⟩,
          Nat.add_sub_cancel_left, hy] at hy'
        cases hy'; exact WLe1_trans hle0 hwl
      | two =>
        have hsz : Acc.size .two = 2 := rfl
        obtain ⟨w0, w1, t0, t1, m0, m1, hw, hm0, hm1, hl0, hl1, hh0, hh1, hst, hle0, hle1, hn0, hn1⟩ :=
          UnitRead_two hU
        rw [← Nat.zero_add n, hoff] at hl0 hh0 hst
        have e1 : offs ad (n + 1) = ⟨ad.label, b + (oS + n) + 1⟩ := by
          simp only [offs, ← hbo, Nat.add_assoc]
        rw [e1] at hl1 hh1
        have hy0 : r.2[n]? = some w0 := by
          have h1 : (r.2.drop n)[0]? = some w0 := by
            rw [← List.getElem?_take_of_lt (show 0 < Acc.size .two by decide), hw]; rfl
          rw [List.getElem?_drop, Nat.add_zero] at h1; exact h1
        have hy1 : r.2[n + 1]? = some w1 := by
          have h1 : (r.2.drop n)[1]? = some w1 := by
            rw [← List.getElem?_take_of_lt (show 1 < Acc.size .two by decide), hw]; rfl
          rw [List.getElem?_drop] at h1; exact h1
        have hpos : oS + n < nWords L := by simp only [Acc.size] at hnb; omega
        have htw : TwoAtT c.ty (b + (oS + n)) :=
          ⟨b, S, L, oS + n, hseg, hL, ⟨pre.length + i', hLi, by rw [ht1, hn]⟩, rfl⟩
        have hpo := hPP ad.label c f (b + (oS + n)) hsto
          (.inl ⟨hown, b, S, L, oS + n, hseg, hL, ⟨pre.length + i', hLi, by rw [ht1, hn]⟩, rfl, hiS⟩) hf htw t0 t1 m0 m1 hn0 hn1 hm0 hm1 hl0 hl1
          (hiddenFrom_mono hfv hh0) (hiddenFrom_mono hfv hh1) hst
        obtain ⟨b', S', ws, o', x0, x1, hseg', hvs, hg0, hg1, hx0, hx1, hbo'⟩ := hpo
        obtain ⟨rfl, rfl⟩ := SegOf_unique hseg hL hpos hseg' hvs (List.getElem?_eq_some_iff.1 hg0).1 hbo'.symm
        refine ⟨ws, ⟨hvs.1, hvs.2 L hL⟩, fun j x y' hj1 hj2 hx hy' => ?_⟩
        simp only [Acc.size] at hj2
        have ho' : o' = oS + n := by omega
        subst ho'
        rw [hwsL, splice_get Q0 r.2 oS (nWords us) _ hrl hbnd, iteT ⟨by omega, by omega⟩] at hy'
        rcases (show j = oS + n ∨ j = oS + n + 1 by omega) with rfl | rfl
        · rw [Nat.add_sub_cancel_left, hy0] at hy'; rw [hg0] at hx; cases hx; cases hy'
          exact WLe1_trans hx0 hle0
        · rw [show oS + n + 1 - oS = n + 1 by omega, hy1] at hy'; rw [hg1] at hx; cases hx; cases hy'
          exact WLe1_trans hx1 hle1
    · refine ⟨Q0, ⟨hQ0, hQl⟩, fun j x y hj1 _ hx hy => ?_⟩
      have h1 : oS + nWords us ≤ nWords (L.take i) := by
        rw [hLe', List.take_append, List.take_of_length_le (by omega), nWords_append,
          List.take_append, List.take_of_length_le (by omega), nWords_append, hpre]
        omega
      rw [hwsL, splice_get Q0 r.2 oS (nWords us) j hrl hbnd, iteF (by omega)] at hy
      rw [hx] at hy; cases hy; exact WLe1_refl _
  obtain ⟨vals, ⟨hvals, hvl⟩, hle⟩ :=
    TermTear.assemble (P := fun ws => ValOf E S ws ∧ ws.length = nWords L)
      (fun k ws1 ws2 hb h1 h2 => ⟨⟨hcpl _ _ _ _ _ hL hb h1.1.1 h2.1.1 h1.2 h2.2,
          TermTear.Valid_tear hL hb h1.1.2 h2.1.2 h1.2 h2.2⟩,
        by rw [TermTear.splice_length (h1.2.trans h2.2.symm)]; exact h2.2⟩)
      (fun ws h => h.2) wsL hwsLlen hunit ⟨Q0, hQ0, hQl⟩
  obtain ⟨n0, hwn, -, hvU, hVU⟩ := VR_at E.unsee hatS hvals.1 hvals.2 (by rw [hvl]; exact wc_of_accs hL)
  have hn0 : n0 = nWords us := by rw [wc_of_accs hus] at hwn; exact (Option.some.inj hwn).symm
  subst hn0
  refine ⟨(vals.drop oS).take (nWords us), ⟨hvU, hVU⟩, ?_⟩
  have e : (wsL.drop oS).take (nWords us) = r.2 := by
    rw [hwsL, List.append_assoc, List.drop_left' (by simp; omega), List.take_left' hrl]
  rw [← e]; exact WLe.take _ (WLe.drop _ hle)

/-- (c1) A locative at any mode but `own` reads the reader-visible count (`modeIni`). -/
theorem modeIni_ne_own {μ : Mode} (h : μ ≠ .own) (ini rini : WeakMem.AllocLabel → Nat) :
    modeIni μ ini rini = ini := by
  cases μ with
  | own => exact absurd rfl h
  | _ => rfl

/-- (c1) `tstepM_loadPubLoc`'s step at any mode whose clause gives a `pub`-like frontier (`hV`). -/
theorem tstepM_loadCellLoc {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx c' : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {acq : Bool} {a : At} {μ : Mode} {u : Ty} {e : Expr}
    (hterm : th.term = .let_ x (.load acq a) e)
    (hpk : cx.peek a = .ok (.loc μ u))
    (haf : affine cx.ke u = false) (hb : cx.bind x u = .ok c')
    (he : Typed p c' e) (htv' : TvOK c') (hRk : skel c'.ret = skel cx.ret) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hμ : μ ≠ .own)
    (hV : ∀ rt pw ad c, evalAt th.env a = some (rt, [pw]) → pw.val = .loc ad 0 → η.sto ad.label = some c →
      ModeOK η.tid η.pfr η.seen μ ad.label c [pw] → ModeOK η.tid η.pfr η.seen .pub ad.label c [pw]) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  obtain ⟨rt, ws, hea, hv, hl⟩ := peek_VR hi.2.1 hpk
  have haf' : (cl ρ η.wit 0 0 u).arrFree = true := arrFree_cl hi.2.2.2.2.2.2.1.af u 0 0 (bind_arrFree hb)
  have hnb : ∀ n e, ¬ Fd (.array (.lit n) e) (cl ρ η.wit 0 0 u) := fun n e hF => by
    have := Fd_arrFree hF haf'; simp [Ty.arrFree] at this
  obtain ⟨ad, c, hws, hsto, hat, hmode, hini⟩ :=
    cell_target (rfl : cellOf (.loc μ u) = some (μ, u)) hnb hv
  obtain ⟨pw, rfl, hpw⟩ := map_singleton hws
  replace hmode := hV _ pw ad c hea hpw hsto hmode
  rw [modeIni_ne_own hμ] at hini
  have hsk := hl.2.1
  obtain ⟨μr, ru, rfl, -, hsku⟩ : ∃ μr ru, rt = .loc μr ru ∧ skelM μr = skelM μ ∧
      etok (skel ru) = etok (skel (close th.σs u)) := by
    simp only [close, substTs, skel, etok] at hsk
    obtain ⟨μr, ru, rfl, h1, h2⟩ := eskel_eq_loc hsk
    exact ⟨μr, ru, rfl, h1, h2⟩
  have hwf := wordFree_close hi.2.2.2.2.2.1 u (wordFreeIn_of_affine u haf)
  have hwr : wordOf (Ty.loc μr ru) = none := by
    cases ru with
    | word r P =>
        obtain ⟨r', hX⟩ := eskel_word (show etok (skel (close th.σs u)) = .word (.lit 0) P by rw [← hsku]; rfl)
        rw [hX] at hwf; simp [Ty.wordFree, Ty.wordFreeIn] at hwf
    | _ => rfl
  have htb : tb cx.ke.length u = true :=
    tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.loc μ u) = some (μ, u))
  have hsig : sig ru = sig (cl ρ η.wit 0 0 u) := by
    have h1 : sig ru = sig (close th.σs u) := sig_of_eskel hsku
    rw [h1]; exact sig_WitL hi.2.2.2.1 ρ (bind_opaqueOK hb) (lt_of_guardT htb hi.2.2.2.2.1)
  have hna : ∀ N e', cl ρ η.wit 0 0 u ≠ .array (.lit N) e' := fun N e' h => by
    rw [h] at haf'; simp [Ty.arrFree] at haf'
  by_cases hown : c.owner = some η.tid
  · -- the thread's own cell: an own load
    obtain ⟨us, hus, ⟨r0, hr0⟩, hld, hstw⟩ := locLoadI (arch := g.arch) (pw := pw) (acq := acq)
      (s := stOf mem pairs th) hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hm.2.2.2.2.2.1 hsto hown hat hini hna
      (fun _ f hf hns => by
        simp only [ModeOK] at hmode
        obtain ⟨f0, hf0, hsf⟩ := hmode
        obtain rfl : f0 = f := Option.some.inj (hf0.symm.trans hf)
        rcases hsf with hs | hs
        · exact absurd hs hns
        · exact hs pw (by simp)) hsku hsig
        (cell_lyt hl.2.2.2.2 rfl rfl).2
          (accs_rtW hE.2.1 hi.2.2.2.1 hi.2.2.2.2.1 (bind_opaqueOK hb) htb (cell_lyt hl.2.2.2.2 rfl rfl).2)
    have key : tstep g mem pairs th =
        (loadUnits g.arch pw ad acq us 0 (stOf mem pairs th)).map fun (s', ws) =>
          (s'.mem, s'.pairs, withS { th with term := e, env := (x, ru, ws) :: th.env } s') := by
      simp only [tstep, hterm, evalOp, hea, cellOf, addrOf, hpw, hwr, Option.isSome_none,
        Bool.false_eq_true, ↓reduceIte, hus, List.map_map]; rfl
    rw [key] at ⊢
    refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hr0), fun r hr hpr0 => ?_⟩
    rw [List.mem_map] at hr
    obtain ⟨⟨s', wsr⟩, hl', rfl⟩ := hr
    obtain ⟨hvr, hlay', f1, f2, f3, f4, f5⟩ := hld (s', wsr) hl' (hpr0)
    exact ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv', bind_FInv hb hi hvr hlay', retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
      MemInv_load hm f1 f2 f3 f4 f5 (loadUnits_relSt _ _ _ _ hl') (loadUnits_vWr _ _ _ _ hl')⟩
  · -- another thread's cell
    simp only [ModeOK] at hmode
    obtain ⟨f, hf, hsf⟩ := hmode
    have hfv : f ≤ pw.view := by
      rcases hsf with hs | hs
      · rcases hm.2.2.2.2.2.2.2.2.1.1 ad.label hs with ⟨c0, h1, h2⟩ | ⟨h1, -⟩
        · refine absurd ?_ hown
          have h1' : η.sto ad.label = some c0 := h1
          rw [hsto] at h1'
          rw [Option.some.inj h1']; exact h2
        · have h1' : η.sto ad.label = none := h1
          rw [hsto] at h1'; cases h1'
      · exact hs pw (by simp)
    have hlU : accs (cl ρ η.wit 0 0 u) ≠ none := by
      rcases AtOff_lay hat with h | ⟨N, e', h, -⟩
      · exact h
      · exact absurd h (hna N e')
    have hlr := pub_accs hi.2.2.2.1 hi.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi.2.1 htv hpk rfl (bind_opaqueOK hb) hea rfl
    obtain ⟨us, hus⟩ : ∃ us, accs ru = some us := Option.ne_none_iff_exists'.1 (by rw [hlr]; exact hlU)
    have husU : accs (cl ρ η.wit 0 0 u) = some us := by rw [← hlr, hus]
    have key : tstep g mem pairs th =
        (loadUnits g.arch pw ad acq us 0 (stOf mem pairs th)).map fun (s', ws) =>
          (s'.mem, s'.pairs, withS { th with term := e, env := (x, ru, ws) :: th.env } s') := by
      simp only [tstep, hterm, evalOp, hea, cellOf, addrOf, hpw, hwr, Option.isSome_none,
        Bool.false_eq_true, ↓reduceIte, hus, List.map_map]; rfl
    rw [key] at ⊢
    obtain ⟨⟨r0, hr0⟩, hval, hsv⟩ := pubLoadAt (arch := g.arch) (pw := pw) (acq := acq)
      hm.2.2.2.2.2.2.2.2.1 hm.2.2.2.2.2.2.1 hsto hown hf hfv hat hini hna husU
    refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hr0), fun r hr hpr0 => ?_⟩
    rw [List.mem_map] at hr
    obtain ⟨⟨s', wsr⟩, hl', rfl⟩ := hr
    obtain ⟨q, hq, hle⟩ := hval (s', wsr) hl' (hpr0)
    have hrl : wsr.length = nWords us := (Reads_unit us 0 wsr (loadUnits_reads us 0 _ (s', wsr) hl' [] (fun _ _ h => by cases h))).1
    obtain ⟨f1, f2, f3, f4⟩ := loadUnits_frame us 0 _ (s', wsr) hl'
    obtain ⟨hvr0, hV0⟩ := ValOf.env hq
    have hvr : VR ρ η u (shp ru) wsr := by
      rw [shp_of_sig hsig]
      exact (VR_close hE.2.1 ρ u [] 0 ρ (fun _ => 0) (shp (cl ρ η.wit 0 0 u)) wsr (fun k => rfl)
        (fun k hk => absurd hk (Nat.not_lt_zero _))).2 (VR_up _ _ q wsr hle hvr0)
    have hlay' : Lay th.σs u ru wsr :=
      ⟨fun us' h => by rw [hus] at h; cases h; exact hrl, hsku, by simp [wc, hus],
        Valid_of_sig hsig.symm (Valid_vals _ q wsr hle.vals hV0), (cell_lyt hl.2.2.2.2 rfl rfl).2⟩
    refine ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv', bind_FInv hb hi hvr hlay', retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩, ?_⟩
    refine MemInv_loadF hm f1 f2 (fun l c1 hc1 ho1 o => loadUnits_cohF us 0 _ (s', wsr) hl' ⟨l, o⟩ ?_)
      f3 f4 (loadUnits_relSt _ _ _ _ hl') (loadUnits_vWr _ _ _ _ hl')
      (fun l B hB o => loadUnits_cohF us 0 _ (s', wsr) hl' ⟨l, o⟩ (fun he => by
        have h0 := (hm.2.2.2.2.2.2.2.2.2.1.2.2 l B hB).1
        have hl0 : l = ad.label := he
        rw [hl0] at h0; have h1 : η.sto ad.label = none := h0; rw [hsto] at h1; cases h1))
    intro hle'
    have hl'' : l = ad.label := hle'
    have h1 : η.sto l = some c1 := hc1
    rw [hl'', hsto] at h1
    exact hown (by rw [Option.some.inj h1]; exact ho1)

/-- **P1 + P4 at the thread, `load` through a `pub` locative** (D3 M5b); the
locative's runtime pointee lays the target out as its type does
(`pub_accs`).  At the thread's own cell an own load (`locLoad`); at another
thread's, `pubLoadAt`. -/
theorem tstepM_loadPubLoc {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {acq : Bool} {a : At} {u : Ty} {e : Expr}
    (hterm : th.term = .let_ x (.load acq a) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.loc .pub u)) (hnw : wordOf (Ty.loc .pub u) = none)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | loadWord hp hw _ _ => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | loadOwn hp _ hc _ _ => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | loadRgn hp _ hc _ _ _ => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | loadCap hp _ hc _ _ _ _ => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | loadTorn hp _ hc _ _ _ => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | loadPub hp _ hc haf _ hb =>
  obtain ⟨t, u', hp, hc, haf, hb⟩ : ∃ t u', cx.peek a = .ok t ∧ cellOf t = some (.pub, u') ∧
      affine cx.ke u' = false ∧ cx.bind x u' = .ok c' := ⟨_, _, hp, hc, haf, hb⟩
  rw [hpk] at hp; cases hp
  simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc; subst hc
  exact tstepM_loadCellLoc (hterm := hterm) (hpk := hpk) (haf := haf) (hb := hb) (he := he) (htv' := htv') (hRk := hRk) (hi := hi) (hE := hE) (htv := htv) (hm := hm) (hRP := hRP) (hPS := hPS) (hμ := fun h => by cases h) (hV := fun _ _ _ _ _ _ _ h => h)

/-! ## §18 (M5c) Storing through a `pub` locative

A store's units sit inside its target's segment (`AtOff_embed`): a one- or
two-word unit of the store is one of the segment's (`OneAt_embed`,
`TwoAt_embed`), and a reader's two-word unit that a new message touches is in
the store's segment (`SegOf_unique2`).  So `PubInv_storeF`'s argument goes
through at an interior address (`PubInv_storeAt`).  The segment's new value is
`VR_put` into a value of the segment (`Inh`), and the cell's other words are
untouched (`MemInv_storePubAt`). -/

/-- **A component store to another thread's published cell keeps `MemInv`**,
whether or not its units fulfil the thread's promises (T3c-7: a fulfilment
leaves memory alone and moves coherence only at the cell).  The segment's new
value is `VR_put` into a value of the segment (`Inh`). -/
theorem MemInv_storePubAt {g : G} {E : TEnv} {s : St} {a : Address} {c : Cell} {us : List Acc}
    {ws : List Word} {pw : Word} {rel : Bool} {U : Ty} {f : Ts} (hm : MemInv g E s)
    (hsto : E.sto a.label = some c) (hown : c.owner ≠ some E.tid) (hf : E.pfr a.label = some f)
    (hat : AtOff c.ty a.offset U) (hini : IniAt E.ini c a U) (hna : ∀ N e, U ≠ .array (.lit N) e)
    (hU : EnvVal E U ws) (hus : accs U = some us) (hlen : ws.length = nWords us) :
    ∀ s', s' ∈ storeUnits g.k g.arch pw a rel us ws 0 s → MemInv g E s' := by
  intro s' hs
  obtain ⟨hmo, hoo, hpl, hfr, hsn, hoh, hpd, hopub, hpi, hbi, hpo⟩ := id hm
  have hpi0 := hpi
  obtain ⟨-, hInh, hCpl, -, -⟩ := hpi0
  obtain ⟨hlt, -⟩ := hCpl a.label c f hsto hf
  obtain ⟨b, oS, S, L, hseg, hbo, hatS, hL, hiS⟩ := at_seg hlt hat hini hna
  obtain ⟨pre, post, hLe, hpre⟩ := AtOff_embed hatS hL hus
  have hnL : nWords L = nWords pre + nWords us + nWords post := by
    rw [hLe, nWords_append, nWords_append]
  obtain ⟨Q0, ⟨hvr0, hV0⟩, hQ0l⟩ := hInh a.label c b S L hsto hseg hL hiS
  have hwS : wc S = some Q0.length := by rw [hQ0l]; exact wc_of_accs hL
  obtain ⟨ws', hws'⟩ : ∃ ws', ws' = ws.map (bumpW s.vs.vRelSt) := ⟨_, rfl⟩
  have hlen' : ws'.length = nWords us := by rw [hws', List.length_map]; exact hlen
  have hget : ∀ j w, ws[j]? = some w → ws'[j]? = some (bumpW s.vs.vRelSt w) := fun j w hw => by
    rw [hws', List.getElem?_map, hw]; rfl
  obtain ⟨hvq, hVq⟩ : ValOf E U ws' := by rw [hws']; exact hU.store hsn
  obtain ⟨hle, hvR, hVR⟩ := VR_put E.unsee hatS hvr0 hV0 hwS hvq hVq
    (by rw [hlen']; exact wc_of_accs hus)
  rw [hlen'] at hle hvR hVR
  generalize hQ : Q0.take oS ++ ws' ++ Q0.drop (oS + nWords us) = Q at hvR hVR
  have hQl : Q.length = nWords L := by
    rw [← hQ]; simp only [List.length_append, List.length_take, List.length_drop, hlen']; omega
  have hQs : ValOfS E S Q := ⟨⟨hvR, hVR⟩, ShapeC_of_wc (wc_of_accs hL) hQl⟩
  have hA' : (Q0.take oS).length = oS := by simp; omega
  have hinQ : ∀ j w, ws[j]? = some w → Q[oS + j]? = some (bumpW s.vs.vRelSt w) := fun j w hw => by
    have hw' := hget j w hw
    have hj : j < ws'.length := (List.getElem?_eq_some_iff.1 hw').1
    rw [← hQ, List.append_assoc, List.getElem?_append_right (by rw [hA']; omega), hA',
      Nat.add_sub_cancel_left, List.getElem?_append_left hj]; exact hw'
  have hmo' := storeUnits_memOKP (a := a) hsto hseg hbo.symm hQs us ws 0 s
    (fun j w hw => ⟨bumpW s.vs.vRelSt w, by simpa using hinQ j w hw, WLe1_refl _⟩) (Nat.le_refl _) hmo s' hs
  have hoo' : OwnOKPF E s'.mem s'.pairs s'.vs s'.promises := fun l' c' hc' hown' => by
    have hl : l' ≠ a.label := fun h => by
      subst h; rw [hsto] at hc'; cases hc'; exact hown hown'
    exact OwnCellF_storeOther (hoo l' c' hc' hown') hl id rfl rfl hpl hmo.2.2 hs
  obtain ⟨hg, hna, hpl', hnew, hwr, hful, hfw⟩ := storeCoreP hsto hseg hbo.symm hQs
    (fun j w hw => ⟨bumpW s.vs.vRelSt w, hinQ j w hw, WLe1_refl _⟩) (Nat.le_refl _) hpl hs
  exact ⟨hmo', hoo', hpl', FreshLP_store hfr hsto hg hna hful (fun _ _ => ⟨rfl, rfl, rfl⟩)
      (PrivCoh_storeUnits hfr.2 hs (fun _ h => h) fun j _ => notPrivU_own (a := offs a j) hsto hown),

    by rw [storeUnits_relSt _ _ _ _ _ hs]; exact hsn, OwnHidP_grow hoh hwr hg.2.1 hnew hfw,
    PubDefP_grow hpd hg.2.1 hnew hfw, hopub.store hpl hs,
    PubInv_storeAt hpi hmo.2.2 hsto hseg hL hbo hLe hpre hpl hmo' hs,
    BoxInv_store hbi hsto hpl hpo.1 s' hs, PromOK_store hpo hpl hs⟩

/-- (c1) `tstepM_storePub`'s step at any mode whose clause gives a `pub`-like frontier (`hV`). -/
theorem tstepM_storeCell {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx c' : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v : At} {tok : Option At}
    {μ : Mode} {u : Ty} {tv : Ty} {c₁ : Cx} {e : Expr}
    (hterm : th.term = .let_ x (.store rel a v tok) e)
    (hpk : cx.peek a = .ok (.ptr μ u))
    (hu : cx.use v = .ok (tv, c₁)) (hsub : SubS c₁ tv u) (hb : c₁.bind x .unit = .ok c')
    (he : Typed p c' e) (htv' : TvOK c') (hRk : skel c'.ret = skel cx.ret) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel)
    (hV : ∀ rt pw ad c, evalAt th.env a = some (rt, [pw]) → pw.val = .loc ad 0 → η.sto ad.label = some c →
      ModeOK η.tid η.pfr η.seen μ ad.label c [pw] → ModeOK η.tid η.pfr η.seen .pub ad.label c [pw]) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  have hotv : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have ho : cx.opaqueOK u = true := sub_opaqueOK hsub hotv
  have htb : tb cx.ke.length u = true := tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.ptr μ u) = some (μ, u))
  obtain ⟨lab, c, pw, μr, ru, hea, hpw, hsto, hcty, hmode, hacc, -, hsku, hsig⟩ := ptr_view hi hpk htv ho
  obtain ⟨f, hf, -⟩ := pubFr hea hpw hsto (hV _ pw ⟨lab, 0⟩ c hea hpw hsto hmode)
  obtain ⟨hi1, rv, wsv, hev, hvv, hlv⟩ := use_FInv hu hi
  have hlr : accs ru = accs c.ty := by rw [(Fd_lay hcty).2.2.1]; exact pub_accs hi.2.2.2.1 hi.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi.2.1 htv hpk rfl ho hea rfl
  obtain ⟨us, hus⟩ : ∃ us, accs ru = some us := by
    cases h : accs ru with
    | none => rw [h] at hlr; exact absurd hlr.symm hacc
    | some us => exact ⟨us, rfl⟩
  have husc : accs c.ty = some us := by rw [← hlr, hus]
  obtain ⟨hval, hlen⟩ := ownStoreVal hE.2.1 hi.2.2.2.1 hi.2.2.2.2.1 hi1.1 hsub ho htb hvv hlv hsig hus
  replace hval := (Fd_EnvVal (CE η) hcty).2 hval
  have key : tstep g mem pairs th =
      (storeUnits g.k g.arch pw ⟨lab, 0⟩ rel us wsv 0 (stOf mem pairs th)).map fun s' =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, .unit, []) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hev, cellOf, addrOf, hpw, hus, List.map_map]; rfl
  rw [key]
  obtain ⟨s0, hs0⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := pw) (a := ⟨lab, 0⟩) (rel := rel)
    us wsv 0 (stOf mem pairs th) hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hs0), fun r hr => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨s', hs', rfl⟩ := hr
  refine ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv', bind_FInv hb hi1 unit_VR (unit_Lay _), retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩, ?_⟩
  by_cases hown : c.owner = some η.tid
  · exact MemInv_storeF hm hsto hown husc hval hlen s' hs'
  · have hna : ∀ N e, c.ty ≠ .array (.lit N) e := fun N e he => by rw [he] at husc; simp [accs] at husc
    exact MemInv_storePubAt (a := ⟨lab, 0⟩) hm hsto hown hf (.here (Or.inl (by rw [husc]; simp)))
      (IniAt_of_ne fun N e he => hna N e he) hna hval husc hlen s' hs'

/-- **P1 + P4 at the thread, `store` through a `pub` reference** (D3 M4b).  At
the thread's own cell `MemInv_storeF` (own promises skipped); at another
thread's, `MemInv_storePubAt` at offset 0, which allows fulfilments (T3c-7). -/
theorem tstepM_storePub {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v : At} {tok : Option At}
    {u : Ty} {e : Expr}
    (hterm : th.term = .let_ x (.store rel a v tok) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.ptr .pub u)) (hnw : wordOf (Ty.ptr .pub u) = none)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | storeWordGive hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storeWordKeep hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storeWordHand hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storeOwn hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeRgn hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeCap hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storePub hp _ hc hwf hu hsub _ hb =>
  obtain ⟨t, u', tv, c₁, hp, hc, hwf, hu, hsub, hb⟩ : ∃ t u' tv c₁, cx.peek a = .ok t ∧
      cellOf t = some (.pub, u') ∧ Ty.wordFreeIn cx.ke u' = true ∧ cx.use v = .ok (tv, c₁) ∧
      SubS c₁ tv u' ∧ c₁.bind x .unit = .ok c' :=
    ⟨_, _, _, _, hp, hc, hwf, hu, hsub, hb⟩
  rw [hpk] at hp; cases hp
  simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc; subst hc
  exact tstepM_storeCell (hterm := hterm) (hpk := hpk) (hu := hu) (hsub := hsub) (hb := hb) (he := he) (htv' := htv') (hRk := hRk) (hi := hi) (hE := hE) (htv := htv) (hm := hm) (hRP := hRP) (hPS := hPS) (hV := fun _ _ _ _ _ _ _ h => h)

/-- (T3d-1) **P1 + P4 at the thread, a protocol word's store through a `pub`
reference**: as `storeWordOwn_core`, with `storePub`'s memory step; `pwf` from
`loadPub_core`. -/
theorem storeWordPub_core {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx c₁ c' : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v tk : At}
    {r r' i j k' : Idx} {P : Proto} {c₂ : Nat} {e : Expr} {xt : Ty}
    (hterm : th.term = .let_ x (.store rel a v (some tk)) e)
    (hpk : cx.peek a = .ok (.ptr .pub (.word r P))) (hg : P.ghost = false)
    (hu : cx.use tk = .ok (.tok r' (some (P, i)), c₁)) (hj : IntIdx c₁ v j) (hst : InState c₁ P j c₂ k')
    (hb : c₁.bind x xt = .ok c') (he : Typed p c' e) (htv' : TvOK c')
    (htag : StoreBind ρ η th.σs xt)
    (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  obtain ⟨hi1, -⟩ := use_FInv hu hi
  obtain ⟨tv, htvk, hio⟩ := hj
  obtain ⟨rt, w, hev, hwv, -⟩ := atom_num hi1.2.1 htvk hio
  have ho : cx.opaqueOK (.word r P) = true := by simp [Cx.opaqueOK, Ty.guardT]
  have hpwf : pwf P = true := by
    obtain ⟨ru0, pw0, lab0, us0, -, -, -, -, hne, hld, hstw⟩ :=
      loadPub_core (acq := false) (g := g) (mem := mem) (pairs := pairs) hpk ho hi hE htv hm
    obtain ⟨_, hvr0⟩ := hstw
    simp only [VR] at hvr0; exact hvr0.1
  obtain ⟨lab, c, pw, ru, f, hea, hpw, hsto, hcty, hf, -, hacc, hsku, hsig⟩ := pubPtr_view hi hpk htv ho
  obtain ⟨r'', rfl⟩ := eskel_word (show etok (skel ru) = .word (.lit 0) P by rw [hsku]; rfl)
  have hus : accs (Ty.word r'' P) = some [.one] := by simp [accs, hg]
  have hlr : accs (Ty.word r'' P) = accs c.ty := by
    rw [(Fd_lay hcty).2.2.1]
    exact pub_accs hi.2.2.2.1 hi.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi.2.1 htv hpk rfl ho hea rfl
  have husc : accs c.ty = some [.one] := by rw [← hlr, hus]
  have hval := (Fd_EnvVal (CE η) hcty).2 (storeWord_val (r := r) hpwf hi1.1 hst hwv)
  have hlen : [w].length = nWords [Acc.one] := rfl
  have key : tstep g mem pairs th =
      (storeUnits g.k g.arch pw ⟨lab, 0⟩ rel [.one] [w] 0 (stOf mem pairs th)).map fun s' =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, .unit, []) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hev, cellOf, addrOf, hpw, hus, List.map_map]; rfl
  rw [key]
  obtain ⟨s0, hs0⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := pw) (a := ⟨lab, 0⟩) (rel := rel)
    [.one] [w] 0 (stOf mem pairs th) hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hs0), fun r hr => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨s', hs', rfl⟩ := hr
  refine ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv', bind_FInv hb hi1 htag.1 htag.2, retPw_eq hRP ((bind_ret hb).trans (use_ret hu))⟩, ?_⟩
  by_cases hown : c.owner = some η.tid
  · exact MemInv_storeF hm hsto hown husc hval hlen s' hs'
  · have hna : ∀ N e, c.ty ≠ .array (.lit N) e := fun N e he => by rw [he] at husc; simp [accs] at husc
    exact MemInv_storePubAt (a := ⟨lab, 0⟩) hm hsto hown hf (.here (Or.inl (by rw [husc]; simp)))
      (IniAt_of_ne fun N e he => hna N e he) hna hval husc hlen s' hs'

/-- (T3d-1) **P1 + P4 at the thread, a protocol word's store** (own or `pub`
reference): Give, Keep and Hand.  The runtime binds `Unit` with no words; so
does the rule for a Give and a Hand, and a Keep's token is `Unit` modulo token
erasure (`tok_Lay`, option 1b). -/
theorem tstepM_storeWord {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v : At} {tok : Option At}
    {μ : Mode} {r : Idx} {P : Proto} {e : Expr}
    (hterm : th.term = .let_ x (.store rel a v tok) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.ptr μ (.word r P))) (hμ : μ = .own ∨ μ = .pub)
    (hg : P.ghost = false)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  have hT0 := hT
  rw [hterm] at hT0
  cases hT0 with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  cases hop with
  | storeOwn hp hnw | storePub hp hnw | storeRgn hp hnw | storeCap hp hnw =>
    exfalso; rw [hpk] at hp; cases hp; simp [wordOf] at hnw
  | storeWordGive hp hw hu _ hj _ _ hst _ _ _ _ _ hb =>
    rw [hpk] at hp; cases hp
    simp only [wordOf, Option.some.injEq, Prod.mk.injEq] at hw; obtain ⟨rfl, rfl⟩ := hw
    rcases hμ with rfl | rfl
    · exact storeWordOwn_core hterm hpk hg hu hj hst hb he htv' ⟨unit_VR, unit_Lay _⟩ hi hE htv hm hRP
    · exact storeWordPub_core hterm hpk hg hu hj hst hb he htv' ⟨unit_VR, unit_Lay _⟩ hi hE htv hm hRP
  | storeWordHand hp hw hu _ hj _ _ hst _ _ _ _ _ _ hb =>
    rw [hpk] at hp; cases hp
    simp only [wordOf, Option.some.injEq, Prod.mk.injEq] at hw; obtain ⟨rfl, rfl⟩ := hw
    rcases hμ with rfl | rfl
    · exact storeWordOwn_core hterm hpk hg hu hj hst hb he htv' ⟨unit_VR, unit_Lay _⟩ hi hE htv hm hRP
    · exact storeWordPub_core hterm hpk hg hu hj hst hb he htv' ⟨unit_VR, unit_Lay _⟩ hi hE htv hm hRP
  | storeWordKeep hp hw hu _ hj _ _ hst _ _ _ _ _ hb =>
    rw [hpk] at hp; cases hp
    simp only [wordOf, Option.some.injEq, Prod.mk.injEq] at hw; obtain ⟨rfl, rfl⟩ := hw
    rcases hμ with rfl | rfl
    · exact storeWordOwn_core hterm hpk hg hu hj hst hb he htv' ⟨by simp [VR], tok_Lay _ _ _ _⟩ hi hE htv hm hRP
    · exact storeWordPub_core hterm hpk hg hu hj hst hb he htv' ⟨by simp [VR], tok_Lay _ _ _ _⟩ hi hE htv hm hRP

/-- (c1) `tstepM_storePubLoc`'s step at any mode whose clause gives a `pub`-like frontier (`hV`). -/
theorem tstepM_storeCellLoc {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx c' : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v : At} {tok : Option At}
    {μ : Mode} {u : Ty} {tv : Ty} {c₁ : Cx} {e : Expr}
    (hterm : th.term = .let_ x (.store rel a v tok) e)
    (hpk : cx.peek a = .ok (.loc μ u))
    (hu : cx.use v = .ok (tv, c₁)) (hsub : SubS c₁ tv u) (hb : c₁.bind x .unit = .ok c')
    (he : Typed p c' e) (htv' : TvOK c') (hRk : skel c'.ret = skel cx.ret) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hμ : μ ≠ .own)
    (hV : ∀ rt pw ad c, evalAt th.env a = some (rt, [pw]) → pw.val = .loc ad 0 → η.sto ad.label = some c →
      ModeOK η.tid η.pfr η.seen μ ad.label c [pw] → ModeOK η.tid η.pfr η.seen .pub ad.label c [pw]) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  have hotv : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have ho : cx.opaqueOK u = true := sub_opaqueOK hsub hotv
  have htb : tb cx.ke.length u = true :=
    tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.loc μ u) = some (μ, u))
  obtain ⟨hi1, rv, wsv, hev, hvv, hlv⟩ := use_FInv hu hi
  have hsigu : sig (close th.σs u) = sig (cl ρ η.wit 0 0 u) :=
    sig_WitL hi.2.2.2.1 ρ ho (lt_of_guardT htb hi.2.2.2.2.1)
  have hwcu : wc (cl ρ η.wit 0 0 u) ≠ none := by
    rw [← wc_of_sig hsigu]; exact (Lay_canon hsub hlv).2.2.2.1
  have hna : ∀ n e, cl ρ η.wit 0 0 u ≠ .array (.lit n) e := fun n e h => hwcu (by rw [h]; simp [wc, accs])
  obtain ⟨rt, ws, hea, hv, hl⟩ := peek_VR hi.2.1 hpk
  obtain ⟨ad, c, hws, hsto, hat, hmode, hini⟩ :=
    cell_target (rfl : cellOf (.loc μ u) = some (μ, u)) (Fd_noarr fun h => hwcu (by simp [wc, h])) hv
  obtain ⟨pw, rfl, hpw⟩ := map_singleton hws
  replace hmode := hV _ pw ad c hea hpw hsto hmode
  rw [modeIni_ne_own hμ] at hini
  have hsk := hl.2.1
  obtain ⟨μr, ru, rfl, -, hsku⟩ : ∃ μr ru, rt = .loc μr ru ∧ skelM μr = skelM μ ∧
      etok (skel ru) = etok (skel (close th.σs u)) := by
    simp only [close, substTs, skel, etok] at hsk
    obtain ⟨μr, ru, rfl, h1, h2⟩ := eskel_eq_loc hsk
    exact ⟨μr, ru, rfl, h1, h2⟩
  have hsig : sig ru = sig (cl ρ η.wit 0 0 u) := by
    have h1 : sig ru = sig (close th.σs u) := sig_of_eskel hsku
    rw [h1]; exact hsigu
  have hlr := pub_accs hi.2.2.2.1 hi.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi.2.1 htv hpk rfl ho hea rfl
  obtain ⟨us, hus⟩ : ∃ us, accs ru = some us := by
    have : wc ru ≠ none := by rw [wc_of_sig hsig]; exact hwcu
    cases h : accs ru with
    | none => simp [wc, h] at this
    | some us => exact ⟨us, rfl⟩
  have husU : accs (cl ρ η.wit 0 0 u) = some us := by rw [← hlr, hus]
  obtain ⟨hval, hlen⟩ := ownStoreVal hE.2.1 hi.2.2.2.1 hi.2.2.2.2.1 hi1.1 hsub ho htb hvv hlv hsig hus
  have hwUA : accs (cl ρ η.wit 0 0 u) = some us := hlr.symm.trans hus
  have hwU : wc (cl ρ η.wit 0 0 u) = some (nWords us) := by rw [← wc_of_sig hsig]; simp [wc, hus]
  have key : tstep g mem pairs th =
      (storeUnits g.k g.arch pw ad rel us wsv 0 (stOf mem pairs th)).map fun s' =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, .unit, []) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hev, cellOf, addrOf, hpw, hus, List.map_map]; rfl
  rw [key]
  obtain ⟨s0, hs0⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := pw) (a := ad) (rel := rel)
    us wsv 0 (stOf mem pairs th) hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hs0), fun r hr => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨s', hs', rfl⟩ := hr
  refine ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv', bind_FInv hb hi1 unit_VR (unit_Lay _), retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩, ?_⟩
  by_cases hown : c.owner = some η.tid
  · exact MemInv_storeAtI hm hsto hown hat hini hna hval hwUA hlen s' hs'
  · simp only [ModeOK] at hmode
    obtain ⟨f, hf, -⟩ := hmode
    exact MemInv_storePubAt hm hsto hown hf hat hini hna hval husU hlen s' hs'

/-- **P1 + P4 at the thread, `store` through a `pub` locative** (D3 M5c).  At
the thread's own cell `MemInv_storeAt`; at another thread's,
`MemInv_storePubAt` (fulfilments allowed, T3c-7). -/
theorem tstepM_storePubLoc {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v : At} {tok : Option At}
    {u : Ty} {e : Expr}
    (hterm : th.term = .let_ x (.store rel a v tok) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.loc .pub u)) (hnw : wordOf (Ty.loc .pub u) = none)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | storeWordGive hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storeWordKeep hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storeWordHand hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storeOwn hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeRgn hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeCap hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storePub hp _ hc hwf hu hsub _ hb =>
  obtain ⟨t, u', tv, c₁, hp, hc, hwf, hu, hsub, hb⟩ : ∃ t u' tv c₁, cx.peek a = .ok t ∧
      cellOf t = some (.pub, u') ∧ Ty.wordFreeIn cx.ke u' = true ∧ cx.use v = .ok (tv, c₁) ∧
      SubS c₁ tv u' ∧ c₁.bind x .unit = .ok c' :=
    ⟨_, _, _, _, hp, hc, hwf, hu, hsub, hb⟩
  rw [hpk] at hp; cases hp
  simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc; subst hc
  exact tstepM_storeCellLoc (hterm := hterm) (hpk := hpk) (hu := hu) (hsub := hsub) (hb := hb) (he := he) (htv' := htv') (hRk := hRk) (hi := hi) (hE := hE) (htv := htv) (hm := hm) (hRP := hRP) (hPS := hPS) (hμ := fun h => by cases h) (hV := fun _ _ _ _ _ _ _ h => h)

/-! ## (T3c-5e) `fence`, `null`, `zero`, and the top-level dispatch -/

/-- (T3c-5e) **Any fence keeps `MemInv`**: a fence raises only `vPreBase`
(which `MemInv` does not read) and `vRelSt` (which it bounds from below). -/
theorem MemInv_fenceG {g : G} {E : TEnv} {s : St} (f : WeakMem.Fence) (hm : MemInv g E s) :
    MemInv g E (fenceS s f) := by
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11⟩ := hm
  cases f with
  | ld => exact ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11⟩
  | st => exact ⟨h1, h2, h3, h4, SeenLE.mono h5 (Nat.le_max_left _ _), h6, h7, h8, h9, h10, h11⟩
  | sy => exact ⟨h1, h2, h3, h4, SeenLE.mono h5 (Nat.le_max_left _ _), h6, h7, h8, h9, h10, h11⟩

/-- (T3c-5e) A frame does not read what a fence changes in the context
(torn reads, saw-marks, unsealed names). -/
theorem FInv_fenceCx {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {K : TEnv → List Word → Prop} {cx : Cx}
    {env : Env} (f : Fence) (h : FInv ρ η σs K cx env) : FInv ρ η σs K (fenceCx cx f) env := by
  cases f <;> exact h

section
variable {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {cx : Cx} {ρ : Nat → Nat} {η : TEnv}

/-- (T3c-5e) **P1 + P4 at the thread, `fence`**: the step only raises views. -/
theorem tstepM_fence {x : String} {f : Fence} {e : Expr}
    (hterm : th.term = .let_ x (.fence f) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | fence hb =>
  have key : tstep g mem pairs th =
      [((fenceS (stOf mem pairs th) (toWFence f)).mem, (fenceS (stOf mem pairs th) (toWFence f)).pairs,
        withS { th with term := e, env := (x, .unit, []) :: th.env } (fenceS (stOf mem pairs th) (toWFence f)))] := by
    simp only [tstep, hterm, evalOp]; rfl
  rw [key]
  refine ⟨by simp, fun r hr => ?_⟩
  simp only [List.mem_singleton] at hr
  subst hr
  have hvr : VR ρ η .unit (shp .unit) [] := by simp [VR]
  have hlay : Lay th.σs .unit .unit [] := by
    refine ⟨fun us h => ?_, rfl, by simp [wc, accs], by simp [Valid], rfl⟩
    simp [accs] at h; subst h; rfl
  exact ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv', by simpa [withS] using bind_FInv hb (FInv_fenceCx f hi) hvr hlay, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
    MemInv_fenceG _ hm⟩

/-- (T3c-5e) **P1 + P4 at the thread, `null`**: a null `Ptr?`, no memory. -/
theorem tstepM_null {x : String} {μ : Mode} {τ : Ty} {e : Expr}
    (hterm : th.term = .let_ x (.null μ τ) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | null hwf hb =>
  have key : tstep g mem pairs th =
      [((stOf mem pairs th).mem, (stOf mem pairs th).pairs,
        withS { th with term := e, env := (x, .ptrOpt μ (close th.σs τ), [cst .null]) :: th.env }
          (stOf mem pairs th))] := by
    simp only [tstep, hterm, evalOp]; rfl
  rw [key]
  refine ⟨by simp, fun r hr => ?_⟩
  simp only [List.mem_singleton] at hr
  subst hr
  have hvr : VR ρ η (.ptrOpt μ τ) (shp (.ptrOpt μ (close th.σs τ))) [cst .null] := by simp only [VR]; exact Or.inl rfl
  have hlay : Lay th.σs (.ptrOpt μ τ) (.ptrOpt μ (close th.σs τ)) [cst .null] := by
    refine ⟨fun us h => ?_, ?_, by simp [wc, accs], by simp only [Valid]; exact Or.inl rfl, ?_⟩
    · simp [accs] at h; subst h; rfl
    · simp [close, substTs, skel]
    · simp [close, substTs, lyt]
  exact ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv', by simpa [withS] using bind_FInv hb hi hvr hlay, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩, hm⟩


/-- (T3d-1) A runtime protocol word's binding: one word, runtime type `word 0 P`. -/
theorem Lay_word (σs : List Ty) (r : Idx) (P : Proto) (hg : P.ghost = false) (w : Word) :
    Lay σs (.word r P) (.word (.lit 0) P) [w] := by
  refine ⟨fun us h => ?_, by simp [close, substTs, skel], by simp [wc, accs, hg], trivial,
    by simp [close, substTs, lyt, idxC_lit]; rfl⟩
  simp [accs, hg] at h; subst h; rfl

/-- (T3d-1) **P1 + P4 at the thread, `mkWord`**: the word is born in a state of
its protocol (the rule's `InState`), which is what `VR` at `word` now asks. -/
theorem tstepM_mkWord {x rn : String} {P : Proto} {v tk : At} {e : Expr}
    (hterm : th.term = .let_ x (.mkWord rn P v tk) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hng : P.ghost = false) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | mkWordGhost _ _ _ _ _ _ _ hg => rw [hng] at hg; cases hg
  | mkWord _ hpwf hu _ hv hst _ _ _ hb =>
  obtain ⟨hi1, -⟩ := use_FInv hu hi
  obtain ⟨tv, htvk, hio⟩ := hv
  obtain ⟨rt, w, hea, hwv, -⟩ := atom_num hi1.2.1 htvk hio
  have key : tstep g mem pairs th =
      [((stOf mem pairs th).mem, (stOf mem pairs th).pairs,
        withS { th with term := e, env := (x, .word (.lit 0) P, [w]) :: th.env } (stOf mem pairs th))] := by
    simp only [tstep, hterm, evalOp, hng, hea]; rfl
  rw [key]
  refine ⟨by simp, fun r hr => ?_⟩
  simp only [List.mem_singleton] at hr
  subst hr
  have hvr : ∀ r', VR ρ η (.word r' P) (shp (.word (.lit 0) P)) [w] := by
    intro r'
    simp only [VR]
    refine ⟨hpwf, fun _ => ?_⟩
    obtain ⟨cl', hcl', hent⟩ := hst
    exact ⟨_, by simp [hwv], _, cl', _, hcl', hent ρ hi1.1⟩
  exact ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv', by simpa [withS] using bind_FInv hb hi1 (hvr _) (Lay_word _ _ _ hng w), retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩, hm⟩

/-- (T3c-5e) **P1 + P4 at the thread, `zero`**: the machine's zero at the
runtime type exists (the static `Zeroable` implies the runtime one,
`zero_close`) and is a value of the witness rendition (`zero_valOf`), hence of
the static type at the frame's runtime type. -/
theorem tstepM_zero {x : String} {τ : Ty} {e : Expr}
    (hterm : th.term = .let_ x (.zero τ) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | zero hwf hsc hz hb =>
  have ho := bind_opaqueOK hb
  have haf := bind_arrFree hb
  have hr : ∀ k, τ.guardT k = false → k < th.σs.length := lt_of_guardT (tb_of_wf τ hwf) hi.2.2.2.2.1
  have hsig : sig (close th.σs τ) = sig (cl ρ η.wit 0 0 τ) := sig_WitL hi.2.2.2.1 ρ ho hr
  have hafT : (cl ρ η.wit 0 0 τ).arrFree = true := arrFree_cl hi.2.2.2.2.2.2.1.af τ 0 0 haf
  have hafR : (close th.σs τ).arrFree = true := by rw [← arrFree_sig, hsig, arrFree_sig]; exact hafT
  have hR := KindSound.zero_close cx.ke th.σs τ hi.2.2.2.2.2.1.2.1 hz
  obtain ⟨zs, hzs, -⟩ := zp _ _ (Nat.lt_succ_self _) [] [] hafR knone_nil hR
  obtain ⟨hval, hwc⟩ := zero_valOf hi.2.2.2.1 (fun k => (hE.2.1 k).1) hi.2.2.2.2.2.2.1 ρ ho hr haf hR hzs
  have key : tstep g mem pairs th =
      [((stOf mem pairs th).mem, (stOf mem pairs th).pairs,
        withS { th with term := e, env := (x, close th.σs τ, zs.map cst) :: th.env } (stOf mem pairs th))] := by
    simp only [tstep, hterm, evalOp, hzs]; rfl
  rw [key]
  refine ⟨by simp, fun r hr' => ?_⟩
  simp only [List.mem_singleton] at hr'
  subst hr'
  obtain ⟨hvr0, hV0⟩ := ValOf.env hval
  have hwcr : wc (close th.σs τ) = some zs.length := by rw [wc_of_sig hsig]; exact hwc
  have hvr : VR ρ η τ (shp (close th.σs τ)) (zs.map cst) := by
    rw [shp_of_sig hsig]
    exact (VR_close hE.2.1 ρ τ [] 0 ρ (fun _ => 0) (shp (cl ρ η.wit 0 0 τ)) _ (fun k => rfl)
      (fun k hk => absurd hk (Nat.not_lt_zero _))).2 hvr0
  have hlay : Lay th.σs τ (close th.σs τ) (zs.map cst) := by
    refine ⟨fun us h => ?_, rfl, by simp [hwcr], Valid_of_sig hsig.symm hV0, rfl⟩
    simp [wc, h] at hwcr; simp; omega
  exact ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv', by simpa [withS] using bind_FInv hb hi hvr hlay, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩, hm⟩

end


/-! ### (T3c-5h) `fold` -/

/-- (T3c-5h) Folding a reference's pointee or a locative's target: its cell's
component folds it too. -/
theorem Fd_foldS {T u s : Ty} {ρ : Nat → Nat} {W : Nat → Ty} (hW : ∀ k, Clo (W k))
    (hg : s.unguarded 0 = false) (hF : Fd T (cl ρ W 0 0 u))
    (hcl : cl ρ W 0 0 u = cl ρ W 0 0 (unfold1 (.mu s))) :
    Fd T (cl ρ W 0 0 (.mu s)) := by
  rw [hcl] at hF
  exact .fold hW hg (accs_cl_unfold_eq hW hg) hF

theorem wf_mu_guard {μ : Mode} {s : Ty} {nt ni : Nat} :
    ((Ty.ptr μ (.mu s)).wf nt ni = true ∨ (Ty.ptrOpt μ (.mu s)).wf nt ni = true ∨
      (Ty.loc μ (.mu s)).wf nt ni = true) → s.unguarded 0 = false := by
  intro h
  rcases h with h | h | h <;> simp [Ty.wf] at h <;> simp [h]

theorem single_len {ws : List Word} {v : WeakMem.Val} (h : ws.map (·.val) = [v]) : ws.length = 1 := by
  have := congrArg List.length h; simpa using this

/-- (T3c-5h) **P1 + P4 at the thread, `fold`**: the reference's words, at the
folded type. -/
theorem tstepM_fold {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {a : At} {τ : Ty} {e : Expr}
    (hterm : th.term = .let_ x (.fold a τ) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | fold hwf hu hfo hb =>
  rename_i c₁ t
  obtain ⟨hi1, rv, wsv, hev, hvv, hlv⟩ := use_FInv hu hi
  have key : tstep g mem pairs th =
      [((stOf mem pairs th).mem, (stOf mem pairs th).pairs,
        withS { th with term := e, env := (x, close th.σs τ, wsv) :: th.env } (stOf mem pairs th))] := by
    simp only [tstep, hterm, evalOp, hev]; rfl
  rw [key]
  refine ⟨by simp, fun r hr => ?_⟩
  simp only [List.mem_singleton] at hr
  subst hr
  have hW : ∀ k, Clo (η.wit k) := fun k => (hE.2.1 k).1
  have hsat : Sat c₁.facts ρ := hi1.1
  suffices h : VR ρ η τ (shp (close th.σs τ)) wsv ∧ Lay th.σs τ (close th.σs τ) wsv from
    ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv', by simpa [withS] using bind_FInv hb hi1 h.1 h.2, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩, hm⟩
  cases hfo with
  | @ptr μ ν u s hme hte =>
      have hg := wf_mu_guard (Or.inl hwf)
      have hcl := cl_tyEq0 hte η.wit 0 (fun _ => hsat)
      simp only [VR] at hvv
      obtain ⟨ad, c, h1, h2, h3, h4, h5, h6⟩ := hvv
      refine ⟨⟨ad, c, h1, h2, h3, Fd_foldS hW hg h4 hcl, by rw [← ModeOK_meq hme]; exact h5, h6⟩,
        fun us h => ?_, rfl, by simp [close, substTs, wc, accs], ?_, rfl⟩
      · simp [close, substTs, accs] at h; subst h; exact single_len h1
      · simp only [close, substTs, Valid]; exact ⟨_, h1⟩
  | @ptrOpt μ ν u s hme hte =>
      have hg := wf_mu_guard (Or.inr (Or.inl hwf))
      have hcl := cl_tyEq0 hte η.wit 0 (fun _ => hsat)
      simp only [VR] at hvv
      rcases hvv with hn | ⟨ad, c, h1, h2, h3, h4, h5, h6⟩
      · refine ⟨Or.inl hn, fun us h => ?_, rfl, by simp [close, substTs, wc, accs], ?_, rfl⟩
        · simp [close, substTs, accs] at h; subst h; exact single_len hn
        · simp only [close, substTs, Valid]; exact Or.inl hn
      · refine ⟨Or.inr ⟨ad, c, h1, h2, h3, Fd_foldS hW hg h4 hcl, by rw [← ModeOK_meq hme]; exact h5, h6⟩,
          fun us h => ?_, rfl, by simp [close, substTs, wc, accs], ?_, rfl⟩
        · simp [close, substTs, accs] at h; subst h; exact single_len h1
        · simp only [close, substTs, Valid]; exact Or.inr ⟨_, h1⟩
  | @loc μ ν u s hme hte =>
      have hg := wf_mu_guard (Or.inr (Or.inr hwf))
      have hcl := cl_tyEq0 hte η.wit 0 (fun _ => hsat)
      simp only [VR] at hvv
      rcases hvv with ⟨hn, e0, he0⟩ | ⟨ad, c, U, h1, h3, h4, hF, h5, h6⟩
      · refine ⟨Or.inl ⟨hn, e0, Fd_foldS hW hg he0 hcl⟩, fun us h => ?_, rfl,
          by simp [close, substTs, wc, accs], ?_, rfl⟩
        · simp [close, substTs, accs] at h; subst h; exact single_len hn
        · simp only [close, substTs, Valid]; exact Or.inl hn
      · refine ⟨Or.inr ⟨ad, c, U, h1, h3, h4, Fd_foldS hW hg hF hcl, by rw [← ModeOK_meq hme]; exact h5,
            by rw [← modeIni_meq hme]; exact h6⟩, fun us h => ?_, rfl, by simp [close, substTs, wc, accs], ?_, rfl⟩
        · simp [close, substTs, accs] at h; subst h; exact single_len h1
        · simp only [close, substTs, Valid]; exact Or.inr ⟨_, h1⟩

/-! ### (T3c-5g) The lane-buffer ops -/

/-- (T3c-5g) `slot_view` at a numeric slot `J` (a lane op's word index is
computed, not an atom). -/
theorem slot_viewN {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {env : Env} {b : At}
    {t u : Ty} {μ : Mode} {n k : Idx} (J : Nat)
    (hvars : VarsOK ρ η σs cx.vars env) (hW : WitL σs η.wit cx.opq)
    (hK : cx.ke.length ≤ σs.length) (htv : TvOK cx)
    (hp : cx.peek b = .ok t) (hbuf : bufOf t = some (μ, n, u, k)) (hJ : J < ev ρ n) (hJk : J < ev ρ k)
    (hop : cx.opaqueOK u = true) :
    ∃ rt w ad c μr ur us, evalAt env b = some (rt, [w]) ∧ w.val = .loc ad 0 ∧
      bufElem rt = some (μr, ur) ∧ accs ur = some us ∧ η.sto ad.label = some c ∧
      AtOff c.ty (offs ad (J * nWords us)).offset (cl ρ η.wit 0 0 u) ∧ ModeOK η.tid η.pfr η.seen μ ad.label c [w] ∧
      IniAt (modeIni μ η.ini η.rini) c (offs ad (J * nWords us)) (cl ρ η.wit 0 0 u) ∧
      etok (skel ur) = etok (skel (close σs u)) ∧ sig ur = sig (cl ρ η.wit 0 0 u) := by
  have ht : t = .refine (.loc μ (.array n u)) (.ini k) := by
    unfold bufOf at hbuf; split at hbuf
    · simp only [Option.some.injEq, Prod.mk.injEq] at hbuf
      obtain ⟨rfl, rfl, rfl, rfl⟩ := hbuf; rfl
    · simp at hbuf
  subst ht
  obtain ⟨rt, ws, hea, hv, hl⟩ := peek_VR hvars hp
  simp only [VR] at hv
  obtain ⟨hv, hir⟩ := hv
  rcases hv with ⟨-, e, he⟩ | ⟨ad, c, U, hws, hsto, hat, hFU, hmode, hini⟩
  · have he := Fd_nonmu he (fun b => by simp [cl])
    simp only [cl, clI_zero, Ty.array.injEq, Idx.lit.injEq] at he
    omega
  obtain rfl := Fd_nonmu hFU (fun b => by simp [cl])
  obtain ⟨w, rfl, hwv⟩ := map_singleton hws
  have hKm : ev ρ k ≤ modeIni μ η.ini η.rini ad.label := by
    simp only [IniR] at hir; have h := hir ad (by simp [hwv]); rw [TEnv.selIni_loc] at h; exact h
  have hJi : J < modeIni μ η.ini η.rini ad.label := Nat.lt_of_lt_of_le hJk hKm
  simp only [cl, clI_zero] at hini
  have hlay := AtOff_lay hat
  simp only [cl, clI_zero] at hlay
  obtain ⟨us, hus⟩ : ∃ us, accs (cl ρ η.wit 0 0 u) = some us := by
    rcases hlay with h | ⟨n', e', he', h⟩
    · simp [accs] at h
    · simp only [Ty.array.injEq] at he'; rw [he'.2]
      exact Option.ne_none_iff_exists'.1 h
  have hat' : AtOff c.ty (ad.offset + (J * nWords us + 0)) (cl ρ η.wit 0 0 u) := by
    refine AtOff_trans hat ?_
    simp only [cl, clI_zero]
    exact .elem hus hJ (.here (Or.inl (by rw [hus]; simp)))
  have hs' : etok (skel rt) = rf (.loc (skelM μ) (.array (.lit 0) (etok (skel (close σs u))))) := by
    rw [hl.2.1]; rfl
  obtain ⟨μr, ur, hbe, hμ, hsu⟩ := buf_runtime hs'
  have htb := peek_tb htv hp
  simp only [tb] at htb
  have hsig : sig ur = sig (cl ρ η.wit 0 0 u) := by
    have e : sig ur = sig (close σs u) := sig_of_eskel hsu
    rw [e]; exact sig_WitL hW ρ hop (lt_of_guardT htb hK)
  have hwc := wc_of_sig hsig
  cases hus' : accs ur with
  | none => simp [wc, hus', hus] at hwc
  | some us' =>
      have hn : nWords us' = nWords us := by simpa [wc, hus, hus'] using hwc
      refine ⟨rt, w, ad, c, μr, ur, us', hea, hwv, hbe, hus', hsto,
        ?_, hmode, IniAt_idx hini hus hJi hJ hn, hsu, hsig⟩
      simpa [offs, hn] using hat'

theorem lanes_of {u : Ty} {q : Bool × Wd} (h : lanesOf u = some q) : u = .lanes q.1 q.2 := by
  cases u <;> simp [lanesOf] at h
  subst h; rfl

theorem fix_of {u : Ty} {q : Bool × Wd} (h : fixOf u = some q) : u = .fix q.1 q.2 := by
  cases u <;> simp [fixOf] at h
  subst h; rfl

theorem skel_lanes {t : Ty} {sg : Bool} {w : Wd} (h : skel t = .lanes sg w) : t = .lanes sg w := by
  cases t with
  | lanes sg' w' => simp only [skel, Ty.lanes.injEq] at h; obtain ⟨rfl, rfl⟩ := h; rfl
  | refine t ψ => simp only [skel] at h; unfold rf at h; split at h <;> simp at h
  | _ => simp [skel] at h

theorem fix_VR {ρ : Nat → Nat} {η : TEnv} (sg : Bool) (w : Wd) (x : Nat) :
    VR ρ η (.fix sg w) (shp (.fix sg w)) [cst (.num (fmask w x))] := by
  simp only [VR, shp]; exact ⟨trivial, fmask w x, rfl, fmask_lt _ _⟩

theorem fix_Lay (σs : List Ty) (sg : Bool) (w : Wd) (v : WeakMem.Val) : Lay σs (.fix sg w) (.fix sg w) [cst v] := by
  refine ⟨fun us h => ?_, rfl, by simp [wc, accs], trivial, rfl⟩
  simp [accs] at h; subst h; rfl


/-- (T3c-5g) The lane element type at runtime: the buffer's runtime element is
the static `lanes` type itself, one word wide. -/
theorem lane_rt {σs : List Ty} {ur : Ty} {sg : Bool} {w : Wd} {us : List Acc}
    (hsku : etok (skel ur) = etok (skel (close σs (.lanes sg w)))) (hus : accs ur = some us) :
    ur = .lanes sg w ∧ us = [.one] := by
  have h := eskel_eq_lanes (by rw [hsku]; rfl)
  subst h
  simp [accs] at hus
  exact ⟨rfl, hus.symm⟩

/-- (T3c-5g) **P1 + P4 at the thread, `ldlw`**: a plain load of word `wi` of an
own `lanes` buffer (`slot_view`, `locLoad`), then a lane of it, a `fix` value. -/
theorem tstepM_ldlw {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {b wi jl : At} {e : Expr}
    (hterm : th.term = .let_ x (.ldlw b wi jl) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hpx : PAx g mem pairs th) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | ldlw hp hbuf hlo hint hlt hltk hpj hij hb =>
  obtain ⟨t, u, n, k, jw, tj, q, hp, hbuf, hlo, hint, hlt, hltk, hpj, hij, hb⟩ : ∃ t u n k jw tj q,
      cx.peek b = .ok t ∧ bufOf t = some (.own, n, u, k) ∧ lanesOf u = some q ∧ IntIdx cx wi jw ∧
      LtI cx jw n ∧ LtI cx jw k ∧ cx.peek jl = .ok tj ∧ (intOf tj).isSome = true ∧
      cx.bind x (.fix q.1 q.2) = .ok c' :=
    ⟨_, _, _, _, _, _, _, hp, hbuf, hlo, hint, hlt, hltk, hpj, hij, hb⟩
  obtain ⟨sg, w⟩ := q
  have hu := lanes_of hlo
  simp only at hu hb
  subst hu
  have ho : cx.opaqueOK (.lanes sg w) = true := by simp [Cx.opaqueOK, Ty.guardT]
  obtain ⟨ti, hpi, hti⟩ := hint
  obtain ⟨rti, wwi, hei, hwi, -⟩ := atom_num hi.2.1 hpi hti
  obtain ⟨oj, hoj⟩ := Option.isSome_iff_exists.1 hij
  obtain ⟨rtj, wj, m, hej, hwj⟩ := atom_int hi.2.1 hpj hoj
  have hJ := hlt ρ hi.1
  have hJk := hltk ρ hi.1
  obtain ⟨rt, pw, ad, c, μr, ur, us, hea, hwv, hbe, hus, hsto, hat, hmode, hini, hsku, hsig⟩ :=
    slot_viewN (ev ρ jw) hi.2.1 hi.2.2.2.1 hi.2.2.2.2.1 htv hp hbuf hJ hJk ho
  obtain ⟨rfl, rfl⟩ := lane_rt hsku hus
  have e1 : ev ρ jw * nWords [Acc.one] = ev ρ jw := by simp [nWords, Acc.size]
  rw [e1] at hat hini
  have hna : ∀ N e', cl ρ η.wit 0 0 (.lanes sg w) ≠ .array (.lit N) e' := fun N e' h => by simp [cl] at h
  obtain ⟨us', hus', ⟨r0, hr0⟩, hld, hstw⟩ := locLoad (ad := offs ad (ev ρ jw)) (arch := g.arch) (pw := pw) (acq := false)
    (s := stOf mem pairs th) hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hsto hmode hat hini hna hsku hsig
      (peek_buf_lyt hi.2.1 hp hbuf hea hbe).2
        (accs_rtW hE.2.1 hi.2.2.2.1 hi.2.2.2.2.1 ho (by simp [tb]) (peek_buf_lyt hi.2.1 hp hbuf hea hbe).2)
  simp [accs] at hus'; subst hus'
  have hni : numOf [wwi] = some (ev ρ jw) := by simp [numOf, hwi]
  have hnj : numOf [wj] = some m := by simp [numOf, hwj]
  have key : tstep g mem pairs th =
      ((loadUnits g.arch pw (offs ad (ev ρ jw)) false [.one] 0 (stOf mem pairs th)).filterMap fun (s1, old) =>
        (numOf old).map fun y => (s1, Ty.fix sg w, [cst (.num (laneN w y (m % w.lanes)))])).map
        fun (s', t, ws) => (s'.mem, s'.pairs, withS { th with term := e, env := (x, t, ws) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hei, hej, hni, hnj, addrOf, hwv, hbe, lanesOf]
  -- every load reads a number (`VR` at `lanes`)
  have hnum : ∀ r1, r1 ∈ loadUnits g.arch pw (offs ad (ev ρ jw)) false [.one] 0 (stOf mem pairs th) →
      PromAbove r1.1 → ∃ y, numOf r1.2 = some y := fun r1 h hp => by
    obtain ⟨hvr, -⟩ := hld r1 h hp
    simp only [VR] at hvr
    obtain ⟨-, y, hy⟩ := hvr
    obtain ⟨w0, h0, hw0⟩ := map_singleton hy
    exact ⟨y, by rw [h0]; simp [numOf, hw0]⟩
  unfold PAx at hpx
  rw [key] at hpx ⊢
  refine ⟨?_, fun r hr hpr0 => ?_⟩
  · rcases hpx with h0 | ⟨r, hr, -⟩
    rotate_left
    · exact List.ne_nil_of_mem hr
    obtain ⟨y0, hy0⟩ := hnum r0 hr0 (PromAbove_nil (by rw [(loadUnits_frame _ _ _ r0 hr0).2.2.1]; exact h0))
    refine List.ne_nil_of_mem (List.mem_map_of_mem (List.mem_filterMap.2 ⟨r0, hr0,
      (?_ : _ = some (r0.1, Ty.fix sg w, [cst (.num (laneN w y0 (m % w.lanes)))]))⟩))
    obtain ⟨s0, o0⟩ := r0; simp only at hy0 ⊢; rw [hy0]; rfl
  have hpr := hpr0
  rw [List.mem_map] at hr
  obtain ⟨⟨s', t', ws'⟩, hr, rfl⟩ := hr
  rw [List.mem_filterMap] at hr
  obtain ⟨⟨s1, old⟩, h1, h2⟩ := hr
  simp only at h2
  obtain ⟨y, hy⟩ : ∃ y, numOf old = some y := by
    cases hn : numOf old with
    | none => simp [hn] at h2
    | some y => exact ⟨y, rfl⟩
  rw [hy, Option.map_some, Option.some.injEq, Prod.mk.injEq] at h2
  obtain ⟨rfl, rfl, rfl⟩ := h2
  obtain ⟨-, -, f1, f2, f3, f4, f5⟩ := hld (s1, old) h1 hpr
  exact ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv',
    bind_FInv hb hi (fix_VR sg w _) (fix_Lay _ sg w _), retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
    MemInv_load hm f1 f2 f3 f4 f5 (loadUnits_relSt _ _ _ _ h1) (loadUnits_vWr _ _ _ _ h1)⟩


/-- (T3c-5g) **P1 + P4 at the thread, `ldl`**: `ldlw` at word `j / lanes`,
lane `j % lanes`; the word is in range because `j < lanes · n`. -/
theorem tstepM_ldl {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {b i : At} {e : Expr}
    (hterm : th.term = .let_ x (.ldl b i) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hpx : PAx g mem pairs th) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | ldl hp hbuf hlo hint hlt hltk hb =>
  obtain ⟨t, u, n, k, j, q, hp, hbuf, hlo, hint, hlt, hltk, hb⟩ : ∃ t u n k j q,
      cx.peek b = .ok t ∧ bufOf t = some (.own, n, u, k) ∧ lanesOf u = some q ∧ IntIdx cx i j ∧
      LtI cx j (.smul q.2.lanes n) ∧ LtI cx j (.smul q.2.lanes k) ∧ cx.bind x (.fix q.1 q.2) = .ok c' :=
    ⟨_, _, _, _, _, _, hp, hbuf, hlo, hint, hlt, hltk, hb⟩
  obtain ⟨sg, w⟩ := q
  have hu := lanes_of hlo
