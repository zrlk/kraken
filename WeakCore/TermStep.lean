/-- (U3 R1) **Agreement on a label set**: what `VR` reads at the labels of
`G`, from `η₁` to `η₂`: cells kept, counts grown, frontiers kept or lowered
(kept at seen labels), boxes kept with payloads naming `G` only. -/
structure AgreeG (G : AllocLabel → Prop) (η₁ η₂ : TEnv) : Prop where
  sto : ∀ l c, G l → η₁.sto l = some c → η₂.sto l = some c
  ini : ∀ l, G l → η₁.ini l ≤ η₂.ini l
  rini : ∀ l, G l → η₁.rini l ≤ η₂.rini l
  pfr : ∀ l f, G l → η₁.pfr l = some f → ∃ f', η₂.pfr l = some f' ∧ f' ≤ f
  pfrS : ∀ l f, G l → η₁.seen l → η₁.pfr l = some f → η₂.pfr l = some f
  seen : ∀ l, G l → η₁.seen l → η₂.seen l
  box : ∀ l B, G l → η₁.box l = some B → η₂.box l = some B ∧ LabsIn G B.pay
  wit : η₁.wit = η₂.wit
  prog : η₁.prog = η₂.prog
  tid : η₁.tid = η₂.tid

theorem AgreeG.unsee {G : AllocLabel → Prop} {η₁ η₂ : TEnv} (h : AgreeG G η₁ η₂) :
    AgreeG G η₁.unsee η₂.unsee :=
  ⟨h.sto, h.ini, h.rini, h.pfr, fun _ _ _ hs => hs.elim, fun _ _ hs => hs.elim, h.box, h.wit, h.prog, h.tid⟩

theorem AgreeG.push0 {G : AllocLabel → Prop} {η₁ η₂ : TEnv} (h : AgreeG G η₁ η₂) (s : Ty) :
    AgreeG G (η₁.push0 s) (η₂.push0 s) :=
  ⟨h.sto, h.ini, h.rini, h.pfr, h.pfrS, h.seen, h.box,
    by simp only [TEnv.push0, TEnv.ins, TEnv.insR, h.wit], h.prog, h.tid⟩

theorem ModeOK_monoG {i : Nat} {P P' : AllocLabel → Option Ts} {S S' : AllocLabel → Prop}
    {μ : Mode} {l : AllocLabel} {c : Cell} {ws : List Word}
    (hP : ∀ f, P l = some f → ∃ f', P' l = some f' ∧ f' ≤ f)
    (hPS : ∀ f, S l → P l = some f → P' l = some f) (hS : S l → S' l) :
    ModeOK i P S μ l c ws → ModeOK i P' S' μ l c ws := by
  cases μ with
  | own => exact id
  | rgn _ => exact id
  | pub =>
    rintro ⟨f, hf, h | h⟩
    · exact ⟨f, hPS f h hf, .inl (hS h)⟩
    · obtain ⟨f', h1, h2⟩ := hP f hf
      exact ⟨f', h1, .inr fun w hw => Nat.le_trans h2 (h w hw)⟩

theorem IniR_monoG {G : AllocLabel → Prop} {ρ : Nat → Nat} {i₁ i₂ : AllocLabel → Nat}
    (h : ∀ l, G l → i₁ l ≤ i₂ l) {ws : List Word} (hG : LabsIn G ws) :
    ∀ {ψ : Pred}, IniR ρ i₁ ψ ws → IniR ρ i₂ ψ ws := by
  intro ψ
  induction ψ with
  | ini k => intro hv; simp only [IniR] at hv ⊢; intro a ha; exact Nat.le_trans (hv a ha) (h _ (LabsIn_one hG ha))
  | and p q ihp ihq => intro hv; simp only [IniR] at hv ⊢; exact ⟨ihp hv.1, ihq hv.2⟩
  | _ => intro _; simp [IniR]

theorem selIni_leG {G : AllocLabel → Prop} {η₁ η₂ : TEnv} (h : AgreeG G η₁ η₂) (t : Ty) :
    ∀ l, G l → η₁.selIni t l ≤ η₂.selIni t l := by
  intro l hl
  have h1 := h.ini l hl; have h2 := h.rini l hl
  unfold TEnv.selIni; rw [TEnv.ownTop_congr h.wit t]; split
  · simp only; omega
  · exact h1

theorem IniAt_monoG {i₁ i₂ : AllocLabel → Nat} {c : Cell} {a : Address} {U : Ty}
    (h : i₁ a.label ≤ i₂ a.label) (hv : IniAt i₁ c a U) : IniAt i₂ c a U := by
  intro N e hc
  rcases hv N e hc with h1 | ⟨us, j, o, h1, h2, h3, h4⟩
  · exact Or.inl h1
  · exact Or.inr ⟨us, j, o, h1, Nat.lt_of_lt_of_le h2 h, h3, h4⟩

theorem modeIni_leG {G : AllocLabel → Prop} {η₁ η₂ : TEnv} (h : AgreeG G η₁ η₂) (μ : Mode) {l : AllocLabel}
    (hl : G l) : modeIni μ η₁.ini η₁.rini l ≤ modeIni μ η₂.ini η₂.rini l := by
  have h1 := h.ini l hl; have h2 := h.rini l hl
  cases μ <;> simp only [modeIni] <;> omega

/-- (U3 R1) **`VR` transfers along agreement on the labels it names**: `VR_mono`
with every label condition restricted to `G` (the value's words, and boxes'
payloads, naming `G` only) and frontiers allowed to fall (a view past the old
frontier is past the new one). -/
theorem VR_monoG {G : AllocLabel → Prop} : ∀ (t : Ty) (η₁ η₂ : TEnv) (ρ : Nat → Nat) (rt : Shp) (ws : List Word),
    (∀ k S vs, η₁.rels k S vs → η₂.rels k S vs) → (∀ k S vs, η₁.urels k S vs → η₂.urels k S vs) →
    AgreeG G η₁ η₂ → LabsIn G ws → VR ρ η₁ t rt ws → VR ρ η₂ t rt ws
  | .tvar k, η₁, η₂, ρ, rt, ws, hr, _, _, _, hv => by
      simp only [VR, TEnv.get] at hv ⊢
      obtain ⟨w0, h0, h1⟩ := hv; exact ⟨w0, h0, hr k rt _ h1⟩
  | .refine t ψ, η₁, η₂, ρ, rt, ws, hr, hur, hA, hG, hv => by
      simp only [VR] at hv ⊢
      exact ⟨VR_monoG t η₁ η₂ ρ rt ws hr hur hA hG hv.1, IniR_monoG (selIni_leG hA t) hG hv.2⟩
  | .iex b, η₁, η₂, ρ, rt, ws, hr, hur, hA, hG, hv => by
      simp only [VR] at hv ⊢
      obtain ⟨n, rb, w, h1, h2⟩ := hv
      exact ⟨n, rb, w, h1, VR_monoG b η₁ η₂ (vcons w ρ) rb ws hr hur hA hG h2⟩
  | .prod a b, η₁, η₂, ρ, rt, ws, hr, hur, hA, hG, hv => by
      simp only [VR] at hv ⊢
      obtain ⟨ra, rb, h1, hf⟩ := hv
      refine ⟨ra, rb, h1, fun n hn => ?_⟩
      obtain ⟨e1, e2, e3⟩ := hf n hn
      exact ⟨e1, VR_monoG a η₁ η₂ ρ _ _ hr hur hA (LabsIn_sub hG fun _ h => List.mem_of_mem_take h) e2,
        VR_monoG b η₁ η₂ ρ _ _ hr hur hA (LabsIn_sub hG fun _ h => List.mem_of_mem_drop h) e3⟩
  | .sum a b, η₁, η₂, ρ, rt, ws, hr, hur, hA, hG, hv => by
      simp only [VR] at hv ⊢
      obtain ⟨n, Ra, Rb, h1, ⟨hb, x, s, B, hx, ho, hB, hn, hsB, hm, hA1, hA'⟩ | ⟨j, p, hd, h2, h3⟩⟩ := hv
      · have hxG : G x.label := LabsIn_one hG hx
        obtain ⟨hB2, hpay⟩ := hA.box _ _ hxG hB
        refine ⟨n, Ra, Rb, h1, Or.inl ⟨hb, x, s, B, hx, ho, hB2, hn, hsB,
          hm.imp (fun ⟨h1, f, h2, h3⟩ => ⟨hA.seen _ hxG h1, f, hA.pfrS _ _ hxG h1 h2, h3⟩) id,
          fun hj => ⟨fun e => VR_monoG a η₁ η₂ ρ _ _ hr hur hA hG ((hA1 hj).1 e), fun e => ?_⟩,
          fun hj => ⟨fun e => VR_monoG b η₁ η₂ ρ _ _ hr hur hA hG ((hA' hj).1 e), fun e => ?_⟩⟩⟩
        · obtain ⟨q, hq, hs1, hw1, hv1, hv⟩ := (hA1 hj).2 e
          exact ⟨q, hq, hs1, hw1, hv1, VR_monoG a η₁.unsee η₂.unsee ρ _ _ hur hur hA.unsee (ofArm_labs hq hpay) hv⟩
        · obtain ⟨q, hq, hs1, hw1, hv1, hv⟩ := (hA' hj).2 e
          exact ⟨q, hq, hs1, hw1, hv1, VR_monoG b η₁.unsee η₂.unsee ρ _ _ hur hur hA.unsee (ofArm_labs hq hpay) hv⟩
      · have hpG := decodeArm_labs hd hG
        refine ⟨n, Ra, Rb, h1, Or.inr ⟨j, p, hd, fun hj => ?_, fun hj => ?_⟩⟩
        · obtain ⟨q, hq, hv⟩ := h2 hj; exact ⟨q, hq, VR_monoG a η₁ η₂ ρ _ _ hr hur hA (ofArm_labs hq hpG) hv⟩
        · obtain ⟨q, hq, hv⟩ := h3 hj; exact ⟨q, hq, VR_monoG b η₁ η₂ ρ _ _ hr hur hA (ofArm_labs hq hpG) hv⟩
  | .code a b _, η₁, η₂, ρ, rt, ws, _, _, hA, _, hv => by
      simp only [VR] at hv ⊢; rw [← hA.wit, ← hA.prog]; exact hv
  | .tex κ b, η₁, η₂, ρ, rt, ws, hr, hur, hA, hG, hv => by
      simp only [VR] at hv ⊢
      obtain ⟨n, rb, s, h1, h2, haf, h3⟩ := hv
      exact ⟨n, rb, s, h1, h2, haf, VR_monoG b (η₁.push0 s) (η₂.push0 s) ρ rb ws
        (push0_rels_mono hr) (push0_urels_mono hur) (hA.push0 s) hG h3⟩
  | .ptr μ u, η₁, η₂, ρ, rt, ws, _, _, hA, hG, hv => by
      simp only [VR] at hv ⊢
      obtain ⟨a, c, h1, h2, h3, h4, h5, h6⟩ := hv
      have haG : G a.label := LabsIn_one hG h1
      exact ⟨a, c, h1, h2, hA.sto _ _ haG h3, hA.wit ▸ h4,
        hA.tid ▸ ModeOK_monoG (hA.pfr _ · haG) (fun f hs hf => hA.pfrS _ f haG hs hf) (hA.seen _ haG) h5, h6⟩
  | .ptrOpt μ u, η₁, η₂, ρ, rt, ws, _, _, hA, hG, hv => by
      simp only [VR] at hv ⊢
      rcases hv with hn | ⟨a, c, h1, h2, h3, h4, h5, h6⟩
      · exact Or.inl hn
      · have haG : G a.label := LabsIn_one hG h1
        exact Or.inr ⟨a, c, h1, h2, hA.sto _ _ haG h3, hA.wit ▸ h4,
          hA.tid ▸ ModeOK_monoG (hA.pfr _ · haG) (fun f hs hf => hA.pfrS _ f haG hs hf) (hA.seen _ haG) h5, h6⟩
  | .loc μ u, η₁, η₂, ρ, rt, ws, _, _, hA, hG, hv => by
      simp only [VR] at hv ⊢
      rcases hv with hn | ⟨a, c, U, h1, h3, h4, hF, h5, h6⟩
      · exact Or.inl ⟨hn.1, hA.wit ▸ hn.2⟩
      · have haG : G a.label := LabsIn_one hG h1
        exact Or.inr ⟨a, c, U, h1, hA.sto _ _ haG h3, h4, hA.wit ▸ hF,
          hA.tid ▸ ModeOK_monoG (hA.pfr _ · haG) (fun f hs hf => hA.pfrS _ f haG hs hf) (hA.seen _ haG) h5,
          IniAt_monoG (modeIni_leG hA μ haG) h6⟩
  | .intS _, _, _, _, _, _, _, _, _, _, hv => by simpa only [VR] using hv
  | .opq _, _, _, _, _, _, _, _, _, _, hv => by simpa only [VR] using hv
  | .int, _, _, _, _, _, _, _, _, _, hv => by simpa only [VR] using hv
  | .tid, _, _, _, _, _, _, _, hA, hG, hv => by
      simp only [VR] at hv ⊢
      obtain ⟨l, c, h1, h2, h3, h5⟩ := hv
      have hl : G l := LabsIn_one hG h1
      exact ⟨l, c, h1, hA.sto _ _ hl h2, h3,
        hA.tid ▸ ModeOK_monoG (hA.pfr _ · hl) (fun f hs hf => hA.pfrS _ f hl hs hf) (hA.seen _ hl) h5⟩
  | .fix _ _, _, _, _, _, _, _, _, _, _, hv => by simpa only [VR] using hv
  | .lanes _ _, _, _, _, _, _, _, _, _, _, hv => by simpa only [VR] using hv
  | .unit, _, _, _, _, _, _, _, _, _, _ => by simp [VR]
  | .void, _, _, _, _, _, _, _, _, _, hv => by simp [VR] at hv
  | .array _ _, _, _, _, _, _, _, _, _, _, _ => by simp [VR]
  | .share _, _, _, _, _, _, _, _, _, _, _ => by simp [VR]
  | .cap _ _, _, _, _, _, _, _, _, _, _, _ => by simp [VR]
  | .word _ _, _, _, _, _, _, _, _, _, _, hv => by simpa only [VR] using hv
  | .tok _ _, _, _, _, _, _, _, _, _, _, _ => by simp [VR]
  | .word2 _ _, _, _, _, _, _, _, _, _, _, hv => by simpa only [VR] using hv
  | .tok2 _ _ _ _, _, _, _, _, _, _, _, _, _, _ => by simp [VR]
  | .epair _ _, _, _, _, _, _, _, _, _, _, hv => by simpa only [VR] using hv
  | .tokE _ _ _, _, _, _, _, _, _, _, _, _, _ => by simp [VR]
  | .mu b, η₁, η₂, ρ, rt, ws, hr, hur, hA, hG, hv => by
      simp only [VR] at hv ⊢
      rw [← hA.wit]
      exact VR_monoG b (η₁.push0 (cl ρ η₁.wit 0 0 (.mu b))) (η₂.push0 (cl ρ η₁.wit 0 0 (.mu b))) ρ rt ws
        (push0_rels_mono hr) (push0_urels_mono hur) (hA.push0 _) hG hv
  | .iall b, η₁, η₂, ρ, rt, ws, hr, hur, hA, hG, hv => by
      simp only [VR] at hv ⊢
      exact fun n => VR_monoG b η₁ η₂ (vcons n ρ) rt ws hr hur hA hG (hv n)

