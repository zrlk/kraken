  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hs0), fun r hr hpa => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨s', hs', rfl⟩ := hr
  have hvr : VR ρ (η.withSto η.sto ini' (Ri := rini')) (.refine (.loc .own (.array n u)) (.ini (.add k (.lit 1))))
