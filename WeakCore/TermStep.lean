/-! ## §3 Allocation: `new` (4d-4) -/

/-- An allocation always has an outcome when the words fill the units. -/
theorem alloc_nonempty {k : Promises.Knobs} {arch : Arch} {lbl : AllocLabel} {us : List Acc} {ws : List Word}
    {s : St} (hlen : ws.length = nWords us) : ∃ r, r ∈ alloc k arch lbl us ws s := by
  unfold alloc
  exact ⟨_, List.mem_map.2 ⟨_, (storeUnits_nonempty _ _ _ _ hlen).choose_spec, rfl⟩⟩

theorem freshLabel_inj_k {base n i k k' : Nat} (hn : 0 < n) (h : freshLabel base n i k = freshLabel base n i k') :
    k = k' := by
  have h0 : base + i + n * k = base + i + n * k' := h
  exact Nat.eq_of_mul_eq_mul_left hn (by omega)

/-- A frame value's runtime layout is its closed static type's (`sig`). -/
theorem lay_closed {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {cx : Cx} {t rt : Ty} {ws : List Word}
    (hW : WitL σs η.wit cx.opq) (hK : cx.ke.length ≤ σs.length)
    (ho : cx.opaqueOK t = true) (htb : tb cx.ke.length t = true) (hl : Lay σs t rt ws) :
    sig rt = sig (cl ρ η.wit 0 0 t) := by
  have h1 : sig rt = sig (close σs t) := sig_of_eskel hl.2.1
  rw [h1]; exact sig_WitL hW ρ ho (lt_of_guardT htb hK)

/-- **P1 + P4 at the thread, `new`**: the value, closed at its static type,
becomes a new own cell of Σ at the next fresh label; the frame's view grows
to the new Σ (`Ext`, `FInv_ext`); memory stays OK; the next labels stay fresh. -/
theorem tstepM_newA {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {a : At} {e : Expr}
    (hterm : th.term = .let_ x (.new a) e)
    (hniA : ∀ t c₁, cx.use a = .ok (t, c₁) → noIallV t = true) (hP : ProgT p) (hn : 0 < g.n)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMFA p g ρ η th (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | new hu _ hb =>
  obtain ⟨tv, c₁, hu, hb⟩ : ∃ tv c₁, cx.use a = .ok (tv, c₁) ∧ c₁.bind x (.ptr .own tv) = .ok c' :=
    ⟨_, _, hu, hb⟩
  obtain ⟨hi1, rt, ws, hea, hv, hl⟩ := use_FInv hu hi
  have ho : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have htb := (use_TvOK hu htv).2.1
  have hsig : sig rt = sig (cl ρ η.wit 0 0 tv) := lay_closed hi.2.2.2.1 hi.2.2.2.2.1 ho htb hl
  obtain ⟨us, hus⟩ : ∃ us, accs rt = some us := by
    cases h : accs rt with
    | none => exact absurd (by simp [wc, h]) hl.2.2.1
    | some us => exact ⟨us, rfl⟩
  have hlen : ws.length = nWords us := hl.1 us hus
  have hwcT : wc (cl ρ η.wit 0 0 tv) = some (nWords us) := by rw [← wc_of_sig hsig]; simp [wc, hus]
  have hvc : VR (fun _ => 0) (CE η) (cl ρ η.wit 0 0 tv) (shp (cl ρ η.wit 0 0 tv)) ws := by
    rw [← shp_of_sig hsig]
    exact (VR_close hE.2.1 ρ tv [] 0 ρ (fun _ => 0) (shp rt) ws (fun k => rfl)
      (fun k hk => absurd hk (Nat.not_lt_zero _))).1 hv
  obtain ⟨hmo, hoo, hpl, hfr, hsn, hoh, hpd, hopub, hpi, hbi, hpo⟩ := hm
  obtain ⟨hnone, hfresh, -, hpf0⟩ := hfr.1 th.nalloc (Nat.le_refl _)
  have hval : ValOf (allocE (CE η) (freshLabel g.lbase g.n g.i th.nalloc) (cl ρ η.wit 0 0 tv)) (cl ρ η.wit 0 0 tv)
      (ws.map (bumpW (stOf mem pairs th).vs.vRelSt)) :=
    ValOf_mono (η₁ := CE η) (η₂ := allocE (CE η) (freshLabel g.lbase g.n g.i th.nalloc) (cl ρ η.wit 0 0 tv))
      rfl rfl (fun l c h => allocE_sub hnone h) (fun _ => Nat.le_refl _)
      (EnvVal.store (η := CE η) ⟨hvc, Valid_of_sig hsig hl.2.2.2.1⟩ hsn)
  have hx : Ext η (η.withSto (allocE (CE η) (freshLabel g.lbase g.n g.i th.nalloc) (cl ρ η.wit 0 0 tv)).sto) :=
    Ext_withSto hE.2.1 (fun l c h => allocE_sub (η := CE η) hnone h) (fun _ => Nat.le_refl _)
  have key : tstep g mem pairs th =
      (alloc g.k g.arch (freshLabel g.lbase g.n g.i th.nalloc) us ws (stOf mem pairs th)).map fun (s', pw) =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, .ptr .own rt, [pw]) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hus, List.map_map]; rfl
  rw [key]
  refine ⟨?_, ?_⟩
  · obtain ⟨r, hr⟩ := alloc_nonempty (k := g.k) (arch := g.arch) (lbl := freshLabel g.lbase g.n g.i th.nalloc)
      (s := stOf mem pairs th) hlen
    exact List.ne_nil_of_mem (List.mem_map_of_mem hr)
  · intro r hr
    rw [List.mem_map] at hr
    obtain ⟨⟨s', pw⟩, hal, rfl⟩ := hr
    obtain ⟨hmo', hoo', hpw⟩ := alloc_okP hwcT hlen hval hfresh hnone hpl hpo.1 hpo.2.1 hpf0 hmo hoo ⟨s', pw⟩ hal
    obtain ⟨hg, -, hna, hpl', hful⟩ := alloc_growsP hpl ⟨s', pw⟩ hal
    obtain ⟨hwr, hhid⟩ := alloc_hidP (s := stOf mem pairs th) hval
      (ShapeC_of_wc hwcT (by rw [List.length_map]; exact hlen))
      (by obtain ⟨_, h, -⟩ := wc_some hwcT; simp [h]) hfresh hpl ⟨s', pw⟩ hal
    simp only at hmo' hoo' hpw hg hna hwr hhid hpl' hful
    subst hpw
    have hwA : ∀ T o w, WordOK (CE η) T o w →
        WordOK (allocE (CE η) (freshLabel g.lbase g.n g.i th.nalloc) (cl ρ η.wit 0 0 tv)) T o w :=
      fun T o w h => WordOK_mono (η₁ := CE η)
        (η₂ := allocE (CE η) (freshLabel g.lbase g.n g.i th.nalloc) (cl ρ η.wit 0 0 tv))
        rfl rfl (fun l c h' => allocE_sub hnone h') (fun _ => Nat.le_refl _)
        (fun _ _ h' => h') (fun _ h' => h') h
    have hoh' : OwnHidP (allocE (CE η) (freshLabel g.lbase g.n g.i th.nalloc) (cl ρ η.wit 0 0 tv)) s'.mem s'.vs
        s'.promises := by
      refine ⟨fun l c hc ho o hi => ?_, fun l c hc ho hlt => ?_⟩
      · by_cases hl : l = freshLabel g.lbase g.n g.i th.nalloc
        · subst hl
          rw [allocE_eq] at hc; cases hc; exact hhid o
        · rw [allocE_ne hl] at hc
          exact HiddenP_growsAt (hoh.1 l c hc ho o hi) (hwA _ _) hwr hg hl hful
      · by_cases hl : l = freshLabel g.lbase g.n g.i th.nalloc
        · subst hl
          exact absurd (Nat.lt_of_lt_of_le hlt (Nat.le_of_eq (hfr.1 th.nalloc (Nat.le_refl _)).2.2.1))
            (Nat.not_lt_zero _)
        · rw [allocE_ne hl] at hc
          obtain ⟨f, hf, hs, hH⟩ := hoh.2 l c hc ho hlt
          exact ⟨f, hf, fun hz => hs (fun hz0 => hz ((ZW.stoAt (allocE_ne hl)).2 hz0)),
            fun o hi => HiddenP_growsAt (hH o hi) (hwA _ _) (Nat.le_refl _) hg hl hful⟩
    have hpd' : PubDefP (allocE (CE η) (freshLabel g.lbase g.n g.i th.nalloc) (cl ρ η.wit 0 0 tv)) s'.mem
        s'.promises := by
      intro l c f hc hown hf o hi
      by_cases hl : l = freshLabel g.lbase g.n g.i th.nalloc
      · subst hl
        rw [allocE_eq] at hc; cases hc; exact (hown rfl).elim
      · rw [allocE_ne hl] at hc
        exact HiddenP_growsAt (hpd l c f hc hown hf o hi) (hwA _ _) (Nat.le_refl _) hg hl hful
    have hpi' : PubInv (allocE (CE η) (freshLabel g.lbase g.n g.i th.nalloc) (cl ρ η.wit 0 0 tv)) s' := by
      refine PubInv_grow (hbs := fun l hb h => by
          by_cases hl : l = freshLabel g.lbase g.n g.i th.nalloc
          · subst hl; exact absurd (hbi.1 th.nalloc (Nat.le_refl _)) hb
          · rw [allocE_ne hl]; exact h) hpi hmo.2.2 hg (alloc_pairs _ hal) hful rfl rfl (fun l c h => allocE_sub hnone h)
        (fun _ => Nat.le_refl _) rfl rfl (fun c h => by rw [allocE_eq] at h; rw [← Option.some.inj h]; rfl)
        (fun l c h => ?_) (fun l c b S us' h hseg hu' hini => ?_) (hpl := fun _ _ hlt => absurd (Nat.lt_of_lt_of_le hlt (Nat.le_of_eq (hfr.1 th.nalloc (Nat.le_refl _)).2.2.1))
          (Nat.not_lt_zero _)) (hrcg := fun _ h => ⟨h, Nat.le_refl _⟩)
      · by_cases hl : l = freshLabel g.lbase g.n g.i th.nalloc
        · subst hl; exact Or.inr hpf0
        · rw [allocE_ne hl] at h; exact Or.inl h
      by_cases hl : l = freshLabel g.lbase g.n g.i th.nalloc
      · subst hl
        rw [allocE_eq] at h
        cases h
        refine Or.inr ?_
        rcases hseg with ⟨-, rfl, -⟩ | ⟨N, us0, j0, hT, -, -, -⟩
        · obtain ⟨vals, hcell, -⟩ := hoo' _ _ allocE_eq rfl
          rcases hcell with ⟨hwc, hv⟩ | hb
          · exact ⟨vals, hv, Option.some.inj (hwc.symm.trans (wc_of_accs hu'))⟩
          · obtain ⟨N, e0, us0, hT, -⟩ := hb
            exact absurd hwcT (by rw [show cl ρ η.wit 0 0 tv = _ from hT]; simp [wc, accs])
        · exact absurd hwcT (by rw [show cl ρ η.wit 0 0 tv = _ from hT]; simp [wc, accs])
      · rw [allocE_ne hl] at h; exact Or.inl ⟨h, hini⟩
    refine ⟨allocE (CE η) (freshLabel g.lbase g.n g.i th.nalloc) (cl ρ η.wit 0 0 tv),
      (by
        intro l c N u hf hc hty
        obtain ⟨j, hj, -, rfl⟩ := hf
        by_cases hl : freshLabel g.lbase g.n g.i j = freshLabel g.lbase g.n g.i th.nalloc
        · rw [hl, allocE_eq] at hc
          cases hc
          have h2 : cl ρ η.wit 0 0 tv = .array (.lit N) u := hty
          exact absurd hwcT (by rw [h2]; simp [wc, accs])
        · rw [allocE_ne hl] at hc
          have h0 : (CE η).sto (freshLabel g.lbase g.n g.i j) = none := (hfr.1 j hj).1
          rw [h0] at hc
          cases hc),
      EFoot_fresh rfl rfl rfl rfl (lt_of_eq_succ hna) (fun l => allocE_sto_cases ⟨Clo_cl (fun k => (hE.2.1 k).1) ρ tv,
        mg_cl (fun k => (hE.2.1 k).1.1) (WitAF.mg hi.2.2.2.2.2.2.1) tv 0 0 (use_mg hu htv),
        noIallV_cl (WitAF.ni hi.2.2.2.2.2.2.1) tv 0 0 (hniA tv _ hu), trivial⟩ (alloc_newT hal hwcT) (alloc_undefT hal hwcT) l) (fun _ => .inl rfl)
        (fun _ => ⟨Nat.le_refl _, .inl rfl⟩),
      ⟨ρ, η.withSto (allocE (CE η) (freshLabel g.lbase g.n g.i th.nalloc) (cl ρ η.wit 0 0 tv)).sto, c', rfl,
        ⟨hE.1, hx.1, hx.2.2.2.2.2.2.2.2.2.2.1⟩, he, htv', ?_, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩, ?_⟩
    · refine bind_FInv hb (FInv_ext hE.2.1 hx hi1) ?_ ?_
      · simp only [VR]
        exact ⟨⟨freshLabel g.lbase g.n g.i th.nalloc, 0⟩, ⟨cl ρ η.wit 0 0 tv, some η.tid⟩, by simp [cst, Promises.TVal.mk0], rfl,
          by simp [TEnv.withSto, allocE, CE], .refl, rfl,
          show accs (cl ρ η.wit 0 0 tv) ≠ none from fun h => by simp [wc, h] at hwcT⟩
      · refine ⟨fun us h => by simp [accs] at h; subst h; rfl, ?_, by simp [wc, accs],
          ⟨⟨freshLabel g.lbase g.n g.i th.nalloc, 0⟩, by simp [cst, Promises.TVal.mk0]⟩, ?_⟩
        · show Ty.ptr (skelM .own) (etok (skel rt)) = Ty.ptr _ _
          rw [hl.2.1]; rfl
        · show Ty.ptr (modeC 0 .own) (etok (lyt 0 rt)) = Ty.ptr _ _
          rw [hl.2.2.2.2]; rfl
    have hopub' : OwnPubV (allocE (CE η) (freshLabel g.lbase g.n g.i th.nalloc) (cl ρ η.wit 0 0 tv)) s' := by
      intro l c f hc ho hf
      by_cases hl : l = freshLabel g.lbase g.n g.i th.nalloc
      · rw [hl] at hf; exact absurd (hf.symm.trans hpf0) (by simp)
      · rw [allocE_ne hl] at hc
        exact ((hopub.alloc hpl hal) l c f hc ho hf).imp id (Or.imp id fun hw => hw.congrE
          fun a ha hi c1 N1 e1 us1 h1 => hi c1 N1 e1 us1 (by rw [allocE_ne (fun e => hl (ha.symm.trans e))]; exact h1))
    · refine ⟨hmo', hoo', hpl', ⟨fun j hj => ?_, PrivCoh_growsAt hfr.2
          (fun a hu hl => by
            obtain ⟨c, N, e, us, hc, rest⟩ := hu
            exact ⟨c, N, e, us, by rw [allocE_ne hl] at hc; exact hc, rest⟩)
          hoo' hg hful (fun t m _ _ hu hl => by
            obtain ⟨c, N, e, us, hc, -, -, hT, -⟩ := hu
            rw [hl, allocE_eq] at hc; cases hc
            simp only at hT; rw [hT] at hwcT; simp [wc, accs] at hwcT)⟩, ?_, hoh', hpd', hopub', hpi',
        BoxInv_alloc hbi rfl hpl hpo.1 hal rfl rfl (fun _ hl => allocE_ne hl) (fun _ _ => rfl),
        PromOK_alloc hpo hpl hal⟩
      rotate_left 1
      · have e : s'.vs.vRelSt = (stOf mem pairs th).vs.vRelSt := alloc_relSt _ hal
        exact (SeenLE.mono hsn (Nat.le_of_eq e.symm) : SeenLE (CE η) s'.vs.vRelSt)
      · have hj' : th.nalloc ≤ j := by
          have : s'.nalloc ≤ j := hj
          rw [hna] at this; exact Nat.le_of_succ_le this
        obtain ⟨f1, f2, f4, f5⟩ := hfr.1 j hj'
        have hne : freshLabel g.lbase g.n g.i j ≠ freshLabel g.lbase g.n g.i th.nalloc := fun h => by
          have := freshLabel_inj_k hn h; subst this
          have : s'.nalloc ≤ th.nalloc := hj
          rw [hna] at this; exact absurd this (by show ¬ th.nalloc + 1 ≤ th.nalloc; omega)
        refine ⟨by rw [allocE_ne hne]; exact f1, fun t m ht hl => ?_, f4, f5⟩
        change s'.mem[t]? = some m at ht
        by_cases hlt : t < (stOf mem pairs th).mem.size
        · rw [hg.2.1 t hlt] at ht
          have hp := f2 t m ht hl
          refine Classical.byContradiction fun hn' => ?_
          obtain ⟨m', hm', e⟩ := hful t hp hn'
          rw [ht] at hm'; cases hm'
          exact hne (hl.symm.trans e)
        · have := hg.2.2 t m (by omega) ht; exact absurd (hl.symm.trans this) hne

/-- (G1) `tstepM_new` from `tstepM_newA`. -/
theorem tstepM_new {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {a : At} {e : Expr}
    (hterm : th.term = .let_ x (.new a) e)
    (hniA : ∀ t c₁, cx.use a = .ok (t, c₁) → noIallV t = true) (hP : ProgT p) (hn : 0 < g.n)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 :=
  (tstepM_newA (hterm := hterm) (hniA := hniA) (hP := hP) (hn := hn) (hT := hT) (hi := hi) (hE := hE) (htv := htv) (hm := hm) (hRP := hRP) (hPS := hPS)).imp id
    fun h r hr => (h r hr).toF

/-! ## §4 Own-cell loads, stores and exchanges (4d-5, 4d-6) -/

/-- A load changes neither memory nor (off the owner's cells, where `LoadCoh` keeps
`OwnOKPF`) coherence: `MemInv` is kept. -/
theorem MemInv_load {g : G} {E : TEnv} {s s' : St} (h : MemInv g E s) (e1 : s'.mem = s.mem)
    (e2 : s'.pairs = s.pairs) (e3 : LoadCoh E s s') (e4 : s'.promises = s.promises)
    (e5 : s'.nalloc = s.nalloc) (e6 : s'.vs.vRelSt = s.vs.vRelSt) (e7 : s'.vs.vWr = s.vs.vWr) :
    MemInv g E s' := by
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11⟩ := h
  have hO' : OwnOKPF E s'.mem s'.pairs s'.vs s'.promises := by rw [e1, e2, e4]; exact e3.1
  refine ⟨by rw [e1, e2, e4]; exact h1, hO', by unfold PromLt at h3 ⊢; rw [e1, e4]; exact h3,
    ⟨fun j hj => ?_, PrivCoh_post h4.2 (fun _ h => h) hO' fun t m ht hm _ => by
      rw [e4] at ht; rw [e1] at hm; exact ⟨ht, hm⟩⟩,
    by rw [e6]; exact h5, OwnHidP.imp h6 (fun l c hc ho => ⟨hc, ho, rfl, rfl, rfl, id⟩)
      (fun l c o V V' _ hle h => by rw [e1, e4]; exact HiddenP_le h hle) (Nat.le_of_eq e7.symm),
    by rw [e1, e4]; exact h7, h8.eqv (Nat.le_of_eq e7.symm) e1 e4,
    ⟨h9.1, h9.2.1, h9.2.2.1, by unfold PubMem PubPair PubLive; rw [e1, e2, e4]; exact h9.2.2.2⟩, ?_,
    PromOK_eq h11 e2 e4⟩
  · obtain ⟨f1, f2, f4, f5⟩ := h4.1 j (by rw [← e5]; exact hj)

    exact ⟨f1, by rw [e1, e4]; exact f2, f4, f5⟩
  · exact BoxInv_tr h10 rfl (fun _ _ _ h => h) (fun _ _ _ => rfl) (fun _ _ _ => rfl) (by omega)
      (fun _ _ _ _ _ _ hv => by rw [e1, e4]; exact hv)
      (fun l B hl hsn o v hv => by
        rw [e1, e4]; exact LatestS_congr hv (e3.2.1 ⟨l, o⟩ (h10.2.2 l B hl).1 (Or.inr hsn)) (fun _ h => h)
          (fun _ h => h))

/-- **A whole-value store to an own cell keeps `MemInv`**: the cell's
invariants by `OwnOK_store`; every other label sees memory only grow at this
cell's label, which is allocated, so no fresh label is touched. -/
theorem MemInv_store {g : G} {E : TEnv} {s : St} {lab : AllocLabel} {c : Cell} {us : List Acc}
    {ws : List Word} {pw : Word} {rel : Bool} (hm : MemInv g E s) (hsto : E.sto lab = some c)
    (hown : c.owner = some E.tid) (hacc : accs c.ty = some us)
    (hv : EnvVal E c.ty ws) (hlen : ws.length = nWords us) :
    ∀ s', s' ∈ storeUnits g.k g.arch pw ⟨lab, 0⟩ rel us ws 0 s → MemInv g E s' := by
  intro s' hs
  have hus : wc c.ty = some (nWords us) := wc_of_accs hacc
  obtain ⟨hmo, hoo, hpl, hfr, hsn, hoh, hpd, hopub, hpi, hbi, hpo⟩ := hm
  obtain ⟨hmo', hoo'⟩ := OwnOKP_store hsto hown hacc (hv.store hsn) hlen (Nat.le_refl _) hpl hpo.1 hmo hoo s' hs
  obtain ⟨hg, -, hna⟩ := storeUnits_growsF (a := ⟨lab, 0⟩) us ws 0 s s' hs
  obtain ⟨hpl', -, -⟩ := storeUnits_promF (a := ⟨lab, 0⟩) us ws 0 s s' hpl hs
  have hfo := storeUnits_fulOK (a := ⟨lab, 0⟩) (b := 0) (o0 := 0) (c := c)
    (Or.inl ⟨rfl, rfl, by obtain ⟨_, h, -⟩ := wc_some hus; simp [h]⟩) rfl
    ⟨hv.store hsn, ShapeC_of_wc hus (by rw [List.length_map]; exact hlen)⟩
    (fun j w hw => ⟨bumpW s.vs.vRelSt w, by simp [hw], WLe1_refl _⟩) (Nat.le_refl _) hpl hs
  have hful : ∀ t, t ∈ s.promises → t ∉ s'.promises → ∃ m, s.mem[t]? = some m ∧ m.loc.label = lab :=
    fun t h1 h2 => by obtain ⟨m, a1, a2, -⟩ := hfo t h1 h2; exact ⟨m, a1, a2⟩
  have hfw : ∀ (t : Nat) (m : Msg) (c' : Cell), t ∈ s.promises → t ∉ s'.promises → s.mem[t]? = some m →
      E.sto m.loc.label = some c' → WordOK E c'.ty m.loc.offset (mw m) := by
    intro t m c' h1 h2 hm hc'
    obtain ⟨m', a1, a2, a3⟩ := hfo t h1 h2
    rw [hm] at a1; cases a1
    rw [a2, hsto] at hc'; cases hc'; exact a3
  have hnew : NewOK E s.mem s'.mem :=
    NewOK_storeF (a := ⟨lab, 0⟩) (b := 0) (o0 := 0) hsto (Or.inl ⟨rfl, rfl, by obtain ⟨_, h, -⟩ := wc_some hus; simp [h]⟩) rfl
      ⟨hv.store hsn, ShapeC_of_wc hus (by rw [List.length_map]; exact hlen)⟩
      (fun j w hw => by simp [List.getElem?_map, hw]) (Nat.le_refl _) s' hs
  have hwr := storeUnits_wrF us ws 0 s s' hs
  refine ⟨hmo', hoo', hpl', ⟨fun j hj => ?_, PrivCoh_storeUnits hfr.2 hs (fun _ h => h)
      fun _ _ => notPrivU_arr hsto fun N e hT => by rw [hT] at hacc; simp [accs] at hacc⟩,
    by rw [storeUnits_relSt _ _ _ _ _ hs]; exact hsn, OwnHidP_grow hoh hwr hg.2.1 hnew hfw,
    PubDefP_grow hpd hg.2.1 hnew hfw, hopub.store hpl hs,
    PubInv_store hpi hmo.2.2 hg (storeUnits_pairs _ _ _ _ _ hs) hful hsto hown
      (fun N e hT => by rw [hT] at hacc; simp [accs] at hacc),
    BoxInv_store hbi hsto hpl hpo.1 s' hs, PromOK_store hpo hpl hs⟩
  obtain ⟨f1, f2, f4, f5⟩ := hfr.1 j (by rw [← hna]; exact hj)

  refine ⟨f1, fun t m ht hl => ?_, f4, f5⟩
  by_cases hlt : t < s.mem.size
  · rw [hg.2.1 t hlt] at ht
    have hp := f2 t m ht hl
    refine Classical.byContradiction fun hn => ?_
    obtain ⟨m', hm', e⟩ := hful t hp hn
    rw [ht] at hm'; cases hm'
    have h' : lab = freshLabel g.lbase g.n g.i j := by rw [← hl, e]
    rw [h'] at hsto; rw [hsto] at f1; cases f1
  · have e := hg.2.2 t m (by omega) ht
    have h' : lab = freshLabel g.lbase g.n g.i j := by rw [← hl, e]
    rw [h'] at hsto; rw [hsto] at f1; cases f1

theorem skel_word {t : Ty} {r : Idx} {P : Proto} (h : skel t = .word r P) : ∃ r', t = .word r' P := by
  cases t <;> simp [skel] at h
  case word r' P' => exact ⟨r', by rw [h.2]⟩
  case refine t ψ => unfold rf at h; split at h <;> simp at h

theorem eskel_word {t : Ty} {r : Idx} {P : Proto} (h : etok (skel t) = .word r P) : ∃ r', t = .word r' P := by
  cases t <;> simp [skel, etok] at h
  case word r' P' => exact ⟨r', by rw [h.2]⟩
  case refine t ψ => unfold rf at h; split at h <;> simp [etok] at h

/-- (T3d-1) `n` is in the state family `cl` (`scale·k + off` for some `k`). -/
def inCl (cl : Clause) (n : Nat) : Bool :=
  if cl.scale = 0 then n == cl.off else cl.off ≤ n && (n - cl.off) % cl.scale == 0

theorem inCl_of (cl : Clause) (k : Nat) : inCl cl (cl.scale * k + cl.off) = true := by
  unfold inCl; split <;> simp_all [Nat.mul_mod_right]

/-- Two families that share a value overlap (`overlap` decides it by the gcd). -/
theorem overlap_of_common {a b : Clause} {n : Nat} (ha : inCl a n = true) (hb : inCl b n = true) :
    overlap a b = true := by
  rcases a with ⟨s, o, h1⟩
  rcases b with ⟨t, q, h2⟩
  unfold inCl at ha hb
  unfold overlap
  cases s with
  | zero =>
    cases t with
    | zero => simp_all
    | succ t =>
      simp only [↓reduceIte, beq_iff_eq, Nat.succ_ne_zero, Bool.and_eq_true, decide_eq_true_eq] at ha hb ⊢
      subst ha; simpa using hb
  | succ s =>
    cases t with
    | zero =>
      simp only [↓reduceIte, beq_iff_eq, Nat.succ_ne_zero, Bool.and_eq_true, decide_eq_true_eq] at ha hb ⊢
      subst hb; simpa using ha
    | succ t =>
      simp only [↓reduceIte, beq_iff_eq, Nat.succ_ne_zero, Bool.and_eq_true, decide_eq_true_eq] at ha hb ⊢
      obtain ⟨ho, hm1⟩ := ha
      obtain ⟨hq, hm2⟩ := hb
      have d1 : Nat.gcd (s + 1) (t + 1) ∣ n - o :=
        Nat.dvd_trans (Nat.gcd_dvd_left _ _) (Nat.dvd_of_mod_eq_zero hm1)
      have d2 : Nat.gcd (s + 1) (t + 1) ∣ n - q :=
        Nat.dvd_trans (Nat.gcd_dvd_right _ _) (Nat.dvd_of_mod_eq_zero hm2)
      have e : (o : Int) - q = ((n - q : Nat) : Int) - ((n - o : Nat) : Int) := by omega
      rw [e]
      exact Int.emod_eq_zero_of_dvd (Int.dvd_sub (Int.natCast_dvd_natCast.2 d2) (Int.natCast_dvd_natCast.2 d1))

theorem mem_enumFrom {α : Type} : ∀ (l : List α) (k i : Nat) (a : α), l[i]? = some a → (i + k, a) ∈ enumFrom l k
  | [], _, _, _, h => by simp at h
  | b :: l, k, 0, a, h => by simp at h; subst h; simp [enumFrom]
  | b :: l, k, i + 1, a, h => by
      simp at h
      have := mem_enumFrom l (k + 1) i a h
      simp only [enumFrom, List.mem_cons]
      right; rw [show i + 1 + k = i + (k + 1) by omega]; exact this

/-- (T3d-1) The states of a well-formed protocol are disjoint. -/
theorem pwf_disjoint {P : Proto} (hp : pwf P = true) {c j : Nat} {a b : Clause} {n : Nat}
    (hc : P.clauses[c]? = some a) (hj : P.clauses[j]? = some b) (ha : inCl a n = true) (hb : inCl b n = true) :
    c = j := by
  have hA : (enumFrom P.clauses 0).all (fun (i, a) =>
      (enumFrom P.clauses 0).all fun (j, b) => j ≤ i || !overlap a b) = true := by
    revert hp; unfold pwf; simp only [Bool.and_eq_true]; intro hp
    exact hp.1.1.1.1.1.1.1.1
  have m1 := mem_enumFrom P.clauses 0 c a hc
  have m2 := mem_enumFrom P.clauses 0 j b hj
  simp only [Nat.add_zero] at m1 m2
  rcases Nat.lt_trichotomy c j with hlt | heq | hgt
  · have h := List.all_eq_true.1 (List.all_eq_true.1 hA _ m1) _ m2
    simp only [overlap_of_common ha hb, Bool.not_true, Bool.or_false, decide_eq_true_eq] at h
    omega
  · exact heq
  · have h := List.all_eq_true.1 (List.all_eq_true.1 hA _ m2) _ m1
    simp only [overlap_of_common hb ha, Bool.not_true, Bool.or_false, decide_eq_true_eq] at h
    omega

theorem close_ptr (σs : List Ty) (μ : Mode) (u : Ty) : close σs (.ptr μ u) = .ptr μ (close σs u) := by
  simp [close, substTs]

/-! ## Layout forms of references and unrolled recursive types -/

/-- A reference's runtime pointee has the layout form of the static pointee,
closed, and its mode the static mode's. -/
theorem cell_lyt {σs : List Ty} {t rt u ur : Ty} {μ μr : Mode} (hl5 : etok (lyt 0 rt) = etok (lyt 0 (close σs t)))
    (hc : cellOf t = some (μ, u)) (hcr : cellOf rt = some (μr, ur)) :
    modeC 0 μr = modeC 0 μ ∧ etok (lyt 0 ur) = etok (lyt 0 (close σs u)) := by
  cases t <;> simp only [cellOf, reduceCtorEq, Option.some.injEq, Prod.mk.injEq] at hc <;>
    obtain ⟨rfl, rfl⟩ := hc <;>
    cases rt <;> simp only [cellOf, reduceCtorEq, Option.some.injEq, Prod.mk.injEq] at hcr <;>
    obtain ⟨rfl, rfl⟩ := hcr <;>
    simp only [close, substTs, lyt, etok, Ty.ptr.injEq, Ty.loc.injEq, reduceCtorEq] at hl5 <;>
    exact hl5

/-- A buffer's runtime element has the static element's layout form. -/
theorem buf_lyt {σs : List Ty} {rt u ur : Ty} {μ μr : Mode} {n : Idx} {ψ : Pred}
    (hl5 : etok (lyt 0 rt) = etok (lyt 0 (close σs (.refine (.loc μ (.array n u)) ψ))))
    (hbe : bufElem rt = some (μr, ur)) : modeC 0 μr = modeC 0 μ ∧ etok (lyt 0 ur) = etok (lyt 0 (close σs u)) := by
  unfold bufElem at hbe
  split at hbe <;> simp only [Option.some.injEq, Prod.mk.injEq, reduceCtorEq] at hbe <;>
    obtain ⟨rfl, rfl⟩ := hbe <;>
    simp only [close, substTs, lyt, etok, anyB_zero, Bool.false_eq_true, ite_false, Ty.loc.injEq, Ty.array.injEq] at hl5 <;>
    exact ⟨hl5.1, hl5.2.2⟩

theorem lyt_loc_of {σs : List Ty} {μ μr : Mode} {u ur : Ty} (hm : modeC 0 μr = modeC 0 μ)
    (hu : etok (lyt 0 ur) = etok (lyt 0 (close σs u))) : etok (lyt 0 (Ty.loc μr ur)) = etok (lyt 0 (close σs (.loc μ u))) := by
  simp only [close, substTs, lyt, etok] at hu ⊢; rw [hm, hu]

theorem peek_cell_lyt {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {cx : Cx} {env : Env} {a : At}
    {t rt u ur : Ty} {ws : List Word} {μ μr : Mode} (hvars : VarsOK ρ η σs cx.vars env)
    (hp : cx.peek a = .ok t) (hea : evalAt env a = some (rt, ws)) (hc : cellOf t = some (μ, u))
    (hcr : cellOf rt = some (μr, ur)) : modeC 0 μr = modeC 0 μ ∧ etok (lyt 0 ur) = etok (lyt 0 (close σs u)) := by
  obtain ⟨rt', ws', hea', -, hl⟩ := peek_VR hvars hp
  rw [hea] at hea'
  simp only [Option.some.injEq, Prod.mk.injEq] at hea'
  obtain ⟨rfl, rfl⟩ := hea'
  exact cell_lyt hl.2.2.2.2 hc hcr

/-- A buffer's runtime element, seen through a variable, has the static
element's layout form. -/
theorem peek_buf_lyt {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {cx : Cx} {env : Env} {b : At}
    {t rt u ur : Ty} {ws : List Word} {μ μr : Mode} {n k : Idx} (hvars : VarsOK ρ η σs cx.vars env)
    (hp : cx.peek b = .ok t) (hbuf : bufOf t = some (μ, n, u, k)) (hea : evalAt env b = some (rt, ws))
    (hbe : bufElem rt = some (μr, ur)) : modeC 0 μr = modeC 0 μ ∧ etok (lyt 0 ur) = etok (lyt 0 (close σs u)) := by
  obtain ⟨rt', ws', hea', -, hl⟩ := peek_VR hvars hp
  rw [hea] at hea'
  simp only [Option.some.injEq, Prod.mk.injEq] at hea'
  obtain ⟨rfl, rfl⟩ := hea'
  unfold bufOf at hbuf
  split at hbuf
  · simp only [Option.some.injEq, Prod.mk.injEq] at hbuf
    obtain ⟨rfl, rfl, rfl, rfl⟩ := hbuf
    exact buf_lyt hl.2.2.2.2 hbe
  · cases hbuf

/-- **What an own pointer is at runtime**: one word, the address of an own
cell of this thread whose type is the closed pointee; its runtime pointee has
the static pointee's skeleton and (for an opaque-free pointee) its `sig`. -/
theorem ownPtr_view {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {K : TEnv → List Word → Prop}
    {cx : Cx} {env : Env} {a : At} {u : Ty}
    (hi : FInv ρ η σs K cx env) (hpk : cx.peek a = .ok (.ptr .own u))
    (htv : TvOK cx) (ho : cx.opaqueOK u = true) :
    ∃ lab c pw ru, evalAt env a = some (.ptr .own ru, [pw]) ∧ pw.val = .loc ⟨lab, 0⟩ 0 ∧
      η.sto lab = some c ∧ Fd c.ty (cl ρ η.wit 0 0 u) ∧ accs c.ty ≠ none ∧ c.owner = some η.tid ∧
      etok (skel ru) = etok (skel (close σs u)) ∧ sig ru = sig (cl ρ η.wit 0 0 u) := by
  obtain ⟨rt, ws, hea, hv, hl⟩ := peek_VR hi.2.1 hpk
  simp only [VR] at hv
  obtain ⟨⟨lab, off⟩, c, hws, hoff, hsto, hcty, hmode, hacc⟩ := hv
  simp only at hoff; subst hoff
  obtain ⟨pw, rfl, hpw⟩ : ∃ pw, ws = [pw] ∧ pw.val = .loc ⟨lab, 0⟩ 0 := by
    match ws, hws with
    | [pw], h => exact ⟨pw, rfl, by simpa using h⟩
    | [], h => simp at h
    | _ :: _ :: _, h => simp at h
  have hsk := hl.2.1
  rw [close_ptr] at hsk
  obtain ⟨ru, rfl, hsku⟩ : ∃ ru, rt = .ptr .own ru ∧ etok (skel ru) = etok (skel (close σs u)) := by
    cases rt <;> simp [skel, etok] at hsk
    case ptr μ ru =>
      cases μ <;> simp [skelM, etok] at hsk
      exact ⟨ru, rfl, hsk⟩
    case refine t ψ => unfold rf at hsk; split at hsk <;> simp [etok] at hsk
  have htb : tb cx.ke.length u = true := tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.ptr .own u) = some (.own, u))
  have hsig : sig ru = sig (cl ρ η.wit 0 0 u) := by
    have h1 : sig ru = sig (close σs u) := sig_of_eskel hsku
    rw [h1]; exact sig_WitL hi.2.2.2.1 ρ ho (lt_of_guardT htb hi.2.2.2.2.1)
  exact ⟨lab, c, pw, ru, hea, hpw, hsto, hcty, hacc, hmode, hsku, hsig⟩

theorem bind_arrFree {cx c' : Cx} {x : String} {t : Ty} (h : cx.bind x t = .ok c') : t.arrFree = true := by
  unfold Cx.bind at h
  split at h <;> split at h <;> (try split at h) <;>
    simp_all [pure, Except.pure, throw, throwThe, MonadExceptOf.throw, bind, Except.bind]

/-- **A value to store at an own pointee**, from a held value of a subtype:
closed, it is a value of the cell's type, as many words as the runtime
pointee's access list. -/
theorem ownStoreVal {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {cx c₁ : Cx} {u ru tv rv : Ty}
    {ws : List Word} {us : List Acc}
    (hco : Coh η) (hW : WitL σs η.wit cx.opq) (hK : cx.ke.length ≤ σs.length)
    (hsat : Sat c₁.facts ρ) (hsub : SubS c₁ tv u) (ho : cx.opaqueOK u = true)
    (htb : tb cx.ke.length u = true) (hv : VR ρ η tv (shp rv) ws) (hl : Lay σs tv rv ws)
    (hsig : sig ru = sig (cl ρ η.wit 0 0 u)) (hus : accs ru = some us) :
    EnvVal (CE η) (cl ρ η.wit 0 0 u) ws ∧ ws.length = nWords us := by
  obtain ⟨hs, hl'⟩ := Lay_canon hsub hl
  have hvu : VR ρ η u (shp (close σs u)) ws := by rw [← hs]; exact VR_sub hsat hsub _ _ hv
  have hsigu : sig (close σs u) = sig (cl ρ η.wit 0 0 u) := sig_WitL hW ρ ho (lt_of_guardT htb hK)
  have hvc : VR (fun _ => 0) (CE η) (cl ρ η.wit 0 0 u) (shp (cl ρ η.wit 0 0 u)) ws := by
    rw [← shp_of_sig hsigu]
    exact (VR_close hco ρ u [] 0 ρ (fun _ => 0) (shp (close σs u)) ws (fun k => rfl)
      (fun k hk => absurd hk (Nat.not_lt_zero _))).1 hvu
  refine ⟨⟨hvc, Valid_of_sig hsigu hl'.2.2.2.1⟩, ?_⟩
  have hw : wc (close σs u) = wc ru := by rw [wc_of_sig hsigu, wc_of_sig hsig]
  exact ShapeC_wc hw hl'.1 us hus

theorem unit_VR {ρ : Nat → Nat} {η : TEnv} : VR ρ η .unit (shp .unit) [] := by simp [VR]

theorem unit_Lay (σs : List Ty) : Lay σs .unit .unit [] := by
  refine ⟨fun us h => ?_, rfl, by simp [wc, accs], by simp [Valid], rfl⟩
  simp [accs] at h; subst h; rfl

/-- (T3d-1) A token binding (a Keep's, a `cas` take's) is `Unit` with no words
at runtime (option 1b: `Lay` compares modulo token erasure). -/
theorem tok_Lay (σs : List Ty) (r : Idx) (P : Proto) (j : Idx) :
    Lay σs (.tok r (some (P, j))) .unit [] := Lay_etok_unit rfl

/-! ## §5 `fld` (T3c-5a-3)

A locative to field `i` of the pair that a reference's target unfolds to.
TermRun computes field 1's offset from the *runtime* type of field 0
(`accs c1`).  That offset exists because a locative's target has a layout
(`LayT`, carried by `AtOff`, and by `VR` at `Ptr`), and it is the closed static
one because field 0's type exposes no unpacked type (D4, `opaqueOK`). -/

section Fld

/-! ### Layouts: which types have one -/

/-- Witnesses with `X` for type variable 0, the rest moved up one. -/
def wcons (X : Ty) (W : Nat → Ty) : Nat → Ty := fun k => if k = 0 then X else W (k - 1)

/-- A layout does not depend on a variable it has (it has none at variable
`e`, which has no layout): closing it at `X` keeps one. -/
theorem accs_cl_succ {ρ : Nat → Nat} {W W' : Nat → Ty} (hW : ∀ k, W' (k + 1) = W k) :
    ∀ (s : Ty) (e f : Nat), accs (cl ρ W (e + 1) f s) ≠ none → accs (cl ρ W' e f s) ≠ none := by
  intro s
  induction s with
  | tvar k =>
      intro e f h
      by_cases h1 : k < e
      · have h2 : k < e + 1 := by omega
        simpa [cl, h1, h2] using h
      · by_cases h2 : k = e
        · subst h2; simp [cl, accs] at h
        · have h3 : ¬ k < e + 1 := by omega
          have h4 : k - e = (k - (e + 1)) + 1 := by omega
          simp only [cl, h1, h3, ite_false] at h ⊢
          rw [h4, hW]; exact h
  | prod a b iha ihb =>
      intro e f h
      simp only [cl] at h ⊢
      rw [accs_ne_prod] at h ⊢
      exact ⟨iha e f h.1, ihb e f h.2⟩
  | mu t ih => intro e f h; simp only [cl, accs] at h ⊢; exact ih (e + 1) f h
  | tex κ t ih =>
      intro e f h; simp only [cl] at h ⊢
      rw [accs_ne_tex] at h ⊢; exact ih (e + 1) f h
  | iall t ih => intro e f h; simp only [cl, accs] at h ⊢; exact ih e (f + 1) h
  | iex t ih =>
      intro e f h; simp only [cl] at h ⊢
      rw [accs_ne_iex] at h ⊢; exact ih e (f + 1) h
  | refine t ψ ih => intro e f h; simp only [cl, accs] at h ⊢; exact ih e f h
  | array i t _ => intro e f h; simp [cl, accs] at h
  | sum a b _ _ => intro e f _; simp only [cl, accs]; split <;> simp
  | word r P => intro e f _; simp only [cl, accs]; split <;> simp
  | _ => intro e f _; simp [cl, accs]

/-- **Unfolding a closed `μ` type keeps its layout.** -/
theorem accs_cl_unfold {ρ : Nat → Nat} {W : Nat → Ty} (s : Ty)
    (h : accs (cl ρ W 0 0 (.mu s)) ≠ none) : accs (cl ρ W 0 0 (unfold1 (.mu s))) ≠ none := by
  have e1 : unfold1 (.mu s) = substTs [.mu s] 0 0 s := substT_eq (.mu s) s 0 0
  have e2 := cl_substTs [.mu s] 0 0 (ρ := ρ) (W₀ := W) (W₁ := wcons (cl ρ W 0 0 (.mu s)) W)
    (fun k hk => absurd hk (Nat.not_lt_zero _))
    (fun j σ hj => by
      cases j with
      | zero => simp at hj; subst hj; simp [wcons]
      | succ j => simp at hj)
    (fun k => by simp [wcons]) s 0 0
  simp only [Nat.add_zero] at e2
  rw [e1, e2]
  simp only [cl, accs] at h
  exact accs_cl_succ (W' := wcons (cl ρ W 0 0 (.mu s)) W) (fun k => by simp [wcons]) s 0 0 h

/-! ### (T3c-5h) Closing commutes with unfolding; `μ` folding at offsets -/

theorem tb_TvB : ∀ (t : Ty) {c c' : Nat}, tb c t = true → c ≤ c' → TvB c' t := by
  intro t
  induction t with
  | tvar k => intro c c' h hc; simp [tb] at h; simp [TvB]; omega
  | prod a b iha ihb => intro c c' h hc; simp only [tb, Bool.and_eq_true] at h; exact ⟨iha h.1 hc, ihb h.2 hc⟩
  | sum a b iha ihb => intro c c' h hc; simp only [tb, Bool.and_eq_true] at h; exact ⟨iha h.1 hc, ihb h.2 hc⟩
  | code a b _ iha ihb => intro c c' h hc; simp only [tb, Bool.and_eq_true] at h; exact ⟨iha h.1 hc, ihb h.2 hc⟩
  | array _ t ih => intro c c' h hc; exact ih h hc
  | ptr _ t ih => intro c c' h hc; exact ih h hc
  | ptrOpt _ t ih => intro c c' h hc; exact ih h hc
  | loc _ t ih => intro c c' h hc; exact ih h hc
  | mu t ih => intro c c' h hc; exact ih h (by omega)
  | tex _ t ih => intro c c' h hc; exact ih h (by omega)
  | iall t ih => intro c c' h hc; exact ih h hc
  | iex t ih => intro c c' h hc; exact ih h hc
  | refine t _ ih => intro c c' h hc; exact ih h hc
  | _ => intro c c' _ _; simp [TvB]

theorem Clo_shiftTN {X : Ty} (hX : Clo X) : ∀ n, shiftTN n X = X
  | 0 => rfl
  | n + 1 => by simp only [shiftTN, Clo_shiftTN hX n]; exact tb_shiftT X hX.1 (Nat.zero_le _)

theorem Clo_shiftIN {X : Ty} (hX : Clo X) : ∀ n, shiftIN n X = X
  | 0 => rfl
  | n + 1 => by simp only [shiftIN, Clo_shiftIN hX n]; exact Clo_shiftI hX 0

/-- Closing the last free type variable at a closed `X` is substituting `X`
for it after closing the rest. -/
theorem cl_wcons {ρ : Nat → Nat} {W : Nat → Ty} (hW : ∀ k, Clo (W k)) {X : Ty} (hX : Clo X) :
    ∀ (s : Ty) (e f : Nat), cl ρ (wcons X W) e f s = substTs [X] e f (cl ρ W (e + 1) f s) := by
  intro s
  induction s with
  | tvar k =>
      intro e f
      by_cases h1 : k < e
      · simp [cl, substTs, h1, show k < e + 1 by omega]
      · by_cases h2 : k = e
        · subst h2; simp [cl, substTs, wcons, Clo_shiftTN hX, Clo_shiftIN hX]
        · have h3 : ¬ k < e + 1 := by omega
          have h4 : k - e ≠ 0 := by omega
          have e5 : k - e - 1 = k - (e + 1) := by omega
          simp only [cl, h1, h3, ite_false, wcons, h4, e5]
          exact (substTs_TvB [X] _ e f (tb_TvB _ (hW _).1 (Nat.zero_le _))).symm
  | prod a b iha ihb => intro e f; simp only [cl, substTs, iha, ihb]
  | sum a b iha ihb => intro e f; simp only [cl, substTs, iha, ihb]
  | code a b _ iha ihb => intro e f; simp only [cl, substTs, iha, ihb]
  | array _ t ih => intro e f; simp only [cl, substTs, ih]
  | ptr _ t ih => intro e f; simp only [cl, substTs, ih]
  | ptrOpt _ t ih => intro e f; simp only [cl, substTs, ih]
  | loc _ t ih => intro e f; simp only [cl, substTs, ih]
  | mu t ih => intro e f; simp only [cl, substTs, ih (e + 1) f]
  | tex _ t ih => intro e f; simp only [cl, substTs, ih (e + 1) f]
  | iall t ih => intro e f; simp only [cl, substTs, ih e (f + 1)]
  | iex t ih => intro e f; simp only [cl, substTs, ih e (f + 1)]
  | refine t _ ih => intro e f; simp only [cl, substTs, ih]
  | _ => intro e f; simp [cl, substTs]

/-- **Closing commutes with unfolding** (at closed witnesses). -/
theorem cl_unfold1 {ρ : Nat → Nat} {W : Nat → Ty} (hW : ∀ k, Clo (W k)) (s : Ty) :
    cl ρ W 0 0 (unfold1 (.mu s)) = unfold1 (cl ρ W 0 0 (.mu s)) := by
  have e1 : unfold1 (.mu s) = substTs [.mu s] 0 0 s := substT_eq (.mu s) s 0 0
  have e2 := cl_substTs [.mu s] 0 0 (ρ := ρ) (W₀ := W) (W₁ := wcons (cl ρ W 0 0 (.mu s)) W)
    (fun k hk => absurd hk (Nat.not_lt_zero _))
    (fun j σ hj => by
      cases j with
      | zero => simp at hj; subst hj; simp [wcons]
      | succ j => simp at hj)
    (fun k => by simp [wcons]) s 0 0
  simp only [Nat.add_zero] at e2
  have e3 : unfold1 (cl ρ W 0 0 (.mu s)) = substTs [cl ρ W 0 0 (.mu s)] 0 0 (cl ρ W 1 0 s) :=
    substT_eq (cl ρ W 0 0 (.mu s)) (cl ρ W 1 0 s) 0 0
  rw [e1, e2, e3, cl_wcons hW (Clo_cl hW ρ (.mu s)) s 0 0]

/-- (T3c-5h) What sits at an offset of a closed `μ` type: itself, or what sits
there in its unfolding. -/
theorem AtOff_mu_inv {ρ : Nat → Nat} {W : Nat → Ty} (hW : ∀ k, Clo (W k)) {s : Ty}
    (hg : s.unguarded 0 = false) {o : Nat} {C : Ty} (h : AtOff (cl ρ W 0 0 (.mu s)) o C) :
    (o = 0 ∧ C = cl ρ W 0 0 (.mu s)) ∨ AtOff (cl ρ W 0 0 (unfold1 (.mu s))) o C := by
  generalize hT : cl ρ W 0 0 (.mu s) = T at h
  induction h with
  | here _ => exact Or.inl ⟨rfl, rfl⟩
  | fst _ _ => simp [cl] at hT
  | snd _ _ _ => simp [cl] at hT
  | elem _ _ _ _ => simp [cl] at hT
  | @mu ρ' W' s' u o hW' _ h' _ =>
      refine Or.inr ?_
      rw [cl_unfold1 hW, hT, ← cl_unfold1 hW']; exact h'
  | @fold ρ' W' s' T' o hW' hg' ha' _ ih =>
      rcases ih hT with ⟨rfl, e⟩ | h'
      · refine Or.inr (.fold hW' hg' ha' ?_)
        rw [e, ← hT]
        have ha : accs (cl ρ W 0 0 (.mu s)) ≠ none := by
          rw [hT, ← e]; exact accs_cl_unfold s' ha'
        exact .fold hW hg ha (.here (Or.inl (accs_cl_unfold s ha)))
      · exact Or.inr (.fold hW' hg' ha' h')

/-- (T3c-5h) Folding keeps the access list. -/
theorem Fd_accs {T U : Ty} (h : Fd T U) : accs T = accs U := by
  induction h with
  | refl => rfl
  | fold _ _ hae _ ih => exact ih.trans hae

/-- (T3c-5h) Only a `μ` is a proper fold. -/
theorem Fd_nonmu {T V : Ty} (h : Fd T V) (hV : ∀ b, V ≠ .mu b) : T = V := by
  revert hV
  induction h with
  | refl => intro _; rfl
  | @fold ρ W s _ _ _ _ _ _ => intro hV; exact absurd rfl (hV (cl ρ W 1 0 s))

/-- (T3c-5h) A fold to a closed `μ`: the identity, or a fold to its unfolding. -/
theorem Fd_mu_inv {ρ : Nat → Nat} {W : Nat → Ty} (hW : ∀ k, Clo (W k)) {s T : Ty}
    (h : Fd T (cl ρ W 0 0 (.mu s))) :
    T = cl ρ W 0 0 (.mu s) ∨ Fd T (cl ρ W 0 0 (unfold1 (.mu s))) := by
  generalize hT : cl ρ W 0 0 (.mu s) = V at h
  induction h with
  | refl => exact Or.inl rfl
  | @fold ρ' W' s' T' hW' _ _ hF _ =>
      refine Or.inr ?_
      rw [cl_unfold1 hW, hT, ← cl_unfold1 hW']; exact hF

/-- (T3c-5h) A type with an access list folds no buffer. -/
theorem Fd_noarr {V : Ty} (h : accs V ≠ none) : ∀ n e, ¬ Fd (.array (.lit n) e) V :=
  fun _ _ hF => h (by rw [← Fd_accs hF]; simp [accs])

theorem arrFree_shiftT : ∀ (t : Ty) (c : Nat), (t.shiftT c).arrFree = t.arrFree := by
  intro t; induction t with
  | tvar k => intro c; by_cases h : k ≥ c <;> simp [Ty.shiftT, h, Ty.arrFree]
  | _ => intro c; simp_all [Ty.shiftT, Ty.arrFree]

theorem arrFree_shiftI : ∀ (t : Ty) (c : Nat), (t.shiftI c).arrFree = t.arrFree := by
  intro t; induction t with
  | _ => intro c; simp_all [Ty.shiftI, Ty.arrFree]

theorem arrFree_substT : ∀ (t : Ty) (j : Nat) (σ : Ty), t.arrFree = true → σ.arrFree = true →
    (Ty.substT j σ t).arrFree = true := by
  intro t; induction t with
  | tvar k =>
      intro j σ _ hσ
      by_cases h1 : k = j
      · simp [Ty.substT, h1, hσ]
      · by_cases h2 : k > j <;> simp [Ty.substT, h1, h2, Ty.arrFree]
  | _ => intro j σ h hσ; simp_all [Ty.substT, Ty.arrFree, arrFree_shiftT, arrFree_shiftI]

/-- (T3c-5h) Folding into an array-free type starts from one. -/
theorem Fd_arrFree {T V : Ty} (h : Fd T V) (hV : V.arrFree = true) : T.arrFree = true := by
  induction h with
  | refl => exact hV
  | @fold ρ W s _ hW _ _ _ ih =>
      apply ih
      rw [cl_unfold1 hW]
      show (Ty.substT 0 (.mu (cl ρ W 1 0 s)) (cl ρ W 1 0 s)).arrFree = true
      exact arrFree_substT _ _ _ hV hV

/-- (T3c-5h) A cell at offset 0 holds what it folds. -/
theorem Fd_AtOff {T U : Ty} (h : Fd T U) (hl : accs T ≠ none) : AtOff T 0 U := by
  induction h with
  | refl => exact .here (Or.inl hl)
  | fold hW hg hae hF ih => exact .fold hW hg (by rw [← hae, ← Fd_accs hF]; exact hl) (ih hl)

/-! ### Offsets -/

theorem AtOff_lay {T U : Ty} {o : Nat} (h : AtOff T o U) : LayT U := by
  induction h with
  | here hl => exact hl
  | fst _ ih => exact ih
  | snd _ _ ih => exact ih
  | elem _ _ _ ih => exact ih
  | mu _ _ _ ih => exact ih
  | fold _ _ ha _ _ => exact Or.inl ha

/-- Offsets compose: a component of a component. -/
theorem AtOff_trans {A B C : Ty} {o o' : Nat} (h1 : AtOff A o B) (h2 : AtOff B o' C) :
    AtOff A (o + o') C := by
  revert h2
  induction h1 with
  | here _ => intro h2; simpa using h2
  | fst _ ih => intro h2; exact .fst (ih h2)
  | snd hu _ ih => intro h2; rw [Nat.add_assoc]; exact .snd hu (ih h2)
  | elem hu hj _ ih => intro h2; rw [Nat.add_assoc]; exact .elem hu hj (ih h2)
  | mu hW hg _ ih => intro h2; exact .mu hW hg (ih h2)
  | fold hW hg ha h1 ih =>
      intro h2
      rcases AtOff_mu_inv hW hg h2 with ⟨rfl, rfl⟩ | h2'
      · exact .fold hW hg ha h1
      · exact ih h2'

/-- (T3c-5b) A component of a locative's target that is not a whole buffer is
inside the same initialised slot. -/
theorem IniAt_trans {ini : AllocLabel → Nat} {c : Cell} {a : Address} {U V : Ty} {o : Nat}
    (h : IniAt ini c a U) (hna : ∀ n e, U ≠ .array (.lit n) e) (ho : AtOff U o V) :
    IniAt ini c (offs a o) V := by
  intro N e hc
  rcases h N e hc with ⟨h1, -⟩ | ⟨us, j, o', h1, h2, h3, h4⟩
  · exact absurd (h1.trans hc) (hna N e)
  · refine Or.inr ⟨us, j, o' + o, h1, h2, ?_, AtOff_trans h4 ho⟩
    show j * nWords us + (o' + o) = a.offset + o
    rw [← h3, Nat.add_assoc]

/-- (T3c-5b) Slot `j < ini` of a buffer locative. -/
theorem IniAt_idx {ini : AllocLabel → Nat} {c : Cell} {ad : Address} {n : Nat} {u : Ty}
    {us us' : List Acc} {j : Nat} (h : IniAt ini c ad (.array (.lit n) u)) (hus : accs u = some us)
    (hj : j < ini ad.label) (hjn : j < n) (hn : nWords us' = nWords us) :
    IniAt ini c (offs ad (j * nWords us')) u := by
  have hl : LayT u := Or.inl (by rw [hus]; simp)
  intro N e hc
  rcases h N e hc with ⟨h1, h0⟩ | ⟨us0, j0, o0, h1, h2, h3, h4⟩
  · rw [hc] at h1
    simp only [Ty.array.injEq, Idx.lit.injEq] at h1
    obtain ⟨rfl, rfl⟩ := h1
    refine Or.inr ⟨us, j, 0, hus, hj, ?_, .here hl⟩
    show j * nWords us + 0 = ad.offset + j * nWords us'
    rw [hn, ← h0]; simp
  · refine Or.inr ⟨us0, j0, o0 + (j * nWords us + 0), h1, h2, ?_, AtOff_trans h4 (.elem hus hjn (.here hl))⟩
    show j0 * nWords us0 + (o0 + (j * nWords us + 0)) = ad.offset + j * nWords us'
    rw [hn, ← h3, Nat.add_zero, Nat.add_assoc]

/-- `IniAt_idx` at a component `V` (offset `o`) of slot `j`. -/
theorem IniAt_idxF {ini : AllocLabel → Nat} {c : Cell} {ad : Address} {n : Nat} {u V : Ty}
    {us us' : List Acc} {j o : Nat} (h : IniAt ini c ad (.array (.lit n) u)) (hus : accs u = some us)
    (hj : j < ini ad.label) (hjn : j < n) (hn : nWords us' = nWords us) (hV : AtOff u o V) :
    IniAt ini c (offs ad (j * nWords us' + o)) V := by
  intro N e hc
  rcases h N e hc with ⟨h1, h0⟩ | ⟨us0, j0, o0, h1, h2, h3, h4⟩
  · rw [hc] at h1
    simp only [Ty.array.injEq, Idx.lit.injEq] at h1
    obtain ⟨rfl, rfl⟩ := h1
    refine Or.inr ⟨us, j, o, hus, hj, ?_, hV⟩
    show j * nWords us + o = ad.offset + (j * nWords us' + o)
    rw [hn, ← h0]; simp
  · refine Or.inr ⟨us0, j0, o0 + (j * nWords us + o), h1, h2, ?_, AtOff_trans h4 (.elem hus hjn hV)⟩
    show j0 * nWords us0 + (o0 + (j * nWords us + o)) = ad.offset + (j * nWords us' + o)
    rw [hn, ← h3, Nat.add_assoc]

theorem unfold1_prod_cases {u c1 c2 : Ty} (h : unfold1 u = .prod c1 c2) :
    u = .prod c1 c2 ∨ ∃ s, u = .mu s := by
  cases u with
  | mu s => exact Or.inr ⟨s, rfl⟩
  | prod a b => exact Or.inl h
  | _ => all_goals (first | exact Ty.noConfusion h | simp [unfold1] at h)

/-- The components of a target `u` that unfolds to a pair: both laid out, at
offsets `0` and field 0's word count. -/
theorem fld_off {ρ : Nat → Nat} {W : Nat → Ty} {u c1 c2 : Ty} (hW : ∀ k, Clo (W k))
    (hunf : unfold1 u = .prod c1 c2) (hl : LayT (cl ρ W 0 0 u)) (hg : mg u = true) :
    ∃ us, accs (cl ρ W 0 0 c1) = some us ∧ accs (cl ρ W 0 0 c2) ≠ none ∧
      AtOff (cl ρ W 0 0 u) 0 (cl ρ W 0 0 c1) ∧ AtOff (cl ρ W 0 0 u) (nWords us) (cl ρ W 0 0 c2) := by
  have key : accs (cl ρ W 0 0 (unfold1 u)) ≠ none := by
    rcases unfold1_prod_cases hunf with rfl | ⟨s, rfl⟩
    · rcases hl with h | ⟨n, e, he, _⟩
      · exact h
      · simp [cl] at he
    · rcases hl with h | ⟨n, e, he, _⟩
      · exact accs_cl_unfold s h
      · simp [cl] at he
  rw [hunf] at key
  simp only [cl] at key
  rw [accs_ne_prod] at key
  have hpair : ∀ v o, AtOff (cl ρ W 0 0 (.prod c1 c2)) o v → AtOff (cl ρ W 0 0 u) o v := by
    rcases unfold1_prod_cases hunf with rfl | ⟨s, rfl⟩
    · exact fun _ _ h => h
    · intro v o h; rw [← hunf] at h
      exact .mu hW (by simp only [mg, Bool.and_eq_true, Bool.not_eq_true'] at hg; exact hg.1) h
  cases hus : accs (cl ρ W 0 0 c1) with
  | none => exact absurd hus key.1
  | some us =>
      refine ⟨us, rfl, key.2, hpair _ _ (.fst (.here (Or.inl key.1))), ?_⟩
      have h2 := hpair _ _ (AtOff.snd (b := cl ρ W 0 0 c2) hus (.here (Or.inl key.2)))
      rwa [Nat.add_zero] at h2

/-- (D3) `ModeOK` at one word depends on the word only through its view. -/
theorem ModeOK_one {i : Nat} {P : AllocLabel → Option Ts} {S : AllocLabel → Prop} {μ : Mode}
    {l l' : AllocLabel} {c : Cell} {w w' : Word} (hl : l = l') (hv : w.view ≤ w'.view)
    (h : ModeOK i P S μ l c [w]) : ModeOK i P S μ l' c [w'] := by
  subst hl
  cases μ with
  | own => exact h
  | pub =>
      obtain ⟨f, hf, h⟩ := h
      exact ⟨f, hf, h.imp id fun h' x hx => by
        simp only [List.mem_singleton] at hx; subst hx; exact Nat.le_trans (h' w (by simp)) hv⟩
  | rgn _ => trivial

/-- A reference's or a non-null locative's target, as a closed component of a cell. -/
theorem cell_target {ρ : Nat → Nat} {η : TEnv} {t u : Ty} {μ : Mode} {rt : Shp} {ws : List Word}
    (hc : cellOf t = some (μ, u)) (hnb : ∀ n e, ¬ Fd (.array (.lit n) e) (cl ρ η.wit 0 0 u))
    (hv : VR ρ η t rt ws) :
    ∃ ad c, ws.map (·.val) = [.loc ad 0] ∧ η.sto ad.label = some c ∧
      AtOff c.ty ad.offset (cl ρ η.wit 0 0 u) ∧ ModeOK η.tid η.pfr η.seen μ ad.label c ws ∧
      IniAt (modeIni μ η.ini η.rini) c ad (cl ρ η.wit 0 0 u) := by
  cases t with
  | ptr μ' u' =>
      simp only [cellOf, Option.some.injEq, Prod.mk.injEq] at hc; obtain ⟨rfl, rfl⟩ := hc
      simp only [VR] at hv
      obtain ⟨ad, c, h1, h2, h3, h4, h5, h6⟩ := hv
      refine ⟨ad, c, h1, h3, ?_, h5, IniAt_of_ne fun N e he => h6 (by rw [he]; simp [accs])⟩
      rw [h2]; exact Fd_AtOff h4 h6
  | loc μ' u' =>
      simp only [cellOf, Option.some.injEq, Prod.mk.injEq] at hc; obtain ⟨rfl, rfl⟩ := hc
      simp only [VR] at hv
      rcases hv with ⟨_, e, he⟩ | ⟨a, c, U, h1, h3, h4, hF, h5, h6⟩
      · exact absurd he (hnb 0 e)
      · have hnaU : ∀ n e, U ≠ .array (.lit n) e := fun n e he => hnb n e (he ▸ hF)
        have hacc : accs U ≠ none := by
          rcases AtOff_lay h4 with h | ⟨n, e, he, -⟩
          · exact h
          · exact absurd he (hnaU n e)
        have ho := Fd_AtOff hF hacc
        have hI := IniAt_trans h6 hnaU ho
        have hoa : offs a 0 = a := by cases a; rfl
        rw [hoa] at hI
        exact ⟨a, c, h1, h3, by simpa using AtOff_trans h4 ho, h5, hI⟩
  | _ => simp [cellOf] at hc

/-! ### Skeletons through an unfolding -/

theorem skel_eq_ptr {rt : Ty} {μ : Mode} {u : Ty} (h : skel rt = .ptr μ u) :
    ∃ μ' u', rt = .ptr μ' u' ∧ skelM μ' = μ ∧ skel u' = u := by
  cases rt with
  | ptr μ' u' => simp only [skel, Ty.ptr.injEq] at h; exact ⟨μ', u', rfl, h.1, h.2⟩
  | refine t ψ => rcases rf_cases (skel t) with e | ⟨u, e⟩ <;> simp [skel, e] at h
  | _ => simp [skel] at h

theorem skel_eq_loc {rt : Ty} {μ : Mode} {u : Ty} (h : skel rt = .loc μ u) :
    ∃ μ' u', rt = .loc μ' u' ∧ skelM μ' = μ ∧ skel u' = u := by
  cases rt with
  | loc μ' u' => simp only [skel, Ty.loc.injEq] at h; exact ⟨μ', u', rfl, h.1, h.2⟩
  | refine t ψ => rcases rf_cases (skel t) with e | ⟨u, e⟩ <;> simp [skel, e] at h
  | _ => simp [skel] at h

theorem skel_eq_mu {rt b : Ty} (h : skel rt = .mu b) : ∃ rb, rt = .mu rb ∧ skel rb = b := by
  cases rt with
  | mu rb => simp only [skel, Ty.mu.injEq] at h; exact ⟨rb, rfl, h⟩
  | refine t ψ => rcases rf_cases (skel t) with e | ⟨u, e⟩ <;> simp [skel, e] at h
  | _ => simp [skel] at h

/-! (T3d-1) The same through token erasure. -/

theorem eskel_eq_ptr {rt : Ty} {μ : Mode} {u : Ty} (h : etok (skel rt) = .ptr μ u) :
    ∃ μ' u', rt = .ptr μ' u' ∧ skelM μ' = μ ∧ etok (skel u') = u := by
  cases rt with
  | ptr μ' u' => simp only [skel, etok, Ty.ptr.injEq] at h; exact ⟨μ', u', rfl, h.1, h.2⟩
  | refine t ψ => rcases rf_cases (skel t) with e | ⟨u, e⟩ <;> simp [skel, etok, e] at h
  | _ => simp [skel, etok] at h

theorem eskel_eq_loc {rt : Ty} {μ : Mode} {u : Ty} (h : etok (skel rt) = .loc μ u) :
    ∃ μ' u', rt = .loc μ' u' ∧ skelM μ' = μ ∧ etok (skel u') = u := by
  cases rt with
  | loc μ' u' => simp only [skel, etok, Ty.loc.injEq] at h; exact ⟨μ', u', rfl, h.1, h.2⟩
  | refine t ψ => rcases rf_cases (skel t) with e | ⟨u, e⟩ <;> simp [skel, etok, e] at h
  | _ => simp [skel, etok] at h

theorem eskel_eq_mu {rt b : Ty} (h : etok (skel rt) = .mu b) : ∃ rb, rt = .mu rb ∧ skel rb = b := by
  cases rt with
  | mu rb => simp only [skel, etok, Ty.mu.injEq] at h; exact ⟨rb, rfl, h⟩
  | refine t ψ => rcases rf_cases (skel t) with e | ⟨u, e⟩ <;> simp [skel, etok, e] at h
  | _ => simp [skel, etok] at h

theorem rf_eq_refine {z t : Ty} {ψ : Pred} (h : rf z = .refine t ψ) : z = t ∧ ψ = .tt := by
  cases z <;> first | (injection h with h1 h2; exact ⟨h1, h2.symm⟩) | (simp [rf] at h)

/-- Substituting for a variable a skeleton does not mention is the identity. -/
theorem substS_shiftT_self (Y : Ty) : ∀ (x : Ty) (c : Nat), skel x = x → substS [Y] c (x.shiftT c) = x := by
  intro x
  induction x with
  | tvar k =>
      intro c _
      by_cases hk : k ≥ c
      · have h1 : ¬ k + 1 < c := by omega
        have h2 : [Y][k + 1 - c]? = none := List.getElem?_eq_none_iff.mpr (by simp; omega)
        simp [Ty.shiftT, hk, substS, h1, h2]
      · simp [Ty.shiftT, hk, substS, show k < c by omega]
  | prod a b iha ihb =>
      intro c h; simp only [skel, Ty.prod.injEq] at h
      simp only [Ty.shiftT, substS, iha c h.1, ihb c h.2]
  | sum a b iha ihb =>
      intro c h; simp only [skel, Ty.sum.injEq] at h
      simp only [Ty.shiftT, substS, iha c h.1, ihb c h.2]
  | code a b _ iha ihb =>
      intro c h; simp only [skel, Ty.code.injEq] at h
      simp only [Ty.shiftT, substS, iha c h.1, ihb c h.2.1]
  | array i t ih =>
      intro c h; simp only [skel, Ty.array.injEq] at h
      simp only [Ty.shiftT, substS, ih c h.2]
  | ptr μ t ih =>
      intro c h; simp only [skel, Ty.ptr.injEq] at h
      simp only [Ty.shiftT, substS, ih c h.2]
  | ptrOpt μ t ih =>
      intro c h; simp only [skel, Ty.ptrOpt.injEq] at h
      simp only [Ty.shiftT, substS, ih c h.2]
  | loc μ t ih =>
      intro c h; simp only [skel, Ty.loc.injEq] at h
      simp only [Ty.shiftT, substS, ih c h.2]
  | mu t ih =>
      intro c h; simp only [skel, Ty.mu.injEq] at h
      simp only [Ty.shiftT, substS, ih (c + 1) h]
  | tex κ t ih =>
      intro c h; simp only [skel, Ty.tex.injEq] at h
      simp only [Ty.shiftT, substS, ih (c + 1) h.2]
  | iall t ih =>
      intro c h; simp only [skel, Ty.iall.injEq] at h
      simp only [Ty.shiftT, substS, ih c h]
  | iex t ih =>
      intro c h; simp only [skel, Ty.iex.injEq] at h
      simp only [Ty.shiftT, substS, ih c h]
  | refine t ψ ih =>
      intro c h
      simp only [skel] at h
      obtain ⟨e1, e2⟩ := rf_eq_refine h
      have ht : skel t = t := e1
      simp only [Ty.shiftT, substS, ih c ht]
      rw [← h, ht]
  | _ => intros; simp [Ty.shiftT, substS]

/-- **The substitution lemma on skeletons**: substituting `A` after `X` for
variable `c` is substituting `X`'s substitution after `A` (above `c`). -/
theorem substS_subst1 (A : List Ty) (hA : ∀ σ ∈ A, skel σ = σ) (X : Ty) :
    ∀ (V : Ty) (c : Nat), substS A c (substS [X] c V) = substS [substS A 0 X] c (substS A (c + 1) V) := by
  intro V
  induction V with
  | tvar k =>
      intro c
      rcases Nat.lt_trichotomy k c with hk | hk | hk
      · simp [substS, hk, show k < c + 1 by omega]
      · subst hk
        have eL : substS [X] k (.tvar k) = shiftTN k X := by simp [substS]
        have eR : substS A (k + 1) (.tvar k) = .tvar k := by simp [substS]
        have eR2 : substS [substS A 0 X] k (.tvar k) = shiftTN k (substS A 0 X) := by simp [substS]
        rw [eL, eR, eR2]; exact substS_shiftTN A k X
      · have h1 : ¬ k < c := by omega
        have h2 : [X][k - c]? = none := List.getElem?_eq_none_iff.mpr (by simp; omega)
        have h3 : ¬ k < c + 1 := by omega
        have h4 : ¬ k - 1 < c := by omega
        have e5 : k - 1 - c = k - (c + 1) := by omega
        have eX : substS [X] c (.tvar k) = .tvar (k - 1) := by simp [substS, h1, h2]
        rw [eX]
        cases hσ : A[k - (c + 1)]? with
        | some σ =>
            have eL : substS A c (.tvar (k - 1)) = shiftTN c σ := by
              simp only [substS, h4, ite_false]; rw [e5, hσ]
            have eR : substS A (c + 1) (.tvar k) = shiftTN (c + 1) σ := by
              simp only [substS, h3, ite_false]; rw [hσ]
            have hs : skel (shiftTN c σ) = shiftTN c σ := by
              rw [skel_shiftTN, hA σ (List.mem_of_getElem? hσ)]
            rw [eL, eR, ← shiftT_shiftTN c c σ (Nat.le_refl c)]
            exact (substS_shiftT_self _ (shiftTN c σ) c hs).symm
        | none =>
            have hl : A.length ≤ k - (c + 1) := by simpa using hσ
            have eL : substS A c (.tvar (k - 1)) = .tvar (k - 1 - A.length) := by
              simp only [substS, h4, ite_false]; rw [e5, hσ]
            have eR : substS A (c + 1) (.tvar k) = .tvar (k - A.length) := by
              simp only [substS, h3, ite_false]; rw [hσ]
            have h6 : ¬ k - A.length < c := by omega
            have h7 : [substS A 0 X][k - A.length - c]? = none :=
              List.getElem?_eq_none_iff.mpr (by simp; omega)
            rw [eL, eR]
            simp only [substS, h6, ite_false, h7, List.length_singleton]
            congr 1; omega
  | prod a b iha ihb => intro c; simp only [substS, iha, ihb]
  | sum a b iha ihb => intro c; simp only [substS, iha, ihb]
  | code a b _ iha ihb => intro c; simp only [substS, iha, ihb]
  | array i t ih => intro c; simp only [substS, ih]
  | ptr μ t ih => intro c; simp only [substS, ih]
  | ptrOpt μ t ih => intro c; simp only [substS, ih]
  | loc μ t ih => intro c; simp only [substS, ih]
  | mu t ih => intro c; simp only [substS, ih (c + 1)]
  | tex κ t ih => intro c; simp only [substS, ih (c + 1)]
  | iall t ih => intro c; simp only [substS, ih c]
  | iex t ih => intro c; simp only [substS, ih c]
  | refine t ψ ih => intro c; simp only [substS, substS_rf, ih c]
  | _ => intro c; simp [substS]

/-- **Runtime unfolding agrees with static unfolding**, on skeletons: a runtime
`μ` type with the skeleton of `μ s` closed at `σs` unfolds to the skeleton of
`μ s`'s unfolding, closed. -/
theorem skel_unfold_mu {σs : List Ty} {s ur : Ty} (h : etok (skel ur) = etok (skel (close σs (.mu s)))) :
    skel (unfold1 ur) = skel (close σs (unfold1 (.mu s))) := by
  have h' : etok (skel ur) = .mu (skel (substTs σs 1 0 s)) := by rw [h]; rfl
  obtain ⟨sr, rfl, hs⟩ := eskel_eq_mu h'
  have e1 : unfold1 (.mu sr) = substTs [.mu sr] 0 0 sr := substT_eq (.mu sr) sr 0 0
  have e2 : unfold1 (.mu s) = substTs [.mu s] 0 0 s := substT_eq (.mu s) s 0 0
  rw [skel_substTs] at hs
  rw [e1, e2]
  simp only [close, skel_substTs, List.map_cons, List.map_nil, skel]
  rw [substS_subst1 (σs.map skel) (fun σ hσ => by
    obtain ⟨τ, -, rfl⟩ := List.mem_map.1 hσ; exact skel_idem τ)]
  rw [hs]
  simp [substS]

/-! ### Layout forms through unrolling -/

/-- `lyt` through a one-variable substitution of a type whose index variables
the substitution's depth shifts away. -/
theorem lyt_substT : ∀ (t : Ty) (j d : Nat) (s : Ty),
    lyt d (Ty.substT j (shiftIN d s) t) = Ty.substT j (lyt 0 s) (lyt d t) := by
  intro t
  induction t with
  | tvar k =>
      intro j d s
      simp only [Ty.substT, lyt]
      split
      · exact lyt_shiftIN d s
      · split <;> rfl
  | mu t ih =>
      intro j d s
      simp only [Ty.substT, lyt]
      rw [shiftT_shiftIN', ih (j + 1) d (s.shiftT 0), lyt_shiftT]
  | tex κ t ih =>
      intro j d s
      simp only [Ty.substT, lyt]
      rw [shiftT_shiftIN', ih (j + 1) d (s.shiftT 0), lyt_shiftT]
  | iall t ih =>
      intro j d s
      simp only [Ty.substT, lyt]
      rw [show Ty.shiftI 0 (shiftIN d s) = shiftIN (d + 1) s from rfl, ih j (d + 1) s,
        lyt_shiftI_id s 0 0 (Nat.le_refl 0)]
  | iex t ih =>
      intro j d s
      simp only [Ty.substT, lyt]
      rw [show Ty.shiftI 0 (shiftIN d s) = shiftIN (d + 1) s from rfl, ih j (d + 1) s,
        lyt_shiftI_id s 0 0 (Nat.le_refl 0)]
  | refine t ψ ih => intro j d s; simp only [Ty.substT, lyt]; split <;> simp_all [Ty.substT]
  | tok r st => intro j d s; simp [lyt, Ty.substT]
  | _ => intro j d s; simp_all [Ty.substT, lyt]

theorem lyt_unfold_mu (sr : Ty) : lyt 0 (unfold1 (.mu sr)) = unfold1 (.mu (lyt 0 sr)) := by
  simp only [unfold1]
  have := lyt_substT sr 0 0 (.mu sr)
  simp only [shiftIN] at this
  rw [this]; rfl

theorem substTs_nil' : ∀ (t : Ty) (c d : Nat), substTs [] c d t = t := by
  intro t
  induction t with
  | tvar k => intro c d; simp only [substTs]; split <;> simp
  | _ => intros; simp_all [substTs]

/-- Index-closed substitution commutes with a one-variable substitution. -/
theorem substTs_substT_IC {L : List Ty} (hL : ∀ σ ∈ L, ICl σ) : ∀ (V : Ty) (c d : Nat) (X : Ty),
    substTs L c d (Ty.substT c X V) = Ty.substT c (substTs L c d X) (substTs L (c + 1) d V) := by
  intro V
  induction V with
  | tvar k =>
      intro c d X
      rcases Nat.lt_trichotomy k c with hk | rfl | hk
      · have h1 : (k == c) = false := by simp; omega
        simp [Ty.substT, substTs, hk, h1, show ¬ k > c by omega, show k < c + 1 by omega]
      · simp [Ty.substT, substTs]
      · have h1 : (k == c) = false := by simp; omega
        have h3 : ¬ k < c + 1 := by omega
        have h4 : ¬ k - 1 < c := by omega
        have e5 : k - 1 - c = k - (c + 1) := by omega
        simp only [Ty.substT, h1, hk, ite_true, Bool.false_eq_true, ite_false, substTs, h3, h4]
        rw [e5]
        cases hσ : L[k - (c + 1)]? with
        | some σ =>
            simp only
            have hc := ICl_shiftTN (hL σ (List.mem_of_getElem? hσ))
            rw [shiftIN_ICl (hc c), shiftIN_ICl (hc (c + 1)), ← shiftT_shiftTN c c σ (Nat.le_refl c),
              substT_shiftT]
        | none =>
            have hl : L.length ≤ k - (c + 1) := by simpa using hσ
            have h6 : (k - L.length == c) = false := by simp; omega
            have h7 : k - L.length > c := by omega
            simp only [Ty.substT, h6, h7, ite_true, Bool.false_eq_true, ite_false]
            congr 1; omega
  | mu t ih =>
      intro c d X
      simp only [Ty.substT, substTs]
      rw [ih (c + 1) d (X.shiftT 0), substTs_shiftT_d L X c 0 d (Nat.zero_le _)]
  | tex κ t ih =>
      intro c d X
      simp only [Ty.substT, substTs]
      rw [ih (c + 1) d (X.shiftT 0), substTs_shiftT_d L X c 0 d (Nat.zero_le _)]
  | iall t ih =>
      intro c d X
      simp only [Ty.substT, substTs]
      rw [ih c (d + 1) (X.shiftI 0), substTs_shiftI_IC hL, substTs_depth hL _ c (d + 1),
        substTs_depth hL (X.shiftI 0) c d]
  | iex t ih =>
      intro c d X
      simp only [Ty.substT, substTs]
      rw [ih c (d + 1) (X.shiftI 0), substTs_shiftI_IC hL, substTs_depth hL _ c (d + 1),
        substTs_depth hL (X.shiftI 0) c d]
  | _ => intros; simp_all [Ty.substT, substTs]

/-- **Unrolling commutes with closing, on layout forms.** -/
theorem lyt_unfold_close (σs : List Ty) (s : Ty) :
    unfold1 (lyt 0 (close σs (.mu s))) = lyt 0 (close σs (unfold1 (.mu s))) := by
  have hL : ∀ σ ∈ σs.map (lyt 0), ICl σ := fun σ h => by
    obtain ⟨x, -, rfl⟩ := List.mem_map.1 h; exact ICl_lyt0 x
  rw [lyt_close σs (unfold1 (.mu s)), lyt_unfold_mu]
  simp only [close, substTs, lyt]
  rw [lyt_substTs s σs 1 0 0 (Nat.le_refl 0)]
  simp only [unfold1]
  rw [substTs_substT_IC hL (lyt 0 s) 0 0 (.mu (lyt 0 s))]
  simp only [substTs]

/-- **A field's runtime type has the static field's layout form.** -/
theorem unfold_lyt {σs : List Ty} {u ur c1 c2 c1r c2r : Ty} (hl5 : etok (lyt 0 ur) = etok (lyt 0 (close σs u)))
    (hsk : etok (skel ur) = etok (skel (close σs u))) (hunf : unfold1 u = .prod c1 c2) (hur : unfold1 ur = .prod c1r c2r) :
    etok (lyt 0 c1r) = etok (lyt 0 (close σs c1)) ∧ etok (lyt 0 c2r) = etok (lyt 0 (close σs c2)) := by
  rcases unfold1_prod_cases hunf with rfl | ⟨s, rfl⟩
  · simp only [close, substTs, skel, etok] at hsk
    obtain ⟨a, b, rfl, -, -⟩ := eskel_eq_prod hsk
    simp only [unfold1, Ty.prod.injEq] at hur
    obtain ⟨rfl, rfl⟩ := hur
    simp only [close, substTs, lyt, etok, Ty.prod.injEq] at hl5
    exact hl5
  · have h' : etok (skel ur) = .mu (skel (substTs σs 1 0 s)) := by rw [hsk]; rfl
    obtain ⟨sr, rfl, -⟩ := eskel_eq_mu h'
    have hl5' : lyt 0 (.mu sr) = lyt 0 (close σs (.mu s)) := by
      have := hl5; simp only [close, substTs, lyt, etok] at this ⊢; exact this
    have e : lyt 0 (unfold1 (.mu sr)) = lyt 0 (close σs (unfold1 (.mu s))) := by
      rw [lyt_unfold_mu, ← lyt_unfold_close, ← hl5']; rfl
    rw [hur, hunf] at e
    simp only [close, substTs, lyt, Ty.prod.injEq] at e
    exact ⟨congrArg etok e.1, congrArg etok e.2⟩

/-! ### The step -/

/-- **`fld`, progress and preservation of the bound value**: the step is
deterministic, keeps the state, and the new locative is a locative to the
field, at the field's offset in the same cell. -/
theorem fld_core {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {env : Env} {a : At}
    {t u c1 c2 : Ty} {μ : Mode} {i : Nat} {g : G} {s : St}
    (hvars : VarsOK ρ η σs cx.vars env) (hW : WitL σs η.wit cx.opq) (hK : cx.ke.length ≤ σs.length)
    (htv : TvOK cx) (hw : ∀ k, Clo (η.wit k))
    (hp : cx.peek a = .ok t) (hc : cellOf t = some (μ, u)) (hunf : unfold1 u = .prod c1 c2)
    (hop : i ≠ 0 → cx.opaqueOK c1 = true) :
    ∃ rt ws, evalOp g env σs s (.fld i a) = [(s, rt, ws)] ∧
      VR ρ η (.loc μ (if i == 0 then c1 else c2)) (shp rt) ws ∧
      Lay σs (.loc μ (if i == 0 then c1 else c2)) rt ws := by
  obtain ⟨rt, ws, hea, hv, hl⟩ := peek_VR hvars hp
  -- the static side: the target cell, and the fields' offsets in it
  have hna : ∀ n e, ¬ Fd (.array (.lit n) e) (cl ρ η.wit 0 0 u) := by
    intro n e hF
    rcases unfold1_prod_cases hunf with rfl | ⟨s', rfl⟩
    · exact absurd (Fd_nonmu hF (fun b => by simp [cl])) (by simp [cl])
    · rcases Fd_mu_inv hw hF with he | hF'
      · simp [cl] at he
      · rw [hunf] at hF'
        exact absurd (Fd_nonmu hF' (fun b => by simp [cl])) (by simp [cl])
  obtain ⟨ad, c, hws, hsto, hat, hmode, hini⟩ := cell_target hc hna hv
  obtain ⟨us, hus, -, ho1, ho2⟩ := fld_off hw hunf (AtOff_lay hat) (mg_cellOf (peek_mg htv hp) hc)
  obtain ⟨w, rfl, hwv⟩ := map_singleton hws
  -- the runtime side: a reference whose pointee unfolds to a pair
  have htb := peek_tb htv hp
  have htbu := tb_unfold1 (tb_cellOf htb hc)
  rw [hunf] at htbu
  simp only [tb, Bool.and_eq_true] at htbu
  have hs := hl.2.1
  obtain ⟨μr, ur, hcr, hμ, hsu⟩ : ∃ μr ur, cellOf rt = some (μr, ur) ∧ skelM μr = skelM μ ∧
      etok (skel ur) = etok (skel (close σs u)) := by
    cases t with
    | ptr μ' u' =>
        simp only [cellOf, Option.some.injEq, Prod.mk.injEq] at hc; obtain ⟨rfl, rfl⟩ := hc
        simp only [close, substTs, skel, etok] at hs
        obtain ⟨μr, ur, rfl, h1, h2⟩ := eskel_eq_ptr hs
        exact ⟨μr, ur, rfl, h1, h2⟩
    | loc μ' u' =>
        simp only [cellOf, Option.some.injEq, Prod.mk.injEq] at hc; obtain ⟨rfl, rfl⟩ := hc
        simp only [close, substTs, skel, etok] at hs
        obtain ⟨μr, ur, rfl, h1, h2⟩ := eskel_eq_loc hs
        exact ⟨μr, ur, rfl, h1, h2⟩
    | _ => simp [cellOf] at hc
  have hunr : etok (skel (unfold1 ur)) = .prod (etok (skel (close σs c1))) (etok (skel (close σs c2))) := by
    rcases unfold1_prod_cases hunf with rfl | ⟨s', rfl⟩
    · have h1 : etok (skel ur) = .prod (etok (skel (close σs c1))) (etok (skel (close σs c2))) := hsu
      obtain ⟨a1, b1, rfl, -, -⟩ := eskel_eq_prod h1
      exact h1
    · rw [skel_unfold_mu hsu, hunf]; rfl
  obtain ⟨c1r, c2r, hur, hs1, hs2⟩ := eskel_eq_prod hunr
  have hcl := peek_cell_lyt hvars hp hea hc hcr
  have hfl := unfold_lyt hcl.2 hsu hunf hur
  -- the result's runtime side, given the field
  have hlay : ∀ (ci cir : Ty) (o : Nat), etok (skel cir) = etok (skel (close σs ci)) → etok (lyt 0 cir) = etok (lyt 0 (close σs ci)) →
      Lay σs (.loc μ ci) (.loc μr cir) [{ w with val := .loc (offs ad o) 0 }] := by
    intro ci cir o hsk hly
    refine ⟨fun us h => by simp [accs] at h; subst h; rfl, ?_, by simp [wc, accs],
      Or.inr ⟨offs ad o, by simp⟩, lyt_loc_of hcl.1 hly⟩
    show Ty.loc (skelM μr) (etok (skel cir)) = Ty.loc (skelM μ) (etok (skel (close σs ci)))
    rw [hμ, hsk]
  have hvr : ∀ (ci : Ty) (o : Nat) (R : Shp), AtOff (cl ρ η.wit 0 0 u) o (cl ρ η.wit 0 0 ci) →
      VR ρ η (.loc μ ci) R [{ w with val := .loc (offs ad o) 0 }] := by
    intro ci o R ho
    simp only [VR]
    exact Or.inr ⟨offs ad o, c, _, by simp, by simpa [offs] using hsto, AtOff_trans hat ho, .refl,
      ModeOK_one (l := ad.label) (w := w) (by simp [offs]) (Nat.le_refl _) hmode,
      IniAt_trans hini (fun n e h => hna n e (by rw [h]; exact .refl)) ho⟩
  by_cases hi0 : i = 0
  · subst hi0
    refine ⟨.loc μr c1r, [{ w with val := .loc (offs ad 0) 0 }], ?_, ?_, ?_⟩
    · simp [evalOp, hea, hcr, hur, hwv, ol, pure]
    · simpa using hvr c1 0 _ ho1
    · simpa using hlay c1 c1r 0 hs1 hfl.1
  · have hsig : sig c1r = sig (cl ρ η.wit 0 0 c1) := by
      have e : sig c1r = sig (close σs c1) := sig_of_eskel hs1
      rw [e]; exact sig_WitL hW ρ (hop hi0) (lt_of_guardT htbu.1 hK)
    have hwc := wc_of_sig hsig
    cases hus' : accs c1r with
    | none => simp [wc, hus', hus] at hwc
    | some us' =>
        have hn : nWords us' = nWords us := by simpa [wc, hus, hus'] using hwc
        have hb : (i == 0) = false := by simpa using hi0
        refine ⟨.loc μr c2r, [{ w with val := .loc (offs ad (nWords us')) 0 }], ?_, ?_, ?_⟩
        · simp [evalOp, hea, hcr, hur, hwv, hus', hb, ol, pure]
        · simp only [hb, Bool.false_eq_true, ite_false]
          rw [hn]; exact hvr c2 _ _ ho2
        · simp only [hb, Bool.false_eq_true, ite_false]
          exact hlay c2 c2r _ hs2 hfl.2

theorem fld_step {p : Prog} {cx c' : Cx} {x : String} {i : Nat} {a : At} {ρ : Nat → Nat} {η : TEnv}
    {σs : List Ty} {env : Env} {K : TEnv → List Word → Prop} {g : G} {s : St}
    (hT : OpT p cx x (.fld i a) c') (hi : FInv ρ η σs K cx env) (htv : TvOK cx) (hw : ∀ k, Clo (η.wit k)) :
    ∃ rt ws, evalOp g env σs s (.fld i a) = [(s, rt, ws)] ∧ FInv ρ η σs K c' ((x, rt, ws) :: env) := by
  cases hT with
  | fldOwn hp hc hunf hop hu hb =>
      obtain ⟨rt, ws, he, hv, hl⟩ :=
        fld_core (g := g) (s := s) hi.2.1 hi.2.2.2.1 hi.2.2.2.2.1 htv hw hp hc hunf hop
      exact ⟨rt, ws, he, bind_FInv hb (use_FInv hu hi).1 hv hl⟩
  | fldShared hp hc _ hunf hop hb =>
      obtain ⟨rt, ws, he, hv, hl⟩ :=
        fld_core (g := g) (s := s) hi.2.1 hi.2.2.2.1 hi.2.2.2.2.1 htv hw hp hc hunf hop
      exact ⟨rt, ws, he, bind_FInv hb hi hv hl⟩

/-- **P1 + P4 at the thread, `fld`.** -/
theorem tstep_fld {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {i : Nat} {a : At} {e : Expr}
    (hterm : th.term = .let_ x (.fld i a) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvE p (CE η) r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
      rename_i c₁
      obtain ⟨rt, ws, hev, hf⟩ := fld_step (g := g) (s := stOf mem pairs th) hop hi htv (fun k => (hE.2.1 k).1)
      have key : tstep g mem pairs th = (evalOp g th.env th.σs (stOf mem pairs th) (.fld i a)).map
          fun (s', t, ws) => (s'.mem, s'.pairs, withS { th with term := e, env := (x, t, ws) :: th.env } s') := by
        simp [tstep, hterm]
      rw [key, hev]
      refine ⟨by simp, ?_⟩
      intro r hr
      simp only [List.map_cons, List.map_nil, List.mem_singleton] at hr
      subst hr
      exact ⟨ρ, η, c₁, rfl, hE, he, OpT_TvOK hP hop htv, hf, retPw_skel hPS hRP (skel_subst_eq (OpT_retSk hop) th.σs 0 0 0)⟩

theorem tstepM_fld {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {i : Nat} {a : At} {e : Expr}
    (hterm : th.term = .let_ x (.fld i a) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  have hT' := hT
  rw [hterm] at hT'
  cases hT' with
  | let_ hop _ =>
      obtain ⟨rt, ws, hev, -⟩ := fld_step (g := g) (s := stOf mem pairs th) hop hi htv (fun k => (hE.2.1 k).1)
      exact lift hm (tstep_fld hterm hP hT hi hE htv hRP hPS) (same_let hterm (fun _ _ _ _ h => by cases h)
        (fun _ _ h => by cases h) (fun r hr => by
          rw [hev, List.mem_singleton] at hr; subst hr; exact same_of_eq rfl))

end Fld

/-! ## §6 `idx` (T3c-5a-3)

A locative to slot `j` of a buffer.  TermRun computes the slot's offset from
the *runtime* element type (`j * nWords (accs u)`).  The buffer's target is a
laid-out array (`LayT`'s second disjunct, carried by `AtOff`), the slot is in
range (`LtI j n`; this also excludes `null`, whose closure is a length-0
array), and the width is the closed static one because the element type
exposes no unpacked type (D4, `opaqueOK`). -/

section Idx

theorem skel_eq_array {rt e : Ty} (h : skel rt = .array (.lit 0) e) :
    ∃ i er, rt = .array i er ∧ skel er = e := by
  cases rt with
  | array i er => simp only [skel, Ty.array.injEq] at h; exact ⟨i, er, rfl, h.2⟩
  | refine t ψ => rcases rf_cases (skel t) with e' | ⟨u, e'⟩ <;> simp [skel, e'] at h
  | _ => simp [skel] at h

theorem eskel_eq_array {rt e : Ty} (h : etok (skel rt) = .array (.lit 0) e) :
    ∃ i er, rt = .array i er ∧ etok (skel er) = e := by
  cases rt with
  | array i er => simp only [skel, etok, Ty.array.injEq] at h; exact ⟨i, er, rfl, h.2⟩
  | refine t ψ => rcases rf_cases (skel t) with e' | ⟨u, e'⟩ <;> simp [skel, etok, e'] at h
  | _ => simp [skel, etok] at h

/-- A runtime type with a buffer's skeleton has a buffer's element. -/
theorem buf_runtime {rt e : Ty} {m : Mode} (h : etok (skel rt) = rf (.loc m (.array (.lit 0) e))) :
    ∃ μr ur, bufElem rt = some (μr, ur) ∧ skelM μr = m ∧ etok (skel ur) = e := by
  cases rt with
  | refine t ψ =>
      simp only [skel, etok_rf] at h
      have h' : rf (etok (skel t)) = .refine (.loc m (.array (.lit 0) e)) .tt := by rw [h]; rfl
      obtain ⟨e1, -⟩ := rf_eq_refine h'
      obtain ⟨μr, u', rfl, h1, h2⟩ := eskel_eq_loc e1
      obtain ⟨i, ur, rfl, h3⟩ := eskel_eq_array h2
      exact ⟨μr, ur, rfl, h1, h3⟩
  | _ => simp [skel, etok, rf] at h

theorem idx_core {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {env : Env} {b i : At}
    {t u : Ty} {μ : Mode} {n k j : Idx} {g : G} {s : St}
    (hsat : Sat cx.facts ρ) (hvars : VarsOK ρ η σs cx.vars env) (hW : WitL σs η.wit cx.opq)
    (hK : cx.ke.length ≤ σs.length) (htv : TvOK cx)
    (hp : cx.peek b = .ok t) (hbuf : bufOf t = some (μ, n, u, k)) (hint : IntIdx cx i j)
    (hlt : LtI cx j n) (hltk : LtI cx j k) (hop : cx.opaqueOK u = true) :
    ∃ rt ws, evalOp g env σs s (.idx b i) = [(s, rt, ws)] ∧
      VR ρ η (.loc μ u) (shp rt) ws ∧ Lay σs (.loc μ u) rt ws := by
  have ht : t = .refine (.loc μ (.array n u)) (.ini k) := by
    unfold bufOf at hbuf; split at hbuf
    · simp only [Option.some.injEq, Prod.mk.injEq] at hbuf
      obtain ⟨rfl, rfl, rfl, rfl⟩ := hbuf; rfl
    · simp at hbuf
  subst ht
  have hJ : ev ρ j < ev ρ n := hlt ρ hsat
  -- the index
  obtain ⟨ti, hpi, hti⟩ := hint
  obtain ⟨rti, wsi, hei, hvi, -⟩ := peek_VR hvars hpi
  obtain ⟨wi, rfl, hwi⟩ := map_singleton (VR_intS hti hvi)
  -- the buffer: a reference into a cell, at an array of laid-out slots
  obtain ⟨rt, ws, hea, hv, hl⟩ := peek_VR hvars hp
  simp only [VR] at hv
  obtain ⟨hv, hir⟩ := hv
  rcases hv with ⟨-, e, he⟩ | ⟨ad, c, U, hws, hsto, hat, hFU, hmode, hini⟩
  · have he := Fd_nonmu he (fun b => by simp [cl])
    simp only [cl, clI_zero, Ty.array.injEq, Idx.lit.injEq] at he
    omega
  obtain rfl := Fd_nonmu hFU (fun b => by simp [cl])
  obtain ⟨w, rfl, hwv⟩ := map_singleton hws
  have hKm : ev ρ k ≤ modeIni μ η.ini η.rini ad.label := by
    simp only [IniR] at hir; have h := hir ad (by simp [hwv]); rw [TEnv.selIni_loc] at h; exact h
  have hJk : ev ρ j < modeIni μ η.ini η.rini ad.label := Nat.lt_of_lt_of_le (hltk ρ hsat) hKm
  simp only [cl, clI_zero] at hini
  have hlay := AtOff_lay hat
  simp only [cl, clI_zero] at hlay
  obtain ⟨us, hus⟩ : ∃ us, accs (cl ρ η.wit 0 0 u) = some us := by
    rcases hlay with h | ⟨n', e', he', h⟩
    · simp [accs] at h
    · simp only [Ty.array.injEq] at he'; rw [he'.2]
      exact Option.ne_none_iff_exists'.1 h
  have hat' : AtOff c.ty (ad.offset + (ev ρ j * nWords us + 0)) (cl ρ η.wit 0 0 u) := by
    refine AtOff_trans hat ?_
    simp only [cl, clI_zero]
    exact .elem hus hJ (.here (Or.inl (by rw [hus]; simp)))
  -- the runtime side: the element type, of the closed static width
  have hs' : etok (skel rt) = rf (.loc (skelM μ) (.array (.lit 0) (etok (skel (close σs u))))) := by
    rw [hl.2.1]; rfl
  obtain ⟨μr, ur, hbe, hμ, hsu⟩ := buf_runtime hs'
  have hbl := buf_lyt hl.2.2.2.2 hbe
  have htb := peek_tb htv hp
  simp only [tb] at htb
  have hsig : sig ur = sig (cl ρ η.wit 0 0 u) := by
    have e : sig ur = sig (close σs u) := sig_of_eskel hsu
    rw [e]; exact sig_WitL hW ρ hop (lt_of_guardT htb hK)
  have hwc := wc_of_sig hsig
  cases hus' : accs ur with
  | none => simp [wc, hus', hus] at hwc
  | some us' =>
      have hn : nWords us' = nWords us := by simpa [wc, hus, hus'] using hwc
      refine ⟨.loc μr ur, [{ w with val := .loc (offs ad (ev ρ j * nWords us')) 0 }], ?_, ?_, ?_⟩
      · simp [evalOp, hea, hei, hwi, hbe, hus', hwv, numOf, ol, pure]
      · simp only [VR]
        refine Or.inr ⟨offs ad (ev ρ j * nWords us'), c, _, by simp, by simpa [offs] using hsto, ?_, .refl,
          ModeOK_one (l := ad.label) (w := w) (by simp [offs]) (Nat.le_refl _) hmode, ?_⟩
        · simpa [offs, hn] using hat'
        · exact IniAt_idx hini hus hJk hJ hn
      · refine ⟨fun us h => by simp [accs] at h; subst h; rfl, ?_, by simp [wc, accs],
          Or.inr ⟨offs ad (ev ρ j * nWords us'), by simp⟩, lyt_loc_of hbl.1 hbl.2⟩
        show Ty.loc (skelM μr) (etok (skel ur)) = Ty.loc (skelM μ) (etok (skel (close σs u)))
        rw [hμ, hsu]

theorem idx_step {p : Prog} {cx c' : Cx} {x : String} {b i : At} {ρ : Nat → Nat} {η : TEnv}
    {σs : List Ty} {env : Env} {K : TEnv → List Word → Prop} {g : G} {s : St}
    (hT : OpT p cx x (.idx b i) c') (hi : FInv ρ η σs K cx env) (htv : TvOK cx) :
    ∃ rt ws, evalOp g env σs s (.idx b i) = [(s, rt, ws)] ∧ FInv ρ η σs K c' ((x, rt, ws) :: env) := by
  cases hT with
  | idxOwn hp hbuf hint hlt hltk hop hu hb =>
      obtain ⟨rt, ws, he, hv, hl⟩ :=
        idx_core (g := g) (s := s) hi.1 hi.2.1 hi.2.2.2.1 hi.2.2.2.2.1 htv hp hbuf hint hlt hltk hop
      exact ⟨rt, ws, he, bind_FInv hb (use_FInv hu hi).1 hv hl⟩
  | idxShared hp hbuf _ hint hlt hltk hop hb =>
      obtain ⟨rt, ws, he, hv, hl⟩ :=
        idx_core (g := g) (s := s) hi.1 hi.2.1 hi.2.2.2.1 hi.2.2.2.2.1 htv hp hbuf hint hlt hltk hop
      exact ⟨rt, ws, he, bind_FInv hb hi hv hl⟩

/-- **P1 + P4 at the thread, `idx`.** -/
theorem tstep_idx {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {b i : At} {e : Expr}
    (hterm : th.term = .let_ x (.idx b i) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvE p (CE η) r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
      rename_i c₁
      obtain ⟨rt, ws, hev, hf⟩ := idx_step (g := g) (s := stOf mem pairs th) hop hi htv
      have key : tstep g mem pairs th = (evalOp g th.env th.σs (stOf mem pairs th) (.idx b i)).map
          fun (s', t, ws) => (s'.mem, s'.pairs, withS { th with term := e, env := (x, t, ws) :: th.env } s') := by
        simp [tstep, hterm]
      rw [key, hev]
      refine ⟨by simp, ?_⟩
      intro r hr
      simp only [List.map_cons, List.map_nil, List.mem_singleton] at hr
      subst hr
      exact ⟨ρ, η, c₁, rfl, hE, he, OpT_TvOK hP hop htv, hf, retPw_skel hPS hRP (skel_subst_eq (OpT_retSk hop) th.σs 0 0 0)⟩

theorem tstepM_idx {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {b i : At} {e : Expr}
    (hterm : th.term = .let_ x (.idx b i) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  have hT' := hT
  rw [hterm] at hT'
  cases hT' with
  | let_ hop _ =>
      obtain ⟨rt, ws, hev, -⟩ := idx_step (g := g) (s := stOf mem pairs th) hop hi htv
      exact lift hm (tstep_idx hterm hP hT hi hE htv hRP hPS) (same_let hterm (fun _ _ _ _ h => by cases h)
        (fun _ _ h => by cases h) (fun r hr => by
          rw [hev, List.mem_singleton] at hr; subst hr; exact same_of_eq rfl))

end Idx

/-! ## §7 Reading a component of a cell through `μ` (T3c-5a-4) -/

section Unfold

/-- The coherent view whose witnesses are `W`: Σ, program and thread are `E`'s,
each variable's relation is its (closed) witness's values. -/
def envW (E : TEnv) (W : Nat → Ty) : TEnv :=
  { CE E with
    rels := fun k => (CE E).relC (W k)
    urels := fun k => (CE E).unsee.relC (W k)
    rrs := fun k => (CE E).relCR (W k)
    urrs := fun k => (CE E).unsee.relCR (W k)
    wit := W }

theorem CE_envW (E : TEnv) (W : Nat → Ty) : CE (envW E W) = CE E := rfl

theorem Coh_envW (E : TEnv) {W : Nat → Ty} (hW : ∀ k, Clo (W k)) : Coh (envW E W) := by
  intro k
  refine ⟨hW k, fun ρ' S ws => ?_, fun ρ' S ws => ?_⟩
  · show (CE E).relC (W k) S ws ↔ VR ρ' (CE E) (W k) S ws
    simp only [TEnv.relC]
    exact VR_clo (hW k) _ ρ' S ws
  · show (CE E).unsee.relC (W k) S ws ↔ VR ρ' (CE (CE E).unsee) (W k) S ws
    simp only [TEnv.relC]
    exact VR_clo (hW k) _ ρ' S ws

theorem CohR_envW (E : TEnv) {W : Nat → Ty} (hW : ∀ k, Clo (W k)) : CohR (envW E W) := by
  intro k
  refine ⟨fun ρ' S ws X => ?_, fun ρ' S ws X => ?_⟩
  · show (CE E).relCR (W k) S ws X ↔ VRR ρ' (CE E) (W k) S ws X
    simp only [TEnv.relCR]
    exact VRR_clo (hW k) _ ρ' S ws X
  · show (CE E).unsee.relCR (W k) S ws X ↔ VRR ρ' (CE (CE E).unsee) (W k) S ws X
    simp only [TEnv.relCR]
    exact VRR_clo (hW k) _ ρ' S ws X

/-- **`VR` at `μ` gives `VR` at its unfolding**, without guardedness: the
bound variable's relation is empty at `μ` and the `μ` type's values at the
unfolding. -/
theorem VR_mu_unfold {η : TEnv} {ρ : Nat → Nat} {b : Ty} {rt : Shp} {ws : List Word}
    (h : VR ρ η (.mu b) rt ws) : VR ρ η (unfold1 (.mu b)) rt ws := by
  have e1 : unfold1 (.mu b) = substTs [.mu b] 0 0 b := substT_eq (.mu b) b 0 0
  rw [e1]
  refine (VR_substTs [.mu b] η ρ b [] 0 ρ rt ws (fun _ => rfl)).2 ?_
  simp only [VR] at h
  refine VR_mono b (η.push0 (cl ρ η.wit 0 0 (.mu b))) _ ρ rt ws (fun k S vs hk => ?_) (fun k S vs hk => ?_) ?_
    rfl rfl (fun _ _ h => h) (fun _ => Nat.le_refl _) (fun _ _ h => h) (fun _ h => h) (fun _ _ h => h) h
  · cases k with
    | zero => simp [TEnv.push0, TEnv.ins, TEnv.insR] at hk
    | succ k => simpa [TEnv.pre, subE, TEnv.push0, TEnv.ins, TEnv.insR] using hk
  · cases k with
    | zero => simp [TEnv.push0, TEnv.ins, TEnv.insR] at hk
    | succ k => simpa [TEnv.pre, subE, TEnv.push0, TEnv.ins, TEnv.insR] using hk
  · funext k; cases k <;> simp [TEnv.pre, subE, TEnv.push0, TEnv.ins, TEnv.insR]

/-- The same on closures, at any closed witnesses: what a cell's `μ`-typed
component holds is a value of the closed unfolding. -/
theorem VR_cl_unfold (E : TEnv) {ρ ρ₀ : Nat → Nat} {W : Nat → Ty} (hW : ∀ k, Clo (W k)) {s : Ty}
    {R : Shp} {ws : List Word} (h : VR ρ₀ (CE E) (cl ρ W 0 0 (.mu s)) R ws) :
    VR ρ₀ (CE E) (cl ρ W 0 0 (unfold1 (.mu s))) R ws := by
  have hc := Coh_envW E hW
  have key : ∀ t, VR ρ (TEnv.pre [] (envW E W)) t R ws ↔
      VR ρ₀ (TEnv.pre [] (CE (envW E W))) (cl ρ (envW E W).wit ([] : List Ty).length 0 t) R ws :=
    fun t => VR_close hc ρ t [] 0 ρ ρ₀ R ws (fun _ => rfl) (fun _ hk => absurd hk (Nat.not_lt_zero _))
  exact (key _).1 (VR_mu_unfold ((key _).2 h))

/-- The guarded converse of `VR_cl_unfold`. -/
theorem VR_cl_fold (E : TEnv) {ρ ρ₀ : Nat → Nat} {W : Nat → Ty} (hW : ∀ k, Clo (W k)) {s : Ty}
    (hg : s.unguarded 0 = false) {R : Shp} {ws : List Word}
    (h : VR ρ₀ (CE E) (cl ρ W 0 0 (unfold1 (.mu s))) R ws) : VR ρ₀ (CE E) (cl ρ W 0 0 (.mu s)) R ws := by
  have hc := Coh_envW E hW
  have key : ∀ t, VR ρ (TEnv.pre [] (envW E W)) t R ws ↔
      VR ρ₀ (TEnv.pre [] (CE (envW E W))) (cl ρ (envW E W).wit ([] : List Ty).length 0 t) R ws :=
    fun t => VR_close hc ρ t [] 0 ρ ρ₀ R ws (fun _ => rfl) (fun _ hk => absurd hk (Nat.not_lt_zero _))
  exact (key _).1 ((VR_unfold hg R ws).1 ((key _).2 h))

theorem er_rf_congr {x y : Ty} (h : er x = er y) : er (rf x) = er (rf y) := by
  by_cases hx : x = .int
  · subst hx
    have : y = .int := by cases y <;> simp_all [er]
    subst this; rfl
  · by_cases hy : y = .int
    · subst hy; exfalso; cases x <;> simp_all [er]
    · have e1 : rf x = .refine x .tt := by cases x <;> simp_all [rf]
      have e2 : rf y = .refine y .tt := by cases y <;> simp_all [rf]
      rw [e1, e2]; simp [er, h]

/-- **`sig` does not see a guarded variable** (`er` erases pointees and code
signatures, the only guards): closing at `X` for variable `c` has the `sig` of
leaving it open. -/
theorem sig_cl_guard {ρ : Nat → Nat} {W W' : Nat → Ty} (hW : ∀ k, W' (k + 1) = W k) :
    ∀ (t : Ty) (c d : Nat), t.unguarded c = false → sig (cl ρ W' c d t) = sig (cl ρ W (c + 1) d t) := by
  intro t
  induction t with
  | tvar k =>
      intro c d hg
      have hk : k ≠ c := by simpa [Ty.unguarded] using hg
      by_cases h1 : k < c
      · simp [cl, h1, show k < c + 1 by omega]
      · have h2 : ¬ k < c + 1 := by omega
        have e : k - c = (k - (c + 1)) + 1 := by omega
        simp only [cl, h1, h2, ite_false]; rw [e, hW]
  | prod a b iha ihb =>
      intro c d hg
      simp only [Ty.unguarded, Bool.or_eq_false_iff] at hg
      have h1 := iha c d hg.1; have h2 := ihb c d hg.2
      simp only [sig, cl, skel, er] at h1 h2 ⊢; rw [h1, h2]
  | sum a b iha ihb =>
      intro c d hg
      simp only [Ty.unguarded, Bool.or_eq_false_iff] at hg
      have h1 := iha c d hg.1; have h2 := ihb c d hg.2
      simp only [sig, cl, skel, er] at h1 h2 ⊢; rw [h1, h2]
  | array i t ih =>
      intro c d hg
      have h1 := ih c d (by simpa [Ty.unguarded] using hg)
      simp only [sig, cl, skel, er] at h1 ⊢; rw [h1]
  | iall t ih =>
      intro c d hg
      have h1 := ih c (d + 1) (by simpa [Ty.unguarded] using hg)
      simp only [sig, cl, skel, er] at h1 ⊢; rw [h1]
  | iex t ih =>
      intro c d hg
      have h1 := ih c (d + 1) (by simpa [Ty.unguarded] using hg)
      simp only [sig, cl, skel, er] at h1 ⊢; rw [h1]
  | mu t ih =>
      intro c d hg
      have h1 := ih (c + 1) d (by simpa [Ty.unguarded] using hg)
      simp only [sig, cl, skel, er] at h1 ⊢; rw [h1]
  | tex κ t ih =>
      intro c d hg
      have h1 := ih (c + 1) d (by simpa [Ty.unguarded] using hg)
      simp only [sig, cl, skel, er] at h1 ⊢; rw [h1]
  | refine t ψ ih =>
      intro c d hg
      have h1 := ih c d (by simpa [Ty.unguarded] using hg)
      simp only [sig, cl, skel] at h1 ⊢
      exact er_rf_congr h1
  | _ => intro c d _; simp [sig, cl, skel, er]

/-- **The closed unfolding has the closed body's `sig`**, for a guarded body:
so the same shape, word count and encoding validity. -/
theorem sig_cl_unfold {ρ : Nat → Nat} {W : Nat → Ty} {s : Ty} (hg : s.unguarded 0 = false) :
    sig (cl ρ W 0 0 (unfold1 (.mu s))) = sig (cl ρ W 1 0 s) := by
  have e1 : unfold1 (.mu s) = substTs [.mu s] 0 0 s := substT_eq (.mu s) s 0 0
  have e2 := cl_substTs [.mu s] 0 0 (ρ := ρ) (W₀ := W) (W₁ := wcons (cl ρ W 0 0 (.mu s)) W)
    (fun k hk => absurd hk (Nat.not_lt_zero _))
    (fun j σ hj => by
      cases j with
      | zero => simp at hj; subst hj; simp [wcons]
      | succ j => simp at hj)
    (fun k => by simp [wcons]) s 0 0
  simp only [Nat.add_zero] at e2
  rw [e1, e2]
  exact sig_cl_guard (fun k => by simp [wcons]) s 0 0 hg

end Unfold

/-! ### (T3c-5h) A folded reference's cell -/

/-- `Fd` keeps the layout: shape, width and validity. -/
theorem Fd_lay {T U : Ty} (h : Fd T U) :
    shp T = shp U ∧ wc T = wc U ∧ accs T = accs U ∧ ∀ ws, Valid T ws ↔ Valid U ws := by
  induction h with
  | refl => exact ⟨rfl, rfl, rfl, fun _ => Iff.rfl⟩
  | @fold ρ W s T hW hg hae _ ih =>
      have hsig := sig_cl_unfold (ρ := ρ) (W := W) hg
      have e1 : cl ρ W 0 0 (.mu s) = .mu (cl ρ W 1 0 s) := rfl
      obtain ⟨h1, h2, h4, h3⟩ := ih
      refine ⟨?_, ?_, h4.trans hae, fun ws => (h3 ws).trans ⟨fun hv => ?_, fun hv => ?_⟩⟩
      · rw [h1, shp_of_sig hsig, e1]; rfl
      · rw [h2, wc_of_sig hsig, e1]; rfl
      · rw [e1]; show Valid (cl ρ W 1 0 s) ws; exact Valid_of_sig hsig hv
      · rw [e1] at hv; exact Valid_of_sig hsig.symm hv

/-- `Fd` keeps the values (on any shape). -/
theorem Fd_VR (E : TEnv) {ρ₀ : Nat → Nat} {T U : Ty} (h : Fd T U) {R : Shp} {ws : List Word} :
    VR ρ₀ (CE E) T R ws ↔ VR ρ₀ (CE E) U R ws := by
  induction h with
  | refl => exact Iff.rfl
  | fold hW hg _ _ ih => exact ih.trans ⟨VR_cl_fold E hW hg, VR_cl_unfold E hW⟩

theorem Fd_EnvVal (E : TEnv) {T U : Ty} (h : Fd T U) {ws : List Word} : EnvVal E T ws ↔ EnvVal E U ws := by
  obtain ⟨h1, -, -, h3⟩ := Fd_lay h
  unfold EnvVal; rw [h1]; exact and_congr (Fd_VR E h) (h3 ws)

/-- A folded type tears as its folding does. -/
theorem TearOK_Fd {T U : Ty} (h : Fd T U) (hU : TearOK U) : TearOK T := by
  intro E us k ws1 ws2 hu hb h1 h2 l1 l2
  obtain ⟨hs, -, ha, -⟩ := Fd_lay h
  rw [hs] at h1 h2 ⊢
  exact (Fd_VR E h).2 (hU E us k ws1 ws2 (by rw [← ha]; exact hu) hb ((Fd_VR E h).1 h1) ((Fd_VR E h).1 h2) l1 l2)

/-! ### (F2) Moved up: torn reads of a cell, for the owner's frontier loads -/

theorem hiddenFrom_mono {mem : Memory} {a : Address} {t V V' : Ts} (hV : V ≤ V')
    (h : WeakMem.hiddenFrom mem a t V' = false) : WeakMem.hiddenFrom mem a t V = false := by
  unfold WeakMem.hiddenFrom at h ⊢
  rw [List.any_eq_false] at h ⊢
  intro x hx hc
  exact h x (List.mem_range.2 (Nat.lt_of_lt_of_le (List.mem_range.1 hx) (Nat.succ_le_succ hV))) hc

/-- A load's bound is past its address register's view. -/
theorem view_le_bound (arch : Arch) (s : St) (pw : Word) (vs : VState) (b : Address) :
    pw.view ≤ Promises.readBoundOf arch vs (Promises.depBound (mth s pw pw pw).regs [0]) b := by
  have h1 : pw.view ≤ Promises.depBound (mth s pw pw pw).regs [0] := by
    simp [Promises.depBound, Promises.depView, Promises.depRts, mth, regsOf]; exact Nat.le_max_left _ _
  simp only [Promises.readBoundOf]
  exact Nat.le_trans h1 (Nat.le_trans (Nat.le_max_right _ _)
    (Nat.le_trans (Nat.le_max_left _ _) (Nat.le_max_left _ _)))

theorem Latest_congr {mem : Memory} {coh coh' : Address → Ts} {a : Address} {v : Word}
    (h : coh' a = coh a) (hl : Latest mem coh a v) : Latest mem coh' a v := by
  unfold Latest at hl ⊢; rw [h]; exact hl

/-- An address with a message has a latest one. -/
theorem exists_latest {mem : Memory} {a : Address} :
    ∀ (n t : Nat) (m : Msg), mem.size - t ≤ n → mem[t]? = some m → m.loc = a →
      ∃ (t' : Nat) (m' : Msg), Latest mem (fun _ => t') a (mw m')
  | 0, t, m, hn, hm, _ => absurd (lt_of_get hm) (by omega)
  | n + 1, t, m, hn, hm, hl => by
    by_cases hx : ∃ (t' : Nat) (m' : Msg), t < t' ∧ mem[t']? = some m' ∧ m'.loc = a
    · obtain ⟨t', m', h1, h2, h3⟩ := hx
      exact exists_latest n t' m' (by omega) h2 h3
    · exact ⟨t, m, ⟨m, hm, hl, rfl, fun _ _ _ => Nat.le_refl _⟩,
        fun t' m' h1 h2 h3 => hx ⟨t', m', h1, h2, h3⟩⟩

/-- **A load of words that all have messages has an outcome** (progress for
loads of another thread's cell). -/
theorem loadUnits_nonemptyL {arch : Arch} {pw : Word} {a : Address} {acq : Bool} :
    ∀ (us : List Acc) (k : Nat) (s : St),
      (∀ j, j < nWords us → ∃ (t : Nat) (m : Msg), s.mem[t]? = some m ∧ m.loc = offs a (k + j)) →
      ∃ r, r ∈ loadUnits arch pw a acq us k s
  | [], k, s, _ => ⟨(s, []), by simp [loadUnits]⟩
  | .one :: us, k, s, hl => by
      obtain ⟨t0, m0, h1, h2⟩ := hl 0 (by simp [nWords, Acc.size]; omega)
      obtain ⟨t, m, hlt⟩ := exists_latest (a := offs a k) _ t0 m0 (Nat.le_refl _) h1 (by simpa using h2)
      obtain ⟨hr, hlt'⟩ := readable_of_latest
        (Promises.readBoundOf arch s.vs (Promises.depBound (mth s pw pw pw).regs [0]) (offs a k)) hlt
      have hx : ∃ th, th ∈ Promises.stepLoad arch s.mem s.pairs (mth s pw pw pw) 1 (offs a k) [0] acq :=
        ⟨_, List.mem_map_of_mem (List.mem_filter.2 ⟨List.mem_range.2 hlt', hr⟩)⟩
      obtain ⟨th, hth⟩ := hx
      obtain ⟨⟨s', ws⟩, hmem⟩ := loadUnits_nonemptyL (arch := arch) (pw := pw) (a := a) (acq := acq) us (k + 1)
        { s with vs := th.vs, undefs := s.undefs + countUndef [th.regs 1] }
        (fun j hj => by
          obtain ⟨t', m', h1', h2'⟩ := hl (j + 1) (by simp [nWords, Acc.size] at hj ⊢; omega)
          exact ⟨t', m', h1', by rw [h2']; congr 1; omega⟩)
      exact ⟨_, by
        simp only [loadUnits, List.mem_flatMap, List.mem_map]
        exact ⟨th, hth, (s', ws), hmem, rfl⟩⟩
  | .two :: us, k, s, hl => by
      obtain ⟨t0, m0, h1, h2⟩ := hl 0 (by simp [nWords, Acc.size]; omega)
      obtain ⟨t1, m1, h1', h2'⟩ := hl 1 (by simp [nWords, Acc.size]; omega)
      have hnx : (offs a k).next = offs a (k + 1) := by simp [offs, WeakMem.Address.next, Nat.add_assoc]
      obtain ⟨ta, ma, hla⟩ := exists_latest (a := offs a k) _ t0 m0 (Nat.le_refl _) h1 (by simpa using h2)
      obtain ⟨tb, mb, hlb⟩ := exists_latest (a := (offs a k).next) _ t1 m1 (Nat.le_refl _) h1'
        (by rw [hnx]; exact h2')
      have hne : (offs a k).next ≠ offs a k := by simp [offs, WeakMem.Address.next]
      have hla' : Latest s.mem (fun b => if b = offs a k then ta else tb) (offs a k) (mw ma) :=
        Latest_congr (by simp) hla
      have hlb' : Latest s.mem (fun b => if b = offs a k then ta else tb) (offs a k).next (mw mb) :=
        Latest_congr (by simp [hne]) hlb
      obtain ⟨hr0, hlt0⟩ := readable_of_latest
        (Promises.readBoundOf arch s.vs (Promises.depBound (mth s pw pw pw).regs [0]) (offs a k)) hla'
      obtain ⟨hr1, hlt1⟩ := readable_of_latest
        (Promises.readBoundOf arch s.vs (Promises.depBound (mth s pw pw pw).regs [0]) (offs a k).next) hlb'
      have hns := noStraddle_latest (pairs := s.pairs) hla' hlb'
      have hx : ∃ th, th ∈ Promises.stepLoadPair arch s.mem s.pairs (mth s pw pw pw) 1 2 (offs a k) [0] acq := by
        simp only [Promises.stepLoadPair, List.mem_flatMap, List.mem_filterMap, List.mem_filter,
          List.mem_range]
        exact ⟨_, _, ⟨hlt0, hr0⟩, _, ⟨hlt1, hr1⟩, by simp only [mth] at hns ⊢; rw [hns]; rfl⟩
      obtain ⟨th, hth⟩ := hx
      obtain ⟨⟨s', ws⟩, hmem⟩ := loadUnits_nonemptyL (arch := arch) (pw := pw) (a := a) (acq := acq) us (k + 2)
        { s with vs := th.vs, undefs := s.undefs + countUndef [th.regs 1, th.regs 2] }
        (fun j hj => by
          obtain ⟨t', m', h1'', h2''⟩ := hl (j + 2) (by simp [nWords, Acc.size] at hj ⊢; omega)
          exact ⟨t', m', h1'', by rw [h2'']; congr 1; omega⟩)
      exact ⟨_, by
        simp only [loadUnits, List.mem_flatMap, List.mem_map]
        exact ⟨th, hth, (s', ws), hmem, rfl⟩⟩

theorem take_drop_take {α : Type} {ws : List α} {m o n : Nat} (h : o + n ≤ m) :
    ((ws.take m).drop o).take n = (ws.drop o).take n := by
  rw [List.drop_take, List.take_take]; congr 1; omega

theorem drop_drop' {α : Type} (ws : List α) (a b : Nat) : (ws.drop a).drop b = ws.drop (a + b) := by
  rw [List.drop_drop]; try rw [Nat.add_comm]

/-- **A component's words**: a value of a laid-out type holds, at offset `o`
along an `AtOff` path, a value of the component type on its word count. -/
theorem VR_at (E : TEnv) {ρ₀ : Nat → Nat} {T U : Ty} {o : Nat} (h : AtOff T o U) :
    ∀ {ws : List Word}, VR ρ₀ (CE E) T (shp T) ws → Valid T ws → wc T = some ws.length →
      ∃ n, wc U = some n ∧ o + n ≤ ws.length ∧
        VR ρ₀ (CE E) U (shp U) ((ws.drop o).take n) ∧ Valid U ((ws.drop o).take n) := by
  induction h with
  | here _ =>
      intro ws hv hV hwc
      have e : (ws.drop 0).take ws.length = ws := by simp
      refine ⟨ws.length, hwc, by omega, ?_, ?_⟩ <;> rw [e] <;> assumption
  | @fst a b u o _ ih =>
      intro ws hv hV hwc
      simp only [VR] at hv; simp only [Valid] at hV
      obtain ⟨ra, rb, e, hsplit⟩ := hv
      simp only [shp, Shp.prod.injEq] at e
      obtain ⟨rfl, rfl⟩ := e
      cases ha : accs a with
      | none => simp [wc, accs, ha] at hwc
      | some ua =>
      cases hb : accs b with
      | none => simp [wc, accs, ha, hb] at hwc
      | some ub =>
      have hwa : wc a = some (nWords ua) := by simp [wc, ha]
      have hlen : ws.length = nWords ua + nWords ub := by
        simp [wc, accs, ha, hb, nWords_append] at hwc; omega
      obtain ⟨_, hva, _⟩ := hsplit _ (by rw [shp_wc]; exact hwa)
      obtain ⟨hVa, _⟩ := hV _ hwa
      have hla : (ws.take (nWords ua)).length = nWords ua := by simp; omega
      obtain ⟨n, hwu, hle, hvu, hVu⟩ := ih hva hVa (by rw [hla]; exact hwa)
      rw [hla] at hle
      rw [take_drop_take hle] at hvu hVu
      exact ⟨n, hwu, by omega, hvu, hVu⟩
  | @snd a b u o ua0 hua _ ih =>
      intro ws hv hV hwc
      simp only [VR] at hv; simp only [Valid] at hV
      obtain ⟨ra, rb, e, hsplit⟩ := hv
      simp only [shp, Shp.prod.injEq] at e
      obtain ⟨rfl, rfl⟩ := e
      cases hb : accs b with
      | none => simp [wc, accs, hua, hb] at hwc
      | some ub =>
      have hwa : wc a = some (nWords ua0) := by simp [wc, hua]
      have hwb : wc b = some (nWords ub) := by simp [wc, hb]
      have hlen : ws.length = nWords ua0 + nWords ub := by
        simp [wc, accs, hua, hb, nWords_append] at hwc; omega
      obtain ⟨_, _, hvb⟩ := hsplit _ (by rw [shp_wc]; exact hwa)
      obtain ⟨_, hVb⟩ := hV _ hwa
      have hlb : (ws.drop (nWords ua0)).length = nWords ub := by simp; omega
      obtain ⟨n, hwu, hle, hvu, hVu⟩ := ih hvb hVb (by rw [hlb]; exact hwb)
      rw [hlb] at hle
      rw [drop_drop'] at hvu hVu
      exact ⟨n, hwu, by omega, hvu, hVu⟩
  | elem _ _ _ _ => intro ws _ _ hwc; simp [wc, accs] at hwc
  | @mu ρ W s u o hW hg _ ih =>
      intro ws hv hV hwc
      have hsig := sig_cl_unfold (ρ := ρ) (W := W) hg
      have e1 : cl ρ W 0 0 (.mu s) = .mu (cl ρ W 1 0 s) := rfl
      have hshp : shp (cl ρ W 0 0 (unfold1 (.mu s))) = shp (cl ρ W 0 0 (.mu s)) := by
        rw [shp_of_sig hsig, e1]; rfl
      have hv' := VR_cl_unfold E hW hv
      rw [← hshp] at hv'
      have hV0 : Valid (cl ρ W 1 0 s) ws := by rw [e1] at hV; exact hV
      have hwc' : wc (cl ρ W 0 0 (unfold1 (.mu s))) = some ws.length := by
        rw [wc_of_sig hsig, ← hwc, e1]; rfl
      exact ih hv' (Valid_of_sig hsig.symm hV0) hwc'
  | @fold ρ W s T o hW hg ha _ ih =>
      intro ws hv hV hwc
      obtain ⟨n, hn, hle, hv', hV'⟩ := ih hv hV hwc
      have hsig := sig_cl_unfold (ρ := ρ) (W := W) hg
      have e1 : cl ρ W 0 0 (.mu s) = .mu (cl ρ W 1 0 s) := rfl
      have hshp : shp (cl ρ W 0 0 (unfold1 (.mu s))) = shp (cl ρ W 0 0 (.mu s)) := by
        rw [shp_of_sig hsig, e1]; rfl
      refine ⟨n, ?_, hle, ?_, ?_⟩
      · rw [← hn, wc_of_sig hsig, e1]; rfl
      · rw [← hshp]; exact VR_cl_fold E hW hg hv'
      · rw [e1]; show Valid (cl ρ W 1 0 s) _; exact Valid_of_sig hsig hV'

/-- (T3c-5b) Slices and splices of a cell's words. -/
theorem iteT {α : Type} {c : Prop} [Decidable c] {a b : α} (h : c) : (if c then a else b) = a := by
  simp [h]

theorem iteF {α : Type} {c : Prop} [Decidable c] {a b : α} (h : ¬c) : (if c then a else b) = b := by
  simp [h]

theorem slice_get {α : Type} (L : List α) (d w i : Nat) :
    ((L.drop d).take w)[i]? = if i < w then L[d + i]? else none := by
  by_cases h : i < w
  · rw [iteT h, List.getElem?_take_of_lt h, List.getElem?_drop]
  · rw [iteF h, List.getElem?_eq_none]; simp only [List.length_take, List.length_drop]; omega

theorem splice_get {α : Type} (L q : List α) (b n i : Nat) (hq : q.length = n) (h : b + n ≤ L.length) :
    (L.take b ++ q ++ L.drop (b + n))[i]? = if b ≤ i ∧ i < b + n then q[i - b]? else L[i]? := by
  have hA : (L.take b).length = b := by simp only [List.length_take]; omega
  by_cases h1 : i < b
  · rw [iteF (by omega), List.append_assoc, List.getElem?_append_left (by rw [hA]; exact h1),
      List.getElem?_take_of_lt h1]
  · by_cases h2 : i < b + n
    · rw [iteT ⟨by omega, h2⟩, List.append_assoc, List.getElem?_append_right (by rw [hA]; omega), hA,
        List.getElem?_append_left (by omega)]
    · rw [iteF (by omega), List.getElem?_append_right (by simp only [List.length_append, hA]; omega)]
      simp only [List.length_append, hA, List.getElem?_drop, hq]
      congr 1; omega

-- (F2) Moved up: needed by `AtOff_embed` (Block B).
theorem info_sig (t : Ty) : info Ty.top (sig t) = info Ty.top t := by
  rw [sig, info_er (skel t) Ty.top (fun _ => rfl), info_skel]

theorem tier_of_sig {a b : Ty} (h : sig a = sig b) : a.tier = b.tier := by
  simp only [Ty.tier, ← info_sig a, h, info_sig]

theorem rawWords_of_sig {a b : Ty} (h : sig a = sig b) : a.rawWords = b.rawWords := by
  have ha : info Ty.top (sig a) = info Ty.top a := by
    simp only [sig]; rw [info_er _ Ty.top (fun _ => rfl), info_skel]
  have hb : info Ty.top (sig b) = info Ty.top b := by
    simp only [sig]; rw [info_er _ Ty.top (fun _ => rfl), info_skel]
  simp only [Ty.rawWords, Ty.width]; rw [← ha, ← hb, h]

section Agree
variable {ρ : Nat → Nat} {W W' : Nat → Ty}

theorem idxM_cl_agree (hW : ∀ k, W' (k + 1) = W k) (hX : ∀ m, (W' 0).idxMentions m = false) :
    ∀ (t : Ty) (c d k : Nat), (cl ρ W' c d t).idxMentions k = (cl ρ W (c + 1) d t).idxMentions k := by
  intro t
  induction t with
  | tvar j =>
      intro c d k
      by_cases h1 : j < c
      · simp [cl, h1, show j < c + 1 by omega]
      · by_cases h2 : j = c
        · subst h2; simp [cl, hX, Ty.idxMentions]
        · have h3 : ¬ j < c + 1 := by omega
          have h4 : j - c = (j - (c + 1)) + 1 := by omega
          simp only [cl, h1, h3, ite_false]; rw [h4, hW]
  | _ => intro c d k; simp_all [cl, Ty.idxMentions]

theorem tyM_cl_agree (hW : ∀ k, W' (k + 1) = W k) (hX : ∀ m, (W' 0).tyMentions m = false) :
    ∀ (t : Ty) (c d k : Nat), k < c → (cl ρ W' c d t).tyMentions k = (cl ρ W (c + 1) d t).tyMentions k := by
  intro t
  induction t with
  | tvar j =>
      intro c d k hk
      by_cases h1 : j < c
      · simp [cl, h1, show j < c + 1 by omega]
      · by_cases h2 : j = c
        · subst h2; simp [cl, hX, Ty.tyMentions]; omega
        · have h3 : ¬ j < c + 1 := by omega
          have h4 : j - c = (j - (c + 1)) + 1 := by omega
          simp only [cl, h1, h3, ite_false]; rw [h4, hW]
  | mu t ih => intro c d k hk; simp only [cl, Ty.tyMentions]; exact ih (c + 1) d (k + 1) (by omega)
  | tex κ t ih => intro c d k hk; simp only [cl, Ty.tyMentions]; exact ih (c + 1) d (k + 1) (by omega)
  | prod a b iha ihb => intro c d k hk; simp only [cl, Ty.tyMentions, iha c d k hk, ihb c d k hk]
  | sum a b iha ihb => intro c d k hk; simp only [cl, Ty.tyMentions, iha c d k hk, ihb c d k hk]
  | code a b _ iha ihb => intro c d k hk; simp only [cl, Ty.tyMentions, iha c d k hk, ihb c d k hk]
  | array i t ih => intro c d k hk; simp only [cl, Ty.tyMentions, ih c d k hk]
  | ptr μ t ih => intro c d k hk; simp only [cl, Ty.tyMentions, ih c d k hk]
  | ptrOpt μ t ih => intro c d k hk; simp only [cl, Ty.tyMentions, ih c d k hk]
  | loc μ t ih => intro c d k hk; simp only [cl, Ty.tyMentions, ih c d k hk]
  | refine t ψ ih => intro c d k hk; simp only [cl, Ty.tyMentions, ih c d k hk]
  | iall t ih => intro c d k hk; simp only [cl, Ty.tyMentions, ih c (d + 1) k hk]
  | iex t ih => intro c d k hk; simp only [cl, Ty.tyMentions, ih c (d + 1) k hk]
  | _ => intro c d k _; simp [cl, Ty.tyMentions]

theorem countT_cl_agree (hW : ∀ k, W' (k + 1) = W k) (hX : ∀ m, (W' 0).tyMentions m = false) :
    ∀ (t : Ty) (c d k : Nat), k < c → (cl ρ W' c d t).countT k = (cl ρ W (c + 1) d t).countT k := by
  have hm := tyM_cl_agree (ρ := ρ) hW hX
  intro t
  induction t with
  | tvar j =>
      intro c d k hk
      by_cases h1 : j < c
      · simp [cl, h1, show j < c + 1 by omega]
      · by_cases h2 : j = c
        · subst h2; simp only [cl, h1, Nat.lt_succ_self, ite_true, ite_false, Nat.sub_self]
          rw [countT_zero _ k (hX k)]; simp [Ty.countT, Ty.tyMentions]; omega
        · have h3 : ¬ j < c + 1 := by omega
          have h4 : j - c = (j - (c + 1)) + 1 := by omega
          simp only [cl, h1, h3, ite_false]; rw [h4, hW]
  | prod a b iha ihb => intro c d k hk; simp only [cl, Ty.countT, iha c d k hk, ihb c d k hk]
  | refine t ψ ih => intro c d k hk; simp only [cl, Ty.countT, ih c d k hk]
  | iall t ih => intro c d k hk; simp only [cl, Ty.countT, ih c (d + 1) k hk]
  | iex t ih => intro c d k hk; simp only [cl, Ty.countT, ih c (d + 1) k hk]
  | tex κ t ih => intro c d k hk; simp only [cl, Ty.countT, ih (c + 1) d (k + 1) (by omega)]
  | mu t ih =>
      intro c d k hk
      simp only [cl, Ty.countT, ih (c + 1) d (k + 1) (by omega), ih (c + 1) d 0 (by omega),
        hm t (c + 1) d (k + 1) (by omega)]
  | sum a b _ _ => intro c d k hk; have := hm (.sum a b) c d k hk; simp only [cl] at this; simp only [cl, Ty.countT, this]
  | code a b kc _ _ => intro c d k hk; have := hm (.code a b kc) c d k hk; simp only [cl] at this; simp only [cl, Ty.countT, this]
  | array i t _ => intro c d k hk; have := hm (.array i t) c d k hk; simp only [cl] at this; simp only [cl, Ty.countT, this]
  | ptr μ t _ => intro c d k hk; have := hm (.ptr μ t) c d k hk; simp only [cl] at this; simp only [cl, Ty.countT, this]
  | ptrOpt μ t _ => intro c d k hk; have := hm (.ptrOpt μ t) c d k hk; simp only [cl] at this; simp only [cl, Ty.countT, this]
  | loc μ t _ => intro c d k hk; have := hm (.loc μ t) c d k hk; simp only [cl] at this; simp only [cl, Ty.countT, this]
  | _ => intro c d k _; simp [cl, Ty.countT, Ty.tyMentions]

theorem countI_cl_agree (hW : ∀ k, W' (k + 1) = W k) (hXT : ∀ m, (W' 0).tyMentions m = false)
    (hXI : ∀ m, (W' 0).idxMentions m = false) :
    ∀ (t : Ty) (c d k : Nat), (cl ρ W' c d t).countI k = (cl ρ W (c + 1) d t).countI k := by
  have hm := idxM_cl_agree (ρ := ρ) hW hXI
  have hT := countT_cl_agree (ρ := ρ) hW hXT
  intro t
  induction t with
  | tvar j =>
      intro c d k
      by_cases h1 : j < c
      · simp [cl, h1, show j < c + 1 by omega]
      · by_cases h2 : j = c
        · subst h2; simp only [cl, h1, Nat.lt_succ_self, ite_true, ite_false, Nat.sub_self]
          rw [countI_zero _ k (hXI k)]; simp [Ty.countI, Ty.idxMentions]
        · have h3 : ¬ j < c + 1 := by omega
          have h4 : j - c = (j - (c + 1)) + 1 := by omega
          simp only [cl, h1, h3, ite_false]; rw [h4, hW]
  | prod a b iha ihb => intro c d k; simp only [cl, Ty.countI, iha c d k, ihb c d k]
  | refine t ψ ih => intro c d k; simp only [cl, Ty.countI, ih c d k]
  | iall t ih => intro c d k; simp only [cl, Ty.countI, ih c (d + 1) (k + 1)]
  | iex t ih => intro c d k; simp only [cl, Ty.countI, ih c (d + 1) (k + 1)]
  | tex κ t ih => intro c d k; simp only [cl, Ty.countI, ih (c + 1) d k]
  | mu t ih =>
      intro c d k
      simp only [cl, Ty.countI, ih (c + 1) d k, hT t (c + 1) d 0 (by omega), hm t (c + 1) d k]
  | _ =>
      intro c d k
      first
        | (simp only [cl, Ty.countI]; done)
        | (rename_i a b _ _; have := hm (.sum a b) c d k; simp only [cl] at this; simp only [cl, Ty.countI, this]; done)
        | (rename_i a b kc _ _; have := hm (.code a b kc) c d k; simp only [cl] at this; simp only [cl, Ty.countI, this]; done)
        | (rename_i i t _; have := hm (.array i t) c d k; simp only [cl] at this; simp only [cl, Ty.countI, this]; done)
        | (rename_i μ t _; have := hm (.ptr μ t) c d k; simp only [cl] at this; simp only [cl, Ty.countI, this]; done)
        | (rename_i μ t _; have := hm (.ptrOpt μ t) c d k; simp only [cl] at this; simp only [cl, Ty.countI, this]; done)
        | (rename_i μ t _; have := hm (.loc μ t) c d k; simp only [cl] at this; simp only [cl, Ty.countI, this]; done)
        | simp [cl, Ty.countI, Ty.idxMentions]

/-- **`accs` does not see a guarded variable** (cf. `sig_cl_guard`): closing it
at a closed `X` lays out as leaving it open. -/
theorem accs_cl_guard (hW : ∀ k, W' (k + 1) = W k) (hXT : ∀ m, (W' 0).tyMentions m = false)
    (hXI : ∀ m, (W' 0).idxMentions m = false) :
    ∀ (t : Ty) (c d : Nat), t.unguarded c = false → accs (cl ρ W' c d t) = accs (cl ρ W (c + 1) d t) := by
  have hI := countI_cl_agree (ρ := ρ) hW hXT hXI
  have hT := countT_cl_agree (ρ := ρ) hW hXT
  intro t
  induction t with
  | tvar j =>
      intro c d hg
      have hk : j ≠ c := by simpa [Ty.unguarded] using hg
      by_cases h1 : j < c
      · simp [cl, h1, show j < c + 1 by omega]
      · have h2 : ¬ j < c + 1 := by omega
        have e : j - c = (j - (c + 1)) + 1 := by omega
        simp only [cl, h1, h2, ite_false]; rw [e, hW]
  | prod a b iha ihb =>
      intro c d hg
      simp only [Ty.unguarded, Bool.or_eq_false_iff] at hg
      simp only [cl, accs, iha c d hg.1, ihb c d hg.2]
  | refine t ψ ih => intro c d hg; simp only [cl, accs]; exact ih c d (by simpa [Ty.unguarded] using hg)
  | iall t ih => intro c d hg; simp only [cl, accs]; exact ih c (d + 1) (by simpa [Ty.unguarded] using hg)
  | mu t ih => intro c d hg; simp only [cl, accs]; exact ih (c + 1) d (by simpa [Ty.unguarded] using hg)
  | iex t ih =>
      intro c d hg
      have hr := rawWords_of_sig (sig_cl_guard (ρ := ρ) hW (.iex t) c d hg)
      have hb := ih c (d + 1) (by simpa [Ty.unguarded] using hg)
      simp only [cl] at hr
      simp only [cl, accs, hr, hb, hI t c (d + 1) 0]
  | tex κ t ih =>
      intro c d hg
      have hr := rawWords_of_sig (sig_cl_guard (ρ := ρ) hW (.tex κ t) c d hg)
      have hb := ih (c + 1) d (by simpa [Ty.unguarded] using hg)
      simp only [cl] at hr
      simp only [cl, accs, hr, hb, hT t (c + 1) d 0 (by omega)]
  | sum a b _ _ =>
      intro c d hg
      have ht := tier_of_sig (sig_cl_guard (ρ := ρ) hW (.sum a b) c d hg)
      simp only [cl] at ht
      simp only [cl, accs, ht]
  | _ => intro c d _; simp [cl, accs]

end Agree

theorem Clo_cl0 {ρ : Nat → Nat} {W : Nat → Ty} (hW : ∀ k, Clo (W k)) (t : Ty) :
    (∀ m, (cl ρ W 0 0 t).tyMentions m = false) ∧ (∀ m, (cl ρ W 0 0 t).idxMentions m = false) := by
  constructor
  · intro m
    cases h : (cl ρ W 0 0 t).tyMentions m
    · rfl
    · have := (TermSound.CoupledCl.tyMentions_cl ρ W (fun j m => TermSound.CoupledCl.Clo_tyMentions (hW j) m) t 0 0 m h).1; omega
  · intro m
    cases h : (cl ρ W 0 0 t).idxMentions m
    · rfl
    · have := (TermSound.CoupledCl.idxMentions_cl ρ W (fun j m => TermSound.CoupledCl.Clo_idxMentions (hW j) m) t 0 0 m h).1; omega

/-- **Unfolding a closed guarded `μ` type keeps its layout**, exactly. -/
theorem accs_cl_unfold_eq {ρ : Nat → Nat} {W : Nat → Ty} (hW : ∀ k, Clo (W k)) {s : Ty}
    (hg : s.unguarded 0 = false) : accs (cl ρ W 0 0 (unfold1 (.mu s))) = accs (cl ρ W 0 0 (.mu s)) := by
  have e1 : unfold1 (.mu s) = substTs [.mu s] 0 0 s := substT_eq (.mu s) s 0 0
  have e2 := cl_substTs [.mu s] 0 0 (ρ := ρ) (W₀ := W) (W₁ := wcons (cl ρ W 0 0 (.mu s)) W)
    (fun k hk => absurd hk (Nat.not_lt_zero _))
    (fun j σ hj => by
      cases j with
      | zero => simp at hj; subst hj; simp [wcons]
      | succ j => simp at hj)
    (fun k => by simp [wcons]) s 0 0
  simp only [Nat.add_zero] at e2
  rw [e1, e2]
  have hX := Clo_cl0 (ρ := ρ) hW (.mu s)
  have := accs_cl_guard (ρ := ρ) (W := W) (W' := wcons (cl ρ W 0 0 (.mu s)) W) (fun k => by simp [wcons])
    (fun m => by simpa [wcons] using hX.1 m) (fun m => by simpa [wcons] using hX.2 m) s 0 0 hg
  rw [this]; simp only [cl, accs]

/-- **A component's accesses are a run of its container's.** -/
theorem AtOff_embed {T U : Ty} {o : Nat} (h : AtOff T o U) :
    ∀ {L us : List Acc}, accs T = some L → accs U = some us →
      ∃ pre post, L = pre ++ us ++ post ∧ nWords pre = o := by
  induction h with
  | here _ =>
      intro L us hL hu; rw [hL] at hu; cases hu
      exact ⟨[], [], by simp, rfl⟩
  | @fold ρ W s T o hW hg ha _ ih =>
      intro L us hL hu
      exact ih hL (by rw [accs_cl_unfold_eq hW hg]; exact hu)
  | @fst a b u o _ ih =>
      intro L us hL hu
      cases ha : accs a with
      | none => simp [accs, ha] at hL
      | some La =>
      cases hb : accs b with
      | none => simp [accs, ha, hb] at hL
      | some Lb =>
      simp only [accs, ha, hb] at hL
      have hL' : L = La ++ Lb := by simpa using hL.symm
      obtain ⟨pre, post, e, hn⟩ := ih ha hu
      exact ⟨pre, post ++ Lb, by rw [hL', e]; simp, hn⟩
  | @snd a b u o ua hua _ ih =>
      intro L us hL hu
      cases hb : accs b with
      | none => simp [accs, hua, hb] at hL
      | some Lb =>
      simp only [accs, hua, hb] at hL
      have hL' : L = ua ++ Lb := by simpa using hL.symm
      obtain ⟨pre, post, e, hn⟩ := ih hb hu
      exact ⟨ua ++ pre, post, by rw [hL', e]; simp, by rw [nWords_append, hn]⟩
  | elem _ _ _ _ => intro L us hL _; simp [accs] at hL
  | @mu ρ W s u o hW hg _ ih =>
      intro L us hL hu
      exact ih (by rw [accs_cl_unfold_eq hW hg]; exact hL) hu

theorem AtOff_arr_elem {T U : Ty} {o : Nat} (h : AtOff T o U) :
    ∀ {N : Nat} {e : Ty}, T = .array (.lit N) e →
      U = T ∨ ∃ us j o', accs e = some us ∧ j < N ∧ o = j * nWords us + o' ∧ AtOff e o' U := by
  induction h with
  | here _ => intro _ _ _; exact Or.inl rfl
  | fst _ _ => intro _ _ e; cases e
  | snd _ _ _ => intro _ _ e; cases e
  | @elem e0 u n j o us hus hj h0 _ =>
      intro N e he
      simp only [Ty.array.injEq, Idx.lit.injEq] at he
      obtain ⟨rfl, rfl⟩ := he
      exact Or.inr ⟨us, j, o, hus, hj, rfl, h0⟩
  | mu _ _ _ _ => intro _ _ e; simp [cl] at e
  | @fold ρ W s T o hW hg ha h0 ih =>
      intro N e he
      rcases ih he with h1 | ⟨us, j, o', hus, hj, ho, h2⟩
      · exfalso; apply ha; rw [← accs_cl_unfold_eq hW hg, h1, he]; simp [accs]
      · exact Or.inr ⟨us, j, o', hus, hj, ho, .fold hW hg ha h2⟩

/-- **A locative's segment**, from its cell's layout, without the cell's words. -/
theorem at_seg {ini : AllocLabel → Nat} {c : Cell} {a : Address} {U : Ty}
    (hlt : LayT c.ty) (hat : AtOff c.ty a.offset U) (hini : IniAt ini c a U)
    (hU : ∀ N e, U ≠ .array (.lit N) e) :
    ∃ b o S L, SegOf c.ty b S ∧ b + o = a.offset ∧ AtOff S o U ∧ accs S = some L ∧
      (∀ N e, c.ty = .array (.lit N) e → ∃ us j, accs e = some us ∧ j < ini a.label ∧ b = j * nWords us) := by
  rcases hlt with hl | ⟨N, e, hT, -⟩
  · obtain ⟨L, hL⟩ := Option.ne_none_iff_exists'.1 hl
    refine ⟨0, a.offset, c.ty, L, Or.inl ⟨rfl, rfl, hl⟩, Nat.zero_add _, hat, hL, fun N e hT => ?_⟩
    rw [hT] at hL; simp [accs] at hL
  · rcases AtOff_arr_elem hat hT with hUc | ⟨us, j', o', hus, hj', ho', hat'⟩
    · exact absurd (hUc.trans hT) (hU N e)
    · rcases hini N e hT with ⟨hUc, -⟩ | ⟨us2, j, o, hus2, hj, hjo, hato⟩
      · exact absurd (hUc.trans hT) (hU N e)
      · rw [hus] at hus2; cases hus2
        by_cases hjj : j ≤ j'
        · refine ⟨j * nWords us, o, e, us, Or.inr ⟨N, us, j, hT, hus, by omega, rfl⟩, hjo, hato, hus,
            fun N1 e1 hT1 => ?_⟩
          rw [hT] at hT1; simp only [Ty.array.injEq, Idx.lit.injEq] at hT1; obtain ⟨-, rfl⟩ := hT1
          exact ⟨us, j, hus, hj, rfl⟩
        · refine ⟨j' * nWords us, o', e, us, Or.inr ⟨N, us, j', hT, hus, hj', rfl⟩, ho'.symm, hat', hus,
            fun N1 e1 hT1 => ?_⟩
          rw [hT] at hT1; simp only [Ty.array.injEq, Idx.lit.injEq] at hT1; obtain ⟨-, rfl⟩ := hT1
          exact ⟨us, j', hus, by omega, rfl⟩

/-- Two segments holding one offset are one segment. -/
theorem SegOf_unique {E : TEnv} {T S S' : Ty} {b b' o o' : Nat} {L : List Acc} {ws' : List Word}
    (h1 : SegOf T b S) (hL : accs S = some L) (ho : o < nWords L)
    (h2 : SegOf T b' S') (hv : ValOfS E S' ws') (ho' : o' < ws'.length) (he : b + o = b' + o') :
    b = b' ∧ S = S' := by
  rcases h1 with ⟨rfl, rfl, -⟩ | ⟨N, us, j, hT, hus, hj, rfl⟩
  · rcases h2 with ⟨rfl, rfl, -⟩ | ⟨N', us', j', hT', -, -, -⟩
    · exact ⟨rfl, rfl⟩
    · rw [hT'] at hL; simp [accs] at hL
  · rcases h2 with ⟨rfl, rfl, hA⟩ | ⟨N', us', j', hT', hus', hj', rfl⟩
    · exfalso; rw [hT] at hA; simp [accs] at hA
    · rw [hT] at hT'; simp only [Ty.array.injEq, Idx.lit.injEq] at hT'
      obtain ⟨rfl, rfl⟩ := hT'
      obtain rfl : us = us' := by rw [hus] at hus'; exact Option.some.inj hus'
      obtain rfl : us = L := by rw [hus] at hL; exact Option.some.inj hL
      have hl' : ws'.length = nWords us := hv.2 us hus
      have : j = j' := by
        rcases Nat.lt_trichotomy j j' with h | h | h
        · have hm := Nat.mul_le_mul_right (nWords us) (show j + 1 ≤ j' by omega)
          rw [Nat.succ_mul] at hm; omega
        · exact h
        · have hm := Nat.mul_le_mul_right (nWords us) (show j' + 1 ≤ j by omega)
          rw [Nat.succ_mul] at hm; omega
      subst this; exact ⟨rfl, rfl⟩

/-- (F2) A hiding bound past the read's hiding: a message not hidden below `V`
is a word of the cell, when non-words are hidden below `V0 ≤ V`. -/
theorem hiddenP_wordOK {E : TEnv} {T : Ty} {mem : Memory} {P : List Ts} {l : AllocLabel} {o t V0 V : Nat}
    {m : Msg} (hd : HiddenP E T mem P l o V0) (hV : V0 ≤ V) (hnp : t ∉ P) (hm : mem[t]? = some m)
    (hloc : m.loc = ⟨l, o⟩) (hh : WeakMem.hiddenFrom mem ⟨l, o⟩ t V = false) : WordOK E T o (mw m) := by
  refine Classical.byContradiction fun hno => ?_
  obtain ⟨t', m', h1, h2, h3, h4⟩ := hd t m hnp hm hloc hno
  have hT : WeakMem.hiddenFrom mem ⟨l, o⟩ t V0 = true := by
    unfold WeakMem.hiddenFrom; rw [List.any_eq_true]
    exact ⟨t', List.mem_range.2 (Nat.lt_succ_of_le h2), by simp [h1, h3, h4]⟩
  rw [hiddenFrom_mono hV hh] at hT; cases hT

/-! ### (F2) Reads with a per-address hiding bound -/

/-- `UnitRead` with a hiding bound per address (`V`): the owner's reads are not
hidden below its coherence, which differs from word to word. -/
def UnitReadV (mem : Memory) (pairs : List Ts) (a : Address) (V : Address → Ts) (P : List Ts) :
    Acc → Nat → List Word → Prop
  | .one, o, [w] => ∃ (t : Nat) (m : Msg), mem[t]? = some m ∧ m.loc = offs a o ∧
      WeakMem.hiddenFrom mem (offs a o) t (V (offs a o)) = false ∧ WLe1 (mw m) w ∧ t ∉ P
  | .two, o, [w0, w1] => ∃ (t0 t1 : Nat) (m0 m1 : Msg), mem[t0]? = some m0 ∧ mem[t1]? = some m1 ∧
      m0.loc = offs a o ∧ m1.loc = offs a (o + 1) ∧
      WeakMem.hiddenFrom mem (offs a o) t0 (V (offs a o)) = false ∧
      WeakMem.hiddenFrom mem (offs a (o + 1)) t1 (V (offs a (o + 1))) = false ∧
      WeakMem.pairStraddles mem pairs (offs a o) t0 t1 = false ∧ WLe1 (mw m0) w0 ∧ WLe1 (mw m1) w1 ∧
      t0 ∉ P ∧ t1 ∉ P
  | _, _, _ => False

/-- `Reads` with a hiding bound per address. -/
def ReadsV (mem : Memory) (pairs : List Ts) (a : Address) (V : Address → Ts) (P : List Ts) :
    List Acc → Nat → List Word → Prop
  | [], _, ws => ws = []
  | u :: us, k, ws => UnitReadV mem pairs a V P u k (ws.take u.size) ∧
      ReadsV mem pairs a V P us (k + u.size) (ws.drop u.size)

/-- A read's bound is past coherence at its address. -/
theorem coh_le_bound (arch : Arch) (vs : VState) (d : Ts) (b : Address) :
    vs.coh b ≤ Promises.readBoundOf arch vs d b := by
  simp only [Promises.readBoundOf]
  exact Nat.le_trans (Nat.le_max_right _ _) (Nat.le_max_left _ _)

/-- **What a load reads, per-address bound**: each unit, messages not hidden
below its address register's view nor below the coherence `C ≤ coh` at its
address at the start of the load. -/
theorem loadUnits_readsV {arch : Arch} {pw : Word} {a : Address} {acq : Bool} :
    ∀ (us : List Acc) (k : Nat) (s : St) (r : St × List Word), r ∈ loadUnits arch pw a acq us k s →
      ∀ P : List Ts, (∀ (t : Nat) (m : Msg), t ∈ P → s.mem[t]? = some m → r.1.vs.coh m.loc < t) →
      ∀ C : Address → Ts, (∀ b, C b ≤ s.vs.coh b) →
      ReadsV s.mem s.pairs a (fun b => max pw.view (C b)) P us k r.2
  | [], k, s, r, hr, P, _, _, _ => by
      simp only [loadUnits, List.mem_singleton] at hr; subst hr; rfl
  | .one :: us, k, s, r, hr, P, hP, C, hC => by
      simp only [loadUnits, List.mem_flatMap, List.mem_map] at hr
      obtain ⟨th, hth, ⟨s', ws⟩, hmem, rfl⟩ := hr
      have hcm := loadUnits_cohMono us (k + 1) _ (s', ws) hmem
      simp only [Promises.stepLoad, List.mem_map, List.mem_filter, List.mem_range] at hth
      obtain ⟨t, ⟨_, hrd⟩, rfl⟩ := hth
      have hC' : ∀ b, C b ≤ (if b = offs a k then max (s.vs.coh (offs a k)) t else s.vs.coh b) := by
        intro b; refine Nat.le_trans (hC b) ?_
        split
        · rename_i hb; subst hb; exact Nat.le_max_left _ _
        · exact Nat.le_refl _
      have ih := loadUnits_readsV us (k + 1) _ (s', ws) hmem P hP C hC'
      obtain ⟨m, hm, hloc, hh⟩ := readable_get hrd
      have e : s.mem[t]! = m := by simp [getElem!_def, hm]
      refine ⟨?_, ih⟩
      refine ⟨t, m, hm, hloc, hiddenFrom_mono (Nat.max_le.2 ⟨view_le_bound arch s pw s.vs _,
          Nat.le_trans (hC _) (coh_le_bound _ _ _ _)⟩) hh,
        ⟨by simp [mw, e], fun _ _ _ => by simp [mw, e]⟩, fun htp => ?_⟩
      have h1 := hP t m htp hm
      rw [hloc] at h1
      have h2 := Nat.le_trans (by
        show t ≤ (if offs a k = offs a k then max (s.vs.coh (offs a k)) t else s.vs.coh (offs a k))
        split
        · exact Nat.le_max_right _ _
        · rename_i hne; exact absurd rfl hne) (hcm (offs a k))
      exact absurd (Nat.lt_of_le_of_lt h2 h1) (Nat.lt_irrefl _)
  | .two :: us, k, s, r, hr, P, hP, C, hC => by
      simp only [loadUnits, List.mem_flatMap, List.mem_map] at hr
      obtain ⟨th, hth, ⟨s', ws⟩, hmem, rfl⟩ := hr
      have hcm := loadUnits_cohMono us (k + 2) _ (s', ws) hmem
      simp only [Promises.stepLoadPair, List.mem_flatMap, List.mem_filterMap, List.mem_filter,
        List.mem_range] at hth
      obtain ⟨t0, ⟨_, hr0⟩, t1, ⟨_, hr1⟩, hs⟩ := hth
      split at hs
      · exact absurd hs (by simp)
      · rename_i hns
        simp only [Option.some.injEq] at hs
        subst hs
        have hC' : ∀ b, C b ≤ (if b = offs a k then max (s.vs.coh (offs a k)) t0
            else if b = (offs a k).next then max (s.vs.coh (offs a k).next) t1 else s.vs.coh b) := by
          intro b; refine Nat.le_trans (hC b) ?_
          split
          · rename_i hb; subst hb; exact Nat.le_max_left _ _
          · split
            · rename_i _ hb; subst hb; exact Nat.le_max_left _ _
            · exact Nat.le_refl _
        have ih := loadUnits_readsV us (k + 2) _ (s', ws) hmem P hP C hC'
        obtain ⟨m0, hm0, hl0, hh0⟩ := readable_get hr0
        obtain ⟨m1, hm1, hl1, hh1⟩ := readable_get hr1
        have e0 : s.mem[t0]! = m0 := by simp [getElem!_def, hm0]
        have e1 : s.mem[t1]! = m1 := by simp [getElem!_def, hm1]
        have hnx : (offs a k).next = offs a (k + 1) := by simp [offs, WeakMem.Address.next, Nat.add_assoc]
        refine ⟨?_, ih⟩
        refine ⟨t0, t1, m0, m1, hm0, hm1, hl0, by rw [hl1, hnx],
          hiddenFrom_mono (Nat.max_le.2 ⟨view_le_bound arch s pw s.vs _,
            Nat.le_trans (hC _) (coh_le_bound _ _ _ _)⟩) hh0,
          by rw [← hnx]; exact hiddenFrom_mono (Nat.max_le.2 ⟨view_le_bound arch s pw s.vs _,
            Nat.le_trans (hC _) (coh_le_bound _ _ _ _)⟩) hh1,
          by simpa using hns, ⟨by simp [mw, e0], fun _ _ _ => by simp [mw, e0]⟩,
          ⟨by simp [mw, e1], fun _ _ _ => by simp [mw, e1]⟩, fun htp => ?_, fun htp => ?_⟩
        · have h1 := hP t0 m0 htp hm0
          rw [hl0] at h1
          have h2 := Nat.le_trans (by
            show t0 ≤ (if offs a k = offs a k then max (s.vs.coh (offs a k)) t0
              else if offs a k = (offs a k).next then max (s.vs.coh (offs a k).next) t1 else s.vs.coh (offs a k))
            split
            · exact Nat.le_max_right _ _
            · rename_i hne; exact absurd rfl hne) (hcm (offs a k))
          exact absurd (Nat.lt_of_le_of_lt h2 h1) (Nat.lt_irrefl _)
        · have h1 := hP t1 m1 htp hm1
          rw [hl1] at h1
          have h2 := Nat.le_trans (by
            show t1 ≤ (if (offs a k).next = offs a k then max (s.vs.coh (offs a k)) t0
              else if (offs a k).next = (offs a k).next then max (s.vs.coh (offs a k).next) t1
              else s.vs.coh (offs a k).next)
            split
            · rename_i heq; exact absurd (congrArg WeakMem.Address.offset heq) (Nat.succ_ne_self _)
            · split
              · exact Nat.le_max_right _ _
              · rename_i hne; exact absurd rfl hne) (hcm (offs a k).next)
          exact absurd (Nat.lt_of_le_of_lt h2 h1) (Nat.lt_irrefl _)

theorem UnitReadV_len {mem : Memory} {pairs : List Ts} {a : Address} {V : Address → Ts} {P : List Ts}
    {u : Acc} {o : Nat} {ws : List Word} (h : UnitReadV mem pairs a V P u o ws) : ws.length = u.size := by
  cases u with
  | one =>
    match ws, h with
    | [_], _ => rfl
    | [], h => simp [UnitReadV] at h
    | _ :: _ :: _, h => simp [UnitReadV] at h
  | two =>
    match ws, h with
    | [_, _], _ => rfl
    | [], h => simp [UnitReadV] at h
    | [_], h => simp [UnitReadV] at h
    | _ :: _ :: _ :: _, h => simp [UnitReadV] at h

theorem UnitReadV_one {mem : Memory} {pairs : List Ts} {a : Address} {V : Address → Ts} {P : List Ts} {o : Nat}
    {ws : List Word} (h : UnitReadV mem pairs a V P .one o ws) :
    ∃ (w : Word) (t : Nat) (m : Msg), ws = [w] ∧ mem[t]? = some m ∧ m.loc = offs a o ∧
      WeakMem.hiddenFrom mem (offs a o) t (V (offs a o)) = false ∧ WLe1 (mw m) w ∧ t ∉ P := by
  match ws, h with
  | [w], ⟨t, m, h1, h2, h3, h4, h5⟩ => exact ⟨w, t, m, rfl, h1, h2, h3, h4, h5⟩
  | [], h => simp [UnitReadV] at h
  | _ :: _ :: _, h => simp [UnitReadV] at h

theorem UnitReadV_two {mem : Memory} {pairs : List Ts} {a : Address} {V : Address → Ts} {P : List Ts} {o : Nat}
    {ws : List Word} (h : UnitReadV mem pairs a V P .two o ws) :
    ∃ (w0 w1 : Word) (t0 t1 : Nat) (m0 m1 : Msg), ws = [w0, w1] ∧ mem[t0]? = some m0 ∧ mem[t1]? = some m1 ∧
      m0.loc = offs a o ∧ m1.loc = offs a (o + 1) ∧
      WeakMem.hiddenFrom mem (offs a o) t0 (V (offs a o)) = false ∧
      WeakMem.hiddenFrom mem (offs a (o + 1)) t1 (V (offs a (o + 1))) = false ∧
      WeakMem.pairStraddles mem pairs (offs a o) t0 t1 = false ∧ WLe1 (mw m0) w0 ∧ WLe1 (mw m1) w1 ∧
      t0 ∉ P ∧ t1 ∉ P := by
  match ws, h with
  | [w0, w1], ⟨t0, t1, m0, m1, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11⟩ =>
    exact ⟨w0, w1, t0, t1, m0, m1, rfl, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11⟩
  | [], h => simp [UnitReadV] at h
  | [_], h => simp [UnitReadV] at h
  | _ :: _ :: _ :: _, h => simp [UnitReadV] at h

/-- `ReadsV` by unit index. -/
theorem ReadsV_unit {mem : Memory} {pairs : List Ts} {a : Address} {V : Address → Ts} {P : List Ts} :
    ∀ (us : List Acc) (k : Nat) (ws : List Word), ReadsV mem pairs a V P us k ws →
      ws.length = nWords us ∧ ∀ i u, us[i]? = some u →
        UnitReadV mem pairs a V P u (k + nWords (us.take i)) ((ws.drop (nWords (us.take i))).take u.size)
  | [], k, ws, h => by
      simp only [ReadsV] at h; subst h
      exact ⟨rfl, fun i u hu => by simp at hu⟩
  | u :: us, k, ws, h => by
      simp only [ReadsV] at h
      obtain ⟨h1, h2⟩ := h
      obtain ⟨ih1, ih2⟩ := ReadsV_unit us (k + u.size) (ws.drop u.size) h2
      have hl := UnitReadV_len h1
      rw [List.length_take] at hl
      refine ⟨?_, fun i u' hu => ?_⟩
      · rw [List.length_drop] at ih1
        simp only [nWords, List.map_cons, List.sum_cons] at ih1 ⊢
        omega
      · cases i with
        | zero =>
          simp at hu; subst hu
          simpa [nWords] using h1
        | succ j =>
          simp only [List.getElem?_cons_succ] at hu
          have := ih2 j u' hu
          have e : nWords ((u :: us).take (j + 1)) = u.size + nWords (us.take j) := by simp [nWords]
          have e2 : ws.drop (u.size + nWords (us.take j)) = (ws.drop u.size).drop (nWords (us.take j)) := by
            simp [List.drop_drop, Nat.add_comm]
          rw [e, e2, ← Nat.add_assoc]; exact this

/-- (F2′) A locative inside a segment below count `n` is below `n`. -/
theorem IniAt_of_seg {n : AllocLabel → Nat} {c : Cell} {a : Address} {U S : Ty} {b oS : Nat}
    (hseg : SegOf c.ty b S) (hbo : b + oS = a.offset) (hat : AtOff S oS U) (h : IniSegN (n a.label) c b) :
    IniAt n c a U := by
  intro N e hT
  rcases hseg with ⟨-, rfl, hA⟩ | ⟨N', us, j, hT', hus, -, rfl⟩
  · rw [hT] at hA; simp [accs] at hA
  · rw [hT] at hT'; simp only [Ty.array.injEq, Idx.lit.injEq] at hT'; obtain ⟨-, rfl⟩ := hT'
    obtain ⟨us', j', hus', hj', hb⟩ := h N e hT
    rw [hus] at hus'; cases hus'
    exact Or.inr ⟨us, j', oS, hus, hj', by rw [← hb]; exact hbo, hat⟩

/-- (F2) **Loading at a locative into a cell, bound-parametric core**: the cell's
segments tear (`TearOK`), every word has a message, and a message read not
hidden below `max pw.view coh` is a word (one-word units) or a pair (two-word
units) of the cell.  The pub path (`pubLoadAtV`, hiding by the frontier) and the
owner's frontier path (`ownLoadAtF`, hiding by coherence) are instances. -/
theorem segLoadV {E : TEnv} {s : St} {ad : Address} {c : Cell} {U : Ty} {us : List Acc}
    {arch : Arch} {pw : Word} {acq : Bool}
    (hInh : Inh E) (hlt : LayT c.ty) (hcplS : ∀ b S, SegOf c.ty b S → accs S ≠ none → TearOK S)
    (hsto : E.sto ad.label = some c) {n : AllocLabel → Nat} (hn : ∀ l, n l ≤ E.ini l)
    (hat : AtOff c.ty ad.offset U) (hini : IniAt n c ad U) (hna : ∀ N e, U ≠ .array (.lit N) e)
    (hus : accs U = some us)
    (hLV : ∀ b S L o, SegOf c.ty b S → accs S = some L → IniSegN (n ad.label) c b → o < nWords L →
      ∃ (t : Nat) (m : Msg), s.mem[t]? = some m ∧ m.loc = ⟨ad.label, b + o⟩)
    (hW1 : ∀ b S L o t m, SegOf c.ty b S → accs S = some L → IniSegN (n ad.label) c b → o < nWords L →
      t ∉ s.promises → s.mem[t]? = some m → m.loc = ⟨ad.label, b + o⟩ →
      WeakMem.hiddenFrom s.mem ⟨ad.label, b + o⟩ t (max pw.view (s.vs.coh ⟨ad.label, b + o⟩)) = false →
      WordOK E c.ty (b + o) (mw m))
    (hW2 : ∀ b S L o t0 t1 m0 m1, SegOf c.ty b S → accs S = some L → IniSegN (n ad.label) c b →
      (∃ oS, b + oS = ad.offset ∧ AtOff S oS U) → TwoAt L o →
      t0 ∉ s.promises → t1 ∉ s.promises → s.mem[t0]? = some m0 → s.mem[t1]? = some m1 →
      m0.loc = ⟨ad.label, b + o⟩ → m1.loc = ⟨ad.label, b + o + 1⟩ →
      WeakMem.hiddenFrom s.mem ⟨ad.label, b + o⟩ t0 (max pw.view (s.vs.coh ⟨ad.label, b + o⟩)) = false →
      WeakMem.hiddenFrom s.mem ⟨ad.label, b + o + 1⟩ t1 (max pw.view (s.vs.coh ⟨ad.label, b + o + 1⟩)) = false →
      WeakMem.pairStraddles s.mem s.pairs ⟨ad.label, b + o⟩ t0 t1 = false →
      PairOK E c.ty (b + o) (mw m0) (mw m1)) :
    (∃ r, r ∈ loadUnits arch pw ad acq us 0 s) ∧
    (∀ r, r ∈ loadUnits arch pw ad acq us 0 s → PromAbove r.1 →
      ∃ q, ValOf E U q ∧ WLe q r.2 ∧ r.2.length = nWords us) ∧
    ∃ q, ValOf E U q := by
  obtain ⟨b, oS, S, L, hseg, hbo, hatS, hL, hiS⟩ := at_seg hlt hat hini hna
  obtain ⟨pre, post, hLe, hpre⟩ := AtOff_embed hatS hL hus
  have hLe' : L = pre ++ (us ++ post) := by rw [hLe, List.append_assoc]
  have hnL : nWords L = nWords pre + nWords us + nWords post := by
    rw [hLe, nWords_append, nWords_append]
  have hcpl : TearOK S := hcplS b S hseg (by rw [hL]; simp)
  have hoff : ∀ n, offs ad (0 + n) = ⟨ad.label, b + (oS + n)⟩ := fun n => by
    simp only [offs, Nat.zero_add, ← hbo, Nat.add_assoc]
  have hlive : ∀ j, j < nWords us → ∃ (t : Nat) (m : Msg), s.mem[t]? = some m ∧ m.loc = offs ad (0 + j) := by
    intro j hj
    obtain ⟨t, m, h1, h2⟩ := hLV b S L (oS + j) hseg hL hiS (by omega)
    exact ⟨t, m, h1, by rw [h2, hoff]⟩
  obtain ⟨r0, hr0⟩ := loadUnits_nonemptyL (arch := arch) (pw := pw) (a := ad) (acq := acq) us 0 s hlive
  have hst0 : ∃ q, ValOf E U q := by
    obtain ⟨Q0, hQ0, hQl⟩ := hInh ad.label c b S L hsto hseg hL (IniSegN.mono (hn _) hiS)
    obtain ⟨n0, -, -, hvU, hVU⟩ := VR_at E.unsee hatS hQ0.1 hQ0.2 (by rw [hQl]; exact wc_of_accs hL)
    exact ⟨_, hvU, hVU⟩
  refine ⟨⟨r0, hr0⟩, fun r hr hpa => ?_, hst0⟩
  obtain ⟨f1, -, f3, -⟩ := loadUnits_frame us 0 _ r hr
  have hrd := ReadsV_unit us 0 r.2 (loadUnits_readsV us 0 _ r hr s.promises
    (fun t m ht hm => hpa t (by rw [f3]; exact ht) m (by rw [f1]; exact hm)) s.vs.coh (fun _ => Nat.le_refl _))
  have hrl : r.2.length = nWords us := hrd.1
  obtain ⟨Q0, hQ0, hQl⟩ := hInh ad.label c b S L hsto hseg hL (IniSegN.mono (hn _) hiS)
  have hbnd : oS + nWords us ≤ Q0.length := by omega
  obtain ⟨wsL, hwsL⟩ : ∃ w, w = Q0.take oS ++ r.2 ++ Q0.drop (oS + nWords us) := ⟨_, rfl⟩
  have hwsLlen : wsL.length = nWords L := by
    rw [hwsL]; simp only [List.length_append, List.length_take, List.length_drop, hrl, hQl]; omega
  have hunit : ∀ i, i < L.length → ∃ ws, (ValOf E S ws ∧ ws.length = nWords L) ∧
      ∀ j x y, nWords (L.take i) ≤ j → j < nWords (L.take (i + 1)) → ws[j]? = some x →
        wsL[j]? = some y → WLe1 x y := by
    intro i hi
    by_cases hi1 : i < pre.length
    · refine ⟨Q0, ⟨hQ0, hQl⟩, fun j x y _ hj2 hx hy => ?_⟩
      have h1 : nWords (L.take (i + 1)) ≤ nWords pre := by
        rw [hLe', List.take_append, nWords_append,
          show i + 1 - pre.length = 0 by omega, List.take_zero]
        have := nWords_take_le pre (i + 1)
        simp only [nWords, List.map_nil, List.sum_nil, Nat.add_zero] at this ⊢; exact this
      rw [hwsL, splice_get Q0 r.2 oS (nWords us) j hrl hbnd, iteF (by omega)] at hy
      rw [hx] at hy; cases hy; exact WLe1_refl _
    by_cases hi2 : i < pre.length + us.length
    · obtain ⟨i', rfl⟩ : ∃ i', i = pre.length + i' := ⟨i - pre.length, by omega⟩
      have hi' : i' < us.length := by omega
      obtain ⟨u0, hu0⟩ : ∃ u0, us[i']? = some u0 := ⟨_, List.getElem?_eq_getElem hi'⟩
      have hLi : L[pre.length + i']? = some u0 := by
        rw [hLe', List.getElem?_append_right (by omega), Nat.add_sub_cancel_left,
          List.getElem?_append_left hi']; exact hu0
      have ht1 : nWords (L.take (pre.length + i')) = oS + nWords (us.take i') := by
        rw [hLe', List.take_append, List.take_of_length_le (by omega), nWords_append,
          Nat.add_sub_cancel_left, List.take_append, show i' - us.length = 0 by omega,
          List.take_zero, List.append_nil, hpre]
      have ht2 : nWords (L.take (pre.length + i' + 1)) = oS + nWords (us.take i') + u0.size := by
        rw [nWords_take_succ hLi, ht1]
      have hnb : nWords (us.take i') + u0.size ≤ nWords us := by
        rw [← nWords_take_succ hu0]; exact nWords_take_le us (i' + 1)
      have hU := hrd.2 i' u0 hu0
      rw [ht1, ht2]
      rw [Nat.zero_add] at hU
      generalize hn : nWords (us.take i') = n at hU hnb ⊢
      cases u0 with
      | one =>
        have hsz : Acc.size .one = 1 := rfl
        obtain ⟨w, t, m, hw, hm, hloc, hh, hwl, hnp⟩ := UnitReadV_one hU
        rw [← Nat.zero_add n, hoff] at hloc hh
        have hy : r.2[n]? = some w := by
          have h1 : (r.2.drop n)[0]? = some w := by
            rw [← List.getElem?_take_of_lt (show 0 < Acc.size .one by decide), hw]; rfl
          rw [List.getElem?_drop, Nat.add_zero] at h1; exact h1
        have hpos : oS + n < nWords L := by simp only [Acc.size] at hnb; omega
        have hwok := hW1 b S L (oS + n) t m hseg hL hiS hpos hnp hm hloc hh
        obtain ⟨b', S', ws, o', w0, hseg', hvs, hget, hle0, hbo'⟩ := hwok
        obtain ⟨rfl, rfl⟩ := SegOf_unique hseg hL hpos hseg' hvs (List.getElem?_eq_some_iff.1 hget).1 hbo'.symm
        refine ⟨ws, ⟨hvs.1, hvs.2 L hL⟩, fun j x y' hj1 hj2 hx hy' => ?_⟩
        simp only [Acc.size] at hj2
        have hj : j = oS + n := by omega
        have ho' : o' = oS + n := by omega
        subst hj ho'
        rw [hget] at hx; cases hx
        rw [hwsL, splice_get Q0 r.2 oS (nWords us) _ hrl hbnd, iteT ⟨by omega, by omega⟩,
          Nat.add_sub_cancel_left, hy] at hy'
        cases hy'; exact WLe1_trans hle0 hwl
      | two =>
        have hsz : Acc.size .two = 2 := rfl
        obtain ⟨w0, w1, t0, t1, m0, m1, hw, hm0, hm1, hl0, hl1, hh0, hh1, hst, hle0, hle1, hn0, hn1⟩ :=
          UnitReadV_two hU
        rw [← Nat.zero_add n, hoff] at hl0 hh0 hst
        have e1 : offs ad (n + 1) = ⟨ad.label, b + (oS + n) + 1⟩ := by
          simp only [offs, ← hbo, Nat.add_assoc]
        rw [e1] at hl1 hh1
        have hy0 : r.2[n]? = some w0 := by
          have h1 : (r.2.drop n)[0]? = some w0 := by
            rw [← List.getElem?_take_of_lt (show 0 < Acc.size .two by decide), hw]; rfl
          rw [List.getElem?_drop, Nat.add_zero] at h1; exact h1
        have hy1 : r.2[n + 1]? = some w1 := by
          have h1 : (r.2.drop n)[1]? = some w1 := by
            rw [← List.getElem?_take_of_lt (show 1 < Acc.size .two by decide), hw]; rfl
          rw [List.getElem?_drop] at h1; exact h1
        have hpos : oS + n < nWords L := by simp only [Acc.size] at hnb; omega
        have hpo := hW2 b S L (oS + n) t0 t1 m0 m1 hseg hL hiS ⟨oS, hbo, hatS⟩ ⟨pre.length + i', hLi, by rw [ht1, hn]⟩
          hn0 hn1 hm0 hm1 hl0 hl1 hh0 hh1 hst
        obtain ⟨b', S', ws, o', x0, x1, hseg', hvs, hg0, hg1, hx0, hx1, hbo'⟩ := hpo
        obtain ⟨rfl, rfl⟩ := SegOf_unique hseg hL hpos hseg' hvs (List.getElem?_eq_some_iff.1 hg0).1 hbo'.symm
        refine ⟨ws, ⟨hvs.1, hvs.2 L hL⟩, fun j x y' hj1 hj2 hx hy' => ?_⟩
        simp only [Acc.size] at hj2
        have ho' : o' = oS + n := by omega
        subst ho'
        rw [hwsL, splice_get Q0 r.2 oS (nWords us) _ hrl hbnd, iteT ⟨by omega, by omega⟩] at hy'
        rcases (show j = oS + n ∨ j = oS + n + 1 by omega) with rfl | rfl
        · rw [Nat.add_sub_cancel_left, hy0] at hy'; rw [hg0] at hx; cases hx; cases hy'
          exact WLe1_trans hx0 hle0
        · rw [show oS + n + 1 - oS = n + 1 by omega, hy1] at hy'; rw [hg1] at hx; cases hx; cases hy'
          exact WLe1_trans hx1 hle1
    · refine ⟨Q0, ⟨hQ0, hQl⟩, fun j x y hj1 _ hx hy => ?_⟩
      have h1 : oS + nWords us ≤ nWords (L.take i) := by
        rw [hLe', List.take_append, List.take_of_length_le (by omega), nWords_append,
          List.take_append, List.take_of_length_le (by omega), nWords_append, hpre]
        omega
      rw [hwsL, splice_get Q0 r.2 oS (nWords us) j hrl hbnd, iteF (by omega)] at hy
      rw [hx] at hy; cases hy; exact WLe1_refl _
  obtain ⟨vals, ⟨hvals, hvl⟩, hle⟩ :=
    TermTear.assemble (P := fun ws => ValOf E S ws ∧ ws.length = nWords L)
      (fun k ws1 ws2 hb h1 h2 => ⟨⟨hcpl _ _ _ _ _ hL hb h1.1.1 h2.1.1 h1.2 h2.2,
          TermTear.Valid_tear hL hb h1.1.2 h2.1.2 h1.2 h2.2⟩,
        by rw [TermTear.splice_length (h1.2.trans h2.2.symm)]; exact h2.2⟩)
      (fun ws h => h.2) wsL hwsLlen hunit ⟨Q0, hQ0, hQl⟩
  obtain ⟨n0, hwn, -, hvU, hVU⟩ := VR_at E.unsee hatS hvals.1 hvals.2 (by rw [hvl]; exact wc_of_accs hL)
  have hn0 : n0 = nWords us := by rw [wc_of_accs hus] at hwn; exact (Option.some.inj hwn).symm
  subst hn0
  refine ⟨(vals.drop oS).take (nWords us), ⟨hvU, hVU⟩, ?_, hrl⟩
  have e : (wsL.drop oS).take (nWords us) = r.2 := by
    rw [hwsL, List.append_assoc, List.drop_left' (by simp; omega), List.take_left' hrl]
  rw [← e]; exact WLe.take _ (WLe.drop _ hle)

/-- (F2) **`pubLoadAt`, bound-parametric**: the reader's hiding bound need only
be past the frontier at each word, through its view or its coherence. -/
theorem pubLoadAtV {E : TEnv} {s : St} {ad : Address} {c : Cell} {U : Ty} {us : List Acc} {f : Ts}
    {arch : Arch} {pw : Word} {acq : Bool}
    (hpi : PubInv E s) (hpd : PubDefP E s.mem s.promises)
    (hsto : E.sto ad.label = some c) (hown : c.owner ≠ some E.tid) (hf : E.pfr ad.label = some f)
    (hfv : ∀ o, f ≤ max pw.view (s.vs.coh ⟨ad.label, o⟩))
    (hat : AtOff c.ty ad.offset U) (hini : IniAt E.ini c ad U) (hna : ∀ N e, U ≠ .array (.lit N) e)
    (hus : accs U = some us) :
    (∃ r, r ∈ loadUnits arch pw ad acq us 0 s) ∧
    (∀ r, r ∈ loadUnits arch pw ad acq us 0 s → PromAbove r.1 →
      ∃ q, ValOf E U q ∧ WLe q r.2 ∧ r.2.length = nWords us) ∧
    ∃ q, ValOf E U q := by
  obtain ⟨-, hInh, hCpl, hPP, hLV⟩ := hpi
  obtain ⟨hlt, hcplS, -⟩ := hCpl ad.label c f hsto hf
  exact segLoadV hInh hlt hcplS hsto (fun _ => Nat.le_refl _) hat hini hna hus
    (fun b S L o hseg hL _ ho => hLV ad.label c f b S L o hsto hown hf hseg hL ho)
    (fun b S L o t m hseg hL hiS ho hnp hm hloc hh =>
      hiddenP_wordOK (hpd ad.label c f hsto hown hf (b + o) (InitR_of_IniSeg hiS hseg hL ho)) (hfv _)
        hnp hm hloc hh)
    (fun b S L o t0 t1 m0 m1 hseg hL hiS _ htw hn0 hn1 hm0 hm1 hl0 hl1 hh0 hh1 hst =>
      hPP ad.label c f (b + o) hsto (.inl ⟨hown, b, S, L, o, hseg, hL, htw, rfl, hiS⟩) hf ⟨b, S, L, o, hseg, hL, htw, rfl⟩ t0 t1 m0 m1 hn0 hn1 hm0 hm1
        hl0 hl1 (hiddenFrom_mono (hfv _) hh0) (hiddenFrom_mono (hfv _) hh1) hst)

/-- (F2) An own word has a message (at its coherence point). -/
theorem OwnOKSF_live {η : TEnv} {mem : Memory} {pairs : List Ts} {vs : VState} {S : Ts → Prop}
    {l : AllocLabel} {c : Cell} {b o : Nat} {S' : Ty} {L : List Acc}
    (h : OwnOKSF η mem pairs vs S) (hsto : η.sto l = some c) (hown : c.owner = some η.tid)
    (hseg : SegOf c.ty b S') (hL : accs S' = some L) (ho : o < nWords L) :
    ∃ (t : Nat) (m : Msg), mem[t]? = some m ∧ m.loc = ⟨l, b + o⟩ := by
  obtain ⟨vals, hc, hlat, -⟩ := h l c hsto hown
  obtain ⟨⟨m, hm, hml, -⟩, -⟩ := hlat (b + o) _ (List.getElem?_eq_getElem (CellOK_cover hc hseg hL ho))
  exact ⟨_, m, hm, hml⟩

/-- (F2) **The owner's load at a locative into its cell with a frontier**: what it
reads, torn across units, bounds a value of the target type.  Coherence hides
everything below the cell's words (`OwnOKSF_word`, `OwnOKSF_pair`). -/
theorem ownLoadAtF {E : TEnv} {s : St} {ad : Address} {c : Cell} {U : Ty} {us : List Acc} {f : Ts}
    {arch : Arch} {pw : Word} {acq : Bool}
    (ho : OwnOKPF E s.mem s.pairs s.vs s.promises) (hInh : Inh E) (hCpl : PubCpl E)
    (hsto : E.sto ad.label = some c) (hown : c.owner = some E.tid) (hf : E.pfr ad.label = some f)
    (hat : AtOff c.ty ad.offset U) (hini : IniAt E.rc c ad U) (hna : ∀ N e, U ≠ .array (.lit N) e)
    (hus : accs U = some us) :
    (∃ r, r ∈ loadUnits arch pw ad acq us 0 s) ∧
    (∀ r, r ∈ loadUnits arch pw ad acq us 0 s → PromAbove r.1 →
      ∃ q, ValOf E U q ∧ WLe q r.2 ∧ r.2.length = nWords us) ∧
    ∃ q, ValOf E U q := by
  obtain ⟨hlt, hcplS, -⟩ := hCpl ad.label c f hsto hf
  have hfn : E.pfr ad.label ≠ none := by rw [hf]; simp
  exact segLoadV hInh hlt hcplS hsto E.rc_le_ini hat hini hna hus
    (fun b S L o hseg hL _ ho' => OwnOKSF_live ho hsto hown hseg hL ho')
    (fun b S L o t m hseg hL hiS ho' hnp hm hloc hh =>
      OwnOKSF_word ho hsto hown hseg hL hiS ho' hnp hm hloc hh (Nat.le_max_right _ _))
    (fun b S L o t0 t1 m0 m1 hseg hL hiS _ htw hn0 hn1 hm0 hm1 hl0 hl1 hh0 hh1 hst =>
      OwnOKSF_pair ho hsto hown hfn hseg hL hiS htw hn0 hn1 hm0 hm1 hl0 hl1 hh0 (Nat.le_max_right _ _) hh1
        (Nat.le_max_right _ _) hst)

/-- (F2′) **The owner's `pub` load at a planted slot** (`¬ IniAt rc`, so the cell
is planted: `rc < ini`): what it reads past the frontier, torn across units,
bounds a value of the target type.  The cell's words are live (`OwnOKSF_live`),
its reader-visible slots hidden below the frontier (`OwnHidP` part 2), and a
two-word unit of a slot at or past the real count is `PubPair`'s
(slot-restricted guard, `IniAt_of_seg`). -/
theorem plantLoadAtV {E : TEnv} {s : St} {ad : Address} {c : Cell} {U : Ty} {us : List Acc} {f : Ts}
    {arch : Arch} {pw : Word} {acq : Bool}
    (hpi : PubInv E s) (ho : OwnOKPF E s.mem s.pairs s.vs s.promises) (hoh : OwnHidP E s.mem s.vs s.promises)
    (hsto : E.sto ad.label = some c) (hown : c.owner = some E.tid) (hf : E.pfr ad.label = some f)
    (hfv : ¬ ZW E ad.label → ∀ o, f ≤ max pw.view (s.vs.coh ⟨ad.label, o⟩))
    (hat : AtOff c.ty ad.offset U) (hini : IniAt E.ini c ad U) (hnr : ¬ IniAt E.rc c ad U)
    (hna : ∀ N e, U ≠ .array (.lit N) e) (hus : accs U = some us) :
    (∃ r, r ∈ loadUnits arch pw ad acq us 0 s) ∧
    (∀ r, r ∈ loadUnits arch pw ad acq us 0 s → PromAbove r.1 →
      ∃ q, ValOf E U q ∧ WLe q r.2 ∧ r.2.length = nWords us) ∧
    ∃ q, ValOf E U q ∧ q.length = nWords us := by
  obtain ⟨-, hInh, hCpl, hPP, -⟩ := hpi
  obtain ⟨hlt, hcplS, -⟩ := hCpl ad.label c f hsto hf
  have hrc : E.rc ad.label < E.ini ad.label := Nat.lt_of_not_le fun hle => hnr (IniAt_monoAt hle hini)
  obtain ⟨f', hf', -, hid⟩ := hoh.2 ad.label c hsto hown hrc
  rw [hf] at hf'; cases hf'
  obtain ⟨h1, h2, -⟩ := segLoadV (arch := arch) (pw := pw) (acq := acq) hInh hlt hcplS hsto
    (fun _ => Nat.le_refl _) hat hini hna hus
    (fun b S L o hseg hL _ ho' => OwnOKSF_live ho hsto hown hseg hL ho')
    (fun b S L o t m hseg hL hiS ho' hnp hm hloc hh =>
      hiddenP_wordOK (hid (b + o) (InitR_of_IniSeg hiS hseg hL ho'))
        (hfv (ZW.not_of_initR hsto (InitR_of_IniSeg hiS hseg hL ho')) _) hnp hm hloc hh)
    (fun b S L o t0 t1 m0 m1 hseg hL hiS ⟨oS, hbo, hatS⟩ htw hn0 hn1 hm0 hm1 hl0 hl1 hh0 hh1 hst =>
      hPP ad.label c f (b + o) hsto (.inr ⟨hrc, b, S, L, o, hseg, hL, htw, rfl,
          fun h => hnr (IniAt_of_seg hseg hbo hatS h), hiS⟩) hf ⟨b, S, L, o, hseg, hL, htw, rfl⟩
        t0 t1 m0 m1 hn0 hn1 hm0 hm1 hl0 hl1
        (hiddenFrom_mono (hfv (ZW.not_of_initR hsto (InitR_of_IniSeg (o := o) hiS hseg hL (by have := TwoAt_lt htw; omega))) _) hh0)
        (hiddenFrom_mono (hfv (ZW.not_of_initR hsto (InitR_of_IniSeg (o := o) hiS hseg hL (by have := TwoAt_lt htw; omega))) _) hh1) hst)
  refine ⟨h1, h2, ?_⟩
  obtain ⟨b, oS, S, L, hseg, -, hatS, hL, hiS⟩ := at_seg hlt hat hini hna
  obtain ⟨Q0, hQ0, hQl⟩ := hInh ad.label c b S L hsto hseg hL hiS
  obtain ⟨n0, hwn, hle, hvU, hVU⟩ := VR_at E.unsee hatS hQ0.1 hQ0.2 (by rw [hQl]; exact wc_of_accs hL)
  have hn0 : n0 = nWords us := by rw [wc_of_accs hus] at hwn; exact (Option.some.inj hwn).symm
  exact ⟨_, ⟨hvU, hVU⟩, by simp only [List.length_take, List.length_drop]; omega⟩

/-- (F2) **`ownLoad` at a cell with a frontier**: each outcome returns a value of the
pointee type (laid out at the runtime pointee) and changes neither memory, pairs,
promises nor allocation count.  Unlike `ownLoad`, coherence may move (to a
typed message past it). -/
theorem ownLoadF {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {s : St} {lab : AllocLabel} {c : Cell}
    {u ru : Ty} {arch : Arch} {pw : Word} {acq : Bool} {us : List Acc} {f : Ts}
    (hco : Coh η) (hoo : OwnOKPF (CE η) s.mem s.pairs s.vs s.promises) (hInh : Inh (CE η))
    (hCpl : PubCpl (CE η)) (hsto : η.sto lab = some c) (hown : c.owner = some η.tid)
    (hf : η.pfr lab = some f)
    (hshpT : shp c.ty = shp (cl ρ η.wit 0 0 u))
    (hVT : ∀ ws, Valid c.ty ws → Valid (cl ρ η.wit 0 0 u) ws)
    (hRT : ∀ R ws, VR (fun _ => 0) (CE η) c.ty R ws → VR (fun _ => 0) (CE η) (cl ρ η.wit 0 0 u) R ws)
    (hna : ∀ N e, c.ty ≠ .array (.lit N) e) (hsku : etok (skel ru) = etok (skel (close σs u)))
    (hlyu : etok (lyt 0 ru) = etok (lyt 0 (close σs u))) (hsig : sig ru = sig (cl ρ η.wit 0 0 u))
    (husc : accs c.ty = some us) (hus : accs ru = some us) :
    (∃ r, r ∈ loadUnits arch pw ⟨lab, 0⟩ acq us 0 s) ∧
      (∀ r, r ∈ loadUnits arch pw ⟨lab, 0⟩ acq us 0 s → PromAbove r.1 →
        VR ρ η u (shp ru) r.2 ∧ Lay σs u ru r.2 ∧ r.1.mem = s.mem ∧ r.1.pairs = s.pairs ∧
        r.1.promises = s.promises ∧ r.1.nalloc = s.nalloc) ∧
      ∃ ws, VR ρ η u (shp ru) ws ∧ Lay σs u ru ws := by
  have hfin : ∀ q ws, ValOf (CE η) c.ty q → WLe q ws → ws.length = nWords us →
      VR ρ η u (shp ru) ws ∧ Lay σs u ru ws := fun q ws hq hv1 hwl => by
    obtain ⟨hvr0, hV0⟩ := ValOf.env hq
    replace hvr0 := hRT _ _ hvr0
    rw [hshpT] at hvr0
    replace hV0 := hVT _ hV0
    refine ⟨?_, ⟨fun us' h => ?_, hsku, by simp [wc, hus], Valid_of_sig hsig.symm (Valid_vals _ q ws hv1.vals hV0), hlyu⟩⟩
    · rw [shp_of_sig hsig]
      exact (VR_close hco ρ u [] 0 ρ (fun _ => 0) (shp (cl ρ η.wit 0 0 u)) ws (fun k => rfl)
        (fun k hk => absurd hk (Nat.not_lt_zero _))).2 (VR_up _ _ q ws hv1 hvr0)
    · rw [hus] at h; cases h; exact hwl
  obtain ⟨hlt, -, -⟩ := hCpl lab c f hsto hf
  obtain ⟨hne, hld, -⟩ := ownLoadAtF (ad := ⟨lab, 0⟩) (U := c.ty) (arch := arch) (pw := pw) (acq := acq)
    hoo hInh hCpl hsto hown hf (AtOff.here hlt) (fun N e h => absurd h (hna N e)) hna husc
  obtain ⟨vals, hcv, -⟩ := hoo lab c hsto hown
  obtain ⟨hwc, hval⟩ := hcv.plain hna
  have hvl : vals.length = nWords us := by rw [wc_of_accs husc] at hwc; exact (Option.some.inj hwc).symm
  refine ⟨hne, fun r hr hpa => ?_, vals, hfin vals vals hval (WLe_refl vals) hvl⟩
  obtain ⟨q, hq, hle, hrl⟩ := hld r hr hpa
  obtain ⟨f1, f2, f3, f4⟩ := loadUnits_frame us 0 s r hr
  exact ⟨(hfin q r.2 hq hle hrl).1, (hfin q r.2 hq hle hrl).2, f1, f2, f3, f4⟩

/-- (T3c-5c) **Layout agreement at a reference's target**: the runtime
pointee of a reference has the static pointee's layout form (`Lay`), and the
frame's `WitL` makes that the layout of the closed static pointee. -/
theorem pub_accs {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {cx : Cx} {env : Env} {a : At}
    {t u rt ru : Ty} {ws : List Word} {μ μr : Mode} (hW : WitL σs η.wit cx.opq)
    (hK : cx.ke.length ≤ σs.length) (hC : ∀ k, Clo (η.wit k)) (hvars : VarsOK ρ η σs cx.vars env)
    (htv : TvOK cx) (hp : cx.peek a = .ok t) (hc : cellOf t = some (μ, u)) (ho : cx.opaqueOK u = true)
    (hea : evalAt env a = some (rt, ws)) (hcr : cellOf rt = some (μr, ru)) :
    accs ru = accs (cl ρ η.wit 0 0 u) :=
  (accs_of_elyt (peek_cell_lyt hvars hp hea hc hcr).2).trans
    (accs_WitL hW hC ρ ho (lt_of_guardT (tb_cellOf (peek_tb htv hp) hc) hK))

/-- **Loading an own cell**: it has an outcome, each outcome returns a value
of the pointee type (laid out at the runtime pointee), and none changes memory,
pairs, promises or allocation count.  (F2) Coherence: `LoadCoh` — unmoved at a
private cell, moved (to typed messages) only at the cell at a frontier. -/
theorem ownLoad {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {s : St} {lab : AllocLabel} {c : Cell}
    {u ru : Ty} {arch : Arch} {pw : Word} {acq : Bool}
    (hco : Coh η) (hoo : OwnOKPF (CE η) s.mem s.pairs s.vs s.promises) (hpo : PromOK s)
    (hpi : PubInv (CE η) s) (hsto : η.sto lab = some c)
    (hown : c.owner = some η.tid)
    (hshpT : shp c.ty = shp (cl ρ η.wit 0 0 u)) (hwcT : wc c.ty = wc (cl ρ η.wit 0 0 u))
    (hVT : ∀ ws, Valid c.ty ws → Valid (cl ρ η.wit 0 0 u) ws)
    (hRT : ∀ R ws, VR (fun _ => 0) (CE η) c.ty R ws → VR (fun _ => 0) (CE η) (cl ρ η.wit 0 0 u) R ws)
    (hna : ∀ N e, c.ty ≠ .array (.lit N) e) (hsku : etok (skel ru) = etok (skel (close σs u)))
    (hlyu : etok (lyt 0 ru) = etok (lyt 0 (close σs u))) (hsig : sig ru = sig (cl ρ η.wit 0 0 u))
    (hacc : accs ru = accs c.ty) :
    ∃ us, accs ru = some us ∧ (∃ r, r ∈ loadUnits arch pw ⟨lab, 0⟩ acq us 0 s) ∧
      (∀ r, r ∈ loadUnits arch pw ⟨lab, 0⟩ acq us 0 s → PromAbove r.1 →
        VR ρ η u (shp ru) r.2 ∧ Lay σs u ru r.2 ∧ r.1.mem = s.mem ∧ r.1.pairs = s.pairs ∧
        LoadCoh (CE η) s r.1 ∧ r.1.promises = s.promises ∧ r.1.nalloc = s.nalloc) ∧
      ∃ ws, VR ρ η u (shp ru) ws ∧ Lay σs u ru ws := by
  cases hp : η.pfr lab with
  | some f =>
    obtain ⟨vals, hcv, -⟩ := hoo lab c hsto hown
    obtain ⟨hwc, -⟩ := hcv.plain hna
    obtain ⟨us, husc⟩ : ∃ us, accs c.ty = some us := by
      cases h : accs c.ty with
      | none => simp [wc, h] at hwc
      | some us => exact ⟨us, rfl⟩
    have hus : accs ru = some us := by rw [hacc, husc]
    obtain ⟨hne, hld, hst⟩ := ownLoadF (arch := arch) (pw := pw) (acq := acq) hco hoo hpi.2.1 hpi.2.2.1
      hsto hown hp hshpT hVT hRT hna hsku hlyu hsig husc hus
    refine ⟨us, hus, hne, fun r hr hpa => ?_, hst⟩
    obtain ⟨a1, a2, a3, a4, a5, a6⟩ := hld r hr hpa
    exact ⟨a1, a2, a3, a4, LoadCoh_load hr hpa hoo ⟨c, hsto⟩, a5, a6⟩
  | none =>
  obtain ⟨vals, hcv, hlat⟩ := OwnOKS_priv hoo hsto hown hp
  obtain ⟨hwc, hval⟩ := hcv.plain hna
  rw [hwcT] at hwc
  have hwcr : wc ru = some vals.length := by rw [wc_of_sig hsig]; exact hwc
  obtain ⟨us, hus⟩ : ∃ us, accs ru = some us := by
    cases h : accs ru with
    | none => simp [wc, h] at hwcr
    | some us => exact ⟨us, rfl⟩
  have hlen : vals.length = nWords us := by simp [wc, hus] at hwcr; omega
  have hlat' : ∀ j v, vals[j]? = some v → LatestP s.mem s.promises s.vs.coh (offs ⟨lab, 0⟩ (0 + j)) v :=
    fun j v hj => by
      have e : offs ⟨lab, 0⟩ (0 + j) = ⟨lab, j⟩ := by simp [offs]
      rw [e]; exact hlat j v hj
  obtain ⟨hvr0, hV0⟩ := ValOf.env hval
  replace hvr0 := hRT _ _ hvr0
  rw [hshpT] at hvr0
  replace hV0 := hVT _ hV0
  have hfin : ∀ ws, WLe vals ws → VR ρ η u (shp ru) ws ∧ Lay σs u ru ws := fun ws hv1 => by
    refine ⟨?_, ⟨fun us' h => ?_, hsku, by simp [wc, hus], Valid_of_sig hsig.symm (Valid_vals _ vals ws hv1.vals hV0), hlyu⟩⟩
    · rw [shp_of_sig hsig]
      exact (VR_close hco ρ u [] 0 ρ (fun _ => 0) (shp (cl ρ η.wit 0 0 u)) ws (fun k => rfl)
        (fun k hk => absurd hk (Nat.not_lt_zero _))).2 (VR_up _ _ vals ws hv1 hvr0)
    · rw [hus] at h; cases h; rw [← hlen, hv1.length]
  refine ⟨us, hus, loadUnits_nonemptyP us 0 s vals hlen (PromOK_pp hpo) hlat', fun r hr hpa => ?_,
    vals, hfin vals (WLe_refl vals)⟩
  obtain ⟨hv1, hc1, _⟩ := loadUnits_latestPA hlen hlat' hr hpa
  obtain ⟨f1, f2, f3, f4⟩ := loadUnits_frame us 0 s r hr
  exact ⟨(hfin r.2 hv1).1, (hfin r.2 hv1).2, f1, f2, LoadCoh_of_eq hoo hc1, f3, f4⟩

/-- **P1 + P4 at the thread, `load` at an own pointer** (4d-5).  `hnw` picks
the rule (a word pointer is `loadWord`'s).  The pointee *at the thread's type
arguments* is not a protocol word either (TermRun re-types a load through a
word pointer as `Int`): `loadOwn` asks the pointee not be affine, and `FInv`'s
`KindsOK` closes that at word-free arguments. -/
theorem tstepM_loadOwn {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {acq : Bool} {a : At} {u : Ty} {e : Expr}
    (hterm : th.term = .let_ x (.load acq a) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.ptr .own u)) (hnw : wordOf (Ty.ptr .own u) = none)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | loadWord hp hw _ _ => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | loadPub hp _ hc _ _ _ => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | loadRgn hp _ hc _ _ _ => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | loadCap hp _ hc _ _ _ _ => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | loadTorn hp _ hc _ _ _ => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | loadOwn hp _ hc haf hb =>
  obtain ⟨t, u', hp, hc, haf, hb⟩ : ∃ t u', cx.peek a = .ok t ∧ cellOf t = some (.own, u') ∧
      affine cx.ke u' = false ∧ cx.bind x u' = .ok c' := ⟨_, _, hp, hc, haf, hb⟩
  rw [hpk] at hp; cases hp
  simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc; subst hc
  have hnwc : wordOf (close th.σs (.ptr .own u)) = none := by
    rw [close_ptr]; exact wordOf_ptr_of_wordFree (wordFree_close hi.2.2.2.2.2.1 u (wordFreeIn_of_affine u haf))
  obtain ⟨lab, c, pw, ru, hea, hpw, hsto, hcty, hacc, hown, hsku, hsig⟩ := ownPtr_view hi hpk htv (bind_opaqueOK hb)
  have hwr : wordOf (Ty.ptr .own ru) = none := by
    cases ru with
    | word r P =>
        obtain ⟨r', hX⟩ := eskel_word (show etok (skel (close th.σs u)) = .word (.lit 0) P by rw [← hsku]; rfl)
        rw [close_ptr, hX] at hnwc; simp [wordOf] at hnwc
    | _ => rfl
  have haf' : (cl ρ η.wit 0 0 u).arrFree = true := arrFree_cl hi.2.2.2.2.2.2.1.af u 0 0 (bind_arrFree hb)
  have hna : ∀ N e', c.ty ≠ .array (.lit N) e' := fun N e' h =>
    hacc (by rw [h]; simp [accs])
  obtain ⟨us, hus, ⟨r0, hr0⟩, hld, hstw⟩ := ownLoad (arch := g.arch) (pw := pw) (acq := acq) (s := stOf mem pairs th)
    hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hsto hown (Fd_lay hcty).1 (Fd_lay hcty).2.1
    (fun ws => ((Fd_lay hcty).2.2.2 ws).1) (fun R ws => (Fd_VR η hcty).1) hna hsku (peek_cell_lyt hi.2.1 hpk hea rfl rfl).2 hsig
    (by rw [(Fd_lay hcty).2.2.1]; exact pub_accs hi.2.2.2.1 hi.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi.2.1 htv hpk rfl (bind_opaqueOK hb) hea rfl)
  have key : tstep g mem pairs th =
      (loadUnits g.arch pw ⟨lab, 0⟩ acq us 0 (stOf mem pairs th)).map fun (s', ws) =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, ru, ws) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, cellOf, addrOf, hpw, hwr, Option.isSome_none,
      Bool.false_eq_true, ↓reduceIte, hus, List.map_map]; rfl
  rw [key]
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hr0), fun r hr hpr0 => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨⟨s', wsr⟩, hl, rfl⟩ := hr
  obtain ⟨hvr, hlay, f1, f2, f3, f4, f5⟩ := hld (s', wsr) hl (hpr0)
  exact ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv', bind_FInv hb hi hvr hlay, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩, MemInv_load hm f1 f2 f3 f4 f5 (loadUnits_relSt _ _ _ _ hl) (loadUnits_vWr _ _ _ _ hl)⟩

/-- **P1 + P4 at the thread, `store` at an own pointer** (4d-6). -/
theorem tstepM_storeOwn {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v : At} {tok : Option At}
    {u : Ty} {e : Expr}
    (hterm : th.term = .let_ x (.store rel a v tok) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.ptr .own u)) (hnw : wordOf (Ty.ptr .own u) = none)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | storeWordGive hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storeWordKeep hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storeWordHand hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storePub hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeRgn hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeCap hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeOwn hp _ hc hwf hu hsub hb =>
  obtain ⟨t, u', tv, c₁, hp, hc, hwf, hu, hsub, hb⟩ : ∃ t u' tv c₁, cx.peek a = .ok t ∧
      cellOf t = some (.own, u') ∧ Ty.wordFreeIn cx.ke u' = true ∧ cx.use v = .ok (tv, c₁) ∧
      SubS c₁ tv u' ∧ c₁.bind x .unit = .ok c' :=
    ⟨_, _, _, _, hp, hc, hwf, hu, hsub, hb⟩
  rw [hpk] at hp; cases hp
  simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc; subst hc
  have hotv : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have ho : cx.opaqueOK u = true := sub_opaqueOK hsub hotv
  have htb : tb cx.ke.length u = true := tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.ptr .own u) = some (.own, u))
  obtain ⟨lab, c, pw, ru, hea, hpw, hsto, hcty, hacc, hown, hsku, hsig⟩ := ownPtr_view hi hpk htv ho
  obtain ⟨hi1, rv, wsv, hev, hvv, hlv⟩ := use_FInv hu hi
  have hsigu : sig (close th.σs u) = sig (cl ρ η.wit 0 0 u) :=
    sig_WitL hi.2.2.2.1 ρ ho (lt_of_guardT htb hi.2.2.2.2.1)
  have hwcu : wc (cl ρ η.wit 0 0 u) ≠ none := by
    rw [← wc_of_sig hsigu]; exact (Lay_canon hsub hlv).2.2.2.1
  obtain ⟨us, hus⟩ : ∃ us, accs ru = some us := by
    have : wc ru ≠ none := by rw [wc_of_sig hsig]; exact hwcu
    cases h : accs ru with
    | none => simp [wc, h] at this
    | some us => exact ⟨us, rfl⟩
  obtain ⟨hval, hlen⟩ := ownStoreVal hE.2.1 hi.2.2.2.1 hi.2.2.2.2.1 hi1.1 hsub ho htb hvv hlv hsig hus
  have husA : accs c.ty = some us := ((Fd_lay hcty).2.2.1.trans (pub_accs hi.2.2.2.1 hi.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi.2.1 htv hpk rfl ho hea rfl).symm).trans hus
  have hus' : wc c.ty = some (nWords us) := by rw [(Fd_lay hcty).2.1, ← wc_of_sig hsig]; simp [wc, hus]
  replace hval := (Fd_EnvVal (CE η) hcty).2 hval
  have key : tstep g mem pairs th =
      (storeUnits g.k g.arch pw ⟨lab, 0⟩ rel us wsv 0 (stOf mem pairs th)).map fun s' =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, .unit, []) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hev, cellOf, addrOf, hpw, hus, List.map_map]; rfl
  rw [key]
  obtain ⟨s0, hs0⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := pw) (a := ⟨lab, 0⟩) (rel := rel)
    us wsv 0 (stOf mem pairs th) hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hs0), fun r hr => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨s', hs', rfl⟩ := hr
  exact ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv', bind_FInv hb hi1 unit_VR (unit_Lay _), retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
    MemInv_store hm hsto hown husA hval hlen s' hs'⟩

/-- **P1 + P4 at the thread, `xchg` at an own pointer** (4d-6): a plain load,
then a plain store of the new value; the old value comes out. -/
theorem tstepM_xchgOwn {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {a v : At} {u : Ty} {e : Expr}
    (hterm : th.term = .let_ x (.xchg a v) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.ptr .own u))
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | xchg hp hx hu hsub hb =>
  obtain ⟨t, u', o, tv, c₁, hp, hx, hu, hsub, hb⟩ : ∃ t u' o tv c₁, cx.peek a = .ok t ∧
      XchgCell cx t u' o ∧ cx.use v = .ok (tv, c₁) ∧ (SubS c₁ tv u' ∨ SubS c₁ tv o) ∧
      c₁.bind x o = .ok c' := ⟨_, _, _, _, _, hp, hx, hu, hsub, hb⟩
  rw [hpk] at hp; cases hp
  cases hx with
  | rgn _ hc _ _ _ => simp [cellOf] at hc
  | own _ hc _ =>
  simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc; subst hc
  have hsub : SubS c₁ tv u := hsub.elim id id
  have hotv : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have ho : cx.opaqueOK u = true := sub_opaqueOK hsub hotv
  have htb : tb cx.ke.length u = true := tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.ptr .own u) = some (.own, u))
  obtain ⟨lab, c, pw, ru, hea, hpw, hsto, hcty, hacc, hown, hsku, hsig⟩ := ownPtr_view hi hpk htv ho
  obtain ⟨hi1, rv, wsv, hev, hvv, hlv⟩ := use_FInv hu hi
  have haf' : (cl ρ η.wit 0 0 u).arrFree = true := arrFree_cl hi.2.2.2.2.2.2.1.af u 0 0 (bind_arrFree hb)
  have hna : ∀ N e', c.ty ≠ .array (.lit N) e' := fun N e' h =>
    hacc (by rw [h]; simp [accs])
  obtain ⟨us, hus, ⟨r0, hr0⟩, hld, hstw⟩ := ownLoad (arch := g.arch) (pw := pw) (acq := false) (s := stOf mem pairs th)
    hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hsto hown (Fd_lay hcty).1 (Fd_lay hcty).2.1
    (fun ws => ((Fd_lay hcty).2.2.2 ws).1) (fun R ws => (Fd_VR η hcty).1) hna hsku (peek_cell_lyt hi.2.1 hpk hea rfl rfl).2 hsig
    (by rw [(Fd_lay hcty).2.2.1]; exact pub_accs hi.2.2.2.1 hi.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi.2.1 htv hpk rfl ho hea rfl)
  obtain ⟨hval, hlen⟩ := ownStoreVal hE.2.1 hi.2.2.2.1 hi.2.2.2.2.1 hi1.1 hsub ho htb hvv hlv hsig hus
  have husA : accs c.ty = some us := ((Fd_lay hcty).2.2.1.trans (pub_accs hi.2.2.2.1 hi.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi.2.1 htv hpk rfl ho hea rfl).symm).trans hus
  have hus' : wc c.ty = some (nWords us) := by rw [(Fd_lay hcty).2.1, ← wc_of_sig hsig]; simp [wc, hus]
  replace hval := (Fd_EnvVal (CE η) hcty).2 hval
  have key : tstep g mem pairs th =
      ((loadUnits g.arch pw ⟨lab, 0⟩ false us 0 (stOf mem pairs th)).flatMap fun (s1, old) =>
        (storeUnits g.k g.arch pw ⟨lab, 0⟩ false us wsv 0 s1).map fun s2 => (s2, ru, old)).map
        fun (s', t, ws) => (s'.mem, s'.pairs, withS { th with term := e, env := (x, t, ws) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hev, cellOf, addrOf, hpw, hus]
  rw [key]
  have hm1 : ∀ r1, r1 ∈ loadUnits g.arch pw ⟨lab, 0⟩ false us 0 (stOf mem pairs th) → PromAbove r1.1 →
      MemInv g (CE η) r1.1 :=
    fun r1 h hp1 => by
      obtain ⟨_, _, f1, f2, f3, f4, f5⟩ := hld r1 h hp1
      exact MemInv_load hm f1 f2 f3 f4 f5 (loadUnits_relSt _ _ _ _ h) (loadUnits_vWr _ _ _ _ h)
  obtain ⟨s2, hs2⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := pw) (a := ⟨lab, 0⟩) (rel := false)
    us wsv 0 r0.1 hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem (List.mem_flatMap.2 ⟨r0, hr0, List.mem_map_of_mem hs2⟩)),
    fun r hr hpr0 => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨⟨s', t', ws'⟩, hr, rfl⟩ := hr
  rw [List.mem_flatMap] at hr
  obtain ⟨⟨s1, old⟩, h1, h2⟩ := hr
  rw [List.mem_map] at h2
  obtain ⟨s2, hs2, he2⟩ := h2
  simp only [Prod.mk.injEq] at he2
  obtain ⟨rfl, rfl, rfl⟩ := he2
  have hp2 : PromAbove s2 :=
    hpr0
  have hp1 : PromAbove s1 := storeUnits_promAbove hs2 hp2
  obtain ⟨hvr, hlay, -⟩ := hld (s1, old) h1 hp1
  exact ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv', bind_FInv hb hi1 hvr hlay, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
    MemInv_store (hm1 (s1, old) h1 hp1) hsto hown husA hval hlen s2 hs2⟩


/-! ## §8 Loading at a locative (T3c-5a-4)

A locative's target is a component of its cell (`AtOff`).  The cell's value
(`OwnOK`'s `ValOf`) is cut along the `AtOff` path down to the component's
words (`VR_at`); through `μ` this is `VR_cl_unfold`, and the layout facts
transfer by `sig_cl_unfold` (the body is guarded: `AtOff.mu`). -/


theorem splice_seg {α : Type} (L X : List α) (b w o : Nat) (hle : o + X.length ≤ w) :
    L.take b ++ (((L.drop b).take w).take o ++ X ++ ((L.drop b).take w).drop (o + X.length)) ++ L.drop (b + w) =
      L.take (b + o) ++ X ++ L.drop (b + o + X.length) := by
  have e1 : ((L.drop b).take w).take o = (L.drop b).take o := by rw [List.take_take]; congr 1; omega
  have e2 : ((L.drop b).take w).drop (o + X.length) ++ L.drop (b + w) = L.drop (b + o + X.length) := by
    rw [List.drop_take]
    have e3 : L.drop (b + w) = ((L.drop b).drop (o + X.length)).drop (w - (o + X.length)) := by
      rw [drop_drop', drop_drop']; congr 1; omega
    rw [e3, List.take_append_drop, drop_drop']; congr 1; omega
  rw [e1, List.take_add]
  simp only [List.append_assoc]
  rw [e2]

/-- (T3c-5b) **The target's segment.** -/
theorem own_seg {E : TEnv} {ini : AllocLabel → Nat} {a : Address} {c : Cell} {U : Ty} {vals : List Word}
    (hcell : CellOK E (ini a.label) c.ty vals) (hat : AtOff c.ty a.offset U) (hini : IniAt ini c a U)
    (hU : ∀ N e, U ≠ .array (.lit N) e) :
    ∃ b o S wS, SegOf c.ty b S ∧ b + o = a.offset ∧ AtOff S o U ∧ wc S = some wS ∧ b + wS ≤ vals.length ∧
      ValOf E S ((vals.drop b).take wS) := by
  rcases hcell with ⟨hwc, hv⟩ | ⟨N, e, us, hT, hus, hn, hlen, hslots⟩
  · refine ⟨0, a.offset, c.ty, vals.length, Or.inl ⟨rfl, rfl, by obtain ⟨_, h, -⟩ := wc_some hwc; simp [h]⟩, Nat.zero_add _, hat, hwc, by simp, ?_⟩
    simpa using hv
  · rcases hini N e hT with ⟨hUc, _⟩ | ⟨us', j, o, hus', hj, hjo, hato⟩
    · exact absurd (hUc.trans hT) (hU N e)
    · rw [hus] at hus'; cases hus'
      have hj' : j < ini a.label := hj
      have hjN : j + 1 ≤ N := by omega
      have hm := Nat.mul_le_mul_right (nWords us) hjN
      rw [Nat.succ_mul] at hm
      exact ⟨j * nWords us, o, e, nWords us, Or.inr ⟨N, us, j, hT, hus, by omega, rfl⟩, hjo, hato,
        wc_of_accs hus, by omega, hslots j hj'⟩

/-- (T3c-5b) **Putting a segment back.** -/
theorem CellOK_put {E : TEnv} {n : Nat} {T S : Ty} {b wS : Nat} {vals q : List Word}
    (hcell : CellOK E n T vals) (hseg : SegOf T b S) (hwS : wc S = some wS) (hbw : b + wS ≤ vals.length)
    (hq : ValOf E S q) (hql : q.length = wS) :
    CellOK E n T (vals.take b ++ q ++ vals.drop (b + wS)) := by
  rcases hcell with ⟨hwc, hv⟩ | ⟨N, e, us, hT, hus, hn, hlen, hslots⟩
  · rcases hseg with ⟨hb, hS, -⟩ | ⟨N, us, j, hT, -, -, -⟩
    · subst hb; subst hS
      rw [hwc] at hwS; cases hwS
      have e : vals.take 0 ++ q ++ vals.drop (0 + vals.length) = q := by simp
      rw [e]; exact Or.inl ⟨by rw [hwc, hql], hq⟩
    · exact absurd hT (notArr_of_wc hwc N S)
  · rcases hseg with ⟨hb, hS, -⟩ | ⟨N', us', j, hT', hus', hj, hb⟩
    · subst hS; rw [hT] at hwS; simp [wc, accs] at hwS
    · subst hb
      rw [hT] at hT'
      simp only [Ty.array.injEq, Idx.lit.injEq] at hT'
      obtain ⟨hN, hSe⟩ := hT'
      subst hN; subst hSe
      rw [hus] at hus'; cases hus'
      rw [wc_of_accs hus] at hwS; cases hwS
      refine Or.inr ⟨N, e, us, hT, hus, hn, ?_, fun j' hj' => ?_⟩
      · simp only [List.length_append, List.length_take, List.length_drop, hql]; omega
      · have hsl := fun (i : Nat) => slice_get (vals.take (j * nWords us) ++ q ++ vals.drop (j * nWords us + nWords us))
          (j' * nWords us) (nWords us) i
        by_cases hjj : j' = j
        · subst hjj
          have e : ((vals.take (j' * nWords us) ++ q ++ vals.drop (j' * nWords us + nWords us)).drop
              (j' * nWords us)).take (nWords us) = q := by
            apply List.ext_getElem?; intro i
            rw [hsl i, splice_get vals q _ _ _ hql hbw]
            by_cases hi : i < nWords us
            · rw [iteT hi, iteT ⟨Nat.le_add_right _ _, by omega⟩, Nat.add_sub_cancel_left]
            · rw [iteF hi, List.getElem?_eq_none (by omega)]
          rw [e]; exact hq
        · have e : ((vals.take (j * nWords us) ++ q ++ vals.drop (j * nWords us + nWords us)).drop
              (j' * nWords us)).take (nWords us) = (vals.drop (j' * nWords us)).take (nWords us) := by
            apply List.ext_getElem?; intro i
            rw [hsl i, slice_get vals]
            by_cases hi : i < nWords us
            · rw [iteT hi, iteT hi, splice_get vals q _ _ _ hql hbw, iteF ?_]
              intro hr; obtain ⟨hr1, hr2⟩ := hr
              rcases Nat.lt_or_gt_of_ne hjj with h | h
              · have hm := Nat.mul_le_mul_right (nWords us) (show j' + 1 ≤ j by omega)
                rw [Nat.succ_mul] at hm; omega
              · have hm := Nat.mul_le_mul_right (nWords us) (show j + 1 ≤ j' by omega)
                rw [Nat.succ_mul] at hm; omega
            · rw [iteF hi, iteF hi]
          rw [e]; exact hslots j' hj'

/-- (F2) The runtime pointee lays out as the closed static pointee: `accs` (cf. `sig_WitL`). -/
theorem accs_rtW {σs : List Ty} {ρ : Nat → Nat} {η : TEnv} {cx : Cx} {u ru : Ty} (hco : Coh η)
    (hW : WitL σs η.wit cx.opq) (hK : cx.ke.length ≤ σs.length) (ho : cx.opaqueOK u = true)
    (htb : tb cx.ke.length u = true) (hly : etok (lyt 0 ru) = etok (lyt 0 (close σs u))) :
    accs ru = accs (cl ρ η.wit 0 0 u) :=
  (accs_of_elyt hly).trans (accs_WitL hW (fun k => (hco k).1) ρ ho (lt_of_guardT htb hK))

/-- **Loading an own cell's component**: as `ownLoad`, at the component's
offset and words.  (F2) At a cell with a frontier, by `ownLoadAtF`. -/
theorem locLoad {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {s : St} {ad : Address} {c : Cell}
    {u ru : Ty} {arch : Arch} {pw : Word} {acq : Bool}
    (hco : Coh η) (hoo : OwnOKPF (CE η) s.mem s.pairs s.vs s.promises) (hpo : PromOK s)
    (hpi : PubInv (CE η) s) (hsto : η.sto ad.label = some c)
    (hown : c.owner = some η.tid) (hat : AtOff c.ty ad.offset (cl ρ η.wit 0 0 u))
    (hini : IniAt η.rc c ad (cl ρ η.wit 0 0 u)) (hna : ∀ N e, cl ρ η.wit 0 0 u ≠ .array (.lit N) e)
    (hsku : etok (skel ru) = etok (skel (close σs u))) (hsig : sig ru = sig (cl ρ η.wit 0 0 u))
    (hlyu : etok (lyt 0 ru) = etok (lyt 0 (close σs u))) (hacc : accs ru = accs (cl ρ η.wit 0 0 u)) :
    ∃ us, accs ru = some us ∧ (∃ r, r ∈ loadUnits arch pw ad acq us 0 s) ∧
      (∀ r, r ∈ loadUnits arch pw ad acq us 0 s → PromAbove r.1 →
        VR ρ η u (shp ru) r.2 ∧ Lay σs u ru r.2 ∧ r.1.mem = s.mem ∧ r.1.pairs = s.pairs ∧
        LoadCoh (CE η) s r.1 ∧ r.1.promises = s.promises ∧ r.1.nalloc = s.nalloc) ∧
      ∃ ws, VR ρ η u (shp ru) ws ∧ Lay σs u ru ws := by
  obtain ⟨vals, hcell, hlat0, -⟩ := hoo ad.label c hsto hown
  obtain ⟨b, oS, S, wS, -, hbo, hatS, hwS, hbw, ⟨hvr0, hV0⟩⟩ :=
    own_seg (E := CE η) (ini := η.rc) hcell hat hini hna
  have hsl : ((vals.drop b).take wS).length = wS := by
    simp only [List.length_take, List.length_drop]; omega
  have hlat : η.pfr ad.label = none → ∀ i v, ((vals.drop b).take wS)[i]? = some v →
      LatestP s.mem s.promises s.vs.coh ⟨ad.label, b + i⟩ v := by
    intro hp i v hi
    have h0 := hlat0 (b + i) v (by
      rw [slice_get] at hi
      by_cases hiw : i < wS
      · rw [iteT hiw] at hi; exact hi
      · rw [iteF hiw] at hi; cases hi)
    have hp0 : (CE η).pfr ad.label = none := hp
    rw [hp0] at h0; exact LatestSF_none h0
  generalize (vals.drop b).take wS = seg at hvr0 hV0 hsl hlat
  obtain ⟨n, hwn, hle, hvs, hVs⟩ := VR_at (CE η).unsee hatS hvr0 hV0 (by rw [hsl]; exact hwS)
  have hwcr : wc ru = some n := by rw [wc_of_sig hsig]; exact hwn
  obtain ⟨us, hus⟩ : ∃ us, accs ru = some us := by
    cases h : accs ru with
    | none => simp [wc, h] at hwcr
    | some us => exact ⟨us, rfl⟩
  have hn : nWords us = n := by simpa [wc, hus] using hwcr
  have hqlen : ((seg.drop oS).take n).length = nWords us := by simp; omega
  have hfin : ∀ ws, WLe ((seg.drop oS).take n) ws → VR ρ η u (shp ru) ws ∧ Lay σs u ru ws := fun ws hv1 => by
    refine ⟨?_, ⟨fun us' h => ?_, hsku, by simp [wc, hus], Valid_of_sig hsig.symm (Valid_vals _ _ ws hv1.vals hVs), hlyu⟩⟩
    · rw [shp_of_sig hsig]
      exact (VR_close hco ρ u [] 0 ρ (fun _ => 0) (shp (cl ρ η.wit 0 0 u)) ws (fun k => rfl)
        (fun k hk => absurd hk (Nat.not_lt_zero _))).2 (VR_up _ _ _ ws hv1 (ValOf.env (η := CE η) ⟨hvs, hVs⟩).1)
    · rw [hus] at h; cases h; rw [← hqlen, hv1.length]
  cases hp : η.pfr ad.label with
  | some f =>
    have husc : accs (cl ρ η.wit 0 0 u) = some us := by rw [← hacc, hus]
    have hfinF : ∀ q ws, ValOf (CE η) (cl ρ η.wit 0 0 u) q → WLe q ws → ws.length = nWords us →
        VR ρ η u (shp ru) ws ∧ Lay σs u ru ws := fun q ws hq hv1 hwl => by
      obtain ⟨hvr1, hV1⟩ := ValOf.env hq
      refine ⟨?_, ⟨fun us' h => ?_, hsku, by simp [wc, hus], Valid_of_sig hsig.symm (Valid_vals _ q ws hv1.vals hV1), hlyu⟩⟩
      · rw [shp_of_sig hsig]
        exact (VR_close hco ρ u [] 0 ρ (fun _ => 0) (shp (cl ρ η.wit 0 0 u)) ws (fun k => rfl)
          (fun k hk => absurd hk (Nat.not_lt_zero _))).2 (VR_up _ _ q ws hv1 hvr1)
      · rw [hus] at h; cases h; exact hwl
    obtain ⟨hne, hld, -⟩ := ownLoadAtF (E := CE η) (arch := arch) (pw := pw) (acq := acq) hoo hpi.2.1 hpi.2.2.1
      hsto hown hp hat hini hna husc
    refine ⟨us, hus, hne, fun r hr hpa => ?_, _, hfin _ (WLe_refl _)⟩
    obtain ⟨q, hq, hle', hrl⟩ := hld r hr hpa
    obtain ⟨f1, f2, f3, f4⟩ := loadUnits_frame us 0 s r hr
    have hF := hfinF q r.2 hq hle' hrl
    exact ⟨hF.1, hF.2, f1, f2, LoadCoh_load hr hpa hoo ⟨c, hsto⟩, f3, f4⟩
  | none =>
  have hlat' : ∀ j v, ((seg.drop oS).take n)[j]? = some v →
      LatestP s.mem s.promises s.vs.coh (offs ad (0 + j)) v := by
    intro j v hj
    have hj' : seg[oS + j]? = some v := by
      by_cases hjn : j < n
      · rw [List.getElem?_take_of_lt hjn, List.getElem?_drop] at hj; exact hj
      · rw [List.getElem?_eq_none (by simp; omega)] at hj; cases hj
    have e : offs ad (0 + j) = ⟨ad.label, b + (oS + j)⟩ := by
      simp only [offs, Nat.zero_add]; rw [← Nat.add_assoc, hbo]
    rw [e]; exact hlat hp _ v hj'
  refine ⟨us, hus, loadUnits_nonemptyP us 0 s _ hqlen (PromOK_pp hpo) hlat', fun r hr hpa => ?_,
    _, hfin _ (WLe_refl _)⟩
  obtain ⟨hv1, hc1, _⟩ := loadUnits_latestPA hqlen hlat' hr hpa
  obtain ⟨f1, f2, f3, f4⟩ := loadUnits_frame us 0 s r hr
  exact ⟨(hfin r.2 hv1).1, (hfin r.2 hv1).2, f1, f2, LoadCoh_of_eq hoo hc1, f3, f4⟩

/-- (F2′) **`locLoad` at the reader-visible count** (a `pub` locative into an
own cell): below the real count it is `locLoad`; at a planted slot the cell has
a frontier, unseen (`OwnHidP` part 2), which the pointer's view is past
(`hfv`, from `ModeOK`), and the load is `plantLoadAtV`. -/
theorem locLoadI {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {s : St} {ad : Address} {c : Cell}
    {u ru : Ty} {arch : Arch} {pw : Word} {acq : Bool}
    (hco : Coh η) (hoo : OwnOKPF (CE η) s.mem s.pairs s.vs s.promises) (hpo : PromOK s)
    (hpi : PubInv (CE η) s) (hoh : OwnHidP (CE η) s.mem s.vs s.promises) (hsto : η.sto ad.label = some c)
    (hown : c.owner = some η.tid) (hat : AtOff c.ty ad.offset (cl ρ η.wit 0 0 u))
    (hini : IniAt η.ini c ad (cl ρ η.wit 0 0 u)) (hna : ∀ N e, cl ρ η.wit 0 0 u ≠ .array (.lit N) e)
    (hfv : ¬ IniAt η.rc c ad (cl ρ η.wit 0 0 u) → ∀ f, η.pfr ad.label = some f → ¬ η.seen ad.label →
      f ≤ pw.view)
    (hsku : etok (skel ru) = etok (skel (close σs u))) (hsig : sig ru = sig (cl ρ η.wit 0 0 u))
    (hlyu : etok (lyt 0 ru) = etok (lyt 0 (close σs u))) (hacc : accs ru = accs (cl ρ η.wit 0 0 u)) :
    ∃ us, accs ru = some us ∧ (∃ r, r ∈ loadUnits arch pw ad acq us 0 s) ∧
      (∀ r, r ∈ loadUnits arch pw ad acq us 0 s → PromAbove r.1 →
        VR ρ η u (shp ru) r.2 ∧ Lay σs u ru r.2 ∧ r.1.mem = s.mem ∧ r.1.pairs = s.pairs ∧
        LoadCoh (CE η) s r.1 ∧ r.1.promises = s.promises ∧ r.1.nalloc = s.nalloc) ∧
      ∃ ws, VR ρ η u (shp ru) ws ∧ Lay σs u ru ws := by
  by_cases hir : IniAt η.rc c ad (cl ρ η.wit 0 0 u)
  · exact locLoad hco hoo hpo hpi hsto hown hat hir hna hsku hsig hlyu hacc
  have hrc : η.rc ad.label < η.ini ad.label := Nat.lt_of_not_le fun hle => hir (IniAt_monoAt hle hini)
  obtain ⟨f, hf, hns, -⟩ := hoh.2 ad.label c hsto hown hrc
  have hfv' := fun hz => hfv hir f hf (hns hz)
  have hlU : accs (cl ρ η.wit 0 0 u) ≠ none := by
    rcases AtOff_lay hat with h | ⟨N, e', h, -⟩
    · exact h
    · exact absurd h (hna N e')
  obtain ⟨us, hus⟩ : ∃ us, accs ru = some us := Option.ne_none_iff_exists'.1 (by rw [hacc]; exact hlU)
  have husc : accs (cl ρ η.wit 0 0 u) = some us := by rw [← hacc, hus]
  obtain ⟨hne, hld, q0, hq0, hq0l⟩ := plantLoadAtV (E := CE η) (arch := arch) (pw := pw) (acq := acq)
    hpi hoo hoh hsto hown hf (fun hz _ => Nat.le_trans (hfv' hz) (Nat.le_max_left _ _)) hat hini hir hna husc
  have hfinF : ∀ q ws, ValOf (CE η) (cl ρ η.wit 0 0 u) q → WLe q ws → ws.length = nWords us →
      VR ρ η u (shp ru) ws ∧ Lay σs u ru ws := fun q ws hq hv1 hwl => by
    obtain ⟨hvr1, hV1⟩ := ValOf.env hq
    refine ⟨?_, ⟨fun us' h => ?_, hsku, by simp [wc, hus], Valid_of_sig hsig.symm (Valid_vals _ q ws hv1.vals hV1), hlyu⟩⟩
    · rw [shp_of_sig hsig]
      exact (VR_close hco ρ u [] 0 ρ (fun _ => 0) (shp (cl ρ η.wit 0 0 u)) ws (fun k => rfl)
        (fun k hk => absurd hk (Nat.not_lt_zero _))).2 (VR_up _ _ q ws hv1 hvr1)
    · rw [hus] at h; cases h; exact hwl
  refine ⟨us, hus, hne, fun r hr hpa => ?_, _, hfinF q0 q0 hq0 (WLe_refl _) hq0l⟩
  obtain ⟨q, hq, hle', hrl⟩ := hld r hr hpa
  obtain ⟨f1, f2, f3, f4⟩ := loadUnits_frame us 0 s r hr
  have hF := hfinF q r.2 hq hle' hrl
  exact ⟨hF.1, hF.2, f1, f2, LoadCoh_load hr hpa hoo ⟨c, hsto⟩, f3, f4⟩

/-- **P1 + P4 at the thread, `load` at an own locative** (T3c-5a-4).  The
locative is not null: its target is not an array (`bind` asks `arrFree`, and
the witnesses are array-free, `WitAF`). -/
theorem tstepM_loadLoc {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {acq : Bool} {a : At} {u : Ty} {e : Expr}
    (hterm : th.term = .let_ x (.load acq a) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.loc .own u)) (hnw : wordOf (Ty.loc .own u) = none)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | loadWord hp hw _ _ => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | loadPub hp _ hc _ _ _ => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | loadRgn hp _ hc _ _ _ => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | loadCap hp _ hc _ _ _ _ => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | loadTorn hp _ hc _ _ _ => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | loadOwn hp _ hc haf hb =>
  obtain ⟨t, u', hp, hc, haf, hb⟩ : ∃ t u', cx.peek a = .ok t ∧ cellOf t = some (.own, u') ∧
      affine cx.ke u' = false ∧ cx.bind x u' = .ok c' := ⟨_, _, hp, hc, haf, hb⟩
  rw [hpk] at hp; cases hp
  simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc; subst hc
  obtain ⟨rt, ws, hea, hv, hl⟩ := peek_VR hi.2.1 hpk
  have haf' : (cl ρ η.wit 0 0 u).arrFree = true := arrFree_cl hi.2.2.2.2.2.2.1.af u 0 0 (bind_arrFree hb)
  have hnb : ∀ n e, ¬ Fd (.array (.lit n) e) (cl ρ η.wit 0 0 u) := fun n e hF => by
    have := Fd_arrFree hF haf'; simp [Ty.arrFree] at this
  obtain ⟨ad, c, hws, hsto, hat, hmode, hini⟩ :=
    cell_target (rfl : cellOf (.loc .own u) = some (.own, u)) hnb hv
  obtain ⟨pw, rfl, hpw⟩ := map_singleton hws
  have hsk := hl.2.1
  obtain ⟨μr, ru, rfl, -, hsku⟩ : ∃ μr ru, rt = .loc μr ru ∧ skelM μr = skelM .own ∧
      etok (skel ru) = etok (skel (close th.σs u)) := by
    simp only [close, substTs, skel, etok] at hsk
    obtain ⟨μr, ru, rfl, h1, h2⟩ := eskel_eq_loc hsk
    exact ⟨μr, ru, rfl, h1, h2⟩
  have hwf := wordFree_close hi.2.2.2.2.2.1 u (wordFreeIn_of_affine u haf)
  have hwr : wordOf (Ty.loc μr ru) = none := by
    cases ru with
    | word r P =>
        obtain ⟨r', hX⟩ := eskel_word (show etok (skel (close th.σs u)) = .word (.lit 0) P by rw [← hsku]; rfl)
        rw [hX] at hwf; simp [Ty.wordFree, Ty.wordFreeIn] at hwf
    | _ => rfl
  have htb : tb cx.ke.length u = true :=
    tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.loc .own u) = some (.own, u))
  have hsig : sig ru = sig (cl ρ η.wit 0 0 u) := by
    have h1 : sig ru = sig (close th.σs u) := sig_of_eskel hsku
    rw [h1]; exact sig_WitL hi.2.2.2.1 ρ (bind_opaqueOK hb) (lt_of_guardT htb hi.2.2.2.2.1)
  have hna : ∀ N e', cl ρ η.wit 0 0 u ≠ .array (.lit N) e' := fun N e' h => by
    rw [h] at haf'; simp [Ty.arrFree] at haf'
  obtain ⟨us, hus, ⟨r0, hr0⟩, hld, hstw⟩ := locLoad (arch := g.arch) (pw := pw) (acq := acq)
    (s := stOf mem pairs th) hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hsto hmode hat hini hna hsku hsig
      (cell_lyt hl.2.2.2.2 rfl rfl).2
        (accs_rtW hE.2.1 hi.2.2.2.1 hi.2.2.2.2.1 (bind_opaqueOK hb) htb (cell_lyt hl.2.2.2.2 rfl rfl).2)
  have key : tstep g mem pairs th =
      (loadUnits g.arch pw ad acq us 0 (stOf mem pairs th)).map fun (s', ws) =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, ru, ws) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, cellOf, addrOf, hpw, hwr, Option.isSome_none,
      Bool.false_eq_true, ↓reduceIte, hus, List.map_map]; rfl
  rw [key]
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hr0), fun r hr hpr0 => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨⟨s', wsr⟩, hl', rfl⟩ := hr
  obtain ⟨hvr, hlay, f1, f2, f3, f4, f5⟩ := hld (s', wsr) hl' (hpr0)
  exact ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv', bind_FInv hb hi hvr hlay, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩, MemInv_load hm f1 f2 f3 f4 f5 (loadUnits_relSt _ _ _ _ hl') (loadUnits_vWr _ _ _ _ hl')⟩

/-! ## §9 Storing at a locative (T3c-5a-4)

The converse of §8: a value of the component type, put into the cell's value at
the component's offset (`VR_put`), gives a value of the cell's type.  Through
`μ` this is the guarded direction, `VR_cl_fold` (`VR_unfold`).  The store then
keeps `OwnOK`: the component's words are latest, the others untouched
(`OwnOK_storeAt`). -/

theorem splice_split {α : Type} (X Y q : List α) (o : Nat) (h : o + q.length ≤ X.length) :
    (X ++ Y).take o ++ q ++ (X ++ Y).drop (o + q.length) = X.take o ++ q ++ X.drop (o + q.length) ++ Y := by
  rw [List.take_append_of_le_length (by omega), List.drop_append_of_le_length h]
  simp only [List.append_assoc]

theorem splice_snd {α : Type} (X Y q : List α) (o : Nat) :
    (X ++ Y).take (X.length + o) ++ q ++ (X ++ Y).drop (X.length + o + q.length) =
      X ++ (Y.take o ++ q ++ Y.drop (o + q.length)) := by
  rw [Nat.add_assoc, List.take_append, List.drop_append, List.take_of_length_le (by omega),
    List.drop_of_length_le (by omega), Nat.add_sub_cancel_left, Nat.add_sub_cancel_left]
  simp

theorem VR_prod_mk {ρ : Nat → Nat} {η : TEnv} {a b : Ty} {A B : List Word} {na : Nat}
    (hA : VR ρ η a (shp a) A) (hB : VR ρ η b (shp b) B) (hl : A.length = na) (hw : wc a = some na) :
    VR ρ η (.prod a b) (shp (.prod a b)) (A ++ B) := by
  subst hl
  simp only [VR]
  refine ⟨shp a, shp b, rfl, fun m hm => ?_⟩
  rw [shp_wc, hw] at hm
  obtain rfl := Option.some.inj hm
  exact ⟨by simp, by simpa using hA, by simpa using hB⟩

theorem Valid_prod_mk {a b : Ty} {A B : List Word} {na : Nat}
    (hA : Valid a A) (hB : Valid b B) (hl : A.length = na) (hw : wc a = some na) :
    Valid (.prod a b) (A ++ B) := by
  subst hl
  simp only [Valid]
  intro m hm
  rw [hw] at hm
  obtain rfl := Option.some.inj hm
  exact ⟨by simpa using hA, by simpa using hB⟩

/-- **Putting a component back**: replacing the words at offset `o` of a value
of a laid-out type by a value of the component type gives a value of the type. -/
theorem VR_put (E : TEnv) {ρ₀ : Nat → Nat} {T U : Ty} {o : Nat} (h : AtOff T o U) :
    ∀ {ws q : List Word}, VR ρ₀ (CE E) T (shp T) ws → Valid T ws → wc T = some ws.length →
      VR ρ₀ (CE E) U (shp U) q → Valid U q → wc U = some q.length →
      o + q.length ≤ ws.length ∧ VR ρ₀ (CE E) T (shp T) (ws.take o ++ q ++ ws.drop (o + q.length)) ∧
        Valid T (ws.take o ++ q ++ ws.drop (o + q.length)) := by
  induction h with
  | here _ =>
      intro ws q _ _ hwc hq hQ hwq
      rw [hwc] at hwq
      have hl := (Option.some.inj hwq).symm
      have e : ws.take 0 ++ q ++ ws.drop (0 + q.length) = q := by rw [hl]; simp
      refine ⟨by omega, ?_, ?_⟩ <;> rw [e] <;> assumption
  | @fst a b u o _ ih =>
      intro ws q hv hV hwc hq hQ hwq
      simp only [VR] at hv; simp only [Valid] at hV
      obtain ⟨ra, rb, e, hsplit⟩ := hv
      simp only [shp, Shp.prod.injEq] at e
      obtain ⟨rfl, rfl⟩ := e
      cases ha : accs a with
      | none => simp [wc, accs, ha] at hwc
      | some ua =>
      cases hb : accs b with
      | none => simp [wc, accs, ha, hb] at hwc
      | some ub =>
      have hwa : wc a = some (nWords ua) := by simp [wc, ha]
      have hlen : ws.length = nWords ua + nWords ub := by
        simp [wc, accs, ha, hb, nWords_append] at hwc; omega
      obtain ⟨_, hva, hvb⟩ := hsplit _ (by rw [shp_wc]; exact hwa)
      obtain ⟨hVa, hVb⟩ := hV _ hwa
      have hla : (ws.take (nWords ua)).length = nWords ua := by simp; omega
      obtain ⟨hle, hva', hVa'⟩ := ih hva hVa (by rw [hla]; exact hwa) hq hQ hwq
      rw [hla] at hle
      have hsp : ws.take o ++ q ++ ws.drop (o + q.length) =
          (ws.take (nWords ua)).take o ++ q ++ (ws.take (nWords ua)).drop (o + q.length) ++
            ws.drop (nWords ua) := by
        conv => lhs; rw [← List.take_append_drop (nWords ua) ws]
        exact splice_split _ _ q o (by rw [hla]; exact hle)
      have hlA : ((ws.take (nWords ua)).take o ++ q ++ (ws.take (nWords ua)).drop (o + q.length)).length =
          nWords ua := by simp; omega
      rw [hsp]
      exact ⟨by omega, VR_prod_mk hva' hvb hlA hwa, Valid_prod_mk hVa' hVb hlA hwa⟩
  | @snd a b u o ua0 hua _ ih =>
      intro ws q hv hV hwc hq hQ hwq
      simp only [VR] at hv; simp only [Valid] at hV
      obtain ⟨ra, rb, e, hsplit⟩ := hv
      simp only [shp, Shp.prod.injEq] at e
      obtain ⟨rfl, rfl⟩ := e
      cases hb : accs b with
      | none => simp [wc, accs, hua, hb] at hwc
      | some ub =>
      have hwa : wc a = some (nWords ua0) := by simp [wc, hua]
      have hwb : wc b = some (nWords ub) := by simp [wc, hb]
      have hlen : ws.length = nWords ua0 + nWords ub := by
        simp [wc, accs, hua, hb, nWords_append] at hwc; omega
      obtain ⟨_, hva, hvb⟩ := hsplit _ (by rw [shp_wc]; exact hwa)
      obtain ⟨hVa, hVb⟩ := hV _ hwa
      have hla : (ws.take (nWords ua0)).length = nWords ua0 := by simp; omega
      have hlb : (ws.drop (nWords ua0)).length = nWords ub := by simp; omega
      obtain ⟨hle, hvb', hVb'⟩ := ih hvb hVb (by rw [hlb]; exact hwb) hq hQ hwq
      rw [hlb] at hle
      have hsp : ws.take (nWords ua0 + o) ++ q ++ ws.drop (nWords ua0 + o + q.length) =
          ws.take (nWords ua0) ++ ((ws.drop (nWords ua0)).take o ++ q ++ (ws.drop (nWords ua0)).drop (o + q.length)) := by
        conv => lhs; rw [← List.take_append_drop (nWords ua0) ws]
        have := splice_snd (ws.take (nWords ua0)) (ws.drop (nWords ua0)) q o
        rwa [hla] at this
      rw [hsp]
      exact ⟨by omega, VR_prod_mk hva hvb' hla hwa, Valid_prod_mk hVa hVb' hla hwa⟩
  | elem _ _ _ _ => intro ws q _ _ hwc; simp [wc, accs] at hwc
  | @mu ρ W s u o hW hg _ ih =>
      intro ws q hv hV hwc hq hQ hwq
      have hsig := sig_cl_unfold (ρ := ρ) (W := W) hg
      have e1 : cl ρ W 0 0 (.mu s) = .mu (cl ρ W 1 0 s) := rfl
      have hshp : shp (cl ρ W 0 0 (unfold1 (.mu s))) = shp (cl ρ W 0 0 (.mu s)) := by
        rw [shp_of_sig hsig, e1]; rfl
      have hv' := VR_cl_unfold E hW hv
      rw [← hshp] at hv'
      have hV0 : Valid (cl ρ W 1 0 s) ws := by rw [e1] at hV; exact hV
      have hwc' : wc (cl ρ W 0 0 (unfold1 (.mu s))) = some ws.length := by
        rw [wc_of_sig hsig, ← hwc, e1]; rfl
      obtain ⟨hle, hv2, hV2⟩ := ih hv' (Valid_of_sig hsig.symm hV0) hwc' hq hQ hwq
      refine ⟨hle, ?_, ?_⟩
      · rw [hshp] at hv2; exact VR_cl_fold E hW hg hv2
      · rw [e1]; show Valid (cl ρ W 1 0 s) _; exact Valid_of_sig hsig hV2
  | @fold ρ W s T o hW hg ha _ ih =>
      intro ws q hv hV hwc hq hQ hwq
      have hsig := sig_cl_unfold (ρ := ρ) (W := W) hg
      have e1 : cl ρ W 0 0 (.mu s) = .mu (cl ρ W 1 0 s) := rfl
      have hshp : shp (cl ρ W 0 0 (unfold1 (.mu s))) = shp (cl ρ W 0 0 (.mu s)) := by
        rw [shp_of_sig hsig, e1]; rfl
      have hq' := VR_cl_unfold E hW hq
      rw [← hshp] at hq'
      have hQ0 : Valid (cl ρ W 1 0 s) q := by rw [e1] at hQ; exact hQ
      have hwq' : wc (cl ρ W 0 0 (unfold1 (.mu s))) = some q.length := by
        rw [wc_of_sig hsig, ← hwq, e1]; rfl
      exact ih hv hV hwc hq' (Valid_of_sig hsig.symm hQ0) hwq'


/-- (S4) **A promise a store discharges is at a one-word unit** of the store
(a pair store appends, `stepStorePair`). -/
theorem storeUnits_fulOne {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s s' : St), PromLt s →
      s' ∈ storeUnits k arch pw a rel us ws i s →
      ∀ t, t ∈ s.promises → t ∉ s'.promises → ∃ (m : Msg) (j : Nat), s.mem[t]? = some m ∧
        m.loc = offs a (i + j) ∧ OneAt us j
  | [], _, _, s, s', hpl, hs => by
      simp only [storeUnits, List.mem_singleton] at hs; subst hs
      exact fun t h1 h2 => absurd h1 h2
  | .one :: us, w :: ws, i, s, s', hpl, hs => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      obtain ⟨t0, hcase, -, -, -⟩ := stepStore_casesC hst
      have hpl1 : PromLt { s with mem := mem', vs := th.vs, promises := th.promises } := by
        rcases hcase with ⟨hmem, -, hprom⟩ | ⟨hmem, -, hprom, -⟩
        · intro t ht
          have ht' : t ∈ s.promises := by have : t ∈ th.promises := ht; rw [hprom] at this; exact this
          show t < mem'.size
          rw [hmem, Array.size_push]; exact Nat.lt_succ_of_lt (hpl t ht')
        · intro t ht
          have ht' : t ∈ s.promises := by
            have : t ∈ th.promises := ht; rw [hprom] at this; exact List.mem_of_mem_erase this
          show t < mem'.size
          rw [hmem]; exact hpl t ht'
      have hold : ∀ t m, t < s.mem.size → mem'[t]? = some m → s.mem[t]? = some m := by
        intro t m ht hm
        rcases hcase with ⟨hmem, -⟩ | ⟨hmem, -⟩
        · rw [hmem, push_lt ht] at hm; exact hm
        · rw [hmem] at hm; exact hm
      intro t ht hn
      by_cases h1 : t ∈ th.promises
      · obtain ⟨m, j, hm, hl, ho⟩ := storeUnits_fulOne us ws (i + 1) _ s' hpl1 hs t h1 hn
        exact ⟨m, j + 1, hold t m (hpl t ht) hm, by rw [hl, show i + 1 + j = i + (j + 1) by omega],
          by simpa [Acc.size] using OneAt_cons Acc.one ho⟩
      · rcases hcase with ⟨-, -, hprom⟩ | ⟨hmem, htp, hprom, hlt, m, hm, hma, hmv, hmv'⟩
        · exact absurd (by rw [hprom]; exact ht) h1
        · have e : t = t0 := Classical.byContradiction fun hne =>
            h1 (by rw [hprom]; exact (List.mem_erase_of_ne hne).2 ht)
          subst e
          exact ⟨m, 0, hm, by rw [hma]; rfl, ⟨0, by simp, by simp [nWords]⟩⟩
  | .two :: us, w0 :: w1 :: ws, i, s, s', hpl, hs => by
      simp only [storeUnits] at hs
      obtain ⟨q1, _, _, q4, q5⟩ := stepStorePair_eq s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel
      generalize Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0) (dataE 2 w1) [0] rel = R at q1 q4 q5 hs
      obtain ⟨mem', pairs', th⟩ := R
      simp only at q1 q4 q5 hs
      have hpl1 : PromLt { s with mem := mem', pairs := pairs', vs := th.vs, promises := th.promises } := by
        intro t ht
        have ht' : t ∈ s.promises := by have : t ∈ th.promises := ht; rw [q4] at this; exact this
        show t < mem'.size
        rw [q1, Array.size_push, Array.size_push]; exact Nat.lt_succ_of_lt (Nat.lt_succ_of_lt (hpl t ht'))
      intro t ht hn
      obtain ⟨m, j, hm, hl, ho⟩ := storeUnits_fulOne us ws (i + 2) _ s' hpl1 hs t
        (by show t ∈ th.promises; rw [q4]; exact ht) hn
      have hlt := hpl t ht
      refine ⟨m, j + 2, ?_, by rw [hl, show i + 2 + j = i + (j + 2) by omega],
        by simpa [Acc.size] using OneAt_cons Acc.two ho⟩
      have : mem'[t]? = some m := hm
      rw [q1, push2_lt hlt] at this; exact this
  | .one :: _, [], _, _, _, _, hs => by simp [storeUnits] at hs
  | .two :: _, [], _, _, _, _, hs => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, _, _, hs => by simp [storeUnits] at hs

/-- Where a store's new message at offset `j` (of `us`, from word `i` of `a`)
sits: a one-word unit; the first word of a pair (a pair start, with its second
word next); or the second word of a pair started at or past `M0`. -/
def NewRole (us : List Acc) (a : Address) (i M0 : Nat) (s' : St) (t j : Nat) : Prop :=
  OneAt us j ∨
  (TwoAt us j ∧ t ∈ s'.pairs ∧ ∃ m1 : Msg, s'.mem[t + 1]? = some m1 ∧ m1.loc = offs a (i + j + 1)) ∨
  (∃ (jj q : Nat) (m0 : Msg), j = jj + 1 ∧ TwoAt us jj ∧ t = q + 1 ∧ M0 ≤ q ∧ q ∈ s'.pairs ∧
    s'.mem[q]? = some m0 ∧ m0.loc = offs a (i + jj))

theorem NewRole_cons {us : List Acc} {a : Address} {i M0 M1 : Nat} {s' : St} {t j : Nat} (u : Acc)
    (hM : M0 ≤ M1) (h : NewRole us a (i + u.size) M1 s' t j) : NewRole (u :: us) a i M0 s' t (j + u.size) := by
  rcases h with h | ⟨h1, h2, m1, h3, h4⟩ | ⟨jj, q, m0, h1, h2, h3, h4, h5, h6, h7⟩
  · exact Or.inl (OneAt_cons u h)
  · exact Or.inr (Or.inl ⟨TwoAt_cons u h1, h2, m1, h3, by rw [h4, show i + u.size + j + 1 = i + (j + u.size) + 1 by omega]⟩)
  · exact Or.inr (Or.inr ⟨jj + u.size, q, m0, by omega, TwoAt_cons u h2, h3, by omega, h5, h6,
      by rw [h7, show i + u.size + jj = i + (jj + u.size) by omega]⟩)

/-- **Where a store's new messages are** (no assumption on promises): memory
only grows, and each new message is at a unit word of the store, in its role. -/
theorem storeUnits_roles {k : Promises.Knobs} {arch : Arch} {pw : Word} {a : Address} {rel : Bool} :
    ∀ (us : List Acc) (ws : List Word) (i : Nat) (s s' : St), s' ∈ storeUnits k arch pw a rel us ws i s →
      s.mem.size ≤ s'.mem.size ∧ (∀ t, t < s.mem.size → s'.mem[t]? = s.mem[t]?) ∧
      ∀ (t : Nat) (m : Msg), s.mem.size ≤ t → s'.mem[t]? = some m →
        ∃ j, m.loc = offs a (i + j) ∧ NewRole us a i s.mem.size s' t j
  | [], _, _, s, s', hs => by
      simp only [storeUnits, List.mem_singleton] at hs; subst hs
      exact ⟨Nat.le_refl _, fun _ _ => rfl, fun t m ht hm => absurd (lt_of_get hm) (by omega)⟩
  | .one :: us, w :: ws, i, s, s', hs => by
      simp only [storeUnits, List.mem_flatMap] at hs
      obtain ⟨⟨mem', th⟩, hst, hs⟩ := hs
      obtain ⟨g1, g2, g3⟩ := storeUnits_roles us ws (i + 1) _ s' hs
      have g1' : mem'.size ≤ s'.mem.size := g1
      have g2' : ∀ t, t < mem'.size → s'.mem[t]? = mem'[t]? := g2
      have g3' : ∀ (t : Nat) (m : Msg), mem'.size ≤ t → s'.mem[t]? = some m →
          ∃ j, m.loc = offs a (i + 1 + j) ∧ NewRole us a (i + 1) mem'.size s' t j := g3
      obtain ⟨t0, hcase, _⟩ := stepStore_cases hst
      have hsz : s.mem.size ≤ mem'.size ∧ (∀ t, t < s.mem.size → mem'[t]? = s.mem[t]?) ∧
          ∀ (t : Nat) (m : Msg), s.mem.size ≤ t → mem'[t]? = some m → m.loc = offs a i := by
        rcases hcase with ⟨rfl, -, -⟩ | ⟨rfl, -⟩
        · refine ⟨by simp, fun t ht => push_lt ht, fun t m ht hm => ?_⟩
          have hlt := lt_of_get hm
          simp only [Array.size_push] at hlt
          have e : t = s.mem.size := by omega
          subst e
          simp at hm
          rw [← hm]
        · exact ⟨Nat.le_refl _, fun _ _ => rfl, fun t m ht hm => absurd (lt_of_get hm) (by omega)⟩
      obtain ⟨q1, q2, q3⟩ := hsz
      refine ⟨Nat.le_trans q1 g1', fun t ht => by rw [g2' t (Nat.lt_of_lt_of_le ht q1)]; exact q2 t ht,
        fun t m ht hm => ?_⟩
      by_cases h1 : mem'.size ≤ t
      · obtain ⟨j, hj, hr⟩ := g3' t m h1 hm
        exact ⟨j + 1, by rw [hj, show i + 1 + j = i + (j + 1) by omega], NewRole_cons .one q1 hr⟩
      · have hm' : mem'[t]? = some m := by rw [← g2' t (by omega)]; exact hm
        exact ⟨0, q3 t m ht hm', Or.inl ⟨0, rfl, by simp [nWords]⟩⟩
  | .two :: us, w0 :: w1 :: ws, i, s, s', hs => by
      simp only [storeUnits] at hs
      obtain ⟨g1, g2, g3⟩ := storeUnits_roles us ws (i + 2) _ s' hs
      have hpp := storeUnits_pairs us ws (i + 2) _ s' hs
      obtain ⟨q1, q2, -, -, -⟩ := stepStorePair_eq s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0)
        (dataE 2 w1) [0] rel
      generalize Promises.stepStorePair s.mem s.pairs (mth s pw w0 w1) (offs a i) (dataE 1 w0)
        (dataE 2 w1) [0] rel = R at g1 g2 g3 hpp q1 q2
      have g1' : R.1.size ≤ s'.mem.size := g1
      have g2' : ∀ t, t < R.1.size → s'.mem[t]? = R.1[t]? := g2
      have g3' : ∀ (t : Nat) (m : Msg), R.1.size ≤ t → s'.mem[t]? = some m →
          ∃ j, m.loc = offs a (i + 2 + j) ∧ NewRole us a (i + 2) R.1.size s' t j := g3
      have hpp' : ∀ p ∈ R.2.1, p ∈ s'.pairs := hpp
      have hsz : R.1.size = s.mem.size + 2 := by rw [q1]; simp
      have hold : ∀ t, t < s.mem.size → R.1[t]? = s.mem[t]? := fun t ht => by
        rw [q1, push_lt (by simp; omega), push_lt ht]
      have h0 : ∀ m, R.1[s.mem.size]? = some m → m.loc = offs a i := by
        intro m hm; rw [q1, push_lt (by simp)] at hm; simp at hm; rw [← hm]
      have h1 : ∀ m, R.1[s.mem.size + 1]? = some m → m.loc = offs a (i + 1) := by
        intro m hm; rw [q1, Array.getElem?_push, if_pos (by simp)] at hm; rw [← Option.some.inj hm]
        simp [offs, WeakMem.Address.next, Nat.add_assoc]
      have ex0 : ∃ m, R.1[s.mem.size]? = some m := by rw [q1, push_lt (by simp)]; simp
      have ex1 : ∃ m, R.1[s.mem.size + 1]? = some m := by rw [q1]; simp
      refine ⟨by omega, fun t ht => by rw [g2' t (by omega)]; exact hold t ht, fun t m ht hm => ?_⟩
      have hT0 : TwoAt (.two :: us) 0 := ⟨0, rfl, by simp [nWords]⟩
      have hp0 : s.mem.size ∈ s'.pairs := hpp' _ (by rw [q2]; simp)
      by_cases hb : R.1.size ≤ t
      · obtain ⟨j, hj, hr⟩ := g3' t m hb hm
        exact ⟨j + 2, by rw [hj, show i + 2 + j = i + (j + 2) by omega], NewRole_cons .two (by omega) hr⟩
      · have hm' : R.1[t]? = some m := by rw [← g2' t (by omega)]; exact hm
        obtain ⟨m0, hm0⟩ := ex0
        obtain ⟨m1, hm1⟩ := ex1
        have e0 : s'.mem[s.mem.size]? = some m0 := by rw [g2' _ (by omega)]; exact hm0
        have e1 : s'.mem[s.mem.size + 1]? = some m1 := by rw [g2' _ (by omega)]; exact hm1
        by_cases ht0 : t = s.mem.size
        · subst ht0
          exact ⟨0, by rw [h0 m hm']; rfl, Or.inr (Or.inl ⟨hT0, hp0, m1, e1, by rw [h1 m1 hm1]⟩)⟩
        · have ht1 : t = s.mem.size + 1 := by omega
          subst ht1
          exact ⟨1, h1 m hm', Or.inr (Or.inr ⟨0, s.mem.size, m0, rfl, hT0, rfl, Nat.le_refl _, hp0, e0,
            by rw [h0 m0 hm0]; rfl⟩)⟩
  | .one :: _, [], _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [], _, _, s', hs => by simp [storeUnits] at hs
  | .two :: _, [_], _, _, s', hs => by simp [storeUnits] at hs

/-- A pair store neither straddling two reads: it is before both or after both. -/
theorem noStraddle_at {M : Memory} {P : List Ts} {a : Address} {t0 t1 p : Nat} {m m' : Msg}
    (h : WeakMem.pairStraddles M P a t0 t1 = false) (hp : p ∈ P) (h0 : M[p]? = some m) (hl0 : m.loc = a)
    (h1 : M[p + 1]? = some m') (hl1 : m'.loc = a.next) : (p ≤ t0 ↔ p + 1 ≤ t1) := by
  unfold WeakMem.pairStraddles at h
  rw [List.any_eq_false] at h
  have := h p hp
  revert this
  by_cases c0 : p ≤ t0 <;> by_cases c1 : p + 1 ≤ t1 <;> simp [c0, c1, h0, h1, hl0, hl1]

theorem NewRole_lt {us : List Acc} {a : Address} {i M0 : Nat} {s' : St} {t j : Nat}
    (h : NewRole us a i M0 s' t j) : j < nWords us := by
  rcases h with h | ⟨h, -⟩ | ⟨jj, q, m0, rfl, h, -⟩
  · have := OneAt_lt h; omega
  · have := TwoAt_lt h; omega
  · have := TwoAt_lt h; omega

theorem offs_eq {a : Address} {l : AllocLabel} {k o : Nat} (hl : l = a.label) (h : o = a.offset + k) :
    offs a k = ⟨l, o⟩ := by subst hl; subst h; rfl

/-- **`PubInv` across a store at a component of a segment** (own or not). -/
theorem PubInv_storeAt {k : Promises.Knobs} {arch : Arch} {pw : Word} {rel : Bool} {E : TEnv} {s s' : St}
    {a : Address} {c : Cell} {b oS : Nat} {S : Ty} {L pre us post : List Acc} {ws : List Word}
    (h : PubInv E s) (hP3 : ∀ p ∈ s.pairs, p + 1 < s.mem.size) (hsto : E.sto a.label = some c)
    (hseg : SegOf c.ty b S) (hL : accs S = some L) (hbo : b + oS = a.offset)
    (hLe : L = pre ++ us ++ post) (hpre : nWords pre = oS) (hpl : PromLt s)
    (hmo' : MemOKP E s'.mem s'.pairs s'.promises) (hs : s' ∈ storeUnits k arch pw a rel us ws 0 s) :
    PubInv E s' := by
  obtain ⟨hS, hI, hC, hPP, hLV⟩ := h
  obtain ⟨g1, g2, g3⟩ := storeUnits_roles us ws 0 s s' hs
  have hful1 := storeUnits_fulOne us ws 0 s s' hpl hs
  have hpp := storeUnits_pairs us ws 0 s s' hs
  have hnL : nWords L = nWords pre + nWords us + nWords post := by
    rw [hLe, nWords_append, nWords_append]
  have hlab : ∀ (t : Nat) (m : Msg), s.mem.size ≤ t → s'.mem[t]? = some m → m.loc.label = a.label := by
    intro t m ht hm
    obtain ⟨j, hj, -⟩ := g3 t m ht hm
    rw [hj]; rfl
  have hold : ∀ (t : Nat) (m : Msg), s'.mem[t]? = some m → t < s.mem.size → s.mem[t]? = some m :=
    fun t m hm ht => by rw [← g2 t ht]; exact hm
  have hoff : ∀ (m : Msg) (j o : Nat) (l : AllocLabel), m.loc = offs a (0 + j) → m.loc = ⟨l, o⟩ →
      o = a.offset + j := by
    intro m j o l h1 h2
    rw [h1] at h2
    have e1 := congrArg WeakMem.Address.offset h2
    simp only [offs, Nat.zero_add] at e1
    exact e1.symm
  refine ⟨hS, hI, hC, ?_, ?_⟩
  · intro l c' f o hc hown hf htwT t0 t1 m0 m1 hn0 hn1 hm0 hm1 hl0 hl1 hh0 hh1 hst
    by_cases hon : (t0 < s.mem.size ∧ t0 ∉ s.promises) ∧ (t1 < s.mem.size ∧ t1 ∉ s.promises)
    · exact hPP l c' f o hc hown hf htwT t0 t1 m0 m1 hon.1.2 hon.2.2 (hold _ _ hm0 hon.1.1)
        (hold _ _ hm1 hon.2.1) hl0 hl1
        (hiddenFrom_back g2 hh0) (hiddenFrom_back g2 hh1) (pairStraddles_back g2 hpp hP3 hst)
    have hlabF : ∀ (t : Nat) (m : Msg) (q : Nat), t ∈ s.promises → t ∉ s'.promises → s'.mem[t]? = some m →
        m.loc = ⟨l, q⟩ → l = a.label := by
      intro t m q ht hn hm hlq
      obtain ⟨m', j, hm', hml, -⟩ := hful1 t ht hn
      rw [hold _ _ hm (hpl t ht)] at hm'; obtain rfl := Option.some.inj hm'
      have e1 := congrArg WeakMem.Address.label (hml.symm.trans hlq)
      simp only [offs] at e1; exact e1.symm
    have hl : l = a.label := by
      by_cases n0 : t0 < s.mem.size ∧ t0 ∉ s.promises
      · by_cases p1 : t1 ∈ s.promises
        · exact hlabF t1 m1 _ p1 hn1 hm1 hl1
        · have : ¬ t1 < s.mem.size := fun h => hon ⟨n0, h, p1⟩
          have := hlab t1 m1 (by omega) hm1; rw [hl1] at this; exact this
      · by_cases p0 : t0 ∈ s.promises
        · exact hlabF t0 m0 _ p0 hn0 hm0 hl0
        · have : ¬ t0 < s.mem.size := fun h => n0 ⟨h, p0⟩
          have := hlab t0 m0 (by omega) hm0; rw [hl0] at this; exact this
    rw [hl] at hc
    rw [hsto] at hc; obtain rfl := Option.some.inj hc
    obtain ⟨b', S', L', o', hseg', hL', htw', rfl⟩ := htwT
    have htl := TwoAt_lt htw'
    -- a new message at a word of the reader's unit: the unit is in the store's segment
    have hsame : ∀ q j, (q = b' + o' ∨ q = b' + o' + 1) → q = a.offset + j → j < nWords us →
        TwoAt (pre ++ us ++ post) o' ∧ b' = b := by
      intro q j hq hqj hj
      obtain ⟨e1, e2⟩ := SegOf_unique2 hseg hL (show oS + j < nWords L by omega) hseg' hL'
        (show q - b' < nWords L' by omega) (by omega)
      subst e2
      rw [hL] at hL'
      obtain rfl := Option.some.inj hL'
      rw [← hLe]; exact ⟨htw', e1.symm⟩
    have hfc : ∀ (t : Nat) (m : Msg) (q : Nat), t ∈ s.promises → t ∉ s'.promises → s'.mem[t]? = some m →
        m.loc = ⟨l, q⟩ → (q = b' + o' ∨ q = b' + o' + 1) → False := by
      intro t m q ht hn hm hlq hq
      obtain ⟨m', j, hm', hml, hone⟩ := hful1 t ht hn
      rw [hold _ _ hm (hpl t ht)] at hm'; obtain rfl := Option.some.inj hm'
      have hq' := hoff m j q l hml hlq
      have hj := OneAt_lt hone
      obtain ⟨htw, eb⟩ := hsame q j hq hq' (by omega)
      have h1 := OneAt_embed (pre := pre) (post := post) hone
      rcases hq with hq | hq
      · rw [show nWords pre + j = o' by omega] at h1; exact TwoAt_not_OneAt htw h1
      · rw [show nWords pre + j = o' + 1 by omega] at h1; exact TwoAt_not_OneAt_succ htw h1
    by_cases p0 : t0 ∈ s.promises
    · exact (hfc t0 m0 _ p0 hn0 hm0 hl0 (Or.inl rfl)).elim
    by_cases p1 : t1 ∈ s.promises
    · exact (hfc t1 m1 _ p1 hn1 hm1 hl1 (Or.inr rfl)).elim
    have hon' : ¬ (t0 < s.mem.size ∧ t1 < s.mem.size) := fun h => hon ⟨⟨h.1, p0⟩, h.2, p1⟩
    clear hon
    by_cases n0 : t0 < s.mem.size
    · -- an old first word, a new second word
      obtain ⟨j, hj, hr⟩ := g3 t1 m1 (by omega) hm1
      have hq := hoff m1 j (b' + o' + 1) l hj hl1
      obtain ⟨htw, eb⟩ := hsame _ j (Or.inr rfl) hq (NewRole_lt hr)
      unfold NewRole at hr
      rcases hr with hr | ⟨hr, -⟩ | ⟨jj, q, m0', e, -, et, hq', hqp, hq0, hql⟩
      · have h1 := OneAt_embed (pre := pre) (post := post) hr
        rw [show nWords pre + j = o' + 1 by omega] at h1
        exact absurd h1 (TwoAt_not_OneAt_succ htw)
      · have h1 := TwoAt_embed (pre := pre) (post := post) hr
        rw [show nWords pre + j = o' + 1 by omega] at h1
        exact absurd h1 (TwoAt_not_TwoAt_succ htw)
      · have := (noStraddle_at hst hqp hq0 (by rw [hql]; exact offs_eq hl (by omega))
          (by rw [← et]; exact hm1) (by rw [hl1]; rfl)).2 (by omega)
        exfalso; omega
    · -- a new first word
      obtain ⟨j, hj, hr⟩ := g3 t0 m0 (by omega) hm0
      have hq := hoff m0 j (b' + o') l hj hl0
      obtain ⟨htw, eb⟩ := hsame _ j (Or.inl rfl) hq (NewRole_lt hr)
      unfold NewRole at hr
      rcases hr with hr | ⟨-, hp, m1', hp1, hpl⟩ | ⟨jj, q, -, e, hjj, -⟩
      · have h1 := OneAt_embed (pre := pre) (post := post) hr
        rw [show nWords pre + j = o' by omega] at h1
        exact absurd h1 (TwoAt_not_OneAt htw)
      · have h01 := (noStraddle_at hst hp hm0 hl0 hp1
          (by rw [hpl]; show offs a _ = ⟨l, b' + o' + 1⟩; exact offs_eq hl (by omega))).1 (Nat.le_refl _)
        obtain ⟨j', hj', hr'⟩ := g3 t1 m1 (by omega) hm1
        have hq1 := hoff m1 j' (b' + o' + 1) l hj' hl1
        unfold NewRole at hr'
        rcases hr' with hr' | ⟨hr', -⟩ | ⟨jj, q, m0', e', -, et, hq', hqp, hq0, hql⟩
        · have h1 := OneAt_embed (pre := pre) (post := post) hr'
          rw [show nWords pre + j' = o' + 1 by omega] at h1
          exact absurd h1 (TwoAt_not_OneAt_succ htw)
        · have h1 := TwoAt_embed (pre := pre) (post := post) hr'
          rw [show nWords pre + j' = o' + 1 by omega] at h1
          exact absurd h1 (TwoAt_not_TwoAt_succ htw)
        · have := (noStraddle_at hst hqp hq0 (by rw [hql]; exact offs_eq hl (by omega))
            (by rw [← et]; exact hm1) (by rw [hl1]; rfl)).2 (by omega)
          have e1 : t1 = t0 + 1 := by omega
          rw [e1] at hm1
          have hpo := hmo'.2.1 t0 m0 m1 c hp hm0 hm1 (by rw [hl0, hl]; exact hsto)
          rw [hl0] at hpo; exact hpo
      · have h1 := TwoAt_embed (pre := pre) (post := post) hjj
        rw [show o' = nWords pre + jj + 1 by omega] at htw
        exact absurd htw (TwoAt_not_TwoAt_succ h1)
  · intro l c' f b S us' o hc hown hf hseg hu ho
    obtain ⟨t, m, h1, h2⟩ := hLV l c' f b S us' o hc hown hf hseg hu ho
    exact ⟨t, m, by rw [g2 t (lt_of_get h1)]; exact h1, h2⟩

/-- (privSlot) A unit of a component initialised in the real count is not an
uninitialised private unit. -/
theorem notPrivU_iniAt {E : TEnv} {a : Address} {c : Cell} {U : Ty} {us : List Acc} {j : Nat}
    (hsto : E.sto a.label = some c) (hini : IniAt E.rc c a U) (hna : ∀ N e, U ≠ .array (.lit N) e)
    (hus : accs U = some us) (hj : j < nWords us) : ¬ PrivU E (offs a j) := by
  rintro ⟨c', N, e, us', hc', -, -, hT, hus', hle, -⟩
  simp only [offs] at hc' hle
  rw [hsto] at hc'; cases hc'
  rcases hini N e hT with ⟨hU, -⟩ | ⟨us2, j2, o, hus2, hj2, hjo, hato⟩
  · exact hna N e (hU.trans hT)
  · rw [hus'] at hus2; cases hus2
    have hb : o + nWords us ≤ nWords us' := by
      obtain ⟨pre, post, e1, hn⟩ := AtOff_embed hato hus' hus
      subst e1; subst hn
      simp only [TermSound.nWords_append]; omega
    have h2 : (j2 + 1) * nWords us' ≤ E.rc a.label * nWords us' := Nat.mul_le_mul_right _ hj2
    rw [Nat.succ_mul] at h2
    omega
#print axioms notPrivU_iniAt

/-- **A component store to an own cell keeps `MemInv`.**  The component is in
the cell's segment (`own_seg`: the whole cell, or an initialised buffer slot);
the segment's new value is `VR_put`, and the cell's new words are the old ones
with the component's replaced (`splice_seg`, `CellOK_put`). -/
theorem MemInv_storeAt {g : G} {E : TEnv} {s : St} {a : Address} {c : Cell} {us : List Acc}
    {ws : List Word} {pw : Word} {rel : Bool} {U : Ty} (hm : MemInv g E s) (hsto : E.sto a.label = some c)
    (hown : c.owner = some E.tid) (hat : AtOff c.ty a.offset U) (hini : IniAt E.rc c a U)
    (hna : ∀ N e, U ≠ .array (.lit N) e)
    (hU : EnvVal E U ws) (hus : accs U = some us) (hlen : ws.length = nWords us) :
    ∀ s', s' ∈ storeUnits g.k g.arch pw a rel us ws 0 s → MemInv g E s' := by
  intro s' hs
  have hwU : wc U = some (nWords us) := wc_of_accs hus
  obtain ⟨hmo, hoo, hpl, hfr, hsn, hoh, hpd, hopub, hpi, hbi, hpo⟩ := id hm
  obtain ⟨vals, hcell, hlat, hpf⟩ := hoo a.label c hsto hown
  obtain ⟨b, oS, S, wS, hseg, hbo, hatS, hwS, hbw, ⟨hvr0, hV0⟩⟩ := own_seg (ini := E.rc) hcell hat hini hna
  obtain ⟨L, hL, hLw⟩ : ∃ L, accs S = some L ∧ nWords L = wS := by
    cases h : accs S with
    | none => simp [wc, h] at hwS
    | some L => exact ⟨L, rfl, by simp [wc, h] at hwS; exact hwS⟩
  obtain ⟨pre, post, hLe, hpre⟩ := AtOff_embed hatS hL hus
  obtain ⟨ws', hws'⟩ : ∃ ws', ws' = ws.map (bumpW s.vs.vRelSt) := ⟨_, rfl⟩
  have hlen' : ws'.length = nWords us := by rw [hws', List.length_map]; exact hlen
  have hget : ∀ j w, ws[j]? = some w → ws'[j]? = some (bumpW s.vs.vRelSt w) := fun j w hw => by
    rw [hws', List.getElem?_map, hw]; rfl
  obtain ⟨hvq, hVq⟩ : ValOf E U ws' := by rw [hws']; exact hU.store hsn
  have hsl : ((vals.drop b).take wS).length = wS := by
    simp only [List.length_take, List.length_drop]; omega
  obtain ⟨hle, hvR, hVR⟩ := VR_put E.unsee hatS hvr0 hV0 (by rw [hsl]; exact hwS) hvq hVq
    (by rw [hlen']; exact hwU)
  rw [hlen', hsl] at hle
  have hwl : ws'.length = nWords us := hlen'
  have hsp := splice_seg vals ws' b wS oS (by rw [hwl]; exact hle)
  have hA' : (((vals.drop b).take wS).take oS).length = oS := by
    simp only [List.length_take, List.length_drop]; omega
  generalize hQ : ((vals.drop b).take wS).take oS ++ ws' ++
    ((vals.drop b).take wS).drop (oS + ws'.length) = Q at hvR hVR hsp
  rw [hwl, hbo] at hsp
  have hQv : ValOf E S Q := ⟨hvR, hVR⟩
  have hQl : Q.length = wS := by
    rw [← hQ]; simp only [List.length_append, List.length_take, List.length_drop, hwl]; omega
  have hQs : ValOfS E S Q := ⟨hQv, ShapeC_of_wc hwS hQl⟩
  have hcell' := CellOK_put hcell hseg hwS hbw hQv hQl
  rw [hsp] at hcell'
  have hle2 : nWords us + a.offset ≤ vals.length := by omega
  have hA : (vals.take a.offset).length = a.offset := by simp; omega
  have hAB : (vals.take a.offset ++ ws').length = a.offset + nWords us := by simp; omega
  have hinQ : ∀ j w, ws[j]? = some w → Q[oS + j]? = some (bumpW s.vs.vRelSt w) := fun j w hw => by
    have hw' := hget j w hw
    have hj : j < ws'.length := (List.getElem?_eq_some_iff.1 hw').1
    rw [← hQ, List.append_assoc, List.getElem?_append_right (by rw [hA']; omega), hA',
      Nat.add_sub_cancel_left, List.getElem?_append_left hj]; exact hw'
  obtain ⟨hmo', hoo'⟩ := OwnOKP_storeAt (k := g.k) (arch := g.arch) (pw := pw) (rel := rel)
    (V := s.vs.vRelSt) (vals' := vals.take a.offset ++ ws' ++ vals.drop (a.offset + nWords us)) hsto hseg hbo.symm hQs
    hinQ
    hcell'
    (fun j w hw => by
      have hw' := hget j w hw
      have hj : j < ws'.length := (List.getElem?_eq_some_iff.1 hw').1
      rw [List.append_assoc, List.getElem?_append_right (by omega), hA,
        Nat.add_sub_cancel_left, List.getElem?_append_left hj]; exact hw')
    hlat hpf
    (fun o hr => by
      rcases hr with hr | hr
      · rw [List.append_assoc, List.getElem?_append_left (by rw [hA]; exact hr),
          List.getElem?_take_of_lt hr]
      · rw [List.getElem?_append_right (by rw [hAB]; exact hr), hAB, List.getElem?_drop,
          Nat.add_sub_of_le hr])
    (by rw [Nat.add_comm]; exact hle2)
    (fun _ o htw _ hr => by
      rw [← hbo] at hr ⊢; exact TwoAtT_comp hseg hL hLe hpre htw hr)
    id rfl (fun o h _ _ => h)
    hlen (Nat.le_refl _) hpl hpo.1 hmo (fun l c _ => hoo l c) s' hs
  exact MemInv_ownStore hm hsto hown hseg hbo.symm hQs hinQ hs hmo' hoo'
    (PubInv_storeAt hpi hmo.2.2 hsto hseg hL hbo hLe hpre hpl hmo' hs)
    (fun j hj => notPrivU_iniAt hsto hini hna hus hj)

/-- (F2′) A finite map over a buffer's words that keeps its length and its
words below slot `n` keeps `BufOK` at `n`. -/
theorem BufOK_congr_lo {E : TEnv} {n N : Nat} {T e : Ty} {ub : List Acc} {vals vals' : List Word}
    (h : BufOK E n T vals) (hT : T = .array (.lit N) e) (hub : accs e = some ub)
    (hl : vals'.length = vals.length) (he : ∀ i, i < n * nWords ub → vals'[i]? = vals[i]?) :
    BufOK E n T vals' := by
  obtain ⟨N', e', ub', hT', hub', hn, hlen, hs⟩ := h
  rw [hT] at hT'; simp only [Ty.array.injEq, Idx.lit.injEq] at hT'; obtain ⟨rfl, rfl⟩ := hT'
  rw [hub] at hub'; cases hub'
  refine ⟨N, e, ub, hT, hub, hn, by rw [hl]; exact hlen, fun j hj => ?_⟩
  have hjw : j * nWords ub + nWords ub ≤ n * nWords ub := by
    have := Nat.mul_le_mul_right (nWords ub) (show j + 1 ≤ n by omega)
    rw [Nat.succ_mul] at this; exact this
  have eq : (vals'.drop (j * nWords ub)).take (nWords ub) = (vals.drop (j * nWords ub)).take (nWords ub) := by
    apply List.ext_getElem?; intro i
    rw [List.getElem?_take, List.getElem?_take]
    split
    · rw [List.getElem?_drop, List.getElem?_drop]; exact he _ (by omega)
    · rfl
  rw [eq]; exact hs j hj

/-- (F2′) **A component store to an own cell keeps `MemInv`, at `ini`.**  Below
`E.rc`, `MemInv_storeAt`.  Otherwise the target is in a planted buffer slot
`j ≥ E.rc` (`IniAt_of_seg`): the segment's new value is `VR_put` into a value
of the slot (`Inh`), and the cell's words below slot `E.rc` are untouched
(`BufOK_congr_lo`). -/
theorem MemInv_storeAtI {g : G} {E : TEnv} {s : St} {a : Address} {c : Cell} {us : List Acc}
    {ws : List Word} {pw : Word} {rel : Bool} {U : Ty} (hm : MemInv g E s) (hsto : E.sto a.label = some c)
    (hown : c.owner = some E.tid) (hat : AtOff c.ty a.offset U) (hini : IniAt E.ini c a U)
    (hna : ∀ N e, U ≠ .array (.lit N) e)
    (hU : EnvVal E U ws) (hus : accs U = some us) (hlen : ws.length = nWords us) :
    ∀ s', s' ∈ storeUnits g.k g.arch pw a rel us ws 0 s → MemInv g E s' := by
  by_cases hr : IniAt E.rc c a U
  · exact MemInv_storeAt hm hsto hown hat hr hna hU hus hlen
  intro s' hs
  obtain ⟨hmo, hoo, hpl, -, hsn, -, -, -, hpi, -, hpo⟩ := id hm
  obtain ⟨vals, hcell, hlat, hpf⟩ := hoo a.label c hsto hown
  have hpi0 := hpi
  obtain ⟨-, hInh, -, -, -⟩ := hpi0
  obtain ⟨b, oS, S, L, hseg, hbo, hatS, hL, hiS⟩ := at_seg (LayT_of_CellOK hcell) hat hini hna
  rcases hcell with ⟨hwc, -⟩ | hbuf
  · exact absurd (fun N e hT => absurd hT (notArr_of_wc hwc N e)) hr
  have hbuf0 := hbuf
  obtain ⟨N, e, ub, hT, hub, -, hvl, -⟩ := hbuf0
  have hseg0 := hseg
  rcases hseg0 with ⟨-, rfl, hA⟩ | ⟨N', ub2, j, hT', hub2, hjN, hb⟩
  · rw [hT] at hA; simp [accs] at hA
  rw [hT] at hT'; simp only [Ty.array.injEq, Idx.lit.injEq] at hT'; obtain ⟨rfl, hSe⟩ := hT'
  subst e
  rw [hub] at hub2; cases hub2
  have hjr : E.rc a.label ≤ j := by
    refine Nat.le_of_not_lt fun hj => hr (IniAt_of_seg hseg hbo hatS fun N1 e1 hT1 => ?_)
    rw [hT] at hT1; simp only [Ty.array.injEq, Idx.lit.injEq] at hT1; obtain ⟨-, rfl⟩ := hT1
    exact ⟨ub, j, hub, hj, hb⟩
  obtain ⟨pre, post, hLe, hpre⟩ := AtOff_embed hatS hL hus
  have hnL : nWords L = nWords pre + nWords us + nWords post := by
    rw [hLe, nWords_append, nWords_append]
  have hLw : nWords L = nWords ub := by rw [hub] at hL; cases hL; rfl
  have hjw : j * nWords ub + nWords ub ≤ vals.length := by
    have := Nat.mul_le_mul_right (nWords ub) (show j + 1 ≤ N by omega)
    rw [Nat.succ_mul] at this; omega
  have hrj : E.rc a.label * nWords ub ≤ j * nWords ub := Nat.mul_le_mul_right _ hjr
  obtain ⟨Q0, ⟨hvr0, hV0⟩, hQ0l⟩ := hInh a.label c b S L hsto hseg hL hiS
  have hwS : wc S = some Q0.length := by rw [hQ0l]; exact wc_of_accs hL
  obtain ⟨ws', hws'⟩ : ∃ ws', ws' = ws.map (bumpW s.vs.vRelSt) := ⟨_, rfl⟩
  have hlen' : ws'.length = nWords us := by rw [hws', List.length_map]; exact hlen
  have hget : ∀ j w, ws[j]? = some w → ws'[j]? = some (bumpW s.vs.vRelSt w) := fun j w hw => by
    rw [hws', List.getElem?_map, hw]; rfl
  obtain ⟨hvq, hVq⟩ : ValOf E U ws' := by rw [hws']; exact hU.store hsn
  obtain ⟨hle, hvR, hVR⟩ := VR_put E.unsee hatS hvr0 hV0 hwS hvq hVq
    (by rw [hlen']; exact wc_of_accs hus)
  rw [hlen'] at hle hvR hVR
  generalize hQ : Q0.take oS ++ ws' ++ Q0.drop (oS + nWords us) = Q at hvR hVR
  have hQl : Q.length = nWords L := by
    rw [← hQ]; simp only [List.length_append, List.length_take, List.length_drop, hlen']; omega
  have hQs : ValOfS E S Q := ⟨⟨hvR, hVR⟩, ShapeC_of_wc (wc_of_accs hL) hQl⟩
  have hA' : (Q0.take oS).length = oS := by simp; omega
  have hinQ : ∀ j w, ws[j]? = some w → Q[oS + j]? = some (bumpW s.vs.vRelSt w) := fun j w hw => by
    have hw' := hget j w hw
    have hj : j < ws'.length := (List.getElem?_eq_some_iff.1 hw').1
    rw [← hQ, List.append_assoc, List.getElem?_append_right (by rw [hA']; omega), hA',
      Nat.add_sub_cancel_left, List.getElem?_append_left hj]; exact hw'
  have hle1 : a.offset + nWords us ≤ b + nWords L := by
    rw [← hbo, hnL, ← hpre, Nat.add_assoc, Nat.add_assoc]
    exact Nat.add_le_add_left (Nat.add_le_add_left (Nat.le_add_right _ _) _) _
  have hbL : b + nWords L ≤ vals.length := by rw [hLw, hb]; exact hjw
  have hbo' : b ≤ a.offset := by rw [← hbo]; exact Nat.le_add_right _ _
  have hle2 : a.offset + nWords us ≤ vals.length := Nat.le_trans hle1 hbL
  have hA : (vals.take a.offset).length = a.offset := by simp; omega
  have hAB : (vals.take a.offset ++ ws').length = a.offset + nWords us := by simp; omega
  have hout : ∀ o, (o < a.offset ∨ a.offset + nWords us ≤ o) →
      (vals.take a.offset ++ ws' ++ vals.drop (a.offset + nWords us))[o]? = vals[o]? := fun o ho => by
    rcases ho with ho | ho
    · rw [List.append_assoc, List.getElem?_append_left (by rw [hA]; exact ho),
        List.getElem?_take_of_lt ho]
    · rw [List.getElem?_append_right (by rw [hAB]; exact ho), hAB, List.getElem?_drop,
        Nat.add_sub_of_le ho]
  have hcell' : CellOK E (E.rc a.label) c.ty (vals.take a.offset ++ ws' ++ vals.drop (a.offset + nWords us)) :=
    Or.inr (BufOK_congr_lo hbuf hT hub
      (by simp only [List.length_append, List.length_take, List.length_drop, hlen']; omega)
      (fun i hi => hout i (Or.inl (Nat.lt_of_lt_of_le hi (Nat.le_trans hrj (by rw [← hb]; exact hbo'))))))
  obtain ⟨hmo', hoo'⟩ := OwnOKP_storeAt (k := g.k) (arch := g.arch) (pw := pw) (rel := rel)
    (V := s.vs.vRelSt) (vals' := vals.take a.offset ++ ws' ++ vals.drop (a.offset + nWords us)) hsto hseg hbo.symm hQs
    hinQ
    hcell'
    (fun j w hw => by
      have hw' := hget j w hw
      have hj : j < ws'.length := (List.getElem?_eq_some_iff.1 hw').1
      rw [List.append_assoc, List.getElem?_append_right (by omega), hA,
        Nat.add_sub_cancel_left, List.getElem?_append_left hj]; exact hw')
    hlat hpf hout hle2
    (fun _ o htw _ hr => by
      rw [← hbo] at hr ⊢; exact TwoAtT_comp hseg hL hLe hpre htw hr)
    id rfl (fun o h _ _ => h)
    hlen (Nat.le_refl _) hpl hpo.1 hmo (fun l c _ => hoo l c) s' hs
  have hrlt : E.rc a.label < E.ini a.label := Nat.lt_of_le_of_ne (E.rc_le_ini _) fun e => hr (by
    unfold IniAt at hini ⊢; rw [e]; exact hini)
  obtain ⟨fq, hfq, -⟩ := hm.2.2.2.2.2.1.2 a.label c hsto hown hrlt
  exact MemInv_ownStore hm hsto hown hseg hbo.symm hQs hinQ hs hmo' hoo'
    (PubInv_storeAt hpi hmo.2.2 hsto hseg hL hbo hLe hpre hpl hmo' hs)
    (fun j _ => notPrivU_pfr (by simp only [offs]; rw [hfq]; simp))

/-- **What an own locative is at runtime**, when its target is not an array:
one word, an address into an own cell of this thread, whose type has the
closed target as the component at that offset. -/
theorem locView {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {K : TEnv → List Word → Prop}
    {cx : Cx} {env : Env} {a : At} {u : Ty}
    (hi : FInv ρ η σs K cx env) (hpk : cx.peek a = .ok (.loc .own u)) (htv : TvOK cx)
    (ho : cx.opaqueOK u = true) (hwc : wc (cl ρ η.wit 0 0 u) ≠ none) :
    ∃ ad c pw μr ru, evalAt env a = some (.loc μr ru, [pw]) ∧ pw.val = .loc ad 0 ∧
      η.sto ad.label = some c ∧ AtOff c.ty ad.offset (cl ρ η.wit 0 0 u) ∧
      IniAt η.rc c ad (cl ρ η.wit 0 0 u) ∧ c.owner = some η.tid ∧
      etok (skel ru) = etok (skel (close σs u)) ∧ sig ru = sig (cl ρ η.wit 0 0 u) := by
  obtain ⟨rt, ws, hea, hv, hl⟩ := peek_VR hi.2.1 hpk
  have hnb : ∀ n e, ¬ Fd (.array (.lit n) e) (cl ρ η.wit 0 0 u) :=
    Fd_noarr fun h => hwc (by simp [wc, h])
  obtain ⟨ad, c, hws, hsto, hat, hmode, hini⟩ := cell_target (rfl : cellOf (.loc .own u) = some (.own, u)) hnb hv
  obtain ⟨pw, rfl, hpw⟩ := map_singleton hws
  have hsk := hl.2.1
  obtain ⟨μr, ru, rfl, -, hsku⟩ : ∃ μr ru, rt = .loc μr ru ∧ skelM μr = skelM .own ∧
      etok (skel ru) = etok (skel (close σs u)) := by
    simp only [close, substTs, skel, etok] at hsk
    obtain ⟨μr, ru, rfl, h1, h2⟩ := eskel_eq_loc hsk
    exact ⟨μr, ru, rfl, h1, h2⟩
  have htb : tb cx.ke.length u = true :=
    tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.loc .own u) = some (.own, u))
  have hsig : sig ru = sig (cl ρ η.wit 0 0 u) := by
    have h1 : sig ru = sig (close σs u) := sig_of_eskel hsku
    rw [h1]; exact sig_WitL hi.2.2.2.1 ρ ho (lt_of_guardT htb hi.2.2.2.2.1)
  exact ⟨ad, c, pw, μr, ru, hea, hpw, hsto, hat, hini, hmode, hsku, hsig⟩

/-- **P1 + P4 at the thread, `store` at an own locative** (T3c-5a-4).  The
target is not an array: the stored value has a layout (`Lay`), which the
target's closure shares (`sig_WitL`). -/
theorem tstepM_storeLoc {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v : At} {tok : Option At}
    {u : Ty} {e : Expr}
    (hterm : th.term = .let_ x (.store rel a v tok) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.loc .own u)) (hnw : wordOf (Ty.loc .own u) = none)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | storeWordGive hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storeWordKeep hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storeWordHand hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storePub hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeRgn hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeCap hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeOwn hp _ hc hwf hu hsub hb =>
  obtain ⟨t, u', tv, c₁, hp, hc, hwf, hu, hsub, hb⟩ : ∃ t u' tv c₁, cx.peek a = .ok t ∧
      cellOf t = some (.own, u') ∧ Ty.wordFreeIn cx.ke u' = true ∧ cx.use v = .ok (tv, c₁) ∧
      SubS c₁ tv u' ∧ c₁.bind x .unit = .ok c' :=
    ⟨_, _, _, _, hp, hc, hwf, hu, hsub, hb⟩
  rw [hpk] at hp; cases hp
  simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc; subst hc
  have hotv : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have ho : cx.opaqueOK u = true := sub_opaqueOK hsub hotv
  have htb : tb cx.ke.length u = true :=
    tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.loc .own u) = some (.own, u))
  obtain ⟨hi1, rv, wsv, hev, hvv, hlv⟩ := use_FInv hu hi
  have hsigu : sig (close th.σs u) = sig (cl ρ η.wit 0 0 u) :=
    sig_WitL hi.2.2.2.1 ρ ho (lt_of_guardT htb hi.2.2.2.2.1)
  have hwcu : wc (cl ρ η.wit 0 0 u) ≠ none := by
    rw [← wc_of_sig hsigu]; exact (Lay_canon hsub hlv).2.2.2.1
  have hna : ∀ n e, cl ρ η.wit 0 0 u ≠ .array (.lit n) e := fun n e h => hwcu (by rw [h]; simp [wc, accs])
  obtain ⟨ad, c, pw, μr, ru, hea, hpw, hsto, hat, hini, hown, hsku, hsig⟩ := locView hi hpk htv ho hwcu
  obtain ⟨us, hus⟩ : ∃ us, accs ru = some us := by
    have : wc ru ≠ none := by rw [wc_of_sig hsig]; exact hwcu
    cases h : accs ru with
    | none => simp [wc, h] at this
    | some us => exact ⟨us, rfl⟩
  obtain ⟨hval, hlen⟩ := ownStoreVal hE.2.1 hi.2.2.2.1 hi.2.2.2.2.1 hi1.1 hsub ho htb hvv hlv hsig hus
  have hwUA : accs (cl ρ η.wit 0 0 u) = some us := (accs_rtW hE.2.1 hi.2.2.2.1 hi.2.2.2.2.1 ho htb (peek_cell_lyt hi.2.1 hpk hea rfl rfl).2).symm.trans hus
  have hwU : wc (cl ρ η.wit 0 0 u) = some (nWords us) := by rw [← wc_of_sig hsig]; simp [wc, hus]
  have key : tstep g mem pairs th =
      (storeUnits g.k g.arch pw ad rel us wsv 0 (stOf mem pairs th)).map fun s' =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, .unit, []) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hev, cellOf, addrOf, hpw, hus, List.map_map]; rfl
  rw [key]
  obtain ⟨s0, hs0⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := pw) (a := ad) (rel := rel)
    us wsv 0 (stOf mem pairs th) hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hs0), fun r hr => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨s', hs', rfl⟩ := hr
  exact ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv', bind_FInv hb hi1 unit_VR (unit_Lay _), retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
    MemInv_storeAt hm hsto hown hat hini hna hval hwUA hlen s' hs'⟩

/-- **P1 + P4 at the thread, `xchg` at an own locative** (T3c-5a-4): a plain
load of the component, then a plain store of the new value. -/
theorem tstepM_xchgLoc {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {a v : At} {u : Ty} {e : Expr}
    (hterm : th.term = .let_ x (.xchg a v) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.loc .own u))
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | xchg hp hx hu hsub hb =>
  obtain ⟨t, u', o, tv, c₁, hp, hx, hu, hsub, hb⟩ : ∃ t u' o tv c₁, cx.peek a = .ok t ∧
      XchgCell cx t u' o ∧ cx.use v = .ok (tv, c₁) ∧ (SubS c₁ tv u' ∨ SubS c₁ tv o) ∧
      c₁.bind x o = .ok c' := ⟨_, _, _, _, _, hp, hx, hu, hsub, hb⟩
  rw [hpk] at hp; cases hp
  cases hx with
  | rgn _ hc _ _ _ => simp [cellOf] at hc
  | own _ hc _ =>
  simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc; subst hc
  have hsub : SubS c₁ tv u := hsub.elim id id
  have hotv : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have ho : cx.opaqueOK u = true := sub_opaqueOK hsub hotv
  have htb : tb cx.ke.length u = true :=
    tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.loc .own u) = some (.own, u))
  have haf' : (cl ρ η.wit 0 0 u).arrFree = true := arrFree_cl hi.2.2.2.2.2.2.1.af u 0 0 (bind_arrFree hb)
  have hna : ∀ n e, cl ρ η.wit 0 0 u ≠ .array (.lit n) e := fun n e h => by
    rw [h] at haf'; simp [Ty.arrFree] at haf'
  obtain ⟨hi1, rv, wsv, hev, hvv, hlv⟩ := use_FInv hu hi
  have hwcu : wc (cl ρ η.wit 0 0 u) ≠ none := by
    rw [← wc_of_sig (sig_WitL hi.2.2.2.1 ρ ho (lt_of_guardT htb hi.2.2.2.2.1))]
    exact (Lay_canon hsub hlv).2.2.2.1
  obtain ⟨ad, c, pw, μr, ru, hea, hpw, hsto, hat, hini, hown, hsku, hsig⟩ := locView hi hpk htv ho hwcu
  obtain ⟨us, hus, ⟨r0, hr0⟩, hld, hstw⟩ := locLoad (arch := g.arch) (pw := pw) (acq := false)
    (s := stOf mem pairs th) hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hsto hown hat hini hna hsku hsig
      (peek_cell_lyt hi.2.1 hpk hea rfl rfl).2
        (accs_rtW hE.2.1 hi.2.2.2.1 hi.2.2.2.2.1 ho htb (peek_cell_lyt hi.2.1 hpk hea rfl rfl).2)
  obtain ⟨hval, hlen⟩ := ownStoreVal hE.2.1 hi.2.2.2.1 hi.2.2.2.2.1 hi1.1 hsub ho htb hvv hlv hsig hus
  have hwUA : accs (cl ρ η.wit 0 0 u) = some us := (accs_rtW hE.2.1 hi.2.2.2.1 hi.2.2.2.2.1 ho htb (peek_cell_lyt hi.2.1 hpk hea rfl rfl).2).symm.trans hus
  have hwU : wc (cl ρ η.wit 0 0 u) = some (nWords us) := by rw [← wc_of_sig hsig]; simp [wc, hus]
  have key : tstep g mem pairs th =
      ((loadUnits g.arch pw ad false us 0 (stOf mem pairs th)).flatMap fun (s1, old) =>
        (storeUnits g.k g.arch pw ad false us wsv 0 s1).map fun s2 => (s2, ru, old)).map
        fun (s', t, ws) => (s'.mem, s'.pairs, withS { th with term := e, env := (x, t, ws) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hev, cellOf, addrOf, hpw, hus]
  rw [key]
  have hm1 : ∀ r1, r1 ∈ loadUnits g.arch pw ad false us 0 (stOf mem pairs th) → PromAbove r1.1 → MemInv g (CE η) r1.1 :=
    fun r1 h hp1 => by
      obtain ⟨_, _, f1, f2, f3, f4, f5⟩ := hld r1 h hp1
      exact MemInv_load hm f1 f2 f3 f4 f5 (loadUnits_relSt _ _ _ _ h) (loadUnits_vWr _ _ _ _ h)
  obtain ⟨s2, hs2⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := pw) (a := ad) (rel := false)
    us wsv 0 r0.1 hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem (List.mem_flatMap.2 ⟨r0, hr0, List.mem_map_of_mem hs2⟩)),
    fun r hr hpr0 => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨⟨s', t', ws'⟩, hr, rfl⟩ := hr
  rw [List.mem_flatMap] at hr
  obtain ⟨⟨s1, old⟩, h1, h2⟩ := hr
  rw [List.mem_map] at h2
  obtain ⟨s2, hs2, he2⟩ := h2
  simp only [Prod.mk.injEq] at he2
  obtain ⟨rfl, rfl, rfl⟩ := he2
  have hp2 : PromAbove s2 :=
    hpr0
  have hp1 : PromAbove s1 := storeUnits_promAbove hs2 hp2
  obtain ⟨hvr, hlay, -⟩ := hld (s1, old) h1 hp1
  exact ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv', bind_FInv hb hi1 hvr hlay, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
    MemInv_storeAt (hm1 (s1, old) h1 hp1) hsto hown hat hini hna hval hwUA hlen s2 hs2⟩

/-! ## §10 Slots of an own buffer by value (T3c-5b-4)

`loadAt`/`xchgAt` are `load`/`xchg` at slot `j`'s locative: `slot_view` exposes
`idx_core`'s runtime pieces, then §8/§9 apply. -/

/-- (T3c-5b) **What a slot of a buffer is at runtime** (`idx_core`, its pieces
exposed): the handle's word is an address into a cell, the index evaluates to
`j`, and slot `j`'s locative is the address `j · w` further on, at an
initialised slot of the cell, with the closed element type as its target. -/
theorem slot_view {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {env : Env} {b i : At}
    {t u : Ty} {μ : Mode} {n k j : Idx}
    (hsat : Sat cx.facts ρ) (hvars : VarsOK ρ η σs cx.vars env) (hW : WitL σs η.wit cx.opq)
    (hK : cx.ke.length ≤ σs.length) (htv : TvOK cx)
    (hp : cx.peek b = .ok t) (hbuf : bufOf t = some (μ, n, u, k)) (hint : IntIdx cx i j)
    (hlt : LtI cx j n) (hltk : LtI cx j k) (hop : cx.opaqueOK u = true) :
    ∃ rt w ad c μr ur us rti wi, evalAt env b = some (rt, [w]) ∧ w.val = .loc ad 0 ∧
      evalAt env i = some (rti, [wi]) ∧ numOf [wi] = some (ev ρ j) ∧
      bufElem rt = some (μr, ur) ∧ accs ur = some us ∧ η.sto ad.label = some c ∧
      AtOff c.ty (offs ad (ev ρ j * nWords us)).offset (cl ρ η.wit 0 0 u) ∧ ModeOK η.tid η.pfr η.seen μ ad.label c [w] ∧
      IniAt (modeIni μ η.ini η.rini) c (offs ad (ev ρ j * nWords us)) (cl ρ η.wit 0 0 u) ∧
      etok (skel ur) = etok (skel (close σs u)) ∧ sig ur = sig (cl ρ η.wit 0 0 u) ∧ tb cx.ke.length u = true ∧
      ∀ o V, AtOff (cl ρ η.wit 0 0 u) o V → IniAt (modeIni μ η.ini η.rini) c (offs ad (ev ρ j * nWords us + o)) V := by
  have ht : t = .refine (.loc μ (.array n u)) (.ini k) := by
    unfold bufOf at hbuf; split at hbuf
    · simp only [Option.some.injEq, Prod.mk.injEq] at hbuf
      obtain ⟨rfl, rfl, rfl, rfl⟩ := hbuf; rfl
    · simp at hbuf
  subst ht
  have hJ : ev ρ j < ev ρ n := hlt ρ hsat
  obtain ⟨ti, hpi, hti⟩ := hint
  obtain ⟨rti, wsi, hei, hvi, -⟩ := peek_VR hvars hpi
  obtain ⟨wi, rfl, hwi⟩ := map_singleton (VR_intS hti hvi)
  obtain ⟨rt, ws, hea, hv, hl⟩ := peek_VR hvars hp
  simp only [VR] at hv
  obtain ⟨hv, hir⟩ := hv
  rcases hv with ⟨-, e, he⟩ | ⟨ad, c, U, hws, hsto, hat, hFU, hmode, hini⟩
  · have he := Fd_nonmu he (fun b => by simp [cl])
    simp only [cl, clI_zero, Ty.array.injEq, Idx.lit.injEq] at he
    omega
  obtain rfl := Fd_nonmu hFU (fun b => by simp [cl])
  obtain ⟨w, rfl, hwv⟩ := map_singleton hws
  have hKm : ev ρ k ≤ modeIni μ η.ini η.rini ad.label := by
    simp only [IniR] at hir; have h := hir ad (by simp [hwv]); rw [TEnv.selIni_loc] at h; exact h
  have hJk : ev ρ j < modeIni μ η.ini η.rini ad.label := Nat.lt_of_lt_of_le (hltk ρ hsat) hKm
  simp only [cl, clI_zero] at hini
  have hlay := AtOff_lay hat
  simp only [cl, clI_zero] at hlay
  obtain ⟨us, hus⟩ : ∃ us, accs (cl ρ η.wit 0 0 u) = some us := by
    rcases hlay with h | ⟨n', e', he', h⟩
    · simp [accs] at h
    · simp only [Ty.array.injEq] at he'; rw [he'.2]
      exact Option.ne_none_iff_exists'.1 h
  have hat' : AtOff c.ty (ad.offset + (ev ρ j * nWords us + 0)) (cl ρ η.wit 0 0 u) := by
    refine AtOff_trans hat ?_
    simp only [cl, clI_zero]
    exact .elem hus hJ (.here (Or.inl (by rw [hus]; simp)))
  have hs' : etok (skel rt) = rf (.loc (skelM μ) (.array (.lit 0) (etok (skel (close σs u))))) := by
    rw [hl.2.1]; rfl
  obtain ⟨μr, ur, hbe, hμ, hsu⟩ := buf_runtime hs'
  have hbl := buf_lyt hl.2.2.2.2 hbe
  have htb := peek_tb htv hp
  simp only [tb] at htb
  have hsig : sig ur = sig (cl ρ η.wit 0 0 u) := by
    have e : sig ur = sig (close σs u) := sig_of_eskel hsu
    rw [e]; exact sig_WitL hW ρ hop (lt_of_guardT htb hK)
  have hwc := wc_of_sig hsig
  cases hus' : accs ur with
  | none => simp [wc, hus', hus] at hwc
  | some us' =>
      have hn : nWords us' = nWords us := by simpa [wc, hus, hus'] using hwc
      refine ⟨rt, w, ad, c, μr, ur, us', rti, wi, hea, hwv, hei, by simp [numOf, hwi], hbe, hus', hsto,
        ?_, hmode, IniAt_idx hini hus hJk hJ hn, hsu, hsig, htb,
        fun o V hV => IniAt_idxF hini hus hJk hJ hn hV⟩
      simpa [offs, hn] using hat'

/-- **P1 + P4 at the thread, `loadAt`** (T3c-5b): the slot's locative
(`slot_view`), then a load at it (`locLoad`). -/
theorem tstepM_loadAt {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {b i : At} {e : Expr}
    (hterm : th.term = .let_ x (.loadAt b i) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | loadAt hp hbuf hint hlt hltk _ hb =>
  obtain ⟨t, u, n, k, j, hp, hbuf, hint, hlt, hltk, hb⟩ : ∃ t u n k j, cx.peek b = .ok t ∧
      bufOf t = some (.own, n, u, k) ∧ IntIdx cx i j ∧ LtI cx j n ∧ LtI cx j k ∧ cx.bind x u = .ok c' :=
    ⟨_, _, _, _, _, hp, hbuf, hint, hlt, hltk, hb⟩
  obtain ⟨rt, w, ad, c, μr, ur, us, rti, wi, hea, hwv, hei, hj, hbe, hus, hsto, hat, hmode, hini, hsku, hsig, htbS, -⟩ :=
    slot_view hi.1 hi.2.1 hi.2.2.2.1 hi.2.2.2.2.1 htv hp hbuf hint hlt hltk (bind_opaqueOK hb)
  have haf' : (cl ρ η.wit 0 0 u).arrFree = true := arrFree_cl hi.2.2.2.2.2.2.1.af u 0 0 (bind_arrFree hb)
  have hna : ∀ N e', cl ρ η.wit 0 0 u ≠ .array (.lit N) e' := fun N e' h => by
    rw [h] at haf'; simp [Ty.arrFree] at haf'
  obtain ⟨us', hus', ⟨r0, hr0⟩, hld, hstw⟩ := locLoad (ad := offs ad (ev ρ j * nWords us)) (arch := g.arch) (pw := w) (acq := false)
    (s := stOf mem pairs th) hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hsto hmode hat hini hna hsku hsig
      (peek_buf_lyt hi.2.1 hp hbuf hea hbe).2
        (accs_rtW hE.2.1 hi.2.2.2.1 hi.2.2.2.2.1 (bind_opaqueOK hb) htbS (peek_buf_lyt hi.2.1 hp hbuf hea hbe).2)
  rw [hus] at hus'; cases hus'
  have key : tstep g mem pairs th =
      (loadUnits g.arch w (offs ad (ev ρ j * nWords us)) false us 0 (stOf mem pairs th)).map fun (s', ws) =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, ur, ws) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hei, hj, addrOf, hwv, hbe, hus, List.map_map]; rfl
  rw [key]
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hr0), fun r hr hpr0 => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨⟨s', wsr⟩, hl', rfl⟩ := hr
  obtain ⟨hvr, hlay, f1, f2, f3, f4, f5⟩ := hld (s', wsr) hl' (hpr0)
  exact ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv', bind_FInv hb hi hvr hlay, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩, MemInv_load hm f1 f2 f3 f4 f5 (loadUnits_relSt _ _ _ _ hl') (loadUnits_vWr _ _ _ _ hl')⟩

/-- **P1 + P4 at the thread, `xchgAt`** (T3c-5b): at the slot's locative, a
plain load then a plain store of the new value, as `xchg` at a locative. -/
theorem tstepM_xchgAt {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {b i v : At} {e : Expr}
    (hterm : th.term = .let_ x (.xchgAt b i v) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | xchgAt hp hbuf _ hint hlt hltk hu hsub hb =>
  obtain ⟨t, u, n, k, j, tv, c₁, hp, hbuf, hint, hlt, hltk, hu, hsub, hb⟩ : ∃ t u n k j tv c₁,
      cx.peek b = .ok t ∧ bufOf t = some (.own, n, u, k) ∧ IntIdx cx i j ∧ LtI cx j n ∧ LtI cx j k ∧
      cx.use v = .ok (tv, c₁) ∧ SubS c₁ tv u ∧ c₁.bind x u = .ok c' :=
    ⟨_, _, _, _, _, _, _, hp, hbuf, hint, hlt, hltk, hu, hsub, hb⟩
  have hotv : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have ho : cx.opaqueOK u = true := sub_opaqueOK hsub hotv
  obtain ⟨rt, w, ad, c, μr, ur, us, rti, wi, hea, hwv, hei, hj, hbe, hus, hsto, hat, hown, hini, hsku, hsig, htb, -⟩ :=
    slot_view hi.1 hi.2.1 hi.2.2.2.1 hi.2.2.2.2.1 htv hp hbuf hint hlt hltk ho
  have haf' : (cl ρ η.wit 0 0 u).arrFree = true := arrFree_cl hi.2.2.2.2.2.2.1.af u 0 0 (bind_arrFree hb)
  have hna : ∀ N e', cl ρ η.wit 0 0 u ≠ .array (.lit N) e' := fun N e' h => by
    rw [h] at haf'; simp [Ty.arrFree] at haf'
  obtain ⟨hi1, rv, wsv, hev, hvv, hlv⟩ := use_FInv hu hi
  obtain ⟨us', hus', ⟨r0, hr0⟩, hld, hstw⟩ := locLoad (ad := offs ad (ev ρ j * nWords us)) (arch := g.arch) (pw := w) (acq := false)
    (s := stOf mem pairs th) hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hsto hown hat hini hna hsku hsig
      (peek_buf_lyt hi.2.1 hp hbuf hea hbe).2
        (accs_rtW hE.2.1 hi.2.2.2.1 hi.2.2.2.2.1 ho htb (peek_buf_lyt hi.2.1 hp hbuf hea hbe).2)
  rw [hus] at hus'; cases hus'
  obtain ⟨hval, hlen⟩ := ownStoreVal hE.2.1 hi.2.2.2.1 hi.2.2.2.2.1 hi1.1 hsub ho htb hvv hlv hsig hus
  have hwUA : accs (cl ρ η.wit 0 0 u) = some us := (accs_rtW hE.2.1 hi.2.2.2.1 hi.2.2.2.2.1 ho htb (peek_buf_lyt hi.2.1 hp hbuf hea hbe).2).symm.trans hus
  have hwU : wc (cl ρ η.wit 0 0 u) = some (nWords us) := by rw [← wc_of_sig hsig]; simp [wc, hus]
  have key : tstep g mem pairs th =
      ((loadUnits g.arch w (offs ad (ev ρ j * nWords us)) false us 0 (stOf mem pairs th)).flatMap fun (s1, old) =>
        (storeUnits g.k g.arch w (offs ad (ev ρ j * nWords us)) false us wsv 0 s1).map fun s2 => (s2, ur, old)).map
        fun (s', t, ws) => (s'.mem, s'.pairs, withS { th with term := e, env := (x, t, ws) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hei, hev, hj, addrOf, hwv, hbe, hus]
  rw [key]
  have hm1 : ∀ r1, r1 ∈ loadUnits g.arch w (offs ad (ev ρ j * nWords us)) false us 0 (stOf mem pairs th) → PromAbove r1.1 →
      MemInv g (CE η) r1.1 := fun r1 h hp1 => by
    obtain ⟨_, _, f1, f2, f3, f4, f5⟩ := hld r1 h hp1
    exact MemInv_load hm f1 f2 f3 f4 f5 (loadUnits_relSt _ _ _ _ h) (loadUnits_vWr _ _ _ _ h)
  obtain ⟨s2, hs2⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := w)
    (a := offs ad (ev ρ j * nWords us)) (rel := false) us wsv 0 r0.1 hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem (List.mem_flatMap.2 ⟨r0, hr0, List.mem_map_of_mem hs2⟩)),
    fun r hr hpr0 => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨⟨s', t', ws'⟩, hr, rfl⟩ := hr
  rw [List.mem_flatMap] at hr
  obtain ⟨⟨s1, old⟩, h1, h2⟩ := hr
  rw [List.mem_map] at h2
  obtain ⟨s2, hs2, he2⟩ := h2
  simp only [Prod.mk.injEq] at he2
  obtain ⟨rfl, rfl, rfl⟩ := he2
  have hp2 : PromAbove s2 :=
    hpr0
  have hp1 : PromAbove s1 := storeUnits_promAbove hs2 hp2
  obtain ⟨hvr, hlay, -⟩ := hld (s1, old) h1 hp1
  exact ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv', bind_FInv hb hi1 hvr hlay, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
    MemInv_storeAt (a := offs ad (ev ρ j * nWords us)) (hm1 (s1, old) h1 hp1) hsto hown hat hini hna hval hwUA hlen s2 hs2⟩


/-! ## §10b Field paths into a slot (T3c-5b-4)

`loadAtF`/`xchgAtF` are `loadAt`/`xchgAt` at the component at field path `q`:
the static `compTy u q` is the runtime `compOff ur q` (`compOff_rt`), at an
offset of the closed element type, so `IniAt` holds there (`IniAt_idxF`). -/

theorem sig_prod (a b : Ty) : sig (.prod a b) = .prod (sig a) (sig b) := rfl

/-- A field path's runtime component has the static component's layout form. -/
theorem compOff_lyt {σs : List Ty} :
    ∀ (q : List Nat) (u c ur cR : Ty) (o : Nat), compTy u q = some c →
      etok (skel ur) = etok (skel (close σs u)) → etok (lyt 0 ur) = etok (lyt 0 (close σs u)) → compOff ur q = some (cR, o) →
      etok (lyt 0 cR) = etok (lyt 0 (close σs c))
  | [], u, c, ur, cR, o, h, _, hl, hco => by
      simp only [compTy, Option.some.injEq] at h; subst h
      simp only [compOff, Option.some.injEq, Prod.mk.injEq] at hco
      obtain ⟨rfl, -⟩ := hco; exact hl
  | 0 :: p, u, c, ur, cR, o, h, hsk, hl, hco => by
      cases u with
      | prod a b =>
          simp only [compTy] at h
          have hsk' : etok (skel ur) = .prod (etok (skel (close σs a))) (etok (skel (close σs b))) := by
            rw [hsk]; simp [close, substTs, skel, etok]
          obtain ⟨ra, rb, rfl, hka, hkb⟩ := eskel_eq_prod hsk'
          simp only [close, substTs, lyt, etok, Ty.prod.injEq] at hl
          simp only [compOff] at hco
          exact compOff_lyt p a c ra cR o h hka hl.1 hco
      | _ => simp [compTy] at h
  | 1 :: p, u, c, ur, cR, o, h, hsk, hl, hco => by
      cases u with
      | prod a b =>
          simp only [compTy] at h
          have hsk' : etok (skel ur) = .prod (etok (skel (close σs a))) (etok (skel (close σs b))) := by
            rw [hsk]; simp [close, substTs, skel, etok]
          obtain ⟨ra, rb, rfl, hka, hkb⟩ := eskel_eq_prod hsk'
          simp only [close, substTs, lyt, etok, Ty.prod.injEq] at hl
          cases ha : accs ra with
          | none => simp [compOff, ha] at hco
          | some us =>
            cases hb : compOff rb p with
            | none => simp [compOff, ha, hb] at hco
            | some pr =>
              obtain ⟨cb, ob⟩ := pr
              simp [compOff, ha, hb] at hco
              obtain ⟨rfl, -⟩ := hco
              exact compOff_lyt p b c rb cb ob h hkb hl.2 hb
      | _ => simp [compTy] at h
  | (_ + 2) :: _, u, _, _, _, _, h, _, _, _ => by cases u <;> simp [compTy] at h

/-- (T3c-5b) **A field path at runtime**: the static component `compTy u q = c`
is the runtime component `compOff ur q = (cR, o)` of the runtime element type
(same skeleton and signature), at offset `o` of the closed type. -/
theorem compOff_rt {σs : List Ty} {ρ : Nat → Nat} {W : Nat → Ty} :
    ∀ (q : List Nat) (u c ur : Ty) (usr : List Acc), compTy u q = some c →
      etok (skel ur) = etok (skel (close σs u)) → sig ur = sig (cl ρ W 0 0 u) → accs ur = some usr →
      ∃ cR o, compOff ur q = some (cR, o) ∧ etok (skel cR) = etok (skel (close σs c)) ∧
        sig cR = sig (cl ρ W 0 0 c) ∧ accs cR ≠ none ∧ AtOff (cl ρ W 0 0 u) o (cl ρ W 0 0 c)
  | [], u, c, ur, usr, h, hsk, hsg, hus => by
      simp only [compTy, Option.some.injEq] at h; subst h
      refine ⟨ur, 0, by simp [compOff], hsk, hsg, by simp [hus], .here (Or.inl ?_)⟩
      have := wc_of_sig hsg
      intro hn; simp [wc, hn, hus] at this
  | 0 :: p, u, c, ur, usr, h, hsk, hsg, hus => by
      cases u with
      | prod a b =>
          simp only [compTy] at h
          have hsk' : etok (skel ur) = .prod (etok (skel (close σs a))) (etok (skel (close σs b))) := by
            rw [hsk]; simp [close, substTs, skel, etok]
          obtain ⟨ra, rb, rfl, hka, hkb⟩ := eskel_eq_prod hsk'
          have hsg' : sig ra = sig (cl ρ W 0 0 a) ∧ sig rb = sig (cl ρ W 0 0 b) := by
            simpa [sig_prod, cl] using hsg
          obtain ⟨usa, husa⟩ : ∃ us, accs ra = some us := by
            cases h1 : accs ra with
            | none => simp [accs, h1] at hus
            | some us => exact ⟨us, rfl⟩
          obtain ⟨cR, o, h1, h2, h3, h4, h5⟩ := compOff_rt p a c ra usa h hka hsg'.1 husa
          refine ⟨cR, o, by simp [compOff, h1], h2, h3, h4, ?_⟩
          simp only [cl]; exact .fst h5
      | _ => simp [compTy] at h
  | 1 :: p, u, c, ur, usr, h, hsk, hsg, hus => by
      cases u with
      | prod a b =>
          simp only [compTy] at h
          have hsk' : etok (skel ur) = .prod (etok (skel (close σs a))) (etok (skel (close σs b))) := by
            rw [hsk]; simp [close, substTs, skel, etok]
          obtain ⟨ra, rb, rfl, hka, hkb⟩ := eskel_eq_prod hsk'
          have hsg' : sig ra = sig (cl ρ W 0 0 a) ∧ sig rb = sig (cl ρ W 0 0 b) := by
            simpa [sig_prod, cl] using hsg
          obtain ⟨usa, husa⟩ : ∃ us, accs ra = some us := by
            cases h1 : accs ra with
            | none => simp [accs, h1] at hus
            | some us => exact ⟨us, rfl⟩
          obtain ⟨usb, husb⟩ : ∃ us, accs rb = some us := by
            cases h1 : accs rb with
            | none => simp [accs, husa, h1] at hus
            | some us => exact ⟨us, rfl⟩
          obtain ⟨cR, o, h1, h2, h3, h4, h5⟩ := compOff_rt p b c rb usb h hkb hsg'.2 husb
          obtain ⟨usA, husA, hnA⟩ : ∃ us, accs (cl ρ W 0 0 a) = some us ∧ nWords us = nWords usa := by
            have hw := wc_of_sig hsg'.1
            cases h1 : accs (cl ρ W 0 0 a) with
            | none => simp [wc, husa, h1] at hw
            | some us => exact ⟨us, rfl, by simpa [wc, husa, h1] using hw.symm⟩
          refine ⟨cR, nWords usa + o, by simp [compOff, husa, h1], h2, h3, h4, ?_⟩
          simp only [cl]; rw [← hnA]; exact .snd husA h5
      | _ => simp [compTy] at h
  | (k + 2) :: p, u, c, ur, usr, h, _, _, _ => by
      cases u <;> simp [compTy] at h

theorem tb_compTy {n : Nat} : ∀ (q : List Nat) (u c : Ty), compTy u q = some c → tb n u = true → tb n c = true
  | [], u, c, h, ht => by simp only [compTy, Option.some.injEq] at h; subst h; exact ht
  | 0 :: p, u, c, h, ht => by
      cases u with
      | prod a b => simp only [compTy] at h; simp only [tb, Bool.and_eq_true] at ht; exact tb_compTy p a c h ht.1
      | _ => simp [compTy] at h
  | 1 :: p, u, c, h, ht => by
      cases u with
      | prod a b => simp only [compTy] at h; simp only [tb, Bool.and_eq_true] at ht; exact tb_compTy p b c h ht.2
      | _ => simp [compTy] at h
  | (k + 2) :: p, u, c, h, _ => by cases u <;> simp [compTy] at h

/-- **P1 + P4 at the thread, `loadAtF`** (T3c-5b): the slot (`slot_view`), the
field path's runtime component (`compOff_rt`), then a load there (`locLoad`). -/
theorem tstepM_loadAtF {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {b i : At} {q : List Nat} {e : Expr}
    (hterm : th.term = .let_ x (.loadAtF b i q) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | loadAtF hp hbuf hct hop hint hlt hltk _ hb =>
  obtain ⟨t, u, c, n, k, j, hp, hbuf, hct, hop, hint, hlt, hltk, hb⟩ : ∃ t u c n k j, cx.peek b = .ok t ∧
      bufOf t = some (.own, n, u, k) ∧ compTy u q = some c ∧ cx.opaqueOK u = true ∧ IntIdx cx i j ∧
      LtI cx j n ∧ LtI cx j k ∧ cx.bind x c = .ok c' :=
    ⟨_, _, _, _, _, _, hp, hbuf, hct, hop, hint, hlt, hltk, hb⟩
  obtain ⟨rt, w, ad, cc, μr, ur, us, rti, wi, hea, hwv, hei, hj, hbe, hus, hsto, hat, hmode, -, hsku, hsig, htbS, hiniF⟩ :=
    slot_view hi.1 hi.2.1 hi.2.2.2.1 hi.2.2.2.2.1 htv hp hbuf hint hlt hltk hop
  obtain ⟨cR, o, hco, hskc, hsgc, -, hato⟩ := compOff_rt q u c ur us hct hsku hsig hus
  have haf' : (cl ρ η.wit 0 0 c).arrFree = true := arrFree_cl hi.2.2.2.2.2.2.1.af c 0 0 (bind_arrFree hb)
  have hna : ∀ N e', cl ρ η.wit 0 0 c ≠ .array (.lit N) e' := fun N e' h => by
    rw [h] at haf'; simp [Ty.arrFree] at haf'
  have hat' : AtOff cc.ty (offs ad (ev ρ j * nWords us + o)).offset (cl ρ η.wit 0 0 c) := by
    have h2 := AtOff_trans hat hato
    simpa [offs, Nat.add_assoc] using h2
  obtain ⟨cs, hcs, ⟨r0, hr0⟩, hld, hstw⟩ := locLoad (ad := offs ad (ev ρ j * nWords us + o)) (arch := g.arch) (pw := w)
    (acq := false) (s := stOf mem pairs th) hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hsto hmode hat' (hiniF o _ hato) hna hskc hsgc
      (compOff_lyt q u c ur cR o hct hsku (peek_buf_lyt hi.2.1 hp hbuf hea hbe).2 hco)
        (accs_rtW hE.2.1 hi.2.2.2.1 hi.2.2.2.2.1 (bind_opaqueOK hb) (tb_compTy q u c hct htbS) (compOff_lyt q u c ur cR o hct hsku (peek_buf_lyt hi.2.1 hp hbuf hea hbe).2 hco))
  have key : tstep g mem pairs th =
      (loadUnits g.arch w (offs ad (ev ρ j * nWords us + o)) false cs 0 (stOf mem pairs th)).map fun (s', ws) =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, cR, ws) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hei, hj, addrOf, hwv, hbe, hus, hco, hcs, List.map_map]; rfl
  rw [key]
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hr0), fun r hr hpr0 => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨⟨s', wsr⟩, hl', rfl⟩ := hr
  obtain ⟨hvr, hlay, f1, f2, f3, f4, f5⟩ := hld (s', wsr) hl' (hpr0)
  exact ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv', bind_FInv hb hi hvr hlay, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩, MemInv_load hm f1 f2 f3 f4 f5 (loadUnits_relSt _ _ _ _ hl') (loadUnits_vWr _ _ _ _ hl')⟩

/-- **P1 + P4 at the thread, `xchgAtF`** (T3c-5b): at the field path's runtime
component of the slot, a plain load then a plain store of the new value. -/
theorem tstepM_xchgAtF {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {b i v : At} {q : List Nat} {e : Expr}
    (hterm : th.term = .let_ x (.xchgAtF b i q v) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hi : FInv ρ η th.σs (Resume p th.stack) cx th.env)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ThInvMF p g (CE η) (stOf mem pairs th) r.1 r.2.1 r.2.2 := by
  rw [hterm] at hT
  cases hT with
  | let_ hop he =>
  rename_i c'
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | xchgAtF hp hbuf hct hop _ hint hlt hltk hu hsub hb =>
  obtain ⟨t, u, c, n, k, j, tv, c₁, hp, hbuf, hct, hop, hint, hlt, hltk, hu, hsub, hb⟩ : ∃ t u c n k j tv c₁,
      cx.peek b = .ok t ∧ bufOf t = some (.own, n, u, k) ∧ compTy u q = some c ∧ cx.opaqueOK u = true ∧
      IntIdx cx i j ∧ LtI cx j n ∧ LtI cx j k ∧
      cx.use v = .ok (tv, c₁) ∧ SubS c₁ tv c ∧ c₁.bind x c = .ok c' :=
    ⟨_, _, _, _, _, _, _, _, hp, hbuf, hct, hop, hint, hlt, hltk, hu, hsub, hb⟩
  have hotv : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have ho : cx.opaqueOK c = true := sub_opaqueOK hsub hotv
  obtain ⟨rt, w, ad, cc, μr, ur, us, rti, wi, hea, hwv, hei, hj, hbe, hus, hsto, hat, hown, -, hsku, hsig, htbu, hiniF⟩ :=
    slot_view hi.1 hi.2.1 hi.2.2.2.1 hi.2.2.2.2.1 htv hp hbuf hint hlt hltk hop
  have htb : tb cx.ke.length c = true := tb_compTy q u c hct htbu
  obtain ⟨cR, o, hco, hskc, hsgc, -, hato⟩ := compOff_rt q u c ur us hct hsku hsig hus
  have haf' : (cl ρ η.wit 0 0 c).arrFree = true := arrFree_cl hi.2.2.2.2.2.2.1.af c 0 0 (bind_arrFree hb)
  have hna : ∀ N e', cl ρ η.wit 0 0 c ≠ .array (.lit N) e' := fun N e' h => by
    rw [h] at haf'; simp [Ty.arrFree] at haf'
  have hat' : AtOff cc.ty (offs ad (ev ρ j * nWords us + o)).offset (cl ρ η.wit 0 0 c) := by
    have h2 := AtOff_trans hat hato
    simpa [offs, Nat.add_assoc] using h2
  have hiniC := hiniF o _ hato
  obtain ⟨hi1, rv, wsv, hev, hvv, hlv⟩ := use_FInv hu hi
  obtain ⟨cs, hcs, ⟨r0, hr0⟩, hld, hstw⟩ := locLoad (ad := offs ad (ev ρ j * nWords us + o)) (arch := g.arch) (pw := w)
    (acq := false) (s := stOf mem pairs th) hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hsto hown hat' hiniC hna hskc hsgc
      (compOff_lyt q u c ur cR o hct hsku (peek_buf_lyt hi.2.1 hp hbuf hea hbe).2 hco)
        (accs_rtW hE.2.1 hi.2.2.2.1 hi.2.2.2.2.1 ho htb (compOff_lyt q u c ur cR o hct hsku (peek_buf_lyt hi.2.1 hp hbuf hea hbe).2 hco))
  obtain ⟨hval, hlen⟩ := ownStoreVal hE.2.1 hi.2.2.2.1 hi.2.2.2.2.1 hi1.1 hsub ho htb hvv hlv hsgc hcs
  have hwUA : accs (cl ρ η.wit 0 0 c) = some cs := (accs_rtW hE.2.1 hi.2.2.2.1 hi.2.2.2.2.1 ho htb (compOff_lyt q u c ur cR o hct hsku (peek_buf_lyt hi.2.1 hp hbuf hea hbe).2 hco)).symm.trans hcs
  have hwU : wc (cl ρ η.wit 0 0 c) = some (nWords cs) := by rw [← wc_of_sig hsgc]; simp [wc, hcs]
  have key : tstep g mem pairs th =
      ((loadUnits g.arch w (offs ad (ev ρ j * nWords us + o)) false cs 0 (stOf mem pairs th)).flatMap fun (s1, old) =>
        (storeUnits g.k g.arch w (offs ad (ev ρ j * nWords us + o)) false cs wsv 0 s1).map fun s2 => (s2, cR, old)).map
        fun (s', t, ws) => (s'.mem, s'.pairs, withS { th with term := e, env := (x, t, ws) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hei, hev, hj, addrOf, hwv, hbe, hus, hco, hcs]
  rw [key]
  have hm1 : ∀ r1, r1 ∈ loadUnits g.arch w (offs ad (ev ρ j * nWords us + o)) false cs 0 (stOf mem pairs th) → PromAbove r1.1 →
      MemInv g (CE η) r1.1 := fun r1 h hp1 => by
    obtain ⟨_, _, f1, f2, f3, f4, f5⟩ := hld r1 h hp1
    exact MemInv_load hm f1 f2 f3 f4 f5 (loadUnits_relSt _ _ _ _ h) (loadUnits_vWr _ _ _ _ h)
  obtain ⟨s2, hs2⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := w)
    (a := offs ad (ev ρ j * nWords us + o)) (rel := false) cs wsv 0 r0.1 hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem (List.mem_flatMap.2 ⟨r0, hr0, List.mem_map_of_mem hs2⟩)),
    fun r hr hpr0 => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨⟨s', t', ws'⟩, hr, rfl⟩ := hr
  rw [List.mem_flatMap] at hr
  obtain ⟨⟨s1, old⟩, h1, h2⟩ := hr
  rw [List.mem_map] at h2
  obtain ⟨s2, hs2, he2⟩ := h2
  simp only [Prod.mk.injEq] at he2
  obtain ⟨rfl, rfl, rfl⟩ := he2
  have hp2 : PromAbove s2 :=
    hpr0
  have hp1 : PromAbove s1 := storeUnits_promAbove hs2 hp2
  obtain ⟨hvr, hlay, -⟩ := hld (s1, old) h1 hp1
  exact ⟨CE η, EFoot_refl, ⟨ρ, η, c', rfl, hE, he, htv', bind_FInv hb hi1 hvr hlay, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
    MemInv_storeAt (a := offs ad (ev ρ j * nWords us + o)) (hm1 (s1, old) h1 hp1) hsto hown hat' hiniC hna hval hwUA hlen s2 hs2⟩

/-! ## §11 Initialising a slot of an own buffer (T3c-5b-4)

`bufInit b i v` stores `v` at slot `j = ini` and raises the buffer's
initialised count: the frame's view moves to `bumpIni` (an `Ext`), the cell's
new words are `BufOK` with one more slot (`BufOK_put`). -/

/-- A component of a laid-out type is laid out. -/
theorem accs_AtOff {T U : Ty} {o : Nat} (h : AtOff T o U) : accs T ≠ none → accs U ≠ none := by
  induction h with
  | here _ => exact id
  | fold _ _ ha _ _ => intro _; exact ha
  | @fst a b u o _ ih =>
      intro h; apply ih; intro ha; apply h; simp [accs, ha]
  | @snd a b u o ua0 hua _ ih =>
      intro h; apply ih; intro hb; apply h; simp [accs, hua, hb]
  | elem _ _ _ _ => intro h; exact (h (by simp [accs])).elim
  | @mu ρ W s u o hW hg _ ih => intro h; exact ih (accs_cl_unfold s h)

/-- A buffer handle's runtime type: a refined locative to an array. -/
theorem buf_runtime' {rt e : Ty} {m : Mode} (h : etok (skel rt) = rf (.loc m (.array (.lit 0) e))) :
    ∃ μr i ur ψ, rt = .refine (.loc μr (.array i ur)) ψ ∧ skelM μr = m ∧ etok (skel ur) = e := by
  cases rt with
  | refine t ψ =>
      simp only [skel, etok_rf] at h
      have h' : rf (etok (skel t)) = .refine (.loc m (.array (.lit 0) e)) .tt := by rw [h]; rfl
      obtain ⟨e1, -⟩ := rf_eq_refine h'
      obtain ⟨μr, u', rfl, h1, h2⟩ := eskel_eq_loc e1
      obtain ⟨i, ur, rfl, h3⟩ := eskel_eq_array h2
      exact ⟨μr, i, ur, ψ, rfl, h1, h3⟩
  | _ => simp [skel, etok, rf] at h

theorem close_refine (σs : List Ty) (t : Ty) (ψ : Pred) : close σs (.refine t ψ) = .refine (close σs t) ψ := by
  simp [close, substTs]

/-- A refinement's layout does not depend on its predicate. -/
theorem Lay_repred {σs : List Ty} {t rt : Ty} {ψ ψ' φ φ' : Pred} {ws : List Word}
    (h : Lay σs (.refine t ψ) (.refine rt φ) ws) : Lay σs (.refine t ψ') (.refine rt φ') ws := by
  obtain ⟨h1, h2, h3, h4⟩ := h
  refine ⟨h1, ?_, h3, h4⟩
  rw [close_refine] at h2 ⊢
  exact h2

/-- (T3c-5b) **A slot put into a buffer**: slot `j` replaced by a value of the
element type; the slots initialised after are the old ones and `j`. -/
theorem BufOK_put {E : TEnv} {n n' N : Nat} {e : Ty} {us : List Acc} {vals q : List Word} {j : Nat}
    (hb : BufOK E n (.array (.lit N) e) vals) (hus : accs e = some us) (hj : j < N)
    (hn' : n' ≤ N) (hcov : ∀ j', j' < n' → j' < n ∨ j' = j)
    (hq : ValOf E e q) (hql : q.length = nWords us) :
    BufOK E n' (.array (.lit N) e) (vals.take (j * nWords us) ++ q ++ vals.drop (j * nWords us + nWords us)) := by
  obtain ⟨N', e', us', hT, hus', hn, hlen, hslots⟩ := hb
  simp only [Ty.array.injEq, Idx.lit.injEq] at hT
  obtain ⟨hN, he⟩ := hT
  subst hN; subst he
  rw [hus] at hus'; cases hus'
  have hbw : j * nWords us + nWords us ≤ vals.length := by
    have hm := Nat.mul_le_mul_right (nWords us) (show j + 1 ≤ N by omega)
    rw [Nat.succ_mul] at hm; omega
  refine ⟨N, e, us, rfl, hus, hn', ?_, fun j' hj' => ?_⟩
  · simp only [List.length_append, List.length_take, List.length_drop, hql]; omega
  · have hsl := fun (i : Nat) => slice_get (vals.take (j * nWords us) ++ q ++ vals.drop (j * nWords us + nWords us))
      (j' * nWords us) (nWords us) i
    by_cases hjj : j' = j
    · subst hjj
      have e : ((vals.take (j' * nWords us) ++ q ++ vals.drop (j' * nWords us + nWords us)).drop
          (j' * nWords us)).take (nWords us) = q := by
        apply List.ext_getElem?; intro i
        rw [hsl i, splice_get vals q _ _ _ hql hbw]
        by_cases hi : i < nWords us
        · rw [iteT hi, iteT ⟨Nat.le_add_right _ _, by omega⟩, Nat.add_sub_cancel_left]
        · rw [iteF hi, List.getElem?_eq_none (by omega)]
      rw [e]; exact hq
    · have hj'n : j' < n := (hcov j' hj').resolve_right hjj
      have e : ((vals.take (j * nWords us) ++ q ++ vals.drop (j * nWords us + nWords us)).drop
          (j' * nWords us)).take (nWords us) = (vals.drop (j' * nWords us)).take (nWords us) := by
        apply List.ext_getElem?; intro i
        rw [hsl i, slice_get vals]
        by_cases hi : i < nWords us
        · rw [iteT hi, iteT hi, splice_get vals q _ _ _ hql hbw, iteF ?_]
          intro hr; obtain ⟨hr1, hr2⟩ := hr
          rcases Nat.lt_or_gt_of_ne hjj with h | h
          · have hm := Nat.mul_le_mul_right (nWords us) (show j' + 1 ≤ j by omega)
            rw [Nat.succ_mul] at hm; omega
          · have hm := Nat.mul_le_mul_right (nWords us) (show j + 1 ≤ j' by omega)
            rw [Nat.succ_mul] at hm; omega
        · rw [iteF hi, iteF hi]
      rw [e]; exact hslots j' hj'n

/-- (F2′ b″) `bufInit`'s `RiniW`: the slot `j ≤ rc` it writes is the only one
the real count may newly cover. -/
theorem riniW_bufInit {g : G} {E E' : TEnv} {s : St} {ad : Address} {c : Cell} {N j : Nat} {e : Ty}
    {us : List Acc} {ws : List Word} {pw : Word}
    (hm : MemInv g E s) (hsto : E.sto ad.label = some c)
    (hini : IniAt E.rc c ad (.array (.lit N) e))
    (hwe : accs e = some us) (hjn : j ≤ E.rc ad.label)
    (hril : E'.rini ad.label = max (E.rini ad.label) (j + 1))
    (hrio : ∀ l', l' ≠ ad.label → E'.rini l' = E.rini l') :
    ∀ s', s' ∈ storeUnits g.k g.arch pw (offs ad (j * nWords us)) false us ws 0 s → RiniW E E' s s'.vs.vWr := by
  intro s' hs' l c' hc' N' e' us' hT' hus' o h1 h2
  by_cases hl' : l ≠ ad.label
  · rw [hrio l hl'] at h2; exact absurd (Nat.lt_of_le_of_lt h1 h2) (Nat.lt_irrefl _)
  have hl : l = ad.label := Classical.byContradiction hl'
  subst hl
  rw [hsto] at hc'; cases hc'
  obtain ⟨hUc, hoff⟩ : Ty.array (.lit N) e = c.ty ∧ ad.offset = 0 := by
    rcases hini N' e' hT' with ⟨hUc, h0⟩ | ⟨us0, j0, o0, hus0, -, -, hato⟩
    · exact ⟨hUc, h0.symm⟩
    · exact (accs_AtOff hato (by rw [hus0]; simp) (by simp [accs])).elim
  rw [hT'] at hUc
  simp only [Ty.array.injEq, Idx.lit.injEq] at hUc
  obtain ⟨-, rfl⟩ := hUc
  rw [hwe] at hus'; cases hus'
  have hjr : j ≤ E.rini ad.label := Nat.le_trans hjn (Nat.min_le_right _ _)
  have hjo : j * nWords us ≤ o := Nat.le_trans (Nat.mul_le_mul_right _ hjr) h1
  have ho2 : o < j * nWords us + nWords us := by
    rw [hril] at h2
    rcases Nat.le_total (E.rini ad.label) (j + 1) with h | h
    · rw [Nat.max_eq_right h, Nat.succ_mul] at h2; exact h2
    · rw [Nat.max_eq_left h] at h2; exact absurd (Nat.lt_of_le_of_lt h1 h2) (Nat.lt_irrefl _)
  generalize j * nWords us = A at hjo ho2 hs'
  have hq : o - A < nWords us := by omega
  have hA : offs (offs ad A) (0 + (o - A)) = ⟨ad.label, o⟩ := by
    have e : A + (o - A) = o := Nat.add_sub_cancel' hjo
    show (⟨ad.label, ad.offset + A + (0 + (o - A))⟩ : Address) = ⟨ad.label, o⟩
    rw [hoff, Nat.zero_add, Nat.zero_add, e]
  have hle := storeUnits_cohLe us ws 0 s s' hs' (o - A) hq
  rw [hA] at hle
  refine ⟨s'.vs.coh ⟨ad.label, o⟩, hle, ?_⟩
  rcases storeUnits_cohW us ws 0 s s' hs' hm.2.2.1 (o - A) hq with h | ⟨u, hu, m, hm', hl, hc⟩
  · rw [hA] at h; exact Or.inl h
  · rw [hA] at hl hc; rw [hc]; exact Or.inr ⟨hu, m, hm', hl⟩

/-- (EFoot tags, RiniArr) The target of a `bufInit` (a buffer component of an own cell) is a
whole buffer cell (`BufOK`). -/
theorem ArrAt_of_buf {g : G} {E : TEnv} {s : St} {ad : Address} {c : Cell} {N : Nat} {e : Ty}
    (hm : MemInv g E s) (hsto : E.sto ad.label = some c) (hown : c.owner = some E.tid)
    (hat : AtOff c.ty ad.offset (.array (.lit N) e)) : ArrAt E ad.label := by
  obtain ⟨vals, hcell, -, -⟩ := hm.2.1 ad.label c hsto hown
  obtain ⟨N', e', usB, hT, husB, -⟩ : BufOK E (E.rc ad.label) c.ty vals := by
    rcases hcell with ⟨hwc, hv⟩ | hb
    · exfalso
      obtain ⟨hvr0, hV0⟩ := hv
      obtain ⟨n', hwn, -⟩ := VR_at E.unsee hat hvr0 hV0 hwc
      simp [wc, accs] at hwn
    · exact hb
  exact ⟨c, N', e', usB, hsto, hT, husB⟩
#print axioms ArrAt_of_buf

/-- (T3c-5b) **`bufInit` keeps `MemInv`**, at the view whose initialised count
for the buffer is raised past slot `j`.  The handle is at the start of the
cell, which is a buffer (`IniAt`; a laid-out cell has no array component,
`VR_at`); slot `j` is at most the count, so the slots initialised after are
the old ones and `j` (`BufOK_put`). -/
theorem MemInv_bufInit {g : G} {E E' : TEnv} {s : St} {ad : Address} {c : Cell} {N j : Nat} {e : Ty}
    {us : List Acc} {ws : List Word} {pw : Word}
    (hm : MemInv g E s) (hsto : E.sto ad.label = some c) (hown : c.owner = some E.tid)
    (hat : AtOff c.ty ad.offset (.array (.lit N) e)) (hini : IniAt E.rc c ad (.array (.lit N) e))
    (hwe : accs e = some us) (hj : j < N) (hjn : j ≤ E.rc ad.label)
    (hq : EnvVal E e ws) (hlen : ws.length = nWords us)
    (hp : E.prog = E'.prog) (ht : E.tid = E'.tid) (hs : E'.sto = E.sto)
    (hil : E'.ini ad.label = max (E.ini ad.label) (j + 1)) (hio : ∀ l', l' ≠ ad.label → E'.ini l' = E.ini l')
    (hril : E'.rini ad.label = max (E.rini ad.label) (j + 1))
    (hrio : ∀ l', l' ≠ ad.label → E'.rini l' = E.rini l')
    (hpf : E'.pfr = E.pfr) (hse : E'.seen = E.seen)
    (hbx : ∀ l B, E.box l = some B → E'.box l = some B := by first | exact fun _ _ h => h | simp_all | (intro _ _ h; simpa [CE, TEnv.withSto] using h))
    (hbe : E'.box = E.box := by first | rfl | simp_all)
