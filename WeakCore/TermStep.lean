/-! ### (P4 step 5b) Frame-only steps with credits; the machine promise step -/

/-- (P4) A frame-only step whose outcomes keep memory, the promises and
`MemInv` at `CE η`, with `tstepR_step`'s conclusion: the target shape, with
`TotStep.same ↦ MintStep.none`, `fresh ↦ fresh`, `claim ↦ claim`. -/
theorem lift_MCk {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {η : TEnv}
    {Rf Rs H : Res} {cr db : Ts → Res}
    (h : tstep g mem pairs th ≠ [] ∧
      ∀ r ∈ tstep g mem pairs th, ∃ Tot', ThInvRE p (CE η) r.2.2 Tot' ∧ TotStep th.term η (Rf + Rs) Tot')
    (hk : ∀ r ∈ tstep g mem pairs th, (stOf r.1 r.2.1 r.2.2).mem = (stOf mem pairs th).mem ∧
      (stOf r.1 r.2.1 r.2.2).promises = (stOf mem pairs th).promises ∧ MemInv g (CE η) (stOf r.1 r.2.1 r.2.2))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStep g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧ ClaimAt th.term C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  refine ⟨h.1, fun r hr => ?_⟩
  obtain ⟨Tot', hT, hts⟩ := h.2 r hr
  obtain ⟨e1, e2, hm'⟩ := hk r hr
  cases hts with
  | same =>
      refine mc_keepM (Rf := Rf) (Rs := Rs) hT hm' e1 e2 hH hC .none (ClaimAt_zero _ _) ?_
      first | exact Res.le_refl _ | (rw [Res.add_zero, Res.add_zero]; exact Res.le_refl _)
  | fresh =>
      refine mc_keepM (Rf := Rf) (Rs := Rs) hT hm' e1 e2 hH hC .fresh (ClaimAt_zero _ _) ?_
      first | exact Res.le_refl _ | (rw [Res.add_zero]; exact Res.le_refl _)
  | claim n j hcl hle => exact mc_keepM hT hm' e1 e2 hH hC (.claim n j) (fun _ _ _ _ => hcl) hle

theorem keepS {g : G} {E : TEnv} {s : St} {A : List (Memory × List Ts × TTh)} (hm : MemInv g E s)
    (hs : ∀ r ∈ A, Same s (stOf r.1 r.2.1 r.2.2)) :
    ∀ r ∈ A, (stOf r.1 r.2.1 r.2.2).mem = s.mem ∧ (stOf r.1 r.2.1 r.2.2).promises = s.promises ∧
      MemInv g E (stOf r.1 r.2.1 r.2.2) :=
  fun r hr => ⟨(hs r hr).1, (hs r hr).2.2.2.1, MemInv_same hm (hs r hr)⟩

/-- **(P4) `lift` with credits**: a frame-only step changing nothing `MemInv`
reads (`Same`), with `tstepR_step`'s conclusion, gives the target shape. -/
theorem lift_MC {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {η : TEnv}
    {Rf Rs H : Res} {cr db : Ts → Res} (hm : MemInv g (CE η) (stOf mem pairs th))
    (h : tstep g mem pairs th ≠ [] ∧
      ∀ r ∈ tstep g mem pairs th, ∃ Tot', ThInvRE p (CE η) r.2.2 Tot' ∧ TotStep th.term η (Rf + Rs) Tot')
    (hs : ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStep g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧ ClaimAt th.term C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F :=
  lift_MCk h (keepS hm hs) hH hC

/-- (P4) The frame-only ops that touch no state: `mkTicket`, the capability
ops and `claim`, `null`, `zero`, `fold`, `fld`, `idx`, `fnptr`. -/
def KeepOp : Op → Prop
  | .mkTicket _ _ _ _ _ | .borrow _ _ | .freeze _ | .endBorrow _ | .claim _ _ => True
  | .null _ _ | .zero _ | .fold _ _ | .fld _ _ | .idx _ _ | .fnptr _ => True
  | _ => False

theorem keep_state {g : G} {env : Env} {σs : List Ty} {s : St} {op : Op} (hA : KeepOp op) :
    ∀ r ∈ evalOp g env σs s op, r.1 = s := by
  intro r hr
  cases op <;> simp only [KeepOp] at hA <;> simp only [evalOp, ol, bind, pure] at hr
  all_goals (try simp only [Option.mem_toList, List.mem_singleton] at hr)
  all_goals (repeat (first
    | (subst hr; rfl)
    | (simp only [Option.bind_eq_some_iff, Option.map_eq_some_iff] at hr)
    | (obtain ⟨_, hr⟩ := hr)
    | (split at hr)))
  all_goals first
    | rfl
    | (subst hr; rfl)
    | (simp only [Option.some.injEq] at hr; subst hr; rfl)
    | (simp only [List.mem_singleton] at hr; subst hr; rfl)
    | (cases hr)
    | (simp at hr; done)
    | (simp only [Functor.map, Option.bind_eq_some_iff, Option.map_eq_some_iff] at hr
       obtain ⟨_, _, hr⟩ := hr
       split at hr <;> first | (cases hr; rfl) | cases hr)

section
variable {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}

theorem same_keep {x : String} {op : Op} {e : Expr} (hterm : th.term = .let_ x op e) (hA : KeepOp op) :
    ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) :=
  same_let hterm (fun f is a ts h => by subst h; exact hA) (fun f a h => by subst h; exact hA)
    (fun r hr => same_of_eq (keep_state hA r hr))

/-- A fence raises only views: memory and promises stay, `MemInv` too. -/
theorem keep_fence {E : TEnv} {x : String} {f : Fence} {e : Expr} (hterm : th.term = .let_ x (.fence f) e)
    (hm : MemInv g E (stOf mem pairs th)) :
    ∀ r ∈ tstep g mem pairs th, (stOf r.1 r.2.1 r.2.2).mem = (stOf mem pairs th).mem ∧
      (stOf r.1 r.2.1 r.2.2).promises = (stOf mem pairs th).promises ∧ MemInv g E (stOf r.1 r.2.1 r.2.2) := by
  intro r hr
  have key : tstep g mem pairs th =
      [((fenceS (stOf mem pairs th) (toWFence f)).mem, (fenceS (stOf mem pairs th) (toWFence f)).pairs,
        withS { th with term := e, env := (x, .unit, []) :: th.env } (fenceS (stOf mem pairs th) (toWFence f)))] := by
    simp only [tstep, hterm, evalOp]; rfl
  rw [key, List.mem_singleton] at hr
  subst hr
  rw [stOf_withS]
  exact ⟨rfl, rfl, MemInv_fenceG _ hm⟩

/-- (D1) `region` fences as `fence` does: memory, promises and `MemInv` stay. -/
theorem keep_region {E : TEnv} {a : At} {rn pn tn : String} {e : Expr} (hterm : th.term = .region a rn pn tn e)
    (hm : MemInv g E (stOf mem pairs th)) :
    ∀ r ∈ tstep g mem pairs th, (stOf r.1 r.2.1 r.2.2).mem = (stOf mem pairs th).mem ∧
      (stOf r.1 r.2.1 r.2.2).promises = (stOf mem pairs th).promises ∧ MemInv g E (stOf r.1 r.2.1 r.2.2) := by
  intro r hr
  rw [fence_region hterm r hr]
  exact ⟨rfl, rfl, MemInv_fenceG _ hm⟩

theorem same_inlR {p : Prog} {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {K : TEnv → Nat → List Word → Res → Prop}
    {Rf : Res} {x : String} {τ : Ty} {a : At} {e : Expr}
    (hterm : th.term = .let_ x (.inl τ a) e)
    (hnb : ∀ t c₁, cx.use a = .ok (t, c₁) → (close th.σs (.sum t τ)).tier ≠ .boxed)
    (hT : Typed p cx th.term) (hi : FInvR ρ η th.σs K cx th.env Rf) :
    ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) := by
  refine same_inl hterm fun t ws hea => ?_
  rw [hterm] at hT
  cases hT with
  | let_ hop _ =>
      cases hop with
      | inl _ hu _ =>
          obtain ⟨-, rt, ws', hea', -, hl⟩ := use_FInv hu hi.1
          rw [hea, Option.some.injEq, Prod.mk.injEq] at hea'
          obtain ⟨rfl, rfl⟩ := hea'
          rw [tier_of_eskel (u := close th.σs (.sum _ τ)) (by show Ty.sum (etok (skel t)) _ = _; rw [hl.2.1]; rfl)]
          exact hnb _ _ hu

theorem same_inrR {p : Prog} {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {K : TEnv → Nat → List Word → Res → Prop}
    {Rf : Res} {x : String} {τ : Ty} {a : At} {e : Expr}
    (hterm : th.term = .let_ x (.inr τ a) e)
    (hnb : ∀ t c₁, cx.use a = .ok (t, c₁) → (close th.σs (.sum τ t)).tier ≠ .boxed)
    (hT : Typed p cx th.term) (hi : FInvR ρ η th.σs K cx th.env Rf) :
    ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) := by
  refine same_inr hterm fun t ws hea => ?_
  rw [hterm] at hT
  cases hT with
  | let_ hop _ =>
      cases hop with
      | inr _ hu _ =>
          obtain ⟨-, rt, ws', hea', -, hl⟩ := use_FInv hu hi.1
          rw [hea, Option.some.injEq, Prod.mk.injEq] at hea'
          obtain ⟨rfl, rfl⟩ := hea'
          rw [tier_of_eskel (u := close th.σs (.sum τ _)) (by show Ty.sum _ (etok (skel t)) = _; rw [hl.2.1]; rfl)]
          exact hnb _ _ hu

theorem same_caseR {p : Prog} {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {Rf Rs : Res}
    {a : At} {x y : String} {e₁ e₂ : Expr}
    (hterm : th.term = .case a x e₁ y e₂)
    (hnb : ∀ t c₁, cx.use a = .ok (t, c₁) → (close th.σs t).tier ≠ .boxed)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) :
    ∀ r ∈ tstep g mem pairs th, Same (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) := by
  rw [hterm] at hT hCk
  obtain ⟨ra, rb, ws, j, p', hea, hS, has, -, -⟩ := case_stepR hT hCk hi (RLink_of hE.2.1 hE.2.2) hE.2.2 hnb htv
  obtain ⟨hta, htb⟩ := tier_sum hS
  intro r hr
  by_cases hj : j < (armsOf ra).length
  · simp only [tstep, hterm, hea, projM_nb hS, has, ol, Option.map_some, Option.toList_some,
      List.flatMap_cons, List.flatMap_nil, hj, ite_true, injM_nb hta, List.append_nil, List.mem_map,
      Option.mem_toList, Option.map_eq_some_iff] at hr
    obtain ⟨_, ⟨_, _, rfl⟩, rfl⟩ := hr
    exact ⟨rfl, rfl, rfl, rfl, rfl⟩
  · simp only [tstep, hterm, hea, projM_nb hS, has, ol, Option.map_some, Option.toList_some,
      List.flatMap_cons, List.flatMap_nil, hj, ite_false, injM_nb htb, List.append_nil, List.mem_map,
      Option.mem_toList, Option.map_eq_some_iff] at hr
    obtain ⟨_, ⟨_, _, rfl⟩, rfl⟩ := hr
    exact ⟨rfl, rfl, rfl, rfl, rfl⟩

end

/-- (P4) Every term `tstepR_step` covers keeps memory, the promises and
`MemInv` (all but `fence` change nothing `MemInv` reads; `fence` raises views). -/
theorem frame_keep {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {Rf Rs : Res}
    (hsc : StepScopeR th.σs cx th.term)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th)) :
    ∀ r ∈ tstep g mem pairs th, (stOf r.1 r.2.1 r.2.2).mem = (stOf mem pairs th).mem ∧
      (stOf r.1 r.2.1 r.2.2).promises = (stOf mem pairs th).promises ∧ MemInv g (CE η) (stOf r.1 r.2.1 r.2.2) := by
  have hT0 := hT
  generalize ht : th.term = t0 at hT0 hsc
  cases hT0 with
  | let_ hop _ =>
    cases hop
    all_goals first
      | exact False.elim hsc
      | exact keepS hm (same_pure ht trivial)
      | exact keepS hm (same_pure ht hsc)
      | exact keepS hm (same_keep ht trivial)
      | exact keepS hm (same_call ht)
      | exact keepS hm (same_callc ht)
      | exact keepS hm (same_inlR ht hsc hT hi)
      | exact keepS hm (same_inrR ht hsc hT hi)
      | exact keep_fence ht hm
  | split => exact keepS hm (same_split ht)
  | unpack => exact keepS hm (same_unpack ht)
  | unpackT => exact keepS hm (same_unpackT ht)
  | ifnull => exact keepS hm (same_ifnull ht)
  | parity => exact keepS hm (same_parity ht)
  | ifeqPlain | ifeq | ifeqRec | ifeqZero => exact keepS hm (same_ifeq ht)
  | case => exact keepS hm (same_caseR ht hsc hT hCk hi hE htv)
  | region | regionBuf => exact keep_region ht hm
  | openPub => exact keepS hm (same_openPub ht)
  | casCell | casShare | casTake | casEpoch => exact False.elim hsc
  | caspMove | caspTake | caspE | caspBump => exact False.elim hsc
  | ret => exact keepS hm (same_ret ht)
  | tail => exact keepS hm (same_tail ht)

/-- **(P4 step 5b) Every frame-only term, with credits** (`tstepR_step` plus
`frame_keep`): scope `StepScopeR`; memory and promises unchanged, so memory's
holding and the credits carry over; mints as `TotStep` (none / fresh region /
`claim`'s exchange). -/
theorem tstepMC_frame {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {Rf Rs H : Res} {cr db : Ts → Res}
    [ProgRetIall p] [TermA4.ProgCkWC p] (hP : ProgT p) (hp : g.p = p) (hnd : isDone th = false)
    (hsc : StepScopeR th.σs cx th.term)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hSub : PwSubS) (hSig : PwSig) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStep g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧ ClaimAt th.term C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F :=
  lift_MCk (tstepR_step hP hp hnd hsc hT hCk hi hE htv hRP hPS hSub hSig) (frame_keep hsc hT hCk hi hE htv hm) hH hC

/-! ### (P4 step 5b) The machine promise step: credits and debits -/

/-- (P4) The state after thread-level promise of `v` at `a` with view `w`
(TermRun's `promise`: append the message, record its index as a promise). -/
def promSt (s : St) (a : Address) (v : WeakMem.Val) (w : Ts) : St :=
  { s with
    mem := s.mem.push ⟨a, v, w⟩
    promises := s.promises ++ [s.mem.size] }

theorem promSt_mem (s : St) (a : Address) (v : WeakMem.Val) (w : Ts) : (promSt s a v w).mem = s.mem.push ⟨a, v, w⟩ := rfl

theorem promSt_promises (s : St) (a : Address) (v : WeakMem.Val) (w : Ts) :
    (promSt s a v w).promises = s.promises ++ [s.mem.size] := rfl

/-- `TermRun.promise` at thread `i`'s state is `promSt`. -/
theorem stOf_promise (mem : Memory) (pairs : List Ts) (th : TTh) (a : Address) (v : WeakMem.Val) (w : Ts) :
    stOf (mem.push ⟨a, v, w⟩) pairs { th with promises := th.promises ++ [mem.size] } =
      promSt (stOf mem pairs th) a v w := rfl

/-- (P6) A promise step keeps `PromOK`: the new promise is the old memory's
size, past every promise and every pair start. -/
theorem PromOK_promise {s : St} {a : Address} {v : WeakMem.Val} {w : Ts} (h : PromOK s)
    (hlt : ∀ t, t ∈ s.promises → t < s.mem.size) (hpr : ∀ t, t ∈ s.pairs → t + 1 < s.mem.size) :
    PromOK (promSt s a v w) := by
  refine ⟨List.nodup_append.2 ⟨h.1, by simp, fun x hx y hy => ?_⟩, fun t ht hq => ?_, fun t ht p hp e => ?_⟩
  · rw [List.mem_singleton] at hy; subst hy; exact Nat.ne_of_lt (hlt x hx)
  · rcases List.mem_append.1 ht with h1 | h1
    · exact h.2.1 t h1 hq
    · rw [List.mem_singleton] at h1; subst h1; exact Nat.lt_irrefl _ (Nat.lt_trans (Nat.lt_succ_self _) (hpr _ hq))
  · rcases List.mem_append.1 ht with h1 | h1
    · exact h.2.2 t h1 p hp e
    · rw [List.mem_singleton] at h1; subst h1
      have := hpr p hp; rw [← e] at this; exact Nat.lt_irrefl _ this

/-- (P6) **`PromOK` across a promise step** from a state meeting `MemInv`
(promises and pair starts lie below the memory's size). -/
theorem MemInv_promOK_promise {g : G} {E : TEnv} {s : St} {a : Address} {v : WeakMem.Val} {w : Ts}
    (hm : MemInv g E s) : PromOK (promSt s a v w) :=
  PromOK_promise hm.2.2.2.2.2.2.2.2.2.2 (MemInv_promLt hm) hm.1.2.2

/-- (S4e) Behind an index of `promSt` that is not a promise: an old message,
not an old promise. -/
theorem promSt_old {s : St} {a : Address} {v : WeakMem.Val} {w : Ts} {t : Nat} {m : Msg}
    (ht : t ∉ (promSt s a v w).promises) (hm : (promSt s a v w).mem[t]? = some m) :
    t ∉ s.promises ∧ s.mem[t]? = some m := by
  have hne : t ≠ s.mem.size := fun e =>
    ht (by rw [promSt_promises, e]; exact List.mem_append_right _ (List.mem_singleton_self _))
  refine ⟨fun h => ht (by rw [promSt_promises]; exact List.mem_append_left _ h), ?_⟩
  rw [promSt_mem, Array.getElem?_push] at hm
  simpa [hne] using hm

/-- (S4e) A latest word skipping `P` stays one in memory with a new promise,
skipping it too. -/
theorem LatestP_push_prom {mem : Memory} {P : List Ts} {coh : Address → Ts} {b : Address} {x : Word}
    (m : Msg) (h : LatestP mem P coh b x) : LatestP (mem.push m) (P ++ [mem.size]) coh b x := by
  obtain ⟨⟨m0, hm0, h1, h2, h3⟩, hn, hl⟩ := h
  have hlt := lt_of_get hm0
  refine ⟨⟨m0, by rw [push_lt hlt]; exact hm0, h1, h2, h3⟩, fun h => ?_, fun t m' ht hm' hl' => ?_⟩
  · rcases List.mem_append.1 h with h | h
    · exact hn h
    · exact Nat.ne_of_lt hlt (List.mem_singleton.1 h)
  · by_cases e : t = mem.size
    · subst e; exact List.mem_append_right _ (List.mem_singleton_self _)
    · have h2' : mem[t]? = some m' := by
        rw [Array.getElem?_push] at hm'; simpa [e] using hm'
      exact List.mem_append_left _ (hl t m' ht h2' hl')

/-- (F2) An own cell's `OwnCellF` survives a new promise, skipped. -/
theorem OwnCellF_push_prom {η : TEnv} {mem : Memory} {pairs : List Ts} {vs : VState} {P : List Ts}
    {l : AllocLabel} {c : Cell} (m : Msg) (h : OwnCellF η mem pairs vs (· ∈ P) l c)
    (hsz : ∀ p, p ∈ pairs → p + 1 < mem.size) :
    OwnCellF η (mem.push m) pairs vs (· ∈ P ++ [mem.size]) l c := by
  have old : ∀ (t : Nat) (mm : Msg), ¬ (t ∈ P ++ [mem.size]) → (mem.push m)[t]? = some mm →
      ¬ t ∈ P ∧ mem[t]? = some mm := fun t mm ht hm' => by
    have hne : t ≠ mem.size := fun e =>
      ht (by rw [e]; exact List.mem_append_right _ (List.mem_singleton_self _))
    exact ⟨fun h' => ht (List.mem_append_left _ h'), by rw [Array.getElem?_push] at hm'; simpa [hne] using hm'⟩
  have hold : ∀ t, t < mem.size → (mem.push m)[t]? = mem[t]? := fun t ht => push_lt ht
  obtain ⟨vals, h1, h2, h3⟩ := h
  refine ⟨vals, h1, fun o v hv => ?_, fun hf o htw hin t0 t1 m0 m1 hn0 hn1 hm0 hm1 hl0 hl1 hc0 hc1 hst => ?_⟩
  · obtain ⟨⟨m0, hm0, hl0, hv0⟩, hn, hab⟩ := h2 o v hv
    have hlt := lt_of_get hm0
    refine ⟨⟨m0, by rw [push_lt hlt]; exact hm0, hl0, hv0⟩, fun h => ?_, fun t m' ht hm' hl' => ?_⟩
    · rcases List.mem_append.1 h with h | h
      · exact hn h
      · exact Nat.ne_of_lt hlt (List.mem_singleton.1 h)
    · by_cases e : t = mem.size
      · subst e; exact Or.inl (List.mem_append_right _ (List.mem_singleton_self _))
      · have h2' : mem[t]? = some m' := by
          rw [Array.getElem?_push] at hm'; simpa [e] using hm'
        exact (hab t m' ht h2' hl').imp (fun h => List.mem_append_left _ h) id
  · obtain ⟨hn0', hm0'⟩ := old t0 m0 hn0 hm0
    obtain ⟨hn1', hm1'⟩ := old t1 m1 hn1 hm1
    exact h3 hf o htw hin t0 t1 m0 m1 hn0' hn1' hm0' hm1' hl0 hl1 hc0 hc1
      (pairStraddles_back hold (fun p hp => hp) hsz hst)

/-- (S4e) `HiddenP` survives a new promise, skipped. -/
theorem HiddenP_push_prom {η : TEnv} {T : Ty} {mem : Memory} {P : List Ts} {l : AllocLabel} {o : Nat}
    {V : Ts} (m : Msg) (h : HiddenP η T mem P l o V) : HiddenP η T (mem.push m) (P ++ [mem.size]) l o V := by
  intro t m' ht hm' hl hn
  have hne : t ≠ mem.size := fun e =>
    ht (by rw [e]; exact List.mem_append_right _ (List.mem_singleton_self _))
  have hm'' : mem[t]? = some m' := by rw [Array.getElem?_push] at hm'; simpa [hne] using hm'
  obtain ⟨t', m1, h1, h2, h3, h4⟩ := h t m' (fun h' => ht (List.mem_append_left _ h')) hm'' hl hn
  exact ⟨t', m1, h1, h2, by rw [push_lt (lt_of_get h3)]; exact h3, h4⟩

/-- **(S4e) A promise step keeps `MemInv`**: every clause skips the thread's
own promises, and the new message is one. -/
theorem MemInv_promSt {g : G} {E : TEnv} {s : St} {a : Address} {v : WeakMem.Val} {w : Ts}
    (hm : MemInv g E s) : MemInv g E (promSt s a v w) := by
  have hpo' := MemInv_promOK_promise (a := a) (v := v) (w := w) hm
  obtain ⟨hmo, hoo, hpl, hfr, hsn, hoh, hpd, hopub, hpi, hbi, -⟩ := hm
  have hold : ∀ t, t < s.mem.size → (promSt s a v w).mem[t]? = s.mem[t]? := fun t ht => push_lt ht
  refine ⟨⟨fun t m c ht hm' hc => ?_, fun t m0 m1 c ht h0 h1 hc => ?_, fun t ht => ?_⟩,
    fun l c hc ho => ?_, fun t ht => ?_, ⟨fun j hj => ?_, PrivCoh_of hfr.2 (fun _ h => h) (fun _ _ => rfl) (fun t m h1 h2 _ => promSt_old h1 h2)⟩, hsn,

    OwnHidP.imp hoh (fun l c hc ho => ⟨hc, ho, rfl, rfl, rfl, id⟩)
      (fun l c o V V' _ hle h => HiddenP_le (HiddenP_push_prom _ h) hle) (Nat.le_refl _),
    fun l c f hc ho hf o hi => HiddenP_push_prom _ (hpd l c f hc ho hf o hi),
    hopub.mono (Nat.le_refl _) hpl (fun t h1 h2 => absurd (List.mem_append_left _ h1) h2)
      (fun u hu => (List.mem_append.1 hu).imp id fun h => Nat.le_of_eq (List.mem_singleton.1 h).symm) hold,
    ⟨hpi.1, hpi.2.1, hpi.2.2.1, ⟨?_, ?_⟩⟩, ⟨hbi.1, fun l B hB => ?_, fun l B hB => ?_⟩, hpo'⟩
  · obtain ⟨ht', hm''⟩ := promSt_old ht hm'
    exact hmo.1 t m c ht' hm'' hc
  · have h2 := hmo.2.2 t ht
    rw [hold t (Nat.lt_of_succ_lt h2)] at h0
    rw [hold (t + 1) h2] at h1
    exact hmo.2.1 t m0 m1 c ht h0 h1 hc
  · have h2 := hmo.2.2 t ht
    show t + 1 < (s.mem.push _).size
    rw [Array.size_push]; exact Nat.lt_succ_of_lt h2
  · exact OwnCellF_push_prom _ (hoo l c hc ho) hmo.2.2
  · show t < (s.mem.push _).size
    rw [Array.size_push]
    rw [promSt_promises] at ht
    rcases List.mem_append.1 ht with h | h
    · exact Nat.lt_succ_of_lt (hpl t h)
    · rw [List.mem_singleton.1 h]; exact Nat.lt_succ_self _
  · obtain ⟨f1, f2, f3, f4⟩ := hfr.1 j hj
    refine ⟨f1, fun t m hm' hl => ?_, f3, f4⟩
    by_cases e : t = s.mem.size
    · rw [promSt_promises, e]; exact List.mem_append_right _ (List.mem_singleton_self _)
    · have h' : s.mem[t]? = some m := by
        rw [promSt_mem, Array.getElem?_push] at hm'; simpa [e] using hm'
      rw [promSt_promises]; exact List.mem_append_left _ (f2 t m h' hl)
  · intro l c f o hc hown hf htw t0 t1 m0 m1 hn0 hn1 hm0 hm1 hl0 hl1 hh0 hh1 hst
    obtain ⟨hn0', hm0'⟩ := promSt_old hn0 hm0
    obtain ⟨hn1', hm1'⟩ := promSt_old hn1 hm1
    exact hpi.2.2.2.1 l c f o hc hown hf htw t0 t1 m0 m1 hn0' hn1' hm0' hm1' hl0 hl1
      (hiddenFrom_back hold hh0) (hiddenFrom_back hold hh1) (pairStraddles_back hold (fun p hp => hp) hmo.2.2 hst)
  · intro l c f b S us o hc hown hf hseg hu ho
    obtain ⟨t, m, h1, h2⟩ := hpi.2.2.2.2 l c f b S us o hc hown hf hseg hu ho
    exact ⟨t, m, by rw [hold t (lt_of_get h1)]; exact h1, h2⟩
  · exact (hbi.2.1 l B hB).imp fun _ _ ⟨t, ht, hl⟩ => ⟨t, ht, LatestP_push_prom _ hl⟩
  · obtain ⟨b1, b2, b3⟩ := hbi.2.2 l B hB
    exact ⟨b1, b2, fun ho => (b3 ho).imp fun _ _ hl => LatestP_push_prom _ hl⟩

/-- (P4) A latest word skipping `P` stays one, skipping also the appended index. -/
theorem LatestNP_push_prom {M : Memory} {P : List Ts} {B : Address} {x : Word} (m : Msg)
    (h : LatestNP M P B x) : LatestNP (M.push m) (P ++ [M.size]) B x := by
  obtain ⟨t, m0, ht, hm0, hl, hw, hlast⟩ := h
  have htl := lt_of_get hm0
  refine ⟨t, m0, fun h => ?_, by rw [push_lt htl]; exact hm0, hl, hw, fun t' m' hlt hm' hl' => ?_⟩
  · rcases List.mem_append.1 h with h | h
    · exact ht h
    · exact absurd (List.mem_singleton.1 h) (Nat.ne_of_lt htl)
  · by_cases e : t' = M.size
    · subst e; exact List.mem_append_right _ (List.mem_singleton_self _)
    · have h2 : M[t']? = some m' := by
        rw [Array.getElem?_push] at hm'; simpa [e] using hm'
      exact List.mem_append_left _ (hlast t' m' hlt h2 hl')

/-- (U3) The first write at a unit is unique. -/
theorem FirstW_uniq {M : Memory} {a : Address} {h h' : Ts} (h1 : FirstW M a h) (h2 : FirstW M a h') : h = h' := by
  obtain ⟨⟨m, hm, hl, hv⟩, hb⟩ := h1
  obtain ⟨⟨m', hm', hl', hv'⟩, hb'⟩ := h2
  rcases Nat.lt_trichotomy h h' with hlt | e | hlt
  · exact absurd (hb' h m hlt hm hl) hv
  · exact e
  · exact absurd (hb h' m' hlt hm' hl') hv'

/-- (U3) Memory growth keeps the first write. -/
theorem FirstW_push {M : Memory} {a : Address} {h : Ts} (x : Msg) (hf : FirstW M a h) : FirstW (M.push x) a h := by
  obtain ⟨⟨m, hm, hl, hv⟩, hb⟩ := hf
  have hlt := lt_of_get hm
  refine ⟨⟨m, by rw [push_lt hlt]; exact hm, hl, hv⟩, fun t m' ht hm' hl' => hb t m' ht ?_ hl'⟩
  rw [push_lt (Nat.lt_trans ht hlt)] at hm'; exact hm'

/-- (U3) With a first write, growth keeps `AboveFW`. -/
theorem AboveFW_push {M : Memory} {a : Address} {h : Ts} (x : Msg) (hf : FirstW M a h) (t : Ts) :
    AboveFW (M.push x) a t ↔ AboveFW M a t :=
  ⟨fun ⟨_, hf', hlt⟩ => ⟨h, hf, by rw [FirstW_uniq (FirstW_push x hf) hf']; exact hlt⟩,
    fun ⟨h', hf', hlt⟩ => ⟨h', FirstW_push x hf', hlt⟩⟩

/-- (U3) Growth keeps `AboveFW` (no first write needed). -/
theorem AboveFW_pushM {M : Memory} {a : Address} {t : Ts} (x : Msg) (h : AboveFW M a t) : AboveFW (M.push x) a t := by
  obtain ⟨h0, hf, hlt⟩ := h
  exact ⟨h0, FirstW_push x hf, hlt⟩

/-- (P4) The latest message (promises included) is the predecessor of an
appended one. -/
theorem PredAt_push_top {M : Memory} {a : Address} {x : Word} (m : Msg) (h : LatestNP M [] a x) :
    PredAt (M.push m) a M.size x := by
  obtain ⟨t, m0, -, hm0, hl, hw, hlast⟩ := h
  have htl := lt_of_get hm0
  refine ⟨t, m0, htl, by rw [push_lt htl]; exact hm0, hl, hw, fun t' m' h1 h2 h3 hl' => ?_⟩
  rw [push_lt h2] at h3
  exact absurd (hlast t' m' h1 h3 hl') (by simp)

theorem pSum_promSt (s : St) (a : Address) (v : WeakMem.Val) (w : Ts) (f : Ts → Res) :
    pSum (promSt s a v w) f = pSum s f + f s.mem.size := by
  unfold pSum
  rw [promSt_promises, List.map_append, Res.sum_append]
  simp only [List.map_cons, List.map_nil, Res.sum_cons]
  first
    | rfl
    | (congr 1; exact Res.ext fun k => by simp [Res.sum, Res.zero])

theorem pSum_agree {s : St} {f f' : Ts → Res} (h : ∀ t, t ∈ s.promises → f' t = f t) :
    pSum s f' = pSum s f := by
  unfold pSum; congr 1; exact List.map_congr_left h

/-- (P4) The credits after a promise: the old ones kept below the appended
index, the new promise's credit `Rc` (`WRes` of its predecessor, if any) and
debit `Rd` (`WRes` of the promised message). -/
theorem PromCr_promise {E : TEnv} {s : St} {cr db : Ts → Res} {a : Address} {v : WeakMem.Val} {w : Ts} {Rc Rd : Res}
    (hC : PromCr E s cr db) (hPb : ∀ t, t ∈ s.promises → t < s.mem.size)
    (hd : DbRes E (promSt s a v w).mem ⟨a, v, w⟩ s.mem.size Rd)
    (hc : (∃ w0, PredAt (promSt s a v w).mem a s.mem.size w0 ∧ VRes E a w0 Rc) ∨
      ((∀ w0, ¬ PredAt (promSt s a v w).mem a s.mem.size w0) ∧ Rc = .zero)) :
    PromCr E (promSt s a v w) (fun t => if t = s.mem.size then Rc else cr t)
      (fun t => if t = s.mem.size then Rd else db t) := by
  have hmem : ∀ t, t < s.mem.size → (promSt s a v w).mem[t]? = s.mem[t]? := fun t h => by
    rw [promSt_mem]; exact push_lt h
  intro tw htw
  rw [promSt_promises] at htw
  rcases List.mem_append.1 htw with ht | ht
  · obtain ⟨m0, hm1, hdb, hcr⟩ := hC tw ht
    have hlt := hPb tw ht
    have hne : ¬ tw = s.mem.size := Nat.ne_of_lt hlt
    refine ⟨m0, by rw [hmem tw hlt]; exact hm1, by
      simp only [iteF hne]; exact DbRes_mem hmem hlt hdb, ?_⟩
    simp only [iteF hne]
    rcases hcr with ⟨w1, hw1, hcw⟩ | ⟨hnw, hcz⟩
    · exact Or.inl ⟨w1, (PredAt_prefix hmem (Nat.le_of_lt hlt)).1 hw1, hcw⟩
    · exact Or.inr ⟨fun w1 hw1 => hnw w1 ((PredAt_prefix hmem (Nat.le_of_lt hlt)).2 hw1), hcz⟩
  · simp only [List.mem_singleton] at ht
    subst ht
    refine ⟨⟨a, v, w⟩, by rw [promSt_mem]; simp, by dsimp only; rw [iteT rfl]; exact hd, ?_⟩
    dsimp only
    rw [iteT rfl]
    exact hc

/-- **(P4 step 5b) The machine promise step, memory's and the credits' side**
(`TermRun.promise`, `stOf_promise`; `MemInv`-free).  The new promise's credit
is `WRes` of its predecessor (the latest message at `a`), its debit `WRes` of
the promised message; old credits and debits are kept below `s.mem.size`.  At
a non-word unit memory's reading skips own promises, so `H` is unchanged and
both new entries are `.zero`; at a word unit (side condition `hwu`: it is a
non-ghost `.word` of a literal region, initialised, and the promised value is a
state of its protocol) memory's reading moves from the old latest message to the
promised one: `H` trades the old `WRes` for the new, an equality. -/
theorem promise_acct {η : TEnv} {s : St} {H : Res} {cr db : Ts → Res} {a : Address} {v : WeakMem.Val} {w : Ts}
    (hH : MemHeld (CE η) s H) (hC : PromCr (CE η) s cr db)
    (hPb : ∀ t, t ∈ s.promises → t < s.mem.size)
    (hwu : VisU (CE η) a → ∃ c n P, η.sto a.label = some c ∧ AtOff c.ty a.offset (.word (.lit n) P) ∧
      P.ghost = false ∧ IniAt η.ini c a (.word (.lit n) P) ∧
      ∃ Rn, VRR (fun _ => 0) (CE (CE η).unsee) (.word (.lit n) P) (shp (.word (.lit n) P)) [mw ⟨a, v, w⟩] Rn)
    (hfw : PredU (CE η) a → ∃ h, FirstW s.mem a h) :
    ∃ H' cr' db', (∀ t, t < s.mem.size → cr' t = cr t ∧ db' t = db t) ∧
      MemHeld (CE η) (promSt s a v w) H' ∧ PromCr (CE η) (promSt s a v w) cr' db' ∧
      H' + pSum (promSt s a v w) cr' + pSum s db = H + pSum s cr + pSum (promSt s a v w) db' := by
  have hkeep : ∀ B x, (VisU (CE η) a → B ≠ a) → LatestNP s.mem (PromAt (CE η) s B) B x →
      LatestNP (promSt s a v w).mem (PromAt (CE η) (promSt s a v w) B) B x := by
    intro B x hBa hx
    by_cases hBe : B = a
    case neg =>
      -- (U3) another unit: nothing changes there
      refine PromAt_atSame ?_ hx
      rw [promSt_mem, promSt_promises]
      refine ⟨(AtSame_push (P := s.promises) (x := ⟨a, v, w⟩) (fun e => hBe e.symm)).1, fun t m hm _ => ?_⟩
      simp only [List.mem_append, List.mem_singleton]
      refine ⟨Or.inl, fun h => h.resolve_right fun e => ?_⟩
      subst e; exact absurd (lt_of_get hm) (Nat.lt_irrefl _)
    rw [hBe] at hx ⊢
    have hB : ¬ VisU (CE η) a := fun h => hBa h hBe
    by_cases hq : PredU (CE η) a
    · -- (U3) a predicted unit: the new promise lies above the first write, skipped
      obtain ⟨h0, hf0⟩ := hfw hq
      have hsz : AboveFW s.mem a s.mem.size := ⟨h0, hf0, by obtain ⟨⟨m0, hm0, -⟩, -⟩ := hf0; exact lt_of_get hm0⟩
      rw [promSt_mem]
      refine LatestNP_congrP (fun t _ _ _ => ?_) (LatestNP_push_prom _ hx)
      rw [List.mem_append, mem_PromAt_pred hB hq, mem_PromAt_pred hB hq, promSt_mem, promSt_promises,
        AboveFW_push _ hf0]
      simp only [List.mem_append, List.mem_singleton]
      constructor
      · rintro (⟨(h | h), ha⟩ | h)
        · exact ⟨Or.inl (Or.inl h), ha⟩
        · exact ⟨Or.inr h, ha⟩
        · subst h; exact ⟨Or.inl (Or.inr rfl), hsz⟩
      · rintro ⟨((h | h) | h), ha⟩
        · exact Or.inl ⟨Or.inl h, ha⟩
        · exact Or.inr h
        · exact Or.inl ⟨Or.inr h, ha⟩
    · rw [PromAt_nword hB hq] at hx ⊢
      rw [promSt_mem, promSt_promises]
      refine LatestNP_congrP (fun t _ _ _ => ?_) (LatestNP_push_prom _ hx)
      simp only [List.mem_append]
      constructor
      · rintro ((h | h) | h)
        · exact Or.inl (Or.inl h)
        · exact Or.inr h
        · exact Or.inl (Or.inr h)
      · rintro ((h | h) | h)
        · exact Or.inl (Or.inl h)
        · exact Or.inr h
        · exact Or.inl (Or.inr h)
  have hagree : ∀ (f : Ts → Res) (R : Res), pSum s (fun t => if t = s.mem.size then R else f t) = pSum s f :=
    fun f R => pSum_agree fun t ht => iteF (Nat.ne_of_lt (hPb t ht))
  have hupd : ∀ (f : Ts → Res) (R : Res), (fun t => if t = s.mem.size then R else f t) s.mem.size = R :=
    fun f R => iteT rfl
  have hold : ∀ (f : Ts → Res) (R : Res) t, t < s.mem.size → (fun t => if t = s.mem.size then R else f t) t = f t :=
    fun f R t ht => iteF (Nat.ne_of_lt ht)
  by_cases hWU : VisU (CE η) a
  · -- a visible word unit: memory now reads the promised message
    obtain ⟨c, n, P, hsto, hat, hg, hini, Rn, hvn⟩ := hwu hWU
    have hWa : WordAt (CE η) a n P := ⟨c, hsto, hat, hg⟩
    obtain ⟨R0, H0, rfl, hent0, hX⟩ := MemHeld_focus hH a.label
    obtain ⟨vals0, hL0, hC0⟩ := hent0.2 c hsto
    have hna : ∀ N e, Ty.word (.lit n) P ≠ .array (.lit N) e := fun N e h => by cases h
    have hwU : wc (Ty.word (.lit n) P) = some 1 := by simp [wc, accs, hg, nWords, Acc.size]
    obtain ⟨b, oS, S, wS, Rsg, Rrc, -, hbo, hatS, hwS, hbw, hR0, ⟨hvs, hVs⟩, hput⟩ := (own_segR hC0 hat hini hna).resolve_right
      (fun ⟨_, _, _, _, _, _, _, hz⟩ => by obtain ⟨uU, hu, hn⟩ := wc_some hwU; have h := hz _ hu; omega)
    have hsl : ((vals0.drop b).take wS).length = wS := by
      simp only [List.length_take, List.length_drop]; omega
    obtain ⟨n1, Rq, Rr2, hwn, hle2, hRs, hvq, hput2⟩ := VRR_at (CE η).unsee hatS hvs (by rw [hsl]; exact hwS)
    rw [hwU] at hwn
    obtain rfl : 1 = n1 := Option.some.inj hwn
    rw [hsl] at hle2
    have hlenv : a.offset + 1 ≤ vals0.length := by
      rw [← hbo, Nat.add_assoc]; exact Nat.le_trans (Nat.add_le_add_left hle2 b) hbw
    have hvqe : (((vals0.drop b).take wS).drop oS).take 1 = (vals0.drop a.offset).take 1 := by
      rw [take_drop_take hle2, drop_drop', hbo]
    rw [hvqe] at hvq
    obtain ⟨w0, rest, hdr⟩ : ∃ w0 rest, vals0.drop a.offset = w0 :: rest := by
      cases h : vals0.drop a.offset with
      | nil => have := congrArg List.length h; simp at this; omega
      | cons w0 rest => exact ⟨w0, rest, rfl⟩
    have hw0 : vals0[a.offset]? = some w0 := by
      have := congrArg (·[0]?) hdr; simpa using this
    rw [hdr] at hvq
    simp only [List.take_succ_cons, List.take_zero] at hvq
    -- the old latest word and its resources
    have hlat0 : LatestNP s.mem [] a w0 := by
      have := hL0 a.offset w0 hw0; rw [PromAt_word hWU] at this; exact this
    have hcr : WRes (CE η) a w0 (wr P n w0.val) := WRes_wr hWa w0
    have hq2 := WRes_of_VRR (E := CE η) hsto hat hg hvq w0 _ rfl hcr
    have hdb : WRes (CE η) a (mw ⟨a, v, w⟩) (wr P n (mw ⟨a, v, w⟩).val) := WRes_wr hWa (mw ⟨a, v, w⟩)
    have hn2 := WRes_of_VRR (E := CE η) hsto hat hg hvn (mw ⟨a, v, w⟩) _ rfl hdb
    have hpred : PredAt (promSt s a v w).mem a s.mem.size w0 := by
      rw [promSt_mem]; exact PredAt_push_top _ hlat0
    -- the new latest word at the unit
    have hnew : LatestNP (promSt s a v w).mem (PromAt (CE η) (promSt s a v w) a) a (mw ⟨a, v, w⟩) := by
      rw [PromAt_word hWU, promSt_mem]
      exact LatestNP_push_top (P := []) (M := s.mem) (⟨a, v, w⟩ : Msg) (fun t ht => by cases ht)
    have hQ := hput2 [mw ⟨a, v, w⟩] Rn hvn rfl
    have hQV := (VR_put (CE η).unsee hatS (VRR_VR S (RLink_of (Coh_CE _) (CohR_CE _)) hvs) hVs
      (by rw [hsl]; exact hwS) (VRR_VR _ (RLink_of (Coh_CE _) (CohR_CE _)) hvn) trivial (by rw [hwU]; rfl)).2.2
    simp only [List.length_singleton] at hQV
    have hQl : (((vals0.drop b).take wS).take oS ++ [mw ⟨a, v, w⟩] ++ ((vals0.drop b).take wS).drop (oS + 1)).length
        = wS := by
      simp only [List.length_append, List.length_take, List.length_drop, List.length_singleton]; omega
    have hcell' := hput _ _ ⟨hQ, hQV⟩ hQl
    have hsp := splice_seg vals0 [mw ⟨a, v, w⟩] b wS oS (by simpa using hle2)
    simp only [List.length_singleton] at hsp
    rw [hsp, hbo] at hcell'
    have hlat' : ∀ o x, (vals0.take a.offset ++ [mw ⟨a, v, w⟩] ++ vals0.drop (a.offset + 1))[o]? = some x →
        LatestNP (promSt s a v w).mem (PromAt (CE η) (promSt s a v w) ⟨a.label, o⟩) ⟨a.label, o⟩ x := by
      intro o x hov
      rw [splice_get vals0 [mw ⟨a, v, w⟩] a.offset 1 o rfl hlenv] at hov
      by_cases hr : a.offset ≤ o ∧ o < a.offset + 1
      · rw [iteT hr] at hov
        obtain rfl : o = a.offset := Nat.le_antisymm (Nat.lt_succ_iff.1 hr.2) hr.1
        simp only [Nat.sub_self, List.getElem?_cons_zero, Option.some.injEq] at hov
        subst hov
        exact hnew
      · rw [iteF hr] at hov
        refine hkeep _ x (fun _ e => hr ?_) (hL0 o x hov)
        have h2 : o = a.offset := congrArg (·.offset) e
        exact ⟨Nat.le_of_eq h2.symm, by rw [h2]; exact Nat.lt_succ_self _⟩
    have hent : HeldEntry (CE η) (promSt s a v w) a.label (Rn + Rr2 + Rrc) := by
      refine ⟨fun h => (by rw [show (CE η).sto a.label = η.sto a.label from rfl, hsto] at h; cases h),
        fun c2 hc2 => ?_⟩
      rw [show (CE η).sto a.label = η.sto a.label from rfl, hsto] at hc2; cases hc2
      exact ⟨_, hlat', hcell'⟩
    have hX' := MemHeldX_tr (E' := CE η) (s' := promSt s a v w) hX (fun _ _ => rfl) (fun _ _ => rfl)
      (fun l' hne o x hl => hkeep _ x (fun _ e => hne (congrArg (·.label) e)) hl) id
    have hIW : IniW (CE η) a := IniW_word (E := CE η) hsto hat hg hini
    have hnI0 : ¬ InitAt (promSt s a v w).mem (⟨a, v, w⟩ : Msg).loc s.mem.size :=
      fun h => VRR_word_nundef hvq hg (h w0 hpred)
    have hC' := PromCr_promise (Rc := wr P n w0.val) hC hPb ((DbRes_nInit hnI0).2 ((VRes_vis hWU.2 hIW).2 hdb))
      (Or.inl ⟨w0, hpred, (VRes_vis hWU.2 hIW).2 hcr⟩)
    subst hR0; subst hRs
    refine ⟨Rn + Rr2 + Rrc + H0, _, _, fun t ht => ⟨hold cr (wr P n w0.val) t ht, hold db (wr P n (mw ⟨a, v, w⟩).val) t ht⟩,
      MemHeld_unfocus hX' hent, hC', ?_⟩
    rw [pSum_promSt, pSum_promSt, hagree, hagree]
    first | rw [hupd, hupd] | rw [iteT rfl, iteT rfl]
    exact Res.ext fun k => by
      have e1 := congrFun hq2 k; have e2 := congrFun hn2 k; simp only [Res.add_apply] at *; omega
  · -- not a visible word unit: memory's reading skips the new own promise
    have hz : ∀ x, VRes (CE η) a x .zero := fun x => by
      by_cases hV : Vis (CE η) a.label ∧ IniW (CE η) a
      · exact Or.inl ⟨hV.1, hV.2, Or.inr ⟨fun n P hw => absurd ⟨WordAt_unit hw, hV.1⟩ hWU, rfl⟩⟩
      · exact Or.inr ⟨hV, rfl⟩
    have hH' : MemHeld (CE η) (promSt s a v w) H :=
      MemHeld_tr hH (fun _ => rfl) (fun _ => rfl)
        (fun l o x hx => hkeep _ x (fun h => absurd h hWU) hx) id
    have hc : (∃ w0, PredAt (promSt s a v w).mem a s.mem.size w0 ∧ VRes (CE η) a w0 Res.zero) ∨
        ((∀ w0, ¬ PredAt (promSt s a v w).mem a s.mem.size w0) ∧ Res.zero = Res.zero) := by
      by_cases hp : ∃ w0, PredAt (promSt s a v w).mem a s.mem.size w0
      · obtain ⟨w0, hw0⟩ := hp; exact Or.inl ⟨w0, hw0, hz w0⟩
      · exact Or.inr ⟨fun w0 hw0 => hp ⟨w0, hw0⟩, rfl⟩
    have hnD : ¬ DesigAt (CE η) (promSt s a v w).mem a s.mem.size := fun ⟨hq0, _, hf⟩ => by
      obtain ⟨h0, ⟨m0, hm0, hl0, hv0⟩, -⟩ := hfw hq0
      have hlt0 := lt_of_get hm0
      exact hv0 (hf.2 h0 m0 hlt0 (by rw [promSt_mem, push_lt hlt0]; exact hm0) hl0)
    have hC' := PromCr_promise hC hPb ((DbRes_zero (m := ⟨a, v, w⟩) hWU hnD).2 rfl) hc
    refine ⟨H, _, _, fun t ht => ⟨hold cr _ t ht, hold db _ t ht⟩, hH', hC', ?_⟩
    rw [pSum_promSt, pSum_promSt, hagree, hagree]
    first | rw [hupd, hupd] | rw [iteT rfl, iteT rfl]
    exact Res.ext fun k => by simp only [Res.add_apply]; omega


/-- **(S4f) A thread-level promise keeps the thread's invariant**
(`TermRun.promise`, `stOf_promise`): same view, `MemInv_promSt`. -/
theorem ThInvM_promise {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {a : Address} {v : WeakMem.Val} {w : Ts} (h : ThInvM p g mem pairs th) :
    ThInvM p g (mem.push ⟨a, v, w⟩) pairs { th with promises := th.promises ++ [mem.size] } := by
  obtain ⟨E, hT, hm, hbf⟩ := h
  refine ⟨E, hT, ?_, hbf⟩
  rw [stOf_promise]
  exact MemInv_promSt hm

/-- **(S4f) The machine promise step, with resources and credits**
(`TermRun.promise`, `stOf_promise`): `ThInvMC` carries over with the same
frame total; memory's holding and the credits move as in `promise_acct` (old
credits and debits kept below the old memory size; an equality of totals).
Side condition `hwu`, at the invariant's view: a promise at a visible word
unit is at a non-ghost `.word` of a literal region, initialised, and the
promised value is a state of its protocol (own cells and non-word units need
nothing). -/
theorem tstepMC_prom {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {Tot H : Res}
    {cr db : Ts → Res} {a : Address} {v : WeakMem.Val} {w : Ts}
    (h : ThInvMC p g mem pairs th Tot H cr db)
    (hwu : ∀ η : TEnv, ThInvRE p (CE η) th Tot → MemInv g (CE η) (stOf mem pairs th) → VisU (CE η) a →
      ∃ c n P, η.sto a.label = some c ∧ AtOff c.ty a.offset (.word (.lit n) P) ∧
        P.ghost = false ∧ IniAt η.ini c a (.word (.lit n) P) ∧
        ∃ Rn, VRR (fun _ => 0) (CE (CE η).unsee) (.word (.lit n) P) (shp (.word (.lit n) P)) [mw ⟨a, v, w⟩] Rn)
    (hfw : ∀ η : TEnv, ThInvRE p (CE η) th Tot → MemInv g (CE η) (stOf mem pairs th) → PredU (CE η) a →
      ∃ h, FirstW mem a h) :
    ∃ H' cr' db', (∀ t, t < mem.size → cr' t = cr t ∧ db' t = db t) ∧
      ThInvMC p g (mem.push ⟨a, v, w⟩) pairs { th with promises := th.promises ++ [mem.size] } Tot H' cr' db' ∧
      H' + pSum (promSt (stOf mem pairs th) a v w) cr' + pSum (stOf mem pairs th) db =
        H + pSum (stOf mem pairs th) cr + pSum (promSt (stOf mem pairs th) a v w) db' := by
  obtain ⟨E, hT, hm, hH, hC⟩ := h
  obtain ⟨ρ, η, cx, Rf, Rs, hE, hrest⟩ := hT
  subst hE
  have hT : ThInvRE p (CE η) th Tot := ⟨ρ, η, cx, Rf, Rs, rfl, hrest⟩
  obtain ⟨H', cr', db', hag, hH', hC', heq⟩ := promise_acct hH hC (MemInv_promLt hm) (hwu η hT hm) (hfw η hT hm)
  refine ⟨H', cr', db', hag, ⟨CE η, ⟨ρ, η, cx, Rf, Rs, rfl, hrest⟩, ?_, ?_, ?_⟩, heq⟩
  · rw [stOf_promise]; exact MemInv_promSt hm
  · rw [stOf_promise]; exact hH'
  · rw [stOf_promise]; exact hC'

/-! ### (S7d) The ghost plant at a promise step -/

/-- **(S7d) The plant keeps the thread's invariant**: `pfr l := some vWr` at a
private own cell `l` (`MemInv_plant`, `MemHeld_plant`).  Same frame (`Ext`:
`FInvR_ext`); memory's holding and the credits move by the flip's telescoping
equality.  Side conditions, at the invariant's view (`hpl`): `l` is private
own, its type facts (`MemInv_plant`'s `hcpl`, `hcT`, `hnT`, `hrT`), and
`FlipOK` (own promises at its word units carry protocol states); and
`PromAbove` of the state. -/
theorem ThInvMC_plant {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {Tot H : Res}
    {cr db : Ts → Res} {l : AllocLabel}
    (h : ThInvMC p g mem pairs th Tot H cr db) (hpa : PromAbove (stOf mem pairs th))
    (hpl : ∀ η : TEnv, ThInvRE p (CE η) th Tot → MemInv g (CE η) (stOf mem pairs th) →
      ∃ c, η.sto l = some c ∧ c.owner = some η.tid ∧ η.pfr l = none ∧
        (∀ b S, SegOf c.ty b S → accs S ≠ none → TearOK S) ∧ Ty.coupledOKIn [] c.ty = true ∧
        Ty.noOwnIn [] c.ty = true ∧ rgnFree c.ty = true ∧ FlipOK (CE η) (stOf mem pairs th) l ∧
        FpOK (CE η) (stOf mem pairs th)) :
    ∃ H' cr' db', ThInvMC p g mem pairs th Tot H' cr' db' ∧
      H' + pSum (stOf mem pairs th) cr' + pSum (stOf mem pairs th) db =
        H + pSum (stOf mem pairs th) cr + pSum (stOf mem pairs th) db' := by
  obtain ⟨E, hT, hm, hH, hC⟩ := h
  obtain ⟨ρ, η, cx, Rf, Rs, hE0, hE, hTy, htv, hFI, hsum⟩ := hT
  subst hE0
  obtain ⟨c, hsto, hown, hnone, hcpl, hcT, hnT, hrT, hf, hfo⟩ :=
    hpl η ⟨ρ, η, cx, Rf, Rs, rfl, hE, hTy, htv, hFI, hsum⟩ hm
  have hx : Ext η (η.withSto η.sto η.ini
      (fun l' => if l' = l then some (stOf mem pairs th).vs.vWr else η.pfr l') η.seen) :=
    Ext_withSto hE.2.1 (fun _ _ h => h) (fun _ => Nat.le_refl _) (fun l' f h => by
      by_cases he : l' = l
      · subst he; rw [hnone] at h; cases h
      · simp [he, h])
  have hE' : EnvOK p (η.withSto η.sto η.ini
      (fun l' => if l' = l then some (stOf mem pairs th).vs.vWr else η.pfr l') η.seen) :=
    ⟨hE.1, hx.1, hx.2.2.2.2.2.2.2.2.2.2.1⟩
  obtain ⟨H', cr', db', hH', hC', heq⟩ := MemHeld_plant (E' := CE (η.withSto η.sto η.ini
      (fun l' => if l' = l then some (stOf mem pairs th).vs.vWr else η.pfr l') η.seen))
    hm hH hC hpa hnone rfl rfl rfl rfl rfl (fun _ _ h => h) hf hfo rfl ⟨c, hsto, hown⟩
  exact ⟨H', cr', db', ⟨_, ⟨ρ, _, cx, Rf, Rs, rfl, hE', hTy, htv, FInvR_ext hE.2.1 hE.2.2 hx hFI, hsum⟩,
    MemInv_plant hm hsto hown hnone rfl rfl rfl rfl rfl rfl rfl hcpl hcT hnT hrT, hH', hC'⟩, heq⟩

/-- **(S7d) A promise step followed by its plant** (s7_design §1, A′: the
promise names a private own cell `l`, which gets the frontier `vWr`):
`tstepMC_prom` then `ThInvMC_plant` at the new state.  Same frame total;
memory's holding and the credits move by an equality of totals.  Side
conditions: `hwu` (the promise, as `tstepMC_prom`), `PromAbove` of the new
state, and the plant's `hpl` at the new state (the new promise included in
`FlipOK`). -/
theorem ThInvMC_promise_plant {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {Tot H : Res}
    {cr db : Ts → Res} {a : Address} {v : WeakMem.Val} {w : Ts} {l : AllocLabel}
    (h : ThInvMC p g mem pairs th Tot H cr db)
    (hwu : ∀ η : TEnv, ThInvRE p (CE η) th Tot → MemInv g (CE η) (stOf mem pairs th) → VisU (CE η) a →
      ∃ c n P, η.sto a.label = some c ∧ AtOff c.ty a.offset (.word (.lit n) P) ∧
        P.ghost = false ∧ IniAt η.ini c a (.word (.lit n) P) ∧
        ∃ Rn, VRR (fun _ => 0) (CE (CE η).unsee) (.word (.lit n) P) (shp (.word (.lit n) P)) [mw ⟨a, v, w⟩] Rn)
    (hfw : ∀ η : TEnv, ThInvRE p (CE η) th Tot → MemInv g (CE η) (stOf mem pairs th) → PredU (CE η) a →
      ∃ h, FirstW mem a h)
    (hpa : PromAbove (promSt (stOf mem pairs th) a v w))
    (hpl : ∀ η : TEnv, ThInvRE p (CE η) th Tot → MemInv g (CE η) (promSt (stOf mem pairs th) a v w) →
      ∃ c, η.sto l = some c ∧ c.owner = some η.tid ∧ η.pfr l = none ∧
        (∀ b S, SegOf c.ty b S → accs S ≠ none → TearOK S) ∧ Ty.coupledOKIn [] c.ty = true ∧
        Ty.noOwnIn [] c.ty = true ∧ rgnFree c.ty = true ∧ FlipOK (CE η) (promSt (stOf mem pairs th) a v w) l ∧
        FpOK (CE η) (promSt (stOf mem pairs th) a v w)) :
    ∃ H' cr' db', ThInvMC p g (mem.push ⟨a, v, w⟩) pairs { th with promises := th.promises ++ [mem.size] } Tot H' cr' db' ∧
      H' + pSum (promSt (stOf mem pairs th) a v w) cr' + pSum (stOf mem pairs th) db =
        H + pSum (stOf mem pairs th) cr + pSum (promSt (stOf mem pairs th) a v w) db' := by
  obtain ⟨H1, cr1, db1, -, h1, e1⟩ := tstepMC_prom h hwu hfw
  obtain ⟨H2, cr2, db2, h2, e2⟩ := ThInvMC_plant (l := l) h1 (by rw [stOf_promise]; exact hpa)
    (fun η hT hm => by rw [stOf_promise] at hm ⊢; exact hpl η hT hm)
  rw [stOf_promise] at e2
  refine ⟨H2, cr2, db2, h2, Res.ext fun k => ?_⟩
  have f1 := congrArg (fun R : Res => R k) e1
  have f2 := congrArg (fun R : Res => R k) e2
  simp only [Res.add_apply] at f1 f2 ⊢
  omega

/-- (S7d, open issue 5) **`FlipOK` from its two certificate facts**: no own
promise at `l` lies in a `word2` unit of `l`'s cell (the conclusion of
`TermTyped.certified_noPairPromP`, at the cell), and one at a non-ghost `.word`
unit is at a literal region, initialised, of a well-formed protocol, holding
one of its states (`certified_promWordP` gives the state or `undef`). -/
theorem FlipOK_of {E : TEnv} {s : St} {l : AllocLabel}
    (hno2 : ∀ t m c, t ∈ s.promises → s.mem[t]? = some m → m.loc.label = l → E.sto l = some c →
      ∀ o2 r P, AtOff c.ty o2 (.word2 r P) → m.loc.offset ≠ o2 ∧ m.loc.offset ≠ o2 + 1)
    (hwd : ∀ t m c r P, t ∈ s.promises → s.mem[t]? = some m → m.loc.label = l → E.sto l = some c →
      P.ghost = false → AtOff c.ty m.loc.offset (.word r P) →
      ∃ n, r = .lit n ∧ IniAt E.ini c m.loc (.word (.lit n) P) ∧ pwf P = true ∧ ∃ v, m.val = .num v ∧ InP P v) :
    FlipOK E s l := by
  intro _ t m ht hm hl hwu _
  obtain ⟨c, hc, hw⟩ := hwu
  rw [hl] at hc
  rcases hw with ⟨r, P, hg, hat⟩ | ⟨r, P, hat⟩ | ⟨r, P, h1, hat⟩
  · obtain ⟨n, rfl, hini, hp, hin⟩ := hwd t m c r P ht hm hl hc hg hat
    exact ⟨c, n, P, hc, hat, hg, hini, hp, hin⟩
  · exact absurd rfl (hno2 t m c ht hm hl hc _ r P hat).1
  · exact absurd (Nat.sub_add_cancel h1).symm (hno2 t m c ht hm hl hc _ r P hat).2


/-! ### (P4 step 5b) The dispatch skeleton -/

/-- (P4) Deep word-freedom of a `pub` store's field, closed at `ρ`, `η`
(the credit bookkeeping of `storePub`/`storePubLoc`): the
`hdw` of `tstepMC_storePub(Loc)`. -/
def StoreDwf (ρ : Nat → Nat) (η : TEnv) (cx : Cx) (t : Expr) : Prop :=
  ∀ x rel a v tok e u, t = .let_ x (.store rel a v tok) e →
    (cx.peek a = .ok (.ptr .pub u) ∨ cx.peek a = .ok (.loc .pub u)) → dwf (cl ρ η.wit 0 0 u) = true

/-- (claim export) A step lemma's `MintStepN` exchange is a `MintStep` and is not
claim-shaped (`ClaimAt`). -/
theorem cN {Sp : AllocLabel → List Res} {t : Expr} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {η : TEnv}
    {Rf Rs H : Res} {cr db : Ts → Res}
    (h : tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStep g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧ ClaimAt t C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F :=
  ⟨h.1, fun r hr hpa => let ⟨Tot, H', C, F, h1, h2, h3⟩ := h.2 r hr hpa
    ⟨Tot, H', C, F, h1, h2.toM, h2.claimAt _, h3⟩⟩

/-- (claim export) `cN` with moved credits. -/
theorem cNX {Sp : AllocLabel → List Res} {t : Expr} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {η : TEnv}
    {Rf Rs H : Res} {cr db : Ts → Res}
    (h : tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F cr' db',
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr' db' ∧ MintStepN g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr' + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db' + F) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F cr' db',
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr' db' ∧ MintStep g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧ ClaimAt t C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr' + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db' + F :=
  ⟨h.1, fun r hr hpa => let ⟨Tot, H', C, F, cr', db', h1, h2, h3⟩ := h.2 r hr hpa
    ⟨Tot, H', C, F, cr', db', h1, h2.toM, h2.claimAt _, h3⟩⟩

/-- **(P4 step 5b) The thread step with memory holdings and promise credits,
every in-scope term** (skeleton; modeled on `tstepM_step`).  Frame-only terms
(`StepScopeR`) by `tstepMC_frame`; words, pairs, `casCell`, `fetch` by the
step-3/4 `tstepMC_*`; the step-2 ops by the step-5a `tstepMC_*`.  Side conditions (promise bookkeeping is in `MemInv`, `PromOK`): for
the pub stores `hia` (components of other threads' cells have non-affine `∀`
bodies) and `hdw`; coupledness comes from `PubCpl` (P7). -/
theorem tstepMCF_stepK {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {Rf Rs H : Res} {cr db : Ts → Res}
    [ProgRetIall p] [TermA4.ProgCkWC p] (hP : ProgT p) (hp : g.p = p) (hn : 0 < g.n) (hnd : isDone th = false)
    (hsc : StepScope cx th.term ∨ StepScopeR th.σs cx th.term)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hpx : PAx g mem pairs th) (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hia : StoreIall ρ η cx th)
    (hdw : StoreCrZ η cx (stOf mem pairs th) th) (hnvp : OwnOpT cx th.term → OwnNVPF (CE η) (stOf mem pairs th))
    (hnp : ∀ x a e, th.term ≠ .let_ x (.publish a) e)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRF : OwnFrontierRMWT (CE η) (stOf mem pairs th) th.term) (hrmw : NoPlantRMW (CE η) th) (hbf : g.boxFence = true)
    (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hSub : PwSubS) (hSig : PwSig) (hZ : ZOK g (CE η) th := by exact fun _ _ h => False.elim h) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStep g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧ ClaimAt th.term C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F := by
  have hnvR : OwnRMWT th.term → OwnNVP (CE η) (stOf mem pairs th) := fun h => OwnNVP_of_F (hnvp (.inl h))
  by_cases hR : StepScopeR th.σs cx th.term
  · exact paW <| tstepMC_frame hP hp hnd hR hT hCk hi hE htv hm hH hC hRP hPS hSub hSig
  have hsc' := hsc.resolve_right hR
  have hT0 := hT
  generalize ht : th.term = t0 at hT0 hsc'
  have hR' : ¬ StepScopeR th.σs cx t0 := ht ▸ hR
  cases hT0 with
  | let_ hop _ =>
    cases hop with
    | spawn => exact False.elim hsc'
    | ext => exact False.elim hsc'
    | atom | pair | addS | addI | subS | pack | rem | nameI | bits | bit1 | vmatch | band
    | cvt | toInt | asLanes | fop | fcmp | fop1 | lane | setLane =>
        exact (hR' (by first | exact True.intro | assumption)).elim
    | packT => exact (hR' hsc').elim
    | inl => exact cN <| tstepMC_inlT (hbf := hbf) (hpx := hpx) ht hP hn hT hCk hi hE htv hm hH hC hRP hPS
    | inr => exact cN <| tstepMC_inrT (hbf := hbf) (hpx := hpx) ht hP hn hT hCk hi hE htv hm hH hC hRP hPS
    | new => exact cN <| paW <| tstepMC_new ht hsc' hP hn hT hCk hi hE htv hm hH hC hRP hPS
    | publish | publishBuf => exact absurd ht (hnp _ _ _)
    | intoRgn | intoRgnBuf => exact False.elim hsc'
    | newBuf => exact cN <| paW <| tstepMC_newBuf ht hsc' hP hn hT hCk hi hE htv hm hH hC hRP hPS
    | idxOwn | idxShared => exact (hR' True.intro).elim
    | bufInit => exact cN <| tstepMC_bufInit (hZ := hZ) ht hP hT hCk hi hE htv hm hH hC (hRF ⟨_, _, .inr (.inr (.inr (.inr (.inr ⟨_, _, _, ht⟩))))⟩) (hnvR ⟨_, _, .inr (.inr (.inr (.inr (.inr ⟨_, _, _, ht⟩))))⟩) hRP hPS
    | null => exact (hR' True.intro).elim
    | fldOwn | fldShared => exact (hR' True.intro).elim
    | fence => exact (hR' True.intro).elim
    | zero => exact (hR' True.intro).elim
    | call => exact (hR' hsc').elim
    | fnptr => exact (hR' True.intro).elim
    | callc => exact (hR' True.intro).elim
    | xchgAt => exact cN <| tstepMC_xchgAt ht hP hT hCk hi hE htv hm hH hC (hRF ⟨_, _, .inr (.inl ⟨_, _, _, ht⟩)⟩) (hnvR ⟨_, _, .inr (.inl ⟨_, _, _, ht⟩)⟩) hRP hPS
    | loadAt => exact cN <| tstepMC_loadAt ht hP hT hCk hi hE htv hm hH hC hRP hPS
    | xchgAtF => exact cN <| tstepMC_xchgAtF ht hP hT hCk hi hE htv hm hH hC (hRF ⟨_, _, .inr (.inr (.inl ⟨_, _, _, _, ht⟩))⟩) (hnvR ⟨_, _, .inr (.inr (.inl ⟨_, _, _, _, ht⟩))⟩) hRP hPS
    | loadAtF => exact cN <| tstepMC_loadAtF ht hP hT hCk hi hE htv hm hH hC hRP hPS
    | ldlw => exact cN <| tstepMC_ldlw (hpx := hpx) ht hP hT hCk hi hE htv hm hH hC hRP hPS
    | ldl => exact cN <| tstepMC_ldl (hpx := hpx) ht hP hT hCk hi hE htv hm hH hC hRP hPS
    | stlw => exact cN <| tstepMC_stlw (hpx := hpx) ht hP hT hCk hi hE htv hm hH hC (hRF ⟨_, _, .inr (.inr (.inr (.inl ⟨_, _, _, _, ht⟩)))⟩) (hnvR ⟨_, _, .inr (.inr (.inr (.inl ⟨_, _, _, _, ht⟩)))⟩) hRP hPS
    | stl => exact cN <| tstepMC_stl (hpx := hpx) ht hP hT hCk hi hE htv hm hH hC (hRF ⟨_, _, .inr (.inr (.inr (.inr (.inl ⟨_, _, _, ht⟩))))⟩) (hnvR ⟨_, _, .inr (.inr (.inr (.inr (.inl ⟨_, _, _, ht⟩))))⟩) hRP hPS
    | fold => exact (hR' True.intro).elim
    | mkWord _ _ _ _ _ _ _ hng _ _ => exact cN <| paW <| tstepMC_mkWord ht hP hT hCk hi hE htv hm hng hH hC hRP hPS
    | mkWordGhost _ _ _ _ _ _ _ hg _ _ => exact cN <| paW <| tstepMC_mkWordGhost ht hP hT hCk hi hE htv hm hg hH hC hRP hPS
    | validate => exact False.elim hsc'
    | borrow | freeze | endBorrow => exact (hR' True.intro).elim
    | mkWord2 => exact cN <| paW <| tstepMC_mkWord2 ht hP hT hCk hi hE htv hm hH hC hRP hPS
    | mkEPair => exact cN <| paW <| tstepMC_mkEPair ht hP hT hCk hi hE htv hm hH hC hRP hPS
    | ldp hpk =>
        obtain ⟨μ, u, hteq | hteq, hμ, hu⟩ := hsc' _ hpk
        · rw [hteq] at hpk
          rcases hμ with rfl | rfl
          · exact cN <| tstepMC_ldpOwn ht hP hu hpk hT hCk hi hE htv hm hH hC hRP hPS
          · exact cN <| tstepMC_ldpPub ht hP hu hpk hT hCk hi hE htv hm hH hC hRP hPS
        · rw [hteq] at hpk
          exact cN <| tstepMC_ldpLoc ht hP hu hpk hμ hT hCk hi hE htv hm hH hC hRP hPS
    | stpGive hpk | stpKeep hpk =>
        obtain ⟨μ, r, P, hteq | hteq, hμ⟩ := hsc' _ hpk
        · rw [hteq] at hpk
          exact cN <| paW <| tstepMC_stp ht hP hpk hμ hT hCk hi hE htv hm hH hC hfo hRP
        · rw [hteq] at hpk
          exact cN <| paW <| tstepMC_stpLoc ht hP hpk hμ hT hCk hi hE htv hm hH hC hfo hRP
    | mkTicket | claim => exact (hR' True.intro).elim
    | fetchCell hpk | fetchEpoch hpk | fetchShare hpk =>
        obtain ⟨μ, u, hteq | hteq, hμ⟩ := hsc' _ hpk
        · rw [hteq] at hpk
          exact cN <| tstepMC_fetch ht hP hpk hμ hT hCk hi hE htv hm hH hC hrmw hfo hRP
        · rw [hteq] at hpk
          exact cN <| tstepMC_fetchLoc ht hP hpk hμ hT hCk hi hE htv hm hH hC hrmw hfo hRP
    | loadWord hpk hw =>
        obtain ⟨μ, hteq | hteq⟩ := wordOf_cases hw <;> subst hteq
        · cases μ with
          | own => exact cN <| tstepMC_loadWordOwn ht hP hpk hT hCk hi hE htv hm hH hC hRP hPS
          | pub => exact cN <| tstepMC_loadWordPub ht hP hpk hT hCk hi hE htv hm hH hC hRP hPS
          | rgn r' => exact ((hsc' _ hpk) r' _ rfl).elim
        · cases μ with
          | own => exact cN <| tstepMC_loadWordLoc ht hP hpk (.inl rfl) hT hCk hi hE htv hm hH hC hRP hPS
          | pub => exact cN <| tstepMC_loadWordLoc ht hP hpk (.inr rfl) hT hCk hi hE htv hm hH hC hRP hPS
          | rgn r' => exact ((hsc' _ hpk) r' _ rfl).elim
    | storeWordGive hpk hw | storeWordKeep hpk hw | storeWordHand hpk hw =>
        obtain ⟨μ, hteq⟩ := wordOf_cases hw
        cases μ with
        | own => exact cN <| paW <| tstepMC_storeWordAny ht hP hpk hteq (.inl rfl) hT hCk hi hE htv hm hH hC hdw.1 hRP hPS
        | pub => exact cN <| paW <| tstepMC_storeWordAny ht hP hpk hteq (.inr rfl) hT hCk hi hE htv hm hH hC hdw.1 hRP hPS
        | rgn r' => rcases hteq with rfl | rfl <;> exact ((hsc' _ hpk) r' _ rfl).elim
    | loadRgn hpk _ hc | loadCap hpk _ hc | loadTorn hpk _ hc => exact absurd hc (hsc' _ hpk _ _)
    | storeRgn hpk _ hc | storeCap hpk _ hc => exact absurd hc (hsc' _ hpk _ _)
    | loadOwn hpk hnw hc =>
        rcases cell_cases hc with rfl | rfl
        · exact cN <| tstepMC_loadOwn ht hP hpk hnw hT hCk hi hE htv hm hH hC hRP hPS
        · exact cN <| tstepMC_loadLoc ht hP hpk hnw hT hCk hi hE htv hm hH hC hRP hPS
    | loadPub hpk hnw hc =>
        rcases cell_cases hc with rfl | rfl
        · exact cN <| tstepMC_loadPub ht hP hpk hnw hT hCk hi hE htv hm hH hC hRP hPS
        · exact cN <| tstepMC_loadPubLoc ht hP hpk hnw hT hCk hi hE htv hm hH hC hRP hPS
    | storeOwn hpk hnw hc =>
        rcases cell_cases hc with rfl | rfl
        · exact cN <| paW <| tstepMC_storeOwn ht hP hpk hnw hT hCk hi hE htv hm hH hC (OwnNVP_of_F (hnvp (.inr ⟨_, _, _, _, _, _, _, ht, .inl ⟨hpk, hnw⟩⟩))) hia hfo hRP hPS
        · exact cN <| paW <| tstepMC_storeLoc ht hP hpk hnw hT hCk hi hE htv hm hH hC (OwnNVP_of_F (hnvp (.inr ⟨_, _, _, _, _, _, _, ht, .inr ⟨hpk, hnw⟩⟩))) hia hfo hRP hPS
    | storePub hpk hnw hc =>
        rcases cell_cases hc with rfl | rfl
        · exact cN <| paW <| tstepMC_storePub ht hP hpk hnw hT hCk hi hE htv hm hH hia
            hdw hC hfo hRP hPS
        · exact cN <| paW <| tstepMC_storePubLoc ht hP hpk hnw hT hCk hi hE htv hm hH hia
            hdw hC hfo hRP hPS
    | xchg hpk hx =>
        cases hx with
        | own _ hc =>
            rcases cell_cases hc with rfl | rfl
            · exact cN <| tstepMC_xchgOwn ht hP hpk hT hCk hi hE htv hm hH hC (hRF ⟨_, _, .inl ⟨_, _, ht⟩⟩) (hnvR ⟨_, _, .inl ⟨_, _, ht⟩⟩) hRP hPS
            · exact cN <| tstepMC_xchgLoc ht hP hpk hT hCk hi hE htv hm hH hC (hRF ⟨_, _, .inl ⟨_, _, ht⟩⟩) (hnvR ⟨_, _, .inl ⟨_, _, ht⟩⟩) hRP hPS
        | rgn _ hc => exact absurd hc (hsc' _ hpk _ _)
  | split => exact (hR' True.intro).elim
  | unpack => exact (hR' True.intro).elim
  | unpackT => exact (hR' True.intro).elim
  | ifnull => exact (hR' True.intro).elim
  | parity => exact (hR' True.intro).elim
  | ifeqPlain | ifeq | ifeqRec | ifeqZero => exact (hR' True.intro).elim
  | case => exact cN <| tstepMC_caseT (hbf := hbf) (hpx := hpx) ht hn hT hCk hi hE htv hm hH hC hRP hPS
  | region | regionBuf => exact (hR' True.intro).elim
  | openPub => exact (hR' True.intro).elim
  | casCell hpk | casShare hpk | casTake hpk | casEpoch hpk =>
      rcases hsc' _ hpk with ⟨μ, r, P, hteq, hμ⟩ | ⟨u, rfl | rfl, hnw⟩
      · cases hg : P.ghost
        · rcases hteq with rfl | rfl
          · exact cN <| tstepMC_casWord ht hpk hμ hg hT hCk hi hE htv hm hH hC hrmw hRP
          · exact cN <| tstepMC_casWordLoc ht hpk hμ hg hT hCk hi hE htv hm hH hC hrmw hRP
        · exact (cas_ghost_absurd (by rw [← ht]; exact hT) hpk hteq
            (wordRef_pwf hpk hteq hμ hi.1 hE htv hm) hg).elim
      · exact cN <| tstepMC_casCell ht hpk hnw hT hCk hi hE htv hm hH hC hfo hrmw hRP
      · exact cN <| tstepMC_casCellLoc ht hpk hnw hT hCk hi hE htv hm hH hC hfo hrmw hRP
  | caspMove hpk | caspTake hpk | caspE hpk | caspBump hpk =>
      obtain ⟨μ, u, hteq | hteq, hμ, hu⟩ := hsc' _ hpk
      · rw [hteq] at hpk
        exact cN <| tstepMC_casp ht hpk hμ hu hT hCk hi hE htv hm hH hC hfo hRP
      · rw [hteq] at hpk
        exact cN <| tstepMC_caspLoc ht hpk hμ hu hT hCk hi hE htv hm hH hC hfo hRP
  | ret => exact (hR' True.intro).elim
  | tail => exact (hR' hsc').elim
/-- (S7c) The fixed-credit form of a step's conclusion gives the new-credit one. -/
theorem mcX {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh} {η : TEnv}
    {Rf Rs H : Res} {cr db : Ts → Res}
    (h : tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F,
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr db ∧ MintStep g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧ ClaimAt th.term C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db + F) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F cr' db',
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr' db' ∧ MintStep g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧ ClaimAt th.term C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr' + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db' + F :=
  ⟨h.1, fun r hr hpa => let ⟨Tot, H', C, F, h1, h2, h3, h4⟩ := h.2 r hr hpa; ⟨Tot, H', C, F, cr, db, h1, h2, h3, h4⟩⟩

/-- (route B) `tstepMC_publish` exporting `PubCons`: the consumed key is the
published cell's own key (`ownW_own_loc`). -/
theorem tstepMC_publishP {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {a : At} {e : Expr}
    {Rf Rs H : Res}
    (hterm : th.term = .let_ x (.publish a) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    {cr db : Ts → Res} (hC : PromCr (CE η) (stOf mem pairs th) cr db) (hsc : PubScope cx a)
    (hwp : ∀ rt ws ad, evalAt th.env a = some (rt, ws) → ws.map (·.val) = [.loc ad 0] →
      FlipOK (CE η) (stOf mem pairs th) ad.label)
    (hwin : ∀ rt ws ad, evalAt th.env a = some (rt, ws) → ws.map (·.val) = [.loc ad 0] →
      NoHold (CE η) (stOf mem pairs th) ad.label)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hown1 : PubLe1 th Rf Rs H := by assumption)
    (hPb : ∀ y a e rt ws ad, th.term = .let_ y (.publish a) e → evalAt th.env a = some (rt, ws) →
      ws.map (·.val) = [.loc ad 0] → g.pf ad.label := by exact fun _ _ _ _ _ _ _ _ _ => trivial) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F cr' db',
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr' db' ∧ MintStep g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧
      ClaimAtP th C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr' + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db' + F := by
  have h := tstepMR_publish (hPb := hPb) hterm hP hT hCk hi hE htv hm hH hsc hC hwp hwin hfo hRP hPS
  refine ⟨h.1, fun r hr hpa => ?_⟩
  obtain ⟨Tot, H', cr', db', rt, ws, hev, -, h1, h2⟩ := h.2 r hr hpa
  refine ⟨Tot, H', ownW .own ws, .zero, cr', db', h1, .consume .own ws,
    ⟨(MintStepN.consume (g := g) (η := η) (s := stOf mem pairs th) (s' := stOf r.1 r.2.1 r.2.2) .own ws).claimAt _, ?_⟩, ?_⟩
  · intro y a' e' rt' ws' ad ht' hev' hws'
    rw [hterm] at ht'
    cases ht'
    rw [hev] at hev'
    cases hev'
    rw [ownW_own_loc hws']
    simp
  · simp only [Res.add_zero]
    exact h2

/-- **(P4 step 5b, S7c) The thread step with memory holdings and promise
credits, every in-scope term**: `tstepMCF_stepK` (credits kept) but at
`publish`, whose view change flips the published cell's accounting
(`tstepMC_publish`, side condition `hwp`): the credits move to `cr'`, `db'`. -/
theorem tstepMCF_stepL {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {Rf Rs H : Res} {cr db : Ts → Res}
    [ProgRetIall p] [TermA4.ProgCkWC p] (hP : ProgT p) (hp : g.p = p) (hn : 0 < g.n) (hnd : isDone th = false)
    (hsc : StepScope cx th.term ∨ StepScopeR th.σs cx th.term)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp)
    (hpx : PAx g mem pairs th) (hC : PromCr (CE η) (stOf mem pairs th) cr db)
    (hia : StoreIall ρ η cx th)
    (hdw : StoreCrZ η cx (stOf mem pairs th) th) (hnvp : OwnOpT cx th.term → OwnNVPF (CE η) (stOf mem pairs th))
    (hwp : ∀ x a e rt ws ad, th.term = .let_ x (.publish a) e → evalAt th.env a = some (rt, ws) →
      ws.map (·.val) = [.loc ad 0] → FlipOK (CE η) (stOf mem pairs th) ad.label)
    (hwin : PubWinT (CE η) (stOf mem pairs th) th)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRF : OwnFrontierRMWT (CE η) (stOf mem pairs th) th.term) (hrmw : NoPlantRMW (CE η) th) (hbf : g.boxFence = true) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) (hSub : PwSubS) (hSig : PwSig) (hown1 : PubLe1 th Rf Rs H := by assumption)
    (hZ : ZOK g (CE η) th := by exact fun _ _ h => False.elim h)
    (hPb : ∀ y a e rt ws ad, th.term = .let_ y (.publish a) e → evalAt th.env a = some (rt, ws) →
      ws.map (·.val) = [.loc ad 0] → g.pf ad.label := by exact fun _ _ _ _ _ _ _ _ _ => trivial) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) → ∃ Tot H' C F cr' db',
      ThInvMCFS p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' cr' db' ∧ MintStep g η (stOf mem pairs th) (stOf r.1 r.2.1 r.2.2) C F ∧ ClaimAtP th C F ∧
      Tot + H' + pSum (stOf r.1 r.2.1 r.2.2) cr' + pSum (stOf mem pairs th) db + C ≤
        Rf + Rs + H + pSum (stOf mem pairs th) cr + pSum (stOf r.1 r.2.1 r.2.2) db' + F := by
  by_cases hpub : ∃ x a e, th.term = .let_ x (.publish a) e
  · obtain ⟨x, a, e, ht⟩ := hpub
    by_cases hR : StepScopeR th.σs cx th.term
    · rw [ht] at hR
      simp only [StepScopeR, OpScopeR] at hR
    · have hsc' := hsc.resolve_right hR
      rw [ht] at hsc'
      exact tstepMC_publishP (hPb := hPb) ht hP hT hCk hi hE htv hm hH hC hsc' (fun rt ws ad => hwp x a e rt ws ad ht)
        (fun rt ws ad => hwin x a e rt ws ad ht) hfo hRP hPS
  · exact claimP_map6 (fun x a e h => hpub ⟨x, a, e, h⟩)
      (mcX (tstepMCF_stepK (hZ := hZ) hP hp hn hnd hsc hT hCk hi hE htv hm hH hpx hC hia hdw hnvp
        (fun x a e h => hpub ⟨x, a, e, h⟩) hfo hRF hrmw hbf hRP hPS hSub hSig))


