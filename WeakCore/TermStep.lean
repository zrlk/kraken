      (storeUnits_growsF us ws 0 s s' hs').2.1 (storeUnits_fulL hm.2.2.1 hs') hne hl) hmono ht.symm
    (fun l' _ => by rw [hpf])
  obtain ⟨Rs', hL', e'⟩ := hent.toS
  rw [e']
  exact ⟨_, MemHeldL_unfocus hX' hL', SKeep_noPred hnv.2.2⟩
