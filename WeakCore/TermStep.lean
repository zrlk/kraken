/-! B.3: transfer between threads' environments.

`VR`/`VRR` read `tid` only through `ModeOK .own` (the box arm reads `seen`,
`pfr`, `box`, since).  `Ty.noOwnIn ke t` excludes every `own` mode that
`VR` reaches (`VR` never descends into a reference's target: it compares the
cell type with `cl ρ η.wit 0 0 u` by `Fd`), so `tid` may change freely. -/

theorem ModeOK_tid {i j : Nat} {P : AllocLabel → Option Ts} {S : AllocLabel → Prop} {μ : Mode}
    {l : AllocLabel} {c : Cell} {ws : List Word} (hμ : μ ≠ .own) :
    ModeOK i P S μ l c ws → ModeOK j P S μ l c ws := by
  cases μ with
  | own => exact absurd rfl hμ
  | pub => exact id
  | rgn _ => exact id

theorem noOwnIn_ptr_mode {ke : KEnv} {μ : Mode} {u : Ty} (h : Ty.noOwnIn ke (.ptr μ u) = true) : μ ≠ .own := by
  intro e; subst e; simp [Ty.noOwnIn] at h

theorem noOwnIn_ptrOpt_mode {ke : KEnv} {μ : Mode} {u : Ty} (h : Ty.noOwnIn ke (.ptrOpt μ u) = true) :
    μ ≠ .own := by
  intro e; subst e; simp [Ty.noOwnIn] at h

theorem noOwnIn_loc_mode {ke : KEnv} {μ : Mode} {u : Ty} (h : Ty.noOwnIn ke (.loc μ u) = true) : μ ≠ .own := by
  intro e; subst e; simp [Ty.noOwnIn] at h

/-- **Transfer** of `VR` to an environment with any `tid`, for a type with no
reachable `own` reference: `VR_mono` with `η₁.tid = η₂.tid` replaced by
`Ty.noOwnIn ke t`. -/
theorem VR_transfer : ∀ (t : Ty) (ke : KEnv) (η₁ η₂ : TEnv) (ρ : Nat → Nat) (rt : Shp) (ws : List Word),
    Ty.noOwnIn ke t = true →
    (∀ k S vs, η₁.rels k S vs → η₂.rels k S vs) → (∀ k S vs, η₁.urels k S vs → η₂.urels k S vs) →
    η₁.wit = η₂.wit → η₁.prog = η₂.prog →
    (∀ l c, η₁.sto l = some c → η₂.sto l = some c) →
    (∀ l, η₁.ini l ≤ η₂.ini l) → (∀ l f, η₁.pfr l = some f → η₂.pfr l = some f) →
    (∀ l, η₁.seen l → η₂.seen l) → (∀ l B, η₁.box l = some B → η₂.box l = some B) →
    VR ρ η₁ t rt ws → (hri : ∀ l, η₁.rini l ≤ η₂.rini l := by rini_le) → VR ρ η₂ t rt ws
  | .tvar k, _, η₁, η₂, ρ, rt, ws, _, hr, _, _, _, _, _, _, _, _, hv, hri => by
      simp only [VR, TEnv.get] at hv ⊢
      obtain ⟨w0, h0, h1⟩ := hv; exact ⟨w0, h0, hr k rt _ h1⟩
  | .refine t ψ, ke, η₁, η₂, ρ, rt, ws, hn, hr, hur, hw, hp, hs, hi, hP, hS, hBx, hv, hri => by
      simp only [Ty.noOwnIn] at hn
      simp only [VR] at hv ⊢
      exact ⟨VR_transfer t ke η₁ η₂ ρ rt ws hn hr hur hw hp hs hi hP hS hBx hv.1, IniR_mono (TEnv.selIni_le hw hi hri t) hv.2⟩
