/-- (§11) **The two-sided mix**: a selection of access units from two values
and its complement carry, together, at most both values' resources. -/
theorem VRR_mix2 {ρ : Nat → Nat} {η : TEnv} {T : Ty} {us : List Acc} {sel : Nat → Bool}
    {ws1 ws2 : List Word} {R1 R2 : Res}
    (hc : Ty.coupledOKIn [] T = true) (hia : IallOK [] T = true) (hu : accs T = some us)
    (h1 : VRR ρ η T (shp T) ws1 R1) (h2 : VRR ρ η T (shp T) ws2 R2)
    (l1 : ws1.length = nWords us) (l2 : ws2.length = nWords us) :
    ∃ Ra Rb, VRR ρ η T (shp T) (mixU us sel ws1 ws2) Ra ∧ VRR ρ η T (shp T) (mixU us sel ws2 ws1) Rb ∧
      Ra + Rb ≤ R1 + R2 :=
  mixR2_gen T [] us sel ρ ρ ρ ρ η η η η ws1 ws2 R1 R2 hc hia hu l1 l2 (fun _ _ => rfl) (fun _ _ => rfl)
    (fun _ _ => rfl) (fun _ _ => rfl)
    (fun _ _ => ⟨rfl, rfl, rfl⟩) (fun _ _ => ⟨rfl, rfl, rfl⟩) (fun _ _ => ⟨rfl, rfl, rfl⟩) (fun _ _ => ⟨rfl, rfl, rfl⟩)
    rfl rfl rfl rfl (CZ_nil η) (CZ_nil η) h1 h2


