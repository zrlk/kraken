/-- (U3 R1) **`ValOf` transfers along agreement on the labels it names**
(`VR_monoG` at the unseen code views; `seen` is not read). -/
theorem ValOf_monoG {G : AllocLabel → Prop} {η₁ η₂ : TEnv} {T : Ty} {ws : List Word}
    (hp : η₁.prog = η₂.prog) (ht : η₁.tid = η₂.tid)
    (hs : ∀ l c, G l → η₁.sto l = some c → η₂.sto l = some c)
    (hi : ∀ l, G l → η₁.ini l ≤ η₂.ini l) (hri : ∀ l, G l → η₁.rini l ≤ η₂.rini l)
    (hP : ∀ l f, G l → η₁.pfr l = some f → ∃ f', η₂.pfr l = some f' ∧ f' ≤ f)
    (hBx : ∀ l B, G l → η₁.box l = some B → η₂.box l = some B ∧ LabsIn G B.pay)
    (hG : LabsIn G ws) (h : ValOf η₁ T ws) : ValOf η₂ T ws :=
  ⟨VR_monoG T (CE η₁.unsee) (CE η₂.unsee) _ _ ws (fun _ _ _ h => h) (fun _ _ _ h => h)
    ⟨hs, hi, hri, hP, fun _ _ _ h => h.elim, fun _ _ h => h.elim, hBx, rfl, hp, ht⟩ hG h.1, h.2⟩

#print axioms ValOf_monoG

/-- (U3 R1) What `VR` reads of an environment besides its variables and
`seen`: two environments with the same core differ only there. -/
def CoreEq (θ η : TEnv) : Prop :=
  θ.sto = η.sto ∧ θ.tid = η.tid ∧ θ.ini = η.ini ∧ θ.rini = η.rini ∧ θ.pfr = η.pfr ∧ θ.box = η.box ∧
    θ.prog = η.prog

theorem CoreEq.push0 {θ η : TEnv} (h : CoreEq θ η) (s : Ty) : CoreEq (θ.push0 s) η := h
theorem CoreEq.unsee {θ η : TEnv} (h : CoreEq θ η) : CoreEq θ.unsee η := h
theorem CoreEq.refl (η : TEnv) : CoreEq η η := ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩

/-- (U3 R1) **Payload transfer** at the boxes of `G`, from `E₁` to `E₂` (the
explicit hypothesis `hpay` of `VR_monoH`): a payload re-injected at any arm,
a value in an environment with `E₁`'s core, is one in the matching
environment with `E₂`'s core (same witnesses, memory relations grown). -/
def PayT (G : AllocLabel → Prop) (E₁ E₂ : TEnv) : Prop :=
  ∀ l B, G l → E₁.box l = some B → ∀ (θ₁ θ₂ : TEnv) (ρ : Nat → Nat) (a T : Ty) (j : Nat) (q : List Word),
    CoreEq θ₁ E₁ → CoreEq θ₂ E₂ → θ₁.wit = θ₂.wit → (∀ k S vs, θ₁.urels k S vs → θ₂.urels k S vs) →
    ofArm T j B.pay = some q → VR ρ θ₁.unsee a (shp T) q → VR ρ θ₂.unsee a (shp T) q

/-- (U3 R1) `AgreeG` with boxes kept but their payloads unconstrained (their
transfer is `PayT`). -/
structure AgreeV (G : AllocLabel → Prop) (η₁ η₂ : TEnv) : Prop where
  sto : ∀ l c, G l → η₁.sto l = some c → η₂.sto l = some c
  ini : ∀ l, G l → η₁.ini l ≤ η₂.ini l
  rini : ∀ l, G l → η₁.rini l ≤ η₂.rini l
  pfr : ∀ l f, G l → η₁.pfr l = some f → ∃ f', η₂.pfr l = some f' ∧ f' ≤ f
  pfrS : ∀ l f, G l → η₁.seen l → η₁.pfr l = some f → η₂.pfr l = some f
  seen : ∀ l, G l → η₁.seen l → η₂.seen l
  box : ∀ l B, G l → η₁.box l = some B → η₂.box l = some B
  wit : η₁.wit = η₂.wit
  prog : η₁.prog = η₂.prog
  tid : η₁.tid = η₂.tid

theorem AgreeV.push0 {G : AllocLabel → Prop} {η₁ η₂ : TEnv} (h : AgreeV G η₁ η₂) (s : Ty) :
    AgreeV G (η₁.push0 s) (η₂.push0 s) :=
  ⟨h.sto, h.ini, h.rini, h.pfr, h.pfrS, h.seen, h.box,
    by simp only [TEnv.push0, TEnv.ins, TEnv.insR, h.wit], h.prog, h.tid⟩

theorem selIni_leV {G : AllocLabel → Prop} {η₁ η₂ : TEnv} (h : AgreeV G η₁ η₂) (t : Ty) :
    ∀ l, G l → η₁.selIni t l ≤ η₂.selIni t l := by
  intro l hl
  have h1 := h.ini l hl; have h2 := h.rini l hl
  unfold TEnv.selIni; rw [TEnv.ownTop_congr h.wit t]; split
  · simp only; omega
  · exact h1

theorem modeIni_leV {G : AllocLabel → Prop} {η₁ η₂ : TEnv} (h : AgreeV G η₁ η₂) (μ : Mode) {l : AllocLabel}
    (hl : G l) : modeIni μ η₁.ini η₁.rini l ≤ modeIni μ η₂.ini η₂.rini l := by
  have h1 := h.ini l hl; have h2 := h.rini l hl
  cases μ <;> simp only [modeIni] <;> omega

/-- (U3 R1) **`VR` transfers along agreement on the labels it names, box
payloads by `PayT`**: `VR_monoG` with the payload condition (`LabsIn G
B.pay`) replaced by the explicit transfer `hpay` at base environments `E₁`,
`E₂` whose cores the two environments keep. -/
theorem VR_monoH {G : AllocLabel → Prop} {E₁ E₂ : TEnv} (hpay : PayT G E₁ E₂) :
    ∀ (t : Ty) (η₁ η₂ : TEnv) (ρ : Nat → Nat) (rt : Shp) (ws : List Word),
    CoreEq η₁ E₁ → CoreEq η₂ E₂ →
    (∀ k S vs, η₁.rels k S vs → η₂.rels k S vs) → (∀ k S vs, η₁.urels k S vs → η₂.urels k S vs) →
    AgreeV G η₁ η₂ → LabsIn G ws → VR ρ η₁ t rt ws → VR ρ η₂ t rt ws
  | .tvar k, η₁, η₂, ρ, rt, ws, _, _, hr, _, _, _, hv => by
      simp only [VR, TEnv.get] at hv ⊢
      obtain ⟨w0, h0, h1⟩ := hv; exact ⟨w0, h0, hr k rt _ h1⟩
  | .refine t ψ, η₁, η₂, ρ, rt, ws, hc1, hc2, hr, hur, hA, hG, hv => by
      simp only [VR] at hv ⊢
      exact ⟨VR_monoH hpay t η₁ η₂ ρ rt ws hc1 hc2 hr hur hA hG hv.1, IniR_monoG (selIni_leV hA t) hG hv.2⟩
  | .iex b, η₁, η₂, ρ, rt, ws, hc1, hc2, hr, hur, hA, hG, hv => by
      simp only [VR] at hv ⊢
      obtain ⟨n, rb, w, h1, h2⟩ := hv
      exact ⟨n, rb, w, h1, VR_monoH hpay b η₁ η₂ (vcons w ρ) rb ws hc1 hc2 hr hur hA hG h2⟩
  | .prod a b, η₁, η₂, ρ, rt, ws, hc1, hc2, hr, hur, hA, hG, hv => by
      simp only [VR] at hv ⊢
      obtain ⟨ra, rb, h1, hf⟩ := hv
      refine ⟨ra, rb, h1, fun n hn => ?_⟩
      obtain ⟨e1, e2, e3⟩ := hf n hn
      exact ⟨e1, VR_monoH hpay a η₁ η₂ ρ _ _ hc1 hc2 hr hur hA (LabsIn_sub hG fun _ h => List.mem_of_mem_take h) e2,
        VR_monoH hpay b η₁ η₂ ρ _ _ hc1 hc2 hr hur hA (LabsIn_sub hG fun _ h => List.mem_of_mem_drop h) e3⟩
  | .sum a b, η₁, η₂, ρ, rt, ws, hc1, hc2, hr, hur, hA, hG, hv => by
      simp only [VR] at hv ⊢
      obtain ⟨n, Ra, Rb, h1, ⟨hb, x, s, B, hx, ho, hB, hn, hsB, hm, hA1, hA'⟩ | ⟨j, p, hd, h2, h3⟩⟩ := hv
      · have hxG : G x.label := LabsIn_one hG hx
        have hB2 := hA.box _ _ hxG hB
        have hB1 : E₁.box x.label = some B := by rw [← hc1.2.2.2.2.2.1]; exact hB
        refine ⟨n, Ra, Rb, h1, Or.inl ⟨hb, x, s, B, hx, ho, hB2, hn, hsB,
          hm.imp (fun ⟨h1, f, h2, h3⟩ => ⟨hA.seen _ hxG h1, f, hA.pfrS _ _ hxG h1 h2, h3⟩) id,
          fun hj => ⟨fun e => VR_monoH hpay a η₁ η₂ ρ _ _ hc1 hc2 hr hur hA hG ((hA1 hj).1 e), fun e => ?_⟩,
          fun hj => ⟨fun e => VR_monoH hpay b η₁ η₂ ρ _ _ hc1 hc2 hr hur hA hG ((hA' hj).1 e), fun e => ?_⟩⟩⟩
        · obtain ⟨q, hq, hs1, hw1, hv1, hv⟩ := (hA1 hj).2 e
          exact ⟨q, hq, hs1, hw1, hv1, hpay _ _ hxG hB1 η₁ η₂ ρ a Ra _ q hc1 hc2 hA.wit hur hq hv⟩
        · obtain ⟨q, hq, hs1, hw1, hv1, hv⟩ := (hA' hj).2 e
          exact ⟨q, hq, hs1, hw1, hv1, hpay _ _ hxG hB1 η₁ η₂ ρ b Rb _ q hc1 hc2 hA.wit hur hq hv⟩
      · have hpG := decodeArm_labs hd hG
        refine ⟨n, Ra, Rb, h1, Or.inr ⟨j, p, hd, fun hj => ?_, fun hj => ?_⟩⟩
        · obtain ⟨q, hq, hv⟩ := h2 hj
          exact ⟨q, hq, VR_monoH hpay a η₁ η₂ ρ _ _ hc1 hc2 hr hur hA (ofArm_labs hq hpG) hv⟩
        · obtain ⟨q, hq, hv⟩ := h3 hj
          exact ⟨q, hq, VR_monoH hpay b η₁ η₂ ρ _ _ hc1 hc2 hr hur hA (ofArm_labs hq hpG) hv⟩
  | .code a b _, η₁, η₂, ρ, rt, ws, _, _, _, _, hA, _, hv => by
      simp only [VR] at hv ⊢; rw [← hA.wit, ← hA.prog]; exact hv
  | .tex κ b, η₁, η₂, ρ, rt, ws, hc1, hc2, hr, hur, hA, hG, hv => by
      simp only [VR] at hv ⊢
      obtain ⟨n, rb, s, h1, h2, haf, h3⟩ := hv
      exact ⟨n, rb, s, h1, h2, haf, VR_monoH hpay b (η₁.push0 s) (η₂.push0 s) ρ rb ws (hc1.push0 s) (hc2.push0 s)
        (push0_rels_mono hr) (push0_urels_mono hur) (hA.push0 s) hG h3⟩
  | .ptr μ u, η₁, η₂, ρ, rt, ws, _, _, _, _, hA, hG, hv => by
      simp only [VR] at hv ⊢
      obtain ⟨a, c, h1, h2, h3, h4, h5, h6⟩ := hv
      have haG : G a.label := LabsIn_one hG h1
      exact ⟨a, c, h1, h2, hA.sto _ _ haG h3, hA.wit ▸ h4,
        hA.tid ▸ ModeOK_monoG (hA.pfr _ · haG) (fun f hs hf => hA.pfrS _ f haG hs hf) (hA.seen _ haG) h5, h6⟩
  | .ptrOpt μ u, η₁, η₂, ρ, rt, ws, _, _, _, _, hA, hG, hv => by
      simp only [VR] at hv ⊢
      rcases hv with hn | ⟨a, c, h1, h2, h3, h4, h5, h6⟩
      · exact Or.inl hn
      · have haG : G a.label := LabsIn_one hG h1
        exact Or.inr ⟨a, c, h1, h2, hA.sto _ _ haG h3, hA.wit ▸ h4,
          hA.tid ▸ ModeOK_monoG (hA.pfr _ · haG) (fun f hs hf => hA.pfrS _ f haG hs hf) (hA.seen _ haG) h5, h6⟩
  | .loc μ u, η₁, η₂, ρ, rt, ws, _, _, _, _, hA, hG, hv => by
      simp only [VR] at hv ⊢
      rcases hv with hn | ⟨a, c, U, h1, h3, h4, hF, h5, h6⟩
      · exact Or.inl ⟨hn.1, hA.wit ▸ hn.2⟩
      · have haG : G a.label := LabsIn_one hG h1
        exact Or.inr ⟨a, c, U, h1, hA.sto _ _ haG h3, h4, hA.wit ▸ hF,
          hA.tid ▸ ModeOK_monoG (hA.pfr _ · haG) (fun f hs hf => hA.pfrS _ f haG hs hf) (hA.seen _ haG) h5,
          IniAt_monoG (modeIni_leV hA μ haG) h6⟩
  | .intS _, _, _, _, _, _, _, _, _, _, _, _, hv => by simpa only [VR] using hv
  | .opq _, _, _, _, _, _, _, _, _, _, _, _, hv => by simpa only [VR] using hv
  | .int, _, _, _, _, _, _, _, _, _, _, _, hv => by simpa only [VR] using hv
  | .tid, _, _, _, _, _, _, _, _, _, hA, hG, hv => by
      simp only [VR] at hv ⊢
      obtain ⟨l, c, h1, h2, h3, h5⟩ := hv
      have hl : G l := LabsIn_one hG h1
      exact ⟨l, c, h1, hA.sto _ _ hl h2, h3,
        hA.tid ▸ ModeOK_monoG (hA.pfr _ · hl) (fun f hs hf => hA.pfrS _ f hl hs hf) (hA.seen _ hl) h5⟩
  | .fix _ _, _, _, _, _, _, _, _, _, _, _, _, hv => by simpa only [VR] using hv
  | .lanes _ _, _, _, _, _, _, _, _, _, _, _, _, hv => by simpa only [VR] using hv
  | .unit, _, _, _, _, _, _, _, _, _, _, _, _ => by simp [VR]
  | .void, _, _, _, _, _, _, _, _, _, _, _, hv => by simp [VR] at hv
  | .array _ _, _, _, _, _, _, _, _, _, _, _, _, _ => by simp [VR]
  | .share _, _, _, _, _, _, _, _, _, _, _, _, _ => by simp [VR]
  | .cap _ _, _, _, _, _, _, _, _, _, _, _, _, _ => by simp [VR]
  | .word _ _, _, _, _, _, _, _, _, _, _, _, _, hv => by simpa only [VR] using hv
  | .tok _ _, _, _, _, _, _, _, _, _, _, _, _, _ => by simp [VR]
  | .word2 _ _, _, _, _, _, _, _, _, _, _, _, _, hv => by simpa only [VR] using hv
  | .tok2 _ _ _ _, _, _, _, _, _, _, _, _, _, _, _, _ => by simp [VR]
  | .epair _ _, _, _, _, _, _, _, _, _, _, _, _, hv => by simpa only [VR] using hv
  | .tokE _ _ _, _, _, _, _, _, _, _, _, _, _, _, _ => by simp [VR]
  | .mu b, η₁, η₂, ρ, rt, ws, hc1, hc2, hr, hur, hA, hG, hv => by
      simp only [VR] at hv ⊢
      rw [← hA.wit]
      exact VR_monoH hpay b (η₁.push0 (cl ρ η₁.wit 0 0 (.mu b))) (η₂.push0 (cl ρ η₁.wit 0 0 (.mu b))) ρ rt ws
        (hc1.push0 _) (hc2.push0 _) (push0_rels_mono hr) (push0_urels_mono hur) (hA.push0 _) hG hv
  | .iall b, η₁, η₂, ρ, rt, ws, hc1, hc2, hr, hur, hA, hG, hv => by
      simp only [VR] at hv ⊢
      exact fun n => VR_monoH hpay b η₁ η₂ (vcons n ρ) rt ws hc1 hc2 hr hur hA hG (hv n)

