theorem heldMixAtLC {g : G} {E : TEnv} {s : St} {H : Res} {Sl : AllocLabel → List Res} {a : Address} {c : Cell}
    {us : List Acc} {nI : AllocLabel → Nat} (hnI : nI a.label ≤ E.ini a.label)
    {ws : List Word} {U : Ty} {Rv : Res} {f : Ts} (hm : MemInv g E s) (hH : MemHeldL E s H Sl)
    (hsto : E.sto a.label = some c) (hf : E.pfr a.label = some f) (hat : AtOff c.ty a.offset U)
    (hini : IniAt nI c a U) (hna : ∀ N e, U ≠ .array (.lit N) e)
    (hiaU : TermTear.IallOK [] U = true) (hfo1 : ∀ t, t ∈ E.fp → t < s.mem.size)
    (hU : EnvValR E U ws Rv) (hus : accs U = some us) (hlen : ws.length = nWords us)
    {k : Promises.Knobs} {arch : Arch} {pw : Word} {rel : Bool} {s' : St}
    (hs' : s' ∈ storeUnits k arch pw a rel us ws 0 s) :
    ∃ H2 Sl' Rb comp, H2 + Rb ≤ Rv + H ∧ MemHeldL E s' H2 Sl' ∧ SSet E nI Sl Sl' a.label ∧
      comp.length = nWords us ∧ VRR (fun _ => 0) (CE E.unsee) U (shp U) comp Rb ∧
      ∀ t m j, t ∈ s.promises → t ∉ s'.promises → s.mem[t]? = some m → m.loc = offs a j → VisU E m.loc →
        comp[j]? = (ws.map (bumpW s.vs.vRelSt))[j]? := by
  have hwU : wc U = some (nWords us) := wc_of_accs hus
  have hcpU := coupledOK_AtOff hat (MemInv_cplT hm hsto hf)
  obtain ⟨H0, rfl, hent0, hX⟩ := MemHeldL_focus hH a.label
  obtain ⟨vals0, hL0, hC0⟩ := hent0.2 c hsto
  rcases own_segL hnI hC0 hat hini hna with ⟨b, oS, S, wS, kk, Rsg, -, hbo, hatS, hwS, hbw, hkk, ⟨hvs, hVs⟩, hkb, hput⟩ |
    ⟨-, -, -, -, -, -, -, hz0⟩
  rotate_left
  · obtain rfl := nWords_zero_nil (hz0 _ hus)
    simp only [storeUnits, List.mem_singleton] at hs'
    subst hs'
    exact ⟨_, Sl, Rv, _, fun k => by simp only [Res.add_apply]; omega, hH, SSet_refl _ _ _ _,
      by rw [List.length_map, hlen], (hU.store hm.2.2.2.2.1).1, fun _ _ _ _ _ _ _ _ => rfl⟩
  have hsl : ((vals0.drop b).take wS).length = wS := by
    simp only [List.length_take, List.length_drop]; omega
  obtain ⟨n, Rq, Rr2, hwn, hle2, hRs, hvq, hput2⟩ := VRR_at E.unsee hatS hvs (by rw [hsl]; exact hwS)
  rw [hwU] at hwn
  obtain rfl : nWords us = n := Option.some.inj hwn
  rw [hsl] at hle2
  obtain ⟨n', hwn', -, -, hVq⟩ := VR_at E.unsee hatS (VRR_VR S (RLink_of (Coh_CE _) (CohR_CE _)) hvs) hVs
    (by rw [hsl]; exact hwS)
  rw [hwU] at hwn'
  obtain rfl : nWords us = n' := Option.some.inj hwn'
  have hlenv : a.offset + nWords us ≤ vals0.length := by
    rw [← hbo, Nat.add_assoc]; exact Nat.le_trans (Nat.add_le_add_left hle2 b) hbw
  have hvqe : (((vals0.drop b).take wS).drop oS).take (nWords us) = (vals0.drop a.offset).take (nWords us) := by
    rw [take_drop_take hle2, drop_drop', hbo]
  rw [hvqe] at hvq hVq
  generalize hqo : (vals0.drop a.offset).take (nWords us) = qold at hvq hVq
  have hlq : qold.length = nWords us := by rw [← hqo]; simp; omega
  have hPb : ∀ t, t ∈ s.promises → t < s.mem.size := fun t ht => hm.2.2.1 t ht
  obtain ⟨sel, vals', hWv, hLv, hcomp⟩ := storeUnits_NPmixF (E := E) us ws 0 s s'
    s.vs.vRelSt qold hs' (Nat.le_refl _) hPb hfo1 hlq
    (fun j w hj => by
      have hj' : vals0[a.offset + j]? = some w := by
        rw [← hqo] at hj
        by_cases hjn : j < nWords us
        · rw [List.getElem?_take_of_lt hjn, List.getElem?_drop] at hj; exact hj
        · rw [List.getElem?_eq_none (by simp; omega)] at hj; cases hj
      have e : offs a (0 + j) = ⟨a.label, a.offset + j⟩ := by simp [offs]
      rw [e]; exact hL0 _ w hj')
  have hst := hU.store hm.2.2.2.2.1
  have hln : (ws.map (bumpW s.vs.vRelSt)).length = nWords us := by
    rw [List.length_map, hlen]
  obtain ⟨Rm, Rb, hvm, hvb, hRm⟩ := TermTear.VRR_mix2 (sel := sel) hcpU hiaU hus hst.1 hvq hln hlq
  have hVm := TermTear.Valid_mix (sel := sel) hus hst.2 hVq hln hlq
  have hlm0 := TermTear.length_mixU us sel _ _ hln hlq
  generalize hqm : TermTear.mixU us sel (ws.map (bumpW s.vs.vRelSt)) qold = qm
    at hvm hVm hWv hlm0
  have hQ := hput2 qm Rm hvm hlm0
  have hQV := (VR_put E.unsee hatS (VRR_VR S (RLink_of (Coh_CE _) (CohR_CE _)) hvs) hVs
    (by rw [hsl]; exact hwS) (VRR_VR _ (RLink_of (Coh_CE _) (CohR_CE _)) hvm) hVm (by rw [hlm0]; exact hwU)).2.2
  rw [hlm0] at hQV
  have hQl : (((vals0.drop b).take wS).take oS ++ qm ++ ((vals0.drop b).take wS).drop (oS + nWords us)).length = wS := by
    simp only [List.length_append, List.length_take, List.length_drop, hlm0]; omega
  have hcell' := hput _ _ ⟨hQ, hQV⟩ hQl
  have hsp := splice_seg vals0 qm b wS oS (by rw [hlm0]; exact hle2)
  rw [hlm0] at hsp
  rw [hsp, hbo] at hcell'
  have hlv' : vals'.length = nWords us := by rw [← WLe.length hWv, hlm0]
  have hcell2 := CellR_up (WLe.append (WLe.append (WLe_refl (vals0.take a.offset)) hWv)
    (WLe_refl (vals0.drop (a.offset + nWords us)))) hcell'
  have hlat' : ∀ o w, (vals0.take a.offset ++ vals' ++ vals0.drop (a.offset + nWords us))[o]? = some w →
      LatestNP s'.mem (PromAt E s' ⟨a.label, o⟩) ⟨a.label, o⟩ w := by
    intro o w hov
    rw [splice_get vals0 vals' a.offset (nWords us) o hlv' hlenv] at hov
    by_cases hr : a.offset ≤ o ∧ o < a.offset + nWords us
    · rw [iteT hr] at hov
      have := hLv (o - a.offset) w hov
      have e2 : offs a (0 + (o - a.offset)) = ⟨a.label, o⟩ := by
        simp only [offs, Nat.zero_add]; congr 1; exact Nat.add_sub_of_le hr.1
      rw [e2] at this; exact this
    · rw [iteF hr] at hov
      refine storeUnits_NPkeep us ws 0 _ s' hs' _ w (fun j hj e => ?_) (hL0 o w hov)
      have h' : o = a.offset + j := by simpa [offs] using congrArg WeakMem.Address.offset e
      subst h'
      exact hr ⟨Nat.le_add_right _ _, Nat.add_lt_add_left hj _⟩
  have hent : HeldEntryL E s' a.label ((Sl a.label).set kk (Rm + Rr2)) := by
    refine ⟨fun h => (by rw [hsto] at h; cases h), fun c2 hc2 => ?_⟩
    rw [hsto] at hc2; cases hc2
    exact ⟨_, hlat', hcell2⟩
  have hX' : MemHeldXL E s' a.label H0 Sl := MemHeldXL_tr hX (fun _ _ => rfl) (fun _ _ => rfl)
    (fun l' hne o w hl => storeUnits_NPkeep us ws 0 _ s' hs' ⟨l', o⟩ w
      (fun j _ he => hne (by have := congrArg WeakMem.Address.label he; simpa [offs] using this)) hl) id
  have hkl : kk < (Sl a.label).length := (List.getElem?_eq_some_iff.1 hkk).1
  have hkv : (Sl a.label)[kk] = Rsg := (List.getElem?_eq_some_iff.1 hkk).2
  refine ⟨_, _, Rb, _, Res.le_def.2 fun k => ?_, MemHeldL_unfocus hX' hent,
    ⟨fun l' hl' => updS_other Sl _ hl', Or.inr ⟨kk, Rm + Rr2, updS_self _ _ _, fun c1 N e hc1 hT => ?_⟩⟩,
    TermTear.length_mixU us sel _ _ hlq hln, hvb,
    fun t m j ht hn hm1 hl hV => hcomp t m j ht hn hm1 (by rw [hl, Nat.zero_add]) hV⟩
  · rw [Res.sum_set _ kk _ hkl, Res.sum_set_zero _ kk hkl, hkv]
    subst hRs
    have h2 := hRm k
    simp only [Res.add_apply] at h2 ⊢
    omega
  · rw [hsto] at hc1; cases hc1
    obtain ⟨us1, hu1⟩ : ∃ us1, accs e = some us1 := by
      have := MemInv_cplT hm hsto hf
      rcases hini N e hT with ⟨hUc, -⟩ | ⟨us1, -, -, hu1, -⟩
      · exact absurd (hUc.trans hT) (hna N e)
      · exact ⟨us1, hu1⟩
    exact (hkb N e us1 hT hu1).2
#print axioms heldMixAtLC

theorem heldMixAtL {g : G} {E : TEnv} {s : St} {H : Res} {Sl : AllocLabel → List Res} {a : Address} {c : Cell}
    {us : List Acc} {nI : AllocLabel → Nat} (hnI : nI a.label ≤ E.ini a.label)
    {ws : List Word} {U : Ty} {Rv : Res} {f : Ts} (hm : MemInv g E s) (hH : MemHeldL E s H Sl)
    (hsto : E.sto a.label = some c) (hf : E.pfr a.label = some f) (hat : AtOff c.ty a.offset U)
    (hini : IniAt nI c a U) (hna : ∀ N e, U ≠ .array (.lit N) e)
    (hiaU : TermTear.IallOK [] U = true) (hfo1 : ∀ t, t ∈ E.fp → t < s.mem.size)
    (hU : EnvValR E U ws Rv) (hus : accs U = some us) (hlen : ws.length = nWords us)
    {k : Promises.Knobs} {arch : Arch} {pw : Word} {rel : Bool} {s' : St}
    (hs' : s' ∈ storeUnits k arch pw a rel us ws 0 s) :
    ∃ H2 Sl', H2 ≤ Rv + H ∧ MemHeldL E s' H2 Sl' ∧ SSet E nI Sl Sl' a.label :=
  let ⟨H2, Sl', Rb, _, hle, h1, h2, _⟩ := heldMixAtLC hnI hm hH hsto hf hat hini hna hiaU hfo1 hU hus hlen hs'
  ⟨H2, Sl', Res.le_trans (Res.le_def.2 fun k => by simp only [Res.add_apply]; omega) hle, h1, h2⟩
#print axioms heldMixAtL

/-- (T2, option ii) The cell a plain store through a reference writes has
`IallOK` components (every `AtOff` position). Replaces the published-cell
side condition `hia`. -/
def StoreIall (ρ : Nat → Nat) (η : TEnv) (cx : Cx) (th : TTh) : Prop :=
  ∀ x rel a v tok e t, th.term = .let_ x (.store rel a v tok) e → cx.peek a = .ok t → wordOf t = none →
    ∀ rt pw ad, evalAt th.env a = some (rt, [pw]) → addrOf pw = some ad →
    ∀ cl0, (CE η).sto ad.label = some cl0 →
      (∀ μ u, t = .ptr μ u → ∀ o U, AtOff cl0.ty o U → TermTear.IallOK [] U = true) ∧
      (∀ μ u U, t = .loc μ u → AtOff cl0.ty ad.offset U → Fd U (cl ρ η.wit 0 0 u) →
        TermTear.IallOK [] U = true)

/-- **(P4) `store` at an own pointer, with resources**: the stored value's
resources move from the frame to the cell; the cell's old resources are
dropped (Q3 = A). -/
theorem tstepMR_storeOwn {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v : At} {tok : Option At}
    {u : Ty} {e : Expr} {Rf Rs H : Res}
    (hterm : th.term = .let_ x (.store rel a v tok) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.ptr .own u)) (hnw : wordOf (Ty.ptr .own u) = none)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hnvp : OwnNVP (CE η) (stOf mem pairs th))
    (hia : StoreIall ρ η cx th)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th,
      ∃ Tot H', ThInvMK p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | storeWordGive hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storeWordKeep hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storeWordHand hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storePub hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeRgn hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeCap hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeOwn hp _ hc hwf hu hsub hb =>
  obtain ⟨t, u', tv, c₁, hp, hc, hwf, hu, hsub, hb⟩ : ∃ t u' tv c₁, cx.peek a = .ok t ∧
      cellOf t = some (.own, u') ∧ Ty.wordFreeIn cx.ke u' = true ∧ cx.use v = .ok (tv, c₁) ∧
      SubS c₁ tv u' ∧ c₁.bind x .unit = .ok c' :=
    ⟨_, _, _, _, hp, hc, hwf, hu, hsub, hb⟩
  rw [hpk] at hp; cases hp
  simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc; subst hc
  have hi0 := hi.1
  have hotv : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have ho : cx.opaqueOK u = true := sub_opaqueOK hsub hotv
  have htb : tb cx.ke.length u = true := tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.ptr .own u) = some (.own, u))
  obtain ⟨lab, c, pw, ru, hea, hpw, hsto, hcty, hacc, hown, hsku, hsig⟩ := ownPtr_view hi0 hpk htv ho
  have hnv := hnvp _ _ hsto hown
  obtain ⟨rv, wsv, Rv, Rr, hev, hvv, hlv, hvrv, hi1, hle⟩ := useR hu hi hE.2.2
  have hsat : Sat c₁.facts ρ := hi1.1.1
  have hsigu : sig (close th.σs u) = sig (cl ρ η.wit 0 0 u) :=
    sig_WitL hi0.2.2.2.1 ρ ho (lt_of_guardT htb hi0.2.2.2.2.1)
  have hwcu : wc (cl ρ η.wit 0 0 u) ≠ none := by
    rw [← wc_of_sig hsigu]; exact (Lay_canon hsub hlv).2.2.2.1
  obtain ⟨us, hus⟩ : ∃ us, accs ru = some us := by
    have : wc ru ≠ none := by rw [wc_of_sig hsig]; exact hwcu
    cases h : accs ru with
    | none => simp [wc, h] at this
    | some us => exact ⟨us, rfl⟩
  obtain ⟨hval, hlen⟩ := ownStoreVal hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 hsat hsub ho htb hvv hlv hsig hus
  have husA : accs c.ty = some us := ((Fd_lay hcty).2.2.1.trans (pub_accs hi0.2.2.2.1 hi0.2.2.2.2.1 (fun k => (hE.2.1 k).1) hi0.2.1 htv hpk rfl ho hea rfl).symm).trans hus
  have hus' : wc c.ty = some (nWords us) := by rw [(Fd_lay hcty).2.1, ← wc_of_sig hsig]; simp [wc, hus]
  replace hval := (Fd_EnvVal (CE η) hcty).2 hval
  have hvalR : EnvValR (CE η) c.ty wsv Rv := by
    obtain ⟨hs, -⟩ := Lay_canon hsub hlv
    have hvu : VRR ρ η u (shp (close th.σs u)) wsv Rv := by rw [← hs]; exact VRR_sub hsat hsub _ _ _ hvrv
    have hvc : VRR (fun _ => 0) (CE η) (cl ρ η.wit 0 0 u) (shp (cl ρ η.wit 0 0 u)) wsv Rv := by
      rw [← shp_of_sig hsigu]
      exact (VRR_close hE.2.1 hE.2.2 ρ u [] 0 ρ (fun _ => 0) (shp (close th.σs u)) wsv Rv (fun k => rfl)
        (fun k hk => absurd hk (Nat.not_lt_zero _))).1 hvu
    refine ⟨?_, hval.2⟩
    rw [(Fd_lay hcty).1]
    exact (Fd_VRR η hcty).2 hvc
  have key : tstep g mem pairs th =
      (storeUnits g.k g.arch pw ⟨lab, 0⟩ rel us wsv 0 (stOf mem pairs th)).map fun s' =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, .unit, []) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hev, cellOf, addrOf, hpw, hus, List.map_map]; rfl
  rw [key]
  obtain ⟨s0, hs0⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := pw) (a := ⟨lab, 0⟩) (rel := rel)
    us wsv 0 (stOf mem pairs th) hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hs0), fun r hr => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨s', hs', rfl⟩ := hr
  have hsn := hm.2.2.2.2.1
  have hfr := bindR hb hi1 (RLink_of hE.2.1 hE.2.2) (show VRR ρ η .unit (shp .unit) [] .zero from rfl) (unit_Lay _)
  rw [Res.add_zero] at hfr
  have hnaC : ∀ N e, c.ty ≠ .array (.lit N) e := fun N e he => by rw [he] at husA; simp [accs] at husA
  rcases hpfl : (CE η).pfr lab with _ | f
  · obtain ⟨g2, -⟩ := storeUnits_latP (a := ⟨lab, 0⟩) us wsv 0 (stOf mem pairs th)
      (stOf mem pairs th).vs.vRelSt hm.2.2.1 (MemInv_nodup hm) (Nat.le_refl _) s' hs'
    have htail : ∀ j : Nat, j < nWords us → TailP (stOf mem pairs th) (offs ⟨lab, 0⟩ (0 + j)) := fun j hj => by
      have := OwnOKPF_tail hm.2.1 hsto hown hpfl hus' j hj
      simpa [offs] using this
    obtain ⟨R0, H0, rfl, -, hX⟩ := MemHeldL_focusE hH lab
    have hX' : MemHeldXL (CE η) s' lab H0 Sp := MemHeldXL_store (a := ⟨lab, 0⟩) hX hm.2.2.1 hs'
    have hent : HeldEntry (CE η) s' lab Rv := HeldEntry_ownN hsto (NVP_store hnv hm.2.2.1 hs') (storeOwn_latestP hlen (g2 htail))
      (Or.inl ⟨by rw [hus', List.length_map, hlen], hvalR.store hsn⟩)
    refine ⟨Rr + Rs, Rv + H0, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Rr, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
      MemInv_store hm hsto hown husA hval hlen s' hs', MemHeldK_unfocus hX' hent hnv.2.2, CrKeep_storeN hm hs' hnv⟩, Res.le_def.2 fun k => ?_⟩
    have h1 := hle k
    simp only [Res.add_apply] at h1 ⊢
    omega
  · -- (F2) a cell with a frontier: memory's holding by the mix (`heldMixAt`)
    have hatC : AtOff c.ty (⟨lab, 0⟩ : Address).offset c.ty := .here (Or.inl (by rw [husA]; simp))
    obtain ⟨H2, Sl2, hH2, hHs0, hss⟩ := heldMixAtL (E := CE η) (nI := (CE η).rc) (TEnv.rc_le_ini (CE η) _) (a := ⟨lab, 0⟩) hm hH hsto hpfl hatC
      (IniAt_of_ne fun N e he => hnaC N e he) hnaC
      ((hia x rel a v tok e _ hterm hpk hnw _ pw ⟨lab, 0⟩ hea (by simp [addrOf, hpw]) c hsto).1 _ _ rfl 0 c.ty hatC) hfo.1 hvalR husA hlen hs'
    have hHs := MemHeldK_ofSSet (s0 := stOf mem pairs th) hHs0 hss (Or.inl (Nat.le_refl _))
    refine ⟨Rr + Rs, H2, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Rr, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
      MemInv_store hm hsto hown husA hval hlen s' hs', hHs, CrKeep_storeN hm hs' hnv⟩, Res.le_def.2 fun k => ?_⟩
    have h1 := hle k
    have h2 := hH2 k
    simp only [Res.add_apply] at h1 h2 ⊢
    omega


/-- **(P4) A component store to an own cell, memory's holding** (the
resourceful side of `MemInv_storeAt`): memory holds `H = R0 + H0`, `R0` the
cell's; the component's current words `vq` (its latest) hold `Rq`; after
storing a value holding `Rv` (from any state agreeing with `s` on memory,
promises and coherence), memory holds `R2 + H0`, with `R2 + Rq + H0 = Rv + H`. -/
theorem heldStoreAt {g : G} {E : TEnv} {s : St} {H : Res} {a : Address} {c : Cell} {us : List Acc}
    {ws : List Word} {U : Ty} {Rv : Res} (hm : MemInv g E s) (hH : MemHeld E s H)
    (hsto : E.sto a.label = some c) (hown : c.owner = some E.tid)
    (hnv : NVP E s a.label)
    (hcP : ∃ vals, CellOK E (E.rc a.label) c.ty vals ∧
      ∀ o v, vals[o]? = some v → LatestP s.mem s.promises s.vs.coh ⟨a.label, o⟩ v)
    (hat : AtOff c.ty a.offset U)
    (hini : IniAt E.rc c a U) (hna : ∀ N e, U ≠ .array (.lit N) e)
    (hU : EnvValR E U ws Rv) (hwU : wc U = some (nWords us)) (hlen : ws.length = nWords us) :
    ∃ vq Rq R2 H0, R2 + Rq + H0 = Rv + H ∧ vq.length = nWords us ∧
      (∀ j v, vq[j]? = some v → LatestP s.mem s.promises s.vs.coh (offs a (0 + j)) v) ∧
      VRR (fun _ => 0) (CE E.unsee) U (shp U) vq Rq ∧
      ∀ (k : Promises.Knobs) (arch : Arch) (pw : Word) (rel : Bool) (s1 : St), s1.mem = s.mem →
        s1.promises = s.promises → LoadCoh E s s1 → (∀ b, s.vs.coh b ≤ s1.vs.coh b) →
        SeenLE E s1.vs.vRelSt →
        ∀ s', s' ∈ storeUnits k arch pw a rel us ws 0 s1 → MemHeld E s' (R2 + H0) := by
  obtain ⟨vals, hcell, hlat⟩ := hcP
  obtain ⟨valsm, hW, hP⟩ := own_msgWordsN (E := E) hnv vals hlat
  obtain ⟨R0, H0, rfl, hent0, hX⟩ := MemHeld_focus hH a.label
  have hcR : CellOKR E (E.ini a.label) (E.rc a.label) c.ty valsm R0 :=
    HeldEntry_cell hent0 hsto hcell hW.length.symm (fun o w h => (hP o w h).2)
  rcases own_segR hcR hat (IniAt_mono E.rc_le_ini hini) hna with
    ⟨b, oS, S, wS, Rs, Rr, -, hbo, hatS, hwS, hbw, hR0, ⟨hvs, hVs⟩, hput⟩ | ⟨N0, e0, -, hT0, -, -, hr0, -⟩
  rotate_left
  · rcases hini N0 e0 hT0 with ⟨hUc, -⟩ | ⟨-, j0, -, -, hj0, -, -⟩
    · exact absurd (hUc.trans hT0) (hna N0 e0)
    · have hj1 : j0 < E.rc a.label := hj0
      omega
  have hsl : ((valsm.drop b).take wS).length = wS := by
    simp only [List.length_take, List.length_drop]; omega
  obtain ⟨n, Rq, Rr2, hwn, hle, hRs, hvq, hput2⟩ := VRR_at E.unsee hatS hvs (by rw [hsl]; exact hwS)
  rw [hwU] at hwn
  obtain rfl : nWords us = n := Option.some.inj hwn
  rw [hsl] at hle
  have hlenv : a.offset + nWords us ≤ valsm.length := by
    rw [← hbo, Nat.add_assoc]; exact Nat.le_trans (Nat.add_le_add_left hle b) hbw
  have hvqe : (((valsm.drop b).take wS).drop oS).take (nWords us) = (valsm.drop a.offset).take (nWords us) := by
    rw [take_drop_take hle, drop_drop', hbo]
  rw [hvqe] at hvq
  refine ⟨(valsm.drop a.offset).take (nWords us), Rq, Rv + Rr2 + Rr, H0, ?_, by simp; omega,
    fun j v hj => ?_, hvq, fun k arch pw rel s1 e1 e2 e3 hmono hsn1 s' hs' => ?_⟩
  · subst hR0; subst hRs; exact Res.ext fun k => by simp only [Res.add_apply]; omega
  · have hj' : valsm[a.offset + j]? = some v := by
      by_cases hjn : j < nWords us
      · rw [List.getElem?_take_of_lt hjn, List.getElem?_drop] at hj; exact hj
      · rw [List.getElem?_eq_none (by simp; omega)] at hj; cases hj
    have e : offs a (0 + j) = ⟨a.label, a.offset + j⟩ := by simp [offs]
    rw [e]; exact (hP _ v hj').1
  -- the store
  have hpl1 : PromLt s1 := fun t ht => by
    rw [e1]; rw [e2] at ht; exact hm.2.2.1 t ht
  have hnd1 : s1.promises.Nodup := by rw [e2]; exact hm.2.2.2.2.2.2.2.2.2.2.1
  have e3' : ∀ o, o < vals.length → s1.vs.coh ⟨a.label, o⟩ = s.vs.coh ⟨a.label, o⟩ := by
    obtain ⟨valsB, hcB, hlatB, -⟩ := e3.1 a.label c hsto hown
    have hlB : valsB.length = vals.length := (CellOKR_len hcR hcB).symm.trans hW.length.symm
    intro o ho
    have hA := hlat o (vals[o]'ho) (List.getElem?_eq_getElem ho)
    obtain ⟨⟨m1, hm1, hl1, -⟩, hn1, -⟩ := hlatB o (valsB[o]'(hlB ▸ ho)) (List.getElem?_eq_getElem _)
    rcases Nat.lt_or_ge (s.vs.coh ⟨a.label, o⟩) (s1.vs.coh ⟨a.label, o⟩) with hlt | hge
    · exact absurd (hA.2.2 _ m1 hlt hm1 hl1) hn1
    · exact Nat.le_antisymm hge (hmono _)
  have htail : ∀ j : Nat, j < nWords us → TailP s1 (offs a (0 + j)) := fun j hj => by
    have hlt : a.offset + j < vals.length := by
      have h1 : vals.length = valsm.length := hW.length
      rw [h1]; exact Nat.lt_of_lt_of_le (Nat.add_lt_add_left hj _) hlenv
    have hv := hlat (a.offset + j) (vals[a.offset + j]'hlt) (List.getElem?_eq_getElem hlt)
    have e : offs a (0 + j) = ⟨a.label, a.offset + j⟩ := by simp [offs]
    unfold TailP; rw [e1, e2, e, e3' _ hlt]
    exact fun t m ht hm hl => hv.2.2 t m ht hm hl
  obtain ⟨g2, g3⟩ := storeUnits_latP (a := a) us ws 0 s1 s1.vs.vRelSt hpl1 hnd1 (Nat.le_refl _) s' hs'
  replace g2 := g2 htail
  have hst := hU.store hsn1
  generalize hws' : ws.map (bumpW s1.vs.vRelSt) = ws' at hst
  have hlen' : ws'.length = nWords us := by rw [← hws', List.length_map]; exact hlen
  have hget : ∀ j w, ws[j]? = some w → ws'[j]? = some (bumpW s1.vs.vRelSt w) := fun j w hw => by
    rw [← hws', List.getElem?_map, hw]; rfl
  have hQ := hput2 ws' Rv hst.1 hlen'
  have hQV := (VR_put E.unsee hatS (VRR_VR S (RLink_of (Coh_CE _) (CohR_CE _)) hvs) hVs (by rw [hsl]; exact hwS)
    (VRR_VR U (RLink_of (Coh_CE _) (CohR_CE _)) hst.1) hst.2 (by rw [hlen']; exact hwU)).2.2
  rw [hlen'] at hQV
  have hQl : (((valsm.drop b).take wS).take oS ++ ws' ++ ((valsm.drop b).take wS).drop (oS + nWords us)).length = wS := by
    simp only [List.length_append, List.length_take, List.length_drop, hlen']; omega
  have hcell' := hput _ _ ⟨hQ, hQV⟩ hQl
  have hsp := splice_seg valsm ws' b wS oS (by rw [hlen']; exact hle)
  rw [hlen'] at hsp
  rw [hsp, hbo] at hcell'
  have hlat' : ∀ o v, (valsm.take a.offset ++ ws' ++ valsm.drop (a.offset + nWords us))[o]? = some v →
      LatestP s'.mem s'.promises s'.vs.coh ⟨a.label, o⟩ v := by
    intro o v hov
    rw [splice_get valsm ws' a.offset (nWords us) o hlen' hlenv] at hov
    by_cases hr : a.offset ≤ o ∧ o < a.offset + nWords us
    · rw [iteT hr] at hov
      obtain ⟨hr1, hr2⟩ := hr
      have hj : o - a.offset < ws.length := by rw [hlen]; exact Nat.sub_lt_left_of_lt_add hr1 hr2
      obtain ⟨w, hw⟩ : ∃ w, ws[o - a.offset]? = some w := ⟨ws[o - a.offset], List.getElem?_eq_getElem hj⟩
      rw [hget _ _ hw] at hov
      cases hov
      have := g2 (o - a.offset) w (by rw [← hlen]; exact hj) hw
      have e2 : offs a (0 + (o - a.offset)) = ⟨a.label, o⟩ := by
        simp only [offs, Nat.zero_add]; congr 1; exact Nat.add_sub_of_le hr1
      rw [e2] at this; exact this
    · rw [iteF hr] at hov
      have hold := (hP o v hov).1
      have hov' : o < vals.length := by rw [hW.length]; exact (List.getElem?_eq_some_iff.1 hov).1
      rw [← e1, ← e2] at hold
      replace hold := LatestS_coh_congr (e3' o hov') hold
      refine g3 _ _ (fun j hj e => ?_) hold
      have h' : o = a.offset + j := by simpa [offs] using congrArg WeakMem.Address.offset e
      subst h'
      exact hr ⟨Nat.le_add_right _ _, Nat.add_lt_add_left hj _⟩
  have hent : HeldEntry E s' a.label (Rv + Rr2 + Rr) :=
    HeldEntry_ownN hsto (NVP_store (NVP_eqs hnv e1 e2) hpl1 hs') hlat' hcell'
  have hX1 : MemHeldX E s1 a.label H0 := MemHeldX_tr hX (fun _ _ => rfl) (fun _ _ => rfl)
    (fun l' hne o w hl => by rw [← e1] at hl; rw [PromAt_eqp e2]; exact hl) id
  have hX' : MemHeldX E s' a.label H0 := MemHeldX_store hX1 hpl1 hs'
  exact MemHeld_unfocus hX' hent


/-- (H, pins) `HeldEntry_cell` along the list. -/
theorem HeldEntryL_cell {E E' : TEnv} {s : St} {l : AllocLabel} {c : Cell} {Rs : List Res} {n' : Nat}
    {vals vals1 : List Word} (he : HeldEntryL E s l Rs) (hsto : E.sto l = some c)
    (hc : CellOK E' n' c.ty vals1) (hl : vals.length = vals1.length)
    (hv : ∀ o w, vals[o]? = some w → LatestNP s.mem (PromAt E s ⟨l, o⟩) ⟨l, o⟩ w) :
    CellR E (E.ini l) (E.rc l) c.ty vals Rs := by
  obtain ⟨vals0, hL, hC⟩ := he.2 c hsto
  have hl0 : vals0.length = vals.length := by
    rw [CellOKR_len (CellOKR_iff.2 ⟨Rs, hC, rfl⟩) hc, hl]
  have e0 : vals0 = vals := List.ext_getElem? fun o => by
    cases h0 : vals0[o]? with
    | none =>
        have : vals.length ≤ o := by rw [← hl0]; exact List.getElem?_eq_none_iff.1 h0
        exact (List.getElem?_eq_none_iff.2 this).symm
    | some w0 =>
        obtain ⟨hlt, -⟩ := List.getElem?_eq_some_iff.1 h0
        have hlt' : o < vals.length := hl0 ▸ hlt
        rw [List.getElem?_eq_getElem hlt']
        exact congrArg some (LatestNP_uniq (hL o w0 h0) (hv o _ (List.getElem?_eq_getElem hlt')))
  subst e0; exact hC
#print axioms HeldEntryL_cell

theorem heldStoreAtL {g : G} {E : TEnv} {s : St} {H : Res} {Sl : AllocLabel → List Res} {a : Address} {c : Cell}
    {us : List Acc} {ws : List Word} {U : Ty} {Rv : Res} (hm : MemInv g E s) (hH : MemHeldL E s H Sl)
    (hsto : E.sto a.label = some c) (hown : c.owner = some E.tid)
    (hnv : NVP E s a.label)
    (hcP : ∃ vals, CellOK E (E.rc a.label) c.ty vals ∧
      ∀ o v, vals[o]? = some v → LatestP s.mem s.promises s.vs.coh ⟨a.label, o⟩ v)
    (hat : AtOff c.ty a.offset U)
    (hini : IniAt E.rc c a U) (hna : ∀ N e, U ≠ .array (.lit N) e)
    (hU : EnvValR E U ws Rv) (hwU : wc U = some (nWords us)) (hlen : ws.length = nWords us) :
    ∃ vq Rq R2 H0, R2 + Rq + H0 = Rv + H ∧ vq.length = nWords us ∧
      (∀ j v, vq[j]? = some v → LatestP s.mem s.promises s.vs.coh (offs a (0 + j)) v) ∧
      VRR (fun _ => 0) (CE E.unsee) U (shp U) vq Rq ∧
      ∀ (k : Promises.Knobs) (arch : Arch) (pw : Word) (rel : Bool) (s1 : St), s1.mem = s.mem →
        s1.promises = s.promises → LoadCoh E s s1 → (∀ b, s.vs.coh b ≤ s1.vs.coh b) →
        SeenLE E s1.vs.vRelSt →
        ∀ s', s' ∈ storeUnits k arch pw a rel us ws 0 s1 →
          ∃ Sl', MemHeldL E s' (R2 + H0) Sl' ∧ SSet E E.rc Sl Sl' a.label := by
  obtain ⟨vals, hcell, hlat⟩ := hcP
  obtain ⟨valsm, hW, hP⟩ := own_msgWordsN (E := E) hnv vals hlat
  obtain ⟨H0, rfl, hent0, hX⟩ := MemHeldL_focus hH a.label
  have hcR : CellR E (E.ini a.label) (E.rc a.label) c.ty valsm (Sl a.label) :=
    HeldEntryL_cell hent0 hsto hcell hW.length.symm (fun o w h => (hP o w h).2)
  rcases own_segL (E.rc_le_ini a.label) hcR hat hini hna with
    ⟨b, oS, S, wS, kk, Rs, -, hbo, hatS, hwS, hbw, hkk, ⟨hvs, hVs⟩, hkb, hput⟩ | ⟨N0, e0, -, hT0, -, -, hr0, -⟩
  rotate_left
  · rcases hini N0 e0 hT0 with ⟨hUc, -⟩ | ⟨-, j0, -, -, hj0, -, -⟩
    · exact absurd (hUc.trans hT0) (hna N0 e0)
    · have hj1 : j0 < E.rc a.label := hj0
      omega
  have hsl : ((valsm.drop b).take wS).length = wS := by
    simp only [List.length_take, List.length_drop]; omega
  obtain ⟨n, Rq, Rr2, hwn, hle, hRs, hvq, hput2⟩ := VRR_at E.unsee hatS hvs (by rw [hsl]; exact hwS)
  rw [hwU] at hwn
  obtain rfl : nWords us = n := Option.some.inj hwn
  rw [hsl] at hle
  have hlenv : a.offset + nWords us ≤ valsm.length := by
    rw [← hbo, Nat.add_assoc]; exact Nat.le_trans (Nat.add_le_add_left hle b) hbw
  have hvqe : (((valsm.drop b).take wS).drop oS).take (nWords us) = (valsm.drop a.offset).take (nWords us) := by
    rw [take_drop_take hle, drop_drop', hbo]
  rw [hvqe] at hvq
  have hkl : kk < (Sl a.label).length := (List.getElem?_eq_some_iff.1 hkk).1
  have hkv : (Sl a.label)[kk] = Rs := (List.getElem?_eq_some_iff.1 hkk).2
  refine ⟨(valsm.drop a.offset).take (nWords us), Rq, Rv + Rr2 + Res.sum ((Sl a.label).set kk .zero), H0, ?_,
    by simp; omega, fun j v hj => ?_, hvq, fun k arch pw rel s1 e1 e2 e3 hmono hsn1 s' hs' => ?_⟩
  · rw [Res.sum_set_zero _ kk hkl, hkv]; subst hRs; exact Res.ext fun k => by simp only [Res.add_apply]; omega
  · have hj' : valsm[a.offset + j]? = some v := by
      by_cases hjn : j < nWords us
      · rw [List.getElem?_take_of_lt hjn, List.getElem?_drop] at hj; exact hj
      · rw [List.getElem?_eq_none (by simp; omega)] at hj; cases hj
    have e : offs a (0 + j) = ⟨a.label, a.offset + j⟩ := by simp [offs]
    rw [e]; exact (hP _ v hj').1
  -- the store
  have hpl1 : PromLt s1 := fun t ht => by
    rw [e1]; rw [e2] at ht; exact hm.2.2.1 t ht
  have hnd1 : s1.promises.Nodup := by rw [e2]; exact hm.2.2.2.2.2.2.2.2.2.2.1
  have e3' : ∀ o, o < vals.length → s1.vs.coh ⟨a.label, o⟩ = s.vs.coh ⟨a.label, o⟩ := by
    obtain ⟨valsB, hcB, hlatB, -⟩ := e3.1 a.label c hsto hown
    have hlB : valsB.length = vals.length :=
      (CellOKR_len (CellOKR_iff.2 ⟨_, hcR, rfl⟩) hcB).symm.trans hW.length.symm
    intro o ho
    have hA := hlat o (vals[o]'ho) (List.getElem?_eq_getElem ho)
    obtain ⟨⟨m1, hm1, hl1, -⟩, hn1, -⟩ := hlatB o (valsB[o]'(hlB ▸ ho)) (List.getElem?_eq_getElem _)
    rcases Nat.lt_or_ge (s.vs.coh ⟨a.label, o⟩) (s1.vs.coh ⟨a.label, o⟩) with hlt | hge
    · exact absurd (hA.2.2 _ m1 hlt hm1 hl1) hn1
    · exact Nat.le_antisymm hge (hmono _)
  have htail : ∀ j : Nat, j < nWords us → TailP s1 (offs a (0 + j)) := fun j hj => by
    have hlt : a.offset + j < vals.length := by
      have h1 : vals.length = valsm.length := hW.length
      rw [h1]; exact Nat.lt_of_lt_of_le (Nat.add_lt_add_left hj _) hlenv
    have hv := hlat (a.offset + j) (vals[a.offset + j]'hlt) (List.getElem?_eq_getElem hlt)
    have e : offs a (0 + j) = ⟨a.label, a.offset + j⟩ := by simp [offs]
    unfold TailP; rw [e1, e2, e, e3' _ hlt]
    exact fun t m ht hm hl => hv.2.2 t m ht hm hl
  obtain ⟨g2, g3⟩ := storeUnits_latP (a := a) us ws 0 s1 s1.vs.vRelSt hpl1 hnd1 (Nat.le_refl _) s' hs'
  replace g2 := g2 htail
  have hst := hU.store hsn1
  generalize hws' : ws.map (bumpW s1.vs.vRelSt) = ws' at hst
  have hlen' : ws'.length = nWords us := by rw [← hws', List.length_map]; exact hlen
  have hget : ∀ j w, ws[j]? = some w → ws'[j]? = some (bumpW s1.vs.vRelSt w) := fun j w hw => by
    rw [← hws', List.getElem?_map, hw]; rfl
  have hQ := hput2 ws' Rv hst.1 hlen'
  have hQV := (VR_put E.unsee hatS (VRR_VR S (RLink_of (Coh_CE _) (CohR_CE _)) hvs) hVs (by rw [hsl]; exact hwS)
    (VRR_VR U (RLink_of (Coh_CE _) (CohR_CE _)) hst.1) hst.2 (by rw [hlen']; exact hwU)).2.2
  rw [hlen'] at hQV
  have hQl : (((valsm.drop b).take wS).take oS ++ ws' ++ ((valsm.drop b).take wS).drop (oS + nWords us)).length = wS := by
    simp only [List.length_append, List.length_take, List.length_drop, hlen']; omega
  have hcell' := hput _ _ ⟨hQ, hQV⟩ hQl
  have hsp := splice_seg valsm ws' b wS oS (by rw [hlen']; exact hle)
  rw [hlen'] at hsp
  rw [hsp, hbo] at hcell'
  have hlat' : ∀ o v, (valsm.take a.offset ++ ws' ++ valsm.drop (a.offset + nWords us))[o]? = some v →
      LatestP s'.mem s'.promises s'.vs.coh ⟨a.label, o⟩ v := by
    intro o v hov
    rw [splice_get valsm ws' a.offset (nWords us) o hlen' hlenv] at hov
    by_cases hr : a.offset ≤ o ∧ o < a.offset + nWords us
    · rw [iteT hr] at hov
      obtain ⟨hr1, hr2⟩ := hr
      have hj : o - a.offset < ws.length := by rw [hlen]; exact Nat.sub_lt_left_of_lt_add hr1 hr2
      obtain ⟨w, hw⟩ : ∃ w, ws[o - a.offset]? = some w := ⟨ws[o - a.offset], List.getElem?_eq_getElem hj⟩
      rw [hget _ _ hw] at hov
      cases hov
      have := g2 (o - a.offset) w (by rw [← hlen]; exact hj) hw
      have e2 : offs a (0 + (o - a.offset)) = ⟨a.label, o⟩ := by
        simp only [offs, Nat.zero_add]; congr 1; exact Nat.add_sub_of_le hr1
      rw [e2] at this; exact this
    · rw [iteF hr] at hov
      have hold := (hP o v hov).1
      have hov' : o < vals.length := by rw [hW.length]; exact (List.getElem?_eq_some_iff.1 hov).1
      rw [← e1, ← e2] at hold
      replace hold := LatestS_coh_congr (e3' o hov') hold
      refine g3 _ _ (fun j hj e => ?_) hold
      have h' : o = a.offset + j := by simpa [offs] using congrArg WeakMem.Address.offset e
      subst h'
      exact hr ⟨Nat.le_add_right _ _, Nat.add_lt_add_left hj _⟩
  have hent : HeldEntryL E s' a.label ((Sl a.label).set kk (Rv + Rr2)) :=
    HeldEntryL_ownN hsto (NVP_store (NVP_eqs hnv e1 e2) hpl1 hs') hlat' hcell'
  have hX1 : MemHeldXL E s1 a.label H0 Sl := MemHeldXL_tr hX (fun _ _ => rfl) (fun _ _ => rfl)
    (fun l' hne o w hl => by rw [← e1] at hl; rw [PromAt_eqp e2]; exact hl) id
  have hX' : MemHeldXL E s' a.label H0 Sl := MemHeldXL_store hX1 hpl1 hs'
  have hU' := MemHeldL_unfocus hX' hent
  rw [Res.sum_set _ kk _ hkl] at hU'
  refine ⟨_, hU', fun l' hl' => updS_other Sl _ hl', Or.inr ⟨kk, Rv + Rr2, updS_self _ _ _, fun c1 N e hc1 hT => ?_⟩⟩
  rw [hsto] at hc1; cases hc1
  rcases hini N e hT with ⟨hUc, -⟩ | ⟨us1, -, -, hu1, -⟩
  · exact absurd (hUc.trans hT) (hna N e)
  · exact (hkb N e us1 hT hu1).2
#print axioms heldStoreAtL

/-- (P4) A stored value with its resources, closed at the target type. -/
theorem storeValR {ρ : Nat → Nat} {η : TEnv} {σs : List Ty} {cx c₁ : Cx} {u tv rv : Ty}
    {ws : List Word} {R : Res}
    (hco : Coh η) (hcr : CohR η) (hW : WitL σs η.wit cx.opq) (hK : cx.ke.length ≤ σs.length)
    (hsat : Sat c₁.facts ρ) (hsub : SubS c₁ tv u) (ho : cx.opaqueOK u = true)
    (htb : tb cx.ke.length u = true) (hvr : VRR ρ η tv (shp rv) ws R) (hl : Lay σs tv rv ws)
    (hV : Valid (cl ρ η.wit 0 0 u) ws) : EnvValR (CE η) (cl ρ η.wit 0 0 u) ws R := by
  obtain ⟨hs, -⟩ := Lay_canon hsub hl
  have hsigu : sig (close σs u) = sig (cl ρ η.wit 0 0 u) := sig_WitL hW ρ ho (lt_of_guardT htb hK)
  have hvu : VRR ρ η u (shp (close σs u)) ws R := by rw [← hs]; exact VRR_sub hsat hsub _ _ _ hvr
  refine ⟨?_, hV⟩
  rw [← shp_of_sig hsigu]
  exact (VRR_close hco hcr ρ u [] 0 ρ (fun _ => 0) (shp (close σs u)) ws R (fun k => rfl)
    (fun k hk => absurd hk (Nat.not_lt_zero _))).1 hvu

/-- (P4) A memory value at the closed target type, read back at the static
type in the thread's view. -/
theorem oldValR {ρ : Nat → Nat} {η : TEnv} {u ru : Ty} {ws : List Word} {R : Res}
    (hco : Coh η) (hcr : CohR η) (hsig : sig ru = sig (cl ρ η.wit 0 0 u))
    (h : VRR (fun _ => 0) (CE (CE η).unsee) (cl ρ η.wit 0 0 u) (shp (cl ρ η.wit 0 0 u)) ws R) :
    VRR ρ η u (shp ru) ws R := by
  have h2 : VRR (fun _ => 0) (CE η) (cl ρ η.wit 0 0 u) (shp (cl ρ η.wit 0 0 u)) ws R :=
    VRR_mono _ (CE (CE η).unsee) (CE η) _ _ _ _ (fun _ _ _ _ h => h) (fun _ _ _ _ h => h) rfl rfl rfl
      (fun _ _ h => h) (fun _ => Nat.le_refl _) (fun _ _ h => h) (fun _ h => h.elim) (fun _ _ h => h) h
  rw [← shp_of_sig hsig] at h2
  exact (VRR_close hco hcr ρ u [] 0 ρ (fun _ => 0) (shp ru) ws R (fun k => rfl)
    (fun k hk => absurd hk (Nat.not_lt_zero _))).2 h2

/-- **(P4) `store` at an own locative, with resources**: the stored value's
resources move into the cell; the overwritten component's are dropped. -/
theorem tstepMR_storeLoc {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {rel : Bool} {a v : At} {tok : Option At}
    {u : Ty} {e : Expr} {Rf Rs H : Res}
    (hterm : th.term = .let_ x (.store rel a v tok) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.loc .own u)) (hnw : wordOf (Ty.loc .own u) = none)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hnvp : OwnNVP (CE η) (stOf mem pairs th))
    (hia : StoreIall ρ η cx th)
    (hfo : FpOK (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th,
      ∃ Tot H', ThInvMK p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | storeWordGive hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storeWordKeep hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storeWordHand hp hw => exfalso; rw [hpk] at hp; cases hp; rw [hnw] at hw; cases hw
  | storePub hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeRgn hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeCap hp _ hc => exfalso; rw [hpk] at hp; cases hp; simp [cellOf] at hc
  | storeOwn hp _ hc hwf hu hsub hb =>
  obtain ⟨t, u', tv, c₁, hp, hc, hwf, hu, hsub, hb⟩ : ∃ t u' tv c₁, cx.peek a = .ok t ∧
      cellOf t = some (.own, u') ∧ Ty.wordFreeIn cx.ke u' = true ∧ cx.use v = .ok (tv, c₁) ∧
      SubS c₁ tv u' ∧ c₁.bind x .unit = .ok c' :=
    ⟨_, _, _, _, hp, hc, hwf, hu, hsub, hb⟩
  rw [hpk] at hp; cases hp
  simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc; subst hc
  have hi0 := hi.1
  have hotv : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have ho : cx.opaqueOK u = true := sub_opaqueOK hsub hotv
  have htb : tb cx.ke.length u = true :=
    tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.loc .own u) = some (.own, u))
  obtain ⟨rv, wsv, Rv, Rr, hev, hvv, hlv, hvrv, hi1, hle⟩ := useR hu hi hE.2.2
  have hsat : Sat c₁.facts ρ := hi1.1.1
  have hsigu : sig (close th.σs u) = sig (cl ρ η.wit 0 0 u) :=
    sig_WitL hi0.2.2.2.1 ρ ho (lt_of_guardT htb hi0.2.2.2.2.1)
  have hwcu : wc (cl ρ η.wit 0 0 u) ≠ none := by
    rw [← wc_of_sig hsigu]; exact (Lay_canon hsub hlv).2.2.2.1
  have hna : ∀ n e, cl ρ η.wit 0 0 u ≠ .array (.lit n) e := fun n e h => hwcu (by rw [h]; simp [wc, accs])
  obtain ⟨ad, c, pw, μr, ru, hea, hpw, hsto, hat, hini, hown, hsku, hsig⟩ := locView hi0 hpk htv ho hwcu
  have hnv := hnvp _ _ hsto hown
  obtain ⟨us, hus⟩ : ∃ us, accs ru = some us := by
    have : wc ru ≠ none := by rw [wc_of_sig hsig]; exact hwcu
    cases h : accs ru with
    | none => simp [wc, h] at this
    | some us => exact ⟨us, rfl⟩
  obtain ⟨hval, hlen⟩ := ownStoreVal hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 hsat hsub ho htb hvv hlv hsig hus
  have hwUA : accs (cl ρ η.wit 0 0 u) = some us := (accs_rtW hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 ho htb (peek_cell_lyt hi0.2.1 hpk hea rfl rfl).2).symm.trans hus
  have hwU : wc (cl ρ η.wit 0 0 u) = some (nWords us) := by rw [← wc_of_sig hsig]; simp [wc, hus]
  have hvalR := storeValR hE.2.1 hE.2.2 hi0.2.2.2.1 hi0.2.2.2.2.1 hsat hsub ho htb hvrv hlv hval.2
  have key : tstep g mem pairs th =
      (storeUnits g.k g.arch pw ad rel us wsv 0 (stOf mem pairs th)).map fun s' =>
        (s'.mem, s'.pairs, withS { th with term := e, env := (x, .unit, []) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hev, cellOf, addrOf, hpw, hus, List.map_map]; rfl
  rw [key]
  obtain ⟨s0, hs0⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := pw) (a := ad) (rel := rel)
    us wsv 0 (stOf mem pairs th) hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem hs0), fun r hr => ?_⟩
  rw [List.mem_map] at hr
  obtain ⟨s', hs', rfl⟩ := hr
  have hfr := bindR hb hi1 (RLink_of hE.2.1 hE.2.2) (show VRR ρ η .unit (shp .unit) [] .zero from rfl) (unit_Lay _)
  rw [Res.add_zero] at hfr
  rcases hpfl : (CE η).pfr ad.label with _ | f
  · obtain ⟨-, Rq, R2, H0, hRe, -, -, -, hput0⟩ := heldStoreAtL hm hH hsto hown hnv (OwnOKPF_cellP hm.2.1 hsto hown hpfl) hat hini hna hvalR hwU hlen
    have hput := fun k0 a0 p0 r0 s0 e1 e2 e3 e4 e5 s9 h9 => MemHeldK_ofSSetE (s0 := stOf mem pairs th) (hput0 k0 a0 p0 r0 s0 e1 e2 e3 e4 e5 s9 h9)
    refine ⟨Rr + Rs, R2 + H0, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Rr, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
      MemInv_storeAt hm hsto hown hat hini hna hval hwUA hlen s' hs',
      hput g.k g.arch pw rel _ rfl rfl (LoadCoh_of_eq hm.2.1 rfl) (fun _ => Nat.le_refl _) hm.2.2.2.2.1 s' hs',
      CrKeep_storeN hm hs' hnv⟩, Res.le_def.2 fun k => ?_⟩
    have h1 := hle k
    have h2 := congrArg (fun R : Res => R k) hRe
    simp only [Res.add_apply] at h1 h2 ⊢
    omega
  · -- (F2) a cell with a frontier: memory's holding by the mix (`heldMixAt`)
    obtain ⟨H2, Sl2, hH2, hHs0, hss⟩ := heldMixAtL (E := CE η) (nI := (CE η).rc) (TEnv.rc_le_ini (CE η) _) hm hH hsto hpfl hat hini hna
      ((hia x rel a v tok e _ hterm hpk hnw _ pw ad hea (by simp [addrOf, hpw]) c hsto).2 _ _ _ rfl hat .refl) hfo.1 hvalR hwUA hlen hs'
    have hHs := MemHeldK_ofSSet (s0 := stOf mem pairs th) hHs0 hss (Or.inl (Nat.le_refl _))
    refine ⟨Rr + Rs, H2, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Rr, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
      MemInv_storeAt hm hsto hown hat hini hna hval hwUA hlen s' hs', hHs,
      CrKeep_storeN hm hs' hnv⟩, Res.le_def.2 fun k => ?_⟩
    have h1 := hle k
    have h2 := hH2 k
    simp only [Res.add_apply] at h1 h2 ⊢
    omega

theorem tstepMR_xchgLoc {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {a v : At} {u : Ty} {e : Expr} {Rf Rs H : Res}
    (hterm : th.term = .let_ x (.xchg a v) e) (hP : ProgT p)
    (hpk : cx.peek a = .ok (.loc .own u))
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hnvp : OwnNVP (CE η) (stOf mem pairs th))
    (hRF : OwnFrontierRMW (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      ∃ Tot H', ThInvMK p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | xchg hp hx hu hsub hb =>
  obtain ⟨t, u', o, tv, c₁, hp, hx, hu, hsub, hb⟩ : ∃ t u' o tv c₁, cx.peek a = .ok t ∧
      XchgCell cx t u' o ∧ cx.use v = .ok (tv, c₁) ∧ (SubS c₁ tv u' ∨ SubS c₁ tv o) ∧
      c₁.bind x o = .ok c' := ⟨_, _, _, _, _, hp, hx, hu, hsub, hb⟩
  rw [hpk] at hp; cases hp
  cases hx with
  | rgn _ hc _ _ _ => simp [cellOf] at hc
  | own _ hc _ =>
  simp only [cellOf, Option.some.injEq, Prod.mk.injEq, true_and] at hc; subst hc
  have hi0 := hi.1
  have hsub : SubS c₁ tv u := hsub.elim id id
  have hotv : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have ho : cx.opaqueOK u = true := sub_opaqueOK hsub hotv
  have htb : tb cx.ke.length u = true :=
    tb_cellOf (peek_tb htv hpk) (rfl : cellOf (.loc .own u) = some (.own, u))
  have haf' : (cl ρ η.wit 0 0 u).arrFree = true := arrFree_cl hi0.2.2.2.2.2.2.1.af u 0 0 (bind_arrFree hb)
  have hna : ∀ n e, cl ρ η.wit 0 0 u ≠ .array (.lit n) e := fun n e h => by
    rw [h] at haf'; simp [Ty.arrFree] at haf'
  obtain ⟨rv, wsv, Rv, Rr, hev, hvv, hlv, hvrv, hi1, hle⟩ := useR hu hi hE.2.2
  have hsat : Sat c₁.facts ρ := hi1.1.1
  have hwcu : wc (cl ρ η.wit 0 0 u) ≠ none := by
    rw [← wc_of_sig (sig_WitL hi0.2.2.2.1 ρ ho (lt_of_guardT htb hi0.2.2.2.2.1))]
    exact (Lay_canon hsub hlv).2.2.2.1
  obtain ⟨ad, c, pw, μr, ru, hea, hpw, hsto, hat, hini, hown, hsku, hsig⟩ := locView hi0 hpk htv ho hwcu
  have hnv := hnvp _ _ hsto hown
  obtain ⟨us, hus, ⟨r0, hr0⟩, hld, hstw⟩ := locLoad (arch := g.arch) (pw := pw) (acq := false)
    (s := stOf mem pairs th) hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hsto hown hat hini hna hsku hsig
      (peek_cell_lyt hi0.2.1 hpk hea rfl rfl).2
        (accs_rtW hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 ho htb (peek_cell_lyt hi0.2.1 hpk hea rfl rfl).2)
  obtain ⟨hval, hlen⟩ := ownStoreVal hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 hsat hsub ho htb hvv hlv hsig hus
  have hwUA : accs (cl ρ η.wit 0 0 u) = some us := (accs_rtW hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 ho htb (peek_cell_lyt hi0.2.1 hpk hea rfl rfl).2).symm.trans hus
  have hwU : wc (cl ρ η.wit 0 0 u) = some (nWords us) := by rw [← wc_of_sig hsig]; simp [wc, hus]
  have hvalR := storeValR hE.2.1 hE.2.2 hi0.2.2.2.1 hi0.2.2.2.2.1 hsat hsub ho htb hvrv hlv hval.2
  obtain ⟨vq, Rq, R2, H0, hRe, hvql, hvqlat, hvqR, hput0⟩ := heldStoreAtL hm hH hsto hown hnv (own_cellP hm.2.1 hRF hsto hown) hat hini hna hvalR hwU hlen
  have hput := fun k0 a0 p0 r0 s0 e1 e2 e3 e4 e5 s9 h9 => MemHeldK_ofSSetE (s0 := stOf mem pairs th) (hput0 k0 a0 p0 r0 s0 e1 e2 e3 e4 e5 s9 h9)
  have key : tstep g mem pairs th =
      ((loadUnits g.arch pw ad false us 0 (stOf mem pairs th)).flatMap fun (s1, old) =>
        (storeUnits g.k g.arch pw ad false us wsv 0 s1).map fun s2 => (s2, ru, old)).map
        fun (s', t, ws) => (s'.mem, s'.pairs, withS { th with term := e, env := (x, t, ws) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hev, cellOf, addrOf, hpw, hus]
  rw [key] at ⊢
  have hm1 : ∀ r1, r1 ∈ loadUnits g.arch pw ad false us 0 (stOf mem pairs th) → PromAbove r1.1 → MemInv g (CE η) r1.1 :=
    fun r1 h hp => by
      obtain ⟨_, _, f1, f2, f3, f4, f5⟩ := hld r1 h hp
      exact MemInv_load hm f1 f2 f3 f4 f5 (loadUnits_relSt _ _ _ _ h) (loadUnits_vWr _ _ _ _ h)
  obtain ⟨s2, hs2⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := pw) (a := ad) (rel := false)
    us wsv 0 r0.1 hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem (List.mem_flatMap.2 ⟨r0, hr0, List.mem_map_of_mem hs2⟩)),
    fun r hr hpr0 => ?_⟩
  have hpr := hpr0
  rw [List.mem_map] at hr
  obtain ⟨⟨s', t', ws'⟩, hr, rfl⟩ := hr
  rw [List.mem_flatMap] at hr
  obtain ⟨⟨s1, old⟩, h1, h2⟩ := hr
  rw [List.mem_map] at h2
  obtain ⟨s2, hs2, he2⟩ := h2
  simp only [Prod.mk.injEq] at he2
  obtain ⟨rfl, rfl, rfl⟩ := he2
  have hp1 : PromAbove s1 := storeUnits_promAbove hs2 (fun t ht m hm => hpr t ht m hm)
  obtain ⟨-, hlay, f1, -, fc, f3, -⟩ := hld (s1, old) h1 hp1
  have hWold : WLe vq old := (loadUnits_latestPA hvql hvqlat h1 hp1).1
  have hvold := oldValR hE.2.1 hE.2.2 hsig (VRR_up _ _ _ _ _ hWold hvqR)
  have hm1' := hm1 (s1, old) h1 hp1
  have hfr := bindR hb hi1 (RLink_of hE.2.1 hE.2.2) hvold hlay
  refine ⟨Rr + Rq + Rs, R2 + H0, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Rr + Rq, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
    MemInv_storeAt hm1' hsto hown hat hini hna hval hwUA hlen s2 hs2,
    hput g.k g.arch pw false s1 f1 f3 fc (loadUnits_cohMono _ 0 _ _ h1) hm1'.2.2.2.2.1 s2 hs2,
    CrKeep_trans (CrKeep_eqs f1 f3) (CrKeep_storeN hm1' hs2 (NVP_eqs hnv f1 f3))⟩, Res.le_def.2 fun k => ?_⟩
  have h1 := hle k
  have h2 := congrArg (fun R : Res => R k) hRe
  simp only [Res.add_apply] at h1 h2 ⊢
  omega

/-- **(P4) `xchgAt` (a slot of an own buffer), with resources**: the slot's
old value comes out with its resources; the new value's go into the slot. -/
theorem tstepMR_xchgAt {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {b i v : At} {e : Expr} {Rf Rs H : Res}
    (hterm : th.term = .let_ x (.xchgAt b i v) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hnvp : OwnNVP (CE η) (stOf mem pairs th))
    (hRF : OwnFrontierRMW (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      ∃ Tot H', ThInvMK p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | xchgAt hp hbuf _ hint hlt hltk hu hsub hb =>
  obtain ⟨t, u, n, k, j, tv, c₁, hp, hbuf, hint, hlt, hltk, hu, hsub, hb⟩ : ∃ t u n k j tv c₁,
      cx.peek b = .ok t ∧ bufOf t = some (.own, n, u, k) ∧ IntIdx cx i j ∧ LtI cx j n ∧ LtI cx j k ∧
      cx.use v = .ok (tv, c₁) ∧ SubS c₁ tv u ∧ c₁.bind x u = .ok c' :=
    ⟨_, _, _, _, _, _, _, hp, hbuf, hint, hlt, hltk, hu, hsub, hb⟩
  have hi0 := hi.1
  have hotv : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have ho : cx.opaqueOK u = true := sub_opaqueOK hsub hotv
  obtain ⟨rt, w, ad, c, μr, ur, us, rti, wi, hea, hwv, hei, hj, hbe, hus, hsto, hat, hown, hini, hsku, hsig, htb, -⟩ :=
    slot_view hi0.1 hi0.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 htv hp hbuf hint hlt hltk ho
  have hnv := hnvp _ _ hsto hown
  have haf' : (cl ρ η.wit 0 0 u).arrFree = true := arrFree_cl hi0.2.2.2.2.2.2.1.af u 0 0 (bind_arrFree hb)
  have hna : ∀ N e', cl ρ η.wit 0 0 u ≠ .array (.lit N) e' := fun N e' h => by
    rw [h] at haf'; simp [Ty.arrFree] at haf'
  obtain ⟨rv, wsv, Rv, Rr, hev, hvv, hlv, hvrv, hi1, hle⟩ := useR hu hi hE.2.2
  have hsat : Sat c₁.facts ρ := hi1.1.1
  obtain ⟨us', hus', ⟨r0, hr0⟩, hld, hstw⟩ := locLoad (ad := offs ad (ev ρ j * nWords us)) (arch := g.arch) (pw := w) (acq := false)
    (s := stOf mem pairs th) hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hsto hown hat hini hna hsku hsig
      (peek_buf_lyt hi0.2.1 hp hbuf hea hbe).2
        (accs_rtW hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 ho htb (peek_buf_lyt hi0.2.1 hp hbuf hea hbe).2)
  rw [hus] at hus'; cases hus'
  obtain ⟨hval, hlen⟩ := ownStoreVal hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 hsat hsub ho htb hvv hlv hsig hus
  have hwUA : accs (cl ρ η.wit 0 0 u) = some us := (accs_rtW hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 ho htb (peek_buf_lyt hi0.2.1 hp hbuf hea hbe).2).symm.trans hus
  have hwU : wc (cl ρ η.wit 0 0 u) = some (nWords us) := by rw [← wc_of_sig hsig]; simp [wc, hus]
  have hvalR := storeValR hE.2.1 hE.2.2 hi0.2.2.2.1 hi0.2.2.2.2.1 hsat hsub ho htb hvrv hlv hval.2
  obtain ⟨vq, Rq, R2, H0, hRe, hvql, hvqlat, hvqR, hput0⟩ := heldStoreAtL (a := offs ad (ev ρ j * nWords us)) hm hH hsto hown hnv (own_cellP hm.2.1 hRF hsto hown) hat hini hna hvalR hwU hlen
  have hput := fun k0 a0 p0 r0 s0 e1 e2 e3 e4 e5 s9 h9 => MemHeldK_ofSSetE (s0 := stOf mem pairs th) (hput0 k0 a0 p0 r0 s0 e1 e2 e3 e4 e5 s9 h9)
  have key : tstep g mem pairs th =
      ((loadUnits g.arch w (offs ad (ev ρ j * nWords us)) false us 0 (stOf mem pairs th)).flatMap fun (s1, old) =>
        (storeUnits g.k g.arch w (offs ad (ev ρ j * nWords us)) false us wsv 0 s1).map fun s2 => (s2, ur, old)).map
        fun (s', t, ws) => (s'.mem, s'.pairs, withS { th with term := e, env := (x, t, ws) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hei, hev, hj, addrOf, hwv, hbe, hus]
  rw [key] at ⊢
  have hm1 : ∀ r1, r1 ∈ loadUnits g.arch w (offs ad (ev ρ j * nWords us)) false us 0 (stOf mem pairs th) →
      PromAbove r1.1 → MemInv g (CE η) r1.1 := fun r1 h hp => by
    obtain ⟨_, _, f1, f2, f3, f4, f5⟩ := hld r1 h hp
    exact MemInv_load hm f1 f2 f3 f4 f5 (loadUnits_relSt _ _ _ _ h) (loadUnits_vWr _ _ _ _ h)
  obtain ⟨s2, hs2⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := w)
    (a := (offs ad (ev ρ j * nWords us))) (rel := false) us wsv 0 r0.1 hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem (List.mem_flatMap.2 ⟨r0, hr0, List.mem_map_of_mem hs2⟩)),
    fun r hr hpr0 => ?_⟩
  have hpr := hpr0
  rw [List.mem_map] at hr
  obtain ⟨⟨s', t', ws'⟩, hr, rfl⟩ := hr
  rw [List.mem_flatMap] at hr
  obtain ⟨⟨s1, old⟩, h1, h2⟩ := hr
  rw [List.mem_map] at h2
  obtain ⟨s2, hs2, he2⟩ := h2
  simp only [Prod.mk.injEq] at he2
  obtain ⟨rfl, rfl, rfl⟩ := he2
  have hp1 : PromAbove s1 := storeUnits_promAbove hs2 (fun t ht m hm => hpr t ht m hm)
  obtain ⟨-, hlay, f1, -, fc, f3, -⟩ := hld (s1, old) h1 hp1
  have hWold : WLe vq old := (loadUnits_latestPA hvql hvqlat h1 hp1).1
  have hvold := oldValR hE.2.1 hE.2.2 hsig (VRR_up _ _ _ _ _ hWold hvqR)
  have hm1' := hm1 (s1, old) h1 hp1
  have hfr := bindR hb hi1 (RLink_of hE.2.1 hE.2.2) hvold hlay
  refine ⟨Rr + Rq + Rs, R2 + H0, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Rr + Rq, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
    MemInv_storeAt (a := (offs ad (ev ρ j * nWords us))) hm1' hsto hown hat hini hna hval hwUA hlen s2 hs2,
    hput g.k g.arch w false s1 f1 f3 fc (loadUnits_cohMono _ 0 _ _ h1) hm1'.2.2.2.2.1 s2 hs2,
    CrKeep_trans (CrKeep_eqs f1 f3) (CrKeep_storeN hm1' hs2 (NVP_eqs hnv f1 f3))⟩, Res.le_def.2 fun k => ?_⟩
  have h1 := hle k
  have h2 := congrArg (fun R : Res => R k) hRe
  simp only [Res.add_apply] at h1 h2 ⊢
  omega

/-- **(P4) `xchgAtF` (a field of a slot of an own buffer), with resources**. -/
theorem tstepMR_xchgAtF {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {b i v : At} {q : List Nat} {e : Expr} {Rf Rs H : Res}
    (hterm : th.term = .let_ x (.xchgAtF b i q v) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hnvp : OwnNVP (CE η) (stOf mem pairs th))
    (hRF : OwnFrontierRMW (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      ∃ Tot H', ThInvMK p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | xchgAtF hp hbuf hct hop _ hint hlt hltk hu hsub hb =>
  obtain ⟨t, u, c, n, k, j, tv, c₁, hp, hbuf, hct, hop, hint, hlt, hltk, hu, hsub, hb⟩ : ∃ t u c n k j tv c₁,
      cx.peek b = .ok t ∧ bufOf t = some (.own, n, u, k) ∧ compTy u q = some c ∧ cx.opaqueOK u = true ∧
      IntIdx cx i j ∧ LtI cx j n ∧ LtI cx j k ∧
      cx.use v = .ok (tv, c₁) ∧ SubS c₁ tv c ∧ c₁.bind x c = .ok c' :=
    ⟨_, _, _, _, _, _, _, _, hp, hbuf, hct, hop, hint, hlt, hltk, hu, hsub, hb⟩
  have hi0 := hi.1
  have hotv : cx.opaqueOK tv = true :=
    peek_opaqueOK htv (use_inv (ρ := ρ) (η := η) (σs := th.σs) (env := th.env) hu).1
  have ho : cx.opaqueOK c = true := sub_opaqueOK hsub hotv
  obtain ⟨rt, w, ad, cc, μr, ur, us, rti, wi, hea, hwv, hei, hj, hbe, hus, hsto, hat, hown, -, hsku, hsig, htbu, hiniF⟩ :=
    slot_view hi0.1 hi0.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 htv hp hbuf hint hlt hltk hop
  have hnv := hnvp _ _ hsto hown
  have htb : tb cx.ke.length c = true := tb_compTy q u c hct htbu
  obtain ⟨cR, o, hco, hskc, hsgc, -, hato⟩ := compOff_rt q u c ur us hct hsku hsig hus
  have haf' : (cl ρ η.wit 0 0 c).arrFree = true := arrFree_cl hi0.2.2.2.2.2.2.1.af c 0 0 (bind_arrFree hb)
  have hna : ∀ N e', cl ρ η.wit 0 0 c ≠ .array (.lit N) e' := fun N e' h => by
    rw [h] at haf'; simp [Ty.arrFree] at haf'
  have hat' : AtOff cc.ty (offs ad (ev ρ j * nWords us + o)).offset (cl ρ η.wit 0 0 c) := by
    have h2 := AtOff_trans hat hato
    simpa [offs, Nat.add_assoc] using h2
  have hiniC := hiniF o _ hato
  obtain ⟨rv, wsv, Rv, Rr, hev, hvv, hlv, hvrv, hi1, hle⟩ := useR hu hi hE.2.2
  have hsat : Sat c₁.facts ρ := hi1.1.1
  obtain ⟨cs, hcs, ⟨r0, hr0⟩, hld, hstw⟩ := locLoad (ad := offs ad (ev ρ j * nWords us + o)) (arch := g.arch) (pw := w)
    (acq := false) (s := stOf mem pairs th) hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hsto hown hat' hiniC hna hskc hsgc
      (compOff_lyt q u c ur cR o hct hsku (peek_buf_lyt hi0.2.1 hp hbuf hea hbe).2 hco)
        (accs_rtW hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 ho htb (compOff_lyt q u c ur cR o hct hsku (peek_buf_lyt hi0.2.1 hp hbuf hea hbe).2 hco))
  obtain ⟨hval, hlen⟩ := ownStoreVal hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 hsat hsub ho htb hvv hlv hsgc hcs
  have hwUA : accs (cl ρ η.wit 0 0 c) = some cs := (accs_rtW hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 ho htb (compOff_lyt q u c ur cR o hct hsku (peek_buf_lyt hi0.2.1 hp hbuf hea hbe).2 hco)).symm.trans hcs
  have hwU : wc (cl ρ η.wit 0 0 c) = some (nWords cs) := by rw [← wc_of_sig hsgc]; simp [wc, hcs]
  have hvalR := storeValR hE.2.1 hE.2.2 hi0.2.2.2.1 hi0.2.2.2.2.1 hsat hsub ho htb hvrv hlv hval.2
  obtain ⟨vq, Rq, R2, H0, hRe, hvql, hvqlat, hvqR, hput0⟩ :=
    heldStoreAtL (a := offs ad (ev ρ j * nWords us + o)) hm hH hsto hown hnv (own_cellP hm.2.1 hRF hsto hown) hat' hiniC hna hvalR hwU hlen
  have hput := fun k0 a0 p0 r0 s0 e1 e2 e3 e4 e5 s9 h9 => MemHeldK_ofSSetE (s0 := stOf mem pairs th) (hput0 k0 a0 p0 r0 s0 e1 e2 e3 e4 e5 s9 h9)
  have key : tstep g mem pairs th =
      ((loadUnits g.arch w (offs ad (ev ρ j * nWords us + o)) false cs 0 (stOf mem pairs th)).flatMap fun (s1, old) =>
        (storeUnits g.k g.arch w (offs ad (ev ρ j * nWords us + o)) false cs wsv 0 s1).map fun s2 => (s2, cR, old)).map
        fun (s', t, ws) => (s'.mem, s'.pairs, withS { th with term := e, env := (x, t, ws) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hei, hev, hj, addrOf, hwv, hbe, hus, hco, hcs]
  rw [key] at ⊢
  have hm1 : ∀ r1, r1 ∈ loadUnits g.arch w (offs ad (ev ρ j * nWords us + o)) false cs 0 (stOf mem pairs th) →
      PromAbove r1.1 → MemInv g (CE η) r1.1 := fun r1 h hp => by
    obtain ⟨_, _, f1, f2, f3, f4, f5⟩ := hld r1 h hp
    exact MemInv_load hm f1 f2 f3 f4 f5 (loadUnits_relSt _ _ _ _ h) (loadUnits_vWr _ _ _ _ h)
  obtain ⟨s2, hs2⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := w)
    (a := (offs ad (ev ρ j * nWords us + o))) (rel := false) cs wsv 0 r0.1 hlen
  refine ⟨List.ne_nil_of_mem (List.mem_map_of_mem (List.mem_flatMap.2 ⟨r0, hr0, List.mem_map_of_mem hs2⟩)),
    fun r hr hpr0 => ?_⟩
  have hpr := hpr0
  rw [List.mem_map] at hr
  obtain ⟨⟨s', t', ws'⟩, hr, rfl⟩ := hr
  rw [List.mem_flatMap] at hr
  obtain ⟨⟨s1, old⟩, h1, h2⟩ := hr
  rw [List.mem_map] at h2
  obtain ⟨s2, hs2, he2⟩ := h2
  simp only [Prod.mk.injEq] at he2
  obtain ⟨rfl, rfl, rfl⟩ := he2
  have hp1 : PromAbove s1 := storeUnits_promAbove hs2 (fun t ht m hm => hpr t ht m hm)
  obtain ⟨-, hlay, f1, -, fc, f3, -⟩ := hld (s1, old) h1 hp1
  have hWold : WLe vq old := (loadUnits_latestPA hvql hvqlat h1 hp1).1
  have hvold := oldValR hE.2.1 hE.2.2 hsgc (VRR_up _ _ _ _ _ hWold hvqR)
  have hm1' := hm1 (s1, old) h1 hp1
  have hfr := bindR hb hi1 (RLink_of hE.2.1 hE.2.2) hvold hlay
  refine ⟨Rr + Rq + Rs, R2 + H0, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Rr + Rq, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
    MemInv_storeAt (a := (offs ad (ev ρ j * nWords us + o))) hm1' hsto hown hat' hiniC hna hval hwUA hlen s2 hs2,
    hput g.k g.arch w false s1 f1 f3 fc (loadUnits_cohMono _ 0 _ _ h1) hm1'.2.2.2.2.1 s2 hs2,
    CrKeep_trans (CrKeep_eqs f1 f3) (CrKeep_storeN hm1' hs2 (NVP_eqs hnv f1 f3))⟩, Res.le_def.2 fun k => ?_⟩
  have h1 := hle k
  have h2 := congrArg (fun R : Res => R k) hRe
  simp only [Res.add_apply] at h1 h2 ⊢
  omega

/-- (P4) A `lanes` word holds nothing. -/
theorem lanes_EnvValR {η : TEnv} {ρ : Nat → Nat} (sg : Bool) (w : Wd) (z : Nat) :
    EnvValR (CE η) (cl ρ η.wit 0 0 (.lanes sg w)) [cst (.num z)] .zero := by
  simp only [cl]
  exact ⟨by simp only [VRR, shp]; exact ⟨⟨trivial, z, rfl⟩, trivial⟩, trivial⟩

/-- **(P4) `stlw`, with resources**: the frame is unchanged (`v` is peeked,
a `fix` word); the lane word holds nothing, so memory holds at most what it
held. -/
theorem tstepMR_stlw {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {b wi jl v : At} {e : Expr} {Rf Rs H : Res}
    (hterm : th.term = .let_ x (.stlw b wi jl v) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hpx : PAx g mem pairs th)
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hnvp : OwnNVP (CE η) (stOf mem pairs th))
    (hRF : OwnFrontierRMW (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      ∃ Tot H', ThInvMK p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | stlw hp hbuf hlo hint hlt hltk hpj hij hpv hfx hb =>
  obtain ⟨t, u, n, k, jw, tj, tv, q, hp, hbuf, hlo, hint, hlt, hltk, hpj, hij, hpv, hfx, hb⟩ :
      ∃ t u n k jw tj tv q,
      cx.peek b = .ok t ∧ bufOf t = some (.own, n, u, k) ∧ lanesOf u = some q ∧ IntIdx cx wi jw ∧
      LtI cx jw n ∧ LtI cx jw k ∧ cx.peek jl = .ok tj ∧ (intOf tj).isSome = true ∧
      cx.peek v = .ok tv ∧ fixOf tv = some q ∧ cx.bind x .unit = .ok c' :=
    ⟨_, _, _, _, _, _, _, _, hp, hbuf, hlo, hint, hlt, hltk, hpj, hij, hpv, hfx, hb⟩
  have hi0 := hi.1
  obtain ⟨sg, w⟩ := q
  have hu := lanes_of hlo
  have htv0 := fix_of hfx
  simp only at hu htv0
  subst hu htv0
  have ho : cx.opaqueOK (.lanes sg w) = true := by simp [Cx.opaqueOK, Ty.guardT]
  obtain ⟨ti, hpi, hti⟩ := hint
  obtain ⟨rti, wwi, hei, hwi, -⟩ := atom_num hi0.2.1 hpi hti
  obtain ⟨oj, hoj⟩ := Option.isSome_iff_exists.1 hij
  obtain ⟨rtj, wj, m, hej, hwj⟩ := atom_int hi0.2.1 hpj hoj
  obtain ⟨rv, wsv, hev, hvv, -⟩ := peek_VR hi0.2.1 hpv
  simp only [VR] at hvv
  obtain ⟨-, yv, hyv, -⟩ := hvv
  obtain ⟨wv, rfl, hwv'⟩ := map_singleton hyv
  have hJ := hlt ρ hi0.1
  have hJk := hltk ρ hi0.1
  obtain ⟨rt, pw, ad, c, μr, ur, us, hea, hwv, hbe, hus, hsto, hat, hmode, hini, hsku, hsig⟩ :=
    slot_viewN (ev ρ jw) hi0.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 htv hp hbuf hJ hJk ho
  have hnvP := hnvp _ _ hsto hmode
  obtain ⟨rfl, rfl⟩ := lane_rt hsku hus
  have e1 : ev ρ jw * nWords [Acc.one] = ev ρ jw := by simp [nWords, Acc.size]
  rw [e1] at hat hini
  have hna : ∀ N e', cl ρ η.wit 0 0 (.lanes sg w) ≠ .array (.lit N) e' := fun N e' h => by simp [cl] at h
  obtain ⟨us', hus', ⟨r0, hr0⟩, hld, hstw⟩ := locLoad (ad := offs ad (ev ρ jw)) (arch := g.arch) (pw := pw) (acq := false)
    (s := stOf mem pairs th) hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hsto hmode hat hini hna hsku hsig
      (peek_buf_lyt hi0.2.1 hp hbuf hea hbe).2
        (accs_rtW hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 ho (by simp [tb]) (peek_buf_lyt hi0.2.1 hp hbuf hea hbe).2)
  simp [accs] at hus'; subst hus'
  have hni : numOf [wwi] = some (ev ρ jw) := by simp [numOf, hwi]
  have hnj : numOf [wj] = some m := by simp [numOf, hwj]
  have hnv : numOf [wv] = some yv := by simp [numOf, hwv']
  have hnum : ∀ r1, r1 ∈ loadUnits g.arch pw (offs ad (ev ρ jw)) false [.one] 0 (stOf mem pairs th) →
      PromAbove r1.1 → ∃ y, numOf r1.2 = some y := fun r1 h hp => by
    obtain ⟨hvr, -⟩ := hld r1 h hp
    simp only [VR] at hvr
    obtain ⟨-, y, hy⟩ := hvr
    obtain ⟨w0, h0, hw0⟩ := map_singleton hy
    exact ⟨y, by rw [h0]; simp [numOf, hw0]⟩
  have hm1 : ∀ r1, r1 ∈ loadUnits g.arch pw (offs ad (ev ρ jw)) false [.one] 0 (stOf mem pairs th) →
      PromAbove r1.1 → MemInv g (CE η) r1.1 := fun r1 h hp => by
    obtain ⟨_, _, f1, f2, f3, f4, f5⟩ := hld r1 h hp
    exact MemInv_load hm f1 f2 f3 f4 f5 (loadUnits_relSt _ _ _ _ h) (loadUnits_vWr _ _ _ _ h)
  have hwUA : accs (cl ρ η.wit 0 0 (.lanes sg w)) = some [Acc.one] := by simp [cl, accs]
  have hwU : wc (cl ρ η.wit 0 0 (.lanes sg w)) = some (nWords [Acc.one]) := by simp [cl, wc, accs]
  have key : tstep g mem pairs th =
      ((loadUnits g.arch pw (offs ad (ev ρ jw)) false [.one] 0 (stOf mem pairs th)).flatMap fun (s1, old) =>
        match numOf old with
        | some y => (storeUnits g.k g.arch pw (offs ad (ev ρ jw)) false [.one]
            [cst (.num (setLaneN w y (m % w.lanes) yv))] 0 s1).map fun s2 => (s2, Ty.unit, ([] : List Word))
        | none => []).map
        fun (s', t, ws) => (s'.mem, s'.pairs, withS { th with term := e, env := (x, t, ws) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hei, hej, hev, hni, hnj, hnv, addrOf, hwv, hbe, lanesOf]
    rfl
  unfold PAx at hpx
  rw [key] at hpx ⊢
  refine ⟨?_, fun r hr hpr0 => ?_⟩
  · rcases hpx with h0 | ⟨r, hr, -⟩
    rotate_left
    · exact List.ne_nil_of_mem hr
    obtain ⟨y0, hy0⟩ := hnum r0 hr0 (PromAbove_nil (by rw [(loadUnits_frame _ _ _ r0 hr0).2.2.1]; exact h0))
    obtain ⟨s2, hs2⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := pw)
      (a := offs ad (ev ρ jw)) (rel := false) [.one] [cst (.num (setLaneN w y0 (m % w.lanes) yv))] 0 r0.1
      (by simp [nWords, Acc.size])
    refine List.ne_nil_of_mem (List.mem_map_of_mem (List.mem_flatMap.2 ⟨r0, hr0, (?_ : (s2, Ty.unit, ([] : List Word)) ∈ _)⟩))
    obtain ⟨s0, o0⟩ := r0; simp only at hy0 hs2 ⊢; rw [hy0]; exact List.mem_map_of_mem hs2
  have hpr := hpr0
  rw [List.mem_map] at hr
  obtain ⟨⟨s', t', ws'⟩, hr, rfl⟩ := hr
  rw [List.mem_flatMap] at hr
  obtain ⟨⟨s1, old⟩, h1, h2⟩ := hr
  simp only at h2
  obtain ⟨y, hy⟩ : ∃ y, numOf old = some y := by
    cases hn : numOf old with
    | none => simp [hn] at h2
    | some y => exact ⟨y, rfl⟩
  rw [hy, List.mem_map] at h2
  obtain ⟨s2, hs2, he2⟩ := h2
  simp only [Prod.mk.injEq] at he2
  obtain ⟨rfl, rfl, rfl⟩ := he2
  have hp1 : PromAbove s1 := storeUnits_promAbove hs2 (fun t ht m hm => hpr t ht m hm)
  obtain ⟨-, -, f1, -, fc, f3, -⟩ := hld (s1, old) h1 hp1
  have hm1' := hm1 (s1, old) h1 hp1
  obtain ⟨-, Rq, R2, H0, hRe, -, -, -, hput0⟩ := heldStoreAtL (a := offs ad (ev ρ jw)) hm hH hsto hmode hnvP (own_cellP hm.2.1 hRF hsto hmode) hat hini hna
    (lanes_EnvValR sg w (setLaneN w y (m % w.lanes) yv)) hwU (by simp [nWords, Acc.size])
  have hput := fun k0 a0 p0 r0 s0 e1 e2 e3 e4 e5 s9 h9 => MemHeldK_ofSSetE (s0 := stOf mem pairs th) (hput0 k0 a0 p0 r0 s0 e1 e2 e3 e4 e5 s9 h9)
  have hfr := bindR hb hi (RLink_of hE.2.1 hE.2.2) (show VRR ρ η .unit (shp .unit) [] .zero from rfl) (unit_Lay _)
  rw [Res.add_zero] at hfr
  refine ⟨Rf + Rs, R2 + H0, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Rf, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
    MemInv_storeAt (a := offs ad (ev ρ jw)) hm1' hsto hmode hat hini hna
      (lanes_EnvVal sg w _) hwUA (by simp [nWords, Acc.size]) s2 hs2,
    hput g.k g.arch pw false s1 f1 f3 fc (loadUnits_cohMono _ 0 _ _ h1) hm1'.2.2.2.2.1 s2 hs2,
    CrKeep_trans (CrKeep_eqs f1 f3) (CrKeep_storeN hm1' hs2 (NVP_eqs hnvP f1 f3))⟩, Res.le_def.2 fun k => ?_⟩
  have h2 := congrArg (fun R : Res => R k) hRe
  simp only [Res.add_apply, Res.zero_apply] at h2 ⊢
  omega

/-- **(P4) `stl`, with resources**: `stlw` at word `j / lanes`. -/
theorem tstepMR_stl {Sp : AllocLabel → List Res} {p : Prog} {g : G} {mem : Memory} {pairs : List Ts} {th : TTh}
    {cx : Cx} {ρ : Nat → Nat} {η : TEnv} {x : String} {b i v : At} {e : Expr} {Rf Rs H : Res}
    (hterm : th.term = .let_ x (.stl b i v) e) (hP : ProgT p)
    (hT : Typed p cx th.term) (hCk : TermA4.CkW p η.wit cx th.term) (hi : FInvR ρ η th.σs (ResumeR p th.stack Rs) cx th.env Rf)
    (hE : EnvOK p η) (htv : TvOK cx) (hm : MemInv g (CE η) (stOf mem pairs th))
    (hpx : PAx g mem pairs th)
    (hH : MemHeldL (CE η) (stOf mem pairs th) H Sp) (hnvp : OwnNVP (CE η) (stOf mem pairs th))
    (hRF : OwnFrontierRMW (CE η) (stOf mem pairs th)) (hRP : RetPw th.σs th.stack cx.ret) (hPS : PwSkel) :
    tstep g mem pairs th ≠ [] ∧ ∀ r ∈ tstep g mem pairs th, PromAbove (stOf r.1 r.2.1 r.2.2) →
      ∃ Tot H', ThInvMK p g (CE η) (stOf mem pairs th) Sp r.1 r.2.1 r.2.2 Tot H' ∧ Tot + H' ≤ Rf + Rs + H := by
  rw [hterm] at hT hCk
  cases hT with
  | let_ hop he =>
  rename_i c'
  obtain ⟨c', -, hop, he, hck, -⟩ := TermA4.CkW_let hCk
  have htv' := OpT_TvOK hP hop htv
  have hRk := OpT_retSk hop
  cases hop with
  | stl hp hbuf hlo hint hlt hltk hpv hfx hb =>
  obtain ⟨t, u, n, k, j, tv, q, hp, hbuf, hlo, hint, hlt, hltk, hpv, hfx, hb⟩ : ∃ t u n k j tv q,
      cx.peek b = .ok t ∧ bufOf t = some (.own, n, u, k) ∧ lanesOf u = some q ∧ IntIdx cx i j ∧
      LtI cx j (.smul q.2.lanes n) ∧ LtI cx j (.smul q.2.lanes k) ∧
      cx.peek v = .ok tv ∧ fixOf tv = some q ∧ cx.bind x .unit = .ok c' :=
    ⟨_, _, _, _, _, _, _, hp, hbuf, hlo, hint, hlt, hltk, hpv, hfx, hb⟩
  have hi0 := hi.1
  obtain ⟨sg, w⟩ := q
  have hu := lanes_of hlo
  have htv0 := fix_of hfx
  simp only at hu htv0 hlt hltk
  subst hu htv0
  have ho : cx.opaqueOK (.lanes sg w) = true := by simp [Cx.opaqueOK, Ty.guardT]
  obtain ⟨ti, hpi, hti⟩ := hint
  obtain ⟨rti, wwi, hei, hwi, -⟩ := atom_num hi0.2.1 hpi hti
  obtain ⟨rv, wsv, hev, hvv, -⟩ := peek_VR hi0.2.1 hpv
  simp only [VR] at hvv
  obtain ⟨-, yv, hyv, -⟩ := hvv
  obtain ⟨wv, rfl, hwv'⟩ := map_singleton hyv
  have hJ0 : ev ρ j < w.lanes * ev ρ n := by simpa [ev] using hlt ρ hi0.1
  have hJk0 : ev ρ j < w.lanes * ev ρ k := by simpa [ev] using hltk ρ hi0.1
  have hJ : ev ρ j / w.lanes < ev ρ n :=
    (Nat.div_lt_iff_lt_mul (Wd.lanes_pos w)).2 (by rw [Nat.mul_comm]; exact hJ0)
  have hJk : ev ρ j / w.lanes < ev ρ k :=
    (Nat.div_lt_iff_lt_mul (Wd.lanes_pos w)).2 (by rw [Nat.mul_comm]; exact hJk0)
  obtain ⟨rt, pw, ad, c, μr, ur, us, hea, hwv, hbe, hus, hsto, hat, hmode, hini, hsku, hsig⟩ :=
    slot_viewN (ev ρ j / w.lanes) hi0.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 htv hp hbuf hJ hJk ho
  have hnvP := hnvp _ _ hsto hmode
  obtain ⟨rfl, rfl⟩ := lane_rt hsku hus
  have e1 : ev ρ j / w.lanes * nWords [Acc.one] = ev ρ j / w.lanes := by simp [nWords, Acc.size]
  rw [e1] at hat hini
  have hna : ∀ N e', cl ρ η.wit 0 0 (.lanes sg w) ≠ .array (.lit N) e' := fun N e' h => by simp [cl] at h
  obtain ⟨us', hus', ⟨r0, hr0⟩, hld, hstw⟩ := locLoad (ad := offs ad (ev ρ j / w.lanes)) (arch := g.arch)
    (pw := pw) (acq := false) (s := stOf mem pairs th) hE.2.1 hm.2.1 hm.2.2.2.2.2.2.2.2.2.2 hm.2.2.2.2.2.2.2.2.1 hsto hmode hat hini hna hsku hsig
      (peek_buf_lyt hi0.2.1 hp hbuf hea hbe).2
        (accs_rtW hE.2.1 hi0.2.2.2.1 hi0.2.2.2.2.1 ho (by simp [tb]) (peek_buf_lyt hi0.2.1 hp hbuf hea hbe).2)
  simp [accs] at hus'; subst hus'
  have hni : numOf [wwi] = some (ev ρ j) := by simp [numOf, hwi]
  have hnv : numOf [wv] = some yv := by simp [numOf, hwv']
  have hnum : ∀ r1, r1 ∈ loadUnits g.arch pw (offs ad (ev ρ j / w.lanes)) false [.one] 0 (stOf mem pairs th) →
      PromAbove r1.1 → ∃ y, numOf r1.2 = some y := fun r1 h hp => by
    obtain ⟨hvr, -⟩ := hld r1 h hp
    simp only [VR] at hvr
    obtain ⟨-, y, hy⟩ := hvr
    obtain ⟨w0, h0, hw0⟩ := map_singleton hy
    exact ⟨y, by rw [h0]; simp [numOf, hw0]⟩
  have hm1 : ∀ r1, r1 ∈ loadUnits g.arch pw (offs ad (ev ρ j / w.lanes)) false [.one] 0 (stOf mem pairs th) →
      PromAbove r1.1 → MemInv g (CE η) r1.1 := fun r1 h hp => by
    obtain ⟨_, _, f1, f2, f3, f4, f5⟩ := hld r1 h hp
    exact MemInv_load hm f1 f2 f3 f4 f5 (loadUnits_relSt _ _ _ _ h) (loadUnits_vWr _ _ _ _ h)
  have hwUA : accs (cl ρ η.wit 0 0 (.lanes sg w)) = some [Acc.one] := by simp [cl, accs]
  have hwU : wc (cl ρ η.wit 0 0 (.lanes sg w)) = some (nWords [Acc.one]) := by simp [cl, wc, accs]
  have key : tstep g mem pairs th =
      ((loadUnits g.arch pw (offs ad (ev ρ j / w.lanes)) false [.one] 0 (stOf mem pairs th)).flatMap fun (s1, old) =>
        match numOf old with
        | some y => (storeUnits g.k g.arch pw (offs ad (ev ρ j / w.lanes)) false [.one]
            [cst (.num (setLaneN w y (ev ρ j % w.lanes) yv))] 0 s1).map fun s2 => (s2, Ty.unit, ([] : List Word))
        | none => []).map
        fun (s', t, ws) => (s'.mem, s'.pairs, withS { th with term := e, env := (x, t, ws) :: th.env } s') := by
    simp only [tstep, hterm, evalOp, hea, hei, hev, hni, hnv, addrOf, hwv, hbe, lanesOf]
    rfl
  unfold PAx at hpx
  rw [key] at hpx ⊢
  refine ⟨?_, fun r hr hpr0 => ?_⟩
  · rcases hpx with h0 | ⟨r, hr, -⟩
    rotate_left
    · exact List.ne_nil_of_mem hr
    obtain ⟨y0, hy0⟩ := hnum r0 hr0 (PromAbove_nil (by rw [(loadUnits_frame _ _ _ r0 hr0).2.2.1]; exact h0))
    obtain ⟨s2, hs2⟩ := storeUnits_nonempty (k := g.k) (arch := g.arch) (pw := pw)
      (a := offs ad (ev ρ j / w.lanes)) (rel := false) [.one] [cst (.num (setLaneN w y0 (ev ρ j % w.lanes) yv))] 0 r0.1
      (by simp [nWords, Acc.size])
    refine List.ne_nil_of_mem (List.mem_map_of_mem (List.mem_flatMap.2 ⟨r0, hr0, (?_ : (s2, Ty.unit, ([] : List Word)) ∈ _)⟩))
    obtain ⟨s0, o0⟩ := r0; simp only at hy0 hs2 ⊢; rw [hy0]; exact List.mem_map_of_mem hs2
  have hpr := hpr0
  rw [List.mem_map] at hr
  obtain ⟨⟨s', t', ws'⟩, hr, rfl⟩ := hr
  rw [List.mem_flatMap] at hr
  obtain ⟨⟨s1, old⟩, h1, h2⟩ := hr
  simp only at h2
  obtain ⟨y, hy⟩ : ∃ y, numOf old = some y := by
    cases hn : numOf old with
    | none => simp [hn] at h2
    | some y => exact ⟨y, rfl⟩
  rw [hy, List.mem_map] at h2
  obtain ⟨s2, hs2, he2⟩ := h2
  simp only [Prod.mk.injEq] at he2
  obtain ⟨rfl, rfl, rfl⟩ := he2
  have hp1 : PromAbove s1 := storeUnits_promAbove hs2 (fun t ht m hm => hpr t ht m hm)
  obtain ⟨-, -, f1, -, fc, f3, -⟩ := hld (s1, old) h1 hp1
  have hm1' := hm1 (s1, old) h1 hp1
  obtain ⟨-, Rq, R2, H0, hRe, -, -, -, hput0⟩ := heldStoreAtL (a := offs ad (ev ρ j / w.lanes)) hm hH hsto hmode hnvP (own_cellP hm.2.1 hRF hsto hmode)
    hat hini hna (lanes_EnvValR sg w (setLaneN w y (ev ρ j % w.lanes) yv)) hwU (by simp [nWords, Acc.size])
  have hput := fun k0 a0 p0 r0 s0 e1 e2 e3 e4 e5 s9 h9 => MemHeldK_ofSSetE (s0 := stOf mem pairs th) (hput0 k0 a0 p0 r0 s0 e1 e2 e3 e4 e5 s9 h9)
  have hfr := bindR hb hi (RLink_of hE.2.1 hE.2.2) (show VRR ρ η .unit (shp .unit) [] .zero from rfl) (unit_Lay _)
  rw [Res.add_zero] at hfr
  refine ⟨Rf + Rs, R2 + H0, ⟨CE η, EFoot_refl, (by seenT), (by boxT), ⟨ρ, η, c', Rf, Rs, rfl, hE, ⟨he, hck⟩, htv', hfr, rfl, retPw_skel hPS hRP (skel_subst_eq hRk th.σs 0 0 0)⟩,
    MemInv_storeAt (a := offs ad (ev ρ j / w.lanes)) hm1' hsto hmode hat hini hna
      (lanes_EnvVal sg w _) hwUA (by simp [nWords, Acc.size]) s2 hs2,
    hput g.k g.arch pw false s1 f1 f3 fc (loadUnits_cohMono _ 0 _ _ h1) hm1'.2.2.2.2.1 s2 hs2,
    CrKeep_trans (CrKeep_eqs f1 f3) (CrKeep_storeN hm1' hs2 (NVP_eqs hnvP f1 f3))⟩, Res.le_def.2 fun k => ?_⟩
  have h2 := congrArg (fun R : Res => R k) hRe
  simp only [Res.add_apply, Res.zero_apply] at h2 ⊢
  omega

/-- (P4) **A slot put into a buffer, with resources** (`BufOK_put` at
`j ≤ n`): an initialised slot's resources are replaced (dropped), a slot at
`n` is appended. -/
theorem BufOKR_put {E : TEnv} {n nr N : Nat} {e : Ty} {us : List Acc} {vals q : List Word} {j : Nat} {R Rq : Res}
    (hb : BufOKR E n nr (.array (.lit N) e) vals R) (hus : accs e = some us) (hj : j < N) (hjn : j ≤ n)
    (hjr : j ≤ nr) (hq : ValOfR E e q Rq) (hql : q.length = nWords us) :
    ∃ R', R' ≤ Rq + R ∧ BufOKR E (max n (j + 1)) (max nr (j + 1)) (.array (.lit N) e)
      (vals.take (j * nWords us) ++ q ++ vals.drop (j * nWords us + nWords us)) R' := by
  obtain ⟨N', e', us', Rl, hT, hus', hn, hlen, hRl, hR, hslots⟩ := hb
  subst hR
  simp only [Ty.array.injEq, Idx.lit.injEq] at hT
  obtain ⟨hN, he⟩ := hT
  subst hN; subst he
  rw [hus] at hus'; cases hus'
  have hbw : j * nWords us + nWords us ≤ vals.length := by
    have hm := Nat.mul_le_mul_right (nWords us) (show j + 1 ≤ N by omega)
    rw [Nat.succ_mul] at hm; omega
  have hlen' : (vals.take (j * nWords us) ++ q ++ vals.drop (j * nWords us + nWords us)).length = N * nWords us := by
    simp only [List.length_append, List.length_take, List.length_drop, hql]; omega
  have hsl := fun (j' i : Nat) => slice_get (vals.take (j * nWords us) ++ q ++ vals.drop (j * nWords us + nWords us))
    (j' * nWords us) (nWords us) i
  have hself : ((vals.take (j * nWords us) ++ q ++ vals.drop (j * nWords us + nWords us)).drop
      (j * nWords us)).take (nWords us) = q := by
    apply List.ext_getElem?; intro i
    rw [hsl j i, splice_get vals q _ _ _ hql hbw]
    by_cases hi : i < nWords us
    · rw [iteT hi, iteT ⟨Nat.le_add_right _ _, by omega⟩, Nat.add_sub_cancel_left]
    · rw [iteF hi, List.getElem?_eq_none (by omega)]
  have hother : ∀ j', j' ≠ j → ((vals.take (j * nWords us) ++ q ++ vals.drop (j * nWords us + nWords us)).drop
      (j' * nWords us)).take (nWords us) = (vals.drop (j' * nWords us)).take (nWords us) := by
    intro j' hjj
    apply List.ext_getElem?; intro i
    rw [hsl j' i, slice_get vals]
    by_cases hi : i < nWords us
    · rw [iteT hi, iteT hi, splice_get vals q _ _ _ hql hbw, iteF ?_]
      intro hr; obtain ⟨hr1, hr2⟩ := hr
      rcases Nat.lt_or_gt_of_ne hjj with h | h
      · have hm := Nat.mul_le_mul_right (nWords us) (show j' + 1 ≤ j by omega)
        rw [Nat.succ_mul] at hm; omega
      · have hm := Nat.mul_le_mul_right (nWords us) (show j + 1 ≤ j' by omega)
        rw [Nat.succ_mul] at hm; omega
    · rw [iteF hi, iteF hi]
  rcases Nat.lt_or_ge j n with hlt | hge
  · rw [Nat.max_eq_left (show j + 1 ≤ n by omega)]
    have hjl : j < Rl.length := by omega
    refine ⟨Res.sum (Rl.set j Rq), Res.le_def.2 fun k => ?_, N, e, us, Rl.set j Rq, rfl, hus, hn, hlen',
      by simp [hRl], rfl, fun j' Rj hj' hRj => ?_⟩
    · have h1 := congrArg (fun X : Res => X k) (Res.sum_set Rl j Rq hjl)
      have h2 := congrArg (fun X : Res => X k) (Res.sum_set_zero Rl j hjl)
      simp only [Res.add_apply] at h1 h2 ⊢; omega
    · by_cases hjj : j' = j
      · subst hjj
        rw [List.getElem?_set_self hjl] at hRj
        cases hRj
        rw [hself]; exact ⟨fun h _ => absurd h (by omega), fun _ => hq⟩
      · rw [List.getElem?_set_ne (Ne.symm hjj)] at hRj
        rw [hother j' hjj]; exact slotR_raise (hslots j' Rj hj' hRj) hjr hjj
  · have hjn' : j = n := by omega
    subst hjn'
    rw [Nat.max_eq_right (Nat.le_succ j)]
    refine ⟨Res.sum Rl + Rq, Res.le_def.2 fun k => by simp only [Res.add_apply]; omega, N, e, us, Rl ++ [Rq], rfl,
      hus, by omega, hlen', by simp [hRl], by rw [Res.sum_append]; simp, fun j' Rj hj' hRj => ?_⟩
    by_cases hjj : j' = j
    · subst hjj
      rw [List.getElem?_append_right (by omega), hRl, Nat.sub_self] at hRj
      simp only [List.getElem?_cons_zero, Option.some.injEq] at hRj
      subst hRj
      rw [hself]; exact ⟨fun h _ => absurd h (by omega), fun _ => hq⟩
    · have hj'l : j' < Rl.length := by omega
      rw [List.getElem?_append_left hj'l] at hRj
      rw [hother j' hjj]; exact slotR_raise (hslots j' Rj (by omega) hRj) hjr hjj

theorem BufOKR_map {E E' : TEnv} {n nr : Nat} {T : Ty} {vals : List Word} {R : Res}
    (f : ∀ {U : Ty} {vs : List Word} {Rq : Res}, ValOfR E U vs Rq → ValOfR E' U vs Rq)
    (h : BufOKR E n nr T vals R) : BufOKR E' n nr T vals R := by
  obtain ⟨N, e, us, Rs, hT, hu, hn, hl, hRs, hR, hj⟩ := h
  exact ⟨N, e, us, Rs, hT, hu, hn, hl, hRs, hR, fun j Rj h1 h2 => slotR_imp (hj j Rj h1 h2) rfl f⟩

/-- (P4) The words an own store at `a` leaves in the cell are its latest: the
stored ones, and the old latest ones elsewhere. -/
theorem splice_latest {s s' : St} {a : Address} {us : List Acc} {ws valsm : List Word} {V : Ts}
    (hlen : ws.length = nWords us) (hlenv : a.offset + nWords us ≤ valsm.length)
    (hP : ∀ o v, valsm[o]? = some v → Latest s.mem s.vs.coh ⟨a.label, o⟩ v)
    (g2 : ∀ (j : Nat) w, j < nWords us → ws[j]? = some w → Latest s'.mem s'.vs.coh (offs a (0 + j)) (bumpW V w))
    (g3 : ∀ (b : Address) (v : Word), (∀ j : Nat, j < nWords us → b ≠ offs a (0 + j)) →
      Latest s.mem s.vs.coh b v → Latest s'.mem s'.vs.coh b v) :
    ∀ o v, (valsm.take a.offset ++ ws.map (bumpW V) ++ valsm.drop (a.offset + nWords us))[o]? = some v →
      Latest s'.mem s'.vs.coh ⟨a.label, o⟩ v := by
  intro o v hov
  have hlen' : (ws.map (bumpW V)).length = nWords us := by rw [List.length_map]; exact hlen
  rw [splice_get valsm _ a.offset (nWords us) o hlen' hlenv] at hov
  by_cases hr : a.offset ≤ o ∧ o < a.offset + nWords us
  · rw [iteT hr] at hov
    obtain ⟨hr1, hr2⟩ := hr
    have hj : o - a.offset < ws.length := by rw [hlen]; exact Nat.sub_lt_left_of_lt_add hr1 hr2
    obtain ⟨w, hw⟩ : ∃ w, ws[o - a.offset]? = some w := ⟨ws[o - a.offset], List.getElem?_eq_getElem hj⟩
    rw [List.getElem?_map, hw] at hov
    cases hov
    have := g2 (o - a.offset) w (by rw [← hlen]; exact hj) hw
    have e2 : offs a (0 + (o - a.offset)) = ⟨a.label, o⟩ := by
      simp only [offs, Nat.zero_add]; congr 1; exact Nat.add_sub_of_le hr1
    rw [e2] at this; exact this
  · rw [iteF hr] at hov
    refine g3 _ _ (fun j hj e => ?_) (hP o v hov)
    have h' : o = a.offset + j := by simpa [offs] using congrArg WeakMem.Address.offset e
    subst h'
    exact hr ⟨Nat.le_add_right _ _, Nat.add_lt_add_left hj _⟩


/-- (S4f) `splice_latest` with own promises (`LatestP`). -/
theorem splice_latestP {s s' : St} {a : Address} {us : List Acc} {ws valsm : List Word} {V : Ts}
    (hlen : ws.length = nWords us) (hlenv : a.offset + nWords us ≤ valsm.length)
    (hP : ∀ o v, valsm[o]? = some v → LatestP s.mem s.promises s.vs.coh ⟨a.label, o⟩ v)
    (g2 : ∀ (j : Nat) w, j < nWords us → ws[j]? = some w → LatestP s'.mem s'.promises s'.vs.coh (offs a (0 + j)) (bumpW V w))
    (g3 : ∀ (b : Address) (v : Word), (∀ j : Nat, j < nWords us → b ≠ offs a (0 + j)) →
      LatestP s.mem s.promises s.vs.coh b v → LatestP s'.mem s'.promises s'.vs.coh b v) :
    ∀ o v, (valsm.take a.offset ++ ws.map (bumpW V) ++ valsm.drop (a.offset + nWords us))[o]? = some v →
      LatestP s'.mem s'.promises s'.vs.coh ⟨a.label, o⟩ v := by
  intro o v hov
  have hlen' : (ws.map (bumpW V)).length = nWords us := by rw [List.length_map]; exact hlen
  rw [splice_get valsm _ a.offset (nWords us) o hlen' hlenv] at hov
  by_cases hr : a.offset ≤ o ∧ o < a.offset + nWords us
  · rw [iteT hr] at hov
    obtain ⟨hr1, hr2⟩ := hr
    have hj : o - a.offset < ws.length := by rw [hlen]; exact Nat.sub_lt_left_of_lt_add hr1 hr2
    obtain ⟨w, hw⟩ : ∃ w, ws[o - a.offset]? = some w := ⟨ws[o - a.offset], List.getElem?_eq_getElem hj⟩
    rw [List.getElem?_map, hw] at hov
    cases hov
    have := g2 (o - a.offset) w (by rw [← hlen]; exact hj) hw
    have e2 : offs a (0 + (o - a.offset)) = ⟨a.label, o⟩ := by
      simp only [offs, Nat.zero_add]; congr 1; exact Nat.add_sub_of_le hr1
    rw [e2] at this; exact this
  · rw [iteF hr] at hov
    refine g3 _ _ (fun j hj e => ?_) (hP o v hov)
    have h' : o = a.offset + j := by simpa [offs] using congrArg WeakMem.Address.offset e
    subst h'
    exact hr ⟨Nat.le_add_right _ _, Nat.add_lt_add_left hj _⟩

/-- **(P4) `bufInit`'s memory holding**: storing a value holding `Rv` at slot
`j ≤ ini` of an own buffer, at the view `E'` whose count is raised past `j`,
leaves memory holding at most `Rv + H`. -/
theorem heldBufInit {g : G} {E E' : TEnv} {s : St} {H : Res} {ad : Address} {c : Cell} {N j : Nat} {e : Ty}
    {us : List Acc} {ws : List Word} {pw : Word} {Rv : Res}
    (hm : MemInv g E s) (hH : MemHeld E s H) (hsto : E.sto ad.label = some c) (hown : c.owner = some E.tid)
    (hnv : NVP E s ad.label)
    (hcP : ∃ vals, CellOK E (E.rc ad.label) c.ty vals ∧
      ∀ o v, vals[o]? = some v → LatestP s.mem s.promises s.vs.coh ⟨ad.label, o⟩ v)
    (hat : AtOff c.ty ad.offset (.array (.lit N) e)) (hini : IniAt E.ini c ad (.array (.lit N) e))
    (hwe : wc e = some (nWords us)) (hj : j < N) (hjn : j ≤ E.ini ad.label)
    (hq : EnvValR E e ws Rv) (hlen : ws.length = nWords us)
    (hp : E.prog = E'.prog) (ht : E.tid = E'.tid) (hs : E'.sto = E.sto)
    (hil : E'.ini ad.label = max (E.ini ad.label) (j + 1)) (hio : ∀ l', l' ≠ ad.label → E'.ini l' = E.ini l')
    (hpf : E'.pfr = E.pfr) (hbx : ∀ l B, E.box l = some B → E'.box l = some B)
    (hq' : ∀ o, ¬ PredU E' ⟨ad.label, o⟩) (hrio : ∀ l', l' ≠ ad.label → E'.rini l' = E.rini l')
    (hjr : j ≤ E.rc ad.label) (hrc' : E'.rc ad.label = max (E.rc ad.label) (j + 1))
    (hfp : E'.fp = E.fp := by first | rfl | assumption)
    (hri : ∀ l, E.rini l ≤ E'.rini l := by rini_le) :
    ∃ H2, H2 ≤ Rv + H ∧
      ∀ s', s' ∈ storeUnits g.k g.arch pw (offs ad (j * nWords us)) false us ws 0 s → MemHeld E' s' H2 := by
  obtain ⟨vals, hcell, hlat⟩ := hcP
  obtain ⟨valsm, hW, hP⟩ := own_msgWordsN (E := E) hnv vals hlat
  obtain ⟨R0, H0, rfl, hent0, hX⟩ := MemHeld_focus hH ad.label
  have hcR : CellOKR E (E.ini ad.label) (E.rc ad.label) c.ty valsm R0 :=
    HeldEntry_cell hent0 hsto hcell hW.length.symm (fun o w h => (hP o w h).2)
  obtain ⟨N', e', usB, Rl, hT, husB, hn, hvl, hRl, hR, hslots⟩ : BufOKR E (E.ini ad.label) (E.rc ad.label) c.ty valsm R0 := by
    rcases hcR with ⟨hwc, hv⟩ | hb
    · exfalso
      obtain ⟨n', _, _, hwn, -⟩ := VRR_at E.unsee hat hv.1 hwc
      simp [wc, accs] at hwn
    · exact hb
  have hoff : ad.offset = 0 := by
    rcases hini N' e' hT with ⟨hUc, h0⟩ | ⟨us', j', o, hus', -, -, hato⟩
    · exact h0.symm
    · exact (accs_AtOff hato (by rw [hus']; simp) (by simp [accs])).elim
  have hUc : Ty.array (.lit N) e = c.ty := by
    rcases hini N' e' hT with ⟨hUc, -⟩ | ⟨us', j', o, hus', -, -, hato⟩
    · exact hUc
    · exact (accs_AtOff hato (by rw [hus']; simp) (by simp [accs])).elim
  have hb0 : BufOKR E (E.ini ad.label) (E.rc ad.label) (.array (.lit N) e) valsm R0 := by
    rw [hUc]; exact ⟨N', e', usB, Rl, hT, husB, hn, hvl, hRl, hR, hslots⟩
  rw [hT] at hUc
  simp only [Ty.array.injEq, Idx.lit.injEq] at hUc
  obtain ⟨hN, he⟩ := hUc
  subst hN; subst he
  have hnu : nWords usB = nWords us := by rw [wc_of_accs husB] at hwe; exact Option.some.inj hwe
  have hst := hq.store hm.2.2.2.2.1
  obtain ⟨R', hR'le, hb'⟩ := BufOKR_put hb0 husB hj hjn hjr hst (by rw [List.length_map, hlen, hnu])
  rw [hnu, ← hil, ← hrc'] at hb'
  refine ⟨R' + H0, Res.le_def.2 fun k => ?_, fun s' hs' => ?_⟩
  · have h1 := hR'le k
    simp only [Res.add_apply] at h1 ⊢; omega
  have had : offs ad (j * nWords us) = ⟨ad.label, j * nWords us⟩ := by
    simp only [offs, hoff, Nat.zero_add]
  rw [had] at hs'
  obtain ⟨g2, g3⟩ := storeUnits_latP (a := ⟨ad.label, j * nWords us⟩) us ws 0 s s.vs.vRelSt hm.2.2.1
    hm.2.2.2.2.2.2.2.2.2.2.1 (Nat.le_refl _) s' hs'
  have hlenv : j * nWords us + nWords us ≤ valsm.length := by
    have hm := Nat.mul_le_mul_right (nWords us) (show j + 1 ≤ N by omega)
    rw [Nat.succ_mul] at hm; rw [hvl, hnu]; omega
  have htail : ∀ i : Nat, i < nWords us → TailP s (offs ⟨ad.label, j * nWords us⟩ (0 + i)) := fun i hi => by
    have hlt : j * nWords us + i < vals.length := by have := hW.length; omega
    have hv := hlat (j * nWords us + i) (vals[j * nWords us + i]'hlt) (List.getElem?_eq_getElem hlt)
    have e : offs ⟨ad.label, j * nWords us⟩ (0 + i) = ⟨ad.label, j * nWords us + i⟩ := by simp [offs]
    rw [e]; exact fun t m ht hm hl => hv.2.2 t m ht hm hl
  have hlat' := splice_latestP (a := ⟨ad.label, j * nWords us⟩) hlen hlenv (fun o v h => (hP o v h).1)
    (g2 htail) g3
  have hsto' : E'.sto ad.label = some c := by rw [hs]; exact hsto
  have hile : ∀ l', E.ini l' ≤ E'.ini l' := fun l' => by
    by_cases h : l' = ad.label
    · subst h; rw [hil]; exact Nat.le_max_left _ _
    · rw [hio l' h]; exact Nat.le_refl _
  have hmono : ∀ {U : Ty} {vs : List Word} {Rq : Res}, ValOfR E U vs Rq → ValOfR E' U vs Rq :=
    fun h => ValOfR_mono hp ht (fun l c h => by rw [hs]; exact h) hile h (fun l f h => by rw [hpf]; exact h) hbx
  have hent : HeldEntry E' s' ad.label R' :=
    HeldEntry_ownN hsto' (NVP_env (NVP_store hnv hm.2.2.1 hs')
      (fun o h => (VisU_congr (by rw [hs]) ht.symm (by rw [hpf])).1 h)
      (fun h => (Vis_congr (by rw [hs]) ht.symm (by rw [hpf])).1 h) hfp hq') hlat' (Or.inr (by rw [hT]; exact BufOKR_map hmono hb'))
  have hX' : MemHeldX E' s' ad.label H0 := MemHeldX_tr hX (fun l' _ => by rw [hs]) hio
    (fun l' hne o w hl => LatestNP_growsAtF (storeUnits_growsF us ws 0 s s' hs').1
      (storeUnits_growsF us ws 0 s s' hs').2.1 (storeUnits_fulL hm.2.2.1 hs') hne hl) hmono ht.symm
    (fun l' _ => by rw [hpf])
  exact MemHeld_unfocus hX' hent


theorem heldBufInitL {g : G} {E E' : TEnv} {s : St} {H : Res} {Sl : AllocLabel → List Res} {ad : Address} {c : Cell} {N j : Nat} {e : Ty}
    {us : List Acc} {ws : List Word} {pw : Word} {Rv : Res}
    (hm : MemInv g E s) (hH : MemHeldL E s H Sl) (hsto : E.sto ad.label = some c) (hown : c.owner = some E.tid)
    (hnv : NVP E s ad.label)
    (hcP : ∃ vals, CellOK E (E.rc ad.label) c.ty vals ∧
      ∀ o v, vals[o]? = some v → LatestP s.mem s.promises s.vs.coh ⟨ad.label, o⟩ v)
    (hat : AtOff c.ty ad.offset (.array (.lit N) e)) (hini : IniAt E.ini c ad (.array (.lit N) e))
    (hwe : wc e = some (nWords us)) (hj : j < N) (hjn : j ≤ E.ini ad.label)
    (hq : EnvValR E e ws Rv) (hlen : ws.length = nWords us)
    (hp : E.prog = E'.prog) (ht : E.tid = E'.tid) (hs : E'.sto = E.sto)
    (hil : E'.ini ad.label = max (E.ini ad.label) (j + 1)) (hio : ∀ l', l' ≠ ad.label → E'.ini l' = E.ini l')
    (hpf : E'.pfr = E.pfr) (hbx : ∀ l B, E.box l = some B → E'.box l = some B)
    (hq' : ∀ o, ¬ PredU E' ⟨ad.label, o⟩) (hrio : ∀ l', l' ≠ ad.label → E'.rini l' = E.rini l')
    (hjr : j ≤ E.rc ad.label) (hrc' : E'.rc ad.label = max (E.rc ad.label) (j + 1))
    (hfp : E'.fp = E.fp := by first | rfl | assumption)
    (hri : ∀ l, E.rini l ≤ E'.rini l := by rini_le) :
    ∃ H2, H2 ≤ Rv + H ∧
      ∀ s', s' ∈ storeUnits g.k g.arch pw (offs ad (j * nWords us)) false us ws 0 s →
