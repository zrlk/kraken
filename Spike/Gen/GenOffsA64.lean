import Scc.Cert.OffsGen
import Spike.Lib.A64Ret0Code
import Spike.Lib.A64Hello1Code

/-!
# The generator of `Spike/Test/A64Ret0Offs.lean`

The AArch64 twin of `Spike/Gen/GenOffsX64.lean`.
`Spike/Test/A64Ret0Offs.lean` holds, for `ret0.w` and `hello1.w`, the
data `Scc.Cert.Rt.A64.ofGrps` and `withEvs` add to `scc --code`'s block
tables (`ret0T`, `hello1T`) to make the AArch64 placement data's rows:

* `{p}Offs`: per block, in table order, its region and entry offsets,
  `Scc.Cert.Blocks.offsA64`'s analysis of the listing (`{p}Asm`);
* `{p}Evs`: per group, in table order, its **single instructions**
  (`OGrp.ev`): the indices of the instructions of its label's run
  (`insRun` after the label's first occurrence in `{p}Prog`) in none of
  the group's rows (`[k, k + |blk|)`), ascending (`evsOf`).

Both sides come from `scc --code`'s listing and its own table only; neither
reads `Scc.Cert.PlaceOK.A64.Out.ofEmitted`'s cut of `lowerAll`'s items,
which `Spike/Test/A64PlaceData.lean` compares against them (`sameGrps`).
Nothing here is trusted: A3's coverage (`coverOk`) and A5's offsets
(`offsetsOk`) check the rows they make.

`Spike/Gen/regen_offs_a64.sh` writes `render`'s text (by `#eval` of
`writeTo`), with `--check` against the committed file.
-/

namespace Spike.Gen.OffsA64

open Kraken.Promising.AArch64 Scc.Cert.Rt.A64

/-- **The single instructions of a group** `g` in the program `prog`: the
indices of its label's run (the instructions after the label's first
occurrence) in none of its rows, ascending; `[]` if the label is not in
the program. -/
def evOf (prog : List Directive) (g : Grp) : List Nat :=
  match after g.l prog with
  | some ds =>
    (List.range (insRun ds).length).filter fun i =>
      !g.bs.any fun (k, blk) => k ≤ i && i < k + blk.length
  | none => []

/-- The single instructions of a table's groups, in table order. -/
def evsOf (prog : List Directive) (gs : List Grp) : List (List Nat) := gs.map (evOf prog)

/-- Items joined by `, `, filled into lines (two-space indent) of at most
99 characters with the separator `,`, the last one of at most 100 with the
list's closing `]` (as `Spike.Gen.OffsX64.fill`). -/
def fill (items : List String) : String := Id.run do
  let mut lines : Array String := #[]
  let mut cur := ""
  let n := items.length
  for (it, i) in items.zipIdx do
    let lim := if i + 1 == n then 100 else 99
    if cur.isEmpty then cur := "  " ++ it
    else if cur.length + 2 + it.length + 1 ≤ lim then cur := cur ++ ", " ++ it
    else
      lines := lines.push (cur ++ ",")
      cur := "  " ++ it
  lines := lines.push cur
  return "\n".intercalate lines.toList

/-- `{p}Offs`: the blocks' regions and entry offsets of `offsA64`'s
analysis, one per line. -/
def renderOffs (asm : String) (p : String) : Except String String := do
  let r ← Scc.Cert.Blocks.analyse Scc.Cert.Blocks.A64.isa asm
  let es := r.blocks.toList.map fun b => s!"({b.lo}, {b.hi}, {Scc.Cert.Blocks.A64.isa.soLean b.so})"
  return s!"/-- The blocks' regions and entry offsets, in table order (`{p}T`). -/
def {p}Offs : List (Int × Int × SO) := [
  " ++ ",\n  ".intercalate es ++ "]
"

/-- `{p}Evs`: `evsOf` of the program and the table. -/
def renderEvs (prog : List Directive) (gs : List Grp) (p : String) : String :=
  let es := (evsOf prog gs).map fun e => toString e
  s!"/-- The single instructions of `{p}T`'s groups, in table order. -/
def {p}Evs : List (List Nat) := [
" ++ fill es ++ "]
"

/-- The header of `Spike/Test/A64Ret0Offs.lean`. -/
def header : String := "import Spike.Lib.A64Flow

/-!
# The static offsets of `ret0.w`'s and `hello1.w`'s block tables

Generated by `Spike/Gen/regen_offs_a64.sh` (`Spike/Gen/GenOffsA64.lean`)
from `SccCode.ret0Asm` and `SccCode.hello1Asm` (`Scc.Cert.Blocks.offsA64`'s
analysis): per block of `ret0T` (`hello1T`), in table order, its region and
entry offsets. `Scc.Cert.Rt.A64.ofGrps` zips them with the table into the
placement data's rows; the placement check (A5,
`Scc.Cert.Rt.A64.offsetsOk`) checks them, so nothing here is trusted.
-/

namespace SccCode

open Spike.Lib.A64.Flow

"

/-- The single instructions' section comment. -/
def evsDoc : String := "/-! ## Single instructions

Per group of `ret0T` (`hello1T`), in table order, the indices of the
instructions of its run in no block (`OGrp.ev`): the complement of the
table's rows in the run of the group's label in `ret0Prog` (`hello1Prog`),
each a single instruction the block lemmas do not cover or a stack switch.
`Scc.Cert.Rt.A64.withEvs` adds them to the rows; A3's coverage
(`Scc.Cert.Rt.A64.coverOk`) checks them, so nothing here is trusted
either. -/

"

/-- **The file**: the header, both programs' offsets, both programs'
single instructions. -/
def render : Except String String := do
  let o1 ← renderOffs SccCode.ret0Asm "ret0"
  let o2 ← renderOffs SccCode.hello1Asm "hello1"
  return header ++ o1 ++ "\n" ++ o2 ++ "\n" ++ evsDoc ++
    renderEvs SccCode.ret0Prog SccCode.ret0T "ret0" ++ "\n" ++
    renderEvs SccCode.hello1Prog SccCode.hello1T "hello1" ++ "\nend SccCode\n"

/-- Write `render`'s text to `out`; fail on the analysis' error. -/
def writeTo (out : System.FilePath) : IO Unit := do
  match render with
  | .ok s => IO.FS.writeFile out s
  | .error e => throw (IO.userError s!"GenOffsA64: {e}")

end Spike.Gen.OffsA64
