import Scc.Cert.OffsGenX64
import Spike.Lib.X64Ret0Code
import Spike.Lib.X64Hello1Code

/-!
# The generator of `Spike/Test/X64Ret0Offs.lean`

`Spike/Test/X64Ret0Offs.lean` holds, for `ret0.w` and `hello1.w`, the
data `Scc.Cert.Rt.X64.ofGrps` and `withEvs` add to `scc --code`'s block
tables (`ret0T`, `hello1T`) to make the x86-64 placement data's rows:

* `{p}Offs`: per block, in table order, its region and entry offsets,
  `Scc.Cert.Blocks.offsX64`'s analysis of the listing (`{p}Text` at the
  instruction sizes of `{p}Asm`);
* `{p}Evs`: per group, in table order, its **single instructions**
  (`OGrp.ev`): the indices of the cells of its label's run (`cellRun`
  after the label's first occurrence in `{p}Cells`) in none of the
  group's rows (`[k, k + |blk|)`), ascending (`evsOf`).

Both sides come from `scc --code`'s listing and its own table only; neither
reads `Scc.Cert.PlaceOK.X64.Out.ofEmitted`'s cut of `lowerAll`'s items,
which `Spike/Test/X64PlaceData.lean` compares against them (`sameGrps`).
Nothing here is trusted: A3's coverage (`coverOk`) and A5's offsets
(`offsetsOk`) check the rows they make.

`Spike/Gen/regen_offs_x64.sh` writes `render`'s text (by `#eval` of
`writeTo`), with `--check` against the committed file.
-/

namespace Spike.Gen.OffsX64

open Kraken.Promising.X64 Scc.Cert.Rt.X64

/-- **The single instructions of a group** `g` in the cells `cells`: the
indices of its label's run (the non-label cells after the label's first
occurrence) in none of its rows, ascending; `[]` if the label is not in
the cells. -/
def evOf (cells : List (Directive × Nat)) (g : Grp) : List Nat :=
  match after g.l cells with
  | some cs =>
    (List.range (cellRun cs).length).filter fun i =>
      !g.bs.any fun (k, _, blk) => k ≤ i && i < k + blk.length
  | none => []

/-- The single instructions of a table's groups, in table order. -/
def evsOf (cells : List (Directive × Nat)) (gs : List Grp) : List (List Nat) := gs.map (evOf cells)

/-- Items joined by `, `, filled into lines (two-space indent) of at most
99 characters with the separator `,`, the last one of at most 100 with the
list's closing `]`. -/
def fill (items : List String) : String := Id.run do
  let mut lines : Array String := #[]
  let mut cur := ""
  let n := items.length
  for (it, i) in items.zipIdx do
    let lim := if i + 1 == n then 100 else 99
    if cur.isEmpty then cur := "  " ++ it
    else if cur.length + 2 + it.length + 1 ≤ lim then cur := cur ++ ", " ++ it
    else
      lines := lines.push (cur ++ ",")
      cur := "  " ++ it
  lines := lines.push cur
  return "\n".intercalate lines.toList

/-- `{p}Offs`: the blocks' regions and entry offsets of `offsX64`'s
analysis, one per line. -/
def renderOffs (text : String) (sizes : List Nat) (p : String) : Except String String := do
  let r ← Scc.Cert.Blocks.analyse Scc.Cert.Blocks.X64.isa text (some sizes)
  let es := r.blocks.toList.map fun b => s!"({b.lo}, {b.hi}, {Scc.Cert.Blocks.X64.isa.soLean b.so})"
  return s!"/-- The blocks' regions and entry offsets, in table order (`{p}T`). -/
def {p}Offs : List (Int × Int × SO) := [
  " ++ ",\n  ".intercalate es ++ "]
"

/-- `{p}Evs`: `evsOf` of the cells and the table. -/
def renderEvs (cells : List (Directive × Nat)) (gs : List Grp) (p : String) : String :=
  let es := (evsOf cells gs).map fun e => toString e
  s!"/-- The single instructions of `{p}T`'s groups, in table order. -/
def {p}Evs : List (List Nat) := [
" ++ fill es ++ "]
"

/-- The header of `Spike/Test/X64Ret0Offs.lean`. -/
def header : String := "import Spike.Lib.X64Block

/-!
# The static offsets of `ret0.w`'s and `hello1.w`'s x64 block tables

Generated by `Spike/Gen/regen_offs_x64.sh` (`Spike/Gen/GenOffsX64.lean`)
from `SccCode.ret0Asm` and `SccCode.hello1Asm` (their texts and
instruction sizes, `Scc.Cert.Blocks.offsX64`'s analysis): per block of
`ret0T` (`hello1T`), in table order, its region and entry offsets.
`Scc.Cert.Rt.X64.ofGrps` zips them with the table into the placement
data's rows; the placement check (A5, `Scc.Cert.Rt.X64.offsetsOk`) checks
them, so nothing here is trusted. The x64 twin of
`Spike/Test/A64Ret0Offs.lean`.
-/

namespace SccCode

open Spike.Lib.X64

"

/-- The single instructions' section comment. -/
def evsDoc : String := "/-! ## Single instructions

Per group of `ret0T` (`hello1T`), in table order, the indices of the cells
of its run in no block (`OGrp.ev`): the complement of the table's rows in
the run of the group's label in `ret0Cells` (`hello1Cells`), each a single
instruction the block lemmas do not cover, a load or store through a base
that is not a frame register, or a stack switch.
`Scc.Cert.Rt.X64.withEvs` adds them to the rows; A3's coverage
(`Scc.Cert.Rt.X64.coverOk`) checks them, so nothing here is trusted
either. -/

"

/-- **The file**: the header, both programs' offsets, both programs'
single instructions. -/
def render : Except String String := do
  let o1 ← renderOffs SccCode.ret0Text SccCode.ret0Asm.sizes "ret0"
  let o2 ← renderOffs SccCode.hello1Text SccCode.hello1Asm.sizes "hello1"
  return header ++ o1 ++ "\n" ++ o2 ++ "\n" ++ evsDoc ++
    renderEvs SccCode.ret0Cells SccCode.ret0T "ret0" ++ "\n" ++
    renderEvs SccCode.hello1Cells SccCode.hello1T "hello1" ++ "\nend SccCode\n"

/-- Write `render`'s text to `out`; fail on the analysis' error. -/
def writeTo (out : System.FilePath) : IO Unit := do
  match render with
  | .ok s => IO.FS.writeFile out s
  | .error e => throw (IO.userError s!"GenOffsX64: {e}")

end Spike.Gen.OffsX64
