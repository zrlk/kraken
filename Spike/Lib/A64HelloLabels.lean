/-
**hello.w on AArch64: the layout facts of `wc_waitLoop`** (B2), decided on the program the canonical loader reads from
hello.w's
listing (`SccCode.helloProg`: `scc_arm_text%` of `SccCode.helloAsm`,
`Spike/Lib/A64HelloCode.lean`, generated by `scc --code`; the parse is the
trust boundary, checked by `#guard` there). There the function's label
prefix is `.L21_wc_waitLoop` (wake.w's `.L20_wc_waitLoop`: hello.w's
`.L19_wc_rodata` comes first).

The restatement of `Spike.Lib.A64.WakeLabels` at `helloProg`: the generic
part (`cellsOf`, `labOff`, `lab_of_off`, `lab_of_off_add`) is imported from
there; the differences between the labels
`Spike.Lib.A64.WaitLoop.seg_waitLoopP` takes as hypotheses (`hentry`,
`hcheck`, `hsp3`, `hpentry`) are re-decided on `helloProg` (`labOff`, by
`decide +kernel`), whatever the base and the cells after the text. The
offsets are wake's (`+40`, `+0`, `+4`, `+16`).

Deferred (not restated in B2): wake's `A64WakeSplit` (source-level
`wakeSrc`) to B6 (source).
-/
import Spike.Lib.A64WakeLabels
import Spike.Lib.A64HelloCode

namespace Spike.Lib.A64.HelloLabels

open Kraken Kraken.Promising.AArch64
open Spike.Lib.A64.WakeLabels (cellsOf labOff lab_of_off_add)

/-- `wc_waitLoop`'s label prefix in hello.w's listing. -/
abbrev pfx : String := ".L21_wc_waitLoop"

theorem off_entry : labOff SccCode.helloProg (pfx ++ ".0_entry") =
    (labOff SccCode.helloProg "wc_waitLoop").map (· + 40) := by decide +kernel
theorem off_check : labOff SccCode.helloProg (pfx ++ ".stack_check") =
    (labOff SccCode.helloProg "wc_waitLoop").map (· + 0) := by decide +kernel
theorem off_sp3 : labOff SccCode.helloProg (pfx ++ ".sp3") =
    (labOff SccCode.helloProg (pfx ++ ".2_else2")).map (· + 4) := by decide +kernel
theorem off_pentry : labOff SccCode.helloProg ".L10_scc_rt_park.0_entry" =
    (labOff SccCode.helloProg "scc_rt_park").map (· + 16) := by decide +kernel
theorem off_some : (labOff SccCode.helloProg "wc_waitLoop").isSome ∧
    (labOff SccCode.helloProg (pfx ++ ".2_else2")).isSome ∧
    (labOff SccCode.helloProg "scc_rt_park").isSome := by decide +kernel

theorem rel_of {l l' : Label} {d : Nat}
    (h : labOff SccCode.helloProg l' = (labOff SccCode.helloProg l).map (· + d))
    (hs : (labOff SccCode.helloProg l).isSome) {base : Int64} {rest : List (Directive × Nat)} :
    (_root_.Executable.labels (base, cellsOf SccCode.helloProg ++ rest)).label l' =
      (_root_.Executable.labels (base, cellsOf SccCode.helloProg ++ rest)).label l + Int64.ofNat d := by
  obtain ⟨k, hk⟩ := Option.isSome_iff_exists.mp hs
  rw [hk] at h
  exact lab_of_off_add hk h

/-- **The canonical loader's thread** has the program's cells first when no
data symbol is below the code. -/
theorem threadAt_cells {E : Scc.Sem.Entry} {base : Nat} {syms : List (String × Nat)}
    (h : ∀ p ∈ syms, base ≤ p.2) :
    (Scc.Sem.A64.threadAt E base SccCode.helloProg syms).exe.2 =
      cellsOf SccCode.helloProg ++
        (Scc.Sem.A64.threadAt E base SccCode.helloProg syms).exe.2.drop SccCode.helloProg.length := by
  rw [Scc.Cert.Rt.A64.threadAt_exe_of_above h]
  simp only [cellsOf, List.drop_left' (List.length_map _)]

variable {exe : _root_.Executable}
  (hexe : exe.2 = cellsOf SccCode.helloProg ++ exe.2.drop SccCode.helloProg.length)
include hexe

private theorem exe_eq : exe = (exe.1, cellsOf SccCode.helloProg ++ exe.2.drop SccCode.helloProg.length) :=
  Prod.ext rfl hexe

/-- `hentry` of `seg_waitLoopP` at hello's prefix. -/
theorem hentry : (_root_.Executable.labels exe).label (pfx ++ ".0_entry") =
    (_root_.Executable.labels exe).label "wc_waitLoop" + 4 + 4 + 4 + 4 + 4 + 4 + 4 + 4 + 4 + 4 := by
  rw [exe_eq hexe, rel_of off_entry off_some.1]
  simp only [Int64.add_assoc]; rfl

/-- `hcheck` of `seg_waitLoopP` at hello's prefix. -/
theorem hcheck : (_root_.Executable.labels exe).label (pfx ++ ".stack_check") =
    (_root_.Executable.labels exe).label "wc_waitLoop" := by
  rw [exe_eq hexe, rel_of off_check off_some.1]
  simp

/-- `hsp3` of `seg_waitLoopP` at hello's prefix. -/
theorem hsp3 : (_root_.Executable.labels exe).label (pfx ++ ".sp3") =
    (_root_.Executable.labels exe).label (pfx ++ ".2_else2") + 4 := by
  rw [exe_eq hexe, rel_of off_sp3 off_some.2.1]
  rfl

/-- `hpentry` of `seg_waitLoopP` (`scc_rt_park`'s prologue falls through). -/
theorem hpentry : (_root_.Executable.labels exe).label ".L10_scc_rt_park.0_entry" =
    (_root_.Executable.labels exe).label "scc_rt_park" + 4 + 4 + 4 + 4 := by
  rw [exe_eq hexe, rel_of off_pentry off_some.2.2]
  simp only [Int64.add_assoc]; rfl

end Spike.Lib.A64.HelloLabels

/-- info: 'Spike.Lib.A64.HelloLabels.hentry' depends on axioms: [propext, Quot.sound] -/
#guard_msgs in
#print axioms Spike.Lib.A64.HelloLabels.hentry

/-- info: 'Spike.Lib.A64.HelloLabels.hpentry' depends on axioms: [propext, Quot.sound] -/
#guard_msgs in
#print axioms Spike.Lib.A64.HelloLabels.hpentry
