import WeakCore.CoreTerm
import Scc.IR.Core

/-!
# Placement data of `ret0.w`

Generated by `scc --blocks` (`Scc/Cert/Place.lean`): per compiled function,
its nodes (block starts and call return points, by assembler label), its IR
registers' frame slots (offsets from the base of its stack region in the
block data), and at each node the source variables' shape types and IR
operands and the term that remains.
-/

namespace SccPlace.ret0

/-! ## `wc_main` -/

/-- The nodes of `wc_main`. -/
inductive wc_mainNode where
  /-- `.L18_wc_main.0_entry`: the start of IR block `entry`. -/
  | b0_entry
  deriving DecidableEq, Repr

/-- The assembler label of each node of `wc_main`. -/
def wc_main_label : wc_mainNode → String
  | .b0_entry => ".L18_wc_main.0_entry"

/-- The frame slot of each IR register of `wc_main`: its offset from the
base of the function's stack region in the block data (`σ.slot k`). -/
def wc_main_rs : Scc.IR.Reg → Option Int
  | "y%0" => some (-32)
  | _ => none

def wc_main_t0 : CoreTerm.Expr :=
  (CoreTerm.Expr.let_ "x" (CoreTerm.Op.atom (CoreTerm.At.lit 40)) (CoreTerm.Expr.let_ "y" (CoreTerm.Op.add (CoreTerm.At.var "x") (CoreTerm.At.lit 2)) (CoreTerm.Expr.ret (CoreTerm.At.var "y"))))

/-- The term that remains at each node of `wc_main`. -/
def wc_main_term : wc_mainNode → CoreTerm.Expr
  | .b0_entry => wc_main_t0

/-- The shape type and IR operands of each source variable at each node of
`wc_main`. -/
def wc_main_env : wc_mainNode → String → Option (CoreLang.Ty × List Scc.IR.Operand)
  | .b0_entry => fun
    | "u" => some ((CoreLang.Ty.unit), [])
    | _ => none

end SccPlace.ret0
