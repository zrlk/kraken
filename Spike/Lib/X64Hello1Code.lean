/-! ## The stack need -/

/-- **The stack need table** (`Scc.Lower.stackNeed`): per stack-checked
function, its label, its frame below the entry stack pointer and the most
stack it uses below it until it returns. -/
def hello1Need : List Scc.Cert.NeedX64.Row := [
  ("scc_rt_main", 72, 168),
  ("wc_rodata", 40, 40),
  ("wc_main", 88, 88)]

/-- The table holds on the program, and each thread entry's need fits in
the initial stack range less the headroom (12288 bytes). -/
theorem hello1Need_ok : Scc.Cert.NeedX64.needOk hello1Cells hello1Need 12288 ["scc_rt_main"] = true := by
  decide +kernel

/-! ## The layout -/

/-- **The stack depth limit**: the most calls of code blocks a thread is
in (`Tcb.depth`); a call past it takes the stack abort outcome.  The frames,
the largest of 96 bytes, with 272 bytes of trampoline frame, entry
frame and grow stub and 4352 bytes of headroom and grow slack, fit in the
stack cap of 67108864 bytes (`Scc.Lower.stackBudget`). -/
def hello1Frames : Nat := 699002

#guard 1 ≤ hello1Frames && hello1Frames * 96 + 272 + 4352 ≤ 67108864
/-- A term at which the lowering keeps an immediate. -/
def hello1Imm_t0 : CoreTerm.Expr :=
  (CoreTerm.Expr.let_ "b" (CoreTerm.Op.newBuf (CoreTerm.At.var "m") (CoreLang.Ty.lanes false (CoreLang.Wd.w8))) (CoreTerm.Expr.let_ "w0" (CoreTerm.Op.asLanes false (CoreLang.Wd.w8) (CoreTerm.At.lit 8583909746840200520)) (CoreTerm.Expr.let_ "o0" (CoreTerm.Op.xchgAt (CoreTerm.At.var "b") (CoreTerm.At.lit 0) (CoreTerm.At.var "w0")) (CoreTerm.Expr.let_ "w1" (CoreTerm.Op.asLanes false (CoreLang.Wd.w8) (CoreTerm.At.lit 44634501743)) (CoreTerm.Expr.let_ "o1" (CoreTerm.Op.xchgAt (CoreTerm.At.var "b") (CoreTerm.At.lit 1) (CoreTerm.At.var "w1")) (CoreTerm.Expr.let_ "n" (CoreTerm.Op.atom (CoreTerm.At.lit 13)) (CoreTerm.Expr.let_ "sm" (CoreTerm.Op.pair (CoreTerm.At.var "b") (CoreTerm.At.var "m")) (CoreTerm.Expr.let_ "sl0" (CoreTerm.Op.pair (CoreTerm.At.var "sm") (CoreTerm.At.var "n")) (CoreTerm.Expr.let_ "sl" (CoreTerm.Op.pack (CoreTerm.At.var "sl0") "m" (CoreLang.Ty.iex (CoreLang.Ty.prod (CoreLang.Ty.prod (CoreLang.Ty.refine (CoreLang.Ty.loc (CoreLang.Mode.own) (CoreLang.Ty.array (CoreLang.Idx.var 0) (CoreLang.Ty.lanes false (CoreLang.Wd.w8)))) (CoreLang.Pred.ini (CoreLang.Idx.var 0))) (CoreLang.Ty.intS (CoreLang.Idx.var 0))) (CoreLang.Ty.int)))) (CoreTerm.Expr.ret (CoreTerm.At.var "sl")))))))))))

open Classical in
/-- **The immediate table** (`Scc.Sem.Layout.imms`): the constant of word `k`
of source variable `x` where the term `e` remains at a node whose lowering
keeps it as an immediate (`Scc.Cert.Place.renderImms`). -/
noncomputable def hello1Imms : CoreTerm.Expr → String → Nat → Option Nat := fun e x k =>
  if e = hello1Imm_t0 then
    match x, k with
      | "m", 0 => some 2
      | "two", 0 => some 2
      | _, _ => none
  else none

/-- **The layout of the program's static link**, with its immediate table. -/
noncomputable def hello1Λ : Scc.Sem.Layout := { linkOf hello1Cells hello1Secs with imms := hello1Imms }

theorem hello1Λ_wf : hello1Λ.WF := Scc.Cert.Link.wfB_sound (by decide +kernel)

