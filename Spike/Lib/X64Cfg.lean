/-
**Whole functions from blocks on x64**: a function's control-flow graph
as one `Seg`.

A function is given by **nodes** (`ND`): a pc, the static offsets there and
an invariant `J` on the abstract state and the source control. The fragment
of a node (`At`) holds of a pair `(s, c)` when `s` runs the function's
executable, its pc is the node's, and its region is related to some abstract
state `σ` at the node's offsets (`Abs`) with `J σ c`, and its memory
satisfies the frame condition `F`, which no write inside the region breaks
(`FStable`): for a function without calls the memory outside the region as
at entry (`DFrame R m0`, `FStable.dframe`); with calls, a condition the
callees keep as well (they write below the region).

- **Block nodes** (`seg_nd`, from `seg_block`): the per-node obligation is
  about the block's closed form only (`…_run`, generated by `block_spec`):
  from `J σ c`, the abstract run **hits** (`Hit`) an internal node or an
  exit: same pc, offsets no stronger than the run's (`SO.le`, decided; at a
  join the offsets of the incoming edges are weakened to the node's), and
  the node's invariant.
- **Given nodes**: an instruction or routine whose segment is a hypothesis
  (a system call, a call, an access the block lemma does not cover), from
  its node to another node.
- **The function** (`fn_seg`): `Seg.cfg` makes the whole graph (loops,
  joins, both edges of every conditional branch) one segment from any node
  to the exits.
- **Inside a predicate** (`seg_ndW`, `seg_givenW`, `fn_segW`, `seg_fixW`,
  `seg_movedW`, `fn_seg_gW`): the same over `SegW W K` (`Spike/Lib/SegW.lean`),
  each node's states in `W` and not moved by the outside moves `K`; a node's
  and a block node's obligations are `NodeW` and `BlkW`.
-/
import Spike.Lib.X64Block

namespace Spike.Lib.X64

open CoreLang CoreTerm
open Kraken Kraken.Promising Kraken.Promising.X64 Kraken.Promising.Lower.X64

/-! ## Weaker static offsets -/

/-- **`o'` claims no more than `o`**: the same `sp`, and every register
offset of `o'` is `o`'s (decided on concrete offsets). -/
def SO.le (o' o : SO) : Bool :=
  decide (o'.sp = o.sp) && o'.regs.all fun e => lk o.regs e.1 == some e.2

theorem lk_mem {ρ : Type} [DecidableEq ρ] {l : List (ρ × Int)} {r : ρ} {k : Int} (h : lk l r = some k) :
    (r, k) ∈ l := by
  induction l with
  | nil => cases h
  | cons e l ih =>
    obtain ⟨r', k'⟩ := e
    simp only [lk] at h
    split at h
    · rename_i hr; cases h; subst hr; exact List.mem_cons_self
    · exact List.mem_cons_of_mem _ (ih h)

theorem SO.get_of_le {o' o : SO} (h : SO.le o' o = true) {r : Reg64} {k : Int} (hk : o'.get r = some k) :
    o.get r = some k := by
  simp only [SO.le, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, beq_iff_eq] at h
  unfold SO.get at hk ⊢
  split at hk
  · rename_i hr; simp only [hr, ↓reduceIte]; rw [← h.1]; exact hk
  · rename_i hr; simp only [hr, ↓reduceIte]; exact h.2 _ (lk_mem hk)

theorem Abs.weaken {R : Region} {o' o : SO} {m : MachineData} {σ : AS} (h : SO.le o' o = true)
    (hA : Abs R o m σ) : Abs R o' m σ :=
  ⟨hA.regs, hA.zmms, hA.status, fun r k hk => hA.so r k (SO.get_of_le h hk), hA.slot⟩

/-! ## Nodes -/

/-- **A node of a function**: its pc, static offsets and invariant. -/
structure ND where
  pc : Int64
  o : SO
  J : AS → Ctl → Prop

/-- **A frame condition no write inside region `R` breaks.** -/
def FStable (R : Region) (F : MachineData → Prop) : Prop := ∀ m m', F m → DFrame R m m' → F m'

/-- The memory outside the region as in `m0`. -/
theorem FStable.dframe (R : Region) (m0 : MachineData) : FStable R (DFrame R m0) := fun _ _ h h' => h.trans h'

/-- **A frame condition no outside move breaks** (`K`, as in `SegW`). -/
def KStable (K : State → State → Prop) (F : MachineData → Prop) : Prop := ∀ s s', K s s' → F s.st.1 → F s'.st.1

/-- Without outside moves every frame condition is stable. -/
theorem KStable.none (F : MachineData → Prop) : KStable (fun _ _ => False) F := fun _ _ h => h.elim

/-- **The fragment of a node**, for the executable `exe` (ending at
`endPc`), region `R`, and frame condition `F`. The declarations are pinned
to none (`s.decls = {}`, as in the loader's thread and kept by every step):
an access's footprint depends on them, and nothing else fixes them. -/
def At (exe : _root_.Executable) (endPc : Int64) (R : Region) (F : MachineData → Prop) (n : ND) : Frag isa :=
  fun s c => s.exe = exe ∧ s.endPc = endPc ∧ s.decls = {} ∧ s.st.2 = n.pc ∧
    ∃ σ, Abs R n.o s.st.1 σ ∧ F s.st.1 ∧ n.J σ c

/-- **No declarations agree everywhere**: the agreement every access of a
node's state needs (`At` pins `s.decls = {}`). -/
theorem agrees_of_decls {s : State} (h : s.decls = {}) (a : BitVec 64) (n : Nat) : s.decls.AgreesAt a n :=
  h ▸ Decls.agreesAt_empty a n

/-- **An abstract run's end hits node `n`**: the node's pc, offsets no
stronger than the run's, the node's invariant. -/
def Hit (n : ND) (am : AM) (c : Ctl) : Prop := n.pc = am.pc ∧ SO.le n.o am.so = true ∧ n.J am.σ c

/-- **Landing** at an internal node of `N` or an exit of `E`. -/
def Lands {ι κ : Sort _} (N : ι → ND) (E : κ → ND) (am : AM) (c : Ctl) : Prop :=
  (∃ j, Hit (N j) am c) ∨ ∃ x, Hit (E x) am c

/-- The function's segment exit: an internal node or an exit. -/
def Next {ι κ : Sort _} (exe : _root_.Executable) (endPc : Int64) (R : Region) (F : MachineData → Prop) (N : ι → ND)
    (E : κ → ND) : Frag isa :=
  fun s c => (∃ j, At exe endPc R F (N j) s c) ∨ ∃ x, At exe endPc R F (E x) s c

section Fn

variable {p : Prog} {lbl : WeakMem.AllocLabel → Option Nat} {ms : MemSide isa}
  {exe : _root_.Executable} {endPc : Int64} {R : Region} {F : MachineData → Prop} {ι κ : Sort _} {N : ι → ND}
  {E : κ → ND}

theorem Hit.at {n : ND} {s : State} {m : MachineData} {am : AM} {c : Ctl} (h : Hit n am c) (he : s.exe = exe)
    (hn : s.endPc = endPc) (hdc : s.decls = {}) (hA : Abs R am.so m am.σ) (hD : F m) :
    At exe endPc R F n { s with st := (m, am.pc) } c :=
  ⟨he, hn, hdc, h.1.symm, am.σ, hA.weaken h.2.1, hD, h.2.2⟩

/-- **A node's states inside `W`**, none moved by `K`: the obligation `hW`
of a node lemma. A function lemma over `SegW` names one per node. -/
def NodeW (W : Frag isa) (K : State → State → Prop) (exe : _root_.Executable) (endPc : Int64) (R : Region)
    (F : MachineData → Prop) (n : ND) : Prop :=
  ∀ s c, At exe endPc R F n s c → W s c ∧ ∀ s', ¬ K s s'

/-- **A block node's states inside `W`**, none moved by `K`: the obligation
`hW` of `seg_ndW` for the block `blk` at node `n` (the states before each
instruction, related to the abstract run so far, the memory outside the
region as at the node). -/
def BlkW (W : Frag isa) (K : State → State → Prop) (exe : _root_.Executable) (endPc : Int64) (R : Region)
    (F : MachineData → Prop) (n : ND) (blk : List (Directive × Nat)) : Prop :=
  ∀ (s : State) σ c, s.exe = exe → s.endPc = endPc → s.decls = {} → s.st.2 = n.pc → Abs R n.o s.st.1 σ → F s.st.1 →
    n.J σ c → ∀ k < blk.length, ∀ m,
      Abs R (arun (_root_.Executable.labels exe).label (blk.take k) ⟨n.pc, n.o, σ⟩).so m
        (arun (_root_.Executable.labels exe).label (blk.take k) ⟨n.pc, n.o, σ⟩).σ → DFrame R s.st.1 m →
      W { s with st := (m, n.pc + Int64.ofNat (cellOff blk k)) } c ∧
        ∀ s', ¬ K { s with st := (m, n.pc + Int64.ofNat (cellOff blk k)) } s'

/-- Every node is inside the trivial predicate, with no outside moves. -/
theorem NodeW.triv {n : ND} : NodeW (fun _ _ => True) (fun _ _ => False) exe endPc R F n :=
  fun _ _ _ => ⟨trivial, fun _ h => h⟩

/-- Every block node is inside the trivial predicate, with no outside moves. -/
theorem BlkW.triv {n : ND} {blk : List (Directive × Nat)} :
    BlkW (fun _ _ => True) (fun _ _ => False) exe endPc R F n blk :=
  fun _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ => ⟨trivial, fun _ h => h⟩

/-- **A block node inside `W`**: a covered block at the node's pc whose
abstract run from every state of the invariant lands at a node, after a
local run of the source, and whose internal states are in `W` (`hW`,
`BlkW`), none of them moved by `K`. The obligation `hedge` is on the
block's closed form only. -/
theorem seg_ndW {W : Frag isa} {K : State → State → Prop} {n : ND} {lo hi : Int} {blk : List (Directive × Nat)}
    (hne : blk ≠ []) (hok : okBlk lo hi n.o blk = true)
    (hF : FStable R F) (hR : R.OK) (hlo : R.lo ≤ lo) (hhi : hi ≤ R.hi)
    (hcode : ∀ s : State, s.exe = exe → s.endPc = endPc → CodeAt s n.pc blk)
    (hW : BlkW W K exe endPc R F n blk)
    (hedge : ∀ σ c, n.J σ c →
      ∃ c', LocalRun p c c' ∧ Lands N E (arun (_root_.Executable.labels exe).label blk ⟨n.pc, n.o, σ⟩) c') :
    SegW W K p lbl ms (At exe endPc R F n) (Next exe endPc R F N E) := by
  refine seg_blockW (R := R) (pc := n.pc) (lo := lo) (hi := hi) (o := n.o) hne
    fun s c ⟨he, hn, hdc, hpc, σ, hA, hD, hJ⟩ => ⟨hpc, hcode s he hn, hok, hR, hlo, hhi, σ, hA, ?_, ?_⟩
  · have hl : labelAddr s = (_root_.Executable.labels exe).label := by
      funext L; show (_root_.Executable.labels s.exe).label L = _; rw [he]
    rw [hl]; exact hW s σ c he hn hdc hpc hA hD hJ
  obtain ⟨c', hr, hL⟩ := hedge σ c hJ
  refine ⟨c', hr, fun m' hA' hD' => ?_⟩
  have hl : labelAddr s = (_root_.Executable.labels exe).label := by
    funext L; show (_root_.Executable.labels s.exe).label L = _; rw [he]
  rw [hl] at hA' ⊢
  rcases hL with ⟨j, hj⟩ | ⟨x, hx⟩
  · exact .inl ⟨j, hj.at he hn hdc hA' (hF _ _ hD hD')⟩
  · exact .inr ⟨x, hx.at he hn hdc hA' (hF _ _ hD hD')⟩

/-- **A block node**: a covered block at the node's pc whose abstract run
from every state of the invariant lands at a node, after a local run of the
source. The obligation `hedge` is on the block's closed form only. -/
theorem seg_nd {n : ND} {lo hi : Int} {blk : List (Directive × Nat)} (hne : blk ≠ []) (hok : okBlk lo hi n.o blk = true)
    (hF : FStable R F) (hR : R.OK) (hlo : R.lo ≤ lo) (hhi : hi ≤ R.hi)
    (hcode : ∀ s : State, s.exe = exe → s.endPc = endPc → CodeAt s n.pc blk)
    (hedge : ∀ σ c, n.J σ c →
      ∃ c', LocalRun p c c' ∧ Lands N E (arun (_root_.Executable.labels exe).label blk ⟨n.pc, n.o, σ⟩) c') :
    Seg p lbl ms (At exe endPc R F n) (Next exe endPc R F N E) :=
  (seg_ndW hne hok hF hR hlo hhi hcode BlkW.triv hedge).toSeg

/-- **A given node inside `W`**: a segment from node `i` to node `j`. -/
theorem seg_givenW {W : Frag isa} {K : State → State → Prop} {n : ND} (j : ι)
    (h : SegW W K p lbl ms (At exe endPc R F n) (At exe endPc R F (N j))) :
    SegW W K p lbl ms (At exe endPc R F n) (Next exe endPc R F N E) :=
  h.mono_post fun _ _ h => .inl ⟨j, h⟩

/-- **A given node**: a segment from node `i` to node `j`. -/
theorem seg_given {n : ND} (j : ι) (h : Seg p lbl ms (At exe endPc R F n) (At exe endPc R F (N j))) :
    Seg p lbl ms (At exe endPc R F n) (Next exe endPc R F N E) :=
  h.mono_post fun _ _ h => .inl ⟨j, h⟩

/-- **A whole function inside `W`**: every internal node's segment exits to
a node, so the function is one segment from its entry `i0` to its exits. -/
theorem fn_segW {W : Frag isa} {K : State → State → Prop}
    (h : ∀ i, SegW W K p lbl ms (At exe endPc R F (N i)) (Next exe endPc R F N E)) (i0 : ι) :
    SegW W K p lbl ms (At exe endPc R F (N i0)) (fun s c => ∃ x, At exe endPc R F (E x) s c) :=
  (SegW.cfg (fun i => At exe endPc R F (N i)) h).mono_pre fun _ _ h => ⟨i0, h⟩

/-- **A whole function**: every internal node's segment exits to a node, so
the function is one segment from its entry `i0` to its exits. -/
theorem fn_seg (h : ∀ i, Seg p lbl ms (At exe endPc R F (N i)) (Next exe endPc R F N E)) (i0 : ι) :
    Seg p lbl ms (At exe endPc R F (N i0)) (fun s c => ∃ x, At exe endPc R F (E x) s c) :=
  (Seg.cfg (fun i => At exe endPc R F (N i)) h).mono_pre fun _ _ h => ⟨i0, h⟩

end Fn

/-! ## Functions whose frame moves -/

section Moving

variable {p : Prog} {lbl : WeakMem.AllocLabel → Option Nat} {ms : MemSide isa}
  {exe : _root_.Executable} {endPc : Int64} {γ ι κ : Sort _} {Rg : γ → Region} {Fg : γ → MachineData → Prop}
  {N : γ → ι → ND} {E : γ → κ → ND}

/-- **The segment exit of a function whose frame may move**: an internal
node or an exit at some ghost `g` (the region, the frame condition and the
nodes' ghost parameters, e.g. after a stack switch or a call that grows the
stack). -/
def NextG (exe : _root_.Executable) (endPc : Int64) (Rg : γ → Region) (Fg : γ → MachineData → Prop)
    (N : γ → ι → ND) (E : γ → κ → ND) : Frag isa :=
  fun s c => (∃ g j, At exe endPc (Rg g) (Fg g) (N g j) s c) ∨ ∃ g x, At exe endPc (Rg g) (Fg g) (E g x) s c

/-- **A node of a fixed frame inside `W`**: a segment to the nodes at the
same ghost. -/
theorem seg_fixW {W : Frag isa} {K : State → State → Prop} {P : Frag isa} (g : γ)
    (h : SegW W K p lbl ms P (Next exe endPc (Rg g) (Fg g) (N g) (E g))) :
    SegW W K p lbl ms P (NextG exe endPc Rg Fg N E) :=
  h.mono_post fun _ _ h => h.elim (fun ⟨j, h⟩ => .inl ⟨g, j, h⟩) fun ⟨x, h⟩ => .inr ⟨g, x, h⟩

/-- **A given node that moves the frame, inside `W`**: a segment to node `j`
at some ghost. -/
theorem seg_movedW {W : Frag isa} {K : State → State → Prop} {P : Frag isa} (j : ι)
    (h : SegW W K p lbl ms P (fun s c => ∃ g, At exe endPc (Rg g) (Fg g) (N g j) s c)) :
    SegW W K p lbl ms P (NextG exe endPc Rg Fg N E) :=
  h.mono_post fun _ _ ⟨g, h⟩ => .inl ⟨g, j, h⟩

/-- **A whole function whose frame may move, inside `W`**. -/
theorem fn_seg_gW {W : Frag isa} {K : State → State → Prop}
    (h : ∀ g i, SegW W K p lbl ms (At exe endPc (Rg g) (Fg g) (N g i)) (NextG exe endPc Rg Fg N E))
    (g0 : γ) (i0 : ι) :
    SegW W K p lbl ms (At exe endPc (Rg g0) (Fg g0) (N g0 i0))
      (fun s c => ∃ g x, At exe endPc (Rg g) (Fg g) (E g x) s c) :=
  (SegW.cfg (fun gi : PProd γ ι => At exe endPc (Rg gi.1) (Fg gi.1) (N gi.1 gi.2)) fun gi =>
      (h gi.1 gi.2).mono_post fun _ _ h => h.elim (fun ⟨g, j, h⟩ => .inl ⟨⟨g, j⟩, h⟩) .inr).mono_pre
    fun _ _ h => ⟨⟨g0, i0⟩, h⟩

/-- **A node of a fixed frame**: a segment to the nodes at the same ghost. -/
theorem seg_fix {P : Frag isa} (g : γ) (h : Seg p lbl ms P (Next exe endPc (Rg g) (Fg g) (N g) (E g))) :
    Seg p lbl ms P (NextG exe endPc Rg Fg N E) :=
  h.mono_post fun _ _ h => h.elim (fun ⟨j, h⟩ => .inl ⟨g, j, h⟩) fun ⟨x, h⟩ => .inr ⟨g, x, h⟩

/-- **A given node that moves the frame**: a segment to node `j` at some
ghost. -/
theorem seg_moved {P : Frag isa} (j : ι)
    (h : Seg p lbl ms P (fun s c => ∃ g, At exe endPc (Rg g) (Fg g) (N g j) s c)) :
    Seg p lbl ms P (NextG exe endPc Rg Fg N E) :=
  h.mono_post fun _ _ ⟨g, h⟩ => .inl ⟨g, j, h⟩

/-- **A whole function whose frame may move**: every internal node at every
ghost exits to a node at some ghost, so the function is one segment from its
entry `i0` at `g0` to its exits (at any ghost). -/
theorem fn_seg_g (h : ∀ g i, Seg p lbl ms (At exe endPc (Rg g) (Fg g) (N g i)) (NextG exe endPc Rg Fg N E))
    (g0 : γ) (i0 : ι) :
    Seg p lbl ms (At exe endPc (Rg g0) (Fg g0) (N g0 i0))
      (fun s c => ∃ g x, At exe endPc (Rg g) (Fg g) (E g x) s c) :=
  (Seg.cfg (fun gi : PProd γ ι => At exe endPc (Rg gi.1) (Fg gi.1) (N gi.1 gi.2)) fun gi =>
      (h gi.1 gi.2).mono_post fun _ _ h => h.elim (fun ⟨g, j, h⟩ => .inl ⟨⟨g, j⟩, h⟩) .inr).mono_pre
    fun _ _ h => ⟨⟨g0, i0⟩, h⟩

end Moving


end Spike.Lib.X64
