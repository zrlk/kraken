/-- The configuration `scc` compiled with. -/
def config : Scc.Config := ({ arch := .arm, host := .linux, gc := .none } : Scc.Config)

-- Reproducibility check (evaluation, not a proof): `source` compiles to
-- exactly `asm`.
#guard Scc.Cert.Arm.reproduces config source asm

/-- The program Kraken's parser reads from `asm` (computed at elaboration
time). -/
def prog : _root_.Program := scc_arm_reparse% asm

/-- `prog` satisfies the lowerability predicate (kernel-checked). -/
theorem lowerable : prog.WCLowerable := by decide +kernel

/-! ## Acceptance and placement -/

/-- The WeakCore program `scc`'s frontend reads from `source`, as a term
(the kernel does not run the frontend's parser). -/
def prog_src : CoreTerm.Prog :=
  [{
    name := "main",
    tparams := [],
    idx := [],
    arg := "u",
    argTy := CoreLang.Ty.unit,
    retTy := CoreLang.Ty.int,
    body := CoreTerm.Expr.let_
        "x"
        (CoreTerm.Op.atom (CoreTerm.At.lit 40))
        (CoreTerm.Expr.let_
          "y"
          (CoreTerm.Op.add (CoreTerm.At.var "x") (CoreTerm.At.lit 2))
          (CoreTerm.Expr.ret (CoreTerm.At.var "y"))) }]

-- The frontend reads `source` as `prog_src` (evaluation, not a proof).
#guard Scc.Cert.SrcTerm.reads source prog_src

/-- `prog_src` is in the fragment the first compiler theorem covers
(kernel-checked). -/
theorem prog_accepted : Scc.Lower.Accepted0 prog_src = true := by decide +kernel

/-- `scc`'s output for `prog_src` as the placement check reads it: the
lowering and the emission (`Scc.Lower.A64.lowerAll`) with the placement data
computed from them. -/
def out : Scc.Cert.PlaceOK.A64.Out := Scc.Cert.PlaceOK.A64.Out.ofEmitted (Scc.Lower.A64.lowerAll config prog_src)

-- The loader's parse of `asm` is `out`'s code and data sections (evaluation,
-- not a proof: the trust boundary).
#guard Scc.Cert.Link.A64.parsesTo asm out.prog out.secs

/-- The configuration of the placement check: the canonical one, with the
program's thread entries and their stack budget (`needOk`'s). -/
def placeCfg : Scc.Cert.PlaceOK.Config :=
  { Scc.Cert.PlaceOK.Config.canonical with needBudget := 12288, entries := ["scc_rt_main"] }

/-- `out` as a literal: its value computed at elaboration time (`scc_lit%`,
untrusted), trusted through `out_eq`. -/
def outLit : Scc.Cert.PlaceOK.A64.Out := scc_lit% out

/-- The lowering of `prog_src`, at elaboration time. -/
def loweredVal : Option (Scc.IR.Program × Bool) := Scc.Cert.PlaceOK.A64.lowered1 config prog_src

/-- The lowering's IR and setup flag, as a literal (untrusted, checked by
`lowered_eq`). -/
def loweredLit : Scc.IR.Program × Bool := (scc_lit% loweredVal).get!

/-- The emission of the literal IR, at elaboration time. -/
def emittedVal : Option (List Scc.Emit.A64.Item × List Scc.Emit.A64.Safepoint) :=
  (Scc.Emit.A64.emitItemsMaps loweredLit.1).toOption

/-- The emitter's items and safepoints, as a literal (untrusted, checked by
`emitted_eq`). -/
def emittedLit : List Scc.Emit.A64.Item × List Scc.Emit.A64.Safepoint := (scc_lit% emittedVal).get!

/-- The lowering's depth limit, at elaboration time. -/
def framesVal : Option Nat := Scc.Cert.LowerStage.frames1 config prog_src

/-- The depth limit as a literal (untrusted, checked by `frames_eq`). -/
def framesLit : Nat := (scc_lit% framesVal).get!

/-- The budget gives the depth limit `framesLit` (kernel-checked: the kernel
runs the lowering at depth limit 0, here). -/
theorem frames_eq : Scc.Cert.LowerStage.frames1 config prog_src = some framesLit := by kernel_rfl

/-- The lowering at `framesLit` gives `loweredLit` (kernel-checked: the
kernel runs the lowering, here). -/
theorem ir_eq : Scc.Cert.LowerStage.ir1 config prog_src framesLit = some loweredLit := by kernel_rfl

/-- The lowering gives `loweredLit` (`lowered1_of_stages`: the budget and
the lowering above). -/
theorem lowered_eq : Scc.Cert.PlaceOK.A64.lowered1 config prog_src = some loweredLit :=
  Scc.Cert.PlaceOK.A64.lowered1_of_stages frames_eq ir_eq

/-- The emitter gives `emittedLit` on the literal IR (kernel-checked: the
kernel runs the emitter, here). -/
theorem emitted_eq : Scc.Emit.A64.emitItemsMaps loweredLit.1 = .ok emittedLit := by kernel_rfl

/-- `out` is `outLit` (kernel-checked in three steps, `ofEmitted_of_stages`:
the lowering and the emitter above, and here the stack need table, the
`.text` filter and the block table on the literals; the decisions below
read `outLit`). -/
theorem out_eq : out = outLit := by
  rw [show out = _ from Scc.Cert.PlaceOK.A64.ofEmitted_of_stages lowered_eq emitted_eq]
  kernel_rfl

/-- A1, A2, A4 and A7 of `outLit` (kernel-checked). -/
theorem prog_placeOK_1 : (Scc.Cert.PlaceOK.A64.a1 outLit (Scc.Cert.PlaceOK.A64.tablesOf placeCfg outLit) && Scc.Cert.PlaceOK.A64.a2 outLit (Scc.Cert.PlaceOK.A64.tablesOf placeCfg outLit) &&
    Scc.Cert.PlaceOK.A64.a4 placeCfg outLit (Scc.Cert.PlaceOK.A64.tablesOf placeCfg outLit) && Scc.Cert.PlaceOK.A64.a7 outLit (Scc.Cert.PlaceOK.A64.tablesOf placeCfg outLit)) = true := by
  decide +kernel

/-- A3 of `outLit`: the block table at its places (kernel-checked). -/
theorem prog_placeOK_3 : Scc.Cert.PlaceOK.A64.a3 outLit (Scc.Cert.PlaceOK.A64.tablesOf placeCfg outLit) = true := by
  decide +kernel

/-- A5 of `outLit`: the block table covered at its offsets (kernel-checked). -/
theorem prog_placeOK_5 : Scc.Cert.PlaceOK.A64.a5 outLit (Scc.Cert.PlaceOK.A64.tablesOf placeCfg outLit) = true := by
  decide +kernel

/-- A6 of `outLit`: the block table in its phases (kernel-checked). -/
theorem prog_placeOK_6 : Scc.Cert.PlaceOK.A64.a6 outLit (Scc.Cert.PlaceOK.A64.tablesOf placeCfg outLit) = true := by
  decide +kernel

/-- A8 of `outLit`: the runtime's data words (kernel-checked). -/
theorem prog_placeOK_8 : Scc.Cert.PlaceOK.A64.a8 outLit (Scc.Cert.PlaceOK.A64.tablesOf placeCfg outLit) = true := by
  decide +kernel

/-- A9 of `outLit`: the lowered code blocks (kernel-checked). -/
theorem prog_placeOK_9 : Scc.Cert.PlaceOK.A64.a9 outLit (Scc.Cert.PlaceOK.A64.tablesOf placeCfg outLit) = true := by
  decide +kernel

/-- A11 of `outLit`: the runtime's fixed code (kernel-checked). -/
theorem prog_placeOK_11 : Scc.Cert.PlaceOK.A64.a11 outLit (Scc.Cert.PlaceOK.A64.tablesOf placeCfg outLit) = true := by
  decide +kernel

/-- **`placeOK` of `scc`'s output** for `prog_src`. -/
theorem prog_placeOK : Scc.Cert.PlaceOK.A64.placeOK placeCfg out = true := by
  have h1 := prog_placeOK_1
  simp only [Bool.and_eq_true] at h1
  rw [out_eq]
  exact Scc.Cert.PlaceOK.A64.placeOK_of h1.1.1.1 h1.1.1.2 prog_placeOK_3 h1.1.2 prog_placeOK_5 prog_placeOK_6 h1.2
    prog_placeOK_8 prog_placeOK_9 prog_placeOK_11

/-- **Acceptance and placement** of `prog_src`'s compilation. -/
theorem prog_cert_ready : Scc.Lower.Accepted0 prog_src = true ∧ Scc.Cert.PlaceOK.A64.placeOK placeCfg out = true :=
  ⟨prog_accepted, prog_placeOK⟩

