-- SHA-256 (UTF-8): 10437a369ff36933225c2bdb99999784500c56e74ec4be6a005b82beccb91ae5
/-- The WeakCore source `wake.w`, verbatim. -/
def source : String := "\
  -- Wake: `hello.w` without the output.  `main` spawns `worker` on the flag\n\
  -- cell `c` and its own `ThreadId`, then sleeps (`waitLoop`: an acquire load\n\
  -- of the flag, parking while it is 0); `worker` wakes `main` (a release store\n\
  -- of the flag and `unpark`) and exits; `main` sees the flag and returns 0.\n\
  --\n\
  -- Provisional forms (see Scc/Frontend.lean): `spawn{f}(a)` is the spawn.\n\
  -- `park`, `unpark` and `ThreadId` are WeakCore's own.\n\
  \n\
  def worker(a : Ptr pub Int * ThreadId) : Unit =\n\
  \x20 let (c, j) = a\n\
  \x20 let d = store rel c 1\n\
  \x20 let w = unpark j\n\
  \x20 ret ()\n\
  \n\
  def waitLoop(c : Ptr pub Int) : Int =\n\
  \x20 let d = load acq c\n\
  \x20 if d = 1 then\n\
  \x20   ret 0\n\
  \x20 else\n\
  \x20   let p = park ()\n\
  \x20   tail waitLoop(c)\n\
  \n\
  def main(me : ThreadId) : Int =\n\
  \x20 let z = zero[Int]\n\
  \x20 let o = new[Int] z\n\
  \x20 let c = publish o\n\
  \x20 let p = (c, me)\n\
  \x20 let t = spawn{worker}(p)\n\
  \x20 tail waitLoop(c)\n\
  "

