/-- The WeakCore source `hello1.w`, verbatim. -/
def source : String := "\
  -- Copy of Scc/Test/hello1.w: below this line it must stay identical (regen_a64.sh checks).\n\
  -- Hello, world on one thread: the setup block `rodata` builds the bytes on\n\
  -- the heap (static data by the heap-bytes route); `main` prints them with the\n\
  -- output extern and returns 0.  No spawn, no park/unpark, and no `publish`\n\
  -- (the program is publish-free, `Scc.Sem.PubFree.ProgPubFree`): the slice\n\
  -- stays owned and `print` takes it by its owned signature (`printOwnSig`),\n\
  -- consuming it.  `print`'s body is a WeakCore model that is not compiled;\n\
  -- `ThreadId` is stubbed as `Ptr pub Void`.\n\
  \n\
  def print{m}(a : ({Loc own Array[m] LanesU8 | ini >= m} * Int[m]) * Int) : Unit =\n\
  \x20 ret ()\n\
  \n\
  def rodata(u : Unit) : exists q. ({Loc own Array[q] LanesU8 | ini >= q} * Int[q]) * Int =\n\
  \x20 let two = 2\n\
  \x20 let m = nameI two\n\
  \x20 let b = newBuf[LanesU8] m\n\
  \x20 let w0 = asLanes U8 8583909746840200520\n\
  \x20 let o0 = xchg b[0] w0\n\
  \x20 let w1 = asLanes U8 44634501743\n\
  \x20 let o1 = xchg b[1] w1\n\
  \x20 let n = 13\n\
  \x20 let sm = (b, m)\n\
  \x20 let sl0 = (sm, n)\n\
  \x20 let sl = pack sl0 at m : exists a. ({Loc own Array[a] LanesU8 | ini >= a} * Int[a]) * Int\n\
  \x20 ret sl\n\
  \n\
  def main(a : (exists q. ({Loc own Array[q] LanesU8 | ini >= q} * Int[q]) * Int) * Ptr pub Void) : Int =\n\
  \x20 let (sl0, me) = a\n\
  \x20 let <q, sl> = unpack sl0\n\
  \x20 let u = print{q}(sl)\n\
  \x20 ret 0\n\
  "

