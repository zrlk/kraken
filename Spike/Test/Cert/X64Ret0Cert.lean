def source : String := "\
  -- Copy of Scc/Test/ret0.w: below this line it must stay identical (regen_a64.sh checks).\n\
  -- main returns 40 + 2 = 42: one thread, no allocation, no output; the first\n\
  -- certification target.\n\
  \n\
  def main(u : Unit) : Int =\n\
  \x20 let x = 40\n\
  \x20 let y = x + 2\n\
  \x20 ret y\n\
  "

