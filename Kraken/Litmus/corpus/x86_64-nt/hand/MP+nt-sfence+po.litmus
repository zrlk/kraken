X86_64 MP+nt-sfence+po
"NT data, sfence, plain flag: sfence orders the NT store before the flag"
{
 0:rax=x;
}
 P0                  | P1            ;
 movl $1,%ebx        | movl (y),%ebx ;
 movntil %ebx,(%rax) | movl (x),%ecx ;
 sfence              |               ;
 movl $1,(y)         |               ;

exists (1:rbx=1 /\ 1:rcx=0)
