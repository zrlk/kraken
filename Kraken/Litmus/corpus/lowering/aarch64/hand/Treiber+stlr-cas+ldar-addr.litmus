AArch64 Treiber+stlr-cas+ldar-addr
"Treiber push: STLR init then plain CAS (a release init does not order the later link); reader LDAR top, address-dependent LDR"
{
uint64_t top=d; uint64_t n=0; uint64_t d=2;
0:X1=n; 0:X3=top; 0:X4=d;
1:X3=top; 1:X7=n;
}
 P0             | P1           ;
 MOV X0,#1      | LDAR X5,[X3] ;
 STLR X0,[X1]   | LDR X6,[X5]  ;
 CAS X4,X1,[X3] |              ;
exists (1:X5=n /\ 1:X6=0)
