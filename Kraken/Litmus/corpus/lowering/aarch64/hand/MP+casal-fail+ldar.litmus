AArch64 MP+casal-fail+ldar
"MP: STR x; failing CASAL on z (comparand 2); STR y. A failing CASAL writes nothing and orders neither store"
{
0:X1=x; 0:X3=y; 0:X5=z;
1:X3=y; 1:X1=x;
}
 P0               | P1           ;
 MOV W0,#1        | LDAR W2,[X3] ;
 STR W0,[X1]      | LDR W4,[X1]  ;
 MOV W6,#2        |              ;
 MOV W7,#3        |              ;
 CASAL W6,W7,[X5] |              ;
 STR W0,[X3]      |              ;
exists (1:X2=1 /\ 1:X4=0)
