AArch64 TreiberPop+casl+ldr-addr-casal
"Treiber pop vs push: push writes n.next then CASL top; pop LDR top, address-dependent LDR of next, CASAL top"
{
uint64_t top=d; uint64_t n[2]; uint64_t d[2];
0:X1=n; 0:X3=top; 0:X4=d;
1:X3=top;
}
 P0              | P1               ;
 STR X4,[X1,#8]  | LDR X5,[X3]      ;
 CASL X4,X1,[X3] | LDR X6,[X5,#8]   ;
                 | MOV X8,X5        ;
                 | CASAL X8,X6,[X3] ;
locations [top;]
exists (1:X5=n /\ 1:X6=0)
