AArch64 SB+casas
"SB: each thread CASA 0->1 on its own location, then LDR of the other"
{
0:X2=x; 0:X4=y;
1:X2=y; 1:X4=x;
}
 P0              | P1              ;
 MOV W0,#0       | MOV W0,#0       ;
 MOV W1,#1       | MOV W1,#1       ;
 CASA W0,W1,[X2] | CASA W0,W1,[X2] ;
 LDR W3,[X4]     | LDR W3,[X4]     ;
exists (0:X3=0 /\ 1:X3=0)
