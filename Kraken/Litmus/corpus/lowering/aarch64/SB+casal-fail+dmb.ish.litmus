AArch64 SB+casal-fail+dmb.ish
"SB: STR x; failing CASAL on z; LDR y. A failing CASAL is an acquire read only: it does not order the earlier store"
{
0:X1=x; 0:X3=y; 0:X5=z;
1:X1=x; 1:X3=y;
}
 P0               | P1          ;
 MOV W0,#1        | MOV W0,#1   ;
 STR W0,[X1]      | STR W0,[X3] ;
 MOV W6,#2        | DMB ISH     ;
 MOV W7,#3        | LDR W2,[X1] ;
 CASAL W6,W7,[X5] |             ;
 LDR W2,[X3]      |             ;
exists (0:X2=0 /\ 1:X2=0)
