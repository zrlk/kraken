AArch64 MP+stp-i128-dmb.ish+ldr-dmb.ishld-ldp
"FEAT_LSE2: message passing with a 16-byte payload: STP; DMB ISH; STR flag, reader LDR flag; DMB ISHLD; LDP. No torn read, no stale payload"
{
__int128 x; uint64_t y;
0:X5=x; 0:X6=y;
1:X5=x; 1:X6=y;
uint64_t 1:X7; uint64_t 1:X8; uint64_t 1:X3;
}
 P0             | P1             ;
 MOV X0,#1      | LDR X3,[X6]    ;
 MOV X1,#2      | DMB ISHLD      ;
 STP X0,X1,[X5] | LDP X7,X8,[X5] ;
 DMB ISH        |                ;
 STR X0,[X6]    |                ;
exists (1:X3=1 /\ 1:X7=0 \/ 1:X7=1 /\ 1:X8=0 \/ 1:X7=0 /\ 1:X8=2)
