AArch64 MP+dmb.ish-stp-i128+ldp-dmb.ishld
"FEAT_LSE2: the lowering's release pair store (DMB ISH; STP) as the flag and acquire pair load (LDP; DMB ISHLD) as the reader; the data is a plain word"
{
__int128 x; uint64_t y;
0:X5=x; 0:X6=y;
1:X5=x; 1:X6=y;
uint64_t 1:X7; uint64_t 1:X8; uint64_t 1:X3;
}
 P0             | P1             ;
 MOV X0,#1      | LDP X7,X8,[X5] ;
 MOV X1,#2      | DMB ISHLD      ;
 STR X0,[X6]    | LDR X3,[X6]    ;
 DMB ISH        |                ;
 STP X0,X1,[X5] |                ;
exists (1:X7=1 /\ 1:X8=2 /\ 1:X3=0 \/ 1:X7=1 /\ 1:X8=0 \/ 1:X7=0 /\ 1:X8=2)
