AArch64 CAS+caspal-arr+casal
"CASPAL (0,0)->(1,2) on t[0..1] vs CASAL 0->3 on t[0]: exactly one succeeds; CASP reads both halves at once"
{
uint64_t t[2];
0:X4=t; 1:X4=t;
uint64_t 0:X0; uint64_t 0:X1; uint64_t 1:X5;
}
 P0                      | P1               ;
 MOV X0,#0               | MOV X5,#0        ;
 MOV X1,#0               | MOV X6,#3        ;
 MOV X2,#1               | CASAL X5,X6,[X4] ;
 MOV X3,#2               |                  ;
 CASPAL X0,X1,X2,X3,[X4] |                  ;
locations [t;]
exists (0:X0=0 /\ 1:X5=0)
