AArch64 MP+stp-i128+popl+casa-ldp
"FEAT_LSE2: STP then STLR flag; reader CASA flag 1->2 (fails on 0, still acquire) then LDP. The 16-byte pair is one access; the flag orders it unless a side is plain"
{
__int128 x; uint64_t y;
0:X5=x; 0:X6=y;
1:X5=x; 1:X6=y;
uint64_t 1:X7; uint64_t 1:X8;
}
 P0             | P1              ;
 MOV X0,#1      | MOV X3,#1       ;
 MOV X1,#2      | MOV X4,#2       ;
 STP X0,X1,[X5] | CASA X3,X4,[X6] ;
 STLR X0,[X6]   | LDP X7,X8,[X5]  ;
exists (1:X3=1 /\ 1:X7=0 \/ 1:X7=1 /\ 1:X8=0 \/ 1:X7=0 /\ 1:X8=2)
