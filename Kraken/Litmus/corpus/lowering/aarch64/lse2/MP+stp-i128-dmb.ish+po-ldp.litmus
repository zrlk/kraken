AArch64 MP+stp-i128-dmb.ish+po-ldp
"FEAT_LSE2: control for the 16-byte payload: the reader has no DMB ISHLD, so a stale payload is allowed, but never a torn one"
{
__int128 x; uint64_t y;
0:X5=x; 0:X6=y;
1:X5=x; 1:X6=y;
uint64_t 1:X7; uint64_t 1:X8; uint64_t 1:X3;
}
 P0             | P1             ;
 MOV X0,#1      | LDR X3,[X6]    ;
 MOV X1,#2      | LDP X7,X8,[X5] ;
 STP X0,X1,[X5] |                ;
 DMB ISH        |                ;
 STR X0,[X6]    |                ;
exists (1:X3=1 /\ 1:X7=0 \/ 1:X7=1 /\ 1:X8=0 \/ 1:X7=0 /\ 1:X8=2)
