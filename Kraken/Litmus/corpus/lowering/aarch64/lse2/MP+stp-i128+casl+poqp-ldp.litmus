AArch64 MP+stp-i128+casl+poqp-ldp
"FEAT_LSE2: STP then CASL flag 0->1; reader LDAPR flag then LDP. The 16-byte pair is one access; the flag orders it unless a side is plain"
{
__int128 x; uint64_t y;
0:X5=x; 0:X6=y;
1:X5=x; 1:X6=y;
uint64_t 1:X7; uint64_t 1:X8;
}
 P0              | P1             ;
 MOV X0,#1       | LDAPR X3,[X6]  ;
 MOV X1,#2       | LDP X7,X8,[X5] ;
 STP X0,X1,[X5]  |                ;
 MOV X2,#0       |                ;
 CASL X2,X0,[X6] |                ;
exists (1:X3=1 /\ 1:X7=0 \/ 1:X7=1 /\ 1:X8=0 \/ 1:X7=0 /\ 1:X8=2)
