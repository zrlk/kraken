X86_64 CoWW+movdqa+cmpxchg16b
"movdqa store (1,1) vs lock cmpxchg16b (0,0)->(2,2) on one record: the cmpxchg16b reads a whole record; the movdqa store is last either way"
{
__int128 rec;
0:xmm0=0x10000000000000001;
1:rax=0; 1:rdx=0; 1:rbx=2; 1:rcx=2;
}
 P0                 | P1                    ;
 movdqa %xmm0,(rec) | lock cmpxchg16b (rec) ;
locations [rec;]
exists (1:rax=1 /\ 1:rdx=0 \/ 1:rax=0 /\ 1:rdx=1)
