X86_64 MP16+cmpxchg16b+movdqa
"lock cmpxchg16b (0,0)->(1,1) vs a movdqa load: the load sees a whole record"
{
__int128 rec;
0:rax=0; 0:rdx=0; 0:rbx=1; 0:rcx=1;
}
 P0                    | P1                 ;
 lock cmpxchg16b (rec) | movdqa (rec),%xmm2 ;
exists (not (1:xmm2=0 \/ 1:xmm2=0x10000000000000001))
