X86_64 Treiber+cmpxchg+mov-po
"Treiber push: mov init, lock cmpxchg link; reader: mov top, independent mov of the node"
{
uint64_t top=d; uint64_t n=0; uint64_t d=2;
0:rax=d; 0:rbx=n; 0:rsi=n;
1:rdi=n;
}
 P0                       | P1               ;
 movq $1,(%rsi)           | movq (top),%rax  ;
 lock cmpxchgq %rbx,(top) | movq (%rdi),%rcx ;
exists (1:rax=n /\ 1:rcx=0)
