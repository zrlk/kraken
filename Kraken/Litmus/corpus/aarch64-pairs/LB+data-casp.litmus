AArch64 LB+data-casp
"Control for LB+data-stxr: CASP's new values are data dependencies"
{
uint64_t t[2];
uint64_t x;
0:X5=t; 0:X1=x; 1:X5=t; 1:X1=x;
uint64_t 0:X0; uint64_t 1:X2;
}
P0                   | P1               ;
LDR X0,[X1]          | LDR X2,[X5]      ;
MOV X6,#0            | DMB SY           ;
MOV X7,#0            | MOV X4,#1        ;
MOV X8,X0            | STR X4,[X1]      ;
MOV X9,X0            |                  ;
CASP X6,X7,X8,X9,[X5] |                 ;
exists (0:X0=1 /\ 1:X2=1)
