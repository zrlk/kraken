AArch64 LB+fdata-stxr
"STXR of a value with a false data dependency on the earlier load: herd's read_reg_ord gives no dependency, so LB is allowed"
{
uint64_t f;
uint64_t x;
0:X5=f; 0:X1=x; 1:X5=f; 1:X1=x;
uint64_t 0:X0; uint64_t 1:X2;
}
P0                   | P1               ;
LDR X0,[X1]          | LDR X2,[X5]      ;
EOR X9,X0,X0         | DMB SY           ;
ADD X9,X9,#1         | MOV X4,#1        ;
LDXR X6,[X5]         | STR X4,[X1]      ;
STXR W8,X9,[X5]      |                  ;
exists (0:X0=1 /\ 1:X2=1)
