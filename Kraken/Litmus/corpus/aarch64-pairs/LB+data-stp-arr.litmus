AArch64 LB+data-stp-arr
"Control for LB+data-stxp-arr: STP's data registers are data dependencies"
{
uint64_t t[2];
uint64_t x;
0:X5=t; 0:X1=x; 1:X5=t; 1:X1=x;
uint64_t 0:X0; uint64_t 1:X2;
}
P0                   | P1               ;
LDR X0,[X1]          | LDR X2,[X5]      ;
STP X0,X0,[X5]       | DMB SY           ;
                     | MOV X4,#1        ;
                     | STR X4,[X1]      ;
exists (0:X0=1 /\ 1:X2=1)
