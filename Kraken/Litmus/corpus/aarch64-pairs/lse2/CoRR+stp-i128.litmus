AArch64 CoRR+stp-i128
"FEAT_LSE2: two aligned 16-byte STPs to one location: the reader's two LDPs see whole values in coherence order"
{
__int128 x;
0:X5=x; 1:X5=x;
uint64_t 1:X2; uint64_t 1:X3; uint64_t 1:X6; uint64_t 1:X7;
}
P0                  | P1               ;
MOV X0,#1           | LDP X2,X3,[X5]   ;
MOV X1,#1           | LDP X6,X7,[X5]   ;
STP X0,X1,[X5]      |                  ;
MOV X0,#2           |                  ;
MOV X1,#2           |                  ;
STP X0,X1,[X5]      |                  ;
exists (1:X2=2 /\ 1:X6=1)
