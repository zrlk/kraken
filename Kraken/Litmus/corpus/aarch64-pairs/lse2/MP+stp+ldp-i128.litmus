AArch64 MP+stp+ldp-i128
"FEAT_LSE2: an aligned 16-byte STP and LDP of a 16-byte location are single-copy atomic, so the reader sees both halves or neither"
{
__int128 x;
0:X5=x; 1:X5=x;
uint64_t 1:X2; uint64_t 1:X3;
}
P0                  | P1               ;
MOV X0,#1           | LDP X2,X3,[X5]   ;
MOV X1,#2           |                  ;
STP X0,X1,[X5]      |                  ;
exists (1:X2=1 /\ 1:X3=0 \/ 1:X2=0 /\ 1:X3=2)
