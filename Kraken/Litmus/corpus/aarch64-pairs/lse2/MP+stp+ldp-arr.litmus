AArch64 MP+stp+ldp-arr
"FEAT_LSE2 control: on two 8-byte array elements (no 16-byte location) STP and LDP stay two accesses, so torn reads remain"
{
uint64_t t[2];
0:X5=t; 1:X5=t;
uint64_t 1:X2; uint64_t 1:X3;
}
P0                  | P1               ;
MOV X0,#1           | LDP X2,X3,[X5]   ;
MOV X1,#2           |                  ;
STP X0,X1,[X5]      |                  ;
exists (1:X2=1 /\ 1:X3=0 \/ 1:X2=0 /\ 1:X3=2)
