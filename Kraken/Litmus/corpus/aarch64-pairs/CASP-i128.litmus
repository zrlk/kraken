AArch64 CASP-i128
"CASP on a 16-byte location: Kraken performs it as two 8-byte halves, which is a mixed-size access it rejects (unsupported)"
{
__int128 x;
0:X4=x;
uint64_t 0:X0; uint64_t 0:X1;
}
P0                        ;
MOV X0,#0                 ;
MOV X1,#0                 ;
MOV X2,#1                 ;
MOV X3,#2                 ;
CASP X0,X1,X2,X3,[X4]     ;
LDXP X6,X7,[X4]           ;
exists (0:X6=1 /\ 0:X7=2)
