AArch64 MP+stlxp-arr+dmb.sy
"STLXP of two array elements: both halves are releases, so the earlier store to y is ordered before the high half"
{
uint64_t t[2];
uint64_t y;
0:X0=t; 0:X4=y; 1:X0=t; 1:X4=y;
uint64_t 1:X3; uint64_t 1:X5;
}
P0                   | P1               ;
MOV X1,#1            | ADD X6,X0,#8     ;
STR X1,[X4]          | LDR X3,[X6]      ;
LDXP X8,X9,[X0]      | DMB SY           ;
STLXP W7,X1,X1,[X0]  | LDR X5,[X4]      ;
exists (1:X3=1 /\ 1:X5=0)
