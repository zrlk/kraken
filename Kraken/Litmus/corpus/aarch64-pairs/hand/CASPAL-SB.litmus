AArch64 CASPAL-SB
"Two CASPAL on overlapping pairs: the atomicity of each half"
{
uint64_t t[3];
0:X4=t; 1:X4=t;
uint64_t 0:X0; uint64_t 0:X1; uint64_t 1:X0; uint64_t 1:X1;
}
P0                        | P1                      ;
MOV X0,#0                 | MOV X0,#0               ;
MOV X1,#0                 | MOV X1,#0               ;
MOV X2,#1                 | MOV X2,#2               ;
MOV X3,#1                 | MOV X3,#2               ;
CASPAL X0,X1,X2,X3,[X4]   | ADD X5,X4,#8            ;
                          | CASPAL X0,X1,X2,X3,[X5] ;
exists (0:X0=0 /\ 0:X1=0 /\ 1:X0=0 /\ 1:X1=0)
