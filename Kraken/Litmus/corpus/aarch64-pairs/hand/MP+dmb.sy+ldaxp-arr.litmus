AArch64 MP+dmb.sy+ldaxp-arr
"LDAXP of two array elements: both halves are acquires, so the later plain load of y is ordered after them"
{
uint64_t t[2];
uint64_t y;
0:X0=t; 0:X4=y; 1:X0=t; 1:X4=y;
uint64_t 1:X2; uint64_t 1:X3; uint64_t 1:X5;
}
P0              | P1               ;
MOV X1,#1       | LDAXP X2,X3,[X0] ;
STR X1,[X4]     | LDR X5,[X4]      ;
DMB SY          |                  ;
ADD X6,X0,#8    |                  ;
STR X1,[X6]     |                  ;
exists (1:X3=1 /\ 1:X5=0)
