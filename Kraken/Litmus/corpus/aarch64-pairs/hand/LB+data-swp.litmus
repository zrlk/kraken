AArch64 LB+data-swp
"Control for LB+data-stxr: SWP's stored value is a data dependency"
{
uint64_t t[2];
uint64_t x;
0:X5=t; 0:X1=x; 1:X5=t; 1:X1=x;
uint64_t 0:X0; uint64_t 1:X2;
}
P0                   | P1               ;
LDR X0,[X1]          | LDR X2,[X5]      ;
MOV X6,#0            | DMB SY           ;
SWP X0,X6,[X5]       | MOV X4,#1        ;
                     | STR X4,[X1]      ;
exists (0:X0=1 /\ 1:X2=1)
