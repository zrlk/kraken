AArch64 LDAXP-STLXP-i128-MP
"Release STLXP of a 16-byte location after a data write, acquire LDAXP reading it"
{
__int128 x;
uint64_t y;
0:X5=x; 0:X6=y; 1:X5=x; 1:X6=y;
uint64_t 1:X2; uint64_t 1:X3; uint64_t 1:X4;
}
P0                   | P1               ;
MOV X0,#1            | LDAXP X2,X3,[X5] ;
STR X0,[X6]          | LDR X4,[X6]      ;
LDXP X8,X9,[X5]      |                  ;
STLXP W7,X0,X0,[X5]  |                  ;
exists (1:X2=1 /\ 1:X4=0)
