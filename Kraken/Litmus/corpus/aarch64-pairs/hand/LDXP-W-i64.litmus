AArch64 LDXP-W-i64
"LDXP/STXP of two W registers on an 8-byte location: one access"
{
uint64_t x;
0:X5=x; 1:X5=x;
uint32_t 1:X2; uint32_t 1:X3;
}
P0                  | P1               ;
MOV W0,#1           | LDXP W2,W3,[X5]  ;
MOV W1,#2           |                  ;
LDXP W6,W7,[X5]     |                  ;
STXP W8,W0,W1,[X5]  |                  ;
exists (1:X2=1 /\ 1:X3=0)
