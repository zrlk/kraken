AArch64 MP+ldxp-i128
"A 16-byte location written by STXP and read by LDXP: single-copy atomic, no torn read"
{
__int128 x;
0:X5=x; 1:X5=x;
uint64_t 1:X2; uint64_t 1:X3;
}
P0                  | P1               ;
MOV X0,#1           | LDXP X2,X3,[X5]  ;
MOV X1,#2           |                  ;
LDXP X6,X7,[X5]     |                  ;
STXP W8,X0,X1,[X5]  |                  ;
exists (1:X2=1 /\ 1:X3=0)
