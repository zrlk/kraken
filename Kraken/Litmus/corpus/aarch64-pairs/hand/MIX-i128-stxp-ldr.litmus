AArch64 MIX-i128-stxp-ldr
"A 16-byte location written by STXP and read by plain 8-byte LDRs of each half"
{
__int128 x;
0:X5=x; 1:X5=x;
uint64_t 1:X2; uint64_t 1:X3;
}
P0                  | P1               ;
MOV X0,#1           | LDR X3,[X5,#8]   ;
MOV X1,#2           | DMB SY           ;
LDXP X6,X7,[X5]     | LDR X2,[X5]      ;
STXP W8,X0,X1,[X5]  |                  ;
exists (1:X3=2 /\ 1:X2=0)
