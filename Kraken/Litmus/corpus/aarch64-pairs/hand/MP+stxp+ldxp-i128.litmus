AArch64 MP+stxp+ldxp-i128
"Control for MP+stlxp+ldaxp-i128: without release/acquire the data access is unordered"
{
__int128 f;
uint64_t y;
0:X5=f; 0:X1=y; 1:X5=f; 1:X1=y;
uint64_t 1:X2; uint64_t 1:X3; uint64_t 1:X4;
}
P0                   | P1               ;
MOV X0,#1            | LDXP X2,X3,[X5]  ;
STR X0,[X1]          | LDR X4,[X1]      ;
MOV X2,#1            |                  ;
MOV X3,#1            |                  ;
LDXP X6,X7,[X5]      |                  ;
STXP W8,X2,X3,[X5]   |                  ;
exists (1:X2=1 /\ 1:X4=0)
