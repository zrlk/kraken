AArch64 CASP-fail-W
"CASP of W registers: success and failure against a concurrent write of one half"
{
uint32_t t[2];
0:X4=t; 1:X4=t;
uint32_t 0:X0; uint32_t 0:X1;
}
P0                        | P1            ;
MOV W0,#0                 | MOV W1,#9     ;
MOV W1,#0                 | STR W1,[X4,#4];
MOV W2,#1                 |               ;
MOV W3,#2                 |               ;
CASP W0,W1,W2,W3,[X4]     |               ;
exists (0:X0=0 /\ 0:X1=9)
