AArch64 MP+dmb.sy+ldp-arr
"LDP control for MP+dmb.sy+ldxp-arr: two independent reads"
{
uint64_t t[2];
0:X0=t; 1:X0=t;
uint64_t 1:X2; uint64_t 1:X3;
}
P0              | P1              ;
MOV X1,#1       | LDP X2,X3,[X0]  ;
ADD X5,X0,#8    |                 ;
STR X1,[X5]     |                 ;
DMB SY          |                 ;
STR X1,[X0]     |                 ;
exists (1:X2=1 /\ 1:X3=0)
