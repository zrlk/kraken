AArch64 MP+dmb.st+addr-ldp
{
int64_t y[2]; int64_t f;
0:X1=y; 0:X2=f;
1:X1=y; 1:X2=f;
}
 P0                      |  P1                      ;
 MOV X9,#1               |  LDR X0,[X2]             ;
 STP X9,X9,[X1]          |  EOR X3,X0,X0            ;
 DMB ST                  |  ADD X3,X3,X1            ;
 STR X9,[X2]             |  LDP X4,X5,[X3]          ;
exists (1:X0=1 /\ (1:X4=0 \/ 1:X5=0))
