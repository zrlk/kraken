AArch64 DSBST-leak
"A plain store promised early, then DSB ST and a stale read"
{
0:X1=z; 0:X3=d; 0:X5=y;
1:X1=y; 1:X3=z;
}
 P0          | P1           ;
 LDR W0,[X1] | MOV W2,#1    ;
 MOV W2,#1   | STLR W2,[X1] ;
 STR W2,[X3] | STLR W2,[X3] ;
 DSB ST      |              ;
 LDR W4,[X5] |              ;
exists (0:X0=1 /\ 0:X4=0)
