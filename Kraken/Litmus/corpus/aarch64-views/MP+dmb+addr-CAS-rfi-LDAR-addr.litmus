AArch64 MP+dmb+addr-CAS-rfi-LDAR-addr
"MP: CAS address-dependent on the flag read, LDAR re-read, then address-dependent LDR of the data"
{
0:X1=z; 0:X2=x;
1:X1=z; 1:X2=x; 1:X4=y;
}
 P0          | P1                   ;
 MOV W0,#1   | MOV W11,#1           ;
 STR W0,[X1] | LDR W0,[X2]          ;
 DMB SY      | EOR W8,W0,W0         ;
 STR W0,[X2] | ADD X9,X4,W8,SXTW    ;
             | MOV W3,#0            ;
             | CAS W3,W11,[X9]      ;
             | LDAR W5,[X4]         ;
             | EOR W6,W5,W5         ;
             | LDR W10,[X1,W6,SXTW] ;
exists (1:X0=1 /\ 1:X5=1 /\ 1:X10=0)
