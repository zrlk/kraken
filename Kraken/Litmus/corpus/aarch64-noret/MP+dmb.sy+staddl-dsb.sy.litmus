AArch64 MP+dmb.sy+staddl-dsb.sy
"write; DMB SY; write || staddl; dsb.sy; read"
{

0:X1=x; 0:X3=y;
1:X1=y; 1:X3=x;
}
 P0          | P1             ;
 MOV W0,#1   | MOV W0,#1      ;
 STR W0,[X1] | STADDL W0,[X1] ;
 DMB SY      | DSB SY         ;
 MOV W2,#2   | LDR W7,[X3]    ;
 STR W2,[X3] |                ;
exists ([y]=3 /\ 1:X7=0)
