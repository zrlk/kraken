AArch64 S+dmb.sy+casa.reg-dmb.ld
"write; DMB SY; write || casa.reg; dmb.ld; write"
{
y=5; 
0:X1=x; 0:X3=y;
1:X1=y; 1:X3=x;
}
 P0           | P1              ;
 MOV W0,#2    | MOV W4,#3       ;
 STR W0,[X1]  | MOV W6,#0       ;
 DMB SY       | CASA W6,W4,[X1] ;
 STR WZR,[X3] | DMB LD          ;
              | MOV W7,#1       ;
              | STR W7,[X3]     ;
exists ([y]=3 /\ [x]=2)
