AArch64 WRC+swpa.zr-dmb.ld+dmb.sy
"write || swpa.zr; dmb.ld; write || read; DMB SY; read"
{

0:X1=x;
1:X1=x; 1:X3=y;
2:X1=y; 2:X3=x;
}
 P0          | P1               | P2          ;
 MOV W2,#2   | MOV W0,#1        | LDR W0,[X1] ;
 STR W2,[X1] | SWPA W0,WZR,[X1] | DMB SY      ;
             | DMB LD           | LDR W2,[X3] ;
             | MOV W7,#1        |             ;
             | STR W7,[X3]      |             ;
exists ([x]=1 /\ 2:X0=1 /\ 2:X2=0)
