AArch64 MP+dmb.sy+ldclr.zr-dmb.ld
"write; DMB SY; write || ldclr.zr; dmb.ld; read"
{

0:X1=x; 0:X3=y;
1:X1=y; 1:X3=x;
}
 P0          | P1                ;
 MOV W0,#1   | MOV W0,#1         ;
 STR W0,[X1] | LDCLR W0,WZR,[X1] ;
 DMB SY      | DMB LD            ;
 MOV W2,#3   | LDR W7,[X3]       ;
 STR W2,[X3] |                   ;
exists ([y]=2 /\ 1:X7=0)
