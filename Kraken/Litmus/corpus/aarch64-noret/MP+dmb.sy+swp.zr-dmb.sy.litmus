AArch64 MP+dmb.sy+swp.zr-dmb.sy
"write; DMB SY; write || swp.zr; dmb.sy; read"
{

0:X1=x; 0:X3=y;
1:X1=y; 1:X3=x;
}
 P0          | P1              ;
 MOV W0,#1   | MOV W0,#1       ;
 STR W0,[X1] | SWP W0,WZR,[X1] ;
 DMB SY      | DMB SY          ;
 MOV W2,#2   | LDR W7,[X3]     ;
 STR W2,[X3] |                 ;
exists ([y]=1 /\ 1:X7=0)
