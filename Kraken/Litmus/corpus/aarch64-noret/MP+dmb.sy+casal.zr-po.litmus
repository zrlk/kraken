AArch64 MP+dmb.sy+casal.zr-po
"write; DMB SY; write || casal.zr; po; read"
{
y=5; 
0:X1=x; 0:X3=y;
1:X1=y; 1:X3=x;
}
 P0           | P1                ;
 MOV W0,#1    | MOV W4,#3         ;
 STR W0,[X1]  | CASAL WZR,W4,[X1] ;
 DMB SY       | LDR W7,[X3]       ;
 STR WZR,[X3] |                   ;
exists ([y]=3 /\ 1:X7=0)
