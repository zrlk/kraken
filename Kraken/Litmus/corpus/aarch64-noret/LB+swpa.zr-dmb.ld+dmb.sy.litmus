AArch64 LB+swpa.zr-dmb.ld+dmb.sy
"swpa.zr; dmb.ld; write || read; DMB SY; write"
{

0:X1=x; 0:X3=y;
1:X1=y; 1:X3=x;
}
 P0               | P1          ;
 MOV W0,#1        | LDR W0,[X1] ;
 SWPA W0,WZR,[X1] | DMB SY      ;
 DMB LD           | MOV W2,#2   ;
 MOV W7,#1        | STR W2,[X3] ;
 STR W7,[X3]      |             ;
exists ([x]=1 /\ 1:X0=1)
