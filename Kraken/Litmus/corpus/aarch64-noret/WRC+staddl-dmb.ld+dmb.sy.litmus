AArch64 WRC+staddl-dmb.ld+dmb.sy
"write || staddl; dmb.ld; write || read; DMB SY; read"
{

0:X1=x;
1:X1=x; 1:X3=y;
2:X1=y; 2:X3=x;
}
 P0          | P1             | P2          ;
 MOV W2,#2   | MOV W0,#1      | LDR W0,[X1] ;
 STR W2,[X1] | STADDL W0,[X1] | DMB SY      ;
             | DMB LD         | LDR W2,[X3] ;
             | MOV W7,#1      |             ;
             | STR W7,[X3]    |             ;
exists ([x]=3 /\ 2:X0=1 /\ 2:X2=0)
