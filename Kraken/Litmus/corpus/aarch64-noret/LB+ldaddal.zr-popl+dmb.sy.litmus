AArch64 LB+ldaddal.zr-popl+dmb.sy
"ldaddal.zr; popl; write || read; DMB SY; write"
{

0:X1=x; 0:X3=y;
1:X1=y; 1:X3=x;
}
 P0                  | P1          ;
 MOV W0,#1           | LDR W0,[X1] ;
 LDADDAL W0,WZR,[X1] | DMB SY      ;
 MOV W7,#1           | MOV W2,#2   ;
 STLR W7,[X3]        | STR W2,[X3] ;
exists ([x]=3 /\ 1:X0=1)
