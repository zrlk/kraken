AArch64 MP+dmb.sy+swpal.zr-po
"write; DMB SY; write || swpal.zr; po; read"
{

0:X1=x; 0:X3=y;
1:X1=y; 1:X3=x;
}
 P0          | P1                ;
 MOV W0,#1   | MOV W0,#1         ;
 STR W0,[X1] | SWPAL W0,WZR,[X1] ;
 DMB SY      | LDR W7,[X3]       ;
 MOV W2,#2   |                   ;
 STR W2,[X3] |                   ;
exists ([y]=1 /\ 1:X7=0)
