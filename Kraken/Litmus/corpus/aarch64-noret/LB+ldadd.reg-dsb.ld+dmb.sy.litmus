AArch64 LB+ldadd.reg-dsb.ld+dmb.sy
"ldadd.reg; dsb.ld; write || read; DMB SY; write"
{

0:X1=x; 0:X3=y;
1:X1=y; 1:X3=x;
}
 P0               | P1          ;
 MOV W0,#1        | LDR W0,[X1] ;
 LDADD W0,W5,[X1] | DMB SY      ;
 DSB LD           | MOV W2,#2   ;
 MOV W7,#1        | STR W2,[X3] ;
 STR W7,[X3]      |             ;
exists ([x]=3 /\ 1:X0=1)
