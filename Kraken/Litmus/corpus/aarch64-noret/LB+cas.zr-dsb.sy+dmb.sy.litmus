AArch64 LB+cas.zr-dsb.sy+dmb.sy
"cas.zr; dsb.sy; write || read; DMB SY; write"
{
x=5; 
0:X1=x; 0:X3=y;
1:X1=y; 1:X3=x;
}
 P0              | P1           ;
 MOV W4,#3       | LDR W0,[X1]  ;
 CAS WZR,W4,[X1] | DMB SY       ;
 DSB SY          | STR WZR,[X3] ;
 MOV W7,#1       |              ;
 STR W7,[X3]     |              ;
exists ([x]=3 /\ 1:X0=1)
