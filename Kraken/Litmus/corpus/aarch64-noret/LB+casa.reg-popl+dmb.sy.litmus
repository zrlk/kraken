AArch64 LB+casa.reg-popl+dmb.sy
"casa.reg; popl; write || read; DMB SY; write"
{
x=5; 
0:X1=x; 0:X3=y;
1:X1=y; 1:X3=x;
}
 P0              | P1           ;
 MOV W4,#3       | LDR W0,[X1]  ;
 MOV W6,#0       | DMB SY       ;
 CASA W6,W4,[X1] | STR WZR,[X3] ;
 MOV W7,#1       |              ;
 STLR W7,[X3]    |              ;
exists ([x]=3 /\ 1:X0=1)
