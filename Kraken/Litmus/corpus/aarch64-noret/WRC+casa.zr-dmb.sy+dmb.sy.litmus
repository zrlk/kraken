AArch64 WRC+casa.zr-dmb.sy+dmb.sy
"write || casa.zr; dmb.sy; write || read; DMB SY; read"
{
x=5; 
0:X1=x;
1:X1=x; 1:X3=y;
2:X1=y; 2:X3=x;
}
 P0           | P1               | P2          ;
 STR WZR,[X1] | MOV W4,#3        | LDR W0,[X1] ;
              | CASA WZR,W4,[X1] | DMB SY      ;
              | DMB SY           | LDR W2,[X3] ;
              | MOV W7,#1        |             ;
              | STR W7,[X3]      |             ;
exists ([x]=3 /\ 2:X0=1 /\ 2:X2=5)
