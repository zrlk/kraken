AArch64 2+2W+casa.zr-dsb.ld+dmb.sy
"casa.zr; dsb.ld; write || write; DMB SY; write"
{
x=5; 
0:X1=x; 0:X3=y;
1:X1=y; 1:X3=x;
}
 P0               | P1           ;
 MOV W4,#3        | MOV W2,#2    ;
 CASA WZR,W4,[X1] | STR W2,[X1]  ;
 DSB LD           | DMB SY       ;
 MOV W7,#1        | STR WZR,[X3] ;
 STR W7,[X3]      |              ;
exists ([x]=3 /\ [y]=2)
