AArch64 MP+dmb.sy+casa.reg-dsb.sy
"write; DMB SY; write || casa.reg; dsb.sy; read"
{
y=5; 
0:X1=x; 0:X3=y;
1:X1=y; 1:X3=x;
}
 P0           | P1              ;
 MOV W0,#1    | MOV W4,#3       ;
 STR W0,[X1]  | MOV W6,#0       ;
 DMB SY       | CASA W6,W4,[X1] ;
 STR WZR,[X3] | DSB SY          ;
              | LDR W7,[X3]     ;
exists ([y]=3 /\ 1:X7=0)
