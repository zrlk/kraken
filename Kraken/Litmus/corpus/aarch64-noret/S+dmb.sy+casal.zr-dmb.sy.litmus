AArch64 S+dmb.sy+casal.zr-dmb.sy
"write; DMB SY; write || casal.zr; dmb.sy; write"
{
y=5; 
0:X1=x; 0:X3=y;
1:X1=y; 1:X3=x;
}
 P0           | P1                ;
 MOV W0,#2    | MOV W4,#3         ;
 STR W0,[X1]  | CASAL WZR,W4,[X1] ;
 DMB SY       | DMB SY            ;
 STR WZR,[X3] | MOV W7,#1         ;
              | STR W7,[X3]       ;
exists ([y]=3 /\ [x]=2)
