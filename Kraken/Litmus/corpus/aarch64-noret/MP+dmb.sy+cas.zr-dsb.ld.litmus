AArch64 MP+dmb.sy+cas.zr-dsb.ld
"write; DMB SY; write || cas.zr; dsb.ld; read"
{
y=5; 
0:X1=x; 0:X3=y;
1:X1=y; 1:X3=x;
}
 P0           | P1              ;
 MOV W0,#1    | MOV W4,#3       ;
 STR W0,[X1]  | CAS WZR,W4,[X1] ;
 DMB SY       | DSB LD          ;
 STR WZR,[X3] | LDR W7,[X3]     ;
exists ([y]=3 /\ 1:X7=0)
