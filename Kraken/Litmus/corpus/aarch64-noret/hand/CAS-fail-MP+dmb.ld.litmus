AArch64 CAS-fail-MP+dmb.ld
"CASA WZR (failing: y is never 0) then DMB LD then a read: neither the acquire nor DMB LD orders the NoRet read"
{
y=5;
0:X1=x; 0:X3=y;
1:X1=y; 1:X3=x; 1:X4=3;
}
 P0           | P1               ;
 MOV W0,#1    | CASA WZR,W4,[X1] ;
 STR W0,[X1]  | DMB LD           ;
 DMB SY       | LDR W7,[X3]      ;
 MOV W2,#6    |                  ;
 STR W2,[X3]  |                  ;
exists ([y]=6 /\ 1:X7=0)
