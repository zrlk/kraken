AArch64 CAS-fail-SB+dmb.sy
"CAS WZR fails (x is 1 or 2, never 0); DMB SY orders the write before it and the read after it"
{
x=1;
0:X1=x; 0:X3=y; 0:X4=3;
1:X1=y; 1:X3=x;
}
 P0               | P1          ;
 MOV W0,#1        | MOV W0,#1   ;
 STR W0,[X3]      | STR W0,[X1] ;
 CAS WZR,W4,[X1]  | DMB SY      ;
 DMB SY           | LDR W2,[X3] ;
 LDR W5,[X3]      |             ;
exists (0:X5=0 /\ 1:X2=1)
