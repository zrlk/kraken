AArch64 S+dmb.sy+ldadd.zr-dmb.sy
"write; DMB SY; write || ldadd.zr; dmb.sy; write"
{

0:X1=x; 0:X3=y;
1:X1=y; 1:X3=x;
}
 P0          | P1                ;
 MOV W0,#2   | MOV W0,#1         ;
 STR W0,[X1] | LDADD W0,WZR,[X1] ;
 DMB SY      | DMB SY            ;
 MOV W2,#2   | MOV W7,#1         ;
 STR W2,[X3] | STR W7,[X3]       ;
exists ([y]=3 /\ [x]=2)
