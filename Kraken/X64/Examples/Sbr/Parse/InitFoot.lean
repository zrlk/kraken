    m.storeInt (p + 0x9e40#64) 8 w =⋆ ElemS p { v with pr0 := Int.toBytes 8 w } ⋆ F := by
  rw [ElemS_pr0, Std.ExtHashMap.sep_assoc] at h
  rw [ElemS_pr0, Std.ExtHashMap.sep_assoc]
  exact Val.storeInt h (Split.here _ _) hl w

theorem ElemS_ld_pr0 (h : m =⋆ ElemS p v ⋆ F) (hl : v.pr0.length = 8) :
    m.loadInt (p + 0x9e40#64) 8 = some (Int.ofBytes v.pr0) := by
  rw [ElemS_pr0, Std.ExtHashMap.sep_assoc] at h
  exact Val.loadInt h (Split.here _ _) hl (by decide)

theorem ElemS_out_pr0 (h : m =⋆ ElemS p v ⋆ F) (hl : v.pr0.length = 8) :
    m =⋆ 8 ?@ (p + 0x9e40#64) ⋆ (ElemH_pr0 p v ⋆ F) := by
  rw [ElemS_pr0, Std.ExtHashMap.sep_assoc] at h
  have h' := Val.forget h (Split.here _ _) (by rw [hl]; decide)
  rw [hl] at h'; exact h'

theorem ElemS_in_pr0 (h : m =⋆ 8 ?@ (p + 0x9e40#64) ⋆ (ElemH_pr0 p v ⋆ F)) :
    ∃ bs : List UInt8, bs.length = 8 ∧ m =⋆ ElemS p { v with pr0 := bs } ⋆ F := by
  obtain ⟨-, bs, hlen, h'⟩ := Block.sep_elim h
  refine ⟨bs, hlen, ?_⟩
  rw [ElemS_pr0, Std.ExtHashMap.sep_assoc]
  exact h'

