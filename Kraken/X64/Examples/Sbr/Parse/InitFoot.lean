theorem zs_add (n k : Nat) : zs (n + k) = zs n ++ zs k := (List.replicate_append_replicate ..).symm

theorem zs_len (n : Nat) : (zs n).length = n := List.length_replicate ..

/-- A zero run at `p + o` split at `n`. -/
theorem zs_split (p : BitVec 64) (o n k : Nat) (h : n + k ≤ 2 ^ 64) :
    zs (n + k) =@ (p + BitVec.ofNat 64 o)
      = zs n =@ (p + BitVec.ofNat 64 o) ⋆ zs k =@ (p + BitVec.ofNat 64 (o + n)) := by
  rw [zs_add, Val.append_eq (zs n) (zs k) _ _ ?_ (by rw [zs_len, zs_len]; exact h)]
  rw [zs_len, BitVec.add_assoc, BitVec.ofNat_add]

/-- A zero run at `p` split at `n`. -/
theorem zs_split0 (p : BitVec 64) (n k : Nat) (h : n + k ≤ 2 ^ 64) :
    zs (n + k) =@ p = zs n =@ p ⋆ zs k =@ (p + BitVec.ofNat 64 n) := by
  rw [zs_add, Val.append_eq (zs n) (zs k) _ _ ?_ (by rw [zs_len, zs_len]; exact h)]
  rw [zs_len]

/-- The zeroed element is `ElemS` at `ev0`. -/
theorem zs_elemS (p : BitVec 64) : zs 0x88ba0 =@ p = ElemS p ev0 := by
  rw [show (0x88ba0 : Nat) = 0x9e40 + 0x7ed60 from rfl, zs_split0 p 0x9e40 0x7ed60 (by decide)]
  try simp only [Nat.reduceAdd]
  rw [show (0x7ed60 : Nat) = 0x8 + 0x7ed58 from rfl, zs_split p 0x9e40 0x8 0x7ed58 (by decide)]
  try simp only [Nat.reduceAdd]
  rw [show (0x7ed58 : Nat) = 0x9db8 + 0x74fa0 from rfl, zs_split p 0x9e48 0x9db8 0x74fa0 (by decide)]
  try simp only [Nat.reduceAdd]
  rw [show (0x74fa0 : Nat) = 0x8 + 0x74f98 from rfl, zs_split p 0x13c00 0x8 0x74f98 (by decide)]
  try simp only [Nat.reduceAdd]
  rw [show (0x74f98 : Nat) = 0x14d1c + 0x6027c from rfl, zs_split p 0x13c08 0x14d1c 0x6027c (by decide)]
  try simp only [Nat.reduceAdd]
  rw [show (0x6027c : Nat) = 0x8 + 0x60274 from rfl, zs_split p 0x28924 0x8 0x60274 (by decide)]
  try simp only [Nat.reduceAdd]
  rw [show (0x60274 : Nat) = 0x4 + 0x60270 from rfl, zs_split p 0x2892c 0x4 0x60270 (by decide)]
  try simp only [Nat.reduceAdd]
  rw [show (0x60270 : Nat) = 0x4 + 0x6026c from rfl, zs_split p 0x28930 0x4 0x6026c (by decide)]
  try simp only [Nat.reduceAdd]
  rw [show (0x6026c : Nat) = 0x8 + 0x60264 from rfl, zs_split p 0x28934 0x8 0x60264 (by decide)]
  try simp only [Nat.reduceAdd]
  rw [show (0x60264 : Nat) = 0x4 + 0x60260 from rfl, zs_split p 0x2893c 0x4 0x60260 (by decide)]
  try simp only [Nat.reduceAdd]
  rw [show (0x60260 : Nat) = 0x2 + 0x6025e from rfl, zs_split p 0x28940 0x2 0x6025e (by decide)]
  try simp only [Nat.reduceAdd]
  rw [show (0x6025e : Nat) = 0x32 + 0x6022c from rfl, zs_split p 0x28942 0x32 0x6022c (by decide)]
