import Kraken.X64.Examples.Sbr.Parse.ResetBase

/-!
# `sbr_reset`: the memory inside the body and its focus equations

Generated by `scripts/sbr/parse/reset/foot.py`. `Mm` is a flat separating conjunction of
cells (atoms); `Mm_<x> : Mm … = X ⋆ Mx_<x> …` brings the atom `x` to the front, the rest
`Mx_<x>` does not mention `x` (a store into `x` keeps it; a change of `st` that only
touches `x` leaves it unchanged by `rfl`).

* `reserve`: the callees' stack
* `fr`: the frame region (`rbp - 0x570`, 0x548 bytes)
* `saved`: the six pushes
* `ret`: the return address
* `sr`: `sample_rate`
* `start`: `start`
* `ready`: `ready_for_dequant`
* `usac`: `usac`
* `sp`: `spectrum_params`
* `lb`: `bs_limiter_bands`
* `k0`: `k[0]`
* `k1`: `k[1]`
* `k2`: `k[2]`
* `kx1`: `kx[1]`
* `m1`: `m[1]`
* `nm`: `n_master`
* `n0`: `n[0]`
* `n1`: `n[1]`
* `nq`: `n_q`
* `nlim`: `n_lim`
* `fm`: `f_master`
* `ftLow`: `f_tablelow`
* `ftHigh`: `f_tablehigh`
* `ftNoise`: `f_tablenoise`
* `ftLim`: `f_tablelim`
* `npatch`: `num_patches`
* `pnum`: `patch_num_subbands`
* `pstart`: `patch_start_subband`
* `ea0`: `data[0].e_a[1]` (raw)
* `idx0`: `data[0].f_indexnoise`, `f_indexsine`
* `ea1`: `data[1].e_a[1]` (raw)
* `idx1`: `data[1].f_indexnoise`, `f_indexsine`
* `avctx`: `ac->avctx`
* `cst`: `sbr_offset` and the constants
* `bw`: `sbr_make_f_tablelim`'s table
* `ext`: the callees' state
* `R`: the caller's memory
-/

open Kraken Kraken.SysV Mem Kraken.X64.Parser Std.WP MachineWP
open Kraken.Examples.Sbr Kraken.Examples.Sbr.Apply Kraken.Examples.Sbr.ParseModel
open Kraken.Examples.Sbr.Parse

namespace Kraken.Examples.Sbr.Reset

variable [CodeEnv]

/-- The memory at every label inside the body. -/
def Mm (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ : MachineData) (st : St) (fr : List UInt8) : Mem 64 → Prop :=
  Reserve (8 + tlimNeed k) ((t₀.regs.get64 .rsp) - 0x578#64) ⋆ fr =@ ((t₀.regs.get64 .rsp) - 0x578#64)
    ⋆ Saved t₀ ⋆ RetCell ra (t₀.regs.get64 .rsp) ⋆ cell4 (arg1 t₀) st.x.sampleRate
    ⋆ cell4 ((arg1 t₀) + 0x4#64) st.x.start ⋆ cell4 ((arg1 t₀) + 0x8#64) st.x.ready
    ⋆ cell4 ((arg1 t₀) + 0x10#64) a.us ⋆ st.sp =@ ((arg1 t₀) + 0x1c#64)
    ⋆ cell4 ((arg1 t₀) + 0x2c#64) a.lb ⋆ c4 ((arg1 t₀) + 0x40#64) st.x.k0
    ⋆ cell4 ((arg1 t₀) + 0x44#64) st.k1 ⋆ cell4 ((arg1 t₀) + 0x48#64) st.k2
    ⋆ c4 ((arg1 t₀) + 0x58#64) st.x.kx1 ⋆ c4 ((arg1 t₀) + 0x60#64) st.x.m1
    ⋆ cell4 ((arg1 t₀) + 0x68#64) st.nm ⋆ c4 ((arg1 t₀) + 0x4c1e0#64) st.x.n0
    ⋆ c4 ((arg1 t₀) + 0x4c1e4#64) st.x.n1 ⋆ c4 ((arg1 t₀) + 0x4c1e8#64) st.x.nq
    ⋆ c4 ((arg1 t₀) + 0x4c1ec#64) st.x.nlim ⋆ st.fm =@ ((arg1 t₀) + 0x4c1f0#64)
    ⋆ st.x.ftLow =@ ((arg1 t₀) + 0x4c252#64) ⋆ st.x.ftHigh =@ ((arg1 t₀) + 0x4c284#64)
    ⋆ st.x.ftNoise =@ ((arg1 t₀) + 0x4c2e6#64) ⋆ st.x.ftLim =@ ((arg1 t₀) + 0x4c2f2#64)
    ⋆ c4 ((arg1 t₀) + 0x4c330#64) st.x.npatch ⋆ st.x.pnum =@ ((arg1 t₀) + 0x4c334#64)
    ⋆ st.x.pstart =@ ((arg1 t₀) + 0x4c33a#64) ⋆ 4 ?@ ((arg1 t₀) + 0x3988#64)
    ⋆ c8 ((arg1 t₀) + 0x15b2c#64) st.x.d0.idx ⋆ 4 ?@ ((arg1 t₀) + 0x19448#64)
    ⋆ c8 ((arg1 t₀) + 0x2b5ec#64) st.x.d1.idx ⋆ c8 (arg0 t₀ + 0x8#64) st.x.avctx ⋆ CstR ⋆ BwR
    ⋆ e.Ext ⋆ a.x.R

/-- `Mm` without `reserve`. -/
def Mx_reserve (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ : MachineData) (st : St) (fr : List UInt8) : Mem 64 → Prop :=
  fr =@ ((t₀.regs.get64 .rsp) - 0x578#64) ⋆ Saved t₀ ⋆ RetCell ra (t₀.regs.get64 .rsp)
    ⋆ cell4 (arg1 t₀) st.x.sampleRate ⋆ cell4 ((arg1 t₀) + 0x4#64) st.x.start
    ⋆ cell4 ((arg1 t₀) + 0x8#64) st.x.ready ⋆ cell4 ((arg1 t₀) + 0x10#64) a.us
    ⋆ st.sp =@ ((arg1 t₀) + 0x1c#64) ⋆ cell4 ((arg1 t₀) + 0x2c#64) a.lb
    ⋆ c4 ((arg1 t₀) + 0x40#64) st.x.k0 ⋆ cell4 ((arg1 t₀) + 0x44#64) st.k1
    ⋆ cell4 ((arg1 t₀) + 0x48#64) st.k2 ⋆ c4 ((arg1 t₀) + 0x58#64) st.x.kx1
    ⋆ c4 ((arg1 t₀) + 0x60#64) st.x.m1 ⋆ cell4 ((arg1 t₀) + 0x68#64) st.nm
    ⋆ c4 ((arg1 t₀) + 0x4c1e0#64) st.x.n0 ⋆ c4 ((arg1 t₀) + 0x4c1e4#64) st.x.n1
    ⋆ c4 ((arg1 t₀) + 0x4c1e8#64) st.x.nq ⋆ c4 ((arg1 t₀) + 0x4c1ec#64) st.x.nlim
    ⋆ st.fm =@ ((arg1 t₀) + 0x4c1f0#64) ⋆ st.x.ftLow =@ ((arg1 t₀) + 0x4c252#64)
    ⋆ st.x.ftHigh =@ ((arg1 t₀) + 0x4c284#64) ⋆ st.x.ftNoise =@ ((arg1 t₀) + 0x4c2e6#64)
    ⋆ st.x.ftLim =@ ((arg1 t₀) + 0x4c2f2#64) ⋆ c4 ((arg1 t₀) + 0x4c330#64) st.x.npatch
    ⋆ st.x.pnum =@ ((arg1 t₀) + 0x4c334#64) ⋆ st.x.pstart =@ ((arg1 t₀) + 0x4c33a#64)
    ⋆ 4 ?@ ((arg1 t₀) + 0x3988#64) ⋆ c8 ((arg1 t₀) + 0x15b2c#64) st.x.d0.idx
    ⋆ 4 ?@ ((arg1 t₀) + 0x19448#64) ⋆ c8 ((arg1 t₀) + 0x2b5ec#64) st.x.d1.idx
    ⋆ c8 (arg0 t₀ + 0x8#64) st.x.avctx ⋆ CstR ⋆ BwR ⋆ e.Ext ⋆ a.x.R

theorem Mm_reserve (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ : MachineData) (st : St) (fr : List UInt8) :
    Mm k e a ra t₀ st fr = Reserve (8 + tlimNeed k) ((t₀.regs.get64 .rsp) - 0x578#64) ⋆ Mx_reserve k e a ra t₀ st fr := by
  simp only [Mm, Mx_reserve]; ac_rfl

