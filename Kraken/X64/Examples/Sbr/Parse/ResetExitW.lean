omit [CodeEnv] in
theorem sep_imp {P P' Q Q' : Mem 64 → Prop} (hp : ∀ m, P m → P' m) (hq : ∀ m, Q m → Q' m) :
    ∀ m, (P ⋆ Q) m → (P' ⋆ Q') m := by
  rintro m ⟨m1, m2, hu, hd, h1, h2⟩
  exact ⟨m1, m2, hu, hd, hp _ h1, hq _ h2⟩

omit [CodeEnv] in
theorem val_imp {a : BitVec 64} {bs : List UInt8} {n : Nat} (hl : bs.length = n)
    (hw : n ≤ 2 ^ 64) : ∀ m, (bs =@ a) m → (n ?@ a) m :=
  fun _ h => ⟨hw, bs, hl, h⟩

/-- The six pushes as 8-byte blocks. -/
def SavedB (t₀ : MachineData) : Mem 64 → Prop :=
  8 ?@ ((t₀.regs.get64 .rsp) - 0x8#64) ⋆ (8 ?@ ((t₀.regs.get64 .rsp) - 0x10#64) ⋆ (8 ?@ ((t₀.regs.get64 .rsp) - 0x18#64)
    ⋆ (8 ?@ ((t₀.regs.get64 .rsp) - 0x20#64) ⋆ (8 ?@ ((t₀.regs.get64 .rsp) - 0x28#64) ⋆ 8 ?@ ((t₀.regs.get64 .rsp) - 0x30#64)))))

omit [CodeEnv] in
theorem saved_imp (t₀ : MachineData) : ∀ m, Saved t₀ m → SavedB t₀ m := by
  intro m h
  unfold Saved at h
  unfold SavedB
  exact sep_imp (val_imp (Int.toBytes_length _ _) (by decide)) (sep_imp
    (val_imp (Int.toBytes_length _ _) (by decide)) (sep_imp
    (val_imp (Int.toBytes_length _ _) (by decide)) (sep_imp
    (val_imp (Int.toBytes_length _ _) (by decide)) (sep_imp
    (val_imp (Int.toBytes_length _ _) (by decide))
    (val_imp (Int.toBytes_length _ _) (by decide)))))) m h

