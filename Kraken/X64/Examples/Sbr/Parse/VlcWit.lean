import Kraken.X64.Examples.Sbr.Parse.VlcData
import Kraken.X64.Examples.Sbr.Parse.EnvVlc
import Kraken.X64.Examples.Sbr.Parse.PsSpec

/-!
# The Huffman-table hypotheses hold of FFmpeg's tables

`read_sbr_envelope` and `read_sbr_noise` assume `Vlc.VlcC v` of the tables `ff_aac_sbr_vlc`
points to, and `ff_ps_read_data` assumes `Ps.VlcC v` of the tables of `vlc_ps`: every walk of
the inlined `get_vlc2` stays inside its table. The tables are built at start-up, so the
hypotheses stay hypotheses; here they are shown to hold of the tables FFmpeg n8.1's start-up
code builds (`VlcData.lean`, generated by `scripts/sbr/vlc/gen.py`), at any addresses:
`vlcC_sbr` and `vlcC_ps`.

Method: a table is one natural number `N` holding its bytes (`natBytes N (4 * n)`), so an
entry is read by kernel-accelerated `Nat` division; `walkB` is a Boolean `VWalk` over `N`
(`walkB_sound`), evaluated by `decide +kernel` once per table.
-/

open Kraken.Examples.Sbr

namespace Kraken.Examples.Sbr.VlcWit

open VlcData

/-! ## Tables as natural numbers -/

/-- Byte `k` of `N`. -/
def byteN (N k : Nat) : UInt8 := UInt8.ofNat (N / 2 ^ (8 * k))

/-- The first `L` bytes of `N`. -/
def natBytes (N L : Nat) : List UInt8 := (List.range L).map (byteN N)

theorem natBytes_length (N L : Nat) : (natBytes N L).length = L := by simp [natBytes]

theorem natBytes_two {N L k : Nat} (h : k + 2 ≤ L) :
    ((natBytes N L).drop k).take 2 = [byteN N k, byteN N (k + 1)] := by
  apply List.ext_getElem
  · simp [natBytes]; omega
  · intro i h1 h2
    simp only [List.length_cons, List.length_nil] at h2
    simp only [natBytes, List.getElem_take, List.getElem_drop, List.getElem_map,
      List.getElem_range]
    match i, h2 with
    | 0, _ => simp
    | 1, _ => simp

theorem ofBytes_two (N k : Nat) :
    BitVec.ofInt 16 (Int.ofBytes [byteN N k, byteN N (k + 1)])
      = BitVec.ofNat 16 (N / 2 ^ (8 * k)) := by
  have hb : ∀ j, (byteN N j).toNat = N / 2 ^ (8 * j) % 256 := by
    intro j; simp [byteN]
  have hk : N / 2 ^ (8 * (k + 1)) = N / 2 ^ (8 * k) / 256 := by
    rw [Nat.div_div_eq_div_mul, show 8 * (k + 1) = 8 * k + 8 by omega, Nat.pow_add]
  simp only [Int.ofBytes, List.foldr_cons, List.foldr_nil, hb, hk]
  apply BitVec.eq_of_toNat_eq
  rw [BitVec.toNat_ofNat]
  generalize N / 2 ^ (8 * k) = M
  rw [show ((0 : Int) * 256 + ((M / 256 % 256 : Nat) : Int)) * 256 + ((M % 256 : Nat) : Int)
      = ((M % 65536 : Nat) : Int) by omega]
  rw [BitVec.toNat_ofInt]
  omega

/-- `table[i].sym` and `table[i].len` of the table `N`. -/
abbrev entS (N i : Nat) : BitVec 16 := BitVec.ofNat 16 (N / 2 ^ (8 * (4 * i)))
abbrev entL (N i : Nat) : BitVec 16 := BitVec.ofNat 16 (N / 2 ^ (8 * (4 * i + 2)))

theorem vsym_eq {N n i : Nat} (h : i < n) : Vlc.vsym (natBytes N (4 * n)) i = entS N i := by
  simp only [Vlc.vsym]; rw [natBytes_two (by omega), ofBytes_two]

theorem vlen_eq {N n i : Nat} (h : i < n) : Vlc.vlen (natBytes N (4 * n)) i = entL N i := by
  simp only [Vlc.vlen]; rw [natBytes_two (by omega), ofBytes_two]

/-! ## The Boolean walk -/

/-- `∀ j < k, f j`. -/
def allLt : Nat → (Nat → Bool) → Bool
  | 0, _ => true
  | k + 1, f => allLt k f && f k

theorem allLt_spec {f : Nat → Bool} : ∀ {k}, allLt k f = true → ∀ j, j < k → f j = true
  | 0, _, j, hj => absurd hj (Nat.not_lt_zero _)
  | k + 1, h, j, hj => by
    simp only [allLt, Bool.and_eq_true] at h
    by_cases hjk : j = k
    · subst hjk; exact h.2
    · exact allLt_spec h.1 j (by omega)

/-- `VWalk` on the table `N` of `n` entries. -/
def walkB (N n : Nat) : Nat → Nat → Bool
  | 0, _ => false
  | d + 1, i => decide (i < n) && (!(entL N i).msb
      || allLt (2 ^ (32 - (entL N i).toNat % 32))
          (fun j => walkB N n d (BitVec.ofNat 32 j + (entS N i).signExtend 32).toNat))

theorem walkB_sound (N n : Nat) :
    ∀ d i, walkB N n d i = true → Vlc.VWalk (natBytes N (4 * n)) d i
  | 0, _, h => by simp [walkB] at h
  | d + 1, i, h => by
    simp only [walkB, Bool.and_eq_true, decide_eq_true_eq, Bool.or_eq_true,
      Bool.not_eq_true'] at h
    obtain ⟨hi, h⟩ := h
    refine ⟨by rw [natBytes_length]; omega, ?_⟩
    rw [vlen_eq hi]
    rcases h with h | h
    · exact Or.inl h
    · refine Or.inr fun j hj => ?_
      have := walkB_sound N n d _ (allLt_spec h j hj)
      simp only [Vlc.vnext]
      rw [vsym_eq hi]
      exact this

theorem ps_walkB_sound (N n : Nat) :
    ∀ d i, walkB N n d i = true → Ps.VWalk (natBytes N (4 * n)) d i
  | 0, _, h => by simp [walkB] at h
  | d + 1, i, h => by
    simp only [walkB, Bool.and_eq_true, decide_eq_true_eq, Bool.or_eq_true,
      Bool.not_eq_true'] at h
    obtain ⟨hi, h⟩ := h
    refine ⟨by rw [natBytes_length]; omega, ?_⟩
    rw [show Ps.vlen (natBytes N (4 * n)) i = entL N i from vlen_eq hi]
    rcases h with h | h
    · exact Or.inl h
    · refine Or.inr fun j hj => ?_
      have := ps_walkB_sound N n d _ (allLt_spec h j hj)
      simp only [Ps.vnext]
      rw [show Ps.vsym (natBytes N (4 * n)) i = entS N i from vsym_eq hi]
      exact this

/-- The check of a table: the walk from every `nb`-bit first-level index. -/
def okB (nb d N n : Nat) : Bool := allLt (2 ^ nb) (walkB N n d)

theorem vlcOk_of {nb d N n : Nat} (p : BitVec 64) (h : okB nb d N n = true) (hn : n < 2 ^ 28) :
    Vlc.VlcOk nb d ⟨p, natBytes N (4 * n)⟩ := by
  refine ⟨?_, ?_, fun i hi => walkB_sound N n d i (allLt_spec h i hi)⟩
  · simp [natBytes_length]
  · simp only [Vlc.VlcTab.N, natBytes_length]; omega

theorem ps_vlcOk_of {nb d N n : Nat} (p : BitVec 64) (h : okB nb d N n = true)
    (hn : n < 2 ^ 28) : Ps.VlcOk nb d ⟨p, natBytes N (4 * n)⟩ := by
  refine ⟨?_, ?_, fun i hi => ps_walkB_sound N n d i (allLt_spec h i hi)⟩
  · simp [natBytes_length]
  · simp only [Ps.VlcTab.N, natBytes_length]; omega

/-! ## The tables -/

/-- `ff_aac_sbr_vlc[k]`'s table: bytes and number of entries. -/
def sbrN : Nat → Nat × Nat
  | 0 => (sbr0, sbr0E) | 1 => (sbr1, sbr1E) | 2 => (sbr2, sbr2E) | 3 => (sbr3, sbr3E)
  | 4 => (sbr4, sbr4E) | 5 => (sbr5, sbr5E) | 6 => (sbr6, sbr6E) | 7 => (sbr7, sbr7E)
  | 8 => (sbr8, sbr8E) | _ => (sbr9, sbr9E)

/-- `vlc_ps[k]`'s table. -/
def psN : Nat → Nat × Nat
  | 0 => (ps0, ps0E) | 1 => (ps1, ps1E) | 2 => (ps2, ps2E) | 3 => (ps3, ps3E)
  | 4 => (ps4, ps4E) | 5 => (ps5, ps5E) | 6 => (ps6, ps6E) | 7 => (ps7, ps7E)
  | 8 => (ps8, ps8E) | _ => (ps9, ps9E)

/-- The SBR tables at the addresses `ptr k`. -/
def vS (ptr : Nat → BitVec 64) (k : Nat) : Vlc.VlcTab :=
  ⟨ptr k, natBytes (sbrN k).1 (4 * (sbrN k).2)⟩

/-- The PS tables at the addresses `ptr k`. -/
def vP (ptr : Nat → BitVec 64) (k : Nat) : Ps.VlcTab :=
  ⟨ptr k, natBytes (psN k).1 (4 * (psN k).2)⟩

theorem sbr_ok0 : okB 9 3 sbr0 sbr0E = true := by decide +kernel
theorem sbr_ok1 : okB 9 3 sbr1 sbr1E = true := by decide +kernel
theorem sbr_ok2 : okB 9 3 sbr2 sbr2E = true := by decide +kernel
theorem sbr_ok3 : okB 9 3 sbr3 sbr3E = true := by decide +kernel
theorem sbr_ok4 : okB 9 3 sbr4 sbr4E = true := by decide +kernel
theorem sbr_ok5 : okB 9 3 sbr5 sbr5E = true := by decide +kernel
theorem sbr_ok6 : okB 9 3 sbr6 sbr6E = true := by decide +kernel
theorem sbr_ok7 : okB 9 3 sbr7 sbr7E = true := by decide +kernel
theorem sbr_ok8 : okB 9 3 sbr8 sbr8E = true := by decide +kernel
theorem sbr_ok9 : okB 9 3 sbr9 sbr9E = true := by decide +kernel

theorem ps_ok0 : okB 9 3 ps0 ps0E = true := by decide +kernel
theorem ps_ok1 : okB 9 3 ps1 ps1E = true := by decide +kernel
theorem ps_ok2 : okB 9 3 ps2 ps2E = true := by decide +kernel
theorem ps_ok3 : okB 9 3 ps3 ps3E = true := by decide +kernel
theorem ps_ok4 : okB 9 2 ps4 ps4E = true := by decide +kernel
theorem ps_ok5 : okB 9 2 ps5 ps5E = true := by decide +kernel
theorem ps_ok6 : okB 5 1 ps6 ps6E = true := by decide +kernel
theorem ps_ok7 : okB 5 1 ps7 ps7E = true := by decide +kernel
theorem ps_ok8 : okB 5 1 ps8 ps8E = true := by decide +kernel
theorem ps_ok9 : okB 5 1 ps9 ps9E = true := by decide +kernel

/-- `Vlc.VlcC` holds of FFmpeg's SBR tables, at any addresses. -/
theorem vlcC_sbr (ptr : Nat → BitVec 64) : Vlc.VlcC (vS ptr) := by
  intro k hk
  match k, hk with
  | 0, _ => exact vlcOk_of _ sbr_ok0 (by decide)
  | 1, _ => exact vlcOk_of _ sbr_ok1 (by decide)
  | 2, _ => exact vlcOk_of _ sbr_ok2 (by decide)
  | 3, _ => exact vlcOk_of _ sbr_ok3 (by decide)
  | 4, _ => exact vlcOk_of _ sbr_ok4 (by decide)
  | 5, _ => exact vlcOk_of _ sbr_ok5 (by decide)
  | 6, _ => exact vlcOk_of _ sbr_ok6 (by decide)
  | 7, _ => exact vlcOk_of _ sbr_ok7 (by decide)
  | 8, _ => exact vlcOk_of _ sbr_ok8 (by decide)
  | 9, _ => exact vlcOk_of _ sbr_ok9 (by decide)

/-- `Ps.VlcC` holds of FFmpeg's PS tables, at any addresses. -/
theorem vlcC_ps (ptr : Nat → BitVec 64) : Ps.VlcC (vP ptr) := by
  intro k hk
  match k, hk with
  | 0, _ => exact ps_vlcOk_of _ ps_ok0 (by decide)
  | 1, _ => exact ps_vlcOk_of _ ps_ok1 (by decide)
  | 2, _ => exact ps_vlcOk_of _ ps_ok2 (by decide)
  | 3, _ => exact ps_vlcOk_of _ ps_ok3 (by decide)
  | 4, _ => exact ps_vlcOk_of _ ps_ok4 (by decide)
  | 5, _ => exact ps_vlcOk_of _ ps_ok5 (by decide)
  | 6, _ => exact ps_vlcOk_of _ ps_ok6 (by decide)
  | 7, _ => exact ps_vlcOk_of _ ps_ok7 (by decide)
  | 8, _ => exact ps_vlcOk_of _ ps_ok8 (by decide)
  | 9, _ => exact ps_vlcOk_of _ ps_ok9 (by decide)

end Kraken.Examples.Sbr.VlcWit
