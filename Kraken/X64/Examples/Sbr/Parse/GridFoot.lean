abbrev TxJt (k : Nat) (Ext : Mem 64 → Prop) (x : GArgs) (ra : Int64) (t₀ : MachineData) (FR : (Mem 64 → Prop) → Mem 64 → Prop) (st : GSt) : Mem 64 → Prop :=
  8 ?@ (t₀.regs.get64 .rsp - 0x30#64) ⋆ (Reserve k (t₀.regs.get64 .rsp - 0x30#64)
    ⋆ (ChB (arg3 t₀) st ⋆ (GbW (arg2 t₀) x st.i ⋆ (cell4 (arg1 t₀ + 0x10#64) x.usac
    ⋆ (cell4 (arg1 t₀ + 0x24#64) x.ampHdr ⋆ (Int.toBytes 8 x.avctx.toInt =@ (arg0 t₀ + 8#64)
    ⋆ (Blocks [(x.buf, x.L), (lab "ceil_log2", 6)] ⋆ (Ext ⋆ FR (Rest x.R ra t₀)))))))))

theorem T_jt_eq (k : Nat) (Ext : Mem 64 → Prop) (x : GArgs) (ra : Int64) (t₀ : MachineData) (FR : (Mem 64 → Prop) → Mem 64 → Prop) (st : GSt) :
    T k Ext x ra t₀ FR st = JtW ⋆ TxJt k Ext x ra t₀ FR st := by
  simp only [T, GFB, InW, TxJt]; ac_rfl

theorem T_jt (k : Nat) (Ext : Mem 64 → Prop) (x : GArgs) (ra : Int64) (t₀ : MachineData) (FR : (Mem 64 → Prop) → Mem 64 → Prop) (st : GSt) :
    ∃ F, T k Ext x ra t₀ FR st = JtW ⋆ F :=
  ⟨_, T_jt_eq k Ext x ra t₀ FR st⟩

/-- `T` without `slot30`, `reserve`, `ext`. -/
abbrev TxExt (k : Nat) (Ext : Mem 64 → Prop) (x : GArgs) (ra : Int64) (t₀ : MachineData) (FR : (Mem 64 → Prop) → Mem 64 → Prop) (st : GSt) : Mem 64 → Prop :=
  ChB (arg3 t₀) st ⋆ (GbW (arg2 t₀) x st.i ⋆ (cell4 (arg1 t₀ + 0x10#64) x.usac
    ⋆ (cell4 (arg1 t₀ + 0x24#64) x.ampHdr ⋆ (Int.toBytes 8 x.avctx.toInt =@ (arg0 t₀ + 8#64)
    ⋆ (Blocks [(x.buf, x.L), (lab "ceil_log2", 6)] ⋆ (JtW ⋆ FR (Rest x.R ra t₀)))))))

