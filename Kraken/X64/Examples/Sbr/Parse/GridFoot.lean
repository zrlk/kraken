    ⋆ (Reserve k (t₀.regs.get64 .rsp - 0x30#64) ⋆ (Ext ⋆ TxExt k Ext x ra t₀ FR st)) := by
  simp only [T, GFB, InW, TxExt]; ac_rfl

theorem T_ext (k : Nat) (Ext : Mem 64 → Prop) (x : GArgs) (ra : Int64) (t₀ : MachineData) (FR : (Mem 64 → Prop) → Mem 64 → Prop) (st : GSt) :
