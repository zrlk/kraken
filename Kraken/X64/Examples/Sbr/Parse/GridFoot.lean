theorem FrO_addr (d o : BitVec 64) (ho : 0xc ≤ o.toNat ∧ o.toNat < 0xc + 9) :
    d + BitVec.ofNat 64 (o.toNat - 0xc) + 0xc#64 = d + o := by
  rw [BitVec.add_assoc]; apply congrArg (d + ·)
  apply BitVec.eq_of_toNat_eq
  rw [BitVec.toNat_add, BitVec.toNat_ofNat]
  have : (0xc#64).toNat = 0xc := rfl
  rw [this]
  have h2 : o.toNat - 0xc < 2 ^ 64 := by omega
  rw [Nat.mod_eq_of_lt h2, Nat.sub_add_cancel ho.1, Nat.mod_eq_of_lt o.isLt]

/-- Load of `FrB` at a constant offset `o` from the base (byte `o - 0xc`). -/
