    m.loadInt (arg3 t₀ + o) 1
      = some (Int.ofBytes (Int.toBytes 1 (bv st.fr (o.toNat - 0xc)).toInt)) := by
  rw [← FrO_addr _ _ ho]
  exact T_loadFr h _ (by omega)

/-- Store to `FrB` at a constant offset `o` from the base. -/
