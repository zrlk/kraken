/-- `T` without `GbW`. -/
abbrev TxGb (k : Nat) (Ext : Mem 64 → Prop) (x : GArgs) (ra : Int64) (t₀ : MachineData) (FR : (Mem 64 → Prop) → Mem 64 → Prop) (st : GSt) : Mem 64 → Prop :=
