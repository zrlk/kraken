/-- Byte `j` of `FrB`. -/
theorem FrB_loadInt {m : Mem 64} {d : BitVec 64} {l : List UInt8} {R : Mem 64 → Prop}
    (h : m =⋆ FrB d l ⋆ R) (j : Nat) (hj : j < 9) :
    m.loadInt (d + BitVec.ofNat 64 j + 0xc#64) 1
      = some (Int.ofBytes (Int.toBytes 1 (bv l j).toInt)) := by
  simp only [FrB] at h
  rcases (by omega : j = 0 ∨ j = 1 ∨ j = 2 ∨ j = 3 ∨ j = 4 ∨ j = 5 ∨ j = 6 ∨ j = 7 ∨ j = 8)
    with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp only [BitVec.add_assoc, BitVec.reduceAdd] <;> cells_grind

/-- Store to byte `j` of `FrB`. -/
theorem FrB_storeInt {m : Mem 64} {d : BitVec 64} {l : List UInt8} {R : Mem 64 → Prop}
    (h : m =⋆ FrB d l ⋆ R) (hl : l.length = 9) (j : Nat) (hj : j < 9) (v : BitVec 8) :
    m.storeInt (d + BitVec.ofNat 64 j + 0xc#64) 1 v.toInt
      =⋆ FrB d (l.set j (UInt8.ofBitVec v)) ⋆ R := by
  simp only [FrB] at h ⊢
  simp only [bv, getD_set_if l j _ _ (by omega)]
  rcases (by omega : j = 0 ∨ j = 1 ∨ j = 2 ∨ j = 3 ∨ j = 4 ∨ j = 5 ∨ j = 6 ∨ j = 7 ∨ j = 8)
    with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp only [BitVec.add_assoc, BitVec.reduceAdd, Nat.reduceEqDiff,
      ↓reduceIte, UInt8.toBitVec_ofBitVec] <;> cells_grind

