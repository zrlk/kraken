    m.storeInt (arg3 t₀ + o) 1 v.toInt =⋆ T k Ext x ra t₀ FR (st.setFr (o.toNat - 0xc) v) := by
  rw [← FrO_addr _ _ ho]
  exact T_storeFr h hl _ (by omega) v

