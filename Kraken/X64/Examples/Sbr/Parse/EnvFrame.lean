import Kraken.X64.Examples.Sbr.Parse.EnvBase
import Kraken.X64.Examples.Sbr.Parse.Lib

/-!
# `read_sbr_envelope`: the frame slots

Generated by `scripts/sbr/parse/env/mem.py`. For every frame slot `rbp - c`: the address as
vcgen leaves it (`fa_<c>`), a load (`T_ld_<f>`) and a store (`T_st_<f>`, the frame value
replaced) through `T`.
-/

open Kraken Kraken.SysV Mem Kraken.X64.Parser Std.WP MachineWP
open Kraken.Examples.Sbr Kraken.Examples.Sbr.Apply Kraken.Examples.Sbr.Vlc
open Kraken.Examples.Sbr.Parse (eq_r eq_l eq_h)

set_option mvcgen.warning false
set_option grind.warning false

namespace Kraken.Examples.Sbr.Env

/-- `T` without the frame. -/
abbrev TF [CodeEnv] (k : Nat) (Ext : Mem 64 → Prop) (x : EArgs) (ra : Int64) (t₀ : MachineData)
    (i : BitVec 32) : Mem 64 → Prop :=
  let r := t₀.regs.get64 .rsp
  Sv t₀ ⋆ (8 ?@ (r - 0xb0#64) ⋆ (Reserve k (r - 0xb0#64) ⋆ (EF Ext x t₀ i ⋆ Rest x.R ra t₀)))

theorem T_frw [CodeEnv] (k : Nat) (Ext : Mem 64 → Prop) (x : EArgs) (ra : Int64)
    (t₀ : MachineData) (fv : FV) (i : BitVec 32) :
    T k Ext x ra t₀ fv i = FrW (t₀.regs.get64 .rsp) fv ⋆ TF k Ext x ra t₀ i := by
  simp only [T]; exact eq_r eq_h

theorem frw_store8 {m : Mem 64} {r : BitVec 64} {fv fv' : FV} {a old w : BitVec 64}
    {G H : Mem 64 → Prop} (h : m =⋆ FrW r fv ⋆ G) (e1 : FrW r fv = c8 a old ⋆ H)
    (e2 : FrW r fv' = c8 a w ⋆ H) : m.storeInt a 8 w.toInt =⋆ FrW r fv' ⋆ G := by
  rw [e1, Std.ExtHashMap.sep_assoc] at h
  rw [e2, Std.ExtHashMap.sep_assoc]
  exact storeInt_sep _ 8 _ _ m ⟨h, Int.toBytes_length 8 _⟩ w.toInt

theorem frw_load8 {m : Mem 64} {r : BitVec 64} {fv : FV} {a v : BitVec 64}
    {G H : Mem 64 → Prop} (h : m =⋆ FrW r fv ⋆ G) (e1 : FrW r fv = c8 a v ⋆ H) :
    m.loadInt a 8 = some (Int.ofBytes (Int.toBytes 8 v.toInt)) := by
  rw [e1, Std.ExtHashMap.sep_assoc] at h
  exact loadInt_sep _ _ 8 _ m h (Int.toBytes_length 8 _) (by omega)

theorem frw_store4 {m : Mem 64} {r : BitVec 64} {fv fv' : FV} {a : BitVec 64} {old w : BitVec 32}
    {G H : Mem 64 → Prop} (h : m =⋆ FrW r fv ⋆ G) (e1 : FrW r fv = cell4 a old ⋆ H)
    (e2 : FrW r fv' = cell4 a w ⋆ H) : m.storeInt a 4 w.toInt =⋆ FrW r fv' ⋆ G := by
  rw [e1, Std.ExtHashMap.sep_assoc] at h
  rw [e2, Std.ExtHashMap.sep_assoc]
  exact storeInt_sep _ 4 _ _ m ⟨h, Int.toBytes_length 4 _⟩ w.toInt

theorem frw_load4 {m : Mem 64} {r : BitVec 64} {fv : FV} {a : BitVec 64} {v : BitVec 32}
    {G H : Mem 64 → Prop} (h : m =⋆ FrW r fv ⋆ G) (e1 : FrW r fv = cell4 a v ⋆ H) :
    m.loadInt a 4 = some (Int.ofBytes (Int.toBytes 4 v.toInt)) := by
  rw [e1, Std.ExtHashMap.sep_assoc] at h
  exact loadInt_sep _ _ 4 _ m h (Int.toBytes_length 4 _) (by omega)


