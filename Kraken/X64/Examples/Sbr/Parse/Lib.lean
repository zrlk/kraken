/-!
# Shared lemmas for the parser proofs

Routine-independent pieces used by the block proofs of the bitstream parsers
(`Parse/*.lean`). See `scripts/sbr/README.md`, "How to prove a parser routine".

* Havoc rules: an instruction whose result is never needed (the bit reader's `bswap`, the
  shifts by `%cl`) is stepped by a rule that forgets the value written: the register gets any
  64-bit value and the flags any status. They are sound over-approximations of the precise
  rules (derived from them), passed to `vcgen` explicitly, never registered as `spec`.
  `shl_cl64_val` keeps the value (for `1 << n`) and forgets the flags.
* Byte lists: a load of / store to byte `j` of a `List UInt8` cell (`bsplit`, `bmerge`,
  `getD_set_*`).
* Focus: a footprint is a separating conjunction of opaque cell groups. A block brings the
  cells it touches to the front with an AC equation of the footprint (generated by
  `scripts/sbr/parse/focus.py`) and applies one of the cell lemmas below (`cell4_load`,
  `cell4_store`, `slot_store`, …). `Hide` keeps a hypothesis away from `simp … at *`/`grind`.
* Small arithmetic facts that come up in every block (`lt4_cases`, `zx8`, `sub_add_lit`, …).
-/

open Kraken MachineWP Std.WP Lean.Order Mem Kraken.SysV Kraken.Examples.Sbr

namespace Kraken.Examples.Sbr.Parse

/-! ## Havoc rules -/

section Havoc

variable [CodeEnv] {Q : Unit → MachineData → Prop} {E : Int64 → MachineData → Prop}
  {p : Program}

omit [CodeEnv] in
theorem regs_set_get (rs : Reg64s) (r : Reg64) : rs.set64 r (rs.get64 r) = rs := by
  cases rs; cases r <;> rfl

/-- `bswap %r32`, value forgotten. -/
theorem bswap32_havoc (asz : Width) (r : Reg64) :
    ⦃ fun s => ∀ v : BitVec 64, ∀ st : StatusFlags,
        WP.wp p Q E { s with regs := s.regs.set64 r v, status := st } ⦄
      (Directive.instr (.regular asz .W32 (.bswap (.low r .W32))) :: p)
    ⦃ Q; E ⦄ :=
  Triple.intro fun s h => by
    intro pc hpl
    obtain ⟨z, rest, hseg, hpl'⟩ := hpl
    rw [after_instr hseg]
    refine step_here hseg (Or.inl ?_)
    simp only [Directive.interp, Instr.interp, Operation.interp,
      MachineData.setReg, Reg64s.set_low32, Effects.All]
    exact h _ s.status _ hpl'

/-- `shl %cl, %r32`, value forgotten. -/
theorem shl_cl32_havoc (asz : Width) (r : Reg64) :
    ⦃ fun s => ∀ v : BitVec 64, ∀ st : StatusFlags,
        WP.wp p Q E { s with regs := s.regs.set64 r v, status := st } ⦄
      (Directive.instr (.regular asz .W32 (.shl (.reg (.low r .W32)) .cl)) :: p)
    ⦃ Q; E ⦄ :=
  Triple.intro fun s hs => (MachineWP.shl_reg_cl_w32_spec (p := p) (Q := Q) (E := E) asz r).le_wp s
    (fun cf af of => by
      split
      · have h := hs (s.regs.get64 r) s.status
        rw [regs_set_get] at h; exact h
      · exact hs _ _)

/-- `shr %cl, %r32`, value forgotten. -/
theorem shr_cl32_havoc (asz : Width) (r : Reg64) :
    ⦃ fun s => ∀ v : BitVec 64, ∀ st : StatusFlags,
        WP.wp p Q E { s with regs := s.regs.set64 r v, status := st } ⦄
      (Directive.instr (.regular asz .W32 (.shr (.reg (.low r .W32)) .cl)) :: p)
    ⦃ Q; E ⦄ :=
  Triple.intro fun s hs => (MachineWP.shr_reg_cl_w32_spec (p := p) (Q := Q) (E := E) asz r).le_wp s
    (fun cf af of => by
      split
      · have h := hs (s.regs.get64 r) s.status
        rw [regs_set_get] at h; exact h
      · exact hs _ _)

/-- `shr %cl, %r8`, value forgotten. -/
theorem shr_cl8_havoc (asz : Width) (r : Reg64) :
    ⦃ fun s => ∀ v : BitVec 64, ∀ st : StatusFlags,
        WP.wp p Q E { s with regs := s.regs.set64 r v, status := st } ⦄
      (Directive.instr (.regular asz .W8 (.shr (.reg (.low r .W8)) .cl)) :: p)
    ⦃ Q; E ⦄ :=
  Triple.intro fun s hs => (MachineWP.shr_reg_cl_w8_spec (p := p) (Q := Q) (E := E) asz r).le_wp s
    (fun cf af of => by
      split
      · have h := hs (s.regs.get64 r) s.status
        rw [regs_set_get] at h; exact h
      · exact hs _ _)

/-- `shl %cl, %r64` with the value kept and the flags forgotten. -/
theorem shl_cl64_val (asz : Width) (r : Reg64) :
    ⦃ fun s => ∀ st : StatusFlags, WP.wp p Q E { s with
        regs := s.regs.set64 r (s.regs.get64 r <<< ((s.regs.get64 .rcx).toNat % 256 % 64)),
        status := st } ⦄
      (Directive.instr (.regular asz .W64 (.shl (.reg (.low r .W64)) .cl)) :: p)
    ⦃ Q; E ⦄ :=
  Triple.intro fun s hs => (MachineWP.shl_reg_cl_w64_spec (p := p) (Q := Q) (E := E) asz r).le_wp s
    (fun cf af of => by
      split
      · rename_i h0
        have h := hs s.status
        rw [h0, BitVec.shiftLeft_zero, regs_set_get] at h; exact h
      · exact hs _)

omit [CodeEnv] in
/-- vcgen leaves register files under an `if` (after a `cmov` or a havoc case split). -/
theorem get64_ite (c : Prop) [Decidable c] (a b : Reg64s) (r : Reg64) :
    (if c then a else b).get64 r = if c then a.get64 r else b.get64 r := by
  split <;> rfl

/-- `incl %r`: the 32-bit sum, zero-extended into the register; the carry flag is kept
(as `dec_reg_w32_spec`). -/
@[spec low] theorem inc_reg_w32_spec (asz : Width) (r : Reg64) :
    ⦃ fun s =>
        let a := (s.regs.get64 r).setWidth 32
        let v := a + 1
        WP.wp p Q E
          { s with
              regs := s.regs.set64 r (v.setWidth 64),
              status := StatusFlags.from_result v
                  { cf := s.status.cf,
                    af := (v.take 4).unsigned != (a.take 4).unsigned + 1,
                    of := v.signed != a.signed + 1 } } ⦄
      (Directive.instr (.regular asz .W32 (.inc (.reg (.low r .W32)))) :: p)
    ⦃ Q; E ⦄ :=
  fallthrough_spec (fun s rng P hP => by
    simp only [Directive.interp, Instr.interp, Operation.interp, RegOrMem.interp,
      MachineData.set, MachineData.setReg, Reg64s.get_low32, Reg64s.set_low32, Effects.All]
    exact hP)

end Havoc

/-! ## Byte lists -/

section Bytes

/-- Byte `i` of `l`. -/
abbrev bv (l : List UInt8) (i : Nat) : BitVec 8 := (l.getD i 0).toBitVec

/-- An 8-byte cell holding `v`. -/
abbrev cell8 (a v : BitVec 64) : Mem 64 → Prop := Int.toBytes 8 v.toInt =@ a

/-- Byte `j` of a list cell as a cell of its own. -/
theorem bsplit (l : List UInt8) (a : BitVec 64) (j : Nat) (hj : j < l.length)
    (hw : l.length ≤ 2 ^ 64) :
    l =@ a = l.take j =@ a ⋆ ([l.getD j 0] =@ (a + BitVec.ofNat 64 j) ⋆
      l.drop (j + 1) =@ (a + BitVec.ofNat 64 j + 1#64)) := by
  have e : l = l.take j ++ ([l.getD j 0] ++ l.drop (j + 1)) := by
    have h1 := (List.take_append_drop j l).symm
    rw [List.drop_eq_getElem_cons hj] at h1
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hj, Option.getD_some]; exact h1
  have hl : (l.take j).length = j := by simp only [List.length_take]; omega
  rw [show (l =@ a) = ((l.take j ++ ([l.getD j 0] ++ l.drop (j + 1))) =@ a) from by rw [← e]]
  rw [Mem.Val.append_eq (l.take j) _ a (a + BitVec.ofNat 64 j) (by rw [hl])
      (by simp only [List.length_append, List.length_take, List.length_cons, List.length_nil,
        List.length_drop]; omega),
    Mem.Val.append_eq [l.getD j 0] _ (a + BitVec.ofNat 64 j) (a + BitVec.ofNat 64 j + 1#64)
      (by simp)
      (by simp only [List.length_cons, List.length_nil, List.length_drop]; omega)]

/-- The pieces of `bsplit` with byte `j` replaced: the list with that byte set. -/
theorem bmerge (l : List UInt8) (a : BitVec 64) (j : Nat) (b : UInt8) (hj : j < l.length)
    (hw : l.length ≤ 2 ^ 64) :
    l.take j =@ a ⋆ ([b] =@ (a + BitVec.ofNat 64 j) ⋆
      l.drop (j + 1) =@ (a + BitVec.ofNat 64 j + 1#64)) = (l.set j b) =@ a := by
  have hl : (l.set j b).length = l.length := List.length_set ..
  rw [bsplit (l.set j b) a j (by omega) (by omega)]
  have h1 : (l.set j b).take j = l.take j := by
    apply List.ext_getElem
    · simp
    · intro n h₁ h₂; simp only [List.getElem_take, List.getElem_set]
      simp only [List.length_take] at h₁
      exact ite_eq_right (by omega)
  have h2 : (l.set j b).drop (j + 1) = l.drop (j + 1) := by
    apply List.ext_getElem
    · simp
    · intro n h₁ h₂; simp only [List.getElem_drop, List.getElem_set]
      exact ite_eq_right (by omega)
  have h3 : (l.set j b).getD j 0 = b := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_set_self (by omega), Option.getD_some]
  rw [h1, h2, h3]

theorem getD_set_ne (l : List UInt8) (j i : Nat) (b : UInt8) (h : i ≠ j) :
    (l.set j b).getD i 0 = l.getD i 0 := by
  simp only [List.getD_eq_getElem?_getD, List.getElem?_set_ne (Ne.symm h)]

theorem getD_set_eq (l : List UInt8) (j : Nat) (b : UInt8) (h : j < l.length) :
    (l.set j b).getD j 0 = b := by
  rw [List.getD_eq_getElem?_getD, List.getElem?_set_self h, Option.getD_some]

theorem getD_set_if (l : List UInt8) (j i : Nat) (b : UInt8) (h : j < l.length) :
    (l.set j b).getD i 0 = if i = j then b else l.getD i 0 := by
  split
  · subst_vars; exact getD_set_eq l _ b h
  · exact getD_set_ne l j i b (by assumption)

end Bytes

/-! ## Focus -/

section Focus

/-- A hypothesis kept out of `grind`'s / `simp … at *`'s sight. -/
def Hide (p : Prop) : Prop := p

theorem pick_r {m : Mem 64} {A B : Mem 64 → Prop} (h : m =⋆ A ⋆ B) : ∃ F, m =⋆ B ⋆ F :=
  ⟨A, by rw [Std.ExtHashMap.sep_comm] at h; exact h⟩

theorem pick_l {m : Mem 64} {A B : Mem 64 → Prop} (h : m =⋆ A ⋆ B) : ∃ F, m =⋆ A ⋆ F :=
  ⟨B, h⟩

theorem pick_ll {m : Mem 64} {A B F : Mem 64 → Prop} (h : m =⋆ (A ⋆ B) ⋆ F) :
    ∃ F', m =⋆ A ⋆ F' :=
  ⟨B ⋆ F, by rw [Std.ExtHashMap.sep_assoc] at h; exact h⟩

theorem pick_lr {m : Mem 64} {A B F : Mem 64 → Prop} (h : m =⋆ (A ⋆ B) ⋆ F) :
    ∃ F', m =⋆ B ⋆ F' :=
  ⟨A ⋆ F, by rw [Std.ExtHashMap.sep_comm A B, Std.ExtHashMap.sep_assoc] at h; exact h⟩

/-- Path steps for an `∃ F, P = X ⋆ F` focus equation: right, left, here. -/
theorem eq_r {A B X G : Mem 64 → Prop} (h : B = X ⋆ G) : A ⋆ B = X ⋆ (A ⋆ G) := by
  rw [h, Std.ExtHashMap.sep_comm_l]

theorem eq_l {A B X G : Mem 64 → Prop} (h : A = X ⋆ G) : A ⋆ B = X ⋆ (G ⋆ B) := by
  rw [h, Std.ExtHashMap.sep_assoc]

theorem eq_h {X B : Mem 64 → Prop} : X ⋆ B = X ⋆ B := rfl

/-- Apply a focus equation to a memory hypothesis. -/
theorem focus {m : Mem 64} {P Q : Mem 64 → Prop} (e : P = Q) (h : m =⋆ P) : m =⋆ Q := e ▸ h

theorem cell4_load {m : Mem 64} {a : BitVec 64} {v : BitVec 32} {F : Mem 64 → Prop}
    (h : m =⋆ cell4 a v ⋆ F) : m.loadInt a 4 = some (Int.ofBytes (Int.toBytes 4 v.toInt)) :=
  loadInt_sep _ _ 4 F m h (Int.toBytes_length 4 _) (by omega)

theorem cell4_store {m : Mem 64} {a : BitVec 64} {v : BitVec 32} {F : Mem 64 → Prop}
    (h : m =⋆ cell4 a v ⋆ F) (w : BitVec 32) : m.storeInt a 4 w.toInt =⋆ cell4 a w ⋆ F :=
  storeInt_sep _ 4 _ _ m ⟨h, Int.toBytes_length 4 _⟩ w.toInt

theorem cell1_load {m : Mem 64} {a : BitVec 64} {v : BitVec 8} {F : Mem 64 → Prop}
    (h : m =⋆ cell1 a v ⋆ F) : m.loadInt a 1 = some (Int.ofBytes (Int.toBytes 1 v.toInt)) :=
  loadInt_sep _ _ 1 F m h (Int.toBytes_length 1 _) (by omega)

theorem cell1_store {m : Mem 64} {a : BitVec 64} {v : BitVec 8} {F : Mem 64 → Prop}
    (h : m =⋆ cell1 a v ⋆ F) (w : BitVec 8) : m.storeInt a 1 w.toInt =⋆ cell1 a w ⋆ F :=
  storeInt_sep _ 1 _ _ m ⟨h, Int.toBytes_length 1 _⟩ w.toInt

theorem cell8_load {m : Mem 64} {a v : BitVec 64} {F : Mem 64 → Prop}
    (h : m =⋆ cell8 a v ⋆ F) : m.loadInt a 8 = some (Int.ofBytes (Int.toBytes 8 v.toInt)) :=
  loadInt_sep _ _ 8 F m h (Int.toBytes_length 8 _) (by omega)

theorem cell8_store {m : Mem 64} {a v : BitVec 64} {F : Mem 64 → Prop}
    (h : m =⋆ cell8 a v ⋆ F) (w : BitVec 64) : m.storeInt a 8 w.toInt =⋆ cell8 a w ⋆ F :=
  storeInt_sep _ 8 _ _ m ⟨h, Int.toBytes_length 8 _⟩ w.toInt

/-- A load from the start of a raw slot `n ?@ a` (any `k ≤ n` bytes). -/
theorem slot_load {m : Mem 64} {a : BitVec 64} {n k : Nat} {F : Mem 64 → Prop}
    (h : m =⋆ n ?@ a ⋆ F) (hk : k ≤ n) : (m.loadInt a k).isSome = true :=
  Block.loadInt_isSome h (by rw [BitVec.sub_self, BitVec.toNat_zero]; omega)

/-- A store to the start of a raw slot keeps the slot. -/
theorem slot_store {m : Mem 64} {a : BitVec 64} {n k : Nat} {F : Mem 64 → Prop}
    (h : m =⋆ n ?@ a ⋆ F) (hk : k ≤ n) (v : Int) : m.storeInt a k v =⋆ n ?@ a ⋆ F :=
  Block.storeInt h (by rw [BitVec.sub_self, BitVec.toNat_zero]; omega) v

/-- A load inside a block of `Blocks` (the bitstream buffer, a read-only table). -/
theorem blocks_load {m : Mem 64} {buf off : BitVec 64} {L n : Nat}
    {bs : List (BitVec 64 × Nat)} {F : Mem 64 → Prop}
    (h : m =⋆ Blocks ((buf, L) :: bs) ⋆ F) (hin : off.toNat + n ≤ L) :
    (m.loadInt (buf + off) n).isSome = true :=
  Blocks.loadInt_isSome h (Blocks.Inside.base_add hin)

end Focus

/-! ## Small arithmetic -/

section Arith

theorem lt4_cases (v : BitVec 64) (h : v.toNat < 4) :
    v = 0#64 ∨ v = 1#64 ∨ v = 2#64 ∨ v = 3#64 := by
  bv_omega

theorem lt4_cases32 (v : BitVec 32) (h : v.toNat < 4) :
    v = 0#32 ∨ v = 1#32 ∨ v = 2#32 ∨ v = 3#32 := by
  bv_omega

theorem sw8 (b : BitVec 8) : (b.setWidth 64).setWidth 8 = b := by
  apply BitVec.eq_of_toNat_eq
  simp only [BitVec.toNat_setWidth]
  have := b.isLt
  omega

theorem zx_small (n : Nat) (h : n < 2 ^ 31) :
    (BitVec.ofNat 32 n).setWidth 64 = BitVec.ofNat 64 n := by
  apply BitVec.eq_of_toNat_eq; simp [BitVec.toNat_setWidth]; omega

theorem zx8 (b : BitVec 8) : (b.setWidth 32).setWidth 64 = b.setWidth 64 := by
  apply BitVec.eq_of_toNat_eq; simp [BitVec.toNat_setWidth]

/-- Stack offsets after pops: `t - a + b = t - (a - b)` (use with `Nat.reduceSub`). -/
theorem sub_add_lit (t : BitVec 64) (a b : Nat) (h : b ≤ a) (ha : a < 2 ^ 64) :
    t - BitVec.ofNat 64 a + BitVec.ofNat 64 b = t - BitVec.ofNat 64 (a - b) := by
  apply BitVec.eq_of_toNat_eq
  simp only [BitVec.toNat_add, BitVec.toNat_sub, BitVec.toNat_ofNat]
  have := t.isLt
  rw [Nat.mod_eq_of_lt (a := a) ha, Nat.mod_eq_of_lt (a := b) (by omega),
    Nat.mod_eq_of_lt (a := a - b) (by omega)]
  omega

/-- `t - a + a = t`. -/
theorem sub_add_cancel_lit (t : BitVec 64) (a : Nat) :
    t - BitVec.ofNat 64 a + BitVec.ofNat 64 a = t := BitVec.sub_add_cancel _ _

end Arith

/-! ## Jump tables -/

section Jt

variable [CodeEnv]

/-- A jump-table entry (a 32-bit offset of the target `L` from the table `J`), read whole and
added to the table's address, lands on `L`. The layout fact `h` is a side condition of the
routine's precondition (the table has no symbol in the object). -/
theorem jt_target (J L : Label) (h : ((lab L - lab J).setWidth 32).signExtend 64 = lab L - lab J)
    (v : Int) (hv : v = Int.ofBytes (Int.toBytes 4 ((lab L - lab J).setWidth 32).toInt)) :
    Int64.ofBitVec (((_root_.Executable.labels cenv).label J).toBitVec
      + (BitVec.ofInt 32 v).signExtend 64) = (_root_.Executable.labels cenv).label L := by
  subst hv
  rw [BitVec.ofInt_ofBytes_toBytes 32 4 rfl, h]
  rw [BitVec.add_comm, BitVec.sub_add_cancel, Int64.ofBitVec_toBitVec]

end Jt

/-! ## Label keys

A block table with a `match` on label strings costs, per lookup, one reduction of a `String`
comparison per preceding case, and comparing two `String` literals by reduction is slow (their
UTF-8 bytes). With many labels, match on `labKey l` instead, a number: the label is reduced to
bytes once and the cases are numerals. `lkey "label"` writes the numeral of a label (also as a
pattern). -/

/-- The bytes of a label read as a big-endian number. -/
abbrev labKey (l : Label) : Nat := l.toByteArray.data.toList.foldl (fun n c => n * 256 + c.toNat) 0

end Kraken.Examples.Sbr.Parse

open Lean in
/-- `lkey "label"`: the numeral `labKey "label"` (usable as a `match` pattern). -/
macro "lkey " s:str : term =>
  return Syntax.mkNumLit (toString (s.getString.toUTF8.foldl (fun n c => n * 256 + c.toNat) 0))

open Lean Meta in
/-- `labKey "label"` to its numeral, in `simp`/`dsimp` (so that a table by key reduces at a
literal label without reducing the string). -/
dsimproc [simp] Kraken.Examples.Sbr.Parse.reduceLabKey (Kraken.Examples.Sbr.Parse.labKey _) :=
  fun e => do
    let_expr Kraken.Examples.Sbr.Parse.labKey s ← e | return .continue
    let .lit (.strVal str) := s | return .continue
    return .done (mkNatLit (str.toUTF8.foldl (fun n c => n * 256 + c.toNat) 0))

/-- `grind` for a small focused separating conjunction (array lemmas, a few cells). Never use
it on a whole footprint. -/
macro "cells_grind" : tactic =>
  `(tactic| grind (ematch := 400) (gen := 400) (instances := 20000) (mbtc := false)
      [-BitVec.toInt_eq_toNat_of_msb, -BitVec.toInt_eq_toNat_bmod])
