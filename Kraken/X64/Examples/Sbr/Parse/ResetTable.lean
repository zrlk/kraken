/-- The table: the entry of the `i`-th label is `ENT[i]`. -/
def table (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ : MachineData) (l : Label)
    (s : MachineData) : Prop :=
  Program.LTable labelList (ENT k e a ra t₀) l s

namespace T

theorem start {k e a ra t₀ s} : table k e a ra t₀ "sbr_reset" s ↔ E.start k e a ra t₀ s :=
  Program.LTable.iff labelList_nodup (i := 0) rfl rfl
theorem L1086 {k e a ra t₀ s} : table k e a ra t₀ "sbr_reset.L1086" s ↔ E.L1086 k e a ra t₀ s :=
  Program.LTable.iff labelList_nodup (i := 1) rfl rfl
