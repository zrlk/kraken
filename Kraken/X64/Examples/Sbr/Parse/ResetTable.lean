import Kraken.X64.Examples.Sbr.Parse.ResetIface
import Kraken.X64.Examples.Sbr.Parse.LibQsort

/-!
# `sbr_reset`: the table

Generated by `scripts/sbr/parse/reset/table.py` from the entry files
`scripts/sbr/parse/reset/spec/*.py`. The table is position-indexed (`Program.LTable`): the
entry of the `i`-th label is `ENT[i]`; `T.<id>` rewrites the table at a literal label to its
entry. The variant of a label is `lex` of its digits: the rank of its loop (strongly connected
component) in the control-flow graph, then the loop's own measure.
-/

open Kraken Kraken.SysV Mem Kraken.X64.Parser Std.WP MachineWP
open Kraken.Examples.Sbr Kraken.Examples.Sbr.Apply Kraken.Examples.Sbr.ParseModel

set_option mvcgen.warning false

namespace Kraken.Examples.Sbr.Reset

variable [CodeEnv]


/-! ## Shard A1: `sbr_make_f_master` up to `L2012` -/

/-- `sbr->sample_rate` as an integer. -/
abbrev srI (a : RArgs) : Int := a.x.sampleRate.toInt

/-- The row `sbr_offset[r]` at its label. -/
def offLab : Nat → BitVec 64
  | 0 => lab "sbr_offset_0"
  | 1 => lab "sbr_offset_1"
  | 2 => lab "sbr_offset_2"
  | 3 => lab "sbr_offset_3"
  | 4 => lab "sbr_offset_4"
  | _ => lab "sbr_offset_5"

/-- `temp` of `sbr_make_f_master` (`3000`, `4000`, `5000`). -/
def tmpOf (sr : Nat) : Nat := if sr < 32000 then 3000 else if sr < 64000 then 4000 else 5000

/-- `k[0]` for the row. -/
abbrev k0A (a : RArgs) (row : Nat) : Int := k0Of (srI a) row (u8 a.sp 0)

abbrev k0N (a : RArgs) (row : Nat) : Nat := (k0A a row).toNat

/-- The decoder values with `k[0]` stored. -/
abbrev xk0 (a : RArgs) (row : Nat) : Args := { a.x with k0 := k0N a row }

/-- Inside `sbr_make_f_master`: the side conditions, `rsp`/`rbp`, the memory `Mm` at values
`st` whose decoder values are `x`, and `P` on the rest. -/
def A1S (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ s : MachineData) (x : Args)
    (P : St → List UInt8 → Prop) : Prop :=
  ResetCI a t₀ ∧ BandsOK e.lg e.pw ∧ Base t₀ s
  ∧ ∃ (st : St) (fr : List UInt8), st.x = x ∧ st.sp = a.sp ∧ st.fm.length = 98 ∧ FrOk fr
    ∧ P st fr ∧ (s.dmem =⋆ Mm k e a ra t₀ st fr)

/-- The pushed registers after `j` pushes (`j = 2`: `rbp`, `r15`; `j = 4`: also `r14`, `r13`). -/
def ProM (j : Nat) (t₀ : MachineData) : Mem 64 → Prop :=
  let r := t₀.regs.get64 .rsp
  match j with
  | 2 => c8 (r - 0x8#64) (t₀.regs.get64 .rbp) ⋆ c8 (r - 0x10#64) (t₀.regs.get64 .r15)
  | _ => c8 (r - 0x8#64) (t₀.regs.get64 .rbp) ⋆ (c8 (r - 0x10#64) (t₀.regs.get64 .r15)
      ⋆ (c8 (r - 0x18#64) (t₀.regs.get64 .r14) ⋆ c8 (r - 0x20#64) (t₀.regs.get64 .r13)))

/-- The prologue after `j` pushes: the rest of the reservation below them. -/
def Pro (j : Nat) (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ s : MachineData) : Prop :=
  ResetCI a t₀ ∧ BandsOK e.lg e.pw
  ∧ s.regs.get64 .rsp = t₀.regs.get64 .rsp - BitVec.ofNat 64 (8 * j)
  ∧ s.regs.get64 .rbp = t₀.regs.get64 .rsp - 8#64
  ∧ s.regs.get64 .rdi = arg0 t₀ ∧ s.regs.get64 .rsi = arg1 t₀
  ∧ s.regs.get64 .rbx = t₀.regs.get64 .rbx ∧ s.regs.get64 .r12 = t₀.regs.get64 .r12
  ∧ s.regs.get64 .r13 = t₀.regs.get64 .r13 ∧ s.regs.get64 .r14 = t₀.regs.get64 .r14
  ∧ (s.dmem =⋆ ProM j t₀ ⋆ (Reserve (resetNeed k - 8 * j)
      (t₀.regs.get64 .rsp - BitVec.ofNat 64 (8 * j)) ⋆ (RetCell ra (t₀.regs.get64 .rsp)
      ⋆ (RF e a t₀ ⋆ a.x.R))))

/-- The rate dispatch: nothing written, `rcx` the rate. -/
def RD (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ s : MachineData) : Prop :=
  A1S k e a ra t₀ s a.x (fun _ _ => True) ∧ s.regs.get64 .r12 = arg1 t₀
  ∧ s.regs.get64 .r15 = arg0 t₀ ∧ s.regs.get64 .rcx = a.x.sampleRate.setWidth 64

/-- After `k[0]` (row `row`): `r12 = sbr`, `r15 = ac`, `P` on the rest. -/
def K0S (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ s : MachineData)
    (P : Nat → St → List UInt8 → Prop) : Prop :=
  ∃ row, rateRow (srI a) = some row
    ∧ A1S k e a ra t₀ s (xk0 a row) (P row) ∧ s.regs.get64 .r12 = arg1 t₀
    ∧ s.regs.get64 .r15 = arg0 t₀

/-- The `stop_dk` part (`bs_stop_freq < 14`): `ac` and `sbr` saved in the frame. -/
def SD (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ s : MachineData)
    (P : St → List UInt8 → Prop) : Prop :=
  ∃ row, rateRow (srI a) = some row ∧ u8 a.sp 1 ≤ 13
    ∧ A1S k e a ra t₀ s (xk0 a row)
      (fun st fr => frSlot64 fr 0x40 = arg0 t₀ ∧ frSlot64 fr 0x30 = arg1 t₀ ∧ P st fr)

/-- The unrolled `stop_dk` sum (`L1555` .. `L15fb`): `r12 = sbr`, `r15 = ac`,
`rax = bs_stop_freq`; `k[2]` is scratch. -/
def SumS (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ s : MachineData) : Prop :=
  SD k e a ra t₀ s (fun _ _ => True) ∧ s.regs.get64 .r12 = arg1 t₀
  ∧ s.regs.get64 .r15 = arg0 t₀ ∧ s.regs.get64 .rax = BitVec.ofNat 64 (u8 a.sp 1)

/-- `k[2]` clamped (`≤ 64`) and stored, `rsi = k[2]`. -/
def K2S (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ s : MachineData) : Prop :=
  ∃ row k2, rateRow (srI a) = some row ∧ k2 ≤ 64
    ∧ A1S k e a ra t₀ s (xk0 a row) (fun st _ => st.k2 = BitVec.ofNat 32 k2)
    ∧ s.regs.get64 .r12 = arg1 t₀ ∧ s.regs.get64 .r15 = arg0 t₀
    ∧ s.regs.get64 .rsi = BitVec.ofNat 64 k2

/-- **The interface A1 → A2 at `L1684`**: `k[0]`, `k[2]` stored and checked as `Master`
requires; `rsi = k[2]`, `r13 = k[0]`, `rcx = k[2] - k[0]`. -/
def AtMaster (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ s : MachineData) : Prop :=
  ∃ (row k2 : Nat), rateRow (srI a) = some row ∧ k2 ≤ 64 ∧ k0N a row ≤ k2
    ∧ (k2 : Int) - k0A a row ≤ maxQ (srI a)
    ∧ A1S k e a ra t₀ s (xk0 a row) (fun st _ => st.k2 = BitVec.ofNat 32 k2)
    ∧ s.regs.get64 .r12 = arg1 t₀ ∧ s.regs.get64 .r15 = arg0 t₀
    ∧ s.regs.get64 .rsi = BitVec.ofNat 64 k2 ∧ s.regs.get64 .r13 = BitVec.ofNat 64 (k0N a row)
    ∧ s.regs.get64 .rcx = BitVec.ofNat 64 (k2 - k0N a row)

/-- `n_master` for `bs_freq_scale = 0`: `((k[2] - k[0] + (dk & 2)) >> dk) << 1`,
`dk = bs_alter_scale + 1`. -/
def nmOf (d alter : Nat) : Nat := if alter = 0 then 2 * (d / 2) else 2 * ((d + 2) / 4)

/-- `k2diff = k[2] - k[0] - n_master * dk`. -/
abbrev diffOf (k0 k2 nm dk : Nat) : Int := (k2 : Int) - k0 - nm * dk

/-- The steps `f_master[i]`, `1 ≤ i ≤ n_master`, after the `k2diff` correction. -/
def stepOf (dk nm : Nat) (diff : Int) (i : Nat) : Int :=
  dk - (if diff < 0 ∧ i = 1 then 1 else 0) - (if diff < -1 ∧ i = 2 then 1 else 0)
    + (if 0 < diff ∧ i = nm then 1 else 0)

/-- `f_master[j]` after the prefix sums. -/
def fvOf (k0 dk nm : Nat) (diff : Int) : Nat → Int
  | 0 => k0
  | j + 1 => fvOf k0 dk nm diff j + stepOf dk nm diff (j + 1)

/-- `f_master[1 .. j)` hold `dk`. -/
def Filled (fm : List UInt8) (dk j : Nat) : Prop := ∀ i, 1 ≤ i → i < j → u16 fm i = dk

/-- `f_master[1 ..= nm]` hold the steps. -/
def Stepped (fm : List UInt8) (dk nm : Nat) (diff : Int) : Prop :=
  ∀ i, 1 ≤ i → i ≤ nm → (u16 fm i : Int) = stepOf dk nm diff i

/-- The prefix sums done up to `j`. -/
def Summed (fm : List UInt8) (k0 dk nm : Nat) (diff : Int) (j : Nat) : Prop :=
  (∀ i, i ≤ j → (u16 fm i : Int) = fvOf k0 dk nm diff i)
  ∧ ∀ i, j < i → i ≤ nm → (u16 fm i : Int) = stepOf dk nm diff i

/-- The `int16` broadcast of `v` (`vmovd` + `vpshufb` with `.LCPI5_4`). -/
def bc16 (v : Nat) : BitVec 128 :=
  let w := BitVec.ofNat 16 v
  w ++ w ++ w ++ w ++ w ++ w ++ w ++ w

/-- `bs_freq_scale = 0`: `k[0]`, `k[2]` checked; `P k0 k2 nm dk st fr` on the rest
(`nm = n_master`, `dk = bs_alter_scale + 1`). -/
def F0 (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ s : MachineData)
    (P : Nat → Nat → Nat → Nat → St → List UInt8 → Prop) : Prop :=
  ∃ (row k2 : Nat), rateRow (srI a) = some row ∧ k2 ≤ 64 ∧ k0N a row ≤ k2
    ∧ (k2 : Int) - k0A a row ≤ maxQ (srI a) ∧ u8 a.sp 3 = 0
    ∧ A1S k e a ra t₀ s (xk0 a row) (fun st fr => st.k2 = BitVec.ofNat 32 k2
        ∧ P (k0N a row) k2 (nmOf (k2 - k0N a row) (u8 a.sp 4)) (u8 a.sp 4 + 1) st fr)
    ∧ s.regs.get64 .r12 = arg1 t₀ ∧ s.regs.get64 .r15 = arg0 t₀

/-- `n_master` stored and checked (`2 ≤ nm`, `bs_xover_band < nm`), `rdx = nm`. -/
abbrev F0b (s : MachineData) (nm : Nat) (st : St) (a : RArgs) : Prop :=
  2 ≤ nm ∧ u8 a.sp 2 < nm ∧ st.nm = BitVec.ofNat 32 nm ∧ s.regs.get64 .rdx = BitVec.ofNat 64 nm

/-- `F0b` and `rsi = k[2]`, `r13 = k[0]`, `rax = dk`, `rcx = nm` (the fill loops). -/
abbrev F0n (s : MachineData) (k0 k2 nm dk : Nat) (st : St) (a : RArgs) : Prop :=
  F0b s nm st a ∧ s.regs.get64 .rsi = BitVec.ofNat 64 k2 ∧ s.regs.get64 .r13 = BitVec.ofNat 64 k0
  ∧ s.regs.get64 .rax = BitVec.ofNat 64 dk ∧ s.regs.get64 .rcx = BitVec.ofNat 64 nm

/-- `xmm0` holds the `int16` broadcast of `dk`. -/
abbrev Xbc (s : MachineData) (dk : Nat) : Prop :=
  (s.zmms.get (AvxReg.xmm .mm0)).setWidth 128 = bc16 dk


/-! ## Shard A2: `bs_freq_scale > 0` -/

namespace A2

/-- `k[1]`: `2 k[0]` with two regions (`49 k[2] > 110 k[0]`), else `k[2]`. -/
abbrev k1Of (k0 k2 : Nat) : Nat := if 110 * k0 < 49 * k2 then 2 * k0 else k2

/-- The `int16` element `j` of the frame array at byte offset `o`. -/
abbrev fv (fr : List UInt8) (o j : Nat) : Int :=
  (BitVec.ofInt 16 (Int.ofBytes (Parse.slice fr (o + 2 * j) 2))).toInt

/-- `(float)n`. -/
abbrev fl (n : Nat) : BitVec 32 := BitVec.sitof32 (BitVec.ofNat 32 n)

/-- `7 - bs_freq_scale` as a float (`.LCPI` free: `vcvtsi2ss`). -/
abbrev h0Of (a : RArgs) : BitVec 32 := fl (7 - u8 a.sp 3)

/-- The factor of the second band count: `h0 * invwarp`. -/
abbrev h1Of (a : RArgs) : BitVec 32 := BitVec.f32mul (h0Of a) (invwarp (u8 a.sp 4))

/-- `base = powf(stop / start, 1 / nb)` of `make_bands`. -/
abbrev bOf (pw : BitVec 32 → BitVec 32 → BitVec 32) (start stop nb : Nat) : BitVec 32 :=
  pw (BitVec.f32div (fl stop) (fl start)) (BitVec.f32div f1 (fl nb))

/-- `lrintf(prod)` after `j` steps of `make_bands`; `start` at `j = 0`. -/
def pv (b : BitVec 32) (start j : Nat) : Int :=
  if j = 0 then start else (BitVec.f32toi64 (chain b (fl start) j)).toInt

/-- What `make_bands` writes at the 1-based index `i` (`bands[i - 1]`). -/
def mb (b : BitVec 32) (start stop nb i : Nat) : Int :=
  if i < nb then pv b start i - pv b start (i - 1) else stop - pv b start (nb - 1)

/-- `Σ_{1 ≤ i ≤ n} A i`. -/
def ssum (A : Nat → Int) : Nat → Int
  | 0 => 0
  | n + 1 => ssum A n + A (n + 1)

/-- The first band count and its `make_bands` base. -/
abbrev n0I (e : REnv) (a : RArgs) (k0 k2 : Nat) : Int := nbOf e.lg k0 (k1Of k0 k2) (h0Of a)
abbrev n0N (e : REnv) (a : RArgs) (k0 k2 : Nat) : Nat := (n0I e a k0 k2).toNat
abbrev b0 (e : REnv) (a : RArgs) (k0 k2 : Nat) : BitVec 32 :=
  bOf e.pw k0 (k1Of k0 k2) (n0N e a k0 k2)

/-- The second band count (two regions) and its base. -/
abbrev n1I (e : REnv) (a : RArgs) (k0 k2 : Nat) : Int := nbOf e.lg (k1Of k0 k2) k2 (h1Of a)
abbrev n1N (e : REnv) (a : RArgs) (k0 k2 : Nat) : Nat := (n1I e a k0 k2).toNat
abbrev b1 (e : REnv) (a : RArgs) (k0 k2 : Nat) : BitVec 32 :=
  bOf e.pw (k1Of k0 k2) k2 (n1N e a k0 k2)

/-- `vk[1 ..= j]` hold the `make_bands` values. -/
def MB (fr : List UInt8) (o : Nat) (b : BitVec 32) (start stop nb j : Nat) : Prop :=
  ∀ i, 1 ≤ i → i ≤ j → fv fr o i = mb b start stop nb i

/-- `vk[1 ..= n]` is a list `A` with entries in `[-B, B]` summing to `tot`. -/
def Arr (fr : List UInt8) (o n : Nat) (B : Int) (tot : Int) : Prop :=
  ∃ A : Nat → Int, (∀ i, 1 ≤ i → i ≤ n → fv fr o i = A i ∧ -B ≤ A i ∧ A i ≤ B) ∧ ssum A n = tot

/-- The prefix sums done below `j`: `vk[i] = v0 + Σ_{l ≤ i} A l` for `i < j` (each `A l > 0`),
`vk[i] = A i` for `j ≤ i ≤ n`; `A` in `[-B, B]`, summing to `tot`. -/
def Pfx (fr : List UInt8) (o n j : Nat) (B v0 tot : Int) (A : Nat → Int) : Prop :=
  (∀ i, 1 ≤ i → i ≤ n → -B ≤ A i ∧ A i ≤ B) ∧ ssum A n = tot
  ∧ (∀ i, i < j → fv fr o i = v0 + ssum A i) ∧ (∀ i, 1 ≤ i → i < j → 0 < A i)
  ∧ (∀ i, j ≤ i → i ≤ n → fv fr o i = A i)

/-- `vk[0 ..= n]` strictly increasing from `v0` to `v1`. -/
def Inc (fr : List UInt8) (o n : Nat) (v0 v1 : Int) : Prop :=
  fv fr o 0 = v0 ∧ fv fr o n = v1 ∧ ∀ i, i < n → fv fr o i < fv fr o (i + 1)

/-- Inside the `bs_freq_scale > 0` part: `AtMaster`'s facts, `bs_freq_scale ≠ 0`, `k[1]`
stored, `P k0 k2 st fr` on the rest. -/
def S (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ s : MachineData)
    (P : Nat → Nat → St → List UInt8 → Prop) : Prop :=
  ∃ (row k2 : Nat), rateRow (srI a) = some row ∧ k2 ≤ 64 ∧ k0N a row ≤ k2
    ∧ (k2 : Int) - k0A a row ≤ maxQ (srI a) ∧ 1 ≤ u8 a.sp 3
    ∧ A1S k e a ra t₀ s (xk0 a row) (fun st fr => st.k2 = BitVec.ofNat 32 k2
        ∧ st.k1 = BitVec.ofNat 32 (k1Of (k0N a row) k2) ∧ P (k0N a row) k2 st fr)

/-- The failure exits inside A2 before `ac` is reloaded: `r12 = sbr`, `ac` in the frame. -/
def F (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ s : MachineData) : Prop :=
  ∃ row, rateRow (srI a) = some row
    ∧ A1S k e a ra t₀ s (xk0 a row) (fun _ fr => frSlot64 fr 0x40 = arg0 t₀)
    ∧ s.regs.get64 .r12 = arg1 t₀

/-! ### Frame slots -/

/-- After `L1684`: `-0x80 = 49 k[2]`, `-0x88 = 110 k[0]`. -/
abbrev SA (fr : List UInt8) (k0 k2 : Nat) : Prop :=
  frSlot32 fr 0x80 = BitVec.ofNat 32 (49 * k2) ∧ frSlot32 fr 0x88 = BitVec.ofNat 32 (110 * k0)

/-- After `L16b7`: also `-0x38 = (float)(7 - bs_freq_scale)`. -/
abbrev SB (fr : List UInt8) (a : RArgs) (k0 k2 : Nat) : Prop :=
  SA fr k0 k2 ∧ frSlot32 fr 0x38 = h0Of a

/-- After `L16db`: also `2 * low32(-0x50) = num_bands_0`, `-0x40 = ac`. -/
abbrev SC (fr : List UInt8) (e : REnv) (a : RArgs) (t₀ : MachineData) (k0 k2 : Nat) : Prop :=
  SB fr a k0 k2 ∧ frSlot32 fr 0x50 + frSlot32 fr 0x50 = BitVec.ofNat 32 (n0N e a k0 k2)
  ∧ frSlot64 fr 0x40 = arg0 t₀

/-- After `L16f8`: also `-0x30 = sbr`. -/
abbrev SD (fr : List UInt8) (e : REnv) (a : RArgs) (t₀ : MachineData) (k0 k2 : Nat) : Prop :=
  SC fr e a t₀ k0 k2 ∧ frSlot64 fr 0x30 = arg1 t₀

/-- After `L171d`: also the low lane of `-0x100` is `(float)k[0]`. -/
abbrev SE (fr : List UInt8) (e : REnv) (a : RArgs) (t₀ : MachineData) (k0 k2 : Nat) : Prop :=
  SD fr e a t₀ k0 k2 ∧ frSlot32 fr 0x100 = fl k0

/-- After `L173b`: also `-0x48 = num_bands_0`. -/
abbrev SF (fr : List UInt8) (e : REnv) (a : RArgs) (t₀ : MachineData) (k0 k2 : Nat) : Prop :=
  SE fr e a t₀ k0 k2 ∧ frSlot64 fr 0x48 = BitVec.ofNat 64 (n0N e a k0 k2)

/-- `num_bands_0` in range (`BandsOK`), the loop facts of the first `make_bands`. -/
abbrev N0 (e : REnv) (a : RArgs) (k0 k2 : Nat) : Prop :=
  0 < n0I e a k0 k2 ∧ n0I e a k0 k2 ≤ 48 ∧ n0N e a k0 k2 % 2 = 0

/-- The two-region part: `-0x40 = ac`, `-0x48 = nb0`, `-0x88 = nb0 + 1`, `-0x50 = vdk0_max`. -/
abbrev TA (fr : List UInt8) (t₀ : MachineData) (n0 : Nat) (vm : Int) : Prop :=
  frSlot64 fr 0x40 = arg0 t₀ ∧ frSlot64 fr 0x48 = BitVec.ofNat 64 n0
  ∧ frSlot64 fr 0x88 = BitVec.ofNat 64 (n0 + 1) ∧ frSlot32 fr 0x50 = BitVec.ofInt 32 vm

/-- `num_bands_1` in range (`BandsOK`). -/
abbrev N1 (e : REnv) (a : RArgs) (k0 k2 : Nat) : Prop :=
  2 ≤ n1I e a k0 k2 ∧ n1I e a k0 k2 ≤ 48 ∧ n1N e a k0 k2 % 2 = 0

/-- After `L1cb9`: also the low lane of `-0x80` is `(float)k[1]`, `-0x38 = nb1`,
`-0x100 = nb1 - 1`, `-0x30 = sbr`. -/
abbrev TB (fr : List UInt8) (t₀ : MachineData) (k1 n0 n1 : Nat) (vm : Int) : Prop :=
  TA fr t₀ n0 vm ∧ frSlot32 fr 0x80 = fl k1 ∧ frSlot64 fr 0x38 = BitVec.ofNat 64 n1
  ∧ frSlot64 fr 0x100 = BitVec.ofNat 64 (n1 - 1)

end A2


/-! ## Shard B: `sbr_make_f_derived` -/

/-- `bs_xover_band`. -/
abbrev xoOf (a : RArgs) : Nat := u8 a.sp 2

/-- The decoder values after `sbr_make_f_master` stored `k[0]`. -/
abbrev x0D (a : RArgs) (k0 : Int) : Args := { a.x with k0 := k0.toNat }

/-- `derived1`'s stores, one at a time (`n[1]`, `n[0]`, `f_tablehigh`, `m[1]`; then `kx[1]`). -/
abbrev d1a (x : Args) (nm xo : Nat) : Args := { x with n1 := nm - xo }
abbrev d1b (x : Args) (nm xo : Nat) : Args := { d1a x nm xo with n0 := (nm - xo + 1) / 2 }
abbrev d1c (x : Args) (nm xo : Nat) (f : Nat → Nat) : Args :=
  { d1b x nm xo with ftHigh := mk16 49 (fun i => if i ≤ nm - xo then f (xo + i) else u16 x.ftHigh i) }
abbrev d1d (x : Args) (nm xo : Nat) (f : Nat → Nat) : Args :=
  { d1c x nm xo f with m1 := f nm - f xo }

/-- Inside `sbr_make_f_derived`: `Master` succeeded with `n_master = nm`, `f_master = fOf st`
(not written again), `ac` in the frame slot `rbp - 0x40`; `P` the progress. -/
def AtDer (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ s : MachineData)
    (P : St → List UInt8 → Nat → Int → Prop) : Prop :=
  ResetCI a t₀ ∧ Base t₀ s ∧ ∃ (st : St) (fr : List UInt8) (nm : Nat) (k0 : Int),
    Master a.x.sampleRate.toInt (u8 a.sp 0) (u8 a.sp 2) (some k0) (some (nm, fOf st))
    ∧ st.sp = a.sp ∧ st.fm.length = 98 ∧ FrOk fr ∧ frSlot64 fr 0x40 = arg0 t₀
    ∧ P st fr nm k0 ∧ (s.dmem =⋆ Mm k e a ra t₀ st fr)
/-- After `sbr_hf_calc_npatches` succeeded: what `Derived.ok` asks before
`sbr_make_f_tablelim`, the current values being `y` (the patches' result). -/
def TailOk (a : RArgs) (y : Args) : Prop :=
  ∃ (k0 : Int) (nm : Nat) (f : Nat → Nat) (q : Nat),
    Master a.x.sampleRate.toInt (u8 a.sp 0) (xoOf a) (some k0) (some (nm, f))
    ∧ (derived1 (x0D a k0) nm (xoOf a) f).kx1 + (derived1 (x0D a k0) nm (xoOf a) f).m1 ≤ 64
    ∧ (derived1 (x0D a k0) nm (xoOf a) f).kx1 ≤ 32 ∧ 1 ≤ q ∧ q ≤ 5
    ∧ Patches f a.x.sampleRate.toInt (x0D a k0).k0 (f (xoOf a)) (f nm - f (xoOf a)) nm
        (derived3 (derived2 (derived1 (x0D a k0) nm (xoOf a) f) (xoOf a) f) q) y true

/-- `sbr_make_f_tablelim`'s requirements on the values (`TlimC` without the address bound). -/
def TlimIn (a : RArgs) (y : Args) : Prop :=
  y.n0 ≤ 24 ∧ y.npatch ≤ 6 ∧ (0 < a.lb.toNat → 1 ≤ y.n0 + y.npatch)
  ∧ y.ftLow.length = 50 ∧ y.ftLim.length = 60 ∧ y.pnum.length = 6
  ∧ TabIn y.ftLow y.n0 y.kx1 (y.kx1 + y.m1) ∧ psum y.pnum y.npatch ≤ y.m1 ∧ y.kx1 + y.m1 ≤ 64
  ∧ y.nlim < 2 ^ 32

/-- `sbr_make_f_derived` returned `0` with the values `z`. -/
def DerOk (a : RArgs) (z : Args) : Prop :=
  ∃ (k0 : Int) (nm : Nat) (f : Nat → Nat),
    Master a.x.sampleRate.toInt (u8 a.sp 0) (xoOf a) (some k0) (some (nm, f))
    ∧ Derived a.x.sampleRate.toInt a.lb.toNat nm (xoOf a) f (x0D a k0) z true

/-- The success tail (`L3228`, `L3230`): `r12 = sbr`, `P` the progress. -/
def AtTail (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ s : MachineData) (P : St → Prop) : Prop :=
  ResetCI a t₀ ∧ Base t₀ s ∧ s.regs.get64 .r12 = arg1 t₀
  ∧ ∃ (st : St) (fr : List UInt8), P st ∧ st.sp = a.sp ∧ st.fm.length = 98 ∧ FrOk fr
    ∧ (s.dmem =⋆ Mm k e a ra t₀ st fr)
/-- `derived1` then `derived2` (`f_tablelow` copied). -/
abbrev dD2 (a : RArgs) (k0 : Int) (nm : Nat) (f : Nat → Nat) : Args :=
  derived2 (derived1 (x0D a k0) nm (xoOf a) f) (xoOf a) f

/-- The `n_q` part (from `L2b30`): derived1's checks passed, `f_tablelow` copied, the frame slots
`rbp - 0x30` (`sbr`), `rbp - 0x38` (`n_master`); `P` the progress. -/
def AtNq (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ s : MachineData)
    (P : St → List UInt8 → Nat → Int → Prop) : Prop :=
  AtDer k e a ra t₀ s (fun st fr nm k0 => NqIn e st ∧ (fOf st) nm ≤ 64 ∧ (fOf st) (xoOf a) ≤ 32
    ∧ frSlot64 fr 0x30 = arg1 t₀ ∧ frSlot64 fr 0x38 = BitVec.ofNat 64 nm ∧ P st fr nm k0)


/-! ## Shard B (env): `sbr_make_f_derived`, the `f_tablelow` copy (`derived2`) -/

/-- `f_tablelow` with entry `0` stored and the entries `1..m` copied from `f_tablehigh`. -/
def LowM (x : Args) (xo : Nat) (f : Nat → Nat) (m : Nat) : List UInt8 :=
  mk16 25 (fun k => if k = 0 then f xo
    else if k ≤ m then f (xo + (2 * k - x.n1 % 2)) else u16 x.ftLow k)

/-- `derived1`'s values. -/
abbrev dD1 (a : RArgs) (k0 : Int) (nm : Nat) (f : Nat → Nat) : Args :=
  derived1 (x0D a k0) nm (xoOf a) f

/-- `derived2` in progress: `m` entries copied. -/
abbrev dLw (a : RArgs) (k0 : Int) (nm : Nat) (f : Nat → Nat) (m : Nat) : Args :=
  { dD1 a k0 nm f with ftLow := LowM (dD1 a k0 nm f) (xoOf a) f m }

/-- The remainder of the 16-wide loop (`n0 & 15`, or `16`). -/
abbrev R16 (n : Nat) : Nat := if n % 16 = 0 then 16 else n % 16

/-- The remainder of the 4-wide loop (`n0 & 3`, or `4`). -/
abbrev R4 (n : Nat) : Nat := if n % 4 = 0 then 4 else n % 4

/-- The `vpshufb` mask of the 16-wide loop (`.LCPI5_6`). -/
abbrev C56 : BitVec 128 := 0x0f0e0d0c0d0c09080d0c090805040100#128

/-- The `vpshufb` mask of the 4-wide loop (`.LCPI5_9`, `vmovq`). -/
abbrev C59 : BitVec 128 := 0x0d0c090805040100#128

/-- The `f_tablelow` copy: `m` entries done; `r14 = f xo`, `r15 = n0`, `r10 = f xo`, `rcx = f nm`
(stored by `L2b30`); `P n0 p m` the
registers (`p = n1 % 2`). -/
def AtLw (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ s : MachineData)
    (P : Nat → Nat → Nat → Prop) : Prop :=
  AtNq k e a ra t₀ s (fun st fr nm k0 => ∃ m, st.x = dLw a k0 nm (fOf st) m
    ∧ s.regs.get64 .r14 = BitVec.ofNat 64 ((fOf st) (xoOf a))
    ∧ s.regs.get64 .r15 = BitVec.ofNat 64 ((nm - (xoOf a) + 1) / 2)
    ∧ s.regs.get64 .r10 = BitVec.ofNat 64 ((fOf st) (xoOf a)) ∧ s.regs.get64 .rcx = BitVec.ofNat 64 ((fOf st) nm)
    ∧ P ((nm - (xoOf a) + 1) / 2) ((nm - (xoOf a)) % 2) m)


/-! ## Shard B: `sbr_hf_calc_npatches` (owner gB) -/

/-- The context of the patch loop: `k[0]`, `n_master`, `n_q`. -/
structure PCx where
  k0 : Int
  nm : Nat
  q : Nat

/-- The values the patch loop starts from (`derived3 ∘ derived2 ∘ derived1`). -/
abbrev px0 (a : RArgs) (c : PCx) (f : Nat → Nat) : Args :=
  derived3 (derived2 (derived1 (x0D a c.k0) c.nm (xoOf a) f) (xoOf a) f) c.q

/-- `k[0]`, `kx[1]`, `kx[1] + m[1]` as the model's loop sees them. -/
abbrev pk0 (c : PCx) : Nat := c.k0.toNat
abbrev pkx (a : RArgs) (f : Nat → Nat) : Nat := f (xoOf a)
abbrev ptop (a : RArgs) (c : PCx) (f : Nat → Nat) : Nat := f (xoOf a) + (f c.nm - f (xoOf a))

/-- The loop's start state (`Patches.run`). -/
abbrev pinit (a : RArgs) (c : PCx) (f : Nat → Nat) (ki : Nat) : PL :=
  { k := ki, lk := -1, msb := pk0 c, lmsb := -1, usb := pkx a f, np := 0,
    pn := mk 6 (old (px0 a c f).pnum), pst := mk 6 (old (px0 a c f).pstart), sb := 0 }

abbrev PR (a : RArgs) (c : PCx) (f : Nat → Nat) : PL → PL → Bool → Prop :=
  PRun f (pk0 c) (pkx a f) c.nm (ptop a c f)

/-- `s` is reached from the start: every run from `s` is a run from the start. -/
def PReach (a : RArgs) (c : PCx) (f : Nat → Nat) (s : PL) : Prop :=
  ∃ ki, KInit f c.nm (ptop a c f) (goalSb a.x.sampleRate.toInt) ki
    ∧ ∀ r b, PR a c f s r b → PR a c f (pinit a c f ki) r b

/-- The fixed facts of the loop: `Derived`'s checks passed, `sbr_make_f_tablelim`'s needs on the
values that the loop does not write. -/
def PFix (a : RArgs) (c : PCx) (f : Nat → Nat) : Prop :=
  Master a.x.sampleRate.toInt (u8 a.sp 0) (xoOf a) (some c.k0) (some (c.nm, f))
  ∧ (derived1 (x0D a c.k0) c.nm (xoOf a) f).kx1 + (derived1 (x0D a c.k0) c.nm (xoOf a) f).m1 ≤ 64
  ∧ (derived1 (x0D a c.k0) c.nm (xoOf a) f).kx1 ≤ 32 ∧ 1 ≤ c.q ∧ c.q ≤ 5
  ∧ TlimIn a { px0 a c f with npatch := 0 } ∧ (px0 a c f).pstart.length = 6

/-- The values while the loop runs in state `s`. -/
abbrev pxs (a : RArgs) (c : PCx) (f : Nat → Nat) (s : PL) : Args :=
  { px0 a c f with npatch := s.np, pnum := s.pn, pstart := s.pst }

/-- The loop invariant at `L312e` (and its variant facts). -/
def PHd (a : RArgs) (c : PCx) (f : Nat → Nat) (s : PL) : Prop :=
  PReach a c f s ∧ PInv (pk0 c) (pkx a f) c.nm (ptop a c f) s
  ∧ ((s.msb : Int) = s.lmsb → s.msb = pkx a f) ∧ (s.msb ≠ s.usb → s.msb ≠ pkx a f → s.lk = -1)
  ∧ -1 ≤ s.lk ∧ s.lk ≤ 48 ∧ -1 ≤ s.lmsb ∧ s.lmsb ≤ 64

/-- Not `k == last_k && msb == last_msb`. -/
abbrev PNr (s : PL) : Prop := ¬ ((s.k : Int) = s.lk ∧ (s.msb : Int) = s.lmsb)

/-- Inside the patch loop: `r12 = sbr` unless said otherwise, the frame slots of the loop. -/
def AtPat (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ s : MachineData)
    (P : St → PCx → Prop) : Prop :=
  ResetCI a t₀ ∧ Base t₀ s ∧ ∃ (st : St) (fr : List UInt8) (c : PCx),
    PFix a c (fOf st) ∧ st.sp = a.sp ∧ st.fm.length = 98 ∧ FrOk fr
    ∧ frSlot64 fr 0x40 = arg0 t₀ ∧ frSlot64 fr 0x30 = arg1 t₀
    ∧ frSlot64 fr 0x38 = BitVec.ofNat 64 c.nm ∧ frSlot64 fr 0x48 = arg1 t₀ + 0x4c1f0#64
    ∧ frSlot32 fr 0x50 = BitVec.ofNat 32 (ptop a c (fOf st))
    ∧ frSlot32 fr 0x80 = BitVec.ofNat 32 (pkx a (fOf st))
    ∧ P st c ∧ (s.dmem =⋆ Mm k e a ra t₀ st fr)

/-- A failure of the patch loop decided (`Derived.badPatch`): the values, `r12 = sbr`. -/
def AtPatF (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ s : MachineData) : Prop :=
  ResetCI a t₀ ∧ Base t₀ s ∧ s.regs.get64 .r12 = arg1 t₀
  ∧ ∃ (st : St) (fr : List UInt8) (c : PCx),
    Master a.x.sampleRate.toInt (u8 a.sp 0) (xoOf a) (some c.k0) (some (c.nm, fOf st))
    ∧ Reset (spOf a) (lbN a) a.x st.x.turnoff ∧ st.x.avctx = a.x.avctx ∧ st.sp = a.sp ∧ st.fm.length = 98 ∧ FrOk fr
    ∧ frSlot64 fr 0x40 = arg0 t₀ ∧ frSlot64 fr 0x30 = arg1 t₀ ∧ (s.dmem =⋆ Mm k e a ra t₀ st fr)

/-- `num_patches > 5` decided (`L31f5`, from the inner loop): as `AtPatF`, `r12` free. -/
def AtPatG (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ s : MachineData) : Prop :=
  ResetCI a t₀ ∧ Base t₀ s
  ∧ ∃ (st : St) (fr : List UInt8) (c : PCx),
    Master a.x.sampleRate.toInt (u8 a.sp 0) (xoOf a) (some c.k0) (some (c.nm, fOf st))
    ∧ Reset (spOf a) (lbN a) a.x st.x.turnoff ∧ st.x.avctx = a.x.avctx ∧ st.sp = a.sp ∧ st.fm.length = 98 ∧ FrOk fr
    ∧ frSlot64 fr 0x40 = arg0 t₀ ∧ frSlot64 fr 0x30 = arg1 t₀ ∧ (s.dmem =⋆ Mm k e a ra t₀ st fr)


/-! ## Shard B: the `goal_sb` search (owner noise) -/

/-- The unrolled `goal_sb` search at index `j` (blocks `L2cc2` … `L30c9`): `goal_sb <
kx[1] + m[1]`, every `f_master[i]`, `i < j`, below `goal_sb`, `eax = goal_sb`, the values of
`L30df` (`num_patches = 0`), `esi = k[0]`, `r12 = sbr`. -/
def AtSrch (j : Nat) (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ s : MachineData) : Prop :=
  AtPat k e a ra t₀ s (fun st c => goalSb a.x.sampleRate.toInt < ptop a c (fOf st)
    ∧ (∀ i, i < j → ((fOf st) i : Int) < goalSb a.x.sampleRate.toInt)
    ∧ st.x = { px0 a c (fOf st) with npatch := 0 }
    ∧ s.regs.get64 .rsi = BitVec.ofNat 64 (pk0 c) ∧ s.regs.get64 .r12 = arg1 t₀
    ∧ s.regs.get64 .rax = BitVec.ofNat 64 (goalSb a.x.sampleRate.toInt).toNat)


/-! ## Shard B: `f_tablenoise` (`derived3`) -/

/-- `f_tablenoise` with entry `0` stored and the entries `1..j` computed. -/
def NzM (x : Args) (q j : Nat) : List UInt8 :=
  mk16 6 (fun k => if k = 0 then u16 x.ftLow 0
    else if k ≤ j then u16 x.ftLow (ntemp x.n0 q k) else u16 x.ftNoise k)

/-- `derived3` in progress: `n_q = q`, `j` entries computed. -/
abbrev dNz (a : RArgs) (k0 : Int) (nm : Nat) (f : Nat → Nat) (q j : Nat) : Args :=
  { dD2 a k0 nm f with nq := q, ftNoise := NzM (dD2 a k0 nm f) q j }

/-- In the noise-border loop: `1 ≤ n_q ≤ 5`, `j` entries computed, `r11 = n_master`,
`r12 = sbr`, the frame slots `rbp - 0x50` (`k[2]` as `f_master[n_master]`) and `rbp - 0x80`
(`kx[1]`); `P st n0 q j` the rest. -/
def AtNz (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ s : MachineData)
    (P : St → Nat → Nat → Nat → Prop) : Prop :=
  AtNq k e a ra t₀ s (fun st fr nm k0 => ∃ q j, 1 ≤ q ∧ q < 6 ∧ st.x = dNz a k0 nm (fOf st) q j
    ∧ s.regs.get64 .r11 = BitVec.ofNat 64 nm ∧ s.regs.get64 .r12 = arg1 t₀
    ∧ frSlot32 fr 0x50 = BitVec.ofNat 32 ((fOf st) nm)
    ∧ frSlot32 fr 0x80 = BitVec.ofNat 32 ((fOf st) (xoOf a))
    ∧ P st ((nm - (xoOf a) + 1) / 2) q j)


/-! ## The `AV_QSORT` copies -/

namespace QS

/-- Element `q` (0-based) of the `int16` frame array at offset `o`. -/
abbrev av (fr : List UInt8) (o : Nat) : Nat → Int := fun q => A2.fv fr o (q + 1)

/-- The address of element `0` of the frame array at offset `o`. -/
abbrev pA (t₀ : MachineData) (o : Nat) : BitVec 64 :=
  t₀.regs.get64 .rsp - 0x578#64 + BitVec.ofNat 64 (o + 2)

/-- The address of element `q`. -/
abbrev ep (t₀ : MachineData) (o q : Nat) : BitVec 64 := pA t₀ o + BitVec.ofNat 64 (2 * q)

/-- The median position of `[lo, e]`. -/
abbrev mid (lo e : Nat) : Nat := lo + (e - lo) / 2

/-- The stack in the frame holds the pending intervals `S` (`start`, inclusive `end`). -/
def StkRel (fr : List UInt8) (t₀ : MachineData) (o : Nat) (S : List Parse.Qsort.Iv) : Prop :=
  ∀ j (h : j < S.length), frSlot64 fr (0x570 - 16 * j) = ep t₀ o S[j].1
    ∧ frSlot64 fr (0x568 - 16 * j) = ep t₀ o S[j].2 - 2#64

/-- `A0[0 .. N)` in `[-B, B]`, summing to `tot`. -/
def AB (N : Nat) (A0 : Nat → Int) (B tot : Int) : Prop :=
  (∀ q, q < N → -B ≤ A0 q ∧ A0 q ≤ B) ∧ Parse.Qsort.sumTo A0 N = tot

/-- Between partitions: the stack `S` (`sp = |S|`), the array a permutation of some `A0`. -/
def Pop (R : (Nat → Int) → Prop) (t₀ : MachineData) (N o : Nat) (fr : List UInt8)
    (sp : BitVec 64) : Prop :=
  1 ≤ N ∧ N ≤ 49 ∧ ∃ (S : List Parse.Qsort.Iv) (A0 : Nat → Int), sp = BitVec.ofNat 64 S.length
    ∧ Parse.Qsort.Depth N S ∧ R A0 ∧ StkRel fr t₀ o S ∧ Parse.Qsort.QW N (av fr o) A0 S

/-- On the current interval `[lo, hi1)`, with the facts `P S A lo hi1` (`A` the array). -/
def Cur (R : (Nat → Int) → Prop) (t₀ : MachineData) (N o : Nat) (fr : List UInt8)
    (sp : BitVec 64) (P : List Parse.Qsort.Iv → (Nat → Int) → Nat → Nat → Prop) : Prop :=
  1 ≤ N ∧ N ≤ 49 ∧ ∃ (S : List Parse.Qsort.Iv) (A0 : Nat → Int) (lo hi1 : Nat),
    sp = BitVec.ofNat 64 S.length ∧ Parse.Qsort.Depth N S ∧ (hi1 - lo) * 2 ^ S.length ≤ N
    ∧ R A0 ∧ StkRel fr t₀ o S ∧ Parse.Qsort.QW N (av fr o) A0 (S ++ [(lo, hi1)])
    ∧ P S (av fr o) lo hi1

/-- As `Cur` for an array `A`, with memory `A` updated at `pos` by `A lo` (half a swap). -/
def CurU (R : (Nat → Int) → Prop) (t₀ : MachineData) (N o : Nat) (fr : List UInt8)
    (sp : BitVec 64) (P : List Parse.Qsort.Iv → (Nat → Int) → Nat → Nat → Nat → Prop) : Prop :=
  1 ≤ N ∧ N ≤ 49 ∧ ∃ (S : List Parse.Qsort.Iv) (A A0 : Nat → Int) (lo hi1 pos : Nat),
    sp = BitVec.ofNat 64 S.length ∧ Parse.Qsort.Depth N S ∧ (hi1 - lo) * 2 ^ S.length ≤ N
    ∧ R A0 ∧ StkRel fr t₀ o S ∧ Parse.Qsort.QW N A A0 (S ++ [(lo, hi1)])
    ∧ (∀ q, av fr o q = Parse.Qsort.upd A pos (A lo) q) ∧ P S A lo hi1 pos

/-- The partition invariant on `[lo, e]`: `left = l`, `right = rt`, the pivot `pv` at `e - 1`. -/
def PInv (A : Nat → Int) (lo e l rt : Nat) (pv : Int) : Prop :=
  lo + 1 ≤ l ∧ l ≤ rt + 2 ∧ rt + 2 ≤ e ∧ l + 1 ≤ e ∧ A (e - 1) = pv

/-- After the pivot is placed at `l`. -/
def PDone (A : Nat → Int) (lo e l rt : Nat) : Prop :=
  lo + 1 ≤ l ∧ l ≤ rt + 2 ∧ rt < l ∧ l + 1 ≤ e

/-- The weight of the stack in memory, `n` entries. -/
def stkPhi (s : MachineData) (n : Nat) : Nat :=
  ((List.range n).map fun j => Parse.Qsort.wBn 2 (slot64 s (0x570 - 16 * j)).toNat
    (slot64 s (0x568 - 16 * j)).toNat).sum

end QS

namespace E
/-- sbr_reset -/
abbrev start (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ : MachineData) : MachineData → Prop :=
  fun s => s = t₀ ∧ ResetPre k e a ra t₀
/-- sbr_reset.L1086 -/
abbrev L1086 (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ : MachineData) : MachineData → Prop :=
  fun s => Pro 2 k e a ra t₀ s
/-- sbr_reset.L108a -/
abbrev L108a (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ : MachineData) : MachineData → Prop :=
  fun s => Pro 4 k e a ra t₀ s
/-- sbr_reset.L10b8 -/
abbrev L10b8 (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ : MachineData) : MachineData → Prop :=
  fun s => RD k e a ra t₀ s ∧ srI a ≤ 0x7cff ∧ srI a ≠ 16000
/-- sbr_reset.L10d9 -/
abbrev L10d9 (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ : MachineData) : MachineData → Prop :=
  fun s => RD k e a ra t₀ s ∧ 0xf9ff < srI a
/-- sbr_reset.L10fe -/
abbrev L10fe (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ : MachineData) : MachineData → Prop :=
  fun s => RD k e a ra t₀ s ∧ 0x7cff < srI a ∧ srI a ≤ 0xf9ff
/-- sbr_reset.L111e -/
abbrev L111e (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ : MachineData) : MachineData → Prop :=
  fun s => RD k e a ra t₀ s ∧ rateRow (srI a) = some 4
/-- sbr_reset.L1127 -/
abbrev L1127 (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ : MachineData) : MachineData → Prop :=
  fun s => RD k e a ra t₀ s ∧ 0x1f3ff < srI a
/-- sbr_reset.L1143 -/
abbrev L1143 (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ : MachineData) : MachineData → Prop :=
  fun s => RD k e a ra t₀ s ∧ rateRow (srI a) = some 5
/-- sbr_reset.L114a -/
abbrev L114a (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ : MachineData) : MachineData → Prop :=
  fun s => RD k e a ra t₀ s ∧ ∃ row, rateRow (srI a) = some row ∧ s.regs.get64 .rdi = offLab row
/-- sbr_reset.L1179 -/
abbrev L1179 (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ : MachineData) : MachineData → Prop :=
  fun s => RD k e a ra t₀ s ∧ (∃ row, rateRow (srI a) = some row ∧ s.regs.get64 .rdi = offLab row) ∧ s.regs.get64 .rax = BitVec.ofNat 64 (tmpOf a.x.sampleRate.toNat * 128 + a.x.sampleRate.toNat / 2) ∧ s.regs.get64 .rsi = BitVec.ofNat 64 (tmpOf a.x.sampleRate.toNat) ∧ s.regs.get64 .r8 = BitVec.ofNat 64 (a.x.sampleRate.toNat / 2)
/-- sbr_reset.L117d -/
abbrev L117d (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ : MachineData) : MachineData → Prop :=
  fun s => RD k e a ra t₀ s ∧ (∃ row, rateRow (srI a) = some row ∧ s.regs.get64 .rdi = offLab row) ∧ s.regs.get64 .rax = BitVec.ofNat 64 ((tmpOf a.x.sampleRate.toNat * 128 + a.x.sampleRate.toNat / 2) / a.x.sampleRate.toNat) ∧ s.regs.get64 .rsi = BitVec.ofNat 64 (tmpOf a.x.sampleRate.toNat) ∧ s.regs.get64 .r8 = BitVec.ofNat 64 (a.x.sampleRate.toNat / 2)
/-- sbr_reset.L118e -/
abbrev L118e (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ : MachineData) : MachineData → Prop :=
  fun s => K0S k e a ra t₀ s (fun row _ _ => s.regs.get64 .rdx = BitVec.ofNat 64 (k0N a row) ∧ s.regs.get64 .rcx = a.x.sampleRate.setWidth 64)
/-- sbr_reset.L11a7 -/
abbrev L11a7 (k : Nat) (e : REnv) (a : RArgs) (ra : Int64) (t₀ : MachineData) : MachineData → Prop :=
  fun s => ∃ row, rateRow (srI a) = some row ∧ u8 a.sp 1 ≤ 13 ∧ A1S k e a ra t₀ s (xk0 a row) (fun _ fr => frSlot64 fr 0x40 = arg0 t₀) ∧ s.regs.get64 .r12 = arg1 t₀ ∧ s.regs.get64 .rcx = a.x.sampleRate.setWidth 64
