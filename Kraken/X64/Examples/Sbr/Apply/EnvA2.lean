theorem blk_L8a50 (k : Nat) (hk : k ≤ 2 ^ 32) (e : Env) (hc : ApplyCallees k e)
    (x : Args) (ra : Int64) (t₀ : MachineData) (hSt : applyNeed k ≤ (t₀.regs.get64 .rsp).toNat) :
    BlockOb k e x ra t₀ "ff_aac_sbr_apply.L8a50" ⟨"ff_aac_sbr_apply.L8a50", B.L8a50, some "ff_aac_sbr_apply.L8a50_1"⟩ := by
  info_off
  clear hc
  intro n
  refine Triple.pin fun s₀ hs₀ => ?_
  obtain ⟨hs, hn⟩ := hs₀
  obtain ⟨hC, ⟨hrsp, hrbp⟩, y, ch, c0, j, p, q, hK, hCy, hc0, hst, hch, hf0, hr14, hr12, hf3, hrbx, hf5, hf6, hf7, hr13, hr15, hm⟩ := T.L8a50.mp hs
  clear hs
  obtain ⟨hn1, hn8, hm1, hm48, hk32, hkm, hte, hmono, hfr, htl, hfl⟩ := env_wf hCy hst hch (hK.2.live hst)
  have z : ∀ a : BitVec 64, a + 0 = a := fun a => BitVec.add_zero a
  obtain rfl | rfl : ch = 0 ∨ ch = 1 := by omega
  all_goals simp only [FrNP, Mm, ApplyF, CstW, ScW, TabW, DScW, DArrW, ArrW, Blocks, dA, sbrA, arg1, Args.d, Nat.one_ne_zero, ↓reduceIte, Nat.reduceMul, Nat.reduceAdd, BitVec.add_assoc, BitVec.reduceAdd] at hm hf0 hr14 hr12 hf3 hrbx hf5 hf6 hf7 hr13 hr15 hn1 hn8 hte hmono hfr htl hfl ⊢
  all_goals try simp only [u8, u16] at hf0 hr14 hr12 hf3 hrbx hf5 hf6 hf7 hr13 hr15 hte hmono hfr
  all_goals try dsimp only
  all_goals have hm0 := hm
  all_goals try simp only [c8, c4] at hm0
  all_goals simp only [B.L8a50]
  all_goals try (have p_hm : PLift _ := ⟨hm⟩; clear hm)
  all_goals try (have p_hm0 : PLift _ := ⟨hm0⟩; clear hm0)
