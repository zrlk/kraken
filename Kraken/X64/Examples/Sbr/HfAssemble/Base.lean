theorem DataW_carve_y2 (x : HfArgs) (t : MachineData) (b₁ b₂ : BitVec 64)
    (h₁ : (b₁ - (arg3 t + 0x11130#64)).toNat + 192 ≤ 16128)
    (h₂ : (b₂ - (arg3 t + 0x11130#64)).toNat + 192 ≤ 16128)
