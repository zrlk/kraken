    (h2 : LeafSpecAt fs.noise2 0 (HfApplyNoiseF HfApplyNoiseK2) (HfApplyNoiseC HfApplyNoiseK2.1))
    (h3 : LeafSpecAt fs.noise3 0 (HfApplyNoiseF HfApplyNoiseK3) (HfApplyNoiseC HfApplyNoiseK3.1)) :
