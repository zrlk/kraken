theorem hfNoiseFn_1 (fs : HfFns) : hfNoiseFn fs 1 = fs.noise1 := rfl
theorem hfNoiseFn_2 (fs : HfFns) : hfNoiseFn fs 2 = fs.noise2 := rfl
