AArch64 MSQueue2
(* Michael-Scott queue (Promising-ARM PLDI'19 §7 "QU"), compiler-style annotations (CASAL on
   tail.next, tail and head): one enqueuer of values 1,2 and one dequeuer
   that dequeues twice into X10, X11.
   Static nodes: `d` is the initial dummy (head = tail = d), `n1`, `n2` are
   the enqueued nodes; node data at [n], next pointer at [n,#8].
   Enqueue: STR data; loop { LDAR tail; LDAR tail.next; if next != 0 then
   CASAL tail -> next, retry; CASAL tail.next: 0 -> node; }; CASAL
   tail -> node. Dequeue (retried until non-empty): LDAR head; LDAR tail;
   LDAR head.next; if head = tail then (empty or help advance tail) else
   LDR next.data; CASAL head -> next.
   Property: the dequeuer receives 1 then 2 (FIFO, nothing lost, nothing
   duplicated, data visible).
   Expected: Always. (Threads have different roles: do not use -sym.)
   Whole image: `msqueue2_envG_whole` (Promising/SLR/EnvG/A64WholeMsQueue2.lean),
   both threads run this whole code block from `enq`/`deq1` to `pdone`/`ddone1`; concrete
   instance with `runnerMatchesWQ2` in A64WholeMsQueue2Concrete.lean.
   The shared symbols are typed (`uint64_t head`, `tail`; `uint32_t d`, `n1`, `n2`, the nodes' 4-byte
   data words, their 8-byte `next` at `n+8` undeclared)
   so that the runner declares them as sized locations at the width of
   the code's accesses (A64DECLS): the runner's
   declarations then agree with the proofs' locations. The code block and
   the verdict are unchanged. Proved from the runner's exact configuration
   (declarations and initial memory included): `msqueue2_envG_runner`, concrete
   `msqueue2_envG_runner_concrete` (Promising/SLR/EnvG/A64WholeMsQueue2Runner.lean).
   Proved program-level fault freedom at the runner's declarations (no
   reachable configuration has a faulting step, any architecture, promises
   included): `msqueue2_envG_runner_faultFree`, concrete
   `msqueue2_envG_runner_faultFree_concrete` (Promising/SLR/EnvG/MemValsA64MsQueue23.lean).
   Proved both at once (safety and fault freedom, at the union of their
   hypotheses): `msqueue2_envG_runner_safe_faultFree`, concrete
   `msqueue2_envG_runner_safe_faultFree_concrete` (Promising/SLR/EnvG/RunnerSafeFFA64.lean). *)
# flags:
# expect: Always
{
uint64_t head=d; uint64_t tail=d; uint32_t d=0; uint32_t n1=0; uint32_t n2=0;
0:X0=head; 0:X1=tail; 0:X12=n1; 0:X13=n2;
1:X0=head; 1:X1=tail;
}
threads { P0: enq pdone; P1: deq1 ddone1; }
code {
enq:
enq1:
  MOV X2,X12
  MOV W9,#1
  STR W9,[X2]
enq1_loop:
  LDAR X3,[X1]
  ADD X8,X3,#8
  LDAR X4,[X8]
  CBNZ X4,enq1_fix
  MOV X5,#0
  CASAL X5,X2,[X8]
  CBNZ X5,enq1_loop
  MOV X5,X3
  CASAL X5,X2,[X1]
  B enq1_end
enq1_fix:
  MOV X5,X3
  CASAL X5,X4,[X1]
  B enq1_loop
enq1_end:
enq2:
  MOV X2,X13
  MOV W9,#2
  STR W9,[X2]
enq2_loop:
  LDAR X3,[X1]
  ADD X8,X3,#8
  LDAR X4,[X8]
  CBNZ X4,enq2_fix
  MOV X5,#0
  CASAL X5,X2,[X8]
  CBNZ X5,enq2_loop
  MOV X5,X3
  CASAL X5,X2,[X1]
  B enq2_end
enq2_fix:
  MOV X5,X3
  CASAL X5,X4,[X1]
  B enq2_loop
enq2_end:
  B pdone
pdone:
  NOP
deq1:
deq1a:
  LDAR X3,[X0]
  LDAR X4,[X1]
  ADD X8,X3,#8
  LDAR X5,[X8]
  CMP X3,X4
  B.NE deq1a_ne
  CBZ X5,deq1a
  MOV X6,X3
  CASAL X6,X5,[X1]
  B deq1a
deq1a_ne:
  CBZ X5,deq1a
  LDR W7,[X5]
  MOV X6,X3
  CASAL X6,X5,[X0]
  CMP X6,X3
  B.NE deq1a
  MOV W10,W7
deq1b:
  LDAR X3,[X0]
  LDAR X4,[X1]
  ADD X8,X3,#8
  LDAR X5,[X8]
  CMP X3,X4
  B.NE deq1b_ne
  CBZ X5,deq1b
  MOV X6,X3
  CASAL X6,X5,[X1]
  B deq1b
deq1b_ne:
  CBZ X5,deq1b
  LDR W7,[X5]
  MOV X6,X3
  CASAL X6,X5,[X0]
  CMP X6,X3
  B.NE deq1b
  MOV W11,W7
  B ddone1
ddone1:
  NOP
}
forall (1:X10=1 /\ 1:X11=2)
