AArch64 SpscQueueRelaxed3
(* SPSC circular buffer (as spsc_queue.kl) with the producer publishing
   `tail` by a plain STR instead of STLR: the data store is no longer
   ordered before the tail update, so the consumer can read a slot before
   the data landed (a stale value, 0 or the slot's previous content).
   Property checked: consumer receives 1,2,3 in order (forall).
   Expected: Sometimes. *)
# flags:
# slow
# expect: Sometimes
# Proved reachable: Kraken.Promising.Reach.SpscQueueRelaxed3.spsc_queue_relaxed3_reachable (Kraken/Promising/ReachA64SpscQueueRelaxed3.lean)
{
buf=0; head=0; tail=0;
0:X0=buf; 0:X1=head; 0:X2=tail;
1:X0=buf; 1:X1=head; 1:X2=tail;
}
threads { P0: prod pdone; P1: cons cdone; }
code {
prod:
  MOV W3,#1
  MOV X4,#0
  MOV X7,X0
prod_loop:
  LDAR X5,[X1]
  SUB X6,X4,X5
  CMP X6,#2
  B.EQ prod_loop
  STR W3,[X7]
  EOR X7,X7,#8
  ADD X4,X4,#1
  STR X4,[X2]
  ADD W3,W3,#1
  CMP W3,#4
  B.NE prod_loop
  B pdone
pdone:
  NOP
cons:
  MOV X4,#0
  MOV X7,X0
c1:
  LDAR X5,[X2]
  CMP X5,X4
  B.EQ c1
  LDR W10,[X7]
  EOR X7,X7,#8
  ADD X4,X4,#1
  STLR X4,[X1]
c2:
  LDAR X5,[X2]
  CMP X5,X4
  B.EQ c2
  LDR W11,[X7]
  EOR X7,X7,#8
  ADD X4,X4,#1
  STLR X4,[X1]
c3:
  LDAR X5,[X2]
  CMP X5,X4
  B.EQ c3
  LDR W12,[X7]
  EOR X7,X7,#8
  ADD X4,X4,#1
  STLR X4,[X1]
  B cdone
cdone:
}
forall (1:X10=1 /\ 1:X11=2 /\ 1:X12=3)
